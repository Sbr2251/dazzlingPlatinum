+namespace SIM::Gpu {
+
+TextureDesc TextureDesc::Rgba8(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d;
+    d.width = w;
+    d.height = h;
+    d.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+    d.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER;
+    d.name = name;
+    return d;
+}
+
+TextureDesc TextureDesc::R8Uint(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = SDL_GPU_TEXTUREFORMAT_R8_UINT;
+    return d;
+}
+
+TextureDesc TextureDesc::R16Uint(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = SDL_GPU_TEXTUREFORMAT_R16_UINT;
+    return d;
+}
+
+TextureDesc TextureDesc::ColorTarget(Uint32 w, Uint32 h, SDL_GPUTextureFormat format, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = format;
+    d.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+    return d;
+}
+
+TextureDesc TextureDesc::DepthTarget(const Device &device, Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = device.DepthFormat();
+    d.usage = SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET;
+    return d;
+}
+
+Texture::Texture(Texture &&o) noexcept : mDevice(o.mDevice), mTexture(o.mTexture), mDesc(o.mDesc) {
+    o.mTexture = nullptr;
+}
+
+Texture &Texture::operator=(Texture &&o) noexcept {
+    if (this != &o) {
+        Release();
+        mDevice = o.mDevice;
+        mTexture = o.mTexture;
+        mDesc = o.mDesc;
+        o.mTexture = nullptr;
+    }
+    return *this;
+}
+
+bool Texture::Create(Device &device, const TextureDesc &desc) {
+    Release();
+    mDevice = &device;
+    mDesc = desc;
+    if (!device.Handle() || desc.width == 0 || desc.height == 0) {
+        device.ReportFailure("Texture::Create: no device or zero size", false);
+        return false;
+    }
+    if (!SDL_GPUTextureSupportsFormat(device.Handle(), desc.format, SDL_GPU_TEXTURETYPE_2D, desc.usage)) {
+        char ctx[160];
+        SDL_snprintf(ctx, sizeof ctx, "Texture::Create(%s): format %d does not support usage 0x%x on this device",
+                     desc.name ? desc.name : "unnamed", (int)desc.format, (unsigned)desc.usage);
+        device.ReportFailure(ctx, false);
+        return false;
+    }
+    SDL_GPUTextureCreateInfo info;
+    SDL_zero(info);
+    info.type = desc.layers > 1 ? SDL_GPU_TEXTURETYPE_2D_ARRAY : SDL_GPU_TEXTURETYPE_2D;
+    info.format = desc.format;
+    info.usage = desc.usage;
+    info.width = desc.width;
+    info.height = desc.height;
+    info.layer_count_or_depth = desc.layers ? desc.layers : 1;
+    info.num_levels = desc.levels ? desc.levels : 1;
+    info.sample_count = SDL_GPU_SAMPLECOUNT_1;
+    SDL_PropertiesID props = 0;
+    if (desc.name) {
+        props = SDL_CreateProperties();
+        SDL_SetStringProperty(props, SDL_PROP_GPU_TEXTURE_CREATE_NAME_STRING, desc.name);
+        info.props = props;
+    }
+    mTexture = SDL_CreateGPUTexture(device.Handle(), &info);
+    if (props) SDL_DestroyProperties(props);
+    if (!mTexture) {
+        char ctx[160];
+        SDL_snprintf(ctx, sizeof ctx, "SDL_CreateGPUTexture(%s %ux%u)", desc.name ? desc.name : "unnamed", desc.width, desc.height);
+        device.ReportFailure(ctx);
+        return false;
+    }
+    return true;
+}
+
+bool Texture::Resize(Uint32 width, Uint32 height) {
+    if (!mDevice) return false;
+    if (mTexture && mDesc.width == width && mDesc.height == height) return true;
+    TextureDesc d = mDesc;
+    d.width = width;
+    d.height = height;
+    Device *device = mDevice;
+    return Create(*device, d);
+}
+
+void Texture::Release() {
+    if (mTexture && mDevice && mDevice->Handle()) SDL_ReleaseGPUTexture(mDevice->Handle(), mTexture);
+    mTexture = nullptr;
+}
+
+bool RenderTarget::Create(Device &device, Uint32 width, Uint32 height, SDL_GPUTextureFormat colorFormat, bool withDepth,
+                          const char *name) {
+    Release();
+    if (!mColor.Create(device, TextureDesc::ColorTarget(width, height, colorFormat, name))) return false;
+    if (withDepth && !mDepth.Create(device, TextureDesc::DepthTarget(device, width, height, name))) {
+        mColor.Release();
+        return false;
+    }
+    return true;
+}
+
+bool RenderTarget::Resize(Uint32 width, Uint32 height) {
+    if (mColor && mColor.Width() == width && mColor.Height() == height) return false;
+    mColor.Resize(width, height);
+    if (mDepth.Desc().width != 0) mDepth.Resize(width, height);
+    return true;
+}
+
+void RenderTarget::Release() {
+    mColor.Release();
+    mDepth.Release();
+}
+
+static SDL_GPUSamplerAddressMode ToAddress(Wrap w) {
+    switch (w) {
+    case Wrap::Repeat: return SDL_GPU_SAMPLERADDRESSMODE_REPEAT;
+    case Wrap::Mirror: return SDL_GPU_SAMPLERADDRESSMODE_MIRRORED_REPEAT;
+    default: return SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+    }
+}
+
+SamplerCache::~SamplerCache() { Clear(); }
+
+void SamplerCache::Clear() {
+    if (mDevice.Handle()) {
+        for (auto &kv : mSamplers) SDL_ReleaseGPUSampler(mDevice.Handle(), kv.second);
+    }
+    mSamplers.clear();
+}
+
+SDL_GPUSampler *SamplerCache::Get(const SamplerKey &key) {
+    auto it = mSamplers.find(key);
+    if (it != mSamplers.end()) return it->second;
+    SDL_GPUSamplerCreateInfo info;
+    SDL_zero(info);
+    info.min_filter = info.mag_filter = key.filter == Filter::Linear ? SDL_GPU_FILTER_LINEAR : SDL_GPU_FILTER_NEAREST;
+    info.mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_NEAREST;
+    info.address_mode_u = ToAddress(key.wrapU);
+    info.address_mode_v = ToAddress(key.wrapV);
+    info.address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+    info.min_lod = 0.0f;
+    info.max_lod = 1000.0f;
+    SDL_GPUSampler *s = SDL_CreateGPUSampler(mDevice.Handle(), &info);
+    if (!s) {
+        mDevice.ReportFailure("SDL_CreateGPUSampler");
+        return nullptr;
+    }
+    mSamplers.emplace(key, s);
+    return s;
+}
+
+} // namespace SIM::Gpu
diff --git a/libraries/sim/tools/gpu_shaderc.py b/libraries/sim/tools/gpu_shaderc.py
new file mode 100644
index 0000000..8aeda79
--- /dev/null
+++ b/libraries/sim/tools/gpu_shaderc.py
@@ -0,0 +1,301 @@
+#!/usr/bin/env python3
+"""Compile one GLSL shader for SDL_GPU and emit a C++ header that embeds it.
+
+Input: a Vulkan-flavoured GLSL file (#version 450) named <name>.vert or <name>.frag.
+Output: a header defining SIM::Gpu::Shaders::<name>_<stage> (a SIM::Gpu::ShaderBlob) holding
+  - the SPIR-V module (for SDL_GPU's Vulkan backend),
+  - MSL source for macOS and for iOS (for SDL_GPU's Metal backend; entry point "main0"),
+  - the resource counts SDL_CreateGPUShader needs.
+
+Tools: glslangValidator (GLSL -> SPIR-V) and spirv-cross (reflection, SPIR-V -> MSL).
+Python 3 standard library only.
+
+Resource binding rules enforced here (from SDL_gpu.h, SDL_CreateGPUShader):
+  SPIR-V vertex shaders:   set 0 = sampled textures, then storage textures, then storage buffers
+                           set 1 = uniform buffers
+  SPIR-V fragment shaders: set 2 = sampled textures, then storage textures, then storage buffers
+                           set 3 = uniform buffers
+  Within each set the bindings must be 0..n-1 with no gaps, in that order. Textures must be
+  combined image samplers (sampler2D / usampler2D ...); SDL_GPU has no separate samplers.
+
+Metal mapping (derived from SDL/src/gpu/metal/SDL_gpu_metal.m, METAL_INTERNAL_BindGraphicsResources):
+  uniform buffer slot i          -> [[buffer(i)]]
+  storage buffer j               -> [[buffer(num_uniform_buffers + j)]]
+  sampled texture k              -> [[texture(k)]] and [[sampler(k)]]
+  storage texture j              -> [[texture(num_samplers + j)]]
+  vertex buffer slot s           -> [[buffer(14 + s)]] (reached through [[stage_in]], never declared here)
+  entry point                    -> "main0" (SDL's default when entrypoint is NULL; spirv-cross renames main)
+The SPIR-V bindings already equal these indices for uniform buffers, sampled textures and
+storage textures; storage buffers differ, so the script rewrites their Binding decorations in
+a private copy of the module before running spirv-cross --msl-decoration-binding, then checks
+every [[buffer/texture/sampler(n)]] in the generated entry point against the rule above.
+(spirv-cross omits resources a shader never reads, so the check is that each emitted index
+is one the rule allows and none repeats.)
+"""
+
+import argparse
+import json
+import os
+import re
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+
+# MSL 2.1: the oldest language version SDL_GPU's Metal backend supports (macOS 10.14, iOS 12/13),
+# enough for everything these shaders use; newer OS releases compile older MSL unchanged.
+MSL_VERSION = "20100"
+
+STAGES = {
+    ".vert": ("vert", "SDL_GPU_SHADERSTAGE_VERTEX", 0, 1),
+    ".frag": ("frag", "SDL_GPU_SHADERSTAGE_FRAGMENT", 2, 3),
+}
+
+INSTALL_HINT = ("install it (macOS: brew install glslang spirv-cross; "
+                "Ubuntu/Debian: apt install glslang-tools spirv-cross)")
+
+
+def fail(msg):
+    sys.stderr.write("gpu_shaderc: error: %s\n" % msg)
+    sys.exit(1)
+
+
+def find_tool(explicit, name):
+    path = explicit or shutil.which(name)
+    if not path or not (os.path.isfile(path) or shutil.which(path)):
+        fail("%s not found; %s" % (name, INSTALL_HINT))
+    return path
+
+
+def run(cmd):
+    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    if proc.returncode != 0:
+        fail("command failed (%d): %s\n%s%s" % (proc.returncode, " ".join(cmd),
+                                               proc.stdout.decode(errors="replace"),
+                                               proc.stderr.decode(errors="replace")))
+    return proc.stdout
+
+
+def check_set(src, kind_lists, set_index, what):
+    """kind_lists: ordered list of (kind, [resources]) that share one descriptor set.
+    Returns the count per kind after checking bindings are 0..n-1 in kind order."""
+    expected = 0
+    counts = {}
+    for kind, res in kind_lists:
+        res = sorted(res, key=lambda r: r["binding"])
+        counts[kind] = len(res)
+        for r in res:
+            if r.get("set", 0) != set_index:
+                fail("%s: %s '%s' is in set %d; %s must use set %d (SDL_GPU resource-set rules)"
+                     % (src, kind, r["name"], r.get("set", 0), what, set_index))
+            if r["binding"] != expected:
+                fail("%s: %s '%s' has binding %d, expected %d: set %d must hold sampled textures, "
+                     "then storage textures, then storage buffers, numbered 0..n-1 without gaps"
+                     % (src, kind, r["name"], r["binding"], expected, set_index))
+            if r.get("array"):
+                fail("%s: %s '%s' is an array; declare one binding per resource" % (src, kind, r["name"]))
+            expected += 1
+    return counts
+
+
+def patch_spirv_bindings(spv, remap):
+    """remap: {(set, binding): new_binding}. Rewrites OpDecorate Binding literals in place."""
+    words = list(struct.unpack("<%dI" % (len(spv) // 4), spv))
+    if words[0] != 0x07230203:
+        fail("not a little-endian SPIR-V module")
+    OP_DECORATE, DEC_BINDING, DEC_SET = 71, 33, 34
+    sets, bindings = {}, {}
+    i = 5
+    while i < len(words):
+        count, op = words[i] >> 16, words[i] & 0xFFFF
+        if count == 0:
+            fail("malformed SPIR-V")
+        if op == OP_DECORATE and count >= 4:
+            target, dec = words[i + 1], words[i + 2]
+            if dec == DEC_SET:
+                sets[target] = words[i + 3]
+            elif dec == DEC_BINDING:
+                bindings[target] = (i + 3, words[i + 3])
+        i += count
+    for target, (pos, b) in bindings.items():
+        key = (sets.get(target, 0), b)
+        if key in remap:
+            words[pos] = remap[key]
+    return struct.pack("<%dI" % len(words), *words)
+
+
+def entry_signature(msl):
+    m = re.search(r"\b(vertex|fragment)\s+\w+\s+main0\s*\((.*?)\)\s*\{", msl, re.S)
+    if not m:
+        fail("generated MSL has no main0 entry point")
+    return m.group(2)
+
+
+def c_bytes(data, per_line=24):
+    out = []
+    for i in range(0, len(data), per_line):
+        out.append("    " + ",".join("0x%02x" % b for b in data[i:i + per_line]) + ",")
+    return "\n".join(out)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("input", help="GLSL source, .vert or .frag")
+    ap.add_argument("-o", "--output", required=True, help="generated header")
+    ap.add_argument("--depfile", help="write a Makefile-style depfile for the build system")
+    ap.add_argument("-I", dest="includes", action="append", default=[], help="GLSL include directory")
+    ap.add_argument("-D", dest="defines", action="append", default=[], help="preprocessor define")
+    ap.add_argument("--name", help="C++ identifier (default: <basename>_<stage>)")
+    ap.add_argument("--glslang", help="path to glslangValidator")
+    ap.add_argument("--spirv-cross", dest="spirv_cross", help="path to spirv-cross")
+    ap.add_argument("--keep", help="also write <keep>.spv / <keep>.metal / <keep>.ios.metal / <keep>.json")
+    args = ap.parse_args()
+
+    src = args.input
+    base, ext = os.path.splitext(os.path.basename(src))
+    if ext not in STAGES:
+        fail("%s: the file extension must be .vert or .frag" % src)
+    stage, sdl_stage, res_set, ubo_set = STAGES[ext]
+    name = args.name or re.sub(r"[^A-Za-z0-9_]", "_", "%s_%s" % (base, stage))
+    if name[0].isdigit():
+        name = "_" + name
+
+    glslang = find_tool(args.glslang, "glslangValidator")
+    spirv_cross = find_tool(args.spirv_cross, "spirv-cross")
+
+    with tempfile.TemporaryDirectory() as tmp:
+        spv_path = os.path.join(tmp, "shader.spv")
+        cmd = [glslang, "-V", "--target-env", "vulkan1.0", "-S", stage, "-o", spv_path]
+        cmd += ["-I" + d for d in args.includes]
+        cmd += ["-D" + d for d in args.defines]
+        dep_path = os.path.join(tmp, "shader.d")
+        cmd += ["--depfile", dep_path, src]
+        run(cmd)
+        with open(spv_path, "rb") as f:
+            spv = f.read()
+
+        refl = json.loads(run([spirv_cross, spv_path, "--reflect"]).decode())
+        for bad, why in (("separate_images", "separate textures"), ("separate_samplers", "separate samplers"),
+                         ("push_constants", "push constants"), ("subpass_inputs", "subpass inputs"),
+                         ("acceleration_structures", "acceleration structures")):
+            if refl.get(bad):
+                fail("%s: %s are not supported by SDL_GPU (%s)" % (src, why, refl[bad][0].get("name")))
+        samplers = refl.get("textures", [])
+        storage_tex = refl.get("images", [])
+        storage_buf = refl.get("ssbos", [])
+        ubos = refl.get("ubos", [])
+        for r in samplers:
+            if r.get("type", "").startswith(("sampler2DMS", "isampler2DMS", "usampler2DMS")):
+                fail("%s: multisample textures cannot be sampled through SDL_GPU" % src)
+        counts = check_set(src, [("sampled texture", samplers), ("storage texture", storage_tex),
+                                 ("storage buffer", storage_buf)], res_set,
+                           "%s shader textures/storage" % stage)
+        ubo_counts = check_set(src, [("uniform buffer", ubos)], ubo_set, "%s shader uniform buffers" % stage)
+        n_samp, n_stex, n_sbuf = counts["sampled texture"], counts["storage texture"], counts["storage buffer"]
+        n_ubo = ubo_counts["uniform buffer"]
+        if n_samp > 16 or n_stex > 8 or n_sbuf > 8 or n_ubo > 4:
+            fail("%s: over SDL_GPU's per-stage limits (16 samplers, 8 storage textures, "
+                 "8 storage buffers, 4 uniform buffers)" % src)
+        for u in ubos:
+            if u.get("block_size", 0) > 32768:
+                fail("%s: uniform block '%s' is %d bytes; SDL_GPU pushes at most 32 KiB per slot"
+                     % (src, u["name"], u["block_size"]))
+
+        # Storage buffer j sits at SPIR-V binding n_samp + n_stex + j but at Metal [[buffer(n_ubo + j)]].
+        remap = {}
+        for r in storage_buf:
+            remap[(res_set, r["binding"])] = n_ubo + (r["binding"] - n_samp - n_stex)
+        msl_spv_path = os.path.join(tmp, "shader_msl.spv")
+        with open(msl_spv_path, "wb") as f:
+            f.write(patch_spirv_bindings(spv, remap))
+
+        expected = sorted([("buffer", i) for i in range(n_ubo)] +
+                          [("buffer", n_ubo + j) for j in range(n_sbuf)] +
+                          [("texture", k) for k in range(n_samp)] +
+                          [("sampler", k) for k in range(n_samp)] +
+                          [("texture", n_samp + j) for j in range(n_stex)])
+        msl = {}
+        for plat, extra in (("macos", []), ("ios", ["--msl-ios"])):
+            text = run([spirv_cross, msl_spv_path, "--msl", "--msl-version", MSL_VERSION,
+                        "--msl-decoration-binding"] + extra).decode()
+            # spirv-cross only declares resources the shader reads; an unused declared resource
+            # leaves a hole that SDL still binds, which is harmless, so compare against used ones.
+            sig = entry_signature(text)
+            present = sorted((k, int(n)) for k, n in re.findall(r"\[\[(buffer|texture|sampler)\((\d+)\)\]\]", sig))
+            if not set(present) <= set(expected) or len(present) != len(set(present)):
+                fail("%s: MSL resource indices %s do not follow SDL_GPU's Metal binding rule %s"
+                     % (src, present, expected))
+            msl[plat] = text.encode()
+
+        deps = []
+        if os.path.exists(dep_path):
+            with open(dep_path) as f:
+                content = f.read().replace("\\\n", " ")
+            if ":" in content:
+                deps = content.split(":", 1)[1].split()
+
+        if args.keep:
+            with open(args.keep + ".spv", "wb") as f:
+                f.write(spv)
+            with open(args.keep + ".metal", "wb") as f:
+                f.write(msl["macos"])
+            with open(args.keep + ".ios.metal", "wb") as f:
+                f.write(msl["ios"])
+            with open(args.keep + ".json", "w") as f:
+                json.dump(refl, f, indent=2)
+
+    ios_same = msl["ios"] == msl["macos"]
+    lines = []
+    lines.append("// Generated by gpu_shaderc.py from %s. Do not edit." % os.path.basename(src))
+    lines.append("// Resources: %d sampled textures, %d storage textures, %d storage buffers, %d uniform buffers."
+                 % (n_samp, n_stex, n_sbuf, n_ubo))
+    lines.append("#pragma once")
+    lines.append("#include <simulator/gpu/shader_blob.hpp>")
+    lines.append("")
+    lines.append("namespace SIM::Gpu::Shaders {")
+    lines.append("")
+    lines.append("inline constexpr unsigned char %s_spirv[] = {" % name)
+    lines.append(c_bytes(spv))
+    lines.append("};")
+    lines.append("")
+    lines.append("inline constexpr unsigned char %s_msl_macos[] = {" % name)
+    lines.append(c_bytes(msl["macos"] + b"\0"))
+    lines.append("};")
+    if not ios_same:
+        lines.append("")
+        lines.append("inline constexpr unsigned char %s_msl_ios[] = {" % name)
+        lines.append(c_bytes(msl["ios"] + b"\0"))
+        lines.append("};")
+    ios_name = "%s_msl_%s" % (name, "macos" if ios_same else "ios")
+    lines.append("")
+    lines.append("inline constexpr ShaderBlob %s = {" % name)
+    lines.append("    \"%s\"," % name)
+    lines.append("    %s," % sdl_stage)
+    lines.append("    %s_spirv, sizeof(%s_spirv)," % (name, name))
+    lines.append("    %s_msl_macos, sizeof(%s_msl_macos) - 1," % (name, name))
+    lines.append("    %s, sizeof(%s) - 1," % (ios_name, ios_name))
+    lines.append("    %du, %du, %du, %du," % (n_samp, n_stex, n_sbuf, n_ubo))
+    lines.append("};")
+    lines.append("")
+    lines.append("} // namespace SIM::Gpu::Shaders")
+    lines.append("")
+    text = "\n".join(lines)
+
+    os.makedirs(os.path.dirname(os.path.abspath(args.output)), exist_ok=True)
+    old = None
+    if os.path.exists(args.output):
+        with open(args.output) as f:
+            old = f.read()
+    if old != text:
+        with open(args.output, "w") as f:
+            f.write(text)
+
+    if args.depfile:
+        with open(args.depfile, "w") as f:
+            f.write("%s: %s\n" % (args.output.replace(" ", "\\ "),
+                                  " ".join(d.replace(" ", "\\ ") for d in ([src] + deps))))
+
+
+if __name__ == "__main__":
+    main()
