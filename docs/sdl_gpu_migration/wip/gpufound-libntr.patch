+#include <simulator/gpu/device.hpp>
+#include <simulator/gpu/pipeline.hpp>
+
+#include <cstdint>
+
+namespace SIM::Gpu {
+
+static inline void HashMix(size_t &h, size_t v) {
+    h ^= v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+}
+
+size_t PipelineKeyHash::operator()(const PipelineKey &k) const {
+    size_t h = 0;
+    HashMix(h, (size_t)(uintptr_t)k.vertex);
+    HashMix(h, (size_t)(uintptr_t)k.fragment);
+    HashMix(h, k.layout.stride);
+    HashMix(h, k.layout.numAttributes);
+    for (Uint32 i = 0; i < k.layout.numAttributes && i < kMaxVertexAttributes; i++) {
+        const VertexAttribute &a = k.layout.attributes[i];
+        HashMix(h, a.location | ((size_t)a.format << 8) | ((size_t)a.offset << 16));
+    }
+    HashMix(h, (size_t)k.primitive | ((size_t)k.cull << 4) | ((size_t)k.frontFace << 8) | ((size_t)k.depthTest << 10) |
+                   ((size_t)k.depthWrite << 11) | ((size_t)k.depthCompare << 12) | ((size_t)k.blend << 16) |
+                   ((size_t)k.colorWriteMask << 20));
+    HashMix(h, (size_t)k.colorFormat | ((size_t)k.depthFormat << 16));
+    return h;
+}
+
+static SDL_GPUColorTargetBlendState BlendState(Blend blend, Uint8 writeMask) {
+    SDL_GPUColorTargetBlendState s;
+    SDL_zero(s);
+    s.color_write_mask = writeMask;
+    s.enable_color_write_mask = writeMask != 0xF;
+    s.color_blend_op = SDL_GPU_BLENDOP_ADD;
+    s.alpha_blend_op = SDL_GPU_BLENDOP_ADD;
+    switch (blend) {
+    case Blend::Opaque:
+        s.enable_blend = false;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ZERO;
+        break;
+    case Blend::Alpha:
+        s.enable_blend = true;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_SRC_ALPHA;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
+        break;
+    case Blend::Premultiplied:
+        s.enable_blend = true;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
+        break;
+    case Blend::Additive:
+        s.enable_blend = true;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        break;
+    }
+    return s;
+}
+
+PipelineCache::~PipelineCache() { Clear(); }
+
+void PipelineCache::Clear() {
+    if (mDevice.Handle()) {
+        for (auto &kv : mPipelines) SDL_ReleaseGPUGraphicsPipeline(mDevice.Handle(), kv.second);
+    }
+    mPipelines.clear();
+}
+
+SDL_GPUGraphicsPipeline *PipelineCache::Get(const PipelineKey &key) {
+    auto it = mPipelines.find(key);
+    if (it != mPipelines.end()) return it->second;
+    if (!key.vertex || !key.fragment) {
+        mDevice.ReportFailure("PipelineCache::Get: key without vertex or fragment shader", false);
+        return nullptr;
+    }
+    SDL_GPUShader *vs = mDevice.Shader(*key.vertex);
+    SDL_GPUShader *fs = mDevice.Shader(*key.fragment);
+    if (!vs || !fs) return nullptr;
+
+    SDL_GPUGraphicsPipelineCreateInfo info;
+    SDL_zero(info);
+    info.vertex_shader = vs;
+    info.fragment_shader = fs;
+
+    SDL_GPUVertexBufferDescription vb;
+    SDL_zero(vb);
+    SDL_GPUVertexAttribute attrs[kMaxVertexAttributes];
+    if (key.layout.numAttributes > 0) {
+        vb.slot = 0;
+        vb.pitch = key.layout.stride;
+        vb.input_rate = SDL_GPU_VERTEXINPUTRATE_VERTEX;
+        for (Uint32 i = 0; i < key.layout.numAttributes; i++) {
+            attrs[i].location = key.layout.attributes[i].location;
+            attrs[i].buffer_slot = 0;
+            attrs[i].format = key.layout.attributes[i].format;
+            attrs[i].offset = key.layout.attributes[i].offset;
+        }
+        info.vertex_input_state.vertex_buffer_descriptions = &vb;
+        info.vertex_input_state.num_vertex_buffers = 1;
+        info.vertex_input_state.vertex_attributes = attrs;
+        info.vertex_input_state.num_vertex_attributes = key.layout.numAttributes;
+    }
+    info.primitive_type = key.primitive;
+    info.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
+    info.rasterizer_state.cull_mode = key.cull;
+    info.rasterizer_state.front_face = key.frontFace;
+    info.rasterizer_state.enable_depth_clip = true;  // GL behaviour; also needs no depthClamp feature
+    info.multisample_state.sample_count = SDL_GPU_SAMPLECOUNT_1;
+    info.depth_stencil_state.enable_depth_test = key.depthTest;
+    info.depth_stencil_state.enable_depth_write = key.depthTest && key.depthWrite;
+    info.depth_stencil_state.compare_op = key.depthTest ? key.depthCompare : SDL_GPU_COMPAREOP_ALWAYS;
+
+    SDL_GPUColorTargetDescription color;
+    SDL_zero(color);
+    if (key.colorFormat != SDL_GPU_TEXTUREFORMAT_INVALID) {
+        color.format = key.colorFormat;
+        color.blend_state = BlendState(key.blend, key.colorWriteMask);
+        info.target_info.color_target_descriptions = &color;
+        info.target_info.num_color_targets = 1;
+    }
+    if (key.depthFormat != SDL_GPU_TEXTUREFORMAT_INVALID) {
+        info.target_info.has_depth_stencil_target = true;
+        info.target_info.depth_stencil_format = key.depthFormat;
+    } else if (key.depthTest) {
+        mDevice.ReportFailure("PipelineCache::Get: depth test without a depth format", false);
+        return nullptr;
+    }
+
+    char name[160];
+    SDL_snprintf(name, sizeof name, "%s+%s", key.vertex->name, key.fragment->name);
+    SDL_PropertiesID props = SDL_CreateProperties();
+    SDL_SetStringProperty(props, SDL_PROP_GPU_GRAPHICSPIPELINE_CREATE_NAME_STRING, name);
+    info.props = props;
+    SDL_GPUGraphicsPipeline *pipeline = SDL_CreateGPUGraphicsPipeline(mDevice.Handle(), &info);
+    SDL_DestroyProperties(props);
+    if (!pipeline) {
+        char ctx[256];
+        SDL_snprintf(ctx, sizeof ctx, "SDL_CreateGPUGraphicsPipeline(%s)", name);
+        mDevice.ReportFailure(ctx);
+        return nullptr;
+    }
+    mPipelines.emplace(key, pipeline);
+    return pipeline;
+}
+
+} // namespace SIM::Gpu
