+static inline Uint32 AlignUp(Uint32 v, Uint32 a) { return (v + a - 1) & ~(a - 1); }
+
+const char *PhaseName(Phase phase) {
+    switch (phase) {
+    case Phase::Scene3D: return "Scene3D";
+    case Phase::Composite2D: return "Composite2D";
+    case Phase::Post: return "Post";
+    case Phase::Overlay: return "Overlay";
+    default: return "?";
+    }
+}
+
+PassDesc PassDesc::Color(SDL_GPUTexture *target, SDL_GPULoadOp load, SDL_FColor clear) {
+    PassDesc d;
+    d.color[0].texture = target;
+    d.color[0].load = load;
+    d.color[0].clear = clear;
+    d.numColorTargets = 1;
+    return d;
+}
+
+PassDesc PassDesc::ColorDepth(SDL_GPUTexture *target, SDL_GPUTexture *depth, SDL_FColor clear, float clearDepth) {
+    PassDesc d = Color(target, SDL_GPU_LOADOP_CLEAR, clear);
+    d.depth.texture = depth;
+    d.depth.load = SDL_GPU_LOADOP_CLEAR;
+    d.depth.clearDepth = clearDepth;
+    return d;
+}
+
+// One recorded command of the open pass segment. Payloads (viewports, uniform data) live in mArena.
+struct Frame::Cmd {
+    enum Type : Uint8 {
+        Pipeline, Viewport, Scissor, BlendConstants, VertexBuffer, StreamBinding, IndexBuffer,
+        VertexSampler, FragmentSampler, VertexUniform, FragmentUniform, Draw, DrawIndexed, InPassFn
+    };
+    Type type;
+    Uint32 a, b, c, d;
+    Sint32 e;
+    void *p, *q;
+};
+
+struct Frame::PendingUpload {
+    SDL_GPUTexture *texture;  // texture upload when set, else buffer upload
+    SDL_GPUBuffer *buffer;
+    Uint32 srcOffset;         // in mUploadBytes
+    Uint32 x, y, w, h, layer, mip;
+    Uint32 dstOffset, size;   // buffer uploads
+    bool cycle;
+};
+
+Frame::Frame(Device &device) : mDevice(device) {}
+
+Frame::~Frame() {
+    SDL_GPUDevice *dev = mDevice.Handle();
+    if (!dev) return;
+    for (SDL_GPUBuffer *b : mRetiredStream) SDL_ReleaseGPUBuffer(dev, b);
+    if (mStreamBuffer) SDL_ReleaseGPUBuffer(dev, mStreamBuffer);
+    if (mTransfer) SDL_ReleaseGPUTransferBuffer(dev, mTransfer);
+}
+
+void Frame::Fail(const char *what) {
+    mFailed = true;
+    mDevice.ReportFailure(what, false);
+}
+
+void Frame::FailSdl(const char *what) {
+    mFailed = true;
+    mDevice.ReportFailure(what, true);
+}
+
+bool Frame::Require(bool inPass, const char *what) {
+    char buf[160];
+    if (!mActive) {
+        SDL_snprintf(buf, sizeof buf, "%s outside a frame", what);
+        Fail(buf);
+        return false;
+    }
+    if (inPass && !mPassOpen) {
+        SDL_snprintf(buf, sizeof buf, "%s outside a pass", what);
+        Fail(buf);
+        return false;
+    }
+    return true;
+}
+
+bool Frame::Begin(Uint64 index) {
+    mCmd = SDL_AcquireGPUCommandBuffer(mDevice.Handle());
+    if (!mCmd) {
+        mDevice.ReportFailure("SDL_AcquireGPUCommandBuffer");
+        return false;
+    }
+    mIndex = index;
+    mActive = true;
+    mFailed = false;
+    mPassOpen = false;
+    mPhase = Phase::Scene3D;
+    mStats = FrameStats();
+    mStream.clear();
+    mStreamUploaded = 0;
+    mChunks.clear();
+    mStreamGpuUsed = 0;
+    mSwapchain = nullptr;
+    mSwapchainAcquired = false;
+    mPresentSource = nullptr;
+    return true;
+}
+
+void Frame::Reference(void *resource) {
+    if (resource) mReferenced.insert(resource);
+}
+
+void Frame::SplitIfReferenced(void *resource) {
+    if (!mPassOpen || !resource || !mReferenced.count(resource)) return;
+    mStats.passSplits++;
+    CloseSegment(true);
+}
+
+Uint32 Frame::Arena(const void *data, Uint32 bytes) {
+    Uint32 off = AlignUp((Uint32)mArena.size(), 16);
+    mArena.resize(off + bytes);
+    if (bytes) memcpy(mArena.data() + off, data, bytes);
+    return off;
+}
+
+// ---- passes -------------------------------------------------------------------------------------
+
+bool Frame::BeginPass(Phase phase, const PassDesc &desc) {
+    if (!Require(false, "BeginPass")) return false;
+    if (mPassOpen) {
+        Fail("BeginPass while a pass is open (EndPass first)");
+        return false;
+    }
+    if (phase < mPhase) {
+        char buf[128];
+        SDL_snprintf(buf, sizeof buf, "BeginPass(%s) after phase %s: phases must not go backwards", PhaseName(phase),
+                     PhaseName(mPhase));
+        Fail(buf);
+        return false;
+    }
+    if (desc.numColorTargets > kMaxColorTargets || (desc.numColorTargets == 0 && !desc.depth.texture)) {
+        Fail("BeginPass: needs 1-4 colour targets or a depth target");
+        return false;
+    }
+    for (Uint32 i = 0; i < desc.numColorTargets; i++) {
+        if (!desc.color[i].texture) {
+            Fail("BeginPass: null colour target");
+            return false;
+        }
+    }
+    mPhase = phase;
+    mPass = desc;
+    mPassOpen = true;
+    mContinuation = false;
+    mSegmentDraws = 0;
+    mBound = BoundState();
+    mCmds.clear();
+    mArena.clear();
+    mInPassFns.clear();
+    mReferenced.clear();
+    for (Uint32 i = 0; i < desc.numColorTargets; i++) Reference(desc.color[i].texture);
+    Reference(desc.depth.texture);
+    return true;
+}
+
+void Frame::EndPass() {
+    if (!Require(true, "EndPass")) return;
+    CloseSegment(false);
+}
+
+// Emits the recorded segment as copy pass (pending uploads, new stream data) + render pass.
+// continuing: the logical pass goes on in a new segment that loads the targets and rebinds state.
+void Frame::CloseSegment(bool continuing) {
+    bool hasClear = false;
+    if (!mContinuation) {
+        for (Uint32 i = 0; i < mPass.numColorTargets; i++) hasClear |= mPass.color[i].load == SDL_GPU_LOADOP_CLEAR;
+        hasClear |= mPass.depth.texture && mPass.depth.load == SDL_GPU_LOADOP_CLEAR;
+    }
+    const bool emit = mSegmentDraws > 0 || hasClear || !mInPassFns.empty();
+
+    if (emit && FlushCopies()) {
+        SDL_GPUColorTargetInfo colors[kMaxColorTargets];
+        SDL_zero(colors);
+        for (Uint32 i = 0; i < mPass.numColorTargets; i++) {
+            const ColorTargetDesc &c = mPass.color[i];
+            colors[i].texture = c.texture;
+            colors[i].clear_color = c.clear;
+            colors[i].load_op = mContinuation ? SDL_GPU_LOADOP_LOAD : c.load;
+            colors[i].store_op = SDL_GPU_STOREOP_STORE;
+            colors[i].cycle = !mContinuation && c.cycle && c.load != SDL_GPU_LOADOP_LOAD;
+        }
+        SDL_GPUDepthStencilTargetInfo depth;
+        SDL_zero(depth);
+        if (mPass.depth.texture) {
+            depth.texture = mPass.depth.texture;
+            depth.clear_depth = mPass.depth.clearDepth;
+            depth.load_op = mContinuation ? SDL_GPU_LOADOP_LOAD : mPass.depth.load;
+            // A split pass needs the depth it wrote so far.
+            depth.store_op = continuing ? SDL_GPU_STOREOP_STORE : mPass.depth.store;
+            depth.stencil_load_op = SDL_GPU_LOADOP_DONT_CARE;
+            depth.stencil_store_op = SDL_GPU_STOREOP_DONT_CARE;
+            depth.cycle = !mContinuation && mPass.depth.cycle && mPass.depth.load != SDL_GPU_LOADOP_LOAD;
+        }
+        if (mPass.label) SDL_PushGPUDebugGroup(mCmd, mPass.label);
+        SDL_GPURenderPass *pass = SDL_BeginGPURenderPass(mCmd, colors, mPass.numColorTargets,
+                                                         mPass.depth.texture ? &depth : nullptr);
+        if (!pass) {
+            FailSdl("SDL_BeginGPURenderPass");
+        } else {
+            mStats.renderPasses++;
+            Replay(pass);
+            SDL_EndGPURenderPass(pass);
+        }
+        if (mPass.label) SDL_PopGPUDebugGroup(mCmd);
+    }
+
+    mCmds.clear();
+    mArena.clear();
+    mInPassFns.clear();
+    mReferenced.clear();
+    mSegmentDraws = 0;
+    if (continuing) {
+        // Without an emitted render pass the targets still hold their pre-pass contents, so a
+        // pass that never emitted keeps its own load ops.
+        if (emit) mContinuation = true;
+        for (Uint32 i = 0; i < mPass.numColorTargets; i++) Reference(mPass.color[i].texture);
+        Reference(mPass.depth.texture);
+        RecordBoundState();
+    } else {
+        mPassOpen = false;
+        mContinuation = false;
+        mBound = BoundState();
+    }
+}
+
+void Frame::RecordBoundState() {
+    BoundState s = mBound;
+    mBound = BoundState();
+    if (s.pipeline) BindPipeline(s.pipeline);
+    if (s.hasViewport) SetViewport(s.viewport);
+    if (s.hasScissor) SetScissor(s.scissor);
+    if (s.hasBlend) SetBlendConstants(s.blend);
+    for (Uint32 i = 0; i < 4; i++) {
+        if (s.vertexIsStream[i]) BindStream(s.vertexOffsets[i], i);
+        else if (s.vertexBuffers[i]) BindVertexBuffer(s.vertexBuffers[i], s.vertexOffsets[i], i);
+    }
+    if (s.indexBuffer) BindIndexBuffer(s.indexBuffer, s.indexOffset, s.indexSize);
+    for (Uint32 i = 0; i < 16; i++) {
+        if (s.vsSamplers[i].texture) BindVertexSampler(i, s.vsSamplers[i].texture, s.vsSamplers[i].sampler);
+        if (s.fsSamplers[i].texture) BindFragmentSampler(i, s.fsSamplers[i].texture, s.fsSamplers[i].sampler);
+    }
+}
+
+void Frame::Replay(SDL_GPURenderPass *pass) {
+    for (const Cmd &c : mCmds) {
+        switch (c.type) {
+        case Cmd::Pipeline:
+            SDL_BindGPUGraphicsPipeline(pass, (SDL_GPUGraphicsPipeline *)c.p);
+            break;
+        case Cmd::Viewport:
+            SDL_SetGPUViewport(pass, (const SDL_GPUViewport *)(mArena.data() + c.a));
+            break;
+        case Cmd::Scissor:
+            SDL_SetGPUScissor(pass, (const SDL_Rect *)(mArena.data() + c.a));
+            break;
+        case Cmd::BlendConstants:
+            SDL_SetGPUBlendConstants(pass, *(const SDL_FColor *)(mArena.data() + c.a));
+            break;
+        case Cmd::VertexBuffer: {
+            SDL_GPUBufferBinding b = { (SDL_GPUBuffer *)c.p, c.b };
+            SDL_BindGPUVertexBuffers(pass, c.a, &b, 1);
+            break;
+        }
+        case Cmd::StreamBinding: {
+            SDL_GPUBufferBinding b;
+            if (ResolveStream(c.b, &b.buffer, &b.offset)) {
+                SDL_BindGPUVertexBuffers(pass, c.a, &b, 1);
+            } else {
+                Fail("stream offset not uploaded (BindStream with an offset from StreamVertices of this frame only)");
+            }
+            break;
+        }
+        case Cmd::IndexBuffer: {
+            SDL_GPUBufferBinding b = { (SDL_GPUBuffer *)c.p, c.b };
+            SDL_BindGPUIndexBuffer(pass, &b, (SDL_GPUIndexElementSize)c.c);
+            break;
+        }
+        case Cmd::VertexSampler: {
+            SDL_GPUTextureSamplerBinding b = { (SDL_GPUTexture *)c.p, (SDL_GPUSampler *)c.q };
+            SDL_BindGPUVertexSamplers(pass, c.a, &b, 1);
+            break;
+        }
+        case Cmd::FragmentSampler: {
+            SDL_GPUTextureSamplerBinding b = { (SDL_GPUTexture *)c.p, (SDL_GPUSampler *)c.q };
+            SDL_BindGPUFragmentSamplers(pass, c.a, &b, 1);
+            break;
+        }
+        case Cmd::VertexUniform:
+            SDL_PushGPUVertexUniformData(mCmd, c.a, mArena.data() + c.b, c.c);
+            break;
+        case Cmd::FragmentUniform:
+            SDL_PushGPUFragmentUniformData(mCmd, c.a, mArena.data() + c.b, c.c);
+            break;
+        case Cmd::Draw:
+            SDL_DrawGPUPrimitives(pass, c.a, c.d, c.b, 0);
+            break;
+        case Cmd::DrawIndexed:
+            SDL_DrawGPUIndexedPrimitives(pass, c.a, c.d, c.b, c.e, 0);
+            break;
+        case Cmd::InPassFn:
+            mInPassFns[c.a](mCmd, pass);
+            break;
+        }
+    }
+}
+
+// ---- state and draws ----------------------------------------------------------------------------
+
+void Frame::BindPipeline(SDL_GPUGraphicsPipeline *pipeline) {
+    if (!Require(true, "BindPipeline")) return;
+    if (!pipeline) {
+        Fail("BindPipeline(nullptr): pipeline creation failed earlier");
+        return;
+    }
+    if (mBound.pipeline == pipeline) return;
+    mBound.pipeline = pipeline;
+    mCmds.push_back({ Cmd::Pipeline, 0, 0, 0, 0, 0, pipeline, nullptr });
+    mStats.pipelineBinds++;
+}
+
+void Frame::SetViewport(const SDL_GPUViewport &viewport) {
+    if (!Require(true, "SetViewport")) return;
+    mBound.hasViewport = true;
+    mBound.viewport = viewport;
+    mCmds.push_back({ Cmd::Viewport, Arena(&viewport, sizeof viewport), 0, 0, 0, 0, nullptr, nullptr });
+}
+
+void Frame::SetScissor(const SDL_Rect &scissor) {
+    if (!Require(true, "SetScissor")) return;
+    mBound.hasScissor = true;
+    mBound.scissor = scissor;
+    mCmds.push_back({ Cmd::Scissor, Arena(&scissor, sizeof scissor), 0, 0, 0, 0, nullptr, nullptr });
+}
+
+void Frame::SetBlendConstants(SDL_FColor constants) {
+    if (!Require(true, "SetBlendConstants")) return;
+    mBound.hasBlend = true;
+    mBound.blend = constants;
+    mCmds.push_back({ Cmd::BlendConstants, Arena(&constants, sizeof constants), 0, 0, 0, 0, nullptr, nullptr });
+}
+
+void Frame::BindVertexBuffer(SDL_GPUBuffer *buffer, Uint32 offset, Uint32 slot) {
+    if (!Require(true, "BindVertexBuffer")) return;
+    if (slot >= 4 || !buffer) {
+        Fail("BindVertexBuffer: slot >= 4 or null buffer");
+        return;
+    }
+    mBound.vertexBuffers[slot] = buffer;
+    mBound.vertexOffsets[slot] = offset;
+    mBound.vertexIsStream[slot] = false;
+    Reference(buffer);
+    mCmds.push_back({ Cmd::VertexBuffer, slot, offset, 0, 0, 0, buffer, nullptr });
+}
+
+void Frame::BindIndexBuffer(SDL_GPUBuffer *buffer, Uint32 offset, SDL_GPUIndexElementSize size) {
+    if (!Require(true, "BindIndexBuffer")) return;
+    mBound.indexBuffer = buffer;
+    mBound.indexOffset = offset;
+    mBound.indexSize = size;
+    Reference(buffer);
+    mCmds.push_back({ Cmd::IndexBuffer, 0, offset, (Uint32)size, 0, 0, buffer, nullptr });
+}
+
+void Frame::BindVertexSampler(Uint32 slot, SDL_GPUTexture *texture, SDL_GPUSampler *sampler) {
+    if (!Require(true, "BindVertexSampler")) return;
+    if (slot >= 16 || !texture || !sampler) {
+        Fail("BindVertexSampler: slot >= 16 or null texture/sampler");
+        return;
+    }
+    mBound.vsSamplers[slot] = { texture, sampler };
+    Reference(texture);
+    mCmds.push_back({ Cmd::VertexSampler, slot, 0, 0, 0, 0, texture, sampler });
+}
+
+void Frame::BindFragmentSampler(Uint32 slot, SDL_GPUTexture *texture, SDL_GPUSampler *sampler) {
+    if (!Require(true, "BindFragmentSampler")) return;
+    if (slot >= 16 || !texture || !sampler) {
+        Fail("BindFragmentSampler: slot >= 16 or null texture/sampler");
+        return;
+    }
+    mBound.fsSamplers[slot] = { texture, sampler };
+    Reference(texture);
+    mCmds.push_back({ Cmd::FragmentSampler, slot, 0, 0, 0, 0, texture, sampler });
+}
+
+void Frame::Draw(Uint32 vertexCount, Uint32 firstVertex, Uint32 instanceCount) {
+    if (!Require(true, "Draw")) return;
+    if (!mBound.pipeline) {
+        Fail("Draw without a bound pipeline");
+        return;
+    }
+    if (vertexCount == 0 || instanceCount == 0) return;
+    mCmds.push_back({ Cmd::Draw, vertexCount, firstVertex, 0, instanceCount, 0, nullptr, nullptr });
+    mSegmentDraws++;
+    mStats.draws++;
+}
+
+void Frame::DrawIndexed(Uint32 indexCount, Uint32 firstIndex, Sint32 vertexOffset, Uint32 instanceCount) {
+    if (!Require(true, "DrawIndexed")) return;
+    if (!mBound.pipeline || !mBound.indexBuffer) {
+        Fail("DrawIndexed without a bound pipeline or index buffer");
+        return;
+    }
+    if (indexCount == 0 || instanceCount == 0) return;
+    mCmds.push_back({ Cmd::DrawIndexed, indexCount, firstIndex, 0, instanceCount, vertexOffset, nullptr, nullptr });
+    mSegmentDraws++;
+    mStats.draws++;
+}
+
+Uint32 Frame::StreamVertices(const void *data, Uint32 bytes) {
+    if (!Require(false, "StreamVertices")) return 0;
+    // mStream stays 16-byte aligned in size, so every batch starts 16-byte aligned on the GPU too.
+    Uint32 off = (Uint32)mStream.size();
+    mStream.resize(off + AlignUp(bytes, 16));
+    if (bytes) memcpy(mStream.data() + off, data, bytes);
+    mStats.streamBytes += bytes;
+    return off;
+}
+
+void Frame::BindStream(Uint32 streamOffset, Uint32 slot) {
+    if (!Require(true, "BindStream")) return;
+    if (slot >= 4) {
+        Fail("BindStream: slot >= 4");
+        return;
+    }
+    mBound.vertexBuffers[slot] = nullptr;
+    mBound.vertexOffsets[slot] = streamOffset;
+    mBound.vertexIsStream[slot] = true;
+    mCmds.push_back({ Cmd::StreamBinding, slot, streamOffset, 0, 0, 0, nullptr, nullptr });
+}
+
+void Frame::DrawStreamed(const void *vertices, Uint32 vertexCount, Uint32 stride) {
+    if (!Require(true, "DrawStreamed") || vertexCount == 0) return;
+    Uint32 off = StreamVertices(vertices, vertexCount * stride);
+    BindStream(off, 0);
+    Draw(vertexCount, 0, 1);
+}
+
+bool Frame::ResolveStream(Uint32 streamOffset, SDL_GPUBuffer **buffer, Uint32 *offset) const {
+    for (const StreamChunk &c : mChunks) {
+        if (streamOffset >= c.streamBegin && streamOffset < c.streamEnd) {
+            *buffer = c.buffer;
+            *offset = c.gpuBase + (streamOffset - c.streamBegin);
+            return true;
+        }
+    }
+    return false;
+}
+
+void Frame::PushVertexUniform(Uint32 slot, const void *data, Uint32 bytes) {
+    if (!Require(false, "PushVertexUniform")) return;
+    if (slot >= 4 || bytes > 32768) {
+        Fail("PushVertexUniform: slot >= 4 or more than 32 KiB");
+        return;
+    }
+    if (mPassOpen) {
+        mCmds.push_back({ Cmd::VertexUniform, slot, Arena(data, bytes), bytes, 0, 0, nullptr, nullptr });
+    } else {
+        SDL_PushGPUVertexUniformData(mCmd, slot, data, bytes);
+    }
+}
+
+void Frame::PushFragmentUniform(Uint32 slot, const void *data, Uint32 bytes) {
+    if (!Require(false, "PushFragmentUniform")) return;
+    if (slot >= 4 || bytes > 32768) {
+        Fail("PushFragmentUniform: slot >= 4 or more than 32 KiB");
+        return;
+    }
+    if (mPassOpen) {
+        mCmds.push_back({ Cmd::FragmentUniform, slot, Arena(data, bytes), bytes, 0, 0, nullptr, nullptr });
+    } else {
+        SDL_PushGPUFragmentUniformData(mCmd, slot, data, bytes);
+    }
+}
+
+void Frame::InPass(std::function<void(SDL_GPUCommandBuffer *, SDL_GPURenderPass *)> fn) {
+    if (!Require(true, "InPass")) return;
+    mCmds.push_back({ Cmd::InPassFn, (Uint32)mInPassFns.size(), 0, 0, 0, 0, nullptr, nullptr });
+    mInPassFns.push_back(std::move(fn));
+}
+
+bool Frame::OutsidePass(std::function<void(SDL_GPUCommandBuffer *)> fn) {
+    if (!Require(false, "OutsidePass")) return false;
+    if (mPassOpen) {
+        Fail("OutsidePass while a pass is open");
+        return false;
+    }
+    if (!FlushCopies()) return false;  // keep queued uploads ahead of the callback's work
+    fn(mCmd);
+    return true;
+}
+
+// ---- uploads ------------------------------------------------------------------------------------
+
+void Frame::UploadTexture(SDL_GPUTexture *texture, SDL_GPUTextureFormat format, Uint32 x, Uint32 y, Uint32 w, Uint32 h,
+                          const void *data, Uint32 rowPitch, bool wholeTexture, Uint32 layer, Uint32 mipLevel) {
+    if (!texture || !data || w == 0 || h == 0) {
+        Fail("UploadTexture: null texture/data or empty region");
+        return;
+    }
+    const Uint32 texel = SDL_GPUTextureFormatTexelBlockSize(format);
+    if (texel == 0) {
+        Fail("UploadTexture: unknown texel size");
+        return;
+    }
+    SplitIfReferenced(texture);
+    const Uint32 row = w * texel;
+    if (rowPitch == 0) rowPitch = row;
+    const Uint32 off = AlignUp((Uint32)mUploadBytes.size(), 16);
+    mUploadBytes.resize(off + row * h);
+    const Uint8 *src = (const Uint8 *)data;
+    if (rowPitch == row) {
+        memcpy(mUploadBytes.data() + off, src, (size_t)row * h);
+    } else {
+        for (Uint32 r = 0; r < h; r++) memcpy(mUploadBytes.data() + off + r * row, src + (size_t)r * rowPitch, row);
+    }
+    PendingUpload u;
+    SDL_zero(u);
+    u.texture = texture;
+    u.srcOffset = off;
+    u.x = x;
+    u.y = y;
+    u.w = w;
+    u.h = h;
+    u.layer = layer;
+    u.mip = mipLevel;
+    u.cycle = wholeTexture;
+    mUploads.push_back(u);
+}
+
+void Frame::UploadTexture(const Texture &texture, const void *data, Uint32 rowPitch) {
+    UploadTexture(texture.Handle(), texture.Format(), 0, 0, texture.Width(), texture.Height(), data, rowPitch,
+                  texture.Desc().layers <= 1 && texture.Desc().levels <= 1);
+}
+
+void Frame::UploadTexture(const Texture &texture, Uint32 x, Uint32 y, Uint32 w, Uint32 h, const void *data, Uint32 rowPitch) {
+    if (x + w > texture.Width() || y + h > texture.Height()) {
+        Fail("UploadTexture: region outside the texture");
+        return;
+    }
+    const bool whole = x == 0 && y == 0 && w == texture.Width() && h == texture.Height() &&
+                       texture.Desc().layers <= 1 && texture.Desc().levels <= 1;
+    UploadTexture(texture.Handle(), texture.Format(), x, y, w, h, data, rowPitch, whole);
+}
+
+void Frame::UploadBuffer(SDL_GPUBuffer *buffer, Uint32 offset, const void *data, Uint32 bytes, bool wholeBuffer) {
+    if (!buffer || !data || bytes == 0) {
+        Fail("UploadBuffer: null buffer/data or zero size");
+        return;
+    }
+    SplitIfReferenced(buffer);
+    const Uint32 off = AlignUp((Uint32)mUploadBytes.size(), 16);
+    mUploadBytes.resize(off + bytes);
+    memcpy(mUploadBytes.data() + off, data, bytes);
+    PendingUpload u;
+    SDL_zero(u);
+    u.buffer = buffer;
+    u.srcOffset = off;
+    u.dstOffset = offset;
+    u.size = bytes;
+    u.cycle = wholeBuffer;
+    mUploads.push_back(u);
+}
+
+bool Frame::EnsureTransfer(Uint32 bytes) {
+    if (mTransfer && mTransferSize >= bytes) return true;
+    SDL_GPUDevice *dev = mDevice.Handle();
+    Uint32 size = mTransferSize ? mTransferSize : mDevice.Config().initialTransferBytes;
+    while (size < bytes) size *= 2;
+    if (mTransfer) SDL_ReleaseGPUTransferBuffer(dev, mTransfer);
+    SDL_GPUTransferBufferCreateInfo info;
+    SDL_zero(info);
+    info.usage = SDL_GPU_TRANSFERBUFFERUSAGE_UPLOAD;
+    info.size = size;
+    mTransfer = SDL_CreateGPUTransferBuffer(dev, &info);
+    mTransferSize = mTransfer ? size : 0;
+    if (!mTransfer) FailSdl("SDL_CreateGPUTransferBuffer (upload)");
+    return mTransfer != nullptr;
+}
+
+// Runs queued uploads and not yet uploaded stream data in one copy pass on mCmd.
+bool Frame::FlushCopies() {
+    const Uint32 streamPending = (Uint32)mStream.size() - mStreamUploaded;
+    if (mUploads.empty() && streamPending == 0) return true;
+    const Uint32 uploadBytes = AlignUp((Uint32)mUploadBytes.size(), 16);
+    if (!EnsureTransfer(uploadBytes + streamPending)) return false;
+
+    SDL_GPUDevice *dev = mDevice.Handle();
+    Uint8 *mapped = (Uint8 *)SDL_MapGPUTransferBuffer(dev, mTransfer, true);
+    if (!mapped) {
+        FailSdl("SDL_MapGPUTransferBuffer (upload)");
+        return false;
+    }
+    if (!mUploadBytes.empty()) memcpy(mapped, mUploadBytes.data(), mUploadBytes.size());
+    if (streamPending) memcpy(mapped + uploadBytes, mStream.data() + mStreamUploaded, streamPending);
+    SDL_UnmapGPUTransferBuffer(dev, mTransfer);
+
+    // Stream data goes into the current stream buffer, or a bigger one when it does not fit.
+    bool streamCycle = false;
+    if (streamPending) {
+        if (!mStreamBuffer || mStreamGpuUsed + streamPending > mStreamCapacity) {
+            Uint32 cap = mStreamCapacity ? mStreamCapacity : mDevice.Config().initialStreamBytes;
+            while (cap < streamPending * 2 || cap < mStreamGpuUsed + streamPending) cap *= 2;
+            if (mStreamBuffer) {
+                if (mStreamGpuUsed > 0) mRetiredStream.push_back(mStreamBuffer);
+                else SDL_ReleaseGPUBuffer(dev, mStreamBuffer);
+                mStats.streamBufferGrowths++;
+            }
+            mStreamBuffer = mDevice.CreateBuffer(SDL_GPU_BUFFERUSAGE_VERTEX, cap, "SIM_GPU vertex stream");
+            mStreamCapacity = mStreamBuffer ? cap : 0;
+            mStreamGpuUsed = 0;
+            if (!mStreamBuffer) {
+                mFailed = true;
+                return false;
+            }
+        }
+        // First write of the frame into this buffer: give it fresh storage instead of waiting for
+        // the frames in flight that still draw from it.
+        streamCycle = mStreamGpuUsed == 0;
+    }
+
+    SDL_GPUCopyPass *copy = SDL_BeginGPUCopyPass(mCmd);
+    if (!copy) {
+        FailSdl("SDL_BeginGPUCopyPass");
+        return false;
+    }
+    for (const PendingUpload &u : mUploads) {
+        if (u.texture) {
+            SDL_GPUTextureTransferInfo src;
+            SDL_zero(src);
+            src.transfer_buffer = mTransfer;
+            src.offset = u.srcOffset;
+            src.pixels_per_row = u.w;
+            src.rows_per_layer = u.h;
+            SDL_GPUTextureRegion dst;
+            SDL_zero(dst);
+            dst.texture = u.texture;
+            dst.mip_level = u.mip;
+            dst.layer = u.layer;
+            dst.x = u.x;
+            dst.y = u.y;
+            dst.w = u.w;
+            dst.h = u.h;
+            dst.d = 1;
+            SDL_UploadToGPUTexture(copy, &src, &dst, u.cycle);
+        } else {
+            SDL_GPUTransferBufferLocation src = { mTransfer, u.srcOffset };
+            SDL_GPUBufferRegion dst = { u.buffer, u.dstOffset, u.size };
+            SDL_UploadToGPUBuffer(copy, &src, &dst, u.cycle);
+        }
+    }
+    if (streamPending) {
+        SDL_GPUTransferBufferLocation src = { mTransfer, uploadBytes };
+        SDL_GPUBufferRegion dst = { mStreamBuffer, mStreamGpuUsed, streamPending };
+        SDL_UploadToGPUBuffer(copy, &src, &dst, streamCycle);
+        mChunks.push_back({ mStreamBuffer, mStreamUploaded, (Uint32)mStream.size(), mStreamGpuUsed });
+        mStreamGpuUsed += streamPending;
+        mStreamUploaded = (Uint32)mStream.size();
+    }
+    SDL_EndGPUCopyPass(copy);
+    mStats.copyPasses++;
+    mStats.uploadBytes += mUploadBytes.size();
+    mUploads.clear();
+    mUploadBytes.clear();
+    return true;
+}
+
+// ---- presentation and submission ----------------------------------------------------------------
+
+SDL_GPUTexture *Frame::AcquireSwapchain(Uint32 *width, Uint32 *height) {
+    if (!Require(false, "AcquireSwapchain")) return nullptr;
+    if (!mSwapchainAcquired) {
+        mSwapchainAcquired = true;
+        mSwapchain = nullptr;
+        mSwapchainW = mSwapchainH = 0;
+        if (mDevice.Window() &&
+            !SDL_WaitAndAcquireGPUSwapchainTexture(mCmd, mDevice.Window(), &mSwapchain, &mSwapchainW, &mSwapchainH)) {
+            FailSdl("SDL_WaitAndAcquireGPUSwapchainTexture");
+            mSwapchain = nullptr;
+        }
+    }
+    if (width) *width = mSwapchainW;
+    if (height) *height = mSwapchainH;
+    return mSwapchain;
+}
+
+void Frame::Present(SDL_GPUTexture *source, Uint32 width, Uint32 height, SDL_GPUFilter filter) {
+    if (!Require(false, "Present")) return;
+    mPresentSource = source;
+    mPresentW = width;
+    mPresentH = height;
+    mPresentFilter = filter;
+}
+
+bool Frame::End() {
+    if (!mActive) {
+        mDevice.ReportFailure("Frame::End without BeginFrame", false);
+        return false;
+    }
+    if (mPassOpen) {
+        Fail("Frame::End with a pass still open (closing it)");
+        CloseSegment(false);
+    }
+    FlushCopies();
+
+    if (mPresentSource && mDevice.Window()) {
+        Uint32 sw = 0, sh = 0;
+        SDL_GPUTexture *swap = AcquireSwapchain(&sw, &sh);
+        if (swap) {
+            SDL_GPUBlitInfo blit;
+            SDL_zero(blit);
+            blit.source.texture = mPresentSource;
+            blit.source.w = mPresentW;
+            blit.source.h = mPresentH;
+            blit.destination.texture = swap;
+            blit.destination.w = sw;
+            blit.destination.h = sh;
+            blit.load_op = SDL_GPU_LOADOP_DONT_CARE;
+            blit.filter = mPresentFilter;
+            SDL_BlitGPUTexture(mCmd, &blit);
+        }
+    }
+
+    if (!SDL_SubmitGPUCommandBuffer(mCmd)) FailSdl("SDL_SubmitGPUCommandBuffer");
+    mCmd = nullptr;
+    mActive = false;
+    SDL_GPUDevice *dev = mDevice.Handle();
+    for (SDL_GPUBuffer *b : mRetiredStream) SDL_ReleaseGPUBuffer(dev, b);  // freed once the GPU is done
+    mRetiredStream.clear();
+    mChunks.clear();
+    mDevice.ApplyPresentMode();
+    return !mFailed;
+}
+
+} // namespace SIM::Gpu
