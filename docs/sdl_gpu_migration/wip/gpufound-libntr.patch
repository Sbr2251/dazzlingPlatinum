+}
+
+bool Device::FlushUploads() {
+    if (!mDevice) return false;
+    if (mFrame->mActive) {
+        ReportFailure("FlushUploads inside a frame (uploads run before the next pass automatically)", false);
+        return false;
+    }
+    if (mFrame->mUploads.empty()) return true;
+    SDL_GPUCommandBuffer *cmd = SDL_AcquireGPUCommandBuffer(mDevice);
+    if (!cmd) {
+        ReportFailure("SDL_AcquireGPUCommandBuffer (FlushUploads)");
+        return false;
+    }
+    mFrame->mCmd = cmd;
+    bool ok = mFrame->FlushCopies();
+    mFrame->mCmd = nullptr;
+    if (!SDL_SubmitGPUCommandBuffer(cmd)) {
+        ReportFailure("SDL_SubmitGPUCommandBuffer (FlushUploads)");
+        ok = false;
+    }
+    return ok;
+}
+
+SDL_GPUBuffer *Device::CreateBuffer(SDL_GPUBufferUsageFlags usage, Uint32 bytes, const char *name) {
+    if (!mDevice) return nullptr;
+    SDL_GPUBufferCreateInfo info;
+    SDL_zero(info);
+    info.usage = usage;
+    info.size = bytes;
+    SDL_PropertiesID props = 0;
+    if (name) {
+        props = SDL_CreateProperties();
+        SDL_SetStringProperty(props, SDL_PROP_GPU_BUFFER_CREATE_NAME_STRING, name);
+        info.props = props;
+    }
+    SDL_GPUBuffer *buffer = SDL_CreateGPUBuffer(mDevice, &info);
+    if (props) SDL_DestroyProperties(props);
+    if (!buffer) ReportFailure("SDL_CreateGPUBuffer");
+    return buffer;
+}
+
+bool Device::EnsureDownload(Uint32 bytes) {
+    if (mDownload && mDownloadSize >= bytes) return true;
+    if (mDownload) SDL_ReleaseGPUTransferBuffer(mDevice, mDownload);
+    SDL_GPUTransferBufferCreateInfo info;
+    SDL_zero(info);
+    info.usage = SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD;
+    info.size = bytes;
+    mDownload = SDL_CreateGPUTransferBuffer(mDevice, &info);
+    mDownloadSize = mDownload ? bytes : 0;
+    if (!mDownload) ReportFailure("SDL_CreateGPUTransferBuffer (download)");
+    return mDownload != nullptr;
+}
+
+bool Device::ReadbackRaw(SDL_GPUTexture *texture, SDL_GPUTextureFormat format, Uint32 x, Uint32 y, Uint32 w, Uint32 h,
+                         std::vector<Uint8> &out) {
+    out.clear();
+    if (!mDevice || !texture || w == 0 || h == 0) {
+        ReportFailure("Readback: no device, texture or region", false);
+        return false;
+    }
+    if (mFrame->mActive) {
+        ReportFailure("Readback inside a frame: call Frame::End() first", false);
+        return false;
+    }
+    const Uint32 bytes = SDL_CalculateGPUTextureFormatSize(format, w, h, 1);
+    if (bytes == 0 || !EnsureDownload(bytes)) return false;
+
+    // Queued uploads may target the texture being read: run them first.
+    if (!mFrame->mUploads.empty() && !FlushUploads()) return false;
+
+    SDL_GPUCommandBuffer *cmd = SDL_AcquireGPUCommandBuffer(mDevice);
+    if (!cmd) {
+        ReportFailure("SDL_AcquireGPUCommandBuffer (readback)");
+        return false;
+    }
+    SDL_GPUCopyPass *copy = SDL_BeginGPUCopyPass(cmd);
+    if (!copy) {
+        ReportFailure("SDL_BeginGPUCopyPass (readback)");
+        SDL_CancelGPUCommandBuffer(cmd);
+        return false;
+    }
+    SDL_GPUTextureRegion src;
+    SDL_zero(src);
+    src.texture = texture;
+    src.x = x;
+    src.y = y;
+    src.w = w;
+    src.h = h;
+    src.d = 1;
+    SDL_GPUTextureTransferInfo dst;
+    SDL_zero(dst);
+    dst.transfer_buffer = mDownload;
+    dst.offset = 0;
+    dst.pixels_per_row = w;
+    dst.rows_per_layer = h;
+    SDL_DownloadFromGPUTexture(copy, &src, &dst);
+    SDL_EndGPUCopyPass(copy);
+    SDL_GPUFence *fence = SDL_SubmitGPUCommandBufferAndAcquireFence(cmd);
+    if (!fence) {
+        ReportFailure("SDL_SubmitGPUCommandBufferAndAcquireFence (readback)");
+        return false;
+    }
+    bool ok = SDL_WaitForGPUFences(mDevice, true, &fence, 1);
+    SDL_ReleaseGPUFence(mDevice, fence);
+    if (!ok) {
+        ReportFailure("SDL_WaitForGPUFences (readback)");
+        return false;
+    }
+    const Uint8 *mapped = (const Uint8 *)SDL_MapGPUTransferBuffer(mDevice, mDownload, false);
+    if (!mapped) {
+        ReportFailure("SDL_MapGPUTransferBuffer (readback)");
+        return false;
+    }
+    out.assign(mapped, mapped + bytes);
+    SDL_UnmapGPUTransferBuffer(mDevice, mDownload);
+    return true;
+}
+
+bool Device::ReadbackRGBA8(SDL_GPUTexture *texture, SDL_GPUTextureFormat format, Uint32 x, Uint32 y, Uint32 w, Uint32 h,
+                           std::vector<Uint8> &out) {
+    bool swap;
+    switch (format) {
+    case SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM:
+    case SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM_SRGB:
+        swap = false;
+        break;
+    case SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM:
+    case SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM_SRGB:
+        swap = true;
+        break;
+    default:
+        ReportFailure("ReadbackRGBA8: the texture is not an RGBA8/BGRA8 format (use ReadbackRaw)", false);
+        return false;
+    }
+    if (!ReadbackRaw(texture, format, x, y, w, h, out)) return false;
+    if (swap) {
+        for (size_t i = 0; i + 3 < out.size(); i += 4) {
+            Uint8 t = out[i];
+            out[i] = out[i + 2];
+            out[i + 2] = t;
+        }
+    }
+    return true;
+}
+
+bool Device::ReadbackRGBA8(const Texture &texture, std::vector<Uint8> &out) {
+    return ReadbackRGBA8(texture.Handle(), texture.Format(), 0, 0, texture.Width(), texture.Height(), out);
+}
+
+bool Device::WaitIdle() {
+    if (!mDevice) return false;
+    if (!SDL_WaitForGPUIdle(mDevice)) {
+        ReportFailure("SDL_WaitForGPUIdle");
+        return false;
+    }
+    return true;
+}
