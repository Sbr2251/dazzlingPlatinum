+void Device::UploadTexture(const Texture &texture, const void *data, Uint32 rowPitch) {
+    if (mFrame) mFrame->UploadTexture(texture, data, rowPitch);
+}
+
+void Device::UploadTexture(const Texture &texture, Uint32 x, Uint32 y, Uint32 w, Uint32 h, const void *data, Uint32 rowPitch) {
+    if (mFrame) mFrame->UploadTexture(texture, x, y, w, h, data, rowPitch);
+}
