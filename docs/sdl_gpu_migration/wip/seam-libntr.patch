+// Render backend selection (SIM_RENDERER=gl|gpu, read once).
+#include <simulator/sim_render_backend.hpp>
+
+#include "render_gl/sim_render_gl.hpp"
+#include "render_gpu/sim_render_gpu.hpp"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+namespace SIM::Render {
+
+namespace detail {
+Backend *gBackend = nullptr;
+}
+
+Backend &Select() {
+  if (detail::gBackend) return *detail::gBackend;
+  const char *e = getenv("SIM_RENDERER");
+  if (e && strcmp(e, "gpu") == 0) {
+    detail::gBackend = CreateGpuBackend();
+  } else if (e && *e && strcmp(e, "gl") != 0) {
+    fprintf(stderr, "SIM_RENDERER=%s: unknown renderer, using gl\n", e);
+  }
+  if (!detail::gBackend) detail::gBackend = CreateGlBackend();
+  return *detail::gBackend;
+}
+
