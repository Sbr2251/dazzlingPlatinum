diff --git a/include/simulator/sim_render_backend.hpp b/include/simulator/sim_render_backend.hpp
new file mode 100644
index 0000000..dd83550
--- /dev/null
+++ b/include/simulator/sim_render_backend.hpp
@@ -0,0 +1,321 @@
+#ifndef LIBNTR_SIM_RENDER_BACKEND_HPP
+#define LIBNTR_SIM_RENDER_BACKEND_HPP
+
+// Render backend interface of the simulator.
+//
+// Every GPU API call of the simulator goes through SIM::Render::Backend. The DS emulation code (G3 command processing,
+// 2D register decoding, PostFX effect timing) decides WHAT is drawn and fills the plain structs below; a backend only
+// turns them into GPU work. One backend is selected at startup (SIM_RENDERER=gl|gpu, read once, default gl):
+//   gl   OpenGL 4.1/4.2 core (libraries/sim/src/render_gl), the reference renderer.
+//   gpu  SDL3 GPU API (libraries/sim/src/render_gpu). Until it is implemented it reports so and the GL backend is used.
+//
+// ---------------------------------------------------------------------------------------------------------------
+// THREADING
+//   All methods are called from one thread: the thread that runs NitroMain. On the PC targets that is the process main
+//   thread, which also calls SIM_RenderInit before NitroMain starts and runs SIM_Render from OS_WaitIrq (VBlank). No
+//   method is ever called concurrently. The GL backend needs its context current on that thread
+//   (SIM::AcquireRenderContext / ReleaseRenderContext do that; they are no-ops for a backend without a GL context).
+//
+// FRAME LIFECYCLE (one emulated VBlank = one SIM_Render call)
+//   startup:  PreWindowCreate -> (window is created with WindowFlags()) -> Init -> ImGuiInit
+//   3D:       G3BeginFrame ... G3Draw* / G3ClearTarget* / CreateTexture / UpdateTexture / DestroyTexture ... G3EndFrame
+//             The game issues G3 work at any time while its frame runs. G3BeginFrame is called at the end of SIM_Render,
+//             G3EndFrame at the start of the next SIM_Render (after the last pending draws, including the deferred
+//             translucent ones, were submitted). G3ClearTarget is normally called right after G3BeginFrame (from
+//             SIM_PostRenderVBlank, only on frames where the game swapped its 3D buffers), but may come at any point
+//             inside the 3D frame and must then be ordered with the draws around it. The 3D target is NOT cleared
+//             otherwise: frames without a G3 swap draw over the previous contents.
+//   2D:       BeginFrame -> ImGuiNewFrame -> CompositeEngine(main) -> CompositeEngine(sub) -> RenderPost -> ImGuiRender
+//             -> [ReadPixels*] -> Present
+//             CompositeEngine samples the 3D target as BG0, so everything submitted before G3EndFrame must be visible
+//             to it. While the game is paused the 2D sequence repeats (several BeginFrame..Present rounds) without a 3D
+//             frame in between. ReadPixels is only valid between ImGuiRender and Present and returns the image Present
+//             is about to show (composite + post + ImGui).
+//   any time: SetSwapInterval, GetSwapInterval, GetFrameSize, DebugMarker. SetInternalResolution is called between
+//             Present and G3BeginFrame.
+//   Outside a 3D frame: the game can submit G3 work before the first G3BeginFrame (during boot) and from its VBlank
+//   handler (which runs inside SIM_Render, between CompositeEngine and Present). The GL backend executes such draws
+//   against whatever is currently bound (legacy behaviour); a recording backend should append them to the next 3D
+//   frame. Texture create/destroy can happen at any time.
+//
+// OWNERSHIP
+//   Every pointer passed in (vertices, fog tables, layer pixels, VRAM/OAM/palette data, uniform structs, screen quad)
+//   is owned by the caller and valid only for the duration of the call. A backend that defers work must copy what it
+//   needs. Pixel buffers returned by ReadPixels are caller-allocated (w * h * 4 bytes). Texture handles are owned by the
+//   caller until DestroyTexture; a backend that records work must keep the texture alive until recorded draws that use
+//   it have executed.
+//
+// COORDINATE CONVENTIONS (shared by both backends; the shaders in libraries/sim/src/shaders depend on them)
+//   - "Combined display" = 256 x 384, the two DS screens stacked. Every 256 x 384 layer image and the 3D target store
+//     the TOP screen in the upper half of the image as sampled with v in [0.5, 1] (v = 0 is the bottom edge). CPU layer
+//     pixels (G2CpuLayers) are rows bottom-up: row 0 is the bottom line of the bottom screen, row 383 the top line of
+//     the top screen.
+//   - G3 vertices are in clip space with +y up (GL / SDL_GPU NDC). Window winding is evaluated in that space.
+//   - FrameParams::view and ReadPixels use window pixels with a TOP-LEFT origin.
+//   - PostFXParams UVs use v = 0 at the BOTTOM of the window (the post shader's fragTexCoord convention).
+// ---------------------------------------------------------------------------------------------------------------
+
+#include <nitro/types.h>
+
+#include <cstddef>
+#include <cstdint>
+
+struct SDL_Window;
+struct ImDrawData;
+
+namespace SIM::G3 {
+
+// One G3 vertex as the backend receives it (40 bytes, tightly packed). Position is clip space after the DS viewport
+// transform and depth mapping (x, y, z used; w is carried but not read by the shaders), texcoord in texture UVs
+// (0..1 per texture repeat), colour 0..1.
+struct RenderVertex {
+	//Position
+	float x;
+	float y;
+	float z;
+	float w;
+	//TexCoord
+	float s;
+	float t;
+	//Color
+	float r;
+	float g;
+	float b;
+	float a;
+};
+
+}
+
+namespace SIM::Render {
+
+// Backend-neutral 3D texture handle. 0 is "no texture".
+using TextureHandle = std::uint64_t;
+constexpr TextureHandle kNoTexture = 0;
+
+enum class Screen : u8 { Bottom = 0, Top = 1 };
+
+// ---- 3D ----------------------------------------------------------------------------------------------------------
+
+// Texture addressing. ClampToBorder = transparent black (0,0,0,0) outside [0,1]; SDL_GPU has no border colour, so
+// that backend emulates it (a border texel has alpha 0 and is discarded by the shader's alpha < 0.05 test).
+enum class WrapMode : u8 { Repeat, MirroredRepeat, ClampToBorder };
+
+// Which triangles are NOT drawn, by window winding in +y-up clip space. All = nothing is drawn (DS GX_CULL_ALL).
+enum class CullWinding : u8 { None, Clockwise, CounterClockwise, All };
+
+enum class DepthFunc : u8 { Less, Equal };
+
+// Fully specified state of one G3 draw. Fixed for every draw (not in the struct): triangle list, blending
+// src*srcAlpha + dst*(1-srcAlpha) on colour AND alpha (the compositor relies on the resulting alpha), depth test on,
+// G3 shader (shaders/g3_*.glsl), target = the 3D target at the screen/scale of the enclosing G3BeginFrame.
+struct G3DrawState {
+  TextureHandle texture = kNoTexture;  // kNoTexture: untextured (vertex colour only)
+  WrapMode wrapS = WrapMode::Repeat;   // only meaningful with a texture
+  WrapMode wrapT = WrapMode::Repeat;
+  u8 polygonMode = 0;                  // DS polygon mode: 0 modulate (texel * vertex colour), else texel only
+  CullWinding cull = CullWinding::None;
+  DepthFunc depthFunc = DepthFunc::Less;
+  bool depthWrite = true;
+  bool fogEnabled = false;
+  const float *fogColor = nullptr;          // 4 floats (rgba 0..1), valid when fogEnabled
+  const float *fogDepthBoundary = nullptr;  // 32 floats, clip-space z boundaries, valid when fogEnabled
+  const float *fogDensity = nullptr;        // 32 floats, 0..1, valid when fogEnabled
+};
+
+// The 3D target is 256*scale x 384*scale; each frame renders into one screen half of it (viewport 256*scale x
+// 192*scale). screen and scale are latched once per frame (POWCNT bit 15 and the internal resolution at the end of
+// SIM_Render), so every draw of the frame uses them.
+struct G3FrameParams {
+  Screen screen = Screen::Bottom;
+  int scale = 1;
+};
+
+// ---- 2D compositing ----------------------------------------------------------------------------------------------
+
+// Uniforms of the compositing shader (shaders/g2_fragment.glsl), one engine.
+struct G2CompositeUniforms {
+  float backdropColor[4];
+  s32 bgOrder[4];
+  s32 bgPriorities[4];
+  s32 bldcnt;
+  s32 bldalpha;
+  s32 bldy;
+  s32 topScreen;     // 1: this engine is the top screen (the shader keeps v >= 0.5), 0: bottom (v < 0.5)
+  s32 dispcnt;
+  s32 winout;
+  s32 bg0as3d;
+  float masterBrightFactor;
+  s32 masterBrightMode;
+};
+
+// What the compositor samples as bgTexture[i].
+enum class LayerSource : u8 {
+  Empty,     // transparent black
+  Layer,     // the engine's BG layer image i (as uploaded by G2CpuLayers or rendered by the GPU 2D pass)
+  G3Target,  // the 3D target (BG0 as 3D)
+};
+
+// CPU-rendered layers: 256 x 384 RGBA8, rows bottom-up (see COORDINATE CONVENTIONS). nullptr = leave that layer
+// image as it is. Layer images are shared by both engines: each engine only ever samples its own screen half.
+struct G2CpuLayers {
+  const u8 *bg[4];
+  const u8 *obj[4];      // OBJ layers by priority 0..3
+  const u8 *objWindow;   // OBJ window mask (alpha > 0.1 = inside)
+};
+
+// GPU 2D layer pass (shaders/g2gpu_*.glsl): renders BG 0-3, OBJ priority 0-3 and the OBJ window mask of one engine
+// from VRAM/OAM/palette data into the layer images, before compositing. Each pass first clears this engine's screen
+// half of its layer image to (0,0,0,0) and only touches that half.
+struct G2GpuLayerParams {
+  // shader uniforms
+  s32 isSub;
+  s32 topScreen;
+  s32 dispcnt;
+  s32 bgMode;
+  s32 extPlttBase;   // byte offset of the BG extended palettes in lcdc
+  s32 bgcnt[4];
+  s32 bgofs[4];      // HOFS | VOFS << 16
+  s32 affA[4], affB[4], affC[4], affD[4];
+  s32 affX[4], affY[4];
+  s32 win0h, win0v, winin, winout;
+  // passes
+  s32 bgRender[4];       // 0: BG layer i is only cleared
+  s32 objEnabled;        // 0: OBJ layers and window are only cleared
+  s32 objCount[5];       // candidate sprites per OBJ priority 0..3, [4] = OBJ window sprites
+  s32 objList[5][128];   // ascending OAM indices, objCount[n] valid entries each
+  // data, uploaded before the passes (the backend may skip uploads of unchanged data)
+  const void *bgVram;    // this engine's BG VRAM, bgVramSize bytes (multiple of 2048)
+  u32 bgVramSize;
+  const void *objVram;   // this engine's OBJ VRAM, objVramSize bytes (multiple of 1024)
+  u32 objVramSize;
+  const void *lcdc;      // 0xA4000 bytes of LCDC VRAM (extended palettes), nullptr = not used by this engine
+  const void *oam;       // this engine's OAM, 1024 bytes (row isSub of the OAM data)
+  const void *palettes[4];  // 512 bytes each: BG main, OBJ main, BG sub, OBJ sub (all four, every pass)
+};
+
+// Composite one engine into the frame's composite image, inside FrameParams::view. Exactly one of cpu / gpu is set.
+// The draw is alpha-blended (src*srcAlpha + dst*(1-srcAlpha)) over the composite image; the shader discards the other
+// engine's screen half.
+struct G2CompositeInput {
+  bool isSub = false;
+  LayerSource bgSource[4] = {};
+  const G2CpuLayers *cpu = nullptr;
+  const G2GpuLayerParams *gpu = nullptr;
+  G2CompositeUniforms uniforms = {};
+  // Display quad(s) for the current screen layout, triangle list in clip space; x, y, z and s, t are used.
+  const G3::RenderVertex *screenQuad = nullptr;
+  int screenQuadVertexCount = 0;
+};
+
+// ---- frame, post pass, present -----------------------------------------------------------------------------------
+
+struct Rect {
+  int x, y, w, h;
+};
+
+struct FrameParams {
+  int frameWidth;   // window size in pixels (GetFrameSize); the composite image has this size
+  int frameHeight;
+  Rect view;        // where the combined display is composited, window pixels, top-left origin
+};
+
+// Uniforms of the post shader (shaders/post_fragment.glsl). The post pass draws the composite image over the whole
+// window, alpha-blended over opaque black.
+struct PostFXParams {
+  float texelSize[2];
+  float shakeOffset[2];
+  float shockCenter[2];
+  float shockRadius;
+  float shockStrength;
+  float zoomCenter[2];
+  float zoomBlur;
+  float vignetteColor[3];
+  float vignetteAmount;
+  float chromaAmount;
+  float glowAmount;
+  float letterbox;
+  s32 fxRegion;
+  float beamTarget[2];
+  float cutinProgress;
+  float cutinAlpha;
+  float titleProgress;
+  float titleAlpha;
+  float glowCenter[2];
+  float glowAtAmount;
+};
+
+// ---- backend -----------------------------------------------------------------------------------------------------
+
+struct InitParams {
+  int windowWidth;     // initial window size
+  int windowHeight;
+  int internalScale;   // initial internal resolution scale of the 3D target
+};
+
+class Backend {
+ public:
+  virtual ~Backend() = default;
+
+  virtual const char *Name() const = 0;
+
+  // -- startup
+  // Before the window exists (GL: context attributes).
+  virtual void PreWindowCreate(int swapInterval) = 0;
+  // SDL window flags the window must be created with (SDL_WindowFlags value, e.g. SDL_WINDOW_OPENGL).
+  virtual std::uint64_t WindowFlags() const = 0;
+  // Creates the device/context for the window and all fixed resources. Ends by presenting one black frame.
+  virtual bool Init(SDL_Window *window, const InitParams &params) = 0;
+
+  // -- 3D
+  virtual void G3BeginFrame(const G3FrameParams &params) = 0;
+  virtual void G3EndFrame() = 0;
+  // Clears the whole 3D target (both halves): colour (0,0,0,0), depth 1.0.
+  virtual void G3ClearTarget() = 0;
+  // verts: count vertices, a triangle list. count > 0.
+  virtual void G3Draw(const G3DrawState &state, const G3::RenderVertex *verts, std::size_t count) = 0;
+  // 3D textures: RGBA8, rows in upload order (row 0 = t 0), nearest filtering.
+  virtual TextureHandle CreateTexture(int width, int height, const void *rgba8) = 0;
+  virtual void UpdateTexture(TextureHandle texture, int width, int height, const void *rgba8) = 0;
+  virtual void DestroyTexture(TextureHandle texture) = 0;
+  // Reallocates the 3D target for a new internal resolution scale (contents undefined afterwards).
+  virtual void SetInternalResolution(int scale) = 0;
+
+  // -- 2D / frame
+  // Starts the frame's composite image (resized to the frame size if needed) and clears it to opaque black.
+  virtual void BeginFrame(const FrameParams &params) = 0;
+  // GPU 2D layer pass availability (creates its resources on first call; false if they failed to build).
+  virtual bool G2GpuAvailable() = 0;
+  virtual void CompositeEngine(const G2CompositeInput &input) = 0;
+  virtual void RenderPost(const PostFXParams &params) = 0;
+  // Shows the frame, then clears the window image to opaque black for the next post pass.
+  virtual void Present() = 0;
+  // Window size in pixels (drawable size; can differ from the window size in points on high-DPI displays).
+  virtual void GetFrameSize(int *width, int *height) = 0;
+  // RGBA8, rows top-down, rect in window pixels with a top-left origin. out holds w * h * 4 bytes.
+  virtual bool ReadPixels(int x, int y, int w, int h, u8 *out) = 0;
+
+  // -- ImGui (Dear ImGui renderer backend + the SDL platform backend's init for this API)
+  virtual void ImGuiInit(SDL_Window *window) = 0;
+  virtual void ImGuiNewFrame() = 0;
+  virtual void ImGuiRender(ImDrawData *drawData) = 0;
+
+  // -- misc
+  virtual void SetSwapInterval(int interval) = 0;
+  virtual int GetSwapInterval() = 0;
+  // Debugger annotation (GL debug output / GPU debug label); may be ignored.
+  virtual void DebugMarker(const char *message, int length) = 0;
+};
+
+// Selects the backend from SIM_RENDERER (once; later calls return the same one). Called by SIM_RenderInit.
+Backend &Select();
+
+namespace detail {
+extern Backend *gBackend;
+}
+
+// The selected backend. Only valid after Select().
+inline Backend &Get() { return *detail::gBackend; }
+
+}
+
+#endif
