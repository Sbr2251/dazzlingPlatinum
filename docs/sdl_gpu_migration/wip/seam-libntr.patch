diff --git a/libraries/sim/src/render_gl/sim_render_gl_g3.cpp b/libraries/sim/src/render_gl/sim_render_gl_g3.cpp
new file mode 100644
index 0000000..82d6ccb
--- /dev/null
+++ b/libraries/sim/src/render_gl/sim_render_gl_g3.cpp
@@ -0,0 +1,154 @@
+// OpenGL render backend: G3 (3D) draws and textures.
+#include "sim_render_gl.hpp"
+
+#include <simulator/sim_g3_GlobalState.hpp>
+
+#include <string.h>
+#include <stddef.h>
+
+namespace SIM::Render {
+
+void GlBackend::G3Init() {
+    glGenVertexArrays(1, &mG3VertexArray);
+    glBindVertexArray(mG3VertexArray);
+
+    glGenBuffers(1, &mG3VertexBuffer);
+
+    glBindBuffer(GL_ARRAY_BUFFER, mG3VertexBuffer);
+
+    glEnableVertexAttribArray(0);
+    glEnableVertexAttribArray(1);
+    glEnableVertexAttribArray(2);
+    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, sizeof(G3::RenderVertex), (void*)offsetof(G3::RenderVertex, x));
+    glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, sizeof(G3::RenderVertex), (void*)offsetof(G3::RenderVertex, s));
+    glVertexAttribPointer(2, 4, GL_FLOAT, GL_FALSE, sizeof(G3::RenderVertex), (void*)offsetof(G3::RenderVertex, r));
+
+    glBindVertexArray(0);
+    glDisableVertexAttribArray(0);
+    glDisableVertexAttribArray(1);
+    glDisableVertexAttribArray(2);
+}
+
+void GlBackend::G3CacheUniformLocations() {
+    if(mG3UniformsCached) return;
+    mLocUseTexture = glGetUniformLocation(mG3Program, "useTexture");
+    mLocMyTexture = glGetUniformLocation(mG3Program, "myTexture");
+    mLocPolygonMode = glGetUniformLocation(mG3Program, "polygonMode");
+    mLocUseFog = glGetUniformLocation(mG3Program, "useFog");
+    mLocFogColor = glGetUniformLocation(mG3Program, "fogColor");
+    mLocFogDepthBoundary = glGetUniformLocation(mG3Program, "fogDepthBoundary");
+    mLocFogDensity = glGetUniformLocation(mG3Program, "fogDensity");
+    if(mLocMyTexture >= 0) glProgramUniform1i(mG3Program, mLocMyTexture, 0);
+    mLastUseTexture = -1; mLastPolygonMode = -1; mLastUseFog = -1;
+    mG3UniformsCached = true;
+    if(G3::gG3Stats.enabled) G3::gG3Stats.uniformLocCalls += 7;
+}
+
+static GLint GlWrap(WrapMode mode) {
+    switch(mode) {
+        case WrapMode::MirroredRepeat: return GL_MIRRORED_REPEAT;
+        case WrapMode::Repeat:         return GL_REPEAT;
+        default:                       return GL_CLAMP_TO_BORDER;
+    }
+}
+
+void GlBackend::G3Draw(const G3DrawState &state, const G3::RenderVertex *verts, std::size_t vertsCount) {
+    G3CacheUniformLocations();
+    if(vertsCount == 0) return;
+
+    glBindVertexArray(mG3VertexArray);
+    glBindBuffer(GL_ARRAY_BUFFER, mG3VertexBuffer);
+
+    if(mG3VertexBufferCount >= vertsCount) {
+        glBufferSubData(GL_ARRAY_BUFFER, 0, sizeof(G3::RenderVertex) * vertsCount, verts);
+    } else {
+        glBufferData(GL_ARRAY_BUFFER, sizeof(G3::RenderVertex) * vertsCount, verts, GL_DYNAMIC_DRAW);
+        mG3VertexBufferCount = vertsCount;
+    }
+
+    // Handle texture
+    if(state.texture == kNoTexture) {
+        if(mLastUseTexture != 0) { glProgramUniform1i(mG3Program, mLocUseTexture, 0); mLastUseTexture = 0; }
+    } else {
+        const GLuint texId = (GLuint)state.texture;
+        glActiveTexture(GL_TEXTURE0);
+        glBindTexture(GL_TEXTURE_2D, texId);
+
+        // Wrap modes are texture state in GL: re-set them only when the texture or the modes change
+        const int wrapS = GlWrap(state.wrapS);
+        const int wrapT = GlWrap(state.wrapT);
+        const bool wrapChanged = (texId != mLastWrapTexture || wrapS != mLastWrapS || wrapT != mLastWrapT);
+        if(wrapChanged) {
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, wrapS);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, wrapT);
+            mLastWrapTexture = texId; mLastWrapS = wrapS; mLastWrapT = wrapT;
+        }
+        if(mLastUseTexture != 1) { glProgramUniform1i(mG3Program, mLocUseTexture, 1); mLastUseTexture = 1; }
+    }
+
+    if(mLastPolygonMode != (int)state.polygonMode) {
+        glProgramUniform1i(mG3Program, mLocPolygonMode, state.polygonMode);
+        mLastPolygonMode = (int)state.polygonMode;
+    }
+    // Fog uniforms: re-upload only when a value actually changed
+    // (the two 32-float tables repeat unchanged on most draws).
+    if(mLastUseFog != (int)state.fogEnabled) {
+        glProgramUniform1i(mG3Program, mLocUseFog, state.fogEnabled);
+        mLastUseFog = (int)state.fogEnabled;
+    }
+    if(state.fogEnabled) {
+        const float * fogColor = state.fogColor;
+        if(!mFogUploaded || memcmp(mLastFogColor, fogColor, sizeof(mLastFogColor)) != 0 ||
+           memcmp(mLastFogDepth, state.fogDepthBoundary, sizeof(mLastFogDepth)) != 0 ||
+           memcmp(mLastFogDensity, state.fogDensity, sizeof(mLastFogDensity)) != 0) {
+            glProgramUniform4f(mG3Program, mLocFogColor, fogColor[0], fogColor[1], fogColor[2], fogColor[3]);
+            glProgramUniform1fv(mG3Program, mLocFogDepthBoundary, 32, state.fogDepthBoundary);
+            glProgramUniform1fv(mG3Program, mLocFogDensity, 32, state.fogDensity);
+            memcpy(mLastFogColor, fogColor, sizeof(mLastFogColor));
+            memcpy(mLastFogDepth, state.fogDepthBoundary, sizeof(mLastFogDepth));
+            memcpy(mLastFogDensity, state.fogDensity, sizeof(mLastFogDensity));
+            mFogUploaded = true;
+        }
+    }
+
+    // Front faces are clockwise (glFrontFace(GL_CW) in G3BeginFrame)
+    switch(state.cull) {
+        case CullWinding::All:              glEnable(GL_CULL_FACE); glCullFace(GL_FRONT_AND_BACK); break;
+        case CullWinding::CounterClockwise: glEnable(GL_CULL_FACE); glCullFace(GL_BACK); break;
+        case CullWinding::Clockwise:        glEnable(GL_CULL_FACE); glCullFace(GL_FRONT); break;
+        default:                            glDisable(GL_CULL_FACE); break;
+    }
+    glDepthFunc(state.depthFunc == DepthFunc::Equal ? GL_EQUAL : GL_LESS);
+    if(!state.depthWrite) glDepthMask(GL_FALSE);
+
+    glDrawArrays(GL_TRIANGLES, 0, vertsCount);
+
+    if(!state.depthWrite) glDepthMask(GL_TRUE);
+}
+
+TextureHandle GlBackend::CreateTexture(int width, int height, const void *rgba8) {
+  GLuint id = 0;
+  glGenTextures(1, &id);
+  glActiveTexture(GL_TEXTURE0);
+  glBindTexture(GL_TEXTURE_2D, id);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, height, 0, GL_RGBA,
+               GL_UNSIGNED_BYTE, rgba8);
+  return (TextureHandle)id;
+}
+
+void GlBackend::UpdateTexture(TextureHandle texture, int width, int height, const void *rgba8) {
+  glActiveTexture(GL_TEXTURE0);
+  glBindTexture(GL_TEXTURE_2D, (GLuint)texture);
+  glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, rgba8);
+}
+
+void GlBackend::DestroyTexture(TextureHandle texture) {
+  GLuint id = (GLuint)texture;
+  glDeleteTextures(1, &id);
+}
+
+}
