+// Turns a draw call into a fully specified backend draw: texture and wrap modes, polygon mode, fog, and the DS cull
+// mode / depth test / depth write of this draw call's own polygon attribute (translucent draw calls are deferred to the
+// end of the frame, so nothing may be taken from whatever attribute was current when they are drawn).
+void GlobalState::SubmitDrawCall(DrawCall& drawCall) {
+    if(gG3Stats.enabled) { gG3Stats.draws++; gG3Stats.verts += drawCall.GetRenderVertsCount(); }
+    const size_t vertsCount = drawCall.GetRenderVertsCount();
+    if(vertsCount == 0) return;
+
+    Render::G3DrawState state;
+    if(drawCall.GetTexture() != nullptr) {
+        state.texture = drawCall.GetTexture()->GetHandle();
+        const TexImageParam texImageParam = drawCall.GetTexImageParam();
+        state.wrapS = texImageParam.repeatS ? (texImageParam.flipS ? Render::WrapMode::MirroredRepeat : Render::WrapMode::Repeat)
+                                            : Render::WrapMode::ClampToBorder;
+        state.wrapT = texImageParam.repeatT ? (texImageParam.flipT ? Render::WrapMode::MirroredRepeat : Render::WrapMode::Repeat)
+                                            : Render::WrapMode::ClampToBorder;
+    }
+    const PolygonAttr attr = drawCall.GetPolygonAttr();
+    state.polygonMode = attr.polygonMode;
+    // Winding culled per DS cull mode (the mapping the renderer has always used: GX_CULL_FRONT culls counter-clockwise
+    // triangles, GX_CULL_BACK clockwise ones).
+    switch(attr.cullMode) {
+        case GX_CULL_ALL:   state.cull = Render::CullWinding::All; break;
+        case GX_CULL_FRONT: state.cull = Render::CullWinding::CounterClockwise; break;
+        case GX_CULL_BACK:  state.cull = Render::CullWinding::Clockwise; break;
+        default:            state.cull = Render::CullWinding::None; break;
+    }
+    // DS depth test bit (POLYGON_ATTR bit 14): 0 = less, 1 = equal ("decal": only where a
+    // polygon already wrote this exact depth, e.g. an overlay drawn on a sprite's own pixels).
+    // LEQUAL let decal polygons cover everything behind them.
+    state.depthFunc = attr.depthTest ? Render::DepthFunc::Equal : Render::DepthFunc::Less;
+    // As on the DS, translucent polygons only update the depth buffer when their attribute asks for it.
+    state.depthWrite = !drawCall.IsTransparent() || attr.translucentDepth;
+    state.fogEnabled = drawCall.GetFogEnabled();
+    if(state.fogEnabled) {
+        state.fogColor = drawCall.GetFogColor();
+        state.fogDepthBoundary = drawCall.GetFogDepthTable();
+        state.fogDensity = drawCall.GetFogDensityTable();
+    }
+    Render::Get().G3Draw(state, drawCall.GetRenderVerts(), vertsCount);
+}
