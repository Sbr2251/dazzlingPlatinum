@@ -0,0 +1,51 @@
+// SDL3 GPU render backend (SIM_RENDERER=gpu). Not implemented yet: every method is an empty stub, and
+// CreateGpuBackend reports that and returns nullptr so that Select() falls back to the OpenGL backend.
+#include "sim_render_gpu.hpp"
+
+#include <stdio.h>
+
+namespace SIM::Render {
+
+static constexpr bool kImplemented = false;
+
+Backend *CreateGpuBackend() {
+  if (!kImplemented) {
+    fprintf(stderr, "SIM_RENDERER=gpu: the SDL_GPU renderer is not implemented yet, falling back to gl\n");
+    return nullptr;
+  }
+  return new GpuBackend();
+}
+
+void GpuBackend::PreWindowCreate(int) {}
+std::uint64_t GpuBackend::WindowFlags() const { return 0; }
+bool GpuBackend::Init(SDL_Window *, const InitParams &) { return false; }
+
+void GpuBackend::G3BeginFrame(const G3FrameParams &) {}
+void GpuBackend::G3EndFrame() {}
+void GpuBackend::G3ClearTarget() {}
+void GpuBackend::G3Draw(const G3DrawState &, const G3::RenderVertex *, std::size_t) {}
+TextureHandle GpuBackend::CreateTexture(int, int, const void *) { return kNoTexture; }
+void GpuBackend::UpdateTexture(TextureHandle, int, int, const void *) {}
+void GpuBackend::DestroyTexture(TextureHandle) {}
+void GpuBackend::SetInternalResolution(int) {}
+
+void GpuBackend::BeginFrame(const FrameParams &) {}
+bool GpuBackend::G2GpuAvailable() { return false; }
+void GpuBackend::CompositeEngine(const G2CompositeInput &) {}
+void GpuBackend::RenderPost(const PostFXParams &) {}
+void GpuBackend::Present() {}
+void GpuBackend::GetFrameSize(int *width, int *height) {
+  if (width) *width = 0;
+  if (height) *height = 0;
+}
+bool GpuBackend::ReadPixels(int, int, int, int, u8 *) { return false; }
+
+void GpuBackend::ImGuiInit(SDL_Window *) {}
+void GpuBackend::ImGuiNewFrame() {}
+void GpuBackend::ImGuiRender(ImDrawData *) {}
+
+void GpuBackend::SetSwapInterval(int) {}
+int GpuBackend::GetSwapInterval() { return 0; }
+void GpuBackend::DebugMarker(const char *, int) {}
+
+}
