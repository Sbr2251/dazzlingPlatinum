diff --git a/libraries/sim/include/sim_g2_gpu.h b/libraries/sim/include/sim_g2_gpu.h
index 542109f..c15a222 100644
--- a/libraries/sim/include/sim_g2_gpu.h
+++ b/libraries/sim/include/sim_g2_gpu.h
@@ -1,18 +1,16 @@
 #ifndef SIM_G2_GPU_H
 #define SIM_G2_GPU_H
 #include <nitro/types.h>
-#include <simulator/sim_opengl.h>
+#include <simulator/sim_render_backend.hpp>
 
-// GPU 2D layer renderer (perf-g2gpu). Renders BG and OBJ layers directly
-// from VRAM/palette/OAM data textures into the existing layer textures
-// (s_bgTextureId / s_objTextureId / objWindowTextureId), after which the
-// existing g2_fragment.glsl compositing runs unchanged.
+// GPU 2D layer renderer (perf-g2gpu). Fills the inputs of the backend's GPU 2D layer pass for one engine: BG and OBJ
+// layers are then rendered from VRAM/palette/OAM data into the layer images, after which the g2_fragment.glsl
+// compositing runs unchanged.
 //
 // GPU path is the default; SIM_G2_GPU=0 forces the CPU reference path in sim_g2.cpp.
-// Returns FALSE when the GPU path is disabled or the engine uses a feature
+// Returns FALSE when the GPU path is disabled or unavailable, or the engine uses a feature
 // the GPU path does not replicate (extended direct-color bitmap, mode 6);
 // the caller then runs the CPU path for that engine.
-BOOL G2GPU_RenderLayers(BOOL isSub, GLuint *bgTexIds, GLuint *objTexIds,
-                        GLuint objWindowTexId);
+BOOL G2GPU_BuildLayerParams(BOOL isSub, SIM::Render::G2GpuLayerParams *out);
 
 #endif
