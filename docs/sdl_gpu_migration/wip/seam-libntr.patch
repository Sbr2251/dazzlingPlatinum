+#ifndef LIBNTR_SIM_RENDER_GPU_HPP
+#define LIBNTR_SIM_RENDER_GPU_HPP
+
+// SDL3 GPU render backend (SIM_RENDERER=gpu). See include/simulator/sim_render_backend.hpp for the contract.
+
+#include <simulator/sim_render_backend.hpp>
+
+namespace SIM::Render {
+
+class GpuBackend final : public Backend {
+ public:
+  const char *Name() const override { return "gpu"; }
+
+  void PreWindowCreate(int swapInterval) override;
+  std::uint64_t WindowFlags() const override;
+  bool Init(SDL_Window *window, const InitParams &params) override;
+
+  void G3BeginFrame(const G3FrameParams &params) override;
+  void G3EndFrame() override;
+  void G3ClearTarget() override;
+  void G3Draw(const G3DrawState &state, const G3::RenderVertex *verts, std::size_t count) override;
+  TextureHandle CreateTexture(int width, int height, const void *rgba8) override;
+  void UpdateTexture(TextureHandle texture, int width, int height, const void *rgba8) override;
+  void DestroyTexture(TextureHandle texture) override;
+  void SetInternalResolution(int scale) override;
+
+  void BeginFrame(const FrameParams &params) override;
+  bool G2GpuAvailable() override;
+  void CompositeEngine(const G2CompositeInput &input) override;
+  void RenderPost(const PostFXParams &params) override;
+  void Present() override;
+  void GetFrameSize(int *width, int *height) override;
+  bool ReadPixels(int x, int y, int w, int h, u8 *out) override;
+
+  void ImGuiInit(SDL_Window *window) override;
+  void ImGuiNewFrame() override;
+  void ImGuiRender(ImDrawData *drawData) override;
+
+  void SetSwapInterval(int interval) override;
+  int GetSwapInterval() override;
+  void DebugMarker(const char *message, int length) override;
+};
+
+// Returns nullptr when the SDL_GPU backend cannot be used (the caller then falls back to OpenGL).
+Backend *CreateGpuBackend();
+
+}
+
+#endif
