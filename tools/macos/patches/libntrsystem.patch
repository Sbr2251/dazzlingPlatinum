diff --git a/libraries/g2d/src/g2d_Animation.c b/libraries/g2d/src/g2d_Animation.c
index 24b8b0f..cef19e3 100644
--- a/libraries/g2d/src/g2d_Animation.c
+++ b/libraries/g2d/src/g2d_Animation.c
@@ -151,7 +151,16 @@ static NNS_G2D_INLINE void SequenceEdgeHandleCommon_ (NNSG2dAnimController * pAn
     }
 
     #ifdef SDK_PORT
-    if( pAnimCtrl->pCurrent->frames == 0 || pAnimCtrl->pActiveCurrent->frames == 0 )
+    /* pCurrent may be one past the end of the frame array here: the tick
+     * loop advances it past the last frame, then the edge handler clamps
+     * it back (ValidateAnimFrame_) -- but only after this guard runs.
+     * Dereferencing a one-past-end frame is a heap-buffer-overflow read
+     * under ASan, so only apply the zero-length-frame check in range;
+     * out-of-range pCurrent falls through to the stop/reset below, as
+     * in the unpatched code. */
+    if ( pAnimCtrl->pCurrent >= GetFrameBegin_(pAnimCtrl->pAnimSequence)
+         && pAnimCtrl->pCurrent < GetFrameEnd_(pAnimCtrl->pAnimSequence)
+         && (pAnimCtrl->pCurrent->frames == 0 || pAnimCtrl->pActiveCurrent->frames == 0) )
     {
         NNS_G2dStopAnimCtrl( pAnimCtrl );
         return;
