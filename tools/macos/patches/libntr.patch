+  glProgramUniform2f(sPostProgramID, glGetUniformLocation(sPostProgramID, "beamTarget"), bu, bv);
+  glProgramUniform1f(sPostProgramID, glGetUniformLocation(sPostProgramID, "cutinProgress"), sFxCutin.progress);
+  glProgramUniform1f(sPostProgramID, glGetUniformLocation(sPostProgramID, "cutinAlpha"),
