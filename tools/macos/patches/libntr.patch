+  effNormal = Find("eff_normal");
+  effNotVery = Find("eff_not_very");
+  effNone = Find("eff_none");
+  statusPar = Find("status_par");
+  statusSlp = Find("status_slp");
+  statusFrz = Find("status_frz");
+  statusBrn = Find("status_brn");
+  statusPsn = Find("status_psn");
+  statusTox = Find("status_tox");
+  statusFnt = Find("status_fnt");
+  infoMoveBg = Find("info_move_bg");
+  infoStatusBg = Find("info_status_bg");
+  infoSubBg = Find("info_sub_bg");
+  for (int i = 0; i < 18; ++i) {
+    char key[32];
+    std::snprintf(key, sizeof(key), "move_card_%02d", i);
+    moveCard[i] = Find(key);
+    std::snprintf(key, sizeof(key), "type_badge_%02d", i);
+    typeBadge[i] = Find(key);
+  }
+}
+
+bool HudUiAtlas::EnsureLoaded(Device &device, Frame *frame) {
+  if (mReady) return true;
+  if (mProbed || !frame) return false;
+  if (!UiAtlasGatePermits()) return false;
+  mProbed = true;
+
+  std::string uiDir = ResolveUiDir();
+  if (uiDir.empty()) return false;
+
+  std::string manifestText;
+  if (!ReadFileToString(JoinPath(uiDir, "manifest.json"), 512 * 1024, manifestText)) {
+    return false;
+  }
+
+  std::string atlasFile;
+  std::unordered_map<std::string, HudUiSprite> parsed;
+  if (!ParseManifest(manifestText, atlasFile, parsed)) {
+    std::fprintf(stderr, "FxHudHD: failed to parse %s/manifest.json\n", uiDir.c_str());
+    return false;
+  }
+
+  std::string pngPath = JoinPath(uiDir, atlasFile);
+  int w = 0, h = 0, comp = 0;
+  unsigned char *rgba = stbi_load(pngPath.c_str(), &w, &h, &comp, 4);
+  if (!rgba || w <= 0 || h <= 0 || w > 4096 || h > 4096) {
+    if (rgba) stbi_image_free(rgba);
+    std::fprintf(stderr, "FxHudHD: failed to load %s\n", pngPath.c_str());
+    return false;
+  }
+
+  const float invW = 1.0f / static_cast<float>(w);
+  const float invH = 1.0f / static_cast<float>(h);
+  for (auto &kv : parsed) {
+    HudUiSprite &sp = kv.second;
+    sp.u0 = sp.x * invW;
+    sp.v0 = sp.y * invH;
+    sp.u1 = (sp.x + sp.w) * invW;
+    sp.v1 = (sp.y + sp.h) * invH;
+  }
+
+  if (!mTexture.Create(device, TextureDesc::Rgba8(static_cast<std::uint32_t>(w),
+                                                  static_cast<std::uint32_t>(h),
+                                                  "hudhd_ui_atlas"))) {
+    stbi_image_free(rgba);
+    return false;
+  }
+  frame->UploadTexture(mTexture, rgba);
+  stbi_image_free(rgba);
+
+  mWidth = static_cast<std::uint32_t>(w);
+  mHeight = static_cast<std::uint32_t>(h);
+  mSprites = std::move(parsed);
+  CacheWellKnown();
+  mReady = true;
+  std::fprintf(stderr, "FxHudHD: loaded BDSP UI atlas %s (%ux%u, %zu sprites)\n",
+               pngPath.c_str(), mWidth, mHeight, mSprites.size());
+  return true;
+}
+
+} // namespace SIM::Render
