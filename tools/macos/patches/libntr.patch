+// Reference shader only: storage textures crash lavapipe on SDL 3.4.16, so
+// the self-test covers integer data through storage buffers (test_ssbo*.frag).
+layout(set = 2, binding = 0, r16ui) readonly uniform uimage2D uTex;
+layout(location = 0) in vec2 vUv;
