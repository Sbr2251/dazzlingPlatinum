+bool ModelsGatePermits() {
+  if (!GatePermits()) return false;
+  const auto &e = GetGateEnv();
+  if (e.modelsZero) return false;
+  if (SIM_Headless_Enabled()) {
+    return e.modelsOne;
+  }
+  return true;
