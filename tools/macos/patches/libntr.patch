-static void calculateVtx(float * x, float * y, float * z, float * w)
-{
-    float myW = 1.0f;
-
-    float oldVec[4];
-    float newVec[4];
-    float curSum;
-
-    oldVec[0] = *x;
-    oldVec[1] = *y;
-    oldVec[2] = *z;
-    oldVec[3] = 1.0f;
-
-    for( int i=0; i < 4; i++ )
-    {
-        curSum = 0.0f;
-        for(int j=0; j < 4; j++ )
-        {
-            curSum = curSum + (oldVec[j] * FX_FX32_TO_F32(currentClipMatrix.nums[j][i]));
-        }
-        newVec[i] = curSum;
-    }
-    *x = newVec[0];
-    *y = newVec[1];
-    *z = newVec[2];
-    *w = newVec[3];
