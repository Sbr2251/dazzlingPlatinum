diff --git a/include/simulator/sim_regblock.h b/include/simulator/sim_regblock.h
new file mode 100644
index 0000000..ed3801a
--- /dev/null
+++ b/include/simulator/sim_regblock.h
@@ -0,0 +1,34 @@
+#ifndef SIMULATOR_SIM_REGBLOCK_H_
+#define SIMULATOR_SIM_REGBLOCK_H_
+
+// Single-byte access into a DS hardware register block on the simulator.
+// Same rationale as GXi_FillRegBlock in libraries/gx (see gx_regblock.h):
+// on real hardware a register table is one contiguous region, but on the
+// simulator each register is a separate host global (s_reg_* in
+// sim_vars.c), so a block read/write rooted at one register walks off the
+// end of that single global -- a global-buffer-overflow under ASan, and
+// technically UB even though the simulator lays the globals out in DS
+// offset order so the bytes land on the intended registers. The volatile
+// byte access below is not ASan-instrumented (no_sanitize) and cannot be
+// re-folded into a memcpy/memset call (whose interceptor would flag the
+// same access). Use only for DS register blocks, never for RAM/VRAM.
+#ifdef __cplusplus
+#include <cstdint>
+extern "C" {
+#else
+#include <stdint.h>
+#endif
+
+// The 32 fog densities, kept as a real array. On hardware they live in
+// the FOG_TABLE register block, but in the simulator the FOG_TABLE_n
+// registers are separate globals, so a byte walk across them (base + idx)
+// reads past a 4-byte object -- UBSan's object-size check flags it, and
+// the read only works by link-order luck. G3X_SetFogTable keeps this array
+// in sync with the register block; the SIM renderer reads from here.
+extern volatile uint8_t SIM_FogTable[32];
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/include/simulator/sim_render_backend.hpp b/include/simulator/sim_render_backend.hpp
new file mode 100644
index 0000000..600795e
--- /dev/null
+++ b/include/simulator/sim_render_backend.hpp
@@ -0,0 +1,536 @@
+#ifndef LIBNTR_SIM_RENDER_BACKEND_HPP
+#define LIBNTR_SIM_RENDER_BACKEND_HPP
+
+// Render backend interface of the simulator.
+//
+// Every GPU API call of the simulator goes through SIM::Render::Backend.
+// The DS emulation code (G3 command processing, 2D register decoding,
+// PostFX effect timing, display capture) decides WHAT is drawn and fills
+// the plain structs below; a backend only turns them into GPU work.
+// One backend is selected at startup (SIM_RENDERER=gl|gpu, read once,
+// default gl):
+//   gl   OpenGL 4.1/4.2 core (libraries/sim/src/render_gl), the reference renderer.
+//   gpu  SDL3 GPU API (libraries/sim/src/render_gpu, on libraries/sim/src/gpu).
+//        Until it is implemented it reports so and the GL backend is used.
+//
+// ---------------------------------------------------------------------------------------------------------------
+// CONTRACT
+//
+// THREADING
+//   Every method is called from one thread: the thread that runs NitroMain.
+//   On the PC targets that is the process main thread, which also calls
+//   SIM_RenderInit before NitroMain starts and SIM_Render from OS_WaitIrq
+//   (VBlank). No method is ever called concurrently. The GL backend needs
+//   its context current on that thread (SIM::AcquireRenderContext /
+//   ReleaseRenderContext do that; they are no-ops for a backend without a
+//   GL context).
+//
+// FRAME LIFECYCLE (one emulated VBlank = one SIM_Render call; read top to bottom)
+//   startup:  PreWindowCreate -> (window created with WindowFlags()) ->
+//             Init(window) -> ImGuiInit(window)
+//   3D:       G3BeginFrame ... G3Draw* / G3ClearTarget / CreateTexture /
+//             UpdateTexture / DestroyTexture ... G3EndFrame
+//             The game issues G3 work at any time while its frame runs.
+//             G3BeginFrame is called at the end of SIM_Render (it binds the
+//             3D target, sets the viewport for the POWCNT screen and uses
+//             the 3D program). G3EndFrame is called at the start of the next
+//             SIM_Render, after the last pending draws (including the
+//             deferred translucent ones) were submitted via G3Draw. After
+//             G3EndFrame the 3D target may be sampled as BG0. G3ClearTarget
+//             is called from SIM_PostRenderVBlank, only on frames where the
+//             game swapped its 3D buffers, and is ordered with the draws
+//             around it. The 3D target is NOT cleared otherwise: frames
+//             without a G3 swap draw over the previous contents.
+//   2D:       BeginCompositeFrame -> CompositeEngine(main) ->
+//             CompositeEngine(sub) -> DrawHiResOverlay -> RenderPost ->
+//             ImGuiRender -> [ReadPixels] -> Present
+//             CompositeEngine samples the 3D target as BG0, so everything
+//             submitted before G3EndFrame must be visible to it. While the
+//             game is paused the 2D sequence repeats (several
+//             BeginCompositeFrame..Present rounds) without a 3D frame in
+//             between. G3BeginFrame for the next frame happens at the end
+//             of SIM_Render, after Present. ReadPixels is only valid
+//             between ImGuiRender and Present and returns the image Present
+//             is about to show (composite + post + ImGui).
+//   capture:  BeginCapture -> CompositeEngine(main) -> EndCapture ->
+//             ReadCapture. BeginCapture saves the current composite target
+//             and binds the capture target; EndCapture restores it. The
+//             caller then blends the capture pixels on the CPU and writes
+//             them into emulated VRAM (see CaptureResult below). A backend
+//             may instead satisfy ReadCapture from a ReadbackRing-style
+//             download started in frame N and collected at a fixed point
+//             in frame N+1, provided the VRAM write always lands at the
+//             same point in the frame (see "Capture" in PLAN.md); the GL
+//             backend delivers synchronously, which is also allowed.
+//             The VRAM display mode does NOT use capture: the caller builds
+//             an RGBA8 image from VRAM and calls DrawVramDisplay, which
+//             draws it into the current composite target.
+//   any time: SetSwapInterval, GetFrameSize, DebugMarker.
+//             SetInternalResolution is called between Present and
+//             G3BeginFrame. Texture create/destroy can happen at any time.
+//   Outside a 3D frame: the game can submit G3 work before the first
+//   G3BeginFrame (during boot) and from its VBlank handler (which runs
+//   inside SIM_Render, between CompositeEngine and Present). The GL
+//   backend executes such draws against whatever is currently bound
+//   (legacy behaviour); a recording backend must append them to the next
+//   3D frame instead of dropping them.
+//
+// OWNERSHIP
+//   Every pointer passed in (vertices, fog tables, layer pixels, VRAM/OAM/
+//   palette data, uniform structs) is owned by the caller and valid only
+//   for the duration of the call. A backend that defers work must copy
+//   what it needs (vertices, fog tables, CPU layer pixels). Pixel buffers
+//   returned by ReadPixels / ReadCapture / Read3DTarget are
+//   caller-allocated. Texture handles are owned by the caller until
+//   DestroyTexture; a backend that records work must keep the texture
+//   alive until recorded draws that use it have executed. The backend owns
+//   all its GPU objects (layer textures, 3D target, post/capture targets,
+//   shader programs, VAOs); callers never see GL ids.
+//
+// TARGETS (the FBO-rebinding bug class is impossible by construction)
+//   Every pass names its target through a Begin* call; no pass ever binds
+//   "framebuffer 0" or "the previous target" to restore state, because
+//   there is no previous target to restore: BeginCompositeFrame,
+//   BeginCapture and RenderPost each name their target explicitly, and
+//   EndCapture restores the composite target it saved in BeginCapture.
+//   Inside the GL backend the same rule holds: each helper binds exactly
+//   the target it draws into.
+//
+// COORDINATE CONVENTIONS (shared by both backends; the shaders in
+// libraries/sim/src/shaders depend on them)
+//   - "Combined display" = 256 x 384, the two DS screens stacked. Every
+//     256 x 384 layer image and the 3D target store the TOP screen in the
+//     upper half of the image as sampled with v in [0.5, 1] (v = 0 is the
+//     bottom edge). CPU layer pixels (G2CpuLayers) are rows bottom-up:
+//     row 0 is the bottom line of the bottom screen, row 383 the top line
+//     of the top screen.
+//   - G3 vertices are in clip space with +y up (GL / SDL_GPU NDC). Window
+//     winding is evaluated in that space.
+//   - FrameParams::view and ReadPixels use window pixels with a TOP-LEFT
+//     origin. ReadPixels returns rows TOP-DOWN (the GL backend flips the
+//     bottom-up glReadPixels result; the GPU backend's downloads are
+//     already top-down, so it must NOT flip).
+//   - PostFXParams UVs use v = 0 at the BOTTOM of the window (the post
+//     shader's fragTexCoord convention).
+//   - Capture pixels (ReadCapture / Read3DTarget) are rows top-down:
+//     row 0 is the top line of the captured screen.
+//
+// SDL GPU MAPPING NOTES (for the gpu backend; see gpu/README.md)
+//   - No global state: draws live in render passes on explicit targets;
+//     pipeline objects bake cull/depth/blend; uniforms are pushed byte
+//     blocks per draw; uploads run in copy passes outside render passes.
+//   - The swapchain texture is acquired per frame and may be BGRA; the
+//     swapchain itself cannot be read back. Keep an offscreen present
+//     target for ReadPixels and blit it to the swapchain in Present.
+//     SDL returns a null swapchain for a hidden/minimised window: show the
+//     window before acquiring, or skip the draw when it is null.
+//   - Integer data (VRAM, OAM, palettes for the GPU 2D passes) goes
+//     through STORAGE BUFFERS, not sampled integer textures: SDL GPU
+//     forbids SAMPLER usage on integer formats, and storage textures crash
+//     lavapipe on SDL 3.4.16. The G2GpuData struct hands the backend the
+//     raw bytes; the backend packs them into storage buffers.
+//   - Depth: a vertex shader that outputs GL clip-space z must remap it
+//     (z = (z + w) * 0.5) or every z < 0 is clipped. Depth compares keep
+//     working because the remap is monotonic. Feed the original z to fog.
+//   - Viewport/scissor origin: SDL GPU is top-left, GL is bottom-left:
+//     y_gpu = targetHeight - y_gl - height. Render-to-texture sampling:
+//     v_gpu = 1 - v_gl for a texture that was rendered, not uploaded.
+//     gl_FragCoord.y counts from the top in SDL GPU, from the bottom in GL.
+//   - GL_CLAMP_TO_BORDER has no SDL GPU equivalent: sample with
+//     CLAMP_TO_EDGE and return the border colour in the fragment shader
+//     when the coordinate is outside [0, 1). With NEAREST filtering this
+//     matches GL exactly.
+//   - Depth equality (the stat-change effect draws with depth EQUAL over
+//     the battler's mesh, vertex for vertex): declare
+//     `invariant gl_Position` in the 3D vertex shader and keep the
+//     position math identical across the shaders that feed EQUAL tests.
+//   - FRONT_AND_BACK culling does not exist in SDL GPU: skip the draw.
+//   - A depth target shared by several passes in one frame: later passes
+//     open it with LOAD, and the earlier pass must have opened it with
+//     STORE, or the depth is lost on tile-based GPUs.
+// ---------------------------------------------------------------------------------------------------------------
+
+#include <nitro/types.h>
+
+#include <cstddef>
+#include <cstdint>
+
+struct SDL_Window;
+struct ImDrawData;
+
+namespace SIM::G3 {
+
+// One G3 vertex as the backend receives it (40 bytes, tightly packed).
+// Position is clip space after the DS viewport transform and depth
+// mapping (x, y, z used; w is carried but not read by the shaders),
+// texcoord in texture UVs (0..1 per texture repeat), colour 0..1.
+struct RenderVertex {
+  float x;
+  float y;
+  float z;
+  float w;
+  float s;
+  float t;
+  float r;
+  float g;
+  float b;
+  float a;
+};
+
+} // namespace SIM::G3
+
+namespace SIM::Render {
+
+// Backend-neutral 3D texture handle. 0 is "no texture".
+using TextureHandle = std::uint64_t;
+constexpr TextureHandle kNoTexture = 0;
+
+enum class Screen : u8 { Bottom = 0, Top = 1 };
+
+// ---- 3D ------------------------------------------------------------------
+
+// Texture addressing. ClampToBorder = transparent black (0,0,0,0)
+// outside [0,1]; SDL GPU has no border colour, so that backend emulates
+// it in the fragment shader (see CONTRACT above).
+enum class WrapMode : u8 { Repeat, MirroredRepeat, ClampToBorder };
+
+// Which triangles are NOT drawn, by window winding in +y-up clip space.
+// All = nothing is drawn (DS GX_CULL_ALL).
+enum class CullWinding : u8 { None, Clockwise, CounterClockwise, All };
+
+enum class DepthFunc : u8 { Less, Equal };
+
+// Fully specified state of one G3 draw. Fixed for every draw (not in the
+// struct): triangle list, blending src*srcAlpha + dst*(1-srcAlpha) on
+// colour AND alpha, depth test on, G3 shader (shaders/g3_*.glsl),
+// target = the 3D target at the screen/scale of the enclosing
+// G3BeginFrame. The backend copies fog tables at the call when it
+// records work.
+struct G3DrawState {
+  TextureHandle texture = kNoTexture; // kNoTexture: untextured (vertex colour only)
+  WrapMode wrapS = WrapMode::Repeat; // only meaningful with a texture
+  WrapMode wrapT = WrapMode::Repeat;
+  u8 polygonMode = 0;                // DS polygon mode: 0 modulate (texel * vertex colour), else texel only
+  CullWinding cull = CullWinding::None;
+  DepthFunc depthFunc = DepthFunc::Less;
+  bool depthWrite = true;
+  bool fogEnabled = false;
+  const float *fogColor = nullptr;         // 4 floats (rgba 0..1), valid when fogEnabled
+  const float *fogDepthBoundary = nullptr; // 32 floats, clip-space z boundaries, valid when fogEnabled
+  const float *fogDensity = nullptr;       // 32 floats, 0..1, valid when fogEnabled
+};
+
+// The 3D target is 256*scale x 384*scale; each frame renders into one
+// screen half of it (viewport 256*scale x 192*scale). screen and scale
+// are latched once per frame (POWCNT bit 15 and the internal resolution
+// at the end of SIM_Render), so every draw of the frame uses them.
+struct G3FrameParams {
+  Screen screen = Screen::Bottom;
+  int scale = 1;
+};
+
+// ---- 2D compositing -------------------------------------------------------
+
+// 2D upscale sampling for one composite (Upscale2DFilter). The backend
+// applies the filter to the layer textures it samples; the sharp mode
+// also needs the per-axis scale in upscaleW (DS pixels per window pixel
+// along the composite viewport).
+enum class UpscaleMode : s32 { Nearest = 0, Sharp = 1, Bilinear = 2 };
+
+// Uniforms of the compositing shader (shaders/g2_fragment.glsl), one engine.
+struct G2CompositeUniforms {
+  float backdropColor[4];
+  s32 bgOrder[4];
+  s32 bgPriorities[4];
+  s32 bldcnt;
+  s32 bldalpha;
+  s32 bldy;
+  s32 topScreen; // 1: this engine is the top screen (the shader keeps v >= 0.5), 0: bottom (v < 0.5)
+  s32 dispcnt;
+  s32 winin;
+  s32 winout;
+  s32 win0h;
+  s32 win0v;
+  s32 win1h;
+  s32 win1v;
+  s32 bg0as3d;
+  float masterBrightFactor;
+  s32 masterBrightMode;
+  UpscaleMode upscaleMode = UpscaleMode::Nearest;
+  // The sharp mode's scale (DS pixels per target pixel) is derived by
+  // the backend from the viewport in force for CompositeEngine, exactly
+  // as the old code read GL_VIEWPORT inside DrawEngine.
+};
+
+// What the compositor samples as bgTexture[i].
+enum class LayerSource : u8 {
+  Empty,    // transparent black (BG disabled)
+  Layer,    // the engine's BG layer image i (CPU upload or GPU 2D pass)
+  G3Target, // the 3D target (BG0 as 3D)
+};
+
+// CPU-rendered layers for one engine: 256 x 384 RGBA8, rows bottom-up
+// (see COORDINATE CONVENTIONS). nullptr = leave that layer image as it
+// is (the backend keeps whatever was uploaded last frame for it).
+struct G2CpuLayers {
+  const u8 *bg[4];
+  const u8 *obj[4]; // OBJ layers by priority 0..3
+  const u8 *objWindow; // OBJ window mask (alpha > 0.1 = inside)
+};
+
+// One per-sprite OBJ draw for the GPU 2D path: the backend draws one
+// scissored, depth-tested quad per entry, in ascending OAM index order,
+// so the lowest OAM index wins (depth LEQUAL, cleared to 1). Scissor and
+// depth are in GL framebuffer coordinates for the layer image
+// (256 x 384, bottom-left origin, y measured from the bottom of the
+// combined image); the backend converts them for SDL GPU.
+struct G2GpuSprite {
+  s32 oamIndex;   // the sprite's OAM index (also the objList uniform)
+  s32 scissorX;   // left, DS pixels
+  s32 scissorY;   // bottom, DS pixels in the combined 256x384 image
+  s32 scissorW;
+  s32 scissorH;
+  float depth;    // (oamIndex + 1) / 128
+  s32 bandYLo;    // DS-pixel band actually drawn (vertical wrap band)
+  s32 bandYHi;
+};
+
+// Raw data + registers for the GPU 2D layer passes
+// (shaders/g2gpu_*.glsl): renders BG 0-3, OBJ priority 0-3 and the OBJ
+// window mask of one engine from VRAM/OAM/palette data into the layer
+// images, before compositing. Each pass first clears this engine's
+// screen half of its layer image to (0,0,0,0) and only touches that half.
+// The backend uploads the data (it may skip uploads of unchanged data);
+// the caller hands it the raw emulated-memory pointers, which are valid
+// for the duration of the call, so a recording backend must copy them.
+// Value-initialize before filling (G2GpuData data{}): objCount and
+// spriteCount start at 0, and the backend reads exactly those counts.
+struct G2GpuData {
+  s32 isSub;
+  s32 topScreen;
+  s32 dispcnt;
+  s32 bgMode;
+  s32 extPlttBase;    // byte offset of the BG extended palettes in lcdc
+  s32 objExtPlttBase; // byte offset of the OBJ extended palettes in lcdc
+  s32 bgcnt[4];
+  s32 bgofs[4]; // HOFS | VOFS << 16
+  s32 affA[4], affB[4], affC[4], affD[4];
+  s32 affX[4], affY[4];
+  s32 win0h, win0v, win1h, win1v, mosaic, winin, winout;
+  s32 bgRender[4]; // 1: render BG layer i, 0: only clear it
+  s32 objEnabled;  // 1: OBJ layers and window are rendered, 0: only cleared
+  // Candidate sprites per OBJ priority 0..3, [4] = OBJ window sprites,
+  // ascending OAM index. objCount[n] entries of objList[n] are valid.
+  s32 objCount[5];
+  s32 objList[5][128];
+  // Per-sprite draws, grouped by priority list (same order as objList):
+  // sprites[0..3] are the OBJ priority passes, sprites[4] the OBJ window
+  // pass. spriteCount[n] entries of sprites[n] are valid. One sprite
+  // expands to up to two entries (vertical wrap band).
+  s32 spriteCount[5];
+  G2GpuSprite sprites[5][256];
+  // Data, uploaded before the passes.
+  const void *bgVram; // this engine's BG VRAM
+  u32 bgVramSize;    // bytes (multiple of 2048)
+  const void *objVram; // this engine's OBJ VRAM
+  u32 objVramSize;    // bytes (multiple of 1024)
+  const void *lcdc;   // 0xA4000 bytes of LCDC VRAM (extended palettes), nullptr = not used
+  u32 lcdcSize;
+  const void *oam;    // this engine's OAM, 1024 bytes
+  const void *palettes[4]; // 512 bytes each: BG main, OBJ main, BG sub, OBJ sub
+};
+
+// Composite one engine into the current composite target (set by
+// BeginCompositeFrame or BeginCapture), inside FrameParams::view.
+// Exactly one of cpu / gpu is set. The draw is alpha-blended
+// (src*srcAlpha + dst*(1-srcAlpha)) over the target; the shader
+// discards the other engine's screen half.
+struct G2CompositeInput {
+  // Value-initialize before filling (G2CompositeInput input{}): the
+  // backend reads bgSource for all four BGs and cpu/gpu as given.
+  bool isSub = false;
+  LayerSource bgSource[4] = {};
+  const G2CpuLayers *cpu = nullptr;
+  const G2GpuData *gpu = nullptr;
+  G2CompositeUniforms uniforms = {};
+  // Display quad(s) for the current screen layout, triangle list in clip
+  // space; x, y, z and s, t are used.
+  const G3::RenderVertex *screenQuad = nullptr;
+  int screenQuadVertexCount = 0;
+};
+
+// ---- frame, post pass, present --------------------------------------------
+
+struct Rect {
+  int x, y, w, h;
+};
+
+struct FrameParams {
+  int frameWidth;  // window size in pixels (GetFrameSize); the composite image has this size
+  int frameHeight;
+  Rect view; // where the combined display is composited, window pixels, top-left origin
+};
+
+// Uniforms of the post shader (shaders/post_fragment.glsl). The post
+// pass draws the composite image over the whole window, alpha-blended
+// over opaque black.
+struct PostFXParams {
+  float texelSize[2];
+  float shakeOffset[2];
+  float shockCenter[2];
+  float shockRadius;
+  float shockStrength;
+  float zoomCenter[2];
+  float zoomBlur;
+  float vignetteColor[3];
+  float vignetteAmount;
+  float chromaAmount;
+  float glowAmount;
+  float letterbox;
+  s32 fxRegion;
+  float beamTarget[2];
+  float cutinProgress;
+  float cutinAlpha;
+  float titleProgress;
+  float titleAlpha;
+  float glowCenter[2];
+  float glowAtAmount;
+};
+
+// ---- hi-res text overlay --------------------------------------------------
+
+// One hi-res overlay draw: a combined-display RGBA8 image (w x h, rows
+// top-down in the caller buffer; the backend flips it to match its
+// target) drawn over the current composite target, after both engines
+// and before the post pass. The caller owns the pixels; the backend
+// copies them when it records work.
+struct HiResOverlayInput {
+  const u8 *rgba8; // w * h * 4 bytes, RGBA8, rows top-down
+  int width;
+  int height;
+  bool dirty = false; // true: re-upload the pixels before drawing
+};
+
+// ---- display capture ------------------------------------------------------
+
+// The capture result the caller blends on the CPU: source A as RGBA8,
+// one captured screen, rows top-down (row 0 = top line of the screen).
+// The backend fills out (256 * 192 * 4 bytes) in ReadCapture /
+// Read3DTarget.
+struct CaptureResult {
+  u8 *rgba8;
+};
+
+// ---- backend --------------------------------------------------------------
+
+struct InitParams {
+  int windowWidth;   // initial window size
+  int windowHeight;
+  int internalScale; // initial internal resolution scale of the 3D target
+};
+
+class Backend {
+ public:
+  virtual ~Backend() = default;
+
+  virtual const char *Name() const = 0;
+
+  // -- startup
+  // Before the window exists (GL: context attributes).
+  virtual void PreWindowCreate(int swapInterval) = 0;
+  // SDL window flags the window must be created with (SDL_WindowFlags value, e.g. SDL_WINDOW_OPENGL).
+  virtual std::uint64_t WindowFlags() const = 0;
+  // Creates the device/context for the window and all fixed resources. Ends by presenting one black frame.
+  virtual bool Init(SDL_Window *window, const InitParams &params) = 0;
+
+  // -- 3D
+  virtual void G3BeginFrame(const G3FrameParams &params) = 0;
+  virtual void G3EndFrame() = 0;
+  // Clears the whole 3D target (both halves): colour (0,0,0,0), depth 1.0.
+  virtual void G3ClearTarget() = 0;
+  // verts: count vertices, a triangle list. count > 0.
+  virtual void G3Draw(const G3DrawState &state, const G3::RenderVertex *verts, std::size_t count) = 0;
+  // 3D textures: RGBA8, rows in upload order (row 0 = t 0), nearest filtering.
+  virtual TextureHandle CreateTexture(int width, int height, const void *rgba8) = 0;
+  virtual void UpdateTexture(TextureHandle texture, int width, int height, const void *rgba8) = 0;
+  virtual void DestroyTexture(TextureHandle texture) = 0;
+  // Reallocates the 3D target for a new internal resolution scale (contents undefined afterwards).
+  virtual void SetInternalResolution(int scale) = 0;
+
+  // -- 2D / frame
+  // Starts the frame's composite target (resized to the frame size if
+  // needed) and clears it to opaque black. view is in window pixels with
+  // a top-left origin; the backend converts it to its own viewport.
+  virtual void BeginCompositeFrame(const FrameParams &params) = 0;
+  // GPU 2D layer passes for one engine (see G2GpuData). Returns false
+  // when the engine uses a feature the GPU path does not replicate
+  // (extended direct-color bitmap, mode 6); the caller then runs the
+  // CPU path for that engine. The caller also calls this when it wants
+  // the GPU path; the backend decides availability on first call.
+  virtual bool RenderGpuLayers(const G2GpuData &data) = 0;
+  // Composites one engine into the current composite target. For the
+  // CPU path the caller passes the layer images in input.cpu; the
+  // backend uploads the ones the composite actually samples (see
+  // G2CompositeInput::bgSource: Empty sources are not uploaded, so a
+  // disabled BG's stale buffer never reaches the texture).
+  virtual void CompositeEngine(const G2CompositeInput &input) = 0;
+  // Hi-res text overlay pass (no-op when the input has no pixels).
+  virtual void DrawHiResOverlay(const HiResOverlayInput &input) = 0;
+  // Post pass: draws the composite image to the window with PostFX.
+  virtual void RenderPost(const PostFXParams &params) = 0;
+  // Applies the 2D upscale sampling mode to the layer textures.
+  virtual void ApplyUpscaleFilter(int mode) = 0;
+  // Shows the frame, then clears the window image to opaque black for the next post pass.
+  virtual void Present() = 0;
+  // Window drawable size in pixels (can differ from the window size in points on high-DPI displays).
+  virtual void GetFrameSize(int *width, int *height) = 0;
+  // RGBA8, rows top-down, rect in window pixels with a top-left origin. out holds w * h * 4 bytes.
+  // Returns the image Present is about to show.
+  virtual bool ReadPixels(int x, int y, int w, int h, u8 *out) = 0;
+
+  // -- display capture
+  // Binds the capture target (256 x 384) and clears it; saves the
+  // current composite target, restored by EndCapture.
+  virtual void BeginCapture() = 0;
+  virtual void EndCapture() = 0;
+  // Reads one captured screen (256 x 192) out of the capture target:
+  // y0 is the GL bottom-up offset of the screen half in the combined
+  // image (0 = bottom screen, 192 = top screen in GL coordinates).
+  // out holds 256 * 192 * 4 bytes, rows top-down.
+  virtual bool ReadCapture(int y0, u8 *out) = 0;
+  // Reads one screen half of the 3D target, downsampled to 256 x 192:
+  // the caller picks the centre texel of each scale x scale block.
+  // y0 is the GL bottom-up offset in the 3D target (see ReadCapture).
+  // out holds 256 * 192 * 4 bytes, rows top-down.
+  virtual bool Read3DTarget(int y0, int scale, u8 *out) = 0;
+  // Draws a VRAM display-mode image (256 x 384 RGBA8, rows bottom-up,
+  // like the CPU layer images) into the current composite target,
+  // with master-bright applied.
+  virtual void DrawVramDisplay(const u8 *rgba8, int topScreen, float brightFactor, int brightMode,
+                                 const G3::RenderVertex *screenQuad, int screenQuadVertexCount) = 0;
+
+  // -- ImGui (Dear ImGui renderer backend + the SDL platform backend's init for this API)
+  virtual void ImGuiInit(SDL_Window *window) = 0;
+  virtual void ImGuiNewFrame() = 0;
+  virtual void ImGuiRender(ImDrawData *drawData) = 0;
+
+  // -- misc
+  virtual void SetSwapInterval(int interval) = 0;
+  virtual int GetSwapInterval() = 0;
+  // Debugger annotation (GL debug output / GPU debug label); may be ignored.
+  virtual void DebugMarker(const char *message, int length) = 0;
+};
+
+// Selects the backend from SIM_RENDERER (once; later calls return the same one). Called by SIM_RenderInit.
+Backend &Select();
+
+namespace detail {
+extern Backend *gBackend;
+}
+
+// The selected backend. Only valid after Select().
+inline Backend &Get() { return *detail::gBackend; }
+
+} // namespace SIM::Render
+
+#endif
