diff --git a/include/simulator/fx_texpack.hpp b/include/simulator/fx_texpack.hpp
new file mode 100644
index 0000000..f6bb456
--- /dev/null
+++ b/include/simulator/fx_texpack.hpp
@@ -0,0 +1,46 @@
+// fx_texpack: hash-keyed texture replacement for the SDL GPU backend.
+//
+// Every G3 texture the game decodes gets a stable 64-bit hash. When a
+// pack is enabled, TexturePack/<hash>.png (1x-4x, same aspect) replaces
+// the decoded pixels; the replacement is sampled with the original
+// normalised UVs (DS texel coords are divided by the ORIGINAL size in
+// sim_g3_GlobalState), so a larger replacement just carries more detail.
+// Dump mode writes every distinct texture at 1x plus manifest.csv so an
+// artist can redraw it. No pack on disk = no per-texture file IO.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace SIM::Render::TexPack {
+
+// Records the raw DS source of the texture that is about to be created
+// (called from the decode path in sim_g3_GlobalState, immediately before
+// the Texture is constructed). The base hash covers the texel data,
+// format and size but NOT the palette; the palette is hashed separately,
+// so a palette animation (same texels, new colours) still maps to the
+// same replacement. Consumed by the next Resolve call.
+void SetPendingSource(const std::uint8_t *texels, std::size_t texelBytes,
+                      const std::uint8_t *palette, std::size_t paletteBytes,
+                      int format, int width, int height);
+
+bool Enabled();
+bool DumpEnabled();
+
+// Result of resolving one decoded texture: either the original pixels
+// (found == false) or the replacement image at its own (larger) size.
+struct Resolved {
+  bool found = false;
+  std::uint64_t hash = 0;
+  int width = 0;
+  int height = 0;
+  std::vector<std::uint8_t> pixels; // RGBA8, width*height*4, when found
+};
+
+// Hook for G3 texture create/update. Handles dump mode, pack lookup and
+// the by-hash cache. Cheap no-op when neither mode is on or no pack
+// directory exists.
+Resolved Resolve(int width, int height, const void *rgba8);
+
+} // namespace SIM::Render::TexPack
