+namespace SIM::Gpu {
+
+static bool EnvFlag(const char *name) {
+    const char *v = SDL_getenv(name);
+    return v && *v && strcmp(v, "0") != 0;
+}
+
+void LogError(const char *context, bool withSdlError) {
+    if (withSdlError) {
+        const char *err = SDL_GetError();
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "SIM_GPU: %s: %s", context, (err && *err) ? err : "(no SDL error)");
+    } else {
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "SIM_GPU: %s", context);
+    }
+    if (EnvFlag("SIM_GPU_FATAL")) {
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "SIM_GPU: SIM_GPU_FATAL is set, aborting");
+        abort();
+    }
+}
+
+void LogInfo(const char *fmt, ...) {
+    char buf[1024];
+    va_list ap;
+    va_start(ap, fmt);
+    SDL_vsnprintf(buf, sizeof buf, fmt, ap);
+    va_end(ap);
+    SDL_LogInfo(SDL_LOG_CATEGORY_GPU, "SIM_GPU: %s", buf);
+}
+
+Device::Device() = default;
+
+Device::~Device() { Destroy(); }
+
+void Device::ReportFailure(const char *context, bool withSdlError) {
+    mFailed = true;
+    LogError(context, withSdlError);
+}
+
+bool Device::Create(const DeviceConfig &config) {
+    if (mDevice) return true;
+    mConfig = config;
+    if (EnvFlag("SIM_GPU_DEBUG")) mConfig.debug = true;
+    const char *envDriver = SDL_getenv("SIM_GPU_DRIVER");
+    if (envDriver && *envDriver) mConfig.driver = envDriver;
+
+    // SDL loads Vulkan through the video subsystem, so it must be up even without a window.
+    if (!SDL_WasInit(SDL_INIT_VIDEO)) {
+        if (!SDL_InitSubSystem(SDL_INIT_VIDEO)) {
+            const char *hint = SDL_GetHint(SDL_HINT_VIDEO_DRIVER);
+            if (hint && *hint) {
+                ReportFailure("SDL_InitSubSystem(VIDEO)");
+                return false;
+            }
+            LogInfo("no display video driver (%s); using the offscreen video driver", SDL_GetError());
+            SDL_SetHint(SDL_HINT_VIDEO_DRIVER, "offscreen");
+            if (!SDL_InitSubSystem(SDL_INIT_VIDEO)) {
+                ReportFailure("SDL_InitSubSystem(VIDEO) with the offscreen driver");
+                return false;
+            }
+        }
+        mInitedVideo = true;
+    }
+
+    SDL_PropertiesID props = SDL_CreateProperties();
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_SHADERS_SPIRV_BOOLEAN, true);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_SHADERS_MSL_BOOLEAN, true);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_DEBUGMODE_BOOLEAN, mConfig.debug);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_VERBOSE_BOOLEAN, mConfig.debug);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_PREFERLOWPOWER_BOOLEAN, mConfig.preferLowPower);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_VULKAN_REQUIRE_HARDWARE_ACCELERATION_BOOLEAN, mConfig.requireHardware);
+    // Optional Vulkan features nothing here uses; leaving them off keeps older Android devices eligible.
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_FEATURE_CLIP_DISTANCE_BOOLEAN, false);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_FEATURE_INDIRECT_DRAW_FIRST_INSTANCE_BOOLEAN, false);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_FEATURE_ANISOTROPY_BOOLEAN, false);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_FEATURE_DEPTH_CLAMPING_BOOLEAN, mConfig.depthClamping);
+    if (mConfig.driver) SDL_SetStringProperty(props, SDL_PROP_GPU_DEVICE_CREATE_NAME_STRING, mConfig.driver);
+    mDevice = SDL_CreateGPUDeviceWithProperties(props);
+    SDL_DestroyProperties(props);
+    if (!mDevice) {
+        ReportFailure("SDL_CreateGPUDeviceWithProperties");
+        Destroy();
+        return false;
+    }
+
+    SDL_GPUShaderFormat formats = SDL_GetGPUShaderFormats(mDevice);
+    if (formats & SDL_GPU_SHADERFORMAT_SPIRV) {
+        mShaderFormat = SDL_GPU_SHADERFORMAT_SPIRV;
+    } else if (formats & SDL_GPU_SHADERFORMAT_MSL) {
+        mShaderFormat = SDL_GPU_SHADERFORMAT_MSL;
+    } else {
+        ReportFailure("the GPU driver accepts neither SPIR-V nor MSL shaders", false);
+        Destroy();
+        return false;
+    }
+
+    // D24 matches the GL renderer's depth precision; Apple GPUs only offer D32_FLOAT (and D16).
+    const SDL_GPUTextureUsageFlags depthUsage = SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET;
+    if (SDL_GPUTextureSupportsFormat(mDevice, SDL_GPU_TEXTUREFORMAT_D24_UNORM, SDL_GPU_TEXTURETYPE_2D, depthUsage)) {
+        mDepthFormat = SDL_GPU_TEXTUREFORMAT_D24_UNORM;
+    } else if (SDL_GPUTextureSupportsFormat(mDevice, SDL_GPU_TEXTUREFORMAT_D32_FLOAT, SDL_GPU_TEXTURETYPE_2D, depthUsage)) {
+        mDepthFormat = SDL_GPU_TEXTUREFORMAT_D32_FLOAT;
+    } else {
+        mDepthFormat = SDL_GPU_TEXTUREFORMAT_D16_UNORM;
+    }
+
+    Uint32 fif = mConfig.framesInFlight < 1 ? 1 : (mConfig.framesInFlight > 3 ? 3 : mConfig.framesInFlight);
+    if (fif != 2 && !SDL_SetGPUAllowedFramesInFlight(mDevice, fif)) ReportFailure("SDL_SetGPUAllowedFramesInFlight");
+
+    mPipelines = std::make_unique<PipelineCache>(*this);
+    mSamplers = std::make_unique<SamplerCache>(*this);
+    mFrame = std::make_unique<Frame>(*this);
+
+    SDL_PropertiesID dp = SDL_GetGPUDeviceProperties(mDevice);
+    LogInfo("device: driver %s, %s (%s), shaders %s, depth %s%s", SDL_GetGPUDeviceDriver(mDevice),
+            dp ? SDL_GetStringProperty(dp, SDL_PROP_GPU_DEVICE_NAME_STRING, "?") : "?",
+            dp ? SDL_GetStringProperty(dp, SDL_PROP_GPU_DEVICE_DRIVER_INFO_STRING, "?") : "?",
+            mShaderFormat == SDL_GPU_SHADERFORMAT_SPIRV ? "SPIR-V" : "MSL",
+            mDepthFormat == SDL_GPU_TEXTUREFORMAT_D24_UNORM ? "D24" : (mDepthFormat == SDL_GPU_TEXTUREFORMAT_D32_FLOAT ? "D32F" : "D16"),
+            mConfig.debug ? ", debug mode" : "");
+    return true;
+}
+
+void Device::Destroy() {
+    if (mDevice) {
+        if (mFrame && mFrame->mActive) {
+            LogError("Device::Destroy with a frame in progress; submitting it", false);
+            mFrame->End();
+        }
+        SDL_WaitForGPUIdle(mDevice);
+        mFrame.reset();
+        if (mPipelines) mPipelines->Clear();
+        if (mSamplers) mSamplers->Clear();
+        mPipelines.reset();
+        mSamplers.reset();
+        for (auto &kv : mShaders) SDL_ReleaseGPUShader(mDevice, kv.second);
+        mShaders.clear();
+        if (mDownload) SDL_ReleaseGPUTransferBuffer(mDevice, mDownload);
+        mDownload = nullptr;
+        mDownloadSize = 0;
+        DetachWindow();
+        SDL_DestroyGPUDevice(mDevice);
+        mDevice = nullptr;
+    }
+    if (mInitedVideo) {
+        SDL_QuitSubSystem(SDL_INIT_VIDEO);
+        mInitedVideo = false;
+    }
+}
+
+const char *Device::DriverName() const { return mDevice ? SDL_GetGPUDeviceDriver(mDevice) : "none"; }
+
+bool Device::SupportsTexture(SDL_GPUTextureFormat format, SDL_GPUTextureUsageFlags usage) const {
+    return mDevice && SDL_GPUTextureSupportsFormat(mDevice, format, SDL_GPU_TEXTURETYPE_2D, usage);
+}
+
+bool Device::AttachWindow(SDL_Window *window) {
+    if (!mDevice || !window) return false;
+    if (mWindow == window) return true;
+    DetachWindow();
+    if (!SDL_ClaimWindowForGPUDevice(mDevice, window)) {
+        ReportFailure("SDL_ClaimWindowForGPUDevice");
+        return false;
+    }
+    mWindow = window;
+    mPresentModeDirty = true;
+    return ApplyPresentMode();
+}
+
+void Device::DetachWindow() {
+    if (mDevice && mWindow) {
+        SDL_WaitForGPUIdle(mDevice);
+        SDL_ReleaseWindowFromGPUDevice(mDevice, mWindow);
+    }
+    mWindow = nullptr;
+}
+
+SDL_GPUTextureFormat Device::SwapchainFormat() const {
+    return (mDevice && mWindow) ? SDL_GetGPUSwapchainTextureFormat(mDevice, mWindow) : SDL_GPU_TEXTUREFORMAT_INVALID;
+}
+
+bool Device::SetVsync(bool enabled) {
+    mVsync = enabled;
+    mPresentModeDirty = true;
+    if (CurrentFrame()) return true;  // applied when the frame ends
+    return ApplyPresentMode();
+}
+
+bool Device::ApplyPresentMode() {
+    if (!mPresentModeDirty) return true;
+    mPresentModeDirty = false;
+    if (!mWindow) return true;
+    SDL_GPUPresentMode mode = SDL_GPU_PRESENTMODE_VSYNC;
+    if (!mVsync) {
+        // Uncapped means uncapped: MAILBOX still presents at the display
+        // refresh (its acquire fence waits for the previous frame's
+        // present), so it caps fast-forward at the refresh rate. Take
+        // IMMEDIATE when the driver offers it, MAILBOX only as a fallback.
+        if (SDL_WindowSupportsGPUPresentMode(mDevice, mWindow, SDL_GPU_PRESENTMODE_IMMEDIATE)) {
+            mode = SDL_GPU_PRESENTMODE_IMMEDIATE;
+        } else if (SDL_WindowSupportsGPUPresentMode(mDevice, mWindow, SDL_GPU_PRESENTMODE_MAILBOX)) {
+            mode = SDL_GPU_PRESENTMODE_MAILBOX;
+        } else {
+            LogInfo("vsync off requested but the swapchain only supports VSYNC");
+        }
+    }
+    if (!SDL_SetGPUSwapchainParameters(mDevice, mWindow, SDL_GPU_SWAPCHAINCOMPOSITION_SDR, mode)) {
+        ReportFailure("SDL_SetGPUSwapchainParameters");
+        return false;
+    }
+    mPresentMode = mode;
+    return true;
+}
+
+SDL_GPUShader *Device::Shader(const ShaderBlob &blob) {
+    auto it = mShaders.find(&blob);
+    if (it != mShaders.end()) return it->second;
+    if (!mDevice) return nullptr;
+    SDL_GPUShaderCreateInfo info;
+    SDL_zero(info);
+    if (mShaderFormat == SDL_GPU_SHADERFORMAT_SPIRV) {
+        info.code = blob.spirv;
+        info.code_size = blob.spirvSize;
+        info.entrypoint = "main";
+    } else {
+#if defined(SDL_PLATFORM_IOS) || defined(SDL_PLATFORM_TVOS)
+        info.code = blob.mslIos;
+        info.code_size = blob.mslIosSize;
+#else
+        info.code = blob.mslMacos;
+        info.code_size = blob.mslMacosSize;
+#endif
+        info.entrypoint = "main0";
+    }
+    info.format = mShaderFormat;
+    info.stage = blob.stage;
+    info.num_samplers = blob.numSamplers;
+    info.num_storage_textures = blob.numStorageTextures;
+    info.num_storage_buffers = blob.numStorageBuffers;
+    info.num_uniform_buffers = blob.numUniformBuffers;
+    SDL_PropertiesID props = SDL_CreateProperties();
+    SDL_SetStringProperty(props, SDL_PROP_GPU_SHADER_CREATE_NAME_STRING, blob.name);
+    info.props = props;
+    SDL_GPUShader *shader = SDL_CreateGPUShader(mDevice, &info);
+    SDL_DestroyProperties(props);
+    if (!shader) {
+        char ctx[256];
+        SDL_snprintf(ctx, sizeof ctx, "SDL_CreateGPUShader(%s)", blob.name);
+        ReportFailure(ctx);
+        return nullptr;
+    }
+    mShaders[&blob] = shader;
+    return shader;
+}
+
+Frame *Device::BeginFrame() {
+    if (!mDevice) return nullptr;
+    if (mFrame->mActive) {
+        ReportFailure("BeginFrame while a frame is in progress", false);
+        return nullptr;
+    }
+    ApplyPresentMode();
+    if (!mFrame->Begin(++mFrameIndex)) return nullptr;
+    return mFrame.get();
+}
