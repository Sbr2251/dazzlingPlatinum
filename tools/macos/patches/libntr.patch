diff --git a/include/simulator/sim_battle3d.h b/include/simulator/sim_battle3d.h
new file mode 100644
index 0000000..036789f
--- /dev/null
+++ b/include/simulator/sim_battle3d.h
@@ -0,0 +1,220 @@
+#ifndef SIM_BATTLE3D_H
+#define SIM_BATTLE3D_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Biome IDs mapped from Platinum BACKGROUND_* constants.
+enum SIM_Battle3DBiome {
+    SIM_BATTLE3D_BIOME_PLAIN = 0,            // plain_route.b3d (Route 201/202 sunny clearing)
+    SIM_BATTLE3D_BIOME_FOREST = 1,           // forest.b3d (Eterna Forest)
+    SIM_BATTLE3D_BIOME_WATER = 2,            // water_lake.b3d (Lake / Surf)
+    SIM_BATTLE3D_BIOME_CAVE = 3,             // mountain_cave.b3d (Cave / Mt. Coronet)
+    SIM_BATTLE3D_BIOME_SNOW = 4,             // snow.b3d (Snowpoint / Route 216)
+    SIM_BATTLE3D_BIOME_CITY = 5,             // city.b3d (Jubilife / Veilstone)
+    SIM_BATTLE3D_BIOME_INDOORS = 6,          // indoors_gym.b3d (Gym / League / Indoors)
+    SIM_BATTLE3D_BIOME_DISTORTION = 7,       // distortion_world.b3d (Distortion World)
+    SIM_BATTLE3D_BIOME_COUNT = 8
+};
+
+// Time-of-day lighting presets.
+enum SIM_Battle3DTimeOfDay {
+    SIM_BATTLE3D_TOD_MORNING = 0,
+    SIM_BATTLE3D_TOD_DAY = 1,
+    SIM_BATTLE3D_TOD_EVENING = 2,
+    SIM_BATTLE3D_TOD_NIGHT = 3
+};
+
+// Weather atmosphere modifiers.
+enum SIM_Battle3DWeather {
+    SIM_BATTLE3D_WEATHER_CLEAR = 0,
+    SIM_BATTLE3D_WEATHER_RAIN = 1,
+    SIM_BATTLE3D_WEATHER_SUN = 2,
+    SIM_BATTLE3D_WEATHER_HAIL = 3,
+    SIM_BATTLE3D_WEATHER_SAND = 4,
+    SIM_BATTLE3D_WEATHER_FOG = 5
+};
+
+#define SIM_BATTLE3D_MAX_BATTLERS 4
+
+// Animation states driven by Dazzling Platinum's battle engine onto 3D .glb rigs.
+enum SIM_Battle3DAnimState {
+    SIM_BATTLE3D_ANIM_IDLE = 0,
+    SIM_BATTLE3D_ANIM_ATTACK_PHYS = 1,
+    SIM_BATTLE3D_ANIM_ATTACK_SPEC = 2,
+    SIM_BATTLE3D_ANIM_HIT = 3,
+    SIM_BATTLE3D_ANIM_FAINT = 4,
+    SIM_BATTLE3D_ANIM_CRY = 5
+};
+
+typedef struct SIM_Battle3DBattler {
+    int visible;       // 1 if active on field
+    int isPlayer;      // 1 = player side, 0 = enemy side
+    float worldX;      // 3D clearing ground X
+    float worldY;      // vertical elevation above ground (0 = grounded, >0 = flying/jumping)
+    float worldZ;      // 3D clearing ground Z
+    float shadowRadius; // ground shadow radius in world units (e.g. 0.7..1.4)
+    float alpha;       // 0..1 fade alpha
+    // --- BDSP extracted 3D model fields (zero-initialized when unused) ---
+    int species;       // National Dex species id (e.g. 392 Infernape, 400 Bibarel); 0 = none
+    int form;          // Form index (0 = base)
+    int isShiny;       // 1 = shiny variant
+    float yawDeg;      // Facing yaw in degrees (0 = +Z toward camera, 180 = -Z away)
+    float modelScale;  // Uniform world scale multiplier (<=0 treated as 1.0)
+    int animState;     // enum SIM_Battle3DAnimState
+    float animTime;    // Elapsed seconds in current animState
+    int animNonce;     // Increments each time a one-shot animation triggers
+    int use3dModel;    // 1 when the game wants the 3D .glb model drawn (and suppressed 2D sprite)
+    float flashAmount; // 0..1 bright white/red send-out materialization glow
+} SIM_Battle3DBattler;
+
+typedef struct SIM_Battle3DFrame {
+    int active;                // 1 when a 3D battle scene should draw this frame
+    int biome;                 // enum SIM_Battle3DBiome
+    int timeOfDay;             // enum SIM_Battle3DTimeOfDay
+    int weather;               // enum SIM_Battle3DWeather
+    float alpha;               // 0..1 overall arena alpha (respects BattleStage_Suppress crossfade)
+    float timeSec;             // monotonic battle time in seconds (gentle wind/water sway)
+    float brightness;          // -1..+1 flash/dim offset (e.g. Mega pulse or lightning flash)
+    float camEye[3];           // camera world eye position (RH: X right, Y up, Z toward viewer)
+    float camTarget[3];        // camera world look-at point
+    float camFovDeg;           // vertical FOV in degrees (e.g. 36.0)
+    float camAspect;           // aspect ratio (16/9 in wide mode)
+    SIM_Battle3DBattler battlers[SIM_BATTLE3D_MAX_BATTLERS];
+    // --- BDSP extracted 3D trainer / Poke Ball intro actors (zero-initialized when unused) ---
+    struct SIM_Battle3DActor {
+        int visible;
+        int kind;          // enum SIM_Battle3DActorKind
+        float worldX;
+        float worldY;
+        float worldZ;
+        float yawDeg;
+        float pitchDeg;
+        float rollDeg;
+        float scale;       // <=0 treated as 1.0
+        float alpha;       // 0..1
+        int animState;     // enum SIM_Battle3DTrainerAnim
+        float animTime;    // deterministic seconds
+        int animNonce;
+        // Bone socket attachment (e.g. Poke Ball held in trainer RHand during wind-up):
+        // attachBoneKind: 0 = world space, 1 = RHand, 2 = LHand.
+        // When attachBoneKind != 0, attachActorIdx (0..3) names the parent actor.
+        int attachActorIdx;
+        int attachBoneKind;
+        float attachOffset[3];
+    } actors[4];
+    // 3D Poke Ball open / materialization light burst VFX
+    struct SIM_Battle3DBurst {
+        int active;
+        float worldX;
+        float worldY;
+        float worldZ;
+        float progress;    // 0..1 normalized burst timeline
+        float radius;      // peak burst radius in meters (e.g. 1.6)
+        float color[3];    // RGB tint (e.g. 1.0, 0.88, 0.72)
+    } burst;
+    int modelsEnabled;     // 1 when game-side BattleModels3D allows extracted GLB arena/models (Opus B2)
+} SIM_Battle3DFrame;
+
+#define SIM_BATTLE3D_MAX_ACTORS 4
+typedef struct SIM_Battle3DActor SIM_Battle3DActor;
+
+enum SIM_Battle3DActorKind {
+    SIM_BATTLE3D_ACTOR_NONE = 0,
+    SIM_BATTLE3D_ACTOR_TRAINER_LUCAS = 1, // trainers/pc0001_00.glb
+    SIM_BATTLE3D_ACTOR_TRAINER_DAWN = 2,  // trainers/pc0002_00.glb
+    SIM_BATTLE3D_ACTOR_POKEBALL = 3       // trainers/pokeball.glb
+};
+
+enum SIM_Battle3DTrainerAnim {
+    SIM_BATTLE3D_TRANIM_WAIT = 0,
+    SIM_BATTLE3D_TRANIM_THROW = 1,
+    SIM_BATTLE3D_TRANIM_ADVENT = 2,
+    SIM_BATTLE3D_TRANIM_LOSE = 3
+};
+
+// --- Compact binary 3D biome format (.b3d v1, little-endian) ---
+#define B3D_MAGIC_0 'B'
+#define B3D_MAGIC_1 '3'
+#define B3D_MAGIC_2 'D'
+#define B3D_MAGIC_3 '1'
+#define B3D_VERSION 1
+
+#define B3D_TEX_FLAG_REPEAT         (1u << 0)
+
+#define B3D_SUBMESH_UNLIT           (1u << 0) // sky dome / emissive (skip toon diffuse + shadows)
+#define B3D_SUBMESH_CAST_SHADOW     (1u << 1) // render in directional sun shadow pass
+#define B3D_SUBMESH_RECEIVE_SHADOW  (1u << 2) // sample shadow map in main pass
+#define B3D_SUBMESH_ALPHA_TEST      (1u << 3) // discard alpha < 0.5 (foliage/grass cards)
+#define B3D_SUBMESH_DOUBLE_SIDED    (1u << 4) // disable backface culling
+
+typedef struct B3DHeader {
+    char magic[4];
+    uint32_t version;
+    uint32_t numTextures;
+    uint32_t numSubmeshes;
+    uint32_t numVertices;
+    uint32_t numIndices;
+    uint32_t pad[2];
+} B3DHeader;
+
+typedef struct B3DTextureDesc {
+    uint32_t width;
+    uint32_t height;
+    uint32_t dataOffset; // byte offset from start of file to width*height*4 RGBA8 pixels
+    uint32_t flags;
+} B3DTextureDesc;
+
+typedef struct B3DSubmeshDesc {
+    uint32_t firstIndex;
+    uint32_t indexCount;
+    int32_t textureIndex; // -1 = untextured (vertex color only)
+    uint32_t flags;
+    float roughness;
+    float fogFactor;      // 0.0 = no distance fog (sky), 1.0 = full atmospheric haze
+    uint32_t pad[2];
+} B3DSubmeshDesc;
+
+typedef struct B3DVertex {
+    float pos[3];
+    float norm[3];
+    float uv[2];
+    float color[4];
+} B3DVertex;
+
+// Simulator-side API (implemented in libntr render_gpu/fx_battle3d.cpp).
+void SIM_Battle3D_SetFrame(const SIM_Battle3DFrame *frame);
+void SIM_Battle3D_Clear(void);
+int SIM_Battle3D_IsSupported(void);
+// Extracted BDSP .glb asset availability queries (read-only disk/cache probe).
+// Returns 1 if <bdsp_assets>/mons/pmXXXX_YY[_shiny].glb exists and is usable.
+int SIM_Battle3D_HasModel(int species, int form, int isShiny);
+// Returns 1 if <bdsp_assets>/arenas/<biome>.glb exists and is usable.
+int SIM_Battle3D_HasArena(int biome);
+// Returns 1 if <bdsp_assets>/trainers/<actor>.glb exists and is usable.
+int SIM_Battle3D_HasActor(int kind);
+// Queries the live world-space position of an actor's named hand bone (1=RHand, 2=LHand).
+// Returns 1 and writes outPos[3] if the actor is loaded and the bone was evaluated.
+int SIM_Battle3D_GetActorBonePos(int actorIdx, int boneKind, float outPos[3]);
+// Queries cached local-space bounding box (meters) of a Pokemon GLB for size normalization (Opus B3).
+// Returns 1 if available and writes outMin[3]/outMax[3].
+int SIM_Battle3D_GetModelBounds(int species, int form, int isShiny, float outMin[3], float outMax[3]);
+// Returns 1 if the model is already GPU-uploaded and render-ready (or 0 while async loading, Opus P1).
+int SIM_Battle3D_IsModelReady(int species, int form, int isShiny);
+// Queries a versioned, bone-local-offset world socket position (e.g. palm center) for
+// an actor matching `expectedNonce` and `animTime >= minAnimTime`. Returns 1 on match.
+int SIM_Battle3D_GetActorSocketPos(int actorIdx, int boneKind, int expectedNonce,
+                                   float minAnimTime, const float localOffset[3],
+                                   float outPos[3]);
+// Returns the loaded animation clip duration in seconds for a 3D Pokemon model slot
+// (SIM_Battle3DAnimState), or 0.0f if unavailable.
+float SIM_Battle3D_GetClipDuration(int species, int form, int isShiny, int animState);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SIM_BATTLE3D_H
