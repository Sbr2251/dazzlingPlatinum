+            mac_air = os.path.join(tmp, f"{name}.mac.air")
+            ios_air = os.path.join(tmp, f"{name}.ios.air")
+
+            with open(glsl_path, "w") as f:
+                f.write(glsl_src)
+            with open(msl_path, "w") as f:
+                f.write(msl_src)
+
+            run([glslang, "-V", "--target-env", "vulkan1.0", "-S", stage, "-o", spv_path, glsl_path])
+            run(["xcrun", "-sdk", "macosx", "metal", "-std=macos-metal2.1", "-Wall", "-Werror", "-c", msl_path, "-o", mac_air])
