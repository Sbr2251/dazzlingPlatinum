+#pragma once
+
+// Lazy loader for untracked BDSP Battle UI sprite atlas (<bdsp_assets>/ui/manifest.json + atlas.png).
+// Gated in headless runs on SIM_FX_BDSP_MODELS=1 so existing visual_bdsp_hd_* goldens remain 0% diff.
+
+#include <simulator/gpu/gpu.hpp>
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+
+namespace SIM::Render {
+
+struct HudUiSprite {
+  float x = 0.0f;
+  float y = 0.0f;
+  float w = 0.0f;
+  float h = 0.0f;
+  float u0 = 0.0f;
+  float v0 = 0.0f;
+  float u1 = 0.0f;
+  float v1 = 0.0f;
+  // 9-slice borders in source sprite pixels: left, top, right, bottom.
+  float bl = 0.0f;
+  float bt = 0.0f;
+  float br = 0.0f;
+  float bb = 0.0f;
+  bool valid = false;
+};
+
+class HudUiAtlas {
+ public:
+  HudUiAtlas() = default;
+  ~HudUiAtlas();
+  HudUiAtlas(const HudUiAtlas &) = delete;
+  HudUiAtlas &operator=(const HudUiAtlas &) = delete;
+
+  // Probes and uploads the BDSP UI atlas once if permitted by the models gate.
+  // Must be called outside an open render pass (e.g. in FxHudHD::Prepare).
+  bool EnsureLoaded(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame);
+
+  void Release();
+
+  bool Ready() const { return mReady; }
+  SDL_GPUTexture *TextureHandle() const { return mReady ? mTexture.Handle() : nullptr; }
+
+  const HudUiSprite *Find(const char *key) const;
+
+  // Cached fast-path lookups (nullptr when not present).
+  const HudUiSprite *btnFight = nullptr;
+  const HudUiSprite *btnPokemon = nullptr;
+  const HudUiSprite *btnBag = nullptr;
+  const HudUiSprite *btnRun = nullptr;
+  const HudUiSprite *btnCancel = nullptr;
+  const HudUiSprite *btnPlainRed = nullptr;
+  const HudUiSprite *btnPlainGreen = nullptr;
+  const HudUiSprite *btnPlainGold = nullptr;
+  const HudUiSprite *btnPlainBlue = nullptr;
+  const HudUiSprite *btnQuickBall = nullptr;
+  const HudUiSprite *cursorFrame = nullptr;
+  const HudUiSprite *cursorEff = nullptr;
+  const HudUiSprite *cardPlayer = nullptr;
+  const HudUiSprite *cardEnemy = nullptr;
+  const HudUiSprite *partyStrip = nullptr;
+  const HudUiSprite *hpBarFrame = nullptr;
+  const HudUiSprite *hpFillGreen = nullptr;
+  const HudUiSprite *hpFillYellow = nullptr;
+  const HudUiSprite *hpFillRed = nullptr;
+  const HudUiSprite *expBg = nullptr;
+  const HudUiSprite *expFill = nullptr;
+  const HudUiSprite *ballOk = nullptr;
+  const HudUiSprite *ballStatus = nullptr;
+  const HudUiSprite *ballFainted = nullptr;
+  const HudUiSprite *ballEmpty = nullptr;
+  const HudUiSprite *ballHdOk = nullptr;
+  const HudUiSprite *caughtIcon = nullptr;
+  const HudUiSprite *genderM = nullptr;
+  const HudUiSprite *genderF = nullptr;
+  const HudUiSprite *keyA = nullptr;
+  const HudUiSprite *keyB = nullptr;
+  const HudUiSprite *keyX = nullptr;
+  const HudUiSprite *keyY = nullptr;
+  const HudUiSprite *keyPillX = nullptr;
+  const HudUiSprite *keyPillY = nullptr;
+  const HudUiSprite *catPhys = nullptr;
+  const HudUiSprite *catSpec = nullptr;
+  const HudUiSprite *catStatus = nullptr;
+  const HudUiSprite *effSuper = nullptr;
+  const HudUiSprite *effNormal = nullptr;
+  const HudUiSprite *effNotVery = nullptr;
+  const HudUiSprite *effNone = nullptr;
+  const HudUiSprite *statusPar = nullptr;
+  const HudUiSprite *statusSlp = nullptr;
+  const HudUiSprite *statusFrz = nullptr;
+  const HudUiSprite *statusBrn = nullptr;
+  const HudUiSprite *statusPsn = nullptr;
+  const HudUiSprite *statusTox = nullptr;
+  const HudUiSprite *statusFnt = nullptr;
+  const HudUiSprite *infoMoveBg = nullptr;
+  const HudUiSprite *infoStatusBg = nullptr;
+  const HudUiSprite *infoSubBg = nullptr;
+  const HudUiSprite *moveCard[18]{};
+  const HudUiSprite *typeBadge[18]{};
+
+ private:
+  void CacheWellKnown();
+
+  SIM::Gpu::Texture mTexture;
+  bool mProbed = false;
+  bool mReady = false;
+  std::uint32_t mWidth = 0;
+  std::uint32_t mHeight = 0;
+  std::unordered_map<std::string, HudUiSprite> mSprites;
+};
+
