+    // Poke Ball send-out materialization glow (warm-white core + crimson Fresnel rim)
+    float flash = clamp(u.camEye.w, 0.0, 1.0);
+    if (flash > 0.001) {
+        float normLenF = length(in.worldNorm);
+        float3 Nf = normLenF > 0.0001 ? (in.worldNorm / normLenF) : float3(0.0, 1.0, 0.0);
