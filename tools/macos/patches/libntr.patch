+  glBindVertexArray(sPostVAO);
+  glDrawArrays(GL_TRIANGLES, 0, 6);
+  FxTick(sFxShock); FxTick(sFxVignette); FxTick(sFxZoom);
+  FxTick(sFxChroma); FxTick(sFxGlow); FxTick(sFxShake); FxTick(sFxLetterbox);
+  sFxFrame++;
+}
