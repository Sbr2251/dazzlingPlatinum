+namespace {
+struct PostFXEffect {
+  float x = 0, y = 0;         // centre, combined-display pixels
+  float r = 0, g = 0, b = 0;  // vignette colour
+  float strength = 0;
+  int framesLeft = 0;
+  int framesTotal = 0;
