+  void RenderPost(const PostFXParams &p) override {
+    if (!mPostProgram || mPostW <= 0) return;
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glViewport(0, 0, mPostW, mPostH);
+    glUseProgram(mPostProgram);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, mPostTex);
+    glProgramUniform1i(mPostProgram, Uniform(mPostProgram, "sceneTex"), 0);
+    glProgramUniform2f(mPostProgram, Uniform(mPostProgram, "texelSize"),
+                       mPostW > 0 ? 1.0f / (float)mPostW : 0.0f,
+                       mPostH > 0 ? 1.0f / (float)mPostH : 0.0f);
+    glProgramUniform2f(mPostProgram, Uniform(mPostProgram, "shakeOffset"),
+                       p.shakeOffset[0], p.shakeOffset[1]);
+    glProgramUniform2f(mPostProgram, Uniform(mPostProgram, "shockCenter"),
+                       p.shockCenter[0], p.shockCenter[1]);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "shockRadius"),
+                       p.shockRadius);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "shockStrength"),
+                       p.shockStrength);
+    glProgramUniform2f(mPostProgram, Uniform(mPostProgram, "zoomCenter"),
+                       p.zoomCenter[0], p.zoomCenter[1]);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "zoomBlur"),
+                       p.zoomBlur);
+    glProgramUniform3f(mPostProgram, Uniform(mPostProgram, "vignetteColor"),
+                       p.vignetteColor[0], p.vignetteColor[1],
+                       p.vignetteColor[2]);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "vignetteAmount"),
+                       p.vignetteAmount);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "chromaAmount"),
+                       p.chromaAmount);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "glowAmount"),
+                       p.glowAmount);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "letterbox"),
+                       p.letterbox);
+    glProgramUniform1i(mPostProgram, Uniform(mPostProgram, "fxRegion"),
+                       p.fxRegion);
+    glProgramUniform2f(mPostProgram, Uniform(mPostProgram, "beamTarget"),
+                       p.beamTarget[0], p.beamTarget[1]);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "cutinProgress"),
+                       p.cutinProgress);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "cutinAlpha"),
+                       p.cutinAlpha);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "titleProgress"),
+                       p.titleProgress);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "titleAlpha"),
+                       p.titleAlpha);
+    glProgramUniform2f(mPostProgram, Uniform(mPostProgram, "glowCenter"),
+                       p.glowCenter[0], p.glowCenter[1]);
+    glProgramUniform1f(mPostProgram, Uniform(mPostProgram, "glowAtAmount"),
+                       p.glowAtAmount);
+    glBindVertexArray(mPostVao);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    glDrawArrays(GL_TRIANGLES, 0, 6);
+  }
