+void FxTick(PostFXEffect &e) { if (e.framesLeft > 0) e.framesLeft--; }
+// Combined-display pixel -> post-pass UV (GL origin is bottom-left).
+void FxUV(const PostFXEffect &e, float *u, float *v) {
+  if (sPostWinW <= 0 || sPostViewW <= 0) { *u = 0.5f; *v = 0.5f; return; }
+  *u = ((float)sPostViewX + e.x / 256.0f * (float)sPostViewW) / (float)sPostWinW;
+  *v = 1.0f - ((float)sPostViewY + e.y / 384.0f * (float)sPostViewH) / (float)sPostWinH;
