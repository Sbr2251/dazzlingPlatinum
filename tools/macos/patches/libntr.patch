+// ---- PostFX (include/port/postfx.h; docs/postfx.md) ----
+// The composited frame is rendered into sPostTex through sPostFBO, then drawn
+// to the window through the post shader. Effects decay per rendered frame in
+// PostFX_TickAndDraw. Coordinates from game code are combined-display pixels
+// (256x384, top-left origin); they are converted against the viewport rect
+// the 2D engines were drawn into (sPostView*), which SIM_Render refreshes.
+static GLuint sPostProgramID;
+static GLuint sPostFBO;
+static GLuint sPostTex;
+static GLuint sPostVAO;
+static GLuint sPostVBO;
+static int sPostW, sPostH;
+static int sPostViewX, sPostViewY, sPostViewW, sPostViewH;
+static int sPostWinW, sPostWinH;
+
+// ---- Display capture (DISPCAPCNT) + VRAM display mode ----
+// Hardware capture takes the main engine's frame (source A: the 2D+3D
+// composite, or 3D only), optionally blends it with VRAM (source B) by
+// EVA/EVB, and writes RGB555+alpha pixels into a VRAM bank A-D; the enable
+// bit then clears. Motion blur / Spear Pillar display that bank back with
+// DISPCNT display mode 2 (GX_DISPMODE_VRAM_*). The simulator keeps BG VRAM
+// and LCDC VRAM in separate arrays, so a capture writes the LCDC array and
+// also the main/sub BG view of the same bank (see CaptureFrame).
+static GLuint sCapFBO, sCapTex, sCapDispTex, sCapProg;
+static const char *sCapFragSrc = R""(
+#version 420 core
+uniform sampler2D capTex;
+uniform int topScreen;
+uniform float brightFactor;
+uniform int brightMode;
+smooth in vec2 fragTexCoord;
+out vec4 color;
+void main()
+{
+    if (topScreen == 1) { if (fragTexCoord.t < 0.5) discard; }
+    else { if (fragTexCoord.t >= 0.5) discard; }
+    color = texture(capTex, fragTexCoord);
+    if (brightMode == 1) color.rgb += (1.0 - color.rgb) * (brightFactor / 16.0);
+    else if (brightMode == 2) color.rgb -= color.rgb * (brightFactor / 16.0);
+    color.a = 1.0;
+}
+)"";
+
+namespace {
+struct PostFXEffect {
+  float x = 0, y = 0;         // centre, combined-display pixels
+  float r = 0, g = 0, b = 0;  // vignette colour
+  float strength = 0;
+  float progress = 0;         // cut-in/title sweep position
+  int framesLeft = 0;
+  int framesTotal = 0;
+};
+PostFXEffect sFxShock, sFxVignette, sFxZoom, sFxChroma, sFxGlow, sFxShake, sFxLetterbox;
+PostFXEffect sFxCutin, sFxTitle, sFxGlowAt;
+int sFxRegion = 1; // top screen only by default
+unsigned sFxFrame = 0;
+
+float FxFactor(const PostFXEffect &e) {
+  return e.framesTotal > 0 ? (float)e.framesLeft / (float)e.framesTotal : 0.0f;
+}
+void FxSet(PostFXEffect &e, int x, int y, float strength, int frames) {
+  e.x = (float)x; e.y = (float)y; e.strength = strength;
