+        if (sx < 0 || sx >= w) return vec4(0.0);
+        int sxF = (a1 & 0x1000u) != 0u ? w - 1 - sx : sx;
+        int syF = (a1 & 0x2000u) != 0u ? h - 1 - sy : sy;
+        if (mode == 3) {
+            if ((a2 >> 12) == 0u) return vec4(0.0);
+            int addr;
+            if ((dispcnt & 0x40) != 0) {
+                if ((dispcnt & 0x20) != 0) return vec4(0.0);
+                addr = (tileNum << (7 + ((dispcnt >> 22) & 1))) + syF * w * 2 + sxF * 2;
+            } else if ((dispcnt & 0x20) != 0) {
+                addr = ((tileNum & 0x1F) << 4) + ((tileNum & 0x3E0) << 7) + syF * 512 + sxF * 2;
+            } else {
+                addr = ((tileNum & 0xF) << 4) + ((tileNum & 0x3F0) << 7) + syF * 256 + sxF * 2;
+            }
+            uint c = objWord(addr);
+            if ((c & 0x8000u) != 0u) { hit = true; palByte = int(c & 0xFFu); }
+        } else if ((a0 & 0x2000u) != 0u) { // 8bpp
+            int t = tileNum;
+            if ((dispcnt & 0x10) != 0) { t <<= ((dispcnt >> 20) & 3); t += ((syF >> 3) * (w >> 3)) << 1; }
+            else t += (syF >> 3) * 0x20;
+            uint idx = objByte((t << 5) + ((syF & 7) << 3) + ((sxF >> 3) << 6) + (sxF & 7));
+            if (idx != 0u) { hit = true; palByte = int(idx); }
+        } else {
+            int t = tileNum;
+            if ((dispcnt & 0x10) != 0) { t <<= ((dispcnt >> 20) & 3); t += (syF >> 3) * (w >> 3); }
+            else t += (syF >> 3) * 0x20;
