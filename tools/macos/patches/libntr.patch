+
+SKINNED_FRAG_MSL = r"""#include <metal_stdlib>
+#include <simd/simd.h>
+using namespace metal;
+
+struct SkinnedMainFragUniforms {
+    float4 sunDir;          // xyz = normalized toward sun, w = rimStrength
+    float4 sunColor;        // rgb = sunlight color
+    float4 skyAmbient;      // rgb = upper hemisphere ambient
+    float4 groundAmbient;   // rgb = lower hemisphere bounce
+    float4 fogColor;        // rgb = atmospheric fog color
+    float4 shadowTint;      // rgb = cool shadow tint, w = shadowStrength
+    float4 baseColorFactor; // rgba material baseColorFactor
+    float4 emissiveFactor;  // rgb = emissive, w = alphaCutoff
+    float4 camEye;          // xyz = camera world position, w = flashAmount (0..1 send-out glow)
+    float4 fogParams;       // x = fogStart, y = fogEnd, z = shadowTexelSize, w = hasShadowMap
+    float4 modelParams;     // x = shadowReceiveScale, y = fogFactor, z = brightness, w = combinedAlpha
+    int4   flags;           // x = useTexture, y = unlit, z = receiveShadow, w = alphaMode (0=O,1=M,2=B)
+};
+
+struct main0_in {
+    float3 worldPos      [[user(locn0)]];
+    float3 worldNorm     [[user(locn1)]];
+    float2 fragUV        [[user(locn2)]];
+    float4 fragColor     [[user(locn3)]];
+    float4 lightSpacePos [[user(locn4)]];
+};
+
+struct main0_out {
+    float4 color [[color(0)]];
+};
+
+constant float kBayer4x4[16] = {
+     0.0,  8.0,  2.0, 10.0,
+    12.0,  4.0, 14.0,  6.0,
+     3.0, 11.0,  1.0,  9.0,
+    15.0,  7.0, 13.0,  5.0
+};
+
+fragment main0_out main0(main0_in in [[stage_in]],
+                         float4 fragCoord [[position]],
+                         bool frontFacing [[front_facing]],
+                         constant SkinnedMainFragUniforms& u [[buffer(0)]],
+                         texture2d<float> albedoTex [[texture(0)]],
+                         sampler albedoSmplr [[sampler(0)]],
+                         depth2d<float> shadowTex [[texture(1)]],
+                         sampler shadowSmplr [[sampler(1)]]) {
+    main0_out out = {};
+    if (u.flags.y == 2) {
+        float t = u.fogColor.w;
+        float4 s0 = albedoTex.sample(albedoSmplr, in.fragUV);
+        float core = s0.b;
+        float vBase = clamp(in.fragUV.y, 0.0, 1.0); // 1.0 at skull/tail base, 0.0 at plume tip
+        float2 uvA = float2(in.fragUV.x + 0.045 * sin(vBase * 6.28318 - t * 4.5),
+                            fract(vBase + t * 1.15));
+        float2 uvB = float2(in.fragUV.x * 1.35 - 0.030 * cos(vBase * 5.0 - t * 5.8),
+                            fract(vBase * 1.15 + t * 1.85));
+        float nA = albedoTex.sample(albedoSmplr, uvA).r;
+        float nB = albedoTex.sample(albedoSmplr, uvB).g;
+        float normLen = length(in.worldNorm);
+        float3 N = normLen > 0.0001 ? (in.worldNorm / normLen) : float3(0.0, 1.0, 0.0);
+        if (!frontFacing) N = -N;
+        float3 V = normalize(u.camEye.xyz - in.worldPos);
+        float ndv = abs(dot(N, V));
+        // Tall cohesive roaring plume: solid near base & center, jagged flickering tongues toward tip & silhouette edge
+        float plumeBody = max(core * 1.15, smoothstep(0.04, 0.62, vBase) * (0.48 + 0.52 * pow(ndv, 0.55)));
+        float edgeField = plumeBody + (nA * 0.44 + nB * 0.28) * (0.35 + 0.65 * (1.0 - core));
+        float alpha = smoothstep(0.30, 0.56, edgeField) * smoothstep(0.0, 0.14, vBase + nA * 0.10) * u.baseColorFactor.a * u.modelParams.w;
+        if (alpha < 0.04) {
+            discard_fragment();
+        }
+        // BDSP 2-tone cel fire: incandescent yellow-white inner core -> vivid red-orange outer tongues
+        float hotVal = core * 0.85 + smoothstep(0.22, 0.88, vBase) * 0.42 + nB * 0.38 + ndv * 0.24 - (1.0 - nA) * 0.14;
+        float hot = smoothstep(0.32, 0.72, hotVal);
+        float coreWhite = smoothstep(0.78, 1.12, hotVal);
+        float3 outerCol = u.baseColorFactor.rgb * 1.32;
+        float3 innerCol = mix(u.emissiveFactor.rgb * 1.24, float3(1.0, 0.99, 0.88), coreWhite * 0.65);
+        float3 fcol = mix(outerCol, innerCol, hot) + outerCol * pow(1.0 - ndv, 2.0) * 0.28;
+        float flash = clamp(u.camEye.w, 0.0, 1.0);
+        if (flash > 0.001) {
+            fcol = mix(fcol, float3(1.0, 0.92, 0.90), flash * 0.85);
+        }
+        out.color = float4(saturate(fcol), clamp(alpha, 0.0, 1.0));
+        return out;
+    }
+    // B6: 4x4 Bayer screen-door alpha dither for fading opaque/mask primitives so depthWrite stays on
+    // and interior/back geometry never shows through during fades.
+    if (u.flags.w != 2 && u.modelParams.w < 0.999) {
+        uint2 px = uint2(fragCoord.xy) & 3u;
+        float thresh = (kBayer4x4[px.y * 4u + px.x] + 0.5) * (1.0 / 16.0);
+        if (u.modelParams.w < thresh) {
+            discard_fragment();
+        }
+    }
+    float4 baseColor = in.fragColor * u.baseColorFactor;
+    if (u.flags.x != 0) {
+        baseColor *= albedoTex.sample(albedoSmplr, in.fragUV);
+    }
+    if (u.flags.w == 1 && baseColor.a < u.emissiveFactor.w) {
+        discard_fragment();
+    }
+
+    float3 col;
+    if (u.flags.y != 0) {
+        col = baseColor.rgb + u.emissiveFactor.rgb;
+    } else {
+        float normLen = length(in.worldNorm);
+        float3 N = normLen > 0.0001 ? (in.worldNorm / normLen) : float3(0.0, 1.0, 0.0);
+        if (!frontFacing) {
+            N = -N;
+        }
+        float3 L = normalize(u.sunDir.xyz);
+        float NdotL = dot(N, L);
+
+        // BDSP character 2-band stylized toon diffuse ramp
+        float wrapNdotL = NdotL * 0.58 + 0.42;
+        float band1 = smoothstep(0.22, 0.44, wrapNdotL);
+        float band2 = smoothstep(0.66, 0.90, wrapNdotL);
+        float toonDiffuse = mix(0.34, 1.0, band1 * 0.74 + band2 * 0.26);
+
+        // Gentle 4-tap PCF shadow receiving (attenuated so characters avoid harsh self-acne)
+        float shadowVis = 1.0;
+        if (u.flags.z != 0 && u.fogParams.w > 0.5) {
+            float3 proj = in.lightSpacePos.xyz / max(in.lightSpacePos.w, 0.0001);
+            float2 suv = float2(proj.x * 0.5 + 0.5, 0.5 - proj.y * 0.5);
+            if (suv.x > 0.002 && suv.x < 0.998 && suv.y > 0.002 && suv.y < 0.998 &&
+                proj.z > 0.0 && proj.z < 1.0) {
+                float bias = mix(max(0.0018, 0.0032 * (1.0 - max(NdotL, 0.0))),
+                                 max(0.0030, 0.0055 * (1.0 - max(NdotL, 0.0))),
+                                 step(u.modelParams.x, 0.8));
+                float ts = u.fogParams.z;
+                float cmp = proj.z - bias;
+                float vis = 0.0;
+                vis += (cmp <= shadowTex.sample(shadowSmplr, suv + float2(-0.75 * ts, -1.25 * ts))) ? 1.0 : 0.0;
+                vis += (cmp <= shadowTex.sample(shadowSmplr, suv + float2( 1.25 * ts, -0.75 * ts))) ? 1.0 : 0.0;
+                vis += (cmp <= shadowTex.sample(shadowSmplr, suv + float2(-1.25 * ts,  0.75 * ts))) ? 1.0 : 0.0;
+                vis += (cmp <= shadowTex.sample(shadowSmplr, suv + float2( 0.75 * ts,  1.25 * ts))) ? 1.0 : 0.0;
+                vis *= 0.25;
+                float2 border = min(suv, float2(1.0) - suv);
+                float borderFade = smoothstep(0.0, 0.06, min(border.x, border.y));
+                shadowVis = mix(1.0, vis, borderFade * u.shadowTint.w * u.modelParams.x);
+            }
+        }
+
+        float3 hemi = mix(u.groundAmbient.rgb, u.skyAmbient.rgb, clamp(N.y * 0.5 + 0.5, 0.0, 1.0));
