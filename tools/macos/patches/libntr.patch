+  std::shared_ptr<Texture> GetTexture(const TextureKey& key);
+  bool GetStoredCRCs(const TextureKey& key, u32 * textureCRC, u32 * paletteCRC);
+  // The cached texture regardless of recorded writes (for CRC revalidation).
+  std::shared_ptr<Texture> PeekTexture(const TextureKey& key);
+
+  // Record a write to texture/palette VRAM (see sim_g3_texnotify.h).
+  static void NotifyWrite(const void * dest, std::size_t size);
+
  private:
-  u64 GetCombinedCRC(u32 textureCRC, u32 paletteCRC);
-  std::unordered_map<u64, std::shared_ptr<Texture>> mTextureMap = {};
+  struct Entry {
