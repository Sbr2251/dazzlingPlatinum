+};
+
+struct main0_in {
+    float3 pos     [[attribute(0)]];
+    float3 norm    [[attribute(1)]];
+    float2 uv      [[attribute(2)]];
+    float4 color   [[attribute(3)]];
+    uint4  joints  [[attribute(4)]];
+    float4 weights [[attribute(5)]];
+};
+
+struct main0_out {
+    float3 worldPos      [[user(locn0)]];
+    float3 worldNorm     [[user(locn1)]];
+    float2 fragUV        [[user(locn2)]];
+    float4 fragColor     [[user(locn3)]];
+    float4 lightSpacePos [[user(locn4)]];
+    float4 gl_Position   [[position]];
+};
+
+vertex main0_out main0(main0_in in [[stage_in]],
+                       constant SkinnedMainVertUniforms& u [[buffer(0)]],
+                       constant SkinnedJointsUniforms& jb [[buffer(1)]]) {
+    main0_out out = {};
+    float4 localPos = float4(in.pos, 1.0);
+    float3 localNorm = in.norm;
+    if (u.params.x > 0.5) {
+        float wSum = in.weights.x + in.weights.y + in.weights.z + in.weights.w;
+        if (wSum > 0.0001) {
+            float4 w = in.weights / wSum;
+            uint4 j = min(in.joints, uint4(191u));
+            float4x4 skinMat =
+                jb.joints[j.x] * w.x +
+                jb.joints[j.y] * w.y +
+                jb.joints[j.z] * w.z +
+                jb.joints[j.w] * w.w;
+            localPos = skinMat * localPos;
+            float3 c0 = skinMat[0].xyz;
+            float3 c1 = skinMat[1].xyz;
+            float3 c2 = skinMat[2].xyz;
+            float3 n0 = cross(c1, c2);
+            float3 n1 = cross(c2, c0);
+            float3 n2 = cross(c0, c1);
+            float det = dot(c0, n0);
+            localNorm = (abs(det) > 1e-6)
+                ? (n0 * in.norm.x + n1 * in.norm.y + n2 * in.norm.z) * (det < 0.0 ? -1.0 : 1.0)
+                : (c0 * in.norm.x + c1 * in.norm.y + c2 * in.norm.z);
+        }
+    }
+    float4 worldPos = u.modelMat * localPos;
+    float3 m0 = u.modelMat[0].xyz;
+    float3 m1 = u.modelMat[1].xyz;
+    float3 m2 = u.modelMat[2].xyz;
+    float3 mn0 = cross(m1, m2);
+    float3 mn1 = cross(m2, m0);
+    float3 mn2 = cross(m0, m1);
+    float mdet = dot(m0, mn0);
+    float3 worldNorm = (abs(mdet) > 1e-6)
+        ? (mn0 * localNorm.x + mn1 * localNorm.y + mn2 * localNorm.z) * (mdet < 0.0 ? -1.0 : 1.0)
+        : (m0 * localNorm.x + m1 * localNorm.y + m2 * localNorm.z);
+
+    out.gl_Position = u.viewProj * worldPos;
+    out.worldPos = worldPos.xyz;
+    out.worldNorm = worldNorm;
+    out.fragUV = in.uv;
+    out.fragColor = in.color;
+    out.lightSpacePos = u.lightViewProj * worldPos;
+    return out;
+}
+"""
+
+SKINNED_VERT_GLSL = r"""#version 450
