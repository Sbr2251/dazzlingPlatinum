+    ("battle3d_skinned_vert", "vert", "SDL_GPU_SHADERSTAGE_VERTEX",
+     SKINNED_VERT_GLSL, SKINNED_VERT_MSL, 0, 0, 0, 2),
+    ("battle3d_skinned_frag", "frag", "SDL_GPU_SHADERSTAGE_FRAGMENT",
+     SKINNED_FRAG_GLSL, SKINNED_FRAG_MSL, 2, 0, 0, 1),
