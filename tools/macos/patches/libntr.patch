+    if (const char *sc = std::getenv("SIM_BDSP_TEST_SCALE"); sc && sc[0] != '\0') {
+      float v = std::strtof(sc, nullptr);
+      if (v > 0.05f && v < 10.0f) testScale = v;
+    }
+    testFraming = EnvIsOne("SIM_BDSP_TEST_FRAMING");
