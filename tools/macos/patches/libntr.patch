+const char *Device::DriverName() const { return mDevice ? SDL_GetGPUDeviceDriver(mDevice) : "none"; }
+
+bool Device::SupportsTexture(SDL_GPUTextureFormat format, SDL_GPUTextureUsageFlags usage) const {
+    return mDevice && SDL_GPUTextureSupportsFormat(mDevice, format, SDL_GPU_TEXTURETYPE_2D, usage);
+}
+
+bool Device::AttachWindow(SDL_Window *window) {
+    if (!mDevice || !window) return false;
+    if (mWindow == window) return true;
+    DetachWindow();
+    if (!SDL_ClaimWindowForGPUDevice(mDevice, window)) {
+        ReportFailure("SDL_ClaimWindowForGPUDevice");
+        return false;
+    }
+    mWindow = window;
+    mPresentModeDirty = true;
+    return ApplyPresentMode();
+}
+
+void Device::DetachWindow() {
+    if (mDevice && mWindow) {
+        SDL_WaitForGPUIdle(mDevice);
+        SDL_ReleaseWindowFromGPUDevice(mDevice, mWindow);
+    }
+    mWindow = nullptr;
+}
+
+SDL_GPUTextureFormat Device::SwapchainFormat() const {
+    return (mDevice && mWindow) ? SDL_GetGPUSwapchainTextureFormat(mDevice, mWindow) : SDL_GPU_TEXTUREFORMAT_INVALID;
+}
+
+bool Device::SetVsync(bool enabled) {
+    mVsync = enabled;
+    mPresentModeDirty = true;
+    if (CurrentFrame()) return true;  // applied when the frame ends
+    return ApplyPresentMode();
+}
+
+bool Device::ApplyPresentMode() {
+    if (!mPresentModeDirty) return true;
+    mPresentModeDirty = false;
+    if (!mWindow) return true;
+    SDL_GPUPresentMode mode = SDL_GPU_PRESENTMODE_VSYNC;
+    if (!mVsync) {
+        if (SDL_WindowSupportsGPUPresentMode(mDevice, mWindow, SDL_GPU_PRESENTMODE_MAILBOX)) {
+            mode = SDL_GPU_PRESENTMODE_MAILBOX;
+        } else if (SDL_WindowSupportsGPUPresentMode(mDevice, mWindow, SDL_GPU_PRESENTMODE_IMMEDIATE)) {
+            mode = SDL_GPU_PRESENTMODE_IMMEDIATE;
+        } else {
+            LogInfo("vsync off requested but the swapchain only supports VSYNC");
+        }
+    }
+    if (!SDL_SetGPUSwapchainParameters(mDevice, mWindow, SDL_GPU_SWAPCHAINCOMPOSITION_SDR, mode)) {
+        ReportFailure("SDL_SetGPUSwapchainParameters");
+        return false;
+    }
+    mPresentMode = mode;
+    return true;
+}
+
+SDL_GPUShader *Device::Shader(const ShaderBlob &blob) {
+    auto it = mShaders.find(&blob);
+    if (it != mShaders.end()) return it->second;
+    if (!mDevice) return nullptr;
+    SDL_GPUShaderCreateInfo info;
+    SDL_zero(info);
+    if (mShaderFormat == SDL_GPU_SHADERFORMAT_SPIRV) {
+        info.code = blob.spirv;
+        info.code_size = blob.spirvSize;
+        info.entrypoint = "main";
+    } else {
+#if defined(SDL_PLATFORM_IOS) || defined(SDL_PLATFORM_TVOS)
+        info.code = blob.mslIos;
+        info.code_size = blob.mslIosSize;
+#else
+        info.code = blob.mslMacos;
+        info.code_size = blob.mslMacosSize;
+#endif
+        info.entrypoint = "main0";
+    }
+    info.format = mShaderFormat;
+    info.stage = blob.stage;
+    info.num_samplers = blob.numSamplers;
+    info.num_storage_textures = blob.numStorageTextures;
+    info.num_storage_buffers = blob.numStorageBuffers;
+    info.num_uniform_buffers = blob.numUniformBuffers;
+    SDL_PropertiesID props = SDL_CreateProperties();
+    SDL_SetStringProperty(props, SDL_PROP_GPU_SHADER_CREATE_NAME_STRING, blob.name);
+    info.props = props;
+    SDL_GPUShader *shader = SDL_CreateGPUShader(mDevice, &info);
+    SDL_DestroyProperties(props);
+    if (!shader) {
+        char ctx[256];
+        SDL_snprintf(ctx, sizeof ctx, "SDL_CreateGPUShader(%s)", blob.name);
+        ReportFailure(ctx);
+        return nullptr;
+    }
+    mShaders[&blob] = shader;
+    return shader;
+}
+
+Frame *Device::BeginFrame() {
+    if (!mDevice) return nullptr;
+    if (mFrame->mActive) {
+        ReportFailure("BeginFrame while a frame is in progress", false);
+        return nullptr;
+    }
+    ApplyPresentMode();
+    if (!mFrame->Begin(++mFrameIndex)) return nullptr;
+    return mFrame.get();
+}
