+static inline void HashMix(size_t &h, size_t v) {
+    h ^= v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+}
+
+size_t PipelineKeyHash::operator()(const PipelineKey &k) const {
+    size_t h = 0;
+    HashMix(h, (size_t)(uintptr_t)k.vertex);
+    HashMix(h, (size_t)(uintptr_t)k.fragment);
+    HashMix(h, k.layout.stride);
+    HashMix(h, k.layout.numAttributes);
+    for (Uint32 i = 0; i < k.layout.numAttributes && i < kMaxVertexAttributes; i++) {
+        const VertexAttribute &a = k.layout.attributes[i];
+        HashMix(h, a.location | ((size_t)a.format << 8) | ((size_t)a.offset << 16));
+    }
+    HashMix(h, (size_t)k.primitive | ((size_t)k.cull << 4) | ((size_t)k.frontFace << 8) | ((size_t)k.depthTest << 10) |
+                   ((size_t)k.depthWrite << 11) | ((size_t)k.depthCompare << 12) | ((size_t)k.blend << 16) |
+                   ((size_t)k.colorWriteMask << 20));
+    HashMix(h, (size_t)k.colorFormat | ((size_t)k.depthFormat << 16));
+    return h;
+}
+
+static SDL_GPUColorTargetBlendState BlendState(Blend blend, Uint8 writeMask) {
+    SDL_GPUColorTargetBlendState s;
+    SDL_zero(s);
+    s.color_write_mask = writeMask;
+    s.enable_color_write_mask = writeMask != 0xF;
+    s.color_blend_op = SDL_GPU_BLENDOP_ADD;
+    s.alpha_blend_op = SDL_GPU_BLENDOP_ADD;
+    switch (blend) {
+    case Blend::Opaque:
+        s.enable_blend = false;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ZERO;
+        break;
+    case Blend::Alpha:
+        s.enable_blend = true;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_SRC_ALPHA;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
+        break;
+    case Blend::Premultiplied:
+        s.enable_blend = true;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
+        break;
+    case Blend::Additive:
+        s.enable_blend = true;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        break;
+    }
+    return s;
+}
+
+PipelineCache::~PipelineCache() { Clear(); }
+
+void PipelineCache::Clear() {
+    if (mDevice.Handle()) {
+        for (auto &kv : mPipelines) SDL_ReleaseGPUGraphicsPipeline(mDevice.Handle(), kv.second);
+    }
+    mPipelines.clear();
+}
+
+SDL_GPUGraphicsPipeline *PipelineCache::Get(const PipelineKey &key) {
+    auto it = mPipelines.find(key);
+    if (it != mPipelines.end()) return it->second;
+    if (!key.vertex || !key.fragment) {
+        mDevice.ReportFailure("PipelineCache::Get: key without vertex or fragment shader", false);
+        return nullptr;
+    }
+    SDL_GPUShader *vs = mDevice.Shader(*key.vertex);
+    SDL_GPUShader *fs = mDevice.Shader(*key.fragment);
+    if (!vs || !fs) return nullptr;
+
+    SDL_GPUGraphicsPipelineCreateInfo info;
+    SDL_zero(info);
+    info.vertex_shader = vs;
+    info.fragment_shader = fs;
+
+    SDL_GPUVertexBufferDescription vb;
+    SDL_zero(vb);
+    SDL_GPUVertexAttribute attrs[kMaxVertexAttributes];
+    if (key.layout.numAttributes > 0) {
+        vb.slot = 0;
+        vb.pitch = key.layout.stride;
+        vb.input_rate = SDL_GPU_VERTEXINPUTRATE_VERTEX;
+        for (Uint32 i = 0; i < key.layout.numAttributes; i++) {
+            attrs[i].location = key.layout.attributes[i].location;
+            attrs[i].buffer_slot = 0;
+            attrs[i].format = key.layout.attributes[i].format;
+            attrs[i].offset = key.layout.attributes[i].offset;
+        }
+        info.vertex_input_state.vertex_buffer_descriptions = &vb;
+        info.vertex_input_state.num_vertex_buffers = 1;
+        info.vertex_input_state.vertex_attributes = attrs;
+        info.vertex_input_state.num_vertex_attributes = key.layout.numAttributes;
+    }
+    info.primitive_type = key.primitive;
+    info.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
+    info.rasterizer_state.cull_mode = key.cull;
+    info.rasterizer_state.front_face = key.frontFace;
+    info.rasterizer_state.enable_depth_clip = true;  // GL behaviour; also needs no depthClamp feature
+    info.multisample_state.sample_count = SDL_GPU_SAMPLECOUNT_1;
+    info.depth_stencil_state.enable_depth_test = key.depthTest;
+    info.depth_stencil_state.enable_depth_write = key.depthTest && key.depthWrite;
+    info.depth_stencil_state.compare_op = key.depthTest ? key.depthCompare : SDL_GPU_COMPAREOP_ALWAYS;
+
+    SDL_GPUColorTargetDescription color;
+    SDL_zero(color);
+    if (key.colorFormat != SDL_GPU_TEXTUREFORMAT_INVALID) {
+        color.format = key.colorFormat;
+        color.blend_state = BlendState(key.blend, key.colorWriteMask);
+        info.target_info.color_target_descriptions = &color;
+        info.target_info.num_color_targets = 1;
+    }
+    if (key.depthFormat != SDL_GPU_TEXTUREFORMAT_INVALID) {
+        info.target_info.has_depth_stencil_target = true;
+        info.target_info.depth_stencil_format = key.depthFormat;
+    } else if (key.depthTest) {
+        mDevice.ReportFailure("PipelineCache::Get: depth test without a depth format", false);
+        return nullptr;
+    }
+
+    char name[160];
+    SDL_snprintf(name, sizeof name, "%s+%s", key.vertex->name, key.fragment->name);
+    SDL_PropertiesID props = SDL_CreateProperties();
+    SDL_SetStringProperty(props, SDL_PROP_GPU_GRAPHICSPIPELINE_CREATE_NAME_STRING, name);
+    info.props = props;
+    SDL_GPUGraphicsPipeline *pipeline = SDL_CreateGPUGraphicsPipeline(mDevice.Handle(), &info);
+    SDL_DestroyProperties(props);
+    if (!pipeline) {
+        char ctx[256];
+        SDL_snprintf(ctx, sizeof ctx, "SDL_CreateGPUGraphicsPipeline(%s)", name);
+        mDevice.ReportFailure(ctx);
+        return nullptr;
+    }
+    mPipelines.emplace(key, pipeline);
+    return pipeline;
+}
+
+} // namespace SIM::Gpu
diff --git a/libraries/sim/src/gpu/gpu_readback.cpp b/libraries/sim/src/gpu/gpu_readback.cpp
new file mode 100644
index 0000000..d983696
--- /dev/null
+++ b/libraries/sim/src/gpu/gpu_readback.cpp
@@ -0,0 +1,165 @@
+#include <simulator/gpu/device.hpp>
+#include <simulator/gpu/readback.hpp>
+
+namespace SIM::Gpu {
+
+ReadbackRing::ReadbackRing(Device &device, Uint32 slots) : mDevice(device) {
+    if (slots < 1) slots = 1;
+    if (slots > 8) slots = 8;
+    mSlots.resize(slots);
+}
+
+ReadbackRing::~ReadbackRing() {
+    for (Slot &s : mSlots) DiscardSlot(s);
+}
+
+void ReadbackRing::DiscardSlot(Slot &slot) {
+    SDL_GPUDevice *dev = mDevice.Handle();
+    if (dev) {
+        if (slot.fence) SDL_ReleaseGPUFence(dev, slot.fence);
+        if (slot.buffer) SDL_ReleaseGPUTransferBuffer(dev, slot.buffer);
+    }
+    slot = Slot();
+}
+
+bool ReadbackRing::HasOutstanding() const {
+    for (const Slot &s : mSlots) {
+        if (s.token != 0) return true;
+    }
+    return false;
+}
+
+Uint64 ReadbackRing::Request(SDL_GPUTexture *texture, SDL_GPUTextureFormat format, Uint32 x, Uint32 y, Uint32 w, Uint32 h) {
+    if (!mDevice.Handle() || !texture || w == 0 || h == 0) {
+        mDevice.ReportFailure("ReadbackRing::Request: no device, texture or region", false);
+        return 0;
+    }
+    const Uint32 bytes = SDL_CalculateGPUTextureFormatSize(format, w, h, 1);
+    if (bytes == 0) {
+        mDevice.ReportFailure("ReadbackRing::Request: unknown texture format size", false);
+        return 0;
+    }
+    bool swapRB = false;
+    switch (format) {
+    case SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM:
+    case SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM_SRGB:
+        break;
+    case SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM:
+    case SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM_SRGB:
+        swapRB = true;
+        break;
+    default:
+        mDevice.ReportFailure("ReadbackRing::Request: only RGBA8/BGRA8 textures (capture targets are RGBA8)", false);
+        return 0;
+    }
+
+    Slot &slot = mSlots[mNextSlot];
+    mNextSlot = (mNextSlot + 1) % (Uint32)mSlots.size();
+    if (slot.token != 0) {
+        // Ring full: wait for the oldest download so its slot can be reused.
+        // Its result was never collected and is discarded.
+        SDL_GPUFence *fence = slot.fence;
+        if (fence && !SDL_WaitForGPUFences(mDevice.Handle(), true, &fence, 1)) {
+            mDevice.ReportFailure("ReadbackRing::Request: SDL_WaitForGPUFences (ring full)");
+            return 0;
+        }
+        DiscardSlot(slot);
+    }
+    if (!slot.buffer || slot.bufferSize < bytes) {
+        if (slot.buffer) SDL_ReleaseGPUTransferBuffer(mDevice.Handle(), slot.buffer);
+        SDL_GPUTransferBufferCreateInfo info;
+        SDL_zero(info);
+        info.usage = SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD;
+        info.size = bytes;
+        slot.buffer = SDL_CreateGPUTransferBuffer(mDevice.Handle(), &info);
+        slot.bufferSize = slot.buffer ? bytes : 0;
+        if (!slot.buffer) {
+            mDevice.ReportFailure("ReadbackRing::Request: SDL_CreateGPUTransferBuffer (download)");
+            return 0;
+        }
+    }
+
+    SDL_GPUCommandBuffer *cmd = SDL_AcquireGPUCommandBuffer(mDevice.Handle());
+    if (!cmd) {
+        mDevice.ReportFailure("ReadbackRing::Request: SDL_AcquireGPUCommandBuffer");
+        return 0;
+    }
+    SDL_GPUCopyPass *copy = SDL_BeginGPUCopyPass(cmd);
+    if (!copy) {
+        mDevice.ReportFailure("ReadbackRing::Request: SDL_BeginGPUCopyPass");
+        SDL_CancelGPUCommandBuffer(cmd);
+        return 0;
+    }
+    SDL_GPUTextureRegion src;
+    SDL_zero(src);
+    src.texture = texture;
+    src.x = x;
+    src.y = y;
+    src.w = w;
+    src.h = h;
+    src.d = 1;
+    SDL_GPUTextureTransferInfo dst;
+    SDL_zero(dst);
+    dst.transfer_buffer = slot.buffer;
+    dst.offset = 0;
+    dst.pixels_per_row = w;
+    dst.rows_per_layer = h;
+    SDL_DownloadFromGPUTexture(copy, &src, &dst);
+    SDL_EndGPUCopyPass(copy);
+    slot.fence = SDL_SubmitGPUCommandBufferAndAcquireFence(cmd);
+    if (!slot.fence) {
+        mDevice.ReportFailure("ReadbackRing::Request: SDL_SubmitGPUCommandBufferAndAcquireFence");
+        return 0;
+    }
+    slot.token = mNextToken++;
+    slot.bytes = bytes;
+    slot.format = format;
+    slot.swapRB = swapRB;
+    return slot.token;
+}
+
+bool ReadbackRing::Collect(Uint64 token, std::vector<Uint8> &out, bool wait) {
+    if (token == 0) return false;  // token 0 is never valid; not a device failure
+    Slot *slot = nullptr;
+    for (Slot &s : mSlots) {
+        if (s.token == token) {
+            slot = &s;
+            break;
+        }
+    }
+    if (!slot) {
+        // Unknown or discarded token (collect before the ring wraps): a caller
+        // error, logged without flagging the device as failed.
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "SIM_GPU: ReadbackRing::Collect: unknown or discarded token");
+        return false;
+    }
+    if (wait) {
+        SDL_GPUFence *fence = slot->fence;
+        if (!SDL_WaitForGPUFences(mDevice.Handle(), true, &fence, 1)) {
+            mDevice.ReportFailure("ReadbackRing::Collect: SDL_WaitForGPUFences");
+            return false;
+        }
+    } else if (!SDL_QueryGPUFence(mDevice.Handle(), slot->fence)) {
+        return false;
+    }
+    const Uint8 *mapped = (const Uint8 *)SDL_MapGPUTransferBuffer(mDevice.Handle(), slot->buffer, false);
+    if (!mapped) {
+        mDevice.ReportFailure("ReadbackRing::Collect: SDL_MapGPUTransferBuffer");
+        return false;
+    }
+    out.assign(mapped, mapped + slot->bytes);
+    SDL_UnmapGPUTransferBuffer(mDevice.Handle(), slot->buffer);
+    if (slot->swapRB) {
+        for (size_t i = 0; i + 3 < out.size(); i += 4) {
+            Uint8 t = out[i];
+            out[i] = out[i + 2];
+            out[i + 2] = t;
+        }
+    }
+    SDL_ReleaseGPUFence(mDevice.Handle(), slot->fence);
+    slot->fence = nullptr;
+    slot->token = 0;
+    return true;
+}
+
+} // namespace SIM::Gpu
diff --git a/libraries/sim/src/gpu/gpu_texture.cpp b/libraries/sim/src/gpu/gpu_texture.cpp
new file mode 100644
index 0000000..8726681
--- /dev/null
+++ b/libraries/sim/src/gpu/gpu_texture.cpp
@@ -0,0 +1,199 @@
+#include <simulator/gpu/device.hpp>
+#include <simulator/gpu/texture.hpp>
+
+#include <utility>
+
+namespace SIM::Gpu {
+
+TextureDesc TextureDesc::Rgba8(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d;
+    d.width = w;
+    d.height = h;
+    d.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+    d.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER;
+    d.name = name;
+    return d;
+}
+
+TextureDesc TextureDesc::Rgba8Mipmapped(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    Uint32 dim = w > h ? w : h;
+    Uint32 levels = 1;
+    while (dim > 1) {
+        dim >>= 1;
+        levels++;
+    }
+    d.levels = levels;
+    // SDL_GenerateMipmapsForGPUTexture requires SAMPLER | COLOR_TARGET usage.
+    d.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+    return d;
+}
+
+TextureDesc TextureDesc::R8Uint(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = SDL_GPU_TEXTUREFORMAT_R8_UINT;
+    // Storage texture (see the header): SAMPLER is forbidden on integer formats.
+    d.usage = SDL_GPU_TEXTUREUSAGE_GRAPHICS_STORAGE_READ;
+    return d;
+}
+
+TextureDesc TextureDesc::R16Uint(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = SDL_GPU_TEXTUREFORMAT_R16_UINT;
+    d.usage = SDL_GPU_TEXTUREUSAGE_GRAPHICS_STORAGE_READ;
+    return d;
+}
+
+TextureDesc TextureDesc::ColorTarget(Uint32 w, Uint32 h, SDL_GPUTextureFormat format, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = format;
+    d.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+    return d;
+}
+
+TextureDesc TextureDesc::DepthTarget(const Device &device, Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = device.DepthFormat();
+    d.usage = SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET;
+    return d;
+}
+
+Texture::Texture(Texture &&o) noexcept : mDevice(o.mDevice), mTexture(o.mTexture), mDesc(o.mDesc) {
+    o.mTexture = nullptr;
+}
+
+Texture &Texture::operator=(Texture &&o) noexcept {
+    if (this != &o) {
+        Release();
+        mDevice = o.mDevice;
+        mTexture = o.mTexture;
+        mDesc = o.mDesc;
+        o.mTexture = nullptr;
+    }
+    return *this;
+}
+
+bool Texture::Create(Device &device, const TextureDesc &desc) {
+    Release();
+    mDevice = &device;
+    mDesc = desc;
+    if (!device.Handle() || desc.width == 0 || desc.height == 0) {
+        device.ReportFailure("Texture::Create: no device or zero size", false);
+        return false;
+    }
+    if (!SDL_GPUTextureSupportsFormat(device.Handle(), desc.format, SDL_GPU_TEXTURETYPE_2D, desc.usage)) {
+        char ctx[160];
+        SDL_snprintf(ctx, sizeof ctx, "Texture::Create(%s): format %d does not support usage 0x%x on this device",
+                     desc.name ? desc.name : "unnamed", (int)desc.format, (unsigned)desc.usage);
+        device.ReportFailure(ctx, false);
+        return false;
+    }
+    SDL_GPUTextureCreateInfo info;
+    SDL_zero(info);
+    info.type = desc.layers > 1 ? SDL_GPU_TEXTURETYPE_2D_ARRAY : SDL_GPU_TEXTURETYPE_2D;
+    info.format = desc.format;
+    info.usage = desc.usage;
+    info.width = desc.width;
+    info.height = desc.height;
+    info.layer_count_or_depth = desc.layers ? desc.layers : 1;
+    info.num_levels = desc.levels ? desc.levels : 1;
+    info.sample_count = SDL_GPU_SAMPLECOUNT_1;
+    SDL_PropertiesID props = 0;
+    if (desc.name) {
+        props = SDL_CreateProperties();
+        SDL_SetStringProperty(props, SDL_PROP_GPU_TEXTURE_CREATE_NAME_STRING, desc.name);
+        info.props = props;
+    }
+    mTexture = SDL_CreateGPUTexture(device.Handle(), &info);
+    if (props) SDL_DestroyProperties(props);
+    if (!mTexture) {
+        char ctx[160];
+        SDL_snprintf(ctx, sizeof ctx, "SDL_CreateGPUTexture(%s %ux%u)", desc.name ? desc.name : "unnamed", desc.width, desc.height);
+        device.ReportFailure(ctx);
+        return false;
+    }
+    return true;
+}
+
+bool Texture::Resize(Uint32 width, Uint32 height) {
+    if (!mDevice) return false;
+    if (mTexture && mDesc.width == width && mDesc.height == height) return true;
+    TextureDesc d = mDesc;
+    d.width = width;
+    d.height = height;
+    Device *device = mDevice;
+    return Create(*device, d);
+}
+
+void Texture::Release() {
+    if (mTexture && mDevice && mDevice->Handle()) SDL_ReleaseGPUTexture(mDevice->Handle(), mTexture);
+    mTexture = nullptr;
+}
+
+bool RenderTarget::Create(Device &device, Uint32 width, Uint32 height, SDL_GPUTextureFormat colorFormat, bool withDepth,
+                          const char *name) {
+    Release();
+    if (!mColor.Create(device, TextureDesc::ColorTarget(width, height, colorFormat, name))) return false;
+    if (withDepth && !mDepth.Create(device, TextureDesc::DepthTarget(device, width, height, name))) {
+        mColor.Release();
+        return false;
+    }
+    return true;
+}
+
+bool RenderTarget::Resize(Uint32 width, Uint32 height) {
+    if (!mColor) return false;
+    if (mColor.Width() == width && mColor.Height() == height) return false;
+    mColor.Resize(width, height);
+    if (mDepth.Desc().width != 0) mDepth.Resize(width, height);
+    return true;
+}
+
+void RenderTarget::Release() {
+    mColor.Release();
+    mDepth.Release();
+}
+
+static SDL_GPUSamplerAddressMode ToAddress(Wrap w) {
+    switch (w) {
+    case Wrap::Repeat: return SDL_GPU_SAMPLERADDRESSMODE_REPEAT;
+    case Wrap::Mirror: return SDL_GPU_SAMPLERADDRESSMODE_MIRRORED_REPEAT;
+    default: return SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+    }
+}
+
+SamplerCache::~SamplerCache() { Clear(); }
+
+void SamplerCache::Clear() {
+    if (mDevice.Handle()) {
+        for (auto &kv : mSamplers) SDL_ReleaseGPUSampler(mDevice.Handle(), kv.second);
+    }
+    mSamplers.clear();
+}
+
+SDL_GPUSampler *SamplerCache::Get(const SamplerKey &key) {
+    auto it = mSamplers.find(key);
+    if (it != mSamplers.end()) return it->second;
+    SDL_GPUSamplerCreateInfo info;
+    SDL_zero(info);
+    info.min_filter = info.mag_filter = key.filter == Filter::Linear ? SDL_GPU_FILTER_LINEAR : SDL_GPU_FILTER_NEAREST;
+    info.mipmap_mode = key.mipmap ? SDL_GPU_SAMPLERMIPMAPMODE_LINEAR : SDL_GPU_SAMPLERMIPMAPMODE_NEAREST;
+    info.address_mode_u = ToAddress(key.wrapU);
+    info.address_mode_v = ToAddress(key.wrapV);
+    info.address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+    info.min_lod = 0.0f;
+    info.max_lod = 1000.0f;
+    if (key.mipmap && key.maxAnisotropy > 1) {
+        info.enable_anisotropy = true;
+        info.max_anisotropy = static_cast<float>(key.maxAnisotropy);
+    }
+    SDL_GPUSampler *s = SDL_CreateGPUSampler(mDevice.Handle(), &info);
+    if (!s) {
+        mDevice.ReportFailure("SDL_CreateGPUSampler");
+        return nullptr;
+    }
+    mSamplers.emplace(key, s);
+    return s;
+}
+
+} // namespace SIM::Gpu
diff --git a/libraries/sim/src/gpu/meson.build b/libraries/sim/src/gpu/meson.build
new file mode 100644
index 0000000..8e6ab62
--- /dev/null
+++ b/libraries/sim/src/gpu/meson.build
@@ -0,0 +1,81 @@
+# SDL GPU foundation library (workstream 1c).
+#
+# This file only defines variables; it adds no sources to any target.
+# The integrator enables the library in libraries/sim/src/meson.build with
+# one line:
+#   libsim_srcs += gpu_srcs
+# (plus the SDL3 dependency on libsim_dependencies, and gpu_shader_headers
+# on any target that includes a generated shader header).
+#
+# Shader headers are generated by libraries/sim/tools/gpu_shaderc.py
+# (GLSL 450 -> SPIR-V -> MSL, embedded as C arrays). The custom targets are
+# build_by_default: false, so a plain libsim build does not need
+# glslangValidator / spirv-cross until something uses gpu_shader_headers.
+# Adding a shader is one line: append its filename to gpu_shaders below and
+# #include "<name>.vert.h" / "<name>.frag.h".
+
+gpu_srcs = files(
+    'gpu_device.cpp',
+    'gpu_frame.cpp',
+    'gpu_pipeline.cpp',
+    'gpu_readback.cpp',
+    'gpu_texture.cpp',
+)
+
+gpu_shaders = [
+    'test_color.vert',
+    'test_color.frag',
+    'test_depth.vert',
+    'test_green.frag',
+    'test_int.frag',
+    'test_int16.frag',
+    'test_invariant.vert',
+    'test_invariant2.vert',
+    'test_pos.vert',
+    'test_red.frag',
+    'test_ssbo.frag',
+    'test_ssbo16.frag',
+    'test_textured.vert',
+    'test_textured.frag',
+    'test_uniform.frag',
+    'post.vert',
+    'post.frag',
+    'fx_weather.frag',
+    'fx_water.frag',
+    'g3.vert',
+    'g3.frag',
+    'quad.vert',
+    'textured.frag',
+    'vram.frag',
+    'g2.frag',
+    'g2clear.frag',
+    'g2gpu.vert',
+    'g2gpu.frag',
+]
+
+gpu_shader_headers = []
+_gpu_python = find_program('python3', required: false)
+_gpu_glslang = find_program('glslangValidator', required: false)
+_gpu_spirv_cross = find_program('spirv-cross', required: false)
+if _gpu_python.found() and _gpu_glslang.found() and _gpu_spirv_cross.found()
+    _gpu_shaderc = '..' / '..' / 'tools' / 'gpu_shaderc.py'
+    foreach _shader : gpu_shaders
+        gpu_shader_headers += custom_target(
+            _shader + '.h',
+            input: 'shaders' / _shader,
+            output: '@PLAINNAME@.h',
+            depfile: '@PLAINNAME@.d',
+            command: [
+                _gpu_python, _gpu_shaderc, '@INPUT@',
+                '-I', meson.current_source_dir() / 'shaders',
+                '--glslang', _gpu_glslang.full_path(),
+                '--spirv-cross', _gpu_spirv_cross.full_path(),
+                '-o', '@OUTPUT@',
+                '--depfile', '@DEPFILE@',
+            ],
+            build_by_default: false,
+        )
+    endforeach
+else
+    warning('gpu shaders: glslangValidator / spirv-cross / python3 missing, gpu_shader_headers is empty')
+endif
diff --git a/libraries/sim/src/gpu/shaders/fx_water.frag b/libraries/sim/src/gpu/shaders/fx_water.frag
new file mode 100644
index 0000000..94a84bb
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/fx_water.frag
@@ -0,0 +1,84 @@
+#version 450
+#extension GL_GOOGLE_include_directive : enable
+#include "sim_gpu.glsl"
+layout(set = 2, binding = 0) uniform sampler2D sceneTex;
+layout(set = 3, binding = 0) uniform FxParams {
+  vec2 texel; float time; int kind;
+  float intensity; float flash; int wideMode; float pad;
+};
+layout(location = 0) in vec2 fragTexCoord;
+layout(location = 0) out vec4 color;
+vec3 scene(vec2 uv) { return texture(sceneTex, SIM_RT_UV(clamp(uv, 0.001, 0.999))).rgb; }
+float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
+// Water mask choice (documented for the lane): post-pass colour mask on
+// the composited frame - blue-dominant, moderately saturated pixels.
+// It needs no game-side tile data and covers field water and battle
+// water alike; non-water blue (sky, menus) is limited by requiring the
+// pixel to sit in the main screen and below its vertical midpoint.
+float waterMask(vec2 uv) {
+  vec3 c = scene(uv);
+  float blue = smoothstep(0.04, 0.14, c.b - c.r) * smoothstep(0.0, 0.08, c.b - c.g);
+  if (kind == 6 || kind == 7 || kind == 8) {
+    // Kind 7 (Violet Rift Coast, Routes 222/223) reuses the same discipline so
+    // beach sand, houses and stone ledges never reflect - only the saturated sea.
+    // Kind 8 (Route 215 flooded lowland) too: night-lit wet grass and mud carry
+    // a slight blue cast (b - r > 0.04) but never this saturated cyan-blue.
+    // Everspring has pale lavender marble & silver-lavender bridge planks (r ~= g, b-r ~ 0.10):
+    // require saturated cyan-blue lagoon chroma so dry plaza stone and wood never reflect.
+    blue = smoothstep(0.20, 0.32, c.b - c.r)
+         * smoothstep(0.04, 0.12, c.g - c.r)
+         * smoothstep(0.08, 0.20, c.b - c.g);
+  }
+  float low = wideMode != 0 ? smoothstep(0.9, 0.55, uv.y) : smoothstep(0.88, 0.58, uv.y);
+  return blue * low;
+}
+void main() {
+  vec2 uv = fragTexCoord;
+  vec3 c = scene(uv);
+  float m = waterMask(uv);
+  if (m <= 0.001) { color = vec4(c, 1.0); return; }
+  // Pixelated posterised reflection: quantise the sample position to a
+  // coarse grid and the colour to 5 levels, sampling the scene above
+  // the waterline (shore, trees, sky) flipped down into the water.
+  vec2 ripple = vec2(sin(uv.y * 160.0 + time * 2.0) * 0.003, sin(uv.x * 120.0 - time * 1.7) * 0.002);
+  vec2 quv = floor((uv + ripple) * vec2(160.0, 120.0)) / vec2(160.0, 120.0);
+  vec2 ruv = vec2(quv.x, (wideMode != 0 ? 1.0 : 1.5) - quv.y);
+  vec3 refl = floor(scene(ruv) * 5.0 + 0.5) / 5.0;
+  // Kind 7: the full-screen flip mirrored the basalt monoliths and rocks of
+  // Routes 222/223 across the open sea as low-contrast ghosts, so it keeps
+  // only a faint 0.08 reflection tint and Platinum's original animated sea
+  // ripples stay crystal clear. Kind 8 (rain-roughened flood water) reflects
+  // softly at 0.30. Every other kind keeps the original 0.7 mix.
+  float reflAmt = kind == 7 ? 0.08 : (kind == 8 ? 0.30 : 0.7);
+  vec3 water = mix(c, refl * vec3(0.75, 0.9, 1.05), reflAmt * intensity);
+  // Shoreline foam: water pixel whose neighbour above is not water.
+  // Foam only at a true shoreline: water here, land above, and water
+  // below too (so the screen edge never counts as a shoreline).
+  float edge = m * (1.0 - waterMask(uv - vec2(0.0, texel.y * 3.0))) * waterMask(uv + vec2(0.0, texel.y * 3.0));
+  // Kind 7: no synthetic foam at all. On the open rift sea the strict mask
+  // flickers along Platinum's own wave-crest lines, so the edge test fired
+  // all over the water as noisy grain (worst at night); the stock sea tiles
+  // already draw their own shoreline rims, so the ripples stay crystal clear.
+  if (kind == 7) edge = 0.0;
+  float foamBand = step(0.55, hash(floor(uv * vec2(256.0, 192.0)) + floor(time * 2.0) * 0.13));
+  water += vec3(0.9) * edge * foamBand * 0.5;
+  if (kind == 6) {
+    // Everspring Fairy Sanctuary water: keep Platinum's original animated sea
+    // ripples clean and legible, adding only a subtle moonlit cyan-lavender sheen.
+    vec2 wp = floor(uv * vec2(256.0, wideMode != 0 ? 144.0 : 384.0));
+    float phase = sin(wp.x * 0.10 + time * 0.9) * cos(wp.y * 0.12 - time * 0.7);
+    vec3 irid = mix(vec3(0.62, 0.90, 1.00), vec3(0.84, 0.70, 1.00), 0.5 + 0.5 * phase);
+    vec3 sheen = irid * (0.07 + 0.03 * sin(time * 0.65)) * intensity;
+    water = 1.0 - (1.0 - clamp(water, 0.0, 1.0)) * (1.0 - sheen);
+  } else if (kind == 7) {
+    // Violet Rift sea: subtle deep-violet reflection tint plus a slow,
+    // DS-grid-snapped violet shimmer; screen-blended so it never clips.
+    vec2 wp = floor(uv * vec2(256.0, wideMode != 0 ? 144.0 : 384.0));
+    float phase = sin(wp.x * 0.08 - time * 0.6) * cos(wp.y * 0.10 + time * 0.5);
+    water = mix(water, water * vec3(0.88, 0.78, 1.08), 0.45 * intensity);
+    vec3 vio = mix(vec3(0.36, 0.18, 0.62), vec3(0.58, 0.30, 0.86), 0.5 + 0.5 * phase);
+    vec3 sheen = vio * (0.10 + 0.04 * sin(time * 0.5)) * intensity;
+    water = 1.0 - (1.0 - clamp(water, 0.0, 1.0)) * (1.0 - sheen);
+  }
+  color = vec4(mix(c, water, clamp(m * intensity + edge, 0.0, 1.0)), 1.0);
+}
diff --git a/libraries/sim/src/gpu/shaders/fx_weather.frag b/libraries/sim/src/gpu/shaders/fx_weather.frag
new file mode 100644
index 0000000..909c1a7
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/fx_weather.frag
@@ -0,0 +1,293 @@
+#version 450
+#extension GL_GOOGLE_include_directive : enable
+#include "sim_gpu.glsl"
+layout(set = 2, binding = 0) uniform sampler2D sceneTex;
+layout(set = 3, binding = 0) uniform FxParams {
+  vec2 texel; float time; int kind;
+  float intensity; float flash; int wideMode; float pad;
+};
+layout(location = 0) in vec2 fragTexCoord;
+layout(location = 0) out vec4 color;
+vec3 scene(vec2 uv) { return texture(sceneTex, SIM_RT_UV(clamp(uv, 0.001, 0.999))).rgb; }
+float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
+// 2x2 / 4x4 ordered-dither thresholds in [0, 1) for integer pixel coords
+// (kind 7 posterises its sky gradient on the DS grid; kind 8 dithers its
+// vignette in screen space to remove 8-bit banding).
+float bayer2(vec2 a) { a = mod(floor(a), 2.0); return fract(a.x * 0.5 + a.y * a.y * 0.75); }
+float bayer4(vec2 a) { return bayer2(floor(a * 0.5)) * 0.25 + bayer2(a); }
+void main() {
+  vec2 uv = fragTexCoord;
+  // Main screen only, mirroring the post pass default region: in the
+  // stacked layout the main screen is the lower half of the texture.
+  bool mainScreen = wideMode != 0 || uv.y >= 0.5;
+  vec3 c = scene(uv);
+  if (!mainScreen || intensity <= 0.001) { color = vec4(c, 1.0); return; }
+  if (kind == 5) {
+    // Heat haze: rising shimmer distortion, stronger low in the frame.
+    float mask = intensity * smoothstep(0.2, 0.9, wideMode != 0 ? uv.y : (uv.y - 0.5) * 2.0);
+    vec2 duv = vec2(sin(uv.y * 90.0 - time * 3.0 + sin(uv.x * 40.0)) * 0.0022, 0.0) * mask;
+    c = scene(uv + duv);
+    c = mix(c, c * vec3(1.06, 0.98, 0.90), mask * 0.5);
+  } else if (kind == 1) {
+    // Fog: clear near the player (screen centre of the main view),
+    // growing with distance from the player and towards the far (top)
+    // side, capped so the player and nearby NPCs stay readable.
+    vec2 pc = vec2(0.5, wideMode != 0 ? 0.55 : 0.75);
+    float pd = length((uv - pc) * vec2(1.4, 1.0));
+    float far = wideMode != 0 ? uv.y : (uv.y - 0.5) * 2.0;
+    float f = intensity * 0.42 * smoothstep(0.08, 0.55, pd) * (0.45 + 0.55 * far);
+    vec3 fogCol = mix(vec3(0.78, 0.83, 0.82), c, 0.25);
+    c = mix(c, fogCol, clamp(f, 0.0, 0.42));
+  } else if (kind == 2 || kind == 3) {
+    // Rain wet look: darker, slightly saturated ground plus specular
+    // puddle ripples on flat (bright, low-saturation) ground.
+    float lum = dot(c, vec3(0.299, 0.587, 0.114));
+    c = mix(c, c * (0.72 + lum * 0.2), intensity);
+    c = mix(vec3(lum), c, 1.0 + 0.18 * intensity);
+    vec2 cell = floor(uv * vec2(160.0, 120.0));
+    float rip = sin(length(fract(uv * vec2(160.0, 120.0)) - 0.5) * 24.0 - time * 6.0 + hash(cell) * 40.0);
+    float flatness = smoothstep(0.25, 0.5, lum) * (1.0 - smoothstep(0.5, 0.8, lum));
+    float puddle = step(0.78, hash(cell + 7.0)) * smoothstep(0.6, 1.0, rip) * flatness;
+    c += vec3(0.65, 0.75, 0.85) * puddle * 0.45 * intensity;
+    c += vec3(0.9) * smoothstep(0.92, 1.0, rip) * step(0.9, hash(cell + 3.0)) * 0.2 * intensity;
+    c += flash; // thunderstorm lightning: whole-scene brightness pulse
+  } else if (kind == 4) {
+    // Light shafts: a few soft diagonal beams slanting down-left from
+    // the canopy top, slowly drifting; additive warm-white at low
+    // alpha, stronger over dark canopy (natural occlusion by the
+    // bright clearings, softer under the tree tops).
+    float slant = uv.x * 2.2 - (wideMode != 0 ? uv.y : (uv.y - 0.5) * 2.0) * 1.4;
+    float beams = pow(0.5 + 0.5 * sin(slant * 9.0 + sin(time * 0.12) * 0.8), 2.0);
+    float vert = wideMode != 0 ? uv.y : (uv.y - 0.5) * 2.0;
+    float lum = dot(c, vec3(0.299, 0.587, 0.114));
+    float canopy = 1.0 - smoothstep(0.35, 0.75, lum);
+    float shaft = beams * (0.4 + 0.6 * vert) * (0.65 + 0.35 * canopy);
+    c += vec3(1.0, 0.95, 0.82) * shaft * 0.6 * intensity;
+    c = mix(c, c * vec3(0.94, 1.03, 0.94), intensity * 0.18);
+  } else if (kind == 6) {
+    // Everspring Fairy Sanctuary (Route 218): 100% procedural math pass.
+    // Main-screen normalized coords p in [0, 1]^2 (bottom-to-top).
+    vec2 p = wideMode != 0 ? uv : vec2(uv.x, (uv.y - 0.5) * 2.0);
+    float aspect = (wideMode != 0 ? 1.0 : 2.0) * (texel.y / max(texel.x, 1e-6));
+    float inten = clamp(intensity, 0.0, 0.8);
+
+    // 1. Subtle twilight lavender-indigo framing & breathing spiral aura
+    // echoing the Gardevoir ward; screen-blended so highlights never clip.
+    float pulse = 0.5 + 0.5 * sin(time * 0.65);
+    vec2 centered = (p - vec2(0.5, 0.52)) * vec2(1.15, 1.0);
+    float r = length(centered);
+    float edge = smoothstep(0.28, 0.84, r);
+    float ang = r > 1e-4 ? atan(centered.y, centered.x) : 0.0;
+    float spiralWave = 0.5 + 0.5 * sin(3.0 * ang - 5.0 * r - time * 0.4);
+    float lum = dot(c, vec3(0.299, 0.587, 0.114));
+    float shadowBoost = 1.0 - smoothstep(0.42, 0.86, lum);
+
+    // Gentle cool twilight edge framing (keeps center crystal clear).
+    c = mix(c, c * vec3(0.93, 0.91, 1.02), edge * 0.22 * inten);
+
+    // Soft rose-lavender moonlight sheen + slow breathing sanctuary warmth.
+    vec3 auraCol = mix(vec3(0.54, 0.44, 0.84), vec3(0.94, 0.58, 0.80), 0.35 + 0.45 * spiralWave);
+    float auraAmt = edge * (0.075 + 0.035 * pulse + 0.025 * spiralWave) * inten;
+    vec3 breathGlow = vec3(0.96, 0.74, 0.88) * (0.028 * pulse * (0.4 + 0.6 * shadowBoost) * inten);
+    vec3 atmoAdd = clamp(auraCol * auraAmt + breathGlow, 0.0, 0.24);
+    c = 1.0 - (1.0 - clamp(c, 0.0, 1.0)) * (1.0 - atmoAdd);
+
+    // 2. Drifting bioluminescent fairy spores & sakura petals, snapped to
+    // Platinum's logical pixel grid so motion stays crisp and pixel-authentic.
+    vec2 gridRes = vec2(floor(192.0 * aspect + 0.5), 192.0);
+    vec2 ps = (floor(p * gridRes) + 0.5) / gridRes;
+    vec3 moteAccum = vec3(0.0);
+
+    // Layer A: Foreground/mid glowing fairy spores drifting gently up-right.
+    {
+      vec2 gp = vec2(ps.x * aspect, ps.y) * 11.0 + vec2(-time * 0.10, -time * 0.32);
+      vec2 cell = floor(gp);
+      vec2 f = fract(gp);
+      float h0 = hash(cell);
+      if (h0 > 0.80) {
+        float h1 = hash(cell + vec2(17.3, 31.7));
+        float h2 = hash(cell + vec2(53.1, 11.9));
+        float h3 = hash(cell + vec2(91.7, 43.3));
+        float swayX = sin(time * (0.85 + h1 * 0.55) + h2 * 6.28318) * 0.08;
+        float swayY = cos(time * (0.65 + h2 * 0.45) + h1 * 6.28318) * 0.05;
+        vec2 center = vec2(mix(0.36, 0.64, h1) + swayX, mix(0.36, 0.64, h2) + swayY);
+        float d = length(f - center);
+        float core = smoothstep(0.105, 0.035, d);
+        float halo = smoothstep(0.27, 0.02, d);
+        halo *= halo;
+        float twinkle = 0.52 + 0.48 * sin(time * (1.35 + h1 * 1.15) + h2 * 6.28318);
+        vec3 col = h3 < 0.36 ? vec3(1.00, 0.64, 0.84)
+                 : (h3 < 0.72 ? vec3(0.58, 0.94, 1.00) : vec3(1.00, 0.90, 0.58));
+        moteAccum += col * (core * 0.62 + halo * 0.24) * twinkle;
+      }
+    }
+
+    // Layer B: Slower parallax sakura petals & distant starlight motes.
+    {
+      vec2 gp = vec2(ps.x * aspect, ps.y) * 16.0 + vec2(time * 0.14, -time * 0.24) + vec2(4.3, 7.1);
+      vec2 cell = floor(gp);
+      vec2 f = fract(gp);
+      float h0 = hash(cell + vec2(101.3, 67.9));
+      if (h0 > 0.88) {
+        float h1 = hash(cell + vec2(23.7, 89.1));
+        float h2 = hash(cell + vec2(71.3, 19.7));
+        float h3 = hash(cell + vec2(13.9, 59.3));
+        float swayX = sin(time * (0.7 + h1 * 0.5) + h2 * 6.28318) * 0.08;
+        float swayY = cos(time * (0.55 + h2 * 0.4) + h1 * 6.28318) * 0.05;
+        vec2 center = vec2(mix(0.36, 0.64, h1) + swayX, mix(0.36, 0.64, h2) + swayY);
+        vec2 df = f - center;
+        float rot = sin(time * 0.9 + h2 * 6.28318) * 0.7 + h3 * 3.14159;
+        float cs = cos(rot);
+        float sn = sin(rot);
+        vec2 rDf = vec2(cs * df.x - sn * df.y, sn * df.x + cs * df.y);
+        // Slightly elongated fluttering sakura petal shape.
+        float dPetal = length(rDf * vec2(1.0, 1.85));
+        float petal = smoothstep(0.13, 0.04, dPetal);
+        float glow = smoothstep(0.25, 0.02, length(df));
+        glow *= glow;
+        float twinkle = 0.58 + 0.42 * sin(time * (1.05 + h2 * 0.9) + h1 * 6.28318);
+        vec3 col = h3 < 0.58 ? vec3(1.00, 0.72, 0.87) : vec3(0.76, 0.88, 1.00);
+        moteAccum += col * (petal * 0.46 + glow * 0.14) * twinkle;
+      }
+    }
+
+    // Soft-clamp and screen-blend motes so they glow cleanly day and night.
+    vec3 moteAdd = clamp(moteAccum * inten, 0.0, 0.68);
+    c = 1.0 - (1.0 - c) * (1.0 - moteAdd);
+  } else if (kind == 7) {
+    // Violet Rift Coast & Sea-Sky Aura (Routes 222 / 223): pure math, zero
+    // textures, every term snapped to Platinum's 192-row logical grid and
+    // screen-blended so nothing clips to white.
+    vec2 p = wideMode != 0 ? uv : vec2(uv.x, (uv.y - 0.5) * 2.0);
+    float aspect = (wideMode != 0 ? 1.0 : 2.0) * (texel.y / max(texel.x, 1e-6));
+    float inten = clamp(intensity, 0.0, 0.85);
+    vec2 gridRes = vec2(floor(192.0 * aspect + 0.5), 192.0);
+    vec2 ip = floor(p * gridRes);
+    vec2 ps = (ip + 0.5) / gridRes;
+
+    // 1. Eerie violet-magenta top-horizon sheen pulsing slowly like a
+    // distant distortion rift over the sea; posterised into 8 dithered bands.
+    float pulse = 0.5 + 0.5 * sin(time * 0.42);
+    float ripple = 0.035 * sin(ps.x * aspect * 7.0 + time * 0.33)
+                 + 0.020 * sin(ps.x * aspect * 17.0 - time * 0.21);
+    float sky = smoothstep(0.50, 1.0, ps.y + ripple);
+    float skyQ = clamp(floor(sky * 8.0 + bayer4(ip)) / 8.0, 0.0, 1.0);
+    vec3 riftCol = mix(vec3(0.46, 0.22, 0.78), vec3(0.86, 0.30, 0.74),
+                       0.5 + 0.5 * sin(ps.x * aspect * 3.0 - time * 0.25));
+    c = mix(c, c * vec3(0.95, 0.88, 1.05), skyQ * 0.38 * inten);
+    vec3 sheen = clamp(riftCol * skyQ * (0.22 + 0.12 * pulse) * inten, 0.0, 0.30);
+    c = 1.0 - (1.0 - clamp(c, 0.0, 1.0)) * (1.0 - sheen);
+    // Faint cool-violet framing; the centre (player, NPCs) stays clear.
+    float edge = smoothstep(0.30, 0.85, length((p - 0.5) * vec2(1.2, 1.0)));
+    c = mix(c, c * vec3(0.92, 0.88, 1.03), edge * 0.25 * inten);
+
+    // 2. Sparse electric-violet & cyan rift embers rising on the DS grid:
+    // 1px cores with a dim plus-shaped glow and a 2px trail below.
+    vec3 emb = vec3(0.0);
+    for (int layer = 0; layer < 2; layer++) {
+      float cellPx = layer == 0 ? 22.0 : 14.0;
+      float speed = layer == 0 ? 16.0 : 9.0; // grid px per second, upward
+      float gain = layer == 0 ? 1.0 : 0.55;
+      vec2 seed = layer == 0 ? vec2(0.0) : vec2(37.0, 91.0);
+      vec2 q = ip + vec2(layer == 0 ? 0.0 : 7.0, -floor(time * speed));
+      vec2 cell = floor(q / cellPx);
+      vec2 local = q - cell * cellPx;
+      if (hash(cell + seed) > (layer == 0 ? 0.78 : 0.84)) {
+        float h1 = hash(cell + seed + vec2(17.3, 31.7));
+        float h2 = hash(cell + seed + vec2(53.1, 11.9));
+        float h3 = hash(cell + seed + vec2(91.7, 43.3));
+        float sway = floor(sin(time * (0.9 + h1) + h2 * 6.28318) * 2.0 + 0.5);
+        vec2 ctr = floor(vec2(mix(4.0, cellPx - 5.0, h1) + sway, mix(3.0, cellPx - 4.0, h2)));
+        vec2 dd = abs(local - ctr);
+        float man = dd.x + dd.y;
+        float core = man < 0.5 ? 1.0 : 0.0;
+        float ring = (man > 0.5 && man < 1.5) ? 0.38 : 0.0;
+        float trail = (dd.x < 0.5 && local.y < ctr.y && local.y >= ctr.y - 2.0) ? 0.22 : 0.0;
+        float flick = 0.55 + 0.45 * step(0.35, hash(cell + seed + floor(time * 6.0 + h3 * 6.0)));
+        vec3 col = h3 < 0.55 ? vec3(0.74, 0.42, 1.00) : vec3(0.42, 0.92, 1.00);
+        emb += col * max(core, max(ring, trail)) * flick * gain;
+      }
+    }
+    float calm = smoothstep(0.02, 0.30, p.y); // keep the text-box band calm
+    vec3 embAdd = clamp(emb * inten * calm * 0.85, 0.0, 0.62);
+    c = 1.0 - (1.0 - c) * (1.0 - embAdd);
+  } else if (kind == 8) {
+    // Stormy Lowland Rain Mist & Alpine Snowdrift (Routes 215 / 216): pure
+    // math, zero textures. Deliberately light: Platinum's stock rain / snow
+    // does the heavy lifting, this pass only adds a very gentle cool outer
+    // vignette plus crisp sparse rain streaks / snow motes. No flat haze
+    // veil, no posterised bands (those crushed contrast into grey-green and
+    // banded at night), and bright snow never receives any brightening.
+    vec2 p = wideMode != 0 ? uv : vec2(uv.x, (uv.y - 0.5) * 2.0);
+    float aspect = (wideMode != 0 ? 1.0 : 2.0) * (texel.y / max(texel.x, 1e-6));
+    float inten = clamp(intensity, 0.0, 0.85);
+    vec2 gridRes = vec2(floor(192.0 * aspect + 0.5), 192.0);
+    vec2 ip = floor(p * gridRes);
+    float lum = dot(c, vec3(0.299, 0.587, 0.114));
+    // Snow guard: zero brightening at lum >= 0.72 (white snow, snow-capped
+    // rocks, text boxes), fading in below so mid-tones still get the rain.
+    float snowGuard = 1.0 - smoothstep(0.60, 0.72, lum);
+
+    // 1. Very gentle cool outer vignette: continuous (no bands), darkening
+    // only, at most ~3% at the extreme corners, centre untouched. A 4x4 Bayer
+    // screen-space dither of +-0.5 LSB on the vignette term removes the
+    // 8-bit stair-stepping that shows on dark night gradients.
+    float edge = smoothstep(0.42, 0.95, length((p - 0.5) * vec2(1.25, 1.0)));
+    float vig = edge * 0.12 * inten;
+    c *= mix(vec3(1.0), vec3(0.90, 0.95, 1.0), vig);
+    c += (bayer4(gl_FragCoord.xy) - 0.46875) * (1.0 / 255.0) * step(0.001, vig);
+
+    vec3 fall = vec3(0.0);
+    // 2. Sparse diagonal rain streaks: 1px staircase lines at a 2:1 slant
+    // (wind from the upper left), stepping whole grid pixels per frame.
+    {
+      float W = 11.0;
+      float H = 34.0;
+      float k = floor(time * 30.0); // 60 px/s down, 30 px/s right
+      vec2 f = vec2(ip.x - k, ip.y + 2.0 * k);
+      vec2 sa = vec2(f.x + floor(f.y * 0.5), f.y); // (across, along)
+      vec2 cell = floor(sa / vec2(W, H));
+      vec2 local = sa - cell * vec2(W, H);
+      if (hash(cell + vec2(5.3, 1.7)) > 0.80) {
+        float h1 = hash(cell + vec2(29.1, 7.7));
+        float h2 = hash(cell + vec2(3.9, 61.3));
+        float h3 = hash(cell + vec2(47.5, 23.1));
+        float cx = floor(1.0 + h1 * (W - 2.0));
+        float len = 4.0 + floor(h2 * 4.0);
+        float y0 = floor(2.0 + h3 * (H - len - 4.0));
+        if (abs(local.x - cx) < 0.5 && local.y >= y0 && local.y < y0 + len) {
+          float t = (local.y - y0) / len; // 0 = leading (lowest) pixel
+          fall += vec3(0.80, 0.87, 0.96) * mix(1.0, 0.40, t) * 0.55;
+        }
+      }
+    }
+    // 3. Tiny snow / rain motes (1px, a few 2x2), gentle sway, sparse.
+    {
+      float cellPx = 18.0;
+      vec2 q = ip - floor(vec2(time * 9.0, -time * 20.0));
+      vec2 cell = floor(q / cellPx);
+      vec2 local = q - cell * cellPx;
+      if (hash(cell + vec2(71.1, 29.3)) > 0.78) {
+        float h1 = hash(cell + vec2(13.7, 83.9));
+        float h2 = hash(cell + vec2(59.3, 41.1));
+        float h3 = hash(cell + vec2(97.1, 5.9));
+        float sway = floor(sin(time * (1.1 + h1 * 0.8) + h2 * 6.28318) * 1.5 + 0.5);
+        vec2 ctr = floor(vec2(mix(3.0, cellPx - 4.0, h1) + sway, mix(3.0, cellPx - 4.0, h2)));
+        vec2 dl = local - ctr;
+        float big = step(0.75, h3);
+        float on = big > 0.5
+            ? ((dl.x > -0.5 && dl.x < 1.5 && dl.y > -0.5 && dl.y < 1.5) ? 1.0 : 0.0)
+            : ((abs(dl.x) + abs(dl.y) < 0.5) ? 1.0 : 0.0);
+        fall += vec3(0.92, 0.95, 1.00) * on * (0.50 + 0.20 * big);
+      }
+    }
+    // Keep the player / nearby sprites (screen centre) and the text-box
+    // band readable, and never brighten snow: screen-blend, capped.
+    float pd = length((p - 0.5) * vec2(1.3, 1.0));
+    float keep = mix(0.40, 1.0, smoothstep(0.06, 0.26, pd)) * smoothstep(0.02, 0.28, p.y);
+    vec3 fallAdd = clamp(fall * inten * keep * snowGuard, 0.0, 0.40);
+    c = clamp(c, 0.0, 1.0);
+    c = 1.0 - (1.0 - c) * (1.0 - fallAdd);
+  }
+  color = vec4(c, 1.0);
+}
diff --git a/libraries/sim/src/gpu/shaders/g2.frag b/libraries/sim/src/gpu/shaders/g2.frag
new file mode 100644
index 0000000..c87147c
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/g2.frag
@@ -0,0 +1,296 @@
+#version 450
+// 2D composite (port of shaders/g2_fragment.glsl). Samples the layer
+// images of one engine and applies layer priorities and order, the blend
+// registers, windows, the backdrop colour and master brightness.
+//
+// Layer-image convention in this backend: texture row 0 is the TOP line
+// of the top screen, so a GL texture coordinate t samples at v = 1 - t.
+// CPU-uploaded layers are flipped at upload time to match; the window,
+// backdrop and brightness logic below keeps the caller's GL coordinates.
+layout(set = 2, binding = 0) uniform sampler2D bgTex0;
+layout(set = 2, binding = 1) uniform sampler2D bgTex1;
+layout(set = 2, binding = 2) uniform sampler2D bgTex2;
+layout(set = 2, binding = 3) uniform sampler2D bgTex3;
+layout(set = 2, binding = 4) uniform sampler2D objTex0;
+layout(set = 2, binding = 5) uniform sampler2D objTex1;
+layout(set = 2, binding = 6) uniform sampler2D objTex2;
+layout(set = 2, binding = 7) uniform sampler2D objTex3;
+layout(set = 2, binding = 8) uniform sampler2D objWindowTex;
+layout(set = 3, binding = 0) uniform G2Params {
+  vec4 backdropColor;
+  ivec4 bgOrder;
+  ivec4 bgPriorities;
+  ivec4 bld;   // bldcnt, bldalpha, bldy, topScreen
+  ivec4 dsp;   // dispcnt, winin, winout, win0h
+  ivec4 win;   // win0v, win1h, win1v, bg0as3d
+  vec4 misc;   // upscaleW.xy, masterBrightFactor, logical layer width
+  ivec4 miscI; // upscaleMode, masterBrightMode, wideMode, unused
+};
+layout(location = 0) in vec2 fragTexCoord;
+layout(location = 0) out vec4 color;
+
+vec2 layerUV(vec2 uv) {
+  // Layer allocations are 384 pixels wide; uv remains logical (0..1 over
+  // either 256 or the requested native-wide width).
+  return vec2(uv.x * misc.w / 384.0, uv.y);
+}
+vec4 sampleUpscaled(sampler2D tex, vec2 uv) {
+  int upscaleMode = miscI.x;
+  vec2 upscaleW = misc.xy;
+  if (upscaleMode != 1) return texture(tex, layerUV(uv));
+  vec2 logicalSz = vec2(misc.w, 384.0);
+  vec2 p = uv * logicalSz;
+  vec2 c = floor(p - 0.5) + 0.5;
+  vec2 f = p - c;
+  vec2 off = clamp(f / max(upscaleW, vec2(0.0001)), vec2(-0.5), vec2(0.5));
+  vec2 q = c + off;
+  return texture(tex, vec2(q.x / 384.0, q.y / 384.0));
+}
+vec4 texBg(int n, vec2 uv) {
+  vec2 q = layerUV(uv);
+  if (n == 0) return texture(bgTex0, q);
+  if (n == 1) return texture(bgTex1, q);
+  if (n == 2) return texture(bgTex2, q);
+  return texture(bgTex3, q);
+}
+vec4 upBg(int n, vec2 uv) {
+  if (n == 0) return sampleUpscaled(bgTex0, uv);
+  if (n == 1) return sampleUpscaled(bgTex1, uv);
+  if (n == 2) return sampleUpscaled(bgTex2, uv);
+  return sampleUpscaled(bgTex3, uv);
+}
+// The 3D target (BG0 as 3D) keeps GL's filtering: MIN LINEAR / MAG
+// NEAREST, no mipmaps, REPEAT wrap. A split min/mag sampler is not
+// robust: drivers disagree on the filter at a ~1:1 footprint, and Metal
+// takes the min filter there and blurs. So the target is bound with a
+// NEAREST sampler and the choice is made here from the texel footprint,
+// exactly as GL makes it from lambda: footprint > 1 texel -> bilinear,
+// else nearest.
+vec4 sampleG3(vec2 uv) {
+  vec2 sz = vec2(textureSize(bgTex0, 0));
+  vec2 dx = dFdx(uv) * sz;
+  vec2 dy = dFdy(uv) * sz;
+  float rho = max(length(dx), length(dy));
+  if (rho <= 1.0) return texture(bgTex0, uv);
+  vec2 p = uv * sz - 0.5;
+  vec2 base = floor(p);
+  vec2 f = p - base;
+  ivec2 i0 = ivec2(base);
+  ivec2 s = ivec2(sz);
+  vec4 c00 = texelFetch(bgTex0, (i0 + ivec2(0, 0) + s) % s, 0);
+  vec4 c10 = texelFetch(bgTex0, (i0 + ivec2(1, 0) + s) % s, 0);
+  vec4 c01 = texelFetch(bgTex0, (i0 + ivec2(0, 1) + s) % s, 0);
+  vec4 c11 = texelFetch(bgTex0, (i0 + ivec2(1, 1) + s) % s, 0);
+  return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
+}
+// Wide layout (wideMode): BG0-as-3D samples the full-width uv; every
+// other layer samples uv2d, the centred 4:3 rect.
+vec2 uvForBg(int n, int bg0as3d, int wideMode, vec2 uv, vec2 uv2d) {
+  if (n == 0 && bg0as3d != 0) return uv;
+  if (wideMode != 0) return uv2d;
+  return uv;
+}
+vec4 sampleBg(int n, vec2 uv) {
+  int upscaleMode = miscI.x;
+  int bg0as3d = win.w;
+  if (n == 0 && bg0as3d != 0) return sampleG3(uv); // 3D stays at its native internal resolution
+  if (upscaleMode == 0) return texBg(n, uv);
+  return upBg(n, uv);
+}
+vec4 texObj(int n, vec2 uv) {
+  vec2 q = layerUV(uv);
+  if (n == 0) return texture(objTex0, q);
+  if (n == 1) return texture(objTex1, q);
+  if (n == 2) return texture(objTex2, q);
+  return texture(objTex3, q);
+}
+vec4 sampleObj(int n, vec2 uv) {
+  if (miscI.x == 0) return texObj(n, uv);
+  if (n == 0) return sampleUpscaled(objTex0, uv);
+  if (n == 1) return sampleUpscaled(objTex1, uv);
+  if (n == 2) return sampleUpscaled(objTex2, uv);
+  return sampleUpscaled(objTex3, uv);
+}
+// Composite one OBJ pixel over the accumulated colour (bottom-up order).
+// OBJ layer alpha encodes the pixel kind: 1 = opaque, 0.0314 = semi-
+// transparent (XLU) marker, anything else in (0.05, 1) = bitmap OBJ
+// per-sprite alpha, 0 = absent/blocking (already filtered by the caller).
+void drawObjPixel(vec4 obj, bool effectOn, vec2 uv, inout vec4 acc, inout int currentBgDrawn) {
+  int bldcnt = bld.x;
+  int bldalpha = bld.y;
+  float oa = obj.a;
+  if (oa <= 0.01) return;
+  if (oa >= 0.999) { acc = obj; currentBgDrawn = 4; return; }
+  // OBJs only draw inside the 2D rect (the caller guards this), so the
+  // backdrop here is always the 2D backdrop, never the wide side colour.
+  vec3 below = (currentBgDrawn == 5) ? backdropColor.rgb : acc.rgb;
+  if (oa <= 0.05) {
+    // Semi-transparent (XLU): alpha-blend with the pixel below using
+    // BLDALPHA, if the below layer is a 2nd target and the window
+    // effect is on; otherwise opaque.
+    bool belowIsTarget2 = ((bldcnt >> (8 + currentBgDrawn)) & 1) == 1;
+    if (effectOn && belowIsTarget2) {
+      float eva = min(16.0, float(bldalpha & 31)) / 16.0;
+      float evb = min(16.0, float((bldalpha >> 8) & 31)) / 16.0;
+      acc.rgb = min(vec3(1.0), obj.rgb * eva + below * evb);
+      acc.a = 1.0;
+      currentBgDrawn = 4;
+      return;
+    }
+    acc = vec4(obj.rgb, 1.0); currentBgDrawn = 4; return;
+  }
+  // Bitmap OBJ per-sprite alpha: blend with the pixel below by alpha.
+  acc.rgb = obj.rgb * oa + below * (1.0 - oa);
+  acc.a = 1.0; currentBgDrawn = 4;
+}
+void main() {
+  int bldcnt = bld.x;
+  int bldalpha = bld.y;
+  int bldy = bld.z;
+  int topScreen = bld.w;
+  int dispcnt = dsp.x;
+  int winin = dsp.y;
+  int winout = dsp.z;
+  int win0h = dsp.w;
+  int win0v = win.x;
+  int win1h = win.y;
+  int win1v = win.z;
+  int bg0as3d = win.w;
+  float inMasterBrightFactor = misc.z;
+  int inMasterBrightMode = miscI.y;
+  vec2 uv = vec2(fragTexCoord.x, 1.0 - fragTexCoord.y);
+  // Classic 2D remains centred in wide scenes. An opted-in layer wider
+  // than 256 maps its full logical width across the entire 16:9 viewport.
+  int wideMode = miscI.z;
+  bool nativeWide2d = wideMode != 0 && misc.w > 256.0;
+  float s2d = nativeWide2d ? fragTexCoord.s : (fragTexCoord.s - 0.125) / 0.75;
+  bool in2d = wideMode == 0 || nativeWide2d || (s2d >= 0.0 && s2d < 1.0);
+  vec2 uv2d = vec2(clamp(s2d, 0.0, 1.0), uv.y);
+  vec3 backdropRgb = (wideMode != 0 && !in2d) ? vec3(0.0) : backdropColor.rgb;
+  int oamsDrawn = 0;
+  int currentBgDrawn = 5; // Backdrop
+  vec4 acc = vec4(0.0);
+  bool objWindowEnabled = ((dispcnt >> 15) & 1) == 1;
+  if (topScreen == 1) {
+    if (fragTexCoord.t < 0.5) discard;
+  } else {
+    if (fragTexCoord.t >= 0.5) discard;
+  }
+  // GBATEK window priority for this pixel: WIN0 > WIN1 > OBJ window >
+  // outside. Layer passes already applied WIN0/WIN1 to the BG textures,
+  // but the OBJ window and the outside mask were not applied there (they
+  // need the OBJ window texture), and OBJs / colour effects were not
+  // window-gated at all. Resolve the full mask here. With no window
+  // enabled the masks are irrelevant: everything shows.
+  int px = int((wideMode != 0 ? s2d : fragTexCoord.s) * misc.w);
+  int py = topScreen == 1 ? int(383.5 - fragTexCoord.t * 384.0) : int(191.5 - fragTexCoord.t * 384.0);
+  bool inWin0 = ((dispcnt >> 13) & 1) == 1
+      && px >= ((win0h >> 8) & 255) && px < (win0h & 255)
+      && py >= ((win0v >> 8) & 255) && py < (win0v & 255);
+  bool inWin1 = ((dispcnt >> 14) & 1) == 1
+      && px >= ((win1h >> 8) & 255) && px < (win1h & 255)
+      && py >= ((win1v >> 8) & 255) && py < (win1v & 255);
+  bool inObjWin = in2d && objWindowEnabled && texture(objWindowTex, layerUV(wideMode != 0 ? uv2d : uv)).a > 0.1;
+  int winMask;   // BG + colour-effect enables for this pixel
+  int objWinMask; // OBJ enable for this pixel (the OBJ window never gates OBJs)
+  if (((dispcnt >> 13) & 7) == 0) { winMask = 63; objWinMask = 63; }
+  else if (inWin0) { winMask = winin & 63; objWinMask = winin & 63; }
+  else if (inWin1) { winMask = (winin >> 8) & 63; objWinMask = (winin >> 8) & 63; }
+  else if (inObjWin) { winMask = (winout >> 8) & 63; objWinMask = winout & 63; }
+  else { winMask = winout & 63; objWinMask = winout & 63; }
+  bool effectOn = ((winMask >> 5) & 1) == 1;
+  for (int i = 0; i < 4; i++) {
+    int bgNum = bgOrder[i];
+    int curPrio = bgPriorities[bgNum];
+    // Draw the OBJs that are at or below the current BG priority
+    for (int j = 3 - oamsDrawn; j > curPrio; j--) {
+      if (in2d && ((objWinMask >> 4) & 1) == 1) {
+        drawObjPixel(sampleObj(j, wideMode != 0 ? uv2d : uv), effectOn, uv, acc, currentBgDrawn);
+      }
+      oamsDrawn++;
+    }
+    // Window: BG visibility for this pixel (layer passes handled
+    // WIN0/WIN1; the OBJ-window / outside choice is made here).
+    if (((winMask >> bgNum) & 1) == 0) continue;
+    if (!in2d && !(bgNum == 0 && bg0as3d != 0)) continue;
+    // Draw the current BG. Cache each texture lookup: the old code
+    // re-fetched the same texel separately for alpha/R/G/B (up to 12
+    // texture operations for one layer on some GLSL compilers).
+    vec2 bgUv = uvForBg(bgNum, bg0as3d, wideMode, uv, uv2d);
+    vec4 bg = sampleBg(bgNum, bgUv);
+    if (effectOn && bgNum == 0 && bg0as3d != 0 && bg.a > 0.004 && bg.a < 0.99 &&
+        (((bldcnt >> (8 + currentBgDrawn)) & 1) == 1)) {
+      // DS special case: translucent 3D pixels are alpha blended with the layer below whenever that layer is a 2nd
+      // target, whatever the blend mode and 1st targets are (particles, glows). The 3D buffer holds colour already
+      // weighted by its alpha (it is drawn over a transparent clear with SRC_ALPHA blending).
+      vec3 below = (currentBgDrawn == 5) ? backdropRgb : acc.rgb;
+      acc.rgb = min(vec3(1.0), bg.rgb + below * (1.0 - bg.a));
+      acc.a = 1.0;
+      currentBgDrawn = bgNum;
+    } else if (bg.a > 0.1) {
+      // Handle blending
+      if (effectOn && ((bldcnt >> 6) & 0x3) == 1 && ((bldcnt >> bgNum) & 1) == 1) {
+        // Alpha Blending Mode. bgNum is Target 1.
+        float alphaA = min(16.0, float(bldalpha & 31)) / 16.0;
+        float alphaB = min(16.0, float((bldalpha >> 8) & 31)) / 16.0;
+        if (bgNum == 0 && bg0as3d != 0) {
+          alphaA = bg.a;
+          alphaB = 1.0 - alphaA;
+        }
+        if ((currentBgDrawn < 4) && (((bldcnt >> (8 + currentBgDrawn)) & 1) == 1)) {
+          vec4 below = sampleBg(currentBgDrawn,
+              uvForBg(currentBgDrawn, bg0as3d, wideMode, uv, uv2d));
+          acc.rgb = min(vec3(1.0), bg.rgb * alphaA + below.rgb * alphaB);
+          acc.a = 1.0;
+          currentBgDrawn = bgNum;
+        } else if ((currentBgDrawn == 4) && (((bldcnt >> (8 + currentBgDrawn)) & 1) == 1)) {
+          // Alpha blending where the highest OBJ pixel is the target
+          acc.rgb = min(vec3(1.0), bg.rgb * alphaA + acc.rgb * alphaB);
+          acc.a = 1.0;
+        } else if ((currentBgDrawn == 5) && (((bldcnt >> (8 + currentBgDrawn)) & 1) == 1)) {
+          // Alpha blending where the backdrop is the target
+          acc.rgb = min(vec3(1.0), bg.rgb * alphaA + backdropRgb * alphaB);
+          acc.a = 1.0;
+        } else {
+          acc = bg;
+          currentBgDrawn = bgNum;
+        }
+      } else if (effectOn && ((bldcnt >> 6) & 0x3) == 2 && ((bldcnt >> bgNum) & 1) == 1) {
+        // Brightness Increase Mode. bgNum is Target 1.
+        float brightFactor = min(16.0, float(bldy & 31)) / 16.0;
+        acc.rgb = bg.rgb + (vec3(1.0) - bg.rgb) * brightFactor;
+        acc.a = 1.0;
+        currentBgDrawn = bgNum;
+      } else if (effectOn && ((bldcnt >> 6) & 0x3) == 3 && ((bldcnt >> bgNum) & 1) == 1) {
+        // Brightness Decrease Mode. bgNum is Target 1.
+        float brightFactor = min(16.0, float(bldy & 31)) / 16.0;
+        acc.rgb = max(vec3(0.0), bg.rgb - bg.rgb * brightFactor);
+        acc.a = 1.0;
+        currentBgDrawn = bgNum;
+      } else {
+        acc.rgb = bg.rgb;
+        acc.a = 1.0;
+        currentBgDrawn = bgNum;
+      }
+    }
+  }
+  // Draw the remaining objs
+  for (int i = 3 - oamsDrawn; i >= 0; i--) {
+    if (in2d && ((objWinMask >> 4) & 1) == 1) {
+      drawObjPixel(sampleObj(i, wideMode != 0 ? uv2d : uv), effectOn, uv, acc, currentBgDrawn);
+    }
+  }
+  if (currentBgDrawn == 5) { acc = backdropColor; if (wideMode != 0 && !in2d) acc.a = 0.0; }
+  if (inMasterBrightMode == 1) {
+    // brightness up
+    acc.r = acc.r + ((1.0 - acc.r) * (inMasterBrightFactor / 16.0));
+    acc.g = acc.g + ((1.0 - acc.g) * (inMasterBrightFactor / 16.0));
+    acc.b = acc.b + ((1.0 - acc.b) * (inMasterBrightFactor / 16.0));
+  } else if (inMasterBrightMode == 2) {
+    // brightness down
+    acc.r = acc.r - (acc.r * (inMasterBrightFactor / 16.0));
+    acc.g = acc.g - (acc.g * (inMasterBrightFactor / 16.0));
+    acc.b = acc.b - (acc.b * (inMasterBrightFactor / 16.0));
+  }
+  color = acc;
+}
diff --git a/libraries/sim/src/gpu/shaders/g2clear.frag b/libraries/sim/src/gpu/shaders/g2clear.frag
new file mode 100644
index 0000000..90ee6db
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/g2clear.frag
@@ -0,0 +1,5 @@
+#version 450
+// Clears one engine's half of a layer image to transparent black. Drawn
+// with a scissor over that half; the layer passes then draw over it.
+layout(location = 0) out vec4 o;
+void main() { o = vec4(0.0); }
diff --git a/libraries/sim/src/gpu/shaders/g2gpu.frag b/libraries/sim/src/gpu/shaders/g2gpu.frag
new file mode 100644
index 0000000..0b9ff3c
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/g2gpu.frag
@@ -0,0 +1,377 @@
+#version 450
+// GPU 2D layer renderer (port of shaders/g2gpu_fragment.glsl). One pass
+// renders one layer (a BG, an OBJ priority layer, or the OBJ window mask)
+// into that layer's 256x384 image; the g2 composite is unchanged
+// afterwards. Integer data (VRAM, OAM, palettes) arrives in storage
+// buffers: SDL GPU forbids samplers on integer textures and storage
+// textures crash lavapipe on SDL 3.4.16, so the GL path's usampler2D +
+// texelFetch reads become packed-word array reads here (bytes packed
+// four per uint, 16-bit words two per uint, little-endian).
+layout(set = 2, binding = 0) readonly buffer BgVram { uint w[]; } bgVram;
+layout(set = 2, binding = 1) readonly buffer ObjVram { uint w[]; } objVram;
+layout(set = 2, binding = 2) readonly buffer Lcdc { uint w[]; } lcdc;
+layout(set = 2, binding = 3) readonly buffer Oam { uint w[]; } oam;
+layout(set = 2, binding = 4) readonly buffer Pal { uint w[]; } pal;
+layout(set = 3, binding = 0) uniform G2GpuParams {
+  ivec4 bgcnt;
+  ivec4 bgofs; // packed HOFS | VOFS<<16 (text BGs)
+  ivec4 affA;
+  ivec4 affB;
+  ivec4 affC;
+  ivec4 affD;
+  ivec4 affX;
+  ivec4 affY;
+  ivec4 m0; // passMode, isSub, layer, topScreen
+  ivec4 m1; // dispcnt, bgMode, extPlttBase, objExtPlttBase
+  ivec4 m2; // win0h, win0v, win1h, win1v
+  ivec4 m3; // winin, winout, mosaic, dbgEnable
+  ivec4 m4; // objCount, singleMode, logical layer width, unused
+  ivec4 objList[32]; // candidate sprite indices for this pass (ascending)
+};
+layout(location = 0) out vec4 outColor;
+
+// Safe sign extension (no signed-overflow UB: left-shifting a signed int
+// past its width, or converting an out-of-range uint to int, is
+// undefined in GLSL, and Apple's Metal translation does not wrap the
+// way Mesa does, so rot/scale sprites vanished there).
+int signExtend9(uint v) { uint x = v & 0x1FFu; return x >= 256u ? int(x) - 512 : int(x); }
