+bool ValidateGlbHeader(const std::string &path) {
+  FILE *f = std::fopen(path.c_str(), "rb");
+  if (!f) return false;
+  std::uint8_t hdr[12] = {};
+  bool ok = std::fread(hdr, 1, sizeof(hdr), f) == sizeof(hdr);
+  std::fclose(f);
+  if (!ok) return false;
+  if (hdr[0] != 'g' || hdr[1] != 'l' || hdr[2] != 'T' || hdr[3] != 'F') return false;
+  std::uint32_t version = static_cast<std::uint32_t>(hdr[4]) |
+                          (static_cast<std::uint32_t>(hdr[5]) << 8) |
+                          (static_cast<std::uint32_t>(hdr[6]) << 16) |
+                          (static_cast<std::uint32_t>(hdr[7]) << 24);
+  return version == 2;
+}
+
+bool ValidateGlbAsset(const std::string &path, bool checkSkinned) {
+  if (!ValidateGlbHeader(path)) return false;
+  std::vector<std::uint8_t> fileBytes;
+  if (!ReadFileBytes(path, fileBytes)) return false;
+
+  cgltf_options opts{};
+  cgltf_data *data = nullptr;
+  if (cgltf_parse(&opts, fileBytes.data(), fileBytes.size(), &data) != cgltf_result_success || !data) {
+    return false;
+  }
+  if (cgltf_load_buffers(&opts, data, path.c_str()) != cgltf_result_success ||
+      cgltf_validate(data) != cgltf_result_success) {
+    cgltf_free(data);
+    return false;
+  }
+
+  if (checkSkinned) {
+    for (cgltf_size si = 0; si < data->skins_count; si++) {
+      if (data->skins[si].joints_count > kMaxGltfJoints) {
+        cgltf_free(data);
+        return false;
+      }
+    }
+  }
+
+  bool anyPrim = false;
+  for (cgltf_size ni = 0; ni < data->nodes_count; ni++) {
+    const cgltf_node &gn = data->nodes[ni];
+    if (!gn.mesh) continue;
+    for (cgltf_size pi = 0; pi < gn.mesh->primitives_count; pi++) {
+      const cgltf_primitive &prim = gn.mesh->primitives[pi];
+      if (prim.type != cgltf_primitive_type_triangles) continue;
+      const cgltf_accessor *posAcc = nullptr;
+      for (cgltf_size ai = 0; ai < prim.attributes_count; ai++) {
+        if (prim.attributes[ai].type == cgltf_attribute_type_position) {
+          posAcc = prim.attributes[ai].data;
+          break;
+        }
+      }
+      if (!posAcc || posAcc->count == 0) continue;
+      const cgltf_size vCount = posAcc->count;
+      if (prim.indices && prim.indices->count >= 3) {
+        const cgltf_size ic = (prim.indices->count / 3) * 3;
+        for (cgltf_size i = 0; i < ic; i++) {
+          if (cgltf_accessor_read_index(prim.indices, i) >= vCount) {
+            cgltf_free(data);
+            return false;
+          }
+        }
+        anyPrim = true;
+      } else if (vCount >= 3) {
+        anyPrim = true;
+      }
+    }
+  }
+
+  cgltf_free(data);
+  return anyPrim;
+}
+
+bool LoadGltfArenaCpu(const std::string &path, GltfArenaCpuData &out) {
+  out = GltfArenaCpuData{};
+  if (!ValidateGlbHeader(path)) return false;
+  std::vector<std::uint8_t> fileBytes;
+  if (!ReadFileBytes(path, fileBytes)) return false;
+
+  cgltf_options opts{};
+  cgltf_data *data = nullptr;
+  if (cgltf_parse(&opts, fileBytes.data(), fileBytes.size(), &data) != cgltf_result_success || !data) {
+    return false;
+  }
+  if (cgltf_load_buffers(&opts, data, path.c_str()) != cgltf_result_success ||
+      cgltf_validate(data) != cgltf_result_success) {
+    cgltf_free(data);
+    return false;
+  }
+
+  std::vector<GltfMaterial> materials;
+  DecodeTexturesAndMaterials(data, out.textures, materials);
+
+  std::vector<GltfNode> nodes;
+  std::vector<std::int32_t> topo;
+  BuildNodeHierarchy(data, nodes, topo);
+
+  std::vector<float> worldMats(nodes.size() * 16);
+  for (std::int32_t idx : topo) {
+    float *dst = &worldMats[static_cast<std::size_t>(idx) * 16];
+    if (nodes[idx].parent >= 0) {
+      Mat4Mul(dst, &worldMats[static_cast<std::size_t>(nodes[idx].parent) * 16], nodes[idx].matrix);
+    } else {
+      std::memcpy(dst, nodes[idx].matrix, sizeof(float) * 16);
+    }
+  }
+
+  std::vector<B3DVertex> &verts = out.verts;
+  std::vector<std::uint32_t> &indices = out.indices;
+  out.hasOwnSky = false;
+
+  for (cgltf_size ni = 0; ni < data->nodes_count; ni++) {
+    const cgltf_node &gn = data->nodes[ni];
+    if (!gn.mesh) continue;
+    const float *wmat = &worldMats[ni * 16];
+    const bool flipWinding = Mat3Det(wmat) < 0.0f;
+    std::string nodeLower = LowerStr(gn.name);
+    const bool nodeIsSky = nodeLower.find("sky") != std::string::npos;
+
+    for (cgltf_size pi = 0; pi < gn.mesh->primitives_count; pi++) {
+      const cgltf_primitive &prim = gn.mesh->primitives[pi];
+      if (prim.type != cgltf_primitive_type_triangles) continue;
+
+      const cgltf_accessor *posAcc = nullptr;
+      const cgltf_accessor *normAcc = nullptr;
+      const cgltf_accessor *uvAcc = nullptr;
+      const cgltf_accessor *colAcc = nullptr;
+      for (cgltf_size ai = 0; ai < prim.attributes_count; ai++) {
+        const cgltf_attribute &a = prim.attributes[ai];
+        if (a.type == cgltf_attribute_type_position) posAcc = a.data;
+        else if (a.type == cgltf_attribute_type_normal) normAcc = a.data;
+        else if (a.type == cgltf_attribute_type_texcoord && a.index == 0) uvAcc = a.data;
+        else if (a.type == cgltf_attribute_type_color && a.index == 0) colAcc = a.data;
+      }
+      if (!posAcc || posAcc->count == 0) continue;
+
+      GltfMaterial mat{};
+      if (prim.material && data->materials) {
+        std::size_t mi = static_cast<std::size_t>(prim.material - data->materials);
+        if (mi < materials.size()) mat = materials[mi];
+      }
+      bool isSky = mat.isSky || nodeIsSky;
+      if (isSky) out.hasOwnSky = true;
+
+      const std::uint32_t baseVert = static_cast<std::uint32_t>(verts.size());
+      const std::uint32_t vCount = static_cast<std::uint32_t>(posAcc->count);
+      verts.resize(baseVert + vCount);
+
+      float smMin[3] = {0.0f, 0.0f, 0.0f};
+      float smMax[3] = {0.0f, 0.0f, 0.0f};
+      for (std::uint32_t v = 0; v < vCount; v++) {
+        B3DVertex &dv = verts[baseVert + v];
+        float p[3] = {0, 0, 0};
+        cgltf_accessor_read_float(posAcc, v, p, 3);
+        Mat4TransformPoint(wmat, p, dv.pos);
+        if (v == 0) {
+          for (int k = 0; k < 3; k++) smMin[k] = smMax[k] = dv.pos[k];
+        } else {
+          for (int k = 0; k < 3; k++) {
+            smMin[k] = std::min(smMin[k], dv.pos[k]);
+            smMax[k] = std::max(smMax[k], dv.pos[k]);
+          }
+        }
+
+        if (normAcc && v < normAcc->count) {
+          float n[3] = {0, 1, 0};
+          cgltf_accessor_read_float(normAcc, v, n, 3);
+          Mat4TransformNormal(wmat, n, dv.norm);
+        } else {
+          dv.norm[0] = 0.0f; dv.norm[1] = 1.0f; dv.norm[2] = 0.0f;
+        }
+
+        if (uvAcc && v < uvAcc->count) {
+          cgltf_accessor_read_float(uvAcc, v, dv.uv, 2);
+        } else {
+          dv.uv[0] = 0.0f; dv.uv[1] = 0.0f;
+        }
+
+        float c[4] = {1, 1, 1, 1};
+        if (colAcc && v < colAcc->count) {
+          cgltf_accessor_read_float(colAcc, v, c, colAcc->type == cgltf_type_vec3 ? 3 : 4);
+        }
+        dv.color[0] = c[0] * mat.baseColorFactor[0];
+        dv.color[1] = c[1] * mat.baseColorFactor[1];
+        dv.color[2] = c[2] * mat.baseColorFactor[2];
+        dv.color[3] = c[3] * mat.baseColorFactor[3];
+      }
+
+      const std::uint32_t firstIdx = static_cast<std::uint32_t>(indices.size());
+      if (prim.indices && prim.indices->count >= 3) {
+        std::size_t ic = (prim.indices->count / 3) * 3;
+        indices.reserve(indices.size() + ic);
+        for (std::size_t i = 0; i < ic; i += 3) {
+          cgltf_size r0 = cgltf_accessor_read_index(prim.indices, i);
+          cgltf_size r1 = cgltf_accessor_read_index(prim.indices, i + 1);
+          cgltf_size r2 = cgltf_accessor_read_index(prim.indices, i + 2);
+          if (r0 >= vCount || r1 >= vCount || r2 >= vCount) {
+            cgltf_free(data);
+            out = GltfArenaCpuData{};
+            return false;
+          }
+          std::uint32_t i0 = baseVert + static_cast<std::uint32_t>(r0);
+          std::uint32_t i1 = baseVert + static_cast<std::uint32_t>(r1);
+          std::uint32_t i2 = baseVert + static_cast<std::uint32_t>(r2);
+          if (flipWinding) std::swap(i1, i2);
+          indices.push_back(i0); indices.push_back(i1); indices.push_back(i2);
+        }
+      } else if (vCount >= 3) {
+        std::uint32_t ic = (vCount / 3) * 3;
+        indices.reserve(indices.size() + ic);
+        for (std::uint32_t i = 0; i < ic; i += 3) {
+          std::uint32_t i0 = baseVert + i, i1 = baseVert + i + 1, i2 = baseVert + i + 2;
+          if (flipWinding) std::swap(i1, i2);
+          indices.push_back(i0); indices.push_back(i1); indices.push_back(i2);
+        }
+      }
+      const std::uint32_t idxCount = static_cast<std::uint32_t>(indices.size()) - firstIdx;
+      if (idxCount == 0) continue;
+
+      if (!normAcc) {
+        ComputeMissingNormals(verts, baseVert, vCount, indices, firstIdx, idxCount);
+      }
+
+      GltfArenaSubmesh sm{};
+      sm.firstIndex = firstIdx;
+      sm.indexCount = idxCount;
+      sm.textureIndex = mat.baseColorTex;
+      sm.roughness = mat.roughness;
+      sm.fogFactor = isSky ? 0.0f : 1.0f;
+      sm.alphaCutoff = mat.alphaCutoff;
+      sm.alphaMode = mat.alphaMode;
+      sm.isSky = isSky;
+      sm.castsShadow = !isSky && !mat.noShadow && !mat.unlit &&
+                       (mat.alphaMode != GltfAlphaMode::Blend);
+      std::memcpy(sm.bboxMin, smMin, sizeof(smMin));
+      std::memcpy(sm.bboxMax, smMax, sizeof(smMax));
+      sm.flags = 0;
+      if (mat.unlit || isSky) sm.flags |= B3D_SUBMESH_UNLIT;
+      if (sm.castsShadow) sm.flags |= B3D_SUBMESH_CAST_SHADOW;
+      if (!isSky) sm.flags |= B3D_SUBMESH_RECEIVE_SHADOW;
+      if (mat.alphaMode == GltfAlphaMode::Mask) sm.flags |= B3D_SUBMESH_ALPHA_TEST;
+      if (mat.doubleSided) sm.flags |= B3D_SUBMESH_DOUBLE_SIDED;
+      out.submeshes.push_back(sm);
+    }
+  }
+
+  cgltf_free(data);
+
+  if (verts.empty() || indices.empty() || out.submeshes.empty()) {
+    out = GltfArenaCpuData{};
+    return false;
+  }
+
+  if (!out.hasOwnSky) {
+    AppendProceduralSkyDome(verts, indices, out.submeshes);
+  }
+
+  // P5: Draw Opaque (1) & Mask (2) BEFORE Sky dome (4) so early-Z rejects occluded sky pixels,
+  // and Blend (5) last.
+  std::stable_sort(out.submeshes.begin(), out.submeshes.end(),
+                   [](const GltfArenaSubmesh &a, const GltfArenaSubmesh &b) {
+                     auto rank = [](const GltfArenaSubmesh &s) {
+                       if (s.isSky) return 4;
+                       if (s.alphaMode == GltfAlphaMode::Opaque) return 1;
+                       if (s.alphaMode == GltfAlphaMode::Mask) return 2;
+                       return 5;
+                     };
+                     return rank(a) < rank(b);
+                   });
+
+  out.valid = true;
+  return true;
+}
+
+bool UploadGltfArenaCpu(Device &device, Frame *frame, GltfArenaCpuData &&cpu, GltfArena &out) {
+  if (!frame || !cpu.valid || cpu.verts.empty() || cpu.indices.empty() || cpu.submeshes.empty()) {
+    return false;
+  }
+
+  std::size_t vramBytes = 0;
+  UploadMipmappedTextures(device, frame, cpu.textures, "battle3d_arena_tex", out.textures, vramBytes);
+
+  const std::size_t vBytes = cpu.verts.size() * sizeof(B3DVertex);
+  const std::size_t iBytes = cpu.indices.size() * sizeof(std::uint32_t);
+
+  SDL_GPUBufferCreateInfo vInfo{};
+  vInfo.usage = SDL_GPU_BUFFERUSAGE_VERTEX;
+  vInfo.size = static_cast<Uint32>(vBytes);
+  out.vertexBuffer = SDL_CreateGPUBuffer(device.Handle(), &vInfo);
+  if (!out.vertexBuffer) {
+    ReleaseGltfArena(device, out);
+    return false;
+  }
+
+  SDL_GPUBufferCreateInfo iInfo{};
+  iInfo.usage = SDL_GPU_BUFFERUSAGE_INDEX;
+  iInfo.size = static_cast<Uint32>(iBytes);
+  out.indexBuffer = SDL_CreateGPUBuffer(device.Handle(), &iInfo);
+  if (!out.indexBuffer) {
+    ReleaseGltfArena(device, out);
+    return false;
+  }
+
+  frame->UploadBuffer(out.vertexBuffer, 0, cpu.verts.data(), static_cast<Uint32>(vBytes), true);
+  frame->UploadBuffer(out.indexBuffer, 0, cpu.indices.data(), static_cast<Uint32>(iBytes), true);
+  out.numVertices = static_cast<std::uint32_t>(cpu.verts.size());
+  out.numIndices = static_cast<std::uint32_t>(cpu.indices.size());
+  out.vramBytes = vramBytes + vBytes + iBytes;
+  out.hasOwnSky = cpu.hasOwnSky;
+  out.submeshes = std::move(cpu.submeshes);
+  out.valid = true;
+  return true;
+}
+
+bool LoadGltfArena(Device &device, Frame *frame, const std::string &path, GltfArena &out) {
+  if (!frame) return false;
+  GltfArenaCpuData cpu;
+  if (!LoadGltfArenaCpu(path, cpu)) return false;
+  return UploadGltfArenaCpu(device, frame, std::move(cpu), out);
+}
+
+void ReleaseGltfArena(Device &device, GltfArena &arena) {
+  if (device.Handle()) {
+    if (arena.vertexBuffer) {
+      SDL_ReleaseGPUBuffer(device.Handle(), arena.vertexBuffer);
+      arena.vertexBuffer = nullptr;
+    }
+    if (arena.indexBuffer) {
+      SDL_ReleaseGPUBuffer(device.Handle(), arena.indexBuffer);
+      arena.indexBuffer = nullptr;
+    }
+  }
+  arena.textures.clear();
+  arena.submeshes.clear();
+  arena.numVertices = 0;
+  arena.numIndices = 0;
+  arena.vramBytes = 0;
+  arena.valid = false;
+  arena.attempted = false;
+  arena.hasOwnSky = false;
+}
