+static void HandleFingerPixel(SDL_FingerID finger, int phase, int px, int py, int winW, int winH) {
+  float nx = winW > 0 ? (float)px / (float)winW : 0.0f;
+  float ny = winH > 0 ? (float)py / (float)winH : 0.0f;
+  if (phase == 0) {
+    SIM::Touchpad::NoteTouch();
+    // Native-wide 2D owns the complete main surface. Route it before the
+    // optional iOS controls overlay so Bag pocket/item taps cannot be eaten
+    // by controls that normally occupy the 4:3 side margins.
+    if (SIM_Layout_GetWide2DWidth() > SIM_NDS_SCREEN_WIDTH && SIM_Layout_MainTouchEnabled()
+        && px >= sMainRectPx[0] && px <= sMainRectPx[2] && py >= sMainRectPx[1] && py <= sMainRectPx[3]) {
+      SIM_Layout_PushMainTouch(
+          map(px, sMainRectPx[0], sMainRectPx[2], 0, SIM_Layout_GetWide2DWidth() - 1),
+          map(py, sMainRectPx[1], sMainRectPx[3], 0, SIM_NDS_SCREEN_HEIGHT - 1));
+      return;
+    }
+    if (SIM::Touchpad::FingerDown((int64_t)finger, nx, ny, winW, winH)) return;
+    if (WideActive() && sPanelAnim <= 0.0f && px >= sTabIconRect[0] && px <= sTabIconRect[2] && py >= sTabIconRect[1] && py <= sTabIconRect[3]) { SIM_Layout_SetPanelOpen(1); return; }
+    if (WideActive() && sPanelAnim > 0.0f && sCloseIconRect[2] > sCloseIconRect[0] && px >= sCloseIconRect[0] && px <= sCloseIconRect[2] && py >= sCloseIconRect[1] && py <= sCloseIconRect[3]) { SIM_Layout_SetPanelOpen(0); return; }
+    if (SIM_Layout_MainTouchEnabled() && px >= sMainRectPx[0] && px <= sMainRectPx[2] && py >= sMainRectPx[1] && py <= sMainRectPx[3] && sMainRectPx[2] > sMainRectPx[0]) {
+      int touchW = SIM_Layout_GetWide2DWidth() > SIM_NDS_SCREEN_WIDTH
+          ? SIM_Layout_GetWide2DWidth() : SIM_NDS_SCREEN_WIDTH;
+      SIM_Layout_PushMainTouch(map(px, sMainRectPx[0], sMainRectPx[2], 0, touchW - 1), map(py, sMainRectPx[1], sMainRectPx[3], 0, SIM_NDS_SCREEN_HEIGHT - 1));
+    }
+    if (!sFingerDS.active) { sFingerDS.active = true; sFingerDS.id = finger; sFingerDS.x = px; sFingerDS.y = py; }
+  } else if (phase == 1) {
+    if (SIM::Touchpad::IsOverlayFinger((int64_t)finger)) SIM::Touchpad::FingerMotion((int64_t)finger, nx, ny, winW, winH);
+    else if (sFingerDS.active && sFingerDS.id == finger) { sFingerDS.x = px; sFingerDS.y = py; }
+  } else {
+    if (SIM::Touchpad::IsOverlayFinger((int64_t)finger)) SIM::Touchpad::FingerUp((int64_t)finger, nx, ny, winW, winH);
+    if (sFingerDS.active && sFingerDS.id == finger) sFingerDS.active = false;
+  }
+}
