+// Ring readback: frame N's download is collected after later frames ran.
+static bool CaseRingReadback(Device &d) {
+    RenderTarget target;
+    CHECK(target.Create(d, 2, 2, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, false, "selftest-ring"), "target create");
+    auto draw = [&](const ShaderBlob &frag) -> bool {
+        Frame *f = d.BeginFrame();
+        if (!f) return false;
+        if (!f->BeginPass(Phase::Scene3D, PassDesc::Color(target.Color().Handle()))) return false;
+        f->BindPipeline(Pipe(d, test_pos_vert, frag, PosLayout()));
+        f->SetViewport(FullViewport(2, 2));
+        FullscreenPosQuad(f);
+        f->EndPass();
+        return f->End();
+    };
+    ReadbackRing ring(d, 3);
+    CHECK(draw(test_red_frag), "draw red");
+    Uint64 tRed = ring.Request(target.Color().Handle(), target.Color().Format(), 2, 2);
+    CHECK(tRed != 0, "ring request red");
+    CHECK(draw(test_green_frag), "draw green");
+    Uint64 tGreen = ring.Request(target.Color().Handle(), target.Color().Format(), 2, 2);
+    CHECK(tGreen != 0, "ring request green");
+    CHECK(ring.HasOutstanding(), "ring reports nothing outstanding");
+    // The synchronous readback of the same texture must agree with the ring.
+    std::vector<Uint8> sync;
+    CHECK(d.ReadbackRGBA8(target.Color(), sync), "sync readback");
+    CHECK(PixelEq(sync, 2, 0, 0, 0, 255, 0, 255), "sync readback is not green");
+    std::vector<Uint8> px;
+    CHECK(ring.Collect(tRed, px, true), "collect red");
+    CHECK(PixelEq(px, 2, 0, 0, 255, 0, 0, 255), "ring readback of frame N is not red");
+    CHECK(ring.Collect(tGreen, px, true), "collect green");
+    CHECK(PixelEq(px, 2, 0, 0, 0, 255, 0, 255), "ring readback of frame N+1 is not green");
+    CHECK(!ring.HasOutstanding(), "ring still reports outstanding after collecting all");
+    // Ring wrap with a 2-slot ring: the uncollected oldest request is
+    // discarded, the newest still collects.
+    ReadbackRing small(d, 2);
+    CHECK(draw(test_red_frag), "draw red 2");
+    Uint64 a = small.Request(target.Color().Handle(), target.Color().Format(), 2, 2);
+    CHECK(draw(test_green_frag), "draw green 2");
+    Uint64 b = small.Request(target.Color().Handle(), target.Color().Format(), 2, 2);
+    CHECK(draw(test_red_frag), "draw red 3");
+    Uint64 c = small.Request(target.Color().Handle(), target.Color().Format(), 2, 2);
+    CHECK(a && b && c, "small-ring requests");
+    CHECK(!small.Collect(a, px, true), "discarded token collected anyway");
+    CHECK(small.Collect(c, px, true), "collect newest after wrap");
+    CHECK(PixelEq(px, 2, 0, 0, 255, 0, 0, 255), "ring readback after wrap is not red");
+    return true;
+}
