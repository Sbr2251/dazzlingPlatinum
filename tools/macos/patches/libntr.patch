+std::uint64_t MakeModelKey(int species, int form, int isShiny) {
+  return (static_cast<std::uint64_t>(static_cast<std::uint32_t>(species)) << 16) |
+         (static_cast<std::uint64_t>(static_cast<std::uint32_t>(form) & 0x7FFFu) << 1) |
+         (isShiny ? 1ull : 0ull);
+}
+
+struct ProbeEntry {
+  bool exists = false;
+  std::string path;
+};
+
+struct CachedModelBounds {
+  float min[3] = {0.0f, 0.0f, 0.0f};
+  float max[3] = {0.0f, 0.0f, 0.0f};
+};
+
+std::mutex gProbeMutex;
+bool gAssetRootsInit = false;
+std::array<std::string, 3> gAssetRoots;
+std::unordered_map<std::uint64_t, ProbeEntry> gModelProbeCache;
+std::unordered_map<int, ProbeEntry> gArenaProbeCache;
+std::unordered_map<int, ProbeEntry> gActorProbeCache;
+std::unordered_set<std::uint64_t> gFailedModels;
+std::unordered_set<int> gFailedArenas;
+std::unordered_set<int> gFailedActors;
+std::unordered_set<std::uint64_t> gReadyModels;
+std::unordered_map<std::uint64_t, std::array<float, kBattle3DAnimSlotCount>> gModelClipDurations;
+std::unordered_map<std::uint64_t, CachedModelBounds> gModelBounds;
+
+void EnsureAssetRootsLocked() {
+  if (gAssetRootsInit) return;
+  gAssetRootsInit = true;
+  const char *envDir = std::getenv("SIM_BDSP_ASSETS_DIR");
+  const char *writableDir = SIM_Platform_WritableDir();
+  const char *dataDir = SIM_Platform_DataDir();
+  gAssetRoots[0] = ExpandLeadingTilde(envDir);
+  gAssetRoots[1] = (writableDir && writableDir[0] != '\0') ? JoinPath(writableDir, "bdsp_assets") : std::string();
+  gAssetRoots[2] = (dataDir && dataDir[0] != '\0') ? JoinPath(dataDir, "bdsp_assets") : std::string();
+}
+
+// P1 & P10: Fast 12-byte GLB v2 header probe (never runs full cgltf parse on the game thread).
+std::string ProbeBdspAssetPath(const std::string &relPath) {
+  std::array<std::string, 3> roots;
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    EnsureAssetRootsLocked();
+    roots = gAssetRoots;
+  }
+  for (const auto &root : roots) {
+    if (root.empty()) continue;
+    std::string full = JoinPath(root, relPath);
+    if (FileExists(full) && ValidateGlbHeader(full)) {
+      return full;
+    }
+  }
+  return "";
+}
+
+void RecordModelCpuMetadata(std::uint64_t key, const GltfModelCpuData &cpu) {
+  std::array<float, kBattle3DAnimSlotCount> durs{};
+  for (int s = 0; s < kBattle3DAnimSlotCount; s++) {
+    durs[s] = cpu.hasClip[s] ? cpu.clips[s].duration : 0.0f;
+  }
+  CachedModelBounds bounds{};
+  std::memcpy(bounds.min, cpu.bboxMin, sizeof(bounds.min));
+  std::memcpy(bounds.max, cpu.bboxMax, sizeof(bounds.max));
+  std::lock_guard<std::mutex> lock(gProbeMutex);
+  gModelClipDurations[key] = durs;
+  gModelBounds[key] = bounds;
+}
+
+// P1: Single-parse background worker for interactive GLB CPU decode (cgltf + stb_image + vertex build).
+// Headless runs bypass the worker thread and parse synchronously once for 100% determinism.
+class GlbAsyncLoader {
+ public:
+  ~GlbAsyncLoader() { Shutdown(); }
+
+  void EnqueueArena(int biome, const std::string &path) {
+    if (path.empty()) return;
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mInFlightArenas.count(biome) || mCompletedArenas.count(biome)) return;
+    mInFlightArenas.insert(biome);
+    mJobs.push_back({JobKind::Arena, static_cast<std::uint64_t>(biome), path});
+    StartWorkerLocked();
+    mCv.notify_one();
+  }
+
+  void EnqueueModel(std::uint64_t key, const std::string &path) {
+    if (path.empty()) return;
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mInFlightModels.count(key) || mCompletedModels.count(key)) return;
+    mInFlightModels.insert(key);
+    mJobs.push_back({JobKind::Model, key, path});
+    StartWorkerLocked();
+    mCv.notify_one();
+  }
+
+  void EnqueueActor(int kind, const std::string &path) {
+    if (path.empty()) return;
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mInFlightActors.count(kind) || mCompletedActors.count(kind)) return;
+    mInFlightActors.insert(kind);
+    mJobs.push_back({JobKind::Actor, static_cast<std::uint64_t>(kind), path});
+    StartWorkerLocked();
+    mCv.notify_one();
+  }
+
+  void StoreSyncModel(std::uint64_t key, GltfModelCpuData &&cpu) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    mCompletedModels[key] = std::move(cpu);
+  }
+
+  bool HasPendingModelCpu(std::uint64_t key) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    return mCompletedModels.count(key) != 0;
+  }
+
+  bool PopCompletedModel(std::uint64_t key, GltfModelCpuData &out) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    auto it = mCompletedModels.find(key);
+    if (it == mCompletedModels.end()) return false;
+    out = std::move(it->second);
+    mCompletedModels.erase(it);
+    return true;
+  }
+
+  bool PopAnyCompletedArena(int &outBiome, GltfArenaCpuData &out) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mCompletedArenas.empty()) return false;
+    auto it = mCompletedArenas.begin();
+    outBiome = it->first;
+    out = std::move(it->second);
+    mCompletedArenas.erase(it);
+    return true;
+  }
+
+  bool PopAnyCompletedModel(std::uint64_t &outKey, GltfModelCpuData &out) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mCompletedModels.empty()) return false;
+    auto it = mCompletedModels.begin();
+    outKey = it->first;
+    out = std::move(it->second);
+    mCompletedModels.erase(it);
+    return true;
+  }
+
+  bool PopAnyCompletedActor(int &outKind, GltfModelCpuData &out) {
+    std::lock_guard<std::mutex> lock(mMutex);
+    if (mCompletedActors.empty()) return false;
+    auto it = mCompletedActors.begin();
+    outKind = it->first;
+    out = std::move(it->second);
+    mCompletedActors.erase(it);
+    return true;
+  }
+
+  void Shutdown() {
+    {
+      std::lock_guard<std::mutex> lock(mMutex);
+      mStop = true;
+      mJobs.clear();
+      mInFlightArenas.clear();
+      mInFlightModels.clear();
+      mInFlightActors.clear();
+      mCompletedArenas.clear();
+      mCompletedModels.clear();
+      mCompletedActors.clear();
+    }
+    mCv.notify_all();
+    if (mWorker.joinable()) {
+      mWorker.join();
+    }
+    std::lock_guard<std::mutex> lock(mMutex);
+    mStop = false;
+  }
+
+ private:
+  enum class JobKind : std::uint8_t { Arena, Model, Actor };
+  struct Job {
+    JobKind kind;
+    std::uint64_t key;
+    std::string path;
+  };
+
+  void StartWorkerLocked() {
+    if (mWorker.joinable()) return;
+    mStop = false;
+    mWorker = std::thread([this]() { WorkerLoop(); });
+  }
+
+  void WorkerLoop() {
+    for (;;) {
+      Job job{};
+      {
+        std::unique_lock<std::mutex> lock(mMutex);
+        mCv.wait(lock, [this]() { return mStop || !mJobs.empty(); });
+        if (mStop) return;
+        job = std::move(mJobs.front());
+        mJobs.pop_front();
+      }
+
+      if (job.kind == JobKind::Arena) {
+        GltfArenaCpuData cpu;
+        const bool ok = LoadGltfArenaCpu(job.path, cpu);
+        const int biome = static_cast<int>(job.key);
+        if (!ok) {
+          std::lock_guard<std::mutex> plock(gProbeMutex);
+          gFailedArenas.insert(biome);
+        }
+        std::lock_guard<std::mutex> lock(mMutex);
+        mInFlightArenas.erase(biome);
+        if (ok && !mStop) {
+          mCompletedArenas[biome] = std::move(cpu);
+        }
+      } else if (job.kind == JobKind::Model) {
+        GltfModelCpuData cpu;
+        const bool ok = LoadGltfModelCpu(job.path, cpu);
+        if (ok) {
+          RecordModelCpuMetadata(job.key, cpu);
+        } else {
+          std::lock_guard<std::mutex> plock(gProbeMutex);
+          gFailedModels.insert(job.key);
+        }
+        std::lock_guard<std::mutex> lock(mMutex);
+        mInFlightModels.erase(job.key);
+        if (ok && !mStop) {
+          mCompletedModels[job.key] = std::move(cpu);
+        }
+      } else {
+        GltfModelCpuData cpu;
+        const bool ok = LoadGltfModelCpu(job.path, cpu);
+        const int kind = static_cast<int>(job.key);
+        if (!ok) {
+          std::lock_guard<std::mutex> plock(gProbeMutex);
+          gFailedActors.insert(kind);
+        }
+        std::lock_guard<std::mutex> lock(mMutex);
+        mInFlightActors.erase(kind);
+        if (ok && !mStop) {
+          mCompletedActors[kind] = std::move(cpu);
+        }
+      }
+    }
+  }
+
+  std::mutex mMutex;
+  std::condition_variable mCv;
+  std::thread mWorker;
+  bool mStop = false;
+  std::deque<Job> mJobs;
+  std::unordered_set<int> mInFlightArenas;
+  std::unordered_set<std::uint64_t> mInFlightModels;
+  std::unordered_set<int> mInFlightActors;
+  std::unordered_map<int, GltfArenaCpuData> mCompletedArenas;
+  std::unordered_map<std::uint64_t, GltfModelCpuData> mCompletedModels;
+  std::unordered_map<int, GltfModelCpuData> mCompletedActors;
+};
+
+GlbAsyncLoader gAsyncLoader;
+
+// Fast boolean probe returning whether model exists on disk (zero std::string copy on hit).
+// In interactive mode, also kicks off async background load on first positive probe.
+bool HasModelFast(int species, int form, int isShiny, bool triggerAsyncPrefetch) {
+  if (species <= 0 || species > 9999 || form < 0 || form > 99) return false;
+  const std::uint64_t key = MakeModelKey(species, form, isShiny);
+  std::string prefetchPath;
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    if (gFailedModels.count(key) != 0) return false;
+    auto it = gModelProbeCache.find(key);
+    if (it != gModelProbeCache.end()) {
+      if (!it->second.exists) return false;
+      if (triggerAsyncPrefetch && !SIM_Headless_Enabled() && gReadyModels.count(key) == 0) {
+        prefetchPath = it->second.path;
+      } else {
+        return true;
+      }
+    }
+  }
+  if (!prefetchPath.empty()) {
+    gAsyncLoader.EnqueueModel(key, prefetchPath);
+    return true;
+  }
+
+  char rel[64];
+  if (isShiny) {
+    // Never substitute normal colours for a shiny battler; keep the 2D shiny sprite if absent.
+    std::snprintf(rel, sizeof(rel), "mons/pm%04d_%02d_shiny.glb", species, form);
+  } else {
+    std::snprintf(rel, sizeof(rel), "mons/pm%04d_%02d.glb", species, form);
+  }
+  std::string found = ProbeBdspAssetPath(rel);
+  const bool exists = !found.empty();
+  bool shouldPrefetch = false;
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    if (gFailedModels.count(key) != 0) return false;
+    gModelProbeCache[key] = {exists, found};
+    shouldPrefetch = exists && triggerAsyncPrefetch && !SIM_Headless_Enabled() && gReadyModels.count(key) == 0;
+  }
+  if (shouldPrefetch) {
+    gAsyncLoader.EnqueueModel(key, found);
+  }
+  return exists;
+}
+
+std::string ResolveModelPath(int species, int form, int isShiny) {
+  if (!HasModelFast(species, form, isShiny, false)) return "";
+  const std::uint64_t key = MakeModelKey(species, form, isShiny);
+  std::lock_guard<std::mutex> lock(gProbeMutex);
+  if (gFailedModels.count(key) != 0) return "";
+  auto it = gModelProbeCache.find(key);
+  return (it != gModelProbeCache.end() && it->second.exists) ? it->second.path : "";
+}
+
+bool HasArenaFast(int biome) {
+  if (biome < 0 || biome >= SIM_BATTLE3D_BIOME_COUNT) return false;
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    if (gFailedArenas.count(biome) != 0) return false;
+    auto it = gArenaProbeCache.find(biome);
+    if (it != gArenaProbeCache.end()) return it->second.exists;
+  }
+  std::string rel = std::string("arenas/") + kBiomeStems[biome] + ".glb";
+  std::string found = ProbeBdspAssetPath(rel);
+  const bool exists = !found.empty();
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    if (gFailedArenas.count(biome) != 0) return false;
+    gArenaProbeCache[biome] = {exists, std::move(found)};
+  }
+  return exists;
+}
+
+std::string ResolveArenaPath(int biome) {
+  if (!HasArenaFast(biome)) return "";
+  std::lock_guard<std::mutex> lock(gProbeMutex);
+  if (gFailedArenas.count(biome) != 0) return "";
+  auto it = gArenaProbeCache.find(biome);
+  return (it != gArenaProbeCache.end() && it->second.exists) ? it->second.path : "";
+}
+
+bool HasActorFast(int kind, bool triggerAsyncPrefetch) {
+  const char *rel = nullptr;
+  switch (kind) {
+    case SIM_BATTLE3D_ACTOR_TRAINER_LUCAS:
+      rel = "trainers/pc0001_00.glb";
+      break;
+    case SIM_BATTLE3D_ACTOR_TRAINER_DAWN:
+      rel = "trainers/pc0002_00.glb";
+      break;
+    case SIM_BATTLE3D_ACTOR_POKEBALL:
+      rel = "trainers/pokeball.glb";
+      break;
+    default:
+      return false;
+  }
+  std::string prefetchPath;
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    if (gFailedActors.count(kind) != 0) return false;
+    auto it = gActorProbeCache.find(kind);
+    if (it != gActorProbeCache.end()) {
+      if (!it->second.exists) return false;
+      if (triggerAsyncPrefetch && !SIM_Headless_Enabled()) {
+        prefetchPath = it->second.path;
+      } else {
+        return true;
+      }
+    }
+  }
+  if (!prefetchPath.empty()) {
+    gAsyncLoader.EnqueueActor(kind, prefetchPath);
+    return true;
+  }
+
+  std::string found = ProbeBdspAssetPath(rel);
+  const bool exists = !found.empty();
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    if (gFailedActors.count(kind) != 0) return false;
+    gActorProbeCache[kind] = {exists, found};
+  }
+  if (exists && triggerAsyncPrefetch && !SIM_Headless_Enabled()) {
+    gAsyncLoader.EnqueueActor(kind, found);
+  }
+  return exists;
+}
+
+std::string ResolveActorPath(int kind) {
+  if (!HasActorFast(kind, false)) return "";
+  std::lock_guard<std::mutex> lock(gProbeMutex);
+  if (gFailedActors.count(kind) != 0) return "";
+  auto it = gActorProbeCache.find(kind);
+  return (it != gActorProbeCache.end() && it->second.exists) ? it->second.path : "";
+}
+
+// P3: Extract 6 clip-space frustum planes from column-major matrix (Zero-to-One NDC: x,y in [-w,w], z in [0,w]).
+void ExtractFrustumPlanesZO(const float m[16], float planes[6][4]) {
+  auto row = [&](int r, int c) { return m[c * 4 + r]; };
+  for (int c = 0; c < 4; c++) {
+    planes[0][c] = row(3, c) + row(0, c); // Left:   x + w >= 0
+    planes[1][c] = row(3, c) - row(0, c); // Right:  w - x >= 0
+    planes[2][c] = row(3, c) + row(1, c); // Bottom: y + w >= 0
+    planes[3][c] = row(3, c) - row(1, c); // Top:    w - y >= 0
+    planes[4][c] = row(2, c);             // Near:   z >= 0 (ZO)
+    planes[5][c] = row(3, c) - row(2, c); // Far:    w - z >= 0
+  }
+}
+
+bool AabbIntersectsFrustum(const float bmin[3], const float bmax[3], const float planes[6][4]) {
+  for (int i = 0; i < 6; i++) {
+    const float a = planes[i][0];
+    const float b = planes[i][1];
+    const float c = planes[i][2];
+    const float d = planes[i][3];
+    const float px = (a >= 0.0f) ? bmax[0] : bmin[0];
+    const float py = (b >= 0.0f) ? bmax[1] : bmin[1];
+    const float pz = (c >= 0.0f) ? bmax[2] : bmin[2];
+    if (a * px + b * py + c * pz + d < 0.0f) {
+      return false;
+    }
+  }
+  return true;
+}
+
+// Identity joint palette for rigid primitives that still bind vertex uniform buffer 1.
+const SkinnedJointsUniforms &IdentityJointsUniforms() {
+  static const SkinnedJointsUniforms kIdent = []() {
+    SkinnedJointsUniforms u{};
+    for (std::uint32_t j = 0; j < kMaxGltfJoints; j++) {
+      u.joints[j * 16 + 0] = 1.0f;
+      u.joints[j * 16 + 5] = 1.0f;
+      u.joints[j * 16 + 10] = 1.0f;
+      u.joints[j * 16 + 15] = 1.0f;
+    }
+    return u;
+  }();
+  return kIdent;
+}
+
+void Mat4BattlerTransform(float out[16], float x, float y, float z, float yawDeg, float scale) {
+  const float rad = yawDeg * (kPi / 180.0f);
+  const float c = std::cos(rad);
+  const float s = std::sin(rad);
+  const float sc = (scale > 0.001f) ? scale : 1.0f;
+  std::memset(out, 0, sizeof(float) * 16);
+  out[0] = c * sc;   out[2] = -s * sc;
+  out[5] = sc;
+  out[8] = s * sc;   out[10] = c * sc;
+  out[12] = x;       out[13] = y;       out[14] = z;       out[15] = 1.0f;
+}
+
+void Mat4ActorTransform(float out[16], float x, float y, float z,
+                        float yawDeg, float pitchDeg, float rollDeg, float scale) {
+  const float sc = (scale > 0.001f) ? scale : 1.0f;
+  const float yr = yawDeg * (kPi / 180.0f);
+  const float pr = pitchDeg * (kPi / 180.0f);
+  const float rr = rollDeg * (kPi / 180.0f);
+  const float cy = std::cos(yr), sy = std::sin(yr);
+  const float cp = std::cos(pr), sp = std::sin(pr);
+  const float cr = std::cos(rr), sr = std::sin(rr);
+
+  // R = Ry(yaw) * Rx(pitch) * Rz(roll), column-major
+  const float r00 = cy * cr + sy * sp * sr;
+  const float r10 = cp * sr;
+  const float r20 = -sy * cr + cy * sp * sr;
+
+  const float r01 = -cy * sr + sy * sp * cr;
+  const float r11 = cp * cr;
+  const float r21 = sy * sr + cy * sp * cr;
+
+  const float r02 = sy * cp;
+  const float r12 = -sp;
+  const float r22 = cy * cp;
+
+  out[0] = r00 * sc; out[1] = r10 * sc; out[2] = r20 * sc; out[3] = 0.0f;
+  out[4] = r01 * sc; out[5] = r11 * sc; out[6] = r21 * sc; out[7] = 0.0f;
+  out[8] = r02 * sc; out[9] = r12 * sc; out[10] = r22 * sc; out[11] = 0.0f;
+  out[12] = x;       out[13] = y;       out[14] = z;       out[15] = 1.0f;
+}
+
+std::string ExeDir() {
+  char buf[PATH_MAX];
+#ifdef __APPLE__
+  uint32_t sz = sizeof(buf);
+  if (_NSGetExecutablePath(buf, &sz) == 0) {
+    char resolved[PATH_MAX];
+    if (realpath(buf, resolved)) {
+      std::string s(resolved);
+      std::size_t slash = s.find_last_of('/');
+      return slash == std::string::npos ? "" : s.substr(0, slash);
+    }
+  }
+#endif
+  return "";
+}
+
+void Mat4Mul(float out[16], const float a[16], const float b[16]) {
+  float r[16];
+  for (int c = 0; c < 4; c++) {
+    for (int row = 0; row < 4; row++) {
+      r[c * 4 + row] = a[0 * 4 + row] * b[c * 4 + 0] +
+                       a[1 * 4 + row] * b[c * 4 + 1] +
+                       a[2 * 4 + row] * b[c * 4 + 2] +
+                       a[3 * 4 + row] * b[c * 4 + 3];
+    }
+  }
+  std::memcpy(out, r, sizeof(r));
+}
+
+void Vec3Normalize(float v[3]) {
+  float len = std::sqrt(v[0] * v[0] + v[1] * v[1] + v[2] * v[2]);
+  if (len > 1e-6f) {
+    v[0] /= len;
+    v[1] /= len;
+    v[2] /= len;
+  } else {
+    v[0] = 0.0f;
+    v[1] = 1.0f;
+    v[2] = 0.0f;
+  }
+}
+
+void Vec3Cross(float out[3], const float a[3], const float b[3]) {
+  out[0] = a[1] * b[2] - a[2] * b[1];
+  out[1] = a[2] * b[0] - a[0] * b[2];
+  out[2] = a[0] * b[1] - a[1] * b[0];
+}
+
+float Vec3Dot(const float a[3], const float b[3]) {
+  return a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+}
+
+// Right-handed LookAt (column-major, OpenGL/Metal math convention).
+void Mat4LookAtRH(float out[16], const float eye[3], const float target[3], const float up[3]) {
+  float f[3] = {target[0] - eye[0], target[1] - eye[1], target[2] - eye[2]};
+  Vec3Normalize(f);
+  float s[3];
+  Vec3Cross(s, f, up);
+  Vec3Normalize(s);
+  float u[3];
+  Vec3Cross(u, s, f);
+
+  std::memset(out, 0, sizeof(float) * 16);
+  out[0] = s[0];  out[4] = s[1];  out[8]  = s[2];  out[12] = -Vec3Dot(s, eye);
+  out[1] = u[0];  out[5] = u[1];  out[9]  = u[2];  out[13] = -Vec3Dot(u, eye);
+  out[2] = -f[0]; out[6] = -f[1]; out[10] = -f[2]; out[14] =  Vec3Dot(f, eye);
+  out[3] = 0.0f;  out[7] = 0.0f;  out[11] = 0.0f;  out[15] = 1.0f;
+}
+
+// Right-handed Perspective with Zero-to-One NDC depth (Metal/Vulkan).
+void Mat4PerspectiveRH_ZO(float out[16], float fovyDeg, float aspect, float zNear, float zFar) {
+  float fovyRad = fovyDeg * (kPi / 180.0f);
+  float f = 1.0f / std::tan(fovyRad * 0.5f);
+  std::memset(out, 0, sizeof(float) * 16);
+  out[0] = f / (aspect > 0.01f ? aspect : (16.0f / 9.0f));
+  out[5] = f;
+  out[10] = zFar / (zNear - zFar);
+  out[11] = -1.0f;
+  out[14] = (zNear * zFar) / (zNear - zFar);
+}
+
+// Right-handed Ortho with Zero-to-One NDC depth (Metal/Vulkan).
+void Mat4OrthoRH_ZO(float out[16], float left, float right, float bottom, float top,
+                    float zNear, float zFar) {
+  std::memset(out, 0, sizeof(float) * 16);
+  out[0] = 2.0f / (right - left);
+  out[5] = 2.0f / (top - bottom);
+  out[10] = 1.0f / (zNear - zFar);
+  out[12] = -(right + left) / (right - left);
+  out[13] = -(top + bottom) / (top - bottom);
+  out[14] = zNear / (zNear - zFar);
+  out[15] = 1.0f;
+}
+
+struct AtmospherePreset {
+  float sunDir[3];
+  float sunColor[3];
+  float skyAmbient[3];
+  float groundAmbient[3];
+  float fogColor[3];
+  float shadowTint[3];
+  float shadowStrength;
+  float skyTint[3];
+  float todMode;
+  float fogStart;
+  float fogEnd;
+};
+
+AtmospherePreset BuildAtmosphere(int biome, int tod, int weather) {
+  AtmospherePreset p{};
+  // Base bright sunny Sinnoh daytime (matches BDSP Route 201/202 clearing).
+  p.sunDir[0] = 0.44f; p.sunDir[1] = 0.80f; p.sunDir[2] = 0.40f;
+  p.sunColor[0] = 1.06f; p.sunColor[1] = 1.01f; p.sunColor[2] = 0.90f;
+  p.skyAmbient[0] = 0.64f; p.skyAmbient[1] = 0.80f; p.skyAmbient[2] = 0.98f;
+  p.groundAmbient[0] = 0.50f; p.groundAmbient[1] = 0.64f; p.groundAmbient[2] = 0.38f;
+  p.fogColor[0] = 0.64f; p.fogColor[1] = 0.82f; p.fogColor[2] = 0.96f;
+  p.shadowTint[0] = 0.50f; p.shadowTint[1] = 0.62f; p.shadowTint[2] = 0.72f;
+  p.shadowStrength = 0.78f;
+  p.skyTint[0] = 1.00f; p.skyTint[1] = 1.00f; p.skyTint[2] = 1.00f;
+  p.todMode = 0.0f;
+  p.fogStart = 18.0f;
+  p.fogEnd = 62.0f;
+
+  // Time-of-day shift
+  if (tod == SIM_BATTLE3D_TOD_MORNING) {
+    p.todMode = 0.25f;
+    p.sunDir[0] = 0.60f; p.sunDir[1] = 0.68f; p.sunDir[2] = 0.42f;
+    p.sunColor[0] = 1.08f; p.sunColor[1] = 0.96f; p.sunColor[2] = 0.82f;
+    p.skyAmbient[0] = 0.66f; p.skyAmbient[1] = 0.76f; p.skyAmbient[2] = 0.96f;
+    p.fogColor[0] = 0.74f; p.fogColor[1] = 0.82f; p.fogColor[2] = 0.94f;
+    p.skyTint[0] = 1.02f; p.skyTint[1] = 0.97f; p.skyTint[2] = 0.94f;
+  } else if (tod == SIM_BATTLE3D_TOD_EVENING) {
+    p.todMode = 0.50f;
+    p.sunDir[0] = -0.62f; p.sunDir[1] = 0.46f; p.sunDir[2] = -0.64f;
+    p.sunColor[0] = 1.12f; p.sunColor[1] = 0.72f; p.sunColor[2] = 0.46f;
+    p.skyAmbient[0] = 0.56f; p.skyAmbient[1] = 0.48f; p.skyAmbient[2] = 0.72f;
+    p.groundAmbient[0] = 0.52f; p.groundAmbient[1] = 0.42f; p.groundAmbient[2] = 0.34f;
+    p.fogColor[0] = 0.86f; p.fogColor[1] = 0.60f; p.fogColor[2] = 0.48f;
+    p.shadowTint[0] = 0.44f; p.shadowTint[1] = 0.38f; p.shadowTint[2] = 0.60f;
+    p.skyTint[0] = 1.05f; p.skyTint[1] = 0.78f; p.skyTint[2] = 0.68f;
+  } else if (tod == SIM_BATTLE3D_TOD_NIGHT) {
+    p.todMode = 1.0f;
+    p.sunDir[0] = -0.45f; p.sunDir[1] = 0.78f; p.sunDir[2] = 0.42f;
+    p.sunColor[0] = 0.88f; p.sunColor[1] = 0.96f; p.sunColor[2] = 1.18f;
+    p.skyAmbient[0] = 0.42f; p.skyAmbient[1] = 0.54f; p.skyAmbient[2] = 0.78f;
+    p.groundAmbient[0] = 0.30f; p.groundAmbient[1] = 0.40f; p.groundAmbient[2] = 0.52f;
+    p.fogColor[0] = 0.22f; p.fogColor[1] = 0.32f; p.fogColor[2] = 0.56f;
+    p.shadowTint[0] = 0.28f; p.shadowTint[1] = 0.38f; p.shadowTint[2] = 0.58f;
+    p.shadowStrength = 0.55f;
+    p.skyTint[0] = 0.34f; p.skyTint[1] = 0.40f; p.skyTint[2] = 0.62f;
+    p.fogStart = 15.0f;
+    p.fogEnd = 58.0f;
+  }
+
+  // Biome-specific overrides
+  if (biome == SIM_BATTLE3D_BIOME_CAVE) {
+    p.todMode = 0.0f;
+    p.sunDir[0] = 0.20f; p.sunDir[1] = 0.94f; p.sunDir[2] = 0.26f;
+    p.sunColor[0] = 0.76f; p.sunColor[1] = 0.80f; p.sunColor[2] = 0.94f;
+    p.skyAmbient[0] = 0.32f; p.skyAmbient[1] = 0.36f; p.skyAmbient[2] = 0.48f;
+    p.groundAmbient[0] = 0.24f; p.groundAmbient[1] = 0.22f; p.groundAmbient[2] = 0.26f;
+    p.fogColor[0] = 0.16f; p.fogColor[1] = 0.18f; p.fogColor[2] = 0.26f;
+    p.fogStart = 12.0f;
+    p.fogEnd = 42.0f;
+    p.skyTint[0] = 0.80f; p.skyTint[1] = 0.82f; p.skyTint[2] = 0.92f;
+  } else if (biome == SIM_BATTLE3D_BIOME_SNOW) {
+    p.groundAmbient[0] = 0.68f; p.groundAmbient[1] = 0.76f; p.groundAmbient[2] = 0.88f;
+    p.fogColor[0] = 0.78f; p.fogColor[1] = 0.86f; p.fogColor[2] = 0.96f;
+    p.fogStart = 16.0f;
+    p.fogEnd = 52.0f;
+  } else if (biome == SIM_BATTLE3D_BIOME_FOREST) {
+    if (tod != SIM_BATTLE3D_TOD_NIGHT && tod != SIM_BATTLE3D_TOD_EVENING) {
+      p.fogColor[0] = 0.44f; p.fogColor[1] = 0.64f; p.fogColor[2] = 0.68f;
+    }
+    p.fogStart = 14.0f;
+    p.fogEnd = 52.0f;
+  } else if (biome == SIM_BATTLE3D_BIOME_INDOORS) {
+    p.todMode = 0.0f;
+    p.sunDir[0] = 0.15f; p.sunDir[1] = 0.96f; p.sunDir[2] = 0.22f;
+    p.sunColor[0] = 0.98f; p.sunColor[1] = 0.98f; p.sunColor[2] = 1.00f;
+    p.skyAmbient[0] = 0.66f; p.skyAmbient[1] = 0.70f; p.skyAmbient[2] = 0.78f;
+    p.groundAmbient[0] = 0.54f; p.groundAmbient[1] = 0.56f; p.groundAmbient[2] = 0.60f;
+    p.fogColor[0] = 0.76f; p.fogColor[1] = 0.80f; p.fogColor[2] = 0.86f;
+    p.fogStart = 24.0f;
+    p.fogEnd = 70.0f;
+    p.skyTint[0] = 1.0f; p.skyTint[1] = 1.0f; p.skyTint[2] = 1.0f;
+  } else if (biome == SIM_BATTLE3D_BIOME_DISTORTION) {
+    p.todMode = 0.0f;
+    p.sunDir[0] = -0.35f; p.sunDir[1] = 0.82f; p.sunDir[2] = 0.45f;
+    p.sunColor[0] = 0.88f; p.sunColor[1] = 0.68f; p.sunColor[2] = 1.05f;
+    p.skyAmbient[0] = 0.44f; p.skyAmbient[1] = 0.30f; p.skyAmbient[2] = 0.66f;
+    p.groundAmbient[0] = 0.28f; p.groundAmbient[1] = 0.20f; p.groundAmbient[2] = 0.42f;
+    p.fogColor[0] = 0.24f; p.fogColor[1] = 0.14f; p.fogColor[2] = 0.38f;
+    p.fogStart = 18.0f;
+    p.fogEnd = 58.0f;
+    p.skyTint[0] = 1.0f; p.skyTint[1] = 1.0f; p.skyTint[2] = 1.0f;
+  }
+
+  // Weather modifiers
+  if (weather == SIM_BATTLE3D_WEATHER_RAIN) {
+    p.sunColor[0] *= 0.72f; p.sunColor[1] *= 0.78f; p.sunColor[2] *= 0.88f;
+    p.fogColor[0] = 0.48f; p.fogColor[1] = 0.58f; p.fogColor[2] = 0.70f;
+    p.fogStart = 12.0f;
+    p.fogEnd = 46.0f;
+    p.shadowStrength *= 0.55f;
+  } else if (weather == SIM_BATTLE3D_WEATHER_SUN) {
+    p.sunColor[0] = std::min(1.22f, p.sunColor[0] * 1.15f);
+    p.sunColor[1] = std::min(1.16f, p.sunColor[1] * 1.10f);
+    p.sunColor[2] *= 0.96f;
+    p.shadowStrength = std::min(0.90f, p.shadowStrength * 1.12f);
+  } else if (weather == SIM_BATTLE3D_WEATHER_SAND) {
+    p.fogColor[0] = 0.80f; p.fogColor[1] = 0.68f; p.fogColor[2] = 0.48f;
+    p.fogStart = 10.0f;
+    p.fogEnd = 40.0f;
+  } else if (weather == SIM_BATTLE3D_WEATHER_HAIL) {
+    p.fogColor[0] = 0.72f; p.fogColor[1] = 0.82f; p.fogColor[2] = 0.94f;
+    p.fogStart = 12.0f;
+    p.fogEnd = 44.0f;
+  } else if (weather == SIM_BATTLE3D_WEATHER_FOG) {
+    p.fogStart = 8.0f;
+    p.fogEnd = 34.0f;
+    p.shadowStrength *= 0.50f;
+  }
+
+  Vec3Normalize(p.sunDir);
+  return p;
+}
