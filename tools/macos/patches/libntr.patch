diff --git a/include/simulator/sim_layout.h b/include/simulator/sim_layout.h
new file mode 100644
index 0000000..fff9405
--- /dev/null
+++ b/include/simulator/sim_layout.h
@@ -0,0 +1,103 @@
+#ifndef SIMULATOR_SIM_LAYOUT_H
+#define SIMULATOR_SIM_LAYOUT_H
+
+// Wide-layout scene API (phase 2, step 1). The game tells the simulator
+// which scene kind is active; the simulator picks the composite from it.
+// See wide-OUT/API.md for the full contract. C header, no nitro.h
+// dependency; booleans are int (0 = false, non-zero = true).
+//
+// The game calls these unconditionally. When ScreenLayout is not wide
+// the calls only record state and change nothing on screen.
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    SIM_LAYOUT_SCENE_UNKNOWN = 0, // No scene set yet; renders as FIELD.
+    SIM_LAYOUT_SCENE_FIELD   = 1, // Overworld / field.
+    SIM_LAYOUT_SCENE_BATTLE  = 2, // Battle.
+    SIM_LAYOUT_SCENE_MENU    = 3, // Any full-screen app using both screens.
+    SIM_LAYOUT_SCENE_MENU_SINGLE = 4 // Party/summary: main screen only + panel.
+} SIM_Layout_Scene;
+
+// Which scene is active. Call at transitions (entry/exit), NOT per frame.
+// Idempotent. Game thread only (the thread that runs SIM_Render); never
+// from an interrupt handler. Resets the panel state: FIELD starts
+// closed, BATTLE follows the battle-touch hint, MENU has no panel.
+void SIM_Layout_SetScene(SIM_Layout_Scene scene);
+SIM_Layout_Scene SIM_Layout_GetScene(void);
+
+// Opt-in native width for the main engine's 2D layers. Zero keeps the
+// normal 256-pixel centred 4:3 presentation; values above 256 (up to 384)
+// expose that many square DS pixels across the wide viewport. Scene changes
+// always reset this, so a wide application cannot leak into another screen.
+void SIM_Layout_SetWide2DWidth(int widthPx);
+int SIM_Layout_GetWide2DWidth(void);
+
+// 1 when the wide layout is actually in effect: ScreenLayout=wide AND
+// the GPU renderer is active. 0 under Renderer=gl (wide falls back to
+// the classic vertical layout), under any other layout, and before the
+// simulator has selected a renderer. Widegame gates ALL wide behaviour
+// on this.
+int SIM_Layout_IsWide(void);
+
+// Wide aspect ratio the game uses for its cameras when IsWide() is 1.
+// Currently exactly 16/9.
+float SIM_Layout_GetWideAspect(void);
+
+// Battle only. 1 while the battle awaits touch/menu input on the bottom
+// screen, 0 while it is top-screen-only. Drives the auto-show of the
+// docked bottom-screen panel in BATTLE. A 0 -> 1 transition clears a
+// manual Tab-close. Ignored in other scenes. Default 0.
+void SIM_Layout_SetBattleTouchNeeded(int needsTouch);
+
+// Force the sub-screen panel open (1) or closed (0). In FIELD and
+// MENU_SINGLE this is the slide-in panel; in BATTLE it overrides the
+// auto-show. No-op in MENU (both screens are already visible).
+void SIM_Layout_SetPanelOpen(int open);
+
+// Effective panel visibility: FIELD/MENU_SINGLE follow SetPanelOpen,
+// BATTLE is SetPanelOpen OR (battle-touch needed AND not manually
+// closed), MENU is always closed.
+int SIM_Layout_IsPanelOpen(void);
+
+// Panel geometry, normalised window coordinates (top-left origin,
+// window = 1 x 1). Returns 0 when no panel is visible. The simulator
+// updates the stored rect every frame from its view and animation.
+int SIM_Layout_GetPanelRect(float *x, float *y, float *w, float *h);
+
+// Main-screen touch (battlehud hook): opt-in routing of clicks on the
+// MAIN (top) screen area to the game, separate from the sub-screen TP
+// registers. Disabled by default; when disabled, main-area clicks keep
+// their classic behaviour (not touch). Coordinates are main-screen DS
+// pixels (x is 0..Wide2DWidth-1 when enabled, otherwise 0..255; y is
+// 0..191). GetMainTouch returns 1 once per click.
+void SIM_Layout_SetMainTouchEnabled(int enabled);
+int SIM_Layout_GetMainTouch(int *x, int *y);
+int SIM_Layout_GetMainTouchHeld(int *x, int *y);
+
+// --- Simulator-internal: called by sim_main, not by the game. ---
+// Informs this module whether the wide layout is in effect (set once
+// in SIM_RenderInit, after the render backend is selected).
+void SIM_Layout_SetWideEnabled(int enabled);
+// Stores the panel rect computed for the current frame.
+void SIM_Layout_SetPanelRect(int visible, float x, float y, float w, float h);
+// battlehud hook: main-screen rect (normalised) + click injection.
+void SIM_Layout_SetMainRect(int visible, float x, float y, float w, float h);
+void SIM_Layout_PushMainTouch(int x, int y);
+void SIM_Layout_SetMainTouchHeld(int held, int x, int y);
+int SIM_Layout_MainTouchEnabled(void);
+// Stores the tab-handle rect computed for the current frame (normalised
+// window coordinates); the simulator draws the handle there.
+void SIM_Layout_SetTabIconRect(int visible, float x, float y, float w, float h);
+int SIM_Layout_GetTabIconRect(float *x, float *y, float *w, float *h);
+// Close handle for the open panel (mirror of the tab handle).
+void SIM_Layout_SetCloseIconRect(int visible, float x, float y, float w, float h);
+int SIM_Layout_GetCloseIconRect(float *x, float *y, float *w, float *h);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/include/simulator/sim_lights.h b/include/simulator/sim_lights.h
new file mode 100644
index 0000000..d74d532
--- /dev/null
+++ b/include/simulator/sim_lights.h
@@ -0,0 +1,56 @@
+#ifndef SIMULATOR_SIM_LIGHTS_H
+#define SIMULATOR_SIM_LIGHTS_H
+
+// Scene lights (phase 2, lighting lane). The game tells the simulator
+// which lights are active for the current frame; the SDL GPU G3
+// renderer adds them per-pixel in the G3 fragment shader. The GL
+// backend ignores them (GPU-only feature, a no-op under Renderer=gl).
+//
+// Coordinates: point-light positions are in G3 clip space (NDC),
+// x in [-1, 1] left to right, y in [-1, 1] bottom to top, for the
+// screen the G3 frame draws into. Radius is in the same NDC units.
+// Colours and intensities are 0..1 floats (intensity may exceed 1 for
+// a flash). Lights only ADD light: with the default state (ambient
+// 1,1,1, no point lights, rim 0) the shader output is bit-identical
+// to the unlit output.
+//
+// The game calls these unconditionally per frame it wants lights.
+// Game thread only. The state is per-frame: the renderer reads the
+// state latched at replay time, so a call made during a frame applies
+// to that frame's G3 draws.
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SIM_LIGHTS_MAX 4
+
+typedef struct {
+    float x;         // NDC x, [-1, 1]
+    float y;         // NDC y, [-1, 1] (bottom to top)
+    float radius;    // NDC falloff radius, > 0
+    float intensity; // 0 = off; 1 = full
+    float r, g, b;   // light colour, 0..1
+} SIM_Light;
+
+typedef struct {
+    float ambientR, ambientG, ambientB; // multiplies the base colour; 1,1,1 = neutral
+    float keyDirX, keyDirY;             // direction TO the key light, screen space, need not be unit
+    float keyR, keyG, keyB;             // key (rim) light colour, 0..1
+    float rimStrength;                  // 0 = no rim; ~0.35 = a thin bright edge
+    int count;                          // point lights in use, 0..SIM_LIGHTS_MAX
+    SIM_Light lights[SIM_LIGHTS_MAX];
+} SIM_LightsState;
+
+// Replaces the whole light state for the current frame.
+void SIM_Lights_Set(const SIM_LightsState *state);
+// Clears the state (ambient 1,1,1, no lights, no rim).
+void SIM_Lights_Clear(void);
+// Reads the current state (for the renderer). Returns 0 when state is NULL.
+int SIM_Lights_Get(SIM_LightsState *state);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
