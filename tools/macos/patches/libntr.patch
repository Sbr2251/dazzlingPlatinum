+static bool CaseIntegerStorageBuffer16(Device &d) {
+    // 16-bit words packed two per uint: low word = i * 1000, high word = i * 2000.
+    SDL_GPUBuffer *buf = d.CreateBuffer(SDL_GPU_BUFFERUSAGE_GRAPHICS_STORAGE_READ, 16 * 4, "selftest-ssbo16");
+    CHECK(buf, "storage buffer create");
+    Uint32 data[16];
+    for (int i = 0; i < 16; i++) data[i] = (Uint32)(i * 1000) | ((Uint32)(i * 2000) << 16);
+    RenderTarget target;
+    CHECK(target.Create(d, 4, 4, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, false, "selftest-ssbo16-target"), "target create");
+    Frame *f = d.BeginFrame();
+    CHECK(f, "BeginFrame");
+    f->UploadBuffer(buf, 0, data, sizeof data);
+    CHECK(f->BeginPass(Phase::Scene3D, PassDesc::Color(target.Color().Handle())), "BeginPass");
+    f->BindPipeline(Pipe(d, test_textured_vert, test_ssbo16_frag, TexturedLayout()));
+    f->SetViewport(FullViewport(4, 4));
+    f->BindFragmentStorageBuffer(0, buf);
+    FullscreenUvQuad(f);
+    f->EndPass();
+    CHECK(f->End(), "End");
+    std::vector<Uint8> px;
+    CHECK(d.ReadbackRGBA8(target.Color(), px), "readback");
+    // v / 65535 * 255: texel 1 -> (4, 8), texel 15 -> (58, 116).
+    CHECK(PixelEq(px, 4, 0, 0, 0, 0, 0, 255), "ssbo16 texel (0,0) is not (0,0)");
+    CHECK(PixelNear(px, 4, 1, 0, 4, 8, 0, 255, 1), "ssbo16 texel (1,0) is not ~(4,8)");
+    CHECK(PixelNear(px, 4, 3, 3, 58, 116, 0, 255, 1), "ssbo16 texel (3,3) is not ~(58,116)");
+    SDL_ReleaseGPUBuffer(d.Handle(), buf);
+    return true;
+}
