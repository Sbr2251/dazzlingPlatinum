+    if ((vc & 0x80) && mst == 1) bgAlias = (u8 *)s_HW_BG_VRAM + ofs + destOfs;
+    if ((vc & 0x80) && mst == 4) subBgAlias = (u8 *)s_HW_DB_BG_VRAM + destOfs;
+    if (!bgAlias) {
+      // Not BG-mapped yet: the game maps it right after capturing. Use the
+      // layouts the capture users set up (C as the second 128K of a 256K
+      // main BG, A at 0) unless another bank already owns that BG range.
+      int want = destBank == 0 ? 0 : destBank == 2 ? 0x20000 : -1;
+      if (want >= 0) {
+        bool covered = false;
+        for (int b = 0; b < 4; b++) {
+          u8 o = vramcnt[b];
+          if ((o & 0x80) && (o & 7) == 1) {
+            int oo = ((o >> 3) & 3) * 0x20000;
+            if (want >= oo && want < oo + 0x20000) covered = true;
+          }
+        }
+        if (!covered) bgAlias = (u8 *)s_HW_BG_VRAM + want + destOfs;
+      }
+    }
+  }
