+void FxHudHD::Prepare(Device &device, Frame *frame,
+                      std::uint32_t targetW, std::uint32_t targetH,
+                      float viewU0, float viewV0, float viewU1, float viewV1) {
+  mTargetW = std::max<std::uint32_t>(1, targetW);
+  mTargetH = std::max<std::uint32_t>(1, targetH);
+
+  if (viewU1 > viewU0 && viewV1 > viewV0) {
+    mViewX = viewU0 * static_cast<float>(mTargetW);
+    mViewW = (viewU1 - viewU0) * static_cast<float>(mTargetW);
+    mViewY = (1.0f - viewV1) * static_cast<float>(mTargetH);
+    mViewH = (viewV1 - viewV0) * static_cast<float>(mTargetH);
+  } else {
+    mViewX = 0.0f;
+    mViewY = 0.0f;
+    mViewW = static_cast<float>(mTargetW);
+    mViewH = static_cast<float>(mTargetH);
+  }
+
+  mShouldDraw = false;
+  const char *demoEnv = std::getenv("SIM_HUDHD_DEMO");
+  if (demoEnv && demoEnv[0] >= '1' && demoEnv[0] <= '4') {
+    BuildDemoFrame(demoEnv[0] - '0');
+    mShouldDraw = true;
+  } else {
+    std::lock_guard<std::mutex> lock(gStateMutex);
+    // P1: Raise stale frame drop threshold from 2 to 6 frames so brief stalls never blink the HUD.
+    if (gFramesSinceSubmit < 6 && gSharedFrame.active != 0) {
+      mLatched = gSharedFrame;
+      mShouldDraw = true;
+    }
+    if (gFramesSinceSubmit < 100) {
+      ++gFramesSinceSubmit;
+    }
+  }
+
+  if (!mShouldDraw) {
+    for (auto &ca : mCardAnim) ca.wasVisible = false;
+    for (auto &ba : mBtnAnim) ba.wasVisible = false;
+    for (auto &ma : mMoveAnim) ma.wasVisible = false;
+    mLastPrepareTicks = 0;
+    return;
+  }
+
+  const float cw = mLatched.canvasW > 1.0f ? mLatched.canvasW : 342.0f;
+  const float ch = mLatched.canvasH > 1.0f ? mLatched.canvasH : 192.0f;
+  mScaleX = mViewW / cw;
+  mScaleY = mViewH / ch;
+
+  const float bakePx = std::clamp(std::round(11.5f * mScaleY), 20.0f, 80.0f);
+  EnsureAtlas(device, frame, bakePx);
+  mUiAtlas.EnsureLoaded(device, frame);
+
+  const bool headless = SIM_Headless_Enabled() != 0;
+  // P9: dt-scaled easing interactively (frame-rate independent on 120Hz ProMotion),
+  // deterministic 1/60s in headless mode.
+  float dt = 1.0f / 60.0f;
+  if (headless) {
+    mTimeSec = 0.0f;
+    mLastPrepareTicks = 0;
+  } else {
+    const Uint64 nowMs = SDL_GetTicks();
+    mTimeSec = static_cast<float>(nowMs) * 0.001f;
+    if (mLastPrepareTicks != 0 && nowMs >= mLastPrepareTicks) {
+      dt = std::clamp(static_cast<float>(nowMs - mLastPrepareTicks) * 0.001f, 0.0f, 0.1f);
+    }
+    mLastPrepareTicks = nowMs;
+  }
+  const float dt60 = dt * 60.0f;
+  const float hpLerp = 1.0f - std::pow(1.0f - 0.22f, dt60);
+  const float cardSlideStep = 0.18f * dt60;
+  const float btnSlideStep = 0.22f * dt60;
+
+  // Advance HP bar easing and slide-in animations
+  for (int i = 0; i < SIM_HUDHD_MAX_CARDS; ++i) {
+    const auto &c = mLatched.cards[i];
+    auto &a = mCardAnim[i];
+    float targetHp = std::clamp(c.hpFrac, 0.0f, 1.0f);
+    if (!c.visible) {
+      a.wasVisible = false;
+      a.slide = 0.0f;
+    } else if (!a.wasVisible || headless) {
+      a.wasVisible = true;
+      a.displayedHp = targetHp;
+      a.slide = 1.0f;
+    } else {
+      a.displayedHp += (targetHp - a.displayedHp) * hpLerp;
+      if (std::abs(targetHp - a.displayedHp) < 0.002f) a.displayedHp = targetHp;
+      a.slide = std::min(1.0f, a.slide + cardSlideStep);
+    }
+  }
+
+  for (int i = 0; i < SIM_HUDHD_MAX_BUTTONS; ++i) {
+    const auto &b = mLatched.buttons[i];
+    auto &a = mBtnAnim[i];
+    if (i >= mLatched.numButtons || !b.visible) {
+      a.wasVisible = false;
+      a.slide = 0.0f;
+    } else if (!a.wasVisible || headless) {
+      a.wasVisible = true;
+      a.slide = 1.0f;
+    } else {
+      a.slide = std::min(1.0f, a.slide + btnSlideStep);
+    }
+  }
+
+  for (int i = 0; i < SIM_HUDHD_MAX_MOVES; ++i) {
+    const auto &m = mLatched.moves[i];
+    auto &a = mMoveAnim[i];
+    if (i >= mLatched.numMoves || !m.visible) {
+      a.wasVisible = false;
+      a.slide = 0.0f;
+    } else if (!a.wasVisible || headless) {
+      a.wasVisible = true;
+      a.slide = 1.0f;
+    } else {
+      a.slide = std::min(1.0f, a.slide + btnSlideStep);
+    }
+  }
+}
+
+void FxHudHD::Render(Device &device, Frame *frame, SDL_GPUTextureFormat colorFormat) {
+  if (!mShouldDraw || !frame || !mHasAtlas) return;
+
+  PipelineKey key;
+  key.vertex = &Shaders::hudhd_vert;
+  key.fragment = &Shaders::hudhd_frag;
+  key.layout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, offsetof(HudVertex, pos));
+  key.layout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, offsetof(HudVertex, uv));
+  key.layout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, offsetof(HudVertex, colorTop));
+  key.layout.Add(3, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, offsetof(HudVertex, colorBot));
+  key.layout.Add(4, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, offsetof(HudVertex, borderColor));
+  key.layout.Add(5, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, offsetof(HudVertex, rectSize));
+  key.layout.Add(6, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, offsetof(HudVertex, params));
+  key.layout.stride = sizeof(HudVertex);
+  key.blend = Blend::Alpha;
+  key.colorFormat = colorFormat;
+  SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+  if (!pipe) return;
+
+  mVerts.clear();
+  if (mVerts.capacity() < 4096) {
+    mVerts.reserve(4096);
+  }
+  DrawBatch db{mViewX, mViewY, mScaleX, mScaleY,
+               static_cast<float>(mTargetW), static_cast<float>(mTargetH), mVerts};
+
+  auto measureTextRange = [&](const char *begin, const char *end, float canvasPt) -> float {
+    if (!begin || begin >= end || mBakedPx <= 0.0f) return 0.0f;
+    const float pxScale = (canvasPt * mScaleY) / mBakedPx;
+    float wPx = 0.0f;
+    const char *p = begin;
+    while (p < end && *p) {
+      std::uint32_t cp = NextCodepoint(p);
+      auto it = mGlyphs.find(cp);
+      if (it == mGlyphs.end()) it = mGlyphs.find('?');
+      if (it != mGlyphs.end()) wPx += it->second.advance * pxScale;
+    }
+    return wPx / mScaleX;
+  };
+
+  auto measureText = [&](const char *str, float canvasPt) -> float {
+    if (!str || mBakedPx <= 0.0f) return 0.0f;
+    const float pxScale = (canvasPt * mScaleY) / mBakedPx;
+    float wPx = 0.0f;
+    const char *p = str;
+    while (*p) {
+      std::uint32_t cp = NextCodepoint(p);
+      auto it = mGlyphs.find(cp);
+      if (it == mGlyphs.end()) it = mGlyphs.find('?');
+      if (it != mGlyphs.end()) wPx += it->second.advance * pxScale;
+    }
+    return wPx / mScaleX;
+  };
+
+  auto drawText = [&](const char *str, float cx, float cy, float canvasPt, Color4 col, bool shadow) {
+    if (!str || mBakedPx <= 0.0f) return;
+    const float pxScale = (canvasPt * mScaleY) / mBakedPx;
+    const float baseY = db.PxY(cy) + mFontAscent * pxScale;
+    auto emitPass = [&](float ox, float oy, Color4 c) {
+      float penX = db.PxX(cx) + ox;
+      const char *p = str;
+      while (*p) {
+        std::uint32_t cp = NextCodepoint(p);
+        auto it = mGlyphs.find(cp);
+        if (it == mGlyphs.end()) it = mGlyphs.find('?');
+        if (it == mGlyphs.end()) continue;
+        const GlyphInfo &g = it->second;
+        if (g.w > 0.0f && g.h > 0.0f) {
+          db.PushQuadPx(penX + g.xoff * pxScale, baseY + g.yoff * pxScale + oy,
+                        g.w * pxScale, g.h * pxScale, c, c, c, 3.0f,
+                        0.0f, 0.0f, 0.0f, g.u0, g.v0, g.u1, g.v1);
+        }
+        penX += g.advance * pxScale;
+      }
+    };
+    if (shadow) {
+      float sOff = std::max(1.0f, 0.35f * mScaleY);
+      emitPass(sOff, sOff, C4(16, 20, 28, 0.55f * col.a));
+    }
+    emitPass(0.0f, 0.0f, col);
+  };
+
+  // P9: O(n) single-pass word-width accumulation with zero per-word std::string allocations.
+  auto drawWrappedText = [&](const char *str, float cx, float cy, float maxW, float canvasPt,
+                             float lineStep, int maxLines, Color4 col, bool shadow) {
+    if (!str || !str[0] || maxW <= 2.0f || maxLines <= 0 || mBakedPx <= 0.0f) return;
+    const float pxScale = (canvasPt * mScaleY) / mBakedPx;
+    float spaceAdvPx = 0.0f;
+    {
+      auto sit = mGlyphs.find(' ');
+      if (sit == mGlyphs.end()) sit = mGlyphs.find('?');
+      if (sit != mGlyphs.end()) spaceAdvPx = sit->second.advance * pxScale;
+    }
+    const float spaceW = spaceAdvPx / mScaleX;
+
+    struct WordSpan {
+      const char *start;
+      const char *end;
+    };
+    constexpr int kMaxWordsPerLine = 128;
+    WordSpan words[kMaxWordsPerLine];
+
+    const char *p = str;
+    int lineIdx = 0;
+    while (*p && lineIdx < maxLines) {
+      while (*p == ' ') ++p;
+      if (!*p) break;
+
+      int nWords = 0;
+      float lineW = 0.0f;
+      while (*p && *p != '\n') {
+        const char *wordStart = p;
+        while (*p && *p != ' ' && *p != '\n') ++p;
+        const char *wordEnd = p;
+        const float wordW = measureTextRange(wordStart, wordEnd, canvasPt);
+        const float candW = (nWords == 0) ? wordW : (lineW + spaceW + wordW);
+        if (nWords > 0 && candW > maxW) {
+          p = wordStart;
+          break;
+        }
+        if (nWords < kMaxWordsPerLine) {
+          words[nWords++] = {wordStart, wordEnd};
+        }
+        lineW = candW;
+        while (*p == ' ') ++p;
+      }
+      if (*p == '\n') ++p;
+      if (nWords > 0) {
+        const float baseY = db.PxY(cy + lineIdx * lineStep) + mFontAscent * pxScale;
+        auto emitLinePass = [&](float ox, float oy, Color4 c) {
+          float penX = db.PxX(cx) + ox;
+          for (int wi = 0; wi < nWords; ++wi) {
+            if (wi > 0) penX += spaceAdvPx;
+            const char *wp = words[wi].start;
+            const char *wend = words[wi].end;
+            while (wp < wend && *wp) {
+              std::uint32_t cp = NextCodepoint(wp);
+              auto it = mGlyphs.find(cp);
+              if (it == mGlyphs.end()) it = mGlyphs.find('?');
+              if (it == mGlyphs.end()) continue;
+              const GlyphInfo &g = it->second;
+              if (g.w > 0.0f && g.h > 0.0f) {
+                db.PushQuadPx(penX + g.xoff * pxScale, baseY + g.yoff * pxScale + oy,
+                              g.w * pxScale, g.h * pxScale, c, c, c, 3.0f,
+                              0.0f, 0.0f, 0.0f, g.u0, g.v0, g.u1, g.v1);
+              }
+              penX += g.advance * pxScale;
+            }
+          }
+        };
+        if (shadow) {
+          float sOff = std::max(1.0f, 0.35f * mScaleY);
