+void RenderBagOverlay(const HudExtDraw &ext, const SIM_HudHD_Overlay &ov, float pulse) {
+  const int numTabs = std::clamp(ov.numTabs, 1, SIM_HUDHD_MAX_OVERLAY_TABS);
+  const int activeTab = std::clamp(ov.activeTab, 0, numTabs - 1);
+  const TabAccent &accent = kTabAccents[activeTab];
+
+  // Top category pill tabs with L/R badges.
+  ext.roundRect(10.0f, 27.5f, 13.0f, 11.0f, 3.0f,
+                HudC4(32, 46, 70, 0.92f), HudC4(20, 30, 48, 0.92f),
+                0.5f, HudC4(165, 200, 242, 0.55f));
+  ext.drawText("L", 14.5f, 29.5f, 6.4f, HudC4(226, 238, 255, 0.95f), false);
+
+  ext.roundRect(ext.canvasW - 23.0f, 27.5f, 13.0f, 11.0f, 3.0f,
+                HudC4(32, 46, 70, 0.92f), HudC4(20, 30, 48, 0.92f),
+                0.5f, HudC4(165, 200, 242, 0.55f));
+  ext.drawText("R", ext.canvasW - 18.8f, 29.5f, 6.4f, HudC4(226, 238, 255, 0.95f), false);
+
+  const float tabsX = 26.5f;
+  const float tabsW = ext.canvasW - 53.0f;
+  const float gap = 4.0f;
+  const float tabW = (tabsW - gap * (numTabs - 1)) / static_cast<float>(numTabs);
+  const float tabY = 25.0f;
+  const float tabH = 15.5f;
+
+  for (int t = 0; t < numTabs; ++t) {
+    float tx = tabsX + t * (tabW + gap);
+    bool isAct = (t == activeTab);
+    if (isAct) {
+      ext.shadowRect(tx, tabY + 1.0f, tabW, tabH, 5.0f, 2.5f, 0.40f);
+      ext.roundRect(tx, tabY, tabW, tabH, 5.0f,
+                    kTabAccents[t].top, kTabAccents[t].bot,
+                    0.95f, HudC4(255, 255, 255, 0.92f));
+    } else {
+      ext.roundRect(tx, tabY + 0.6f, tabW, tabH - 1.2f, 4.5f,
+                    HudC4(26, 38, 58, 0.82f), HudC4(18, 28, 44, 0.84f),
+                    0.5f, HudC4(130, 162, 204, 0.30f));
+    }
+    const char *tname = ov.tabNames[t];
+    float tw = ext.measureText(tname, 6.8f);
+    ext.drawText(tname, tx + (tabW - tw) * 0.5f, tabY + (isAct ? 4.1f : 4.5f), 6.8f,
+                 isAct ? HudC4(255, 255, 255, 1.0f) : HudC4(178, 196, 222, 0.86f), isAct);
+  }
+
+  // Left frosted description card.
+  const float leftX = 10.0f, leftY = 45.5f, leftW = 114.0f, leftH = 124.0f;
+  ext.shadowRect(leftX, leftY + 1.2f, leftW, leftH, 6.0f, 3.0f, 0.38f);
+  ext.roundRect(leftX, leftY, leftW, leftH, 6.0f,
+                HudC4(18, 29, 48, 0.90f), HudC4(12, 20, 35, 0.93f),
+                0.7f, HudC4(150, 195, 245, 0.36f));
+
+  // Colored pocket header stripe inside left card.
+  ext.roundRect(leftX + 5.0f, leftY + 5.0f, leftW - 10.0f, 15.0f, 3.8f,
+                accent.top, accent.bot, 0.4f, HudC4(255, 255, 255, 0.35f));
+  char countSummary[32];
+  std::snprintf(countSummary, sizeof(countSummary), "%s (%d)", ov.tabNames[activeTab], ov.totalItems);
+  float csw = ext.measureText(countSummary, 6.6f);
+  ext.drawText(countSummary, leftX + (leftW - csw) * 0.5f, leftY + 9.0f, 6.6f,
+               HudC4(255, 255, 255, 1.0f), true);
+
+  // Find selected item for left panel title/count.
+  const SIM_HudHD_OverlayItem *selItem = nullptr;
+  for (int i = 0; i < ov.numItems && i < SIM_HUDHD_MAX_OVERLAY_ITEMS; ++i) {
+    if (ov.items[i].valid && ov.items[i].selected) {
+      selItem = &ov.items[i];
+      break;
+    }
+  }
+
+  if (selItem) {
+    ext.drawText(selItem->name, leftX + 7.0f, leftY + 26.5f, 8.2f, HudC4(250, 253, 255, 1.0f), true);
+    char qtyBuf[24];
+    std::snprintf(qtyBuf, sizeof(qtyBuf), "In Bag: x%d", selItem->count);
+    ext.drawText(qtyBuf, leftX + 7.0f, leftY + 38.0f, 6.5f, accent.glow, false);
+    ext.line(leftX + 7.0f, leftY + 48.5f, leftX + leftW - 7.0f, leftY + 48.5f, 0.55f,
+             HudC4(160, 198, 240, 0.28f));
+    if (ov.desc[0] != '\0') {
+      ext.drawWrappedText(ov.desc, leftX + 7.0f, leftY + 53.0f, leftW - 14.0f, 6.4f, 8.8f, 5,
+                          HudC4(222, 234, 248, 0.95f), false);
+    }
+    // Touch-friendly "Use" action pill at bottom of left description panel.
+    ext.roundRect(leftX + 7.0f, leftY + leftH - 20.5f, leftW - 14.0f, 15.0f, 4.2f,
+                  accent.top, accent.bot, 0.7f, HudC4(255, 255, 255, 0.80f));
+    const char *useLbl = "A  Use Item";
+    float uw = ext.measureText(useLbl, 6.8f);
+    ext.drawText(useLbl, leftX + (leftW - uw) * 0.5f, leftY + leftH - 16.6f, 6.8f,
+                 HudC4(255, 255, 255, 1.0f), true);
+  } else {
+    ext.drawWrappedText("No usable items in this pocket.", leftX + 10.0f, leftY + 52.0f, leftW - 20.0f,
+                        6.8f, 9.5f, 3, HudC4(166, 184, 210, 0.85f), false);
+  }
+
+  // Right frosted item list container.
+  const float listX = 130.0f, listY = 45.5f, listW = ext.canvasW - 140.0f, listH = 124.0f;
+  ext.shadowRect(listX, listY + 1.2f, listW, listH, 6.0f, 3.0f, 0.36f);
+  ext.roundRect(listX, listY, listW, listH, 6.0f,
+                HudC4(16, 26, 44, 0.86f), HudC4(11, 18, 32, 0.90f),
+                0.7f, HudC4(150, 195, 245, 0.30f));
+
+  if (ov.numItems <= 0) {
+    const char *emptyMsg = "Pocket is empty";
+    float ew = ext.measureText(emptyMsg, 8.0f);
+    ext.drawText(emptyMsg, listX + (listW - ew) * 0.5f, listY + (listH - 8.0f) * 0.5f,
+                 8.0f, HudC4(162, 180, 206, 0.80f), false);
+    return;
+  }
+
+  const float padX = 5.0f;
+  const float padY = 4.5f;
+  const float rowH = 15.0f;
+  const float rowGap = 1.6f;
+  const float rowW = listW - padX * 2.0f - (ov.totalItems > ov.numItems ? 5.5f : 0.0f);
+
+  for (int i = 0; i < ov.numItems && i < SIM_HUDHD_MAX_OVERLAY_ITEMS; ++i) {
+    const SIM_HudHD_OverlayItem &it = ov.items[i];
+    if (!it.valid) continue;
+    float ry = listY + padY + i * (rowH + rowGap);
+    bool sel = (it.selected != 0);
+
+    if (sel) {
+      ext.shadowRect(listX + padX, ry + 0.8f, rowW, rowH, 4.0f, 2.0f, 0.32f);
+      ext.roundRect(listX + padX, ry, rowW, rowH, 4.0f,
+                    HudC4(250, 253, 255, 0.97f), HudC4(228, 238, 252, 0.97f),
+                    0.85f, accent.top);
+      ext.roundRect(listX + padX + 1.5f, ry + 2.2f, 2.6f, rowH - 4.4f, 1.2f,
+                    accent.top, accent.bot, 0.0f, {});
+    } else {
+      ext.roundRect(listX + padX, ry, rowW, rowH, 3.8f,
+                    HudC4(34, 48, 72, 0.68f), HudC4(24, 36, 56, 0.72f),
+                    0.45f, HudC4(160, 194, 236, 0.22f));
+    }
+
+    ext.drawText(it.name, listX + padX + 8.0f, ry + 3.6f, 7.6f,
+                 sel ? HudC4(18, 28, 46, 1.0f) : HudC4(236, 244, 255, 0.95f), !sel);
+
+    char qty[16];
+    std::snprintf(qty, sizeof(qty), "x%d", it.count);
+    float qw = ext.measureText(qty, 7.0f);
+    float qPillW = qw + 8.0f;
+    float qPillX = listX + padX + rowW - qPillW - 4.0f;
+    ext.roundRect(qPillX, ry + 2.6f, qPillW, rowH - 5.2f, 3.0f,
+                  sel ? accent.top : HudC4(20, 32, 52, 0.88f),
+                  sel ? accent.bot : HudC4(14, 24, 40, 0.88f),
+                  0.0f, {});
+    ext.drawText(qty, qPillX + 4.0f, ry + 3.8f, 7.0f,
+                 sel ? HudC4(255, 255, 255, 1.0f) : HudC4(192, 220, 252, 0.95f), false);
+
+    if (sel) {
+      DrawSelectionBrackets(ext, listX + padX, ry, rowW, rowH, pulse);
+    }
+  }
+
+  // Scrollbar when pocket has more items than visible rows.
+  if (ov.totalItems > ov.numItems && ov.totalItems > 0) {
+    float sbX = listX + listW - 6.0f;
+    float sbY = listY + 6.0f;
+    float sbH = listH - 12.0f;
+    ext.roundRect(sbX, sbY, 2.8f, sbH, 1.4f, HudC4(255, 255, 255, 0.14f), HudC4(255, 255, 255, 0.14f), 0.0f, {});
+    float thumbFrac = std::clamp(static_cast<float>(ov.numItems) / static_cast<float>(ov.totalItems), 0.15f, 1.0f);
+    float maxScroll = static_cast<float>(std::max(1, ov.totalItems - ov.numItems));
+    float scrollFrac = std::clamp(static_cast<float>(ov.scrollOffset) / maxScroll, 0.0f, 1.0f);
+    float thumbH = sbH * thumbFrac;
+    float thumbY = sbY + (sbH - thumbH) * scrollFrac;
+    ext.roundRect(sbX, thumbY, 2.8f, thumbH, 1.4f, accent.top, accent.bot, 0.0f, {});
+  }
+}
+
+void DrawGenderMark(const HudExtDraw &ext, int gender, float x, float y, float sz) {
+  if (gender == SIM_HUDHD_GENDER_MALE) {
+    if (ext.useBdspUi && ext.atlas && ext.atlas->genderM) {
+      ext.spriteAspectFit(ext.atlas->genderM, x, y, sz, sz, HudC4(255, 255, 255, 1.0f));
+    } else {
+      ext.drawText("\xE2\x99\x82", x, y, sz, HudC4(86, 174, 255, 1.0f), false);
+    }
+  } else if (gender == SIM_HUDHD_GENDER_FEMALE) {
+    if (ext.useBdspUi && ext.atlas && ext.atlas->genderF) {
+      ext.spriteAspectFit(ext.atlas->genderF, x, y, sz, sz, HudC4(255, 255, 255, 1.0f));
+    } else {
+      ext.drawText("\xE2\x99\x80", x, y, sz, HudC4(252, 114, 152, 1.0f), false);
+    }
+  }
+}
+
+void RenderPartyOverlay(const HudExtDraw &ext, const SIM_HudHD_Overlay &ov, float pulse) {
+  const float gridX = 12.0f;
+  const float gridY = 27.0f;
+  const float gapX = 8.0f;
+  const float gapY = 5.5f;
+  const float cardW = (ext.canvasW - gridX * 2.0f - gapX) * 0.5f;
+  const float cardH = 43.0f;
+
+  for (int i = 0; i < SIM_HUDHD_MAX_OVERLAY_PARTY; ++i) {
+    const int col = i & 1;
+    const int row = i >> 1;
+    const float cx = gridX + col * (cardW + gapX);
+    const float cy = gridY + row * (cardH + gapY);
+    const SIM_HudHD_OverlayMon &mon = ov.party[i];
+
+    if (!mon.valid) {
+      ext.roundRect(cx, cy, cardW, cardH, 5.5f,
+                    HudC4(14, 22, 36, 0.42f), HudC4(10, 16, 28, 0.46f),
+                    0.5f, HudC4(120, 150, 190, 0.16f));
+      continue;
+    }
+
+    const bool sel = (mon.selected != 0);
+    const bool act = (mon.isActive != 0);
+    const bool fnt = (mon.isFainted != 0);
+
+    HudExtColor topCol, botCol, borderCol;
+    if (sel) {
+      topCol = HudC4(250, 253, 255, 0.97f);
+      botCol = HudC4(228, 238, 252, 0.97f);
+      borderCol = act ? HudC4(56, 186, 248, 0.98f) : (fnt ? HudC4(228, 86, 96, 0.96f) : HudC4(88, 174, 255, 0.96f));
+    } else if (act) {
+      topCol = HudC4(24, 74, 122, 0.92f);
+      botCol = HudC4(16, 48, 86, 0.94f);
+      borderCol = HudC4(96, 206, 255, 0.72f);
+    } else if (fnt) {
+      topCol = HudC4(74, 30, 38, 0.88f);
+      botCol = HudC4(50, 20, 28, 0.90f);
+      borderCol = HudC4(212, 92, 102, 0.50f);
+    } else {
+      topCol = HudC4(26, 38, 60, 0.90f);
+      botCol = HudC4(18, 28, 46, 0.92f);
+      borderCol = HudC4(148, 184, 228, 0.34f);
+    }
+
+    ext.shadowRect(cx, cy + 1.2f, cardW, cardH, 5.5f, 2.5f, sel ? 0.42f : 0.28f);
+    ext.roundRect(cx, cy, cardW, cardH, 5.5f, topCol, botCol, sel ? 1.1f : 0.65f, borderCol);
+
+    // Left accent strip for active/fainted state.
+    HudExtColor stripTop = act ? HudC4(66, 204, 255) : (fnt ? HudC4(218, 66, 76) : HudC4(62, 198, 128));
+    HudExtColor stripBot = act ? HudC4(34, 142, 224) : (fnt ? HudC4(166, 38, 48) : HudC4(34, 152, 90));
+    ext.roundRect(cx + 2.0f, cy + 4.0f, 2.8f, cardH - 8.0f, 1.4f, stripTop, stripBot, 0.0f, {});
+
+    // Ball icon on left.
+    DrawBallIcon(ext, mon, cx + 15.5f, cy + 15.5f, 7.2f);
+
+    const HudExtColor mainText = sel ? HudC4(18, 28, 46, 1.0f) : HudC4(248, 252, 255, 1.0f);
+    const HudExtColor subText = sel ? HudC4(62, 80, 110, 0.96f) : HudC4(186, 208, 236, 0.92f);
+
+    // Name + Gender + Level.
+    const float tx = cx + 27.0f;
+    ext.drawText(mon.name, tx, cy + 5.2f, 8.2f, mainText, !sel);
+    float nw = ext.measureText(mon.name, 8.2f);
+    DrawGenderMark(ext, mon.gender, tx + nw + 2.5f, cy + 5.6f, 7.2f);
+
+    char lvBuf[16];
+    std::snprintf(lvBuf, sizeof(lvBuf), "Lv.%d", mon.level);
+    float lw = ext.measureText(lvBuf, 7.0f);
+    ext.drawText(lvBuf, cx + cardW - 6.0f - lw, cy + 6.0f, 7.0f, subText, false);
+
+    // HP bar + HP numbers.
+    DrawHpBar(ext, tx, cy + 18.0f, cardW - 33.0f, 5.2f, mon.hp, mon.maxHp);
+
+    char hpBuf[24];
+    std::snprintf(hpBuf, sizeof(hpBuf), "%d / %d", mon.hp, mon.maxHp);
+    float hpw = ext.measureText(hpBuf, 6.4f);
+    ext.drawText(hpBuf, cx + cardW - 6.0f - hpw, cy + 25.0f, 6.4f, mainText, false);
+
+    // Active tag or Status pill on bottom-left; held item on bottom-right/middle.
+    float badgeX = tx;
+    if (act) {
+      const char *tag = "IN BATTLE";
+      float tagW = ext.measureText(tag, 5.0f) + 6.0f;
+      ext.roundRect(badgeX, cy + 25.0f, tagW, 8.2f, 2.2f,
+                    HudC4(42, 162, 236), HudC4(24, 118, 196), 0.0f, {});
+      ext.drawText(tag, badgeX + 3.0f, cy + 26.4f, 5.0f, HudC4(255, 255, 255, 1.0f), false);
+      badgeX += tagW + 3.0f;
+    }
+    if (mon.status != SIM_HUDHD_STATUS_NONE) {
+      DrawStatusBadge(ext, mon.status, badgeX, cy + 24.8f, 20.0f, 8.6f);
+    }
+
+    if (mon.heldItem[0] != '\0' && std::strcmp(mon.heldItem, "None") != 0) {
+      char itemLbl[44];
+      std::snprintf(itemLbl, sizeof(itemLbl), "Item: %s", mon.heldItem);
+      ext.drawText(itemLbl, tx, cy + 34.5f, 5.6f, subText, false);
+    } else if (mon.ability[0] != '\0' && std::strcmp(mon.ability, "---") != 0) {
+      ext.drawText(mon.ability, tx, cy + 34.5f, 5.6f, subText, false);
+    }
+
+    if (sel && ov.confirmMode == 0) {
+      DrawSelectionBrackets(ext, cx, cy, cardW, cardH, pulse);
+    }
+  }
+
+  // Inline Shift / Summary / Cancel action prompt modal.
+  if (ov.confirmMode == 1 && ov.confirmCount > 0) {
+    const int nOpt = std::clamp(ov.confirmCount, 1, 3);
+    const float pw = 104.0f;
+    const float optH = 17.5f;
+    const float optGap = 3.5f;
+    const float ph = 14.0f + nOpt * optH + (nOpt - 1) * optGap;
+    const float px = ext.canvasW - pw - 12.0f;
+    const float py = 170.0f - ph;
+
+    ext.shadowRect(px, py + 2.0f, pw, ph, 6.0f, 4.5f, 0.55f);
+    ext.roundRect(px, py, pw, ph, 6.0f,
+                  HudC4(18, 28, 48, 0.96f), HudC4(12, 20, 36, 0.97f),
+                  1.0f, HudC4(130, 198, 255, 0.72f));
+
+    for (int k = 0; k < nOpt; ++k) {
+      float oy = py + 7.0f + k * (optH + optGap);
+      bool sel = (k == ov.confirmCursor);
+      if (sel) {
+        ext.roundRect(px + 7.0f, oy, pw - 14.0f, optH, 4.2f,
+                      HudC4(250, 253, 255, 0.98f), HudC4(228, 238, 252, 0.98f),
+                      0.9f, HudC4(66, 178, 252, 0.95f));
+      } else {
+        ext.roundRect(px + 7.0f, oy, pw - 14.0f, optH, 4.2f,
+                      HudC4(34, 48, 72, 0.80f), HudC4(24, 36, 56, 0.84f),
+                      0.45f, HudC4(150, 186, 228, 0.28f));
+      }
+      const char *lbl = ov.confirmLabels[k];
+      float lw = ext.measureText(lbl, 7.6f);
+      ext.drawText(lbl, px + (pw - lw) * 0.5f, oy + 4.8f, 7.6f,
+                   sel ? HudC4(18, 28, 46, 1.0f) : HudC4(236, 244, 255, 0.95f), !sel);
+      if (sel) {
+        DrawSelectionBrackets(ext, px + 7.0f, oy, pw - 14.0f, optH, pulse);
+      }
+    }
+  }
+}
+
+void RenderSummaryOverlay(const HudExtDraw &ext, const SIM_HudHD_Overlay &ov, float pulse) {
+  const int idx = std::clamp(ov.partyCursor, 0, SIM_HUDHD_MAX_OVERLAY_PARTY - 1);
+  const SIM_HudHD_OverlayMon &mon = ov.party[idx];
+  if (!mon.valid) return;
+
+  // Left card: Identity, Ability, Held Item & 6 Stats.
+  const float lx = 10.0f, ly = 26.0f, lw = 156.0f, lh = 144.0f;
+  ext.shadowRect(lx, ly + 1.2f, lw, lh, 6.0f, 3.0f, 0.40f);
+  ext.roundRect(lx, ly, lw, lh, 6.0f,
+                HudC4(20, 32, 54, 0.92f), HudC4(13, 21, 38, 0.95f),
+                0.8f, HudC4(142, 192, 248, 0.42f));
+
+  // Identity header inside left card.
+  DrawBallIcon(ext, mon, lx + 16.0f, ly + 16.0f, 7.5f);
+  ext.drawText(mon.name, lx + 28.0f, ly + 6.5f, 9.0f, HudC4(250, 253, 255, 1.0f), true);
+  float nw = ext.measureText(mon.name, 9.0f);
+  DrawGenderMark(ext, mon.gender, lx + 30.5f + nw, ly + 7.2f, 7.6f);
+
+  char lvBuf[16];
+  std::snprintf(lvBuf, sizeof(lvBuf), "Lv.%d", mon.level);
+  float lvw = ext.measureText(lvBuf, 7.2f);
+  ext.drawText(lvBuf, lx + lw - 8.0f - lvw, ly + 7.6f, 7.2f, HudC4(182, 216, 252, 0.96f), false);
+
+  DrawHpBar(ext, lx + 28.0f, ly + 19.5f, lw - 36.0f, 5.2f, mon.hp, mon.maxHp);
+  char hpBuf[28];
+  std::snprintf(hpBuf, sizeof(hpBuf), "HP %d / %d", mon.hp, mon.maxHp);
+  ext.drawText(hpBuf, lx + 28.0f, ly + 26.5f, 6.2f, HudC4(222, 236, 252, 0.95f), false);
+  if (mon.status != SIM_HUDHD_STATUS_NONE) {
+    DrawStatusBadge(ext, mon.status, lx + lw - 28.0f, ly + 26.0f, 20.0f, 8.4f);
+  }
+
+  // Ability & Held Item row.
+  ext.line(lx + 7.0f, ly + 37.5f, lx + lw - 7.0f, ly + 37.5f, 0.55f, HudC4(150, 192, 240, 0.26f));
+  ext.roundRect(lx + 7.0f, ly + 41.0f, (lw - 18.0f) * 0.5f, 18.0f, 3.5f,
+                HudC4(28, 44, 72, 0.85f), HudC4(20, 32, 54, 0.88f), 0.4f, HudC4(140, 184, 232, 0.25f));
+  ext.drawText("ABILITY", lx + 10.5f, ly + 43.0f, 4.8f, HudC4(140, 194, 248, 0.90f), false);
+  ext.drawText(mon.ability, lx + 10.5f, ly + 49.5f, 6.4f, HudC4(248, 252, 255, 1.0f), false);
+
+  float itemBoxX = lx + 11.0f + (lw - 18.0f) * 0.5f;
+  ext.roundRect(itemBoxX, ly + 41.0f, (lw - 18.0f) * 0.5f, 18.0f, 3.5f,
+                HudC4(28, 44, 72, 0.85f), HudC4(20, 32, 54, 0.88f), 0.4f, HudC4(140, 184, 232, 0.25f));
+  ext.drawText("HELD ITEM", itemBoxX + 3.5f, ly + 43.0f, 4.8f, HudC4(248, 206, 118, 0.90f), false);
+  ext.drawText(mon.heldItem, itemBoxX + 3.5f, ly + 49.5f, 6.4f, HudC4(248, 252, 255, 1.0f), false);
+
+  // 6 Stats bars.
+  static const char *const kStatNames[6] = {"HP", "Attack", "Defense", "Sp. Atk", "Sp. Def", "Speed"};
+  static const HudExtColor kStatCols[6] = {
+      {0.34f, 0.86f, 0.48f, 1.0f},
+      {0.96f, 0.46f, 0.36f, 1.0f},
+      {0.94f, 0.72f, 0.26f, 1.0f},
+      {0.42f, 0.68f, 0.98f, 1.0f},
+      {0.62f, 0.52f, 0.96f, 1.0f},
+      {0.96f, 0.44f, 0.72f, 1.0f},
+  };
+  float statY = ly + 64.0f;
+  for (int s = 0; s < 6; ++s) {
+    float ry = statY + s * 12.6f;
+    ext.drawText(kStatNames[s], lx + 8.0f, ry + 1.0f, 6.4f, HudC4(198, 218, 242, 0.95f), false);
+    char sv[16];
+    std::snprintf(sv, sizeof(sv), "%d", mon.stats[s]);
+    float svw = ext.measureText(sv, 6.8f);
+    ext.drawText(sv, lx + 64.0f - svw, ry + 0.8f, 6.8f, HudC4(250, 253, 255, 1.0f), false);
+
+    float barX = lx + 70.0f;
+    float barW = lw - 78.0f;
+    float frac = std::clamp(static_cast<float>(mon.stats[s]) / 260.0f, 0.04f, 1.0f);
+    ext.roundRect(barX, ry + 2.4f, barW, 4.6f, 2.3f,
+                  HudC4(14, 22, 36, 0.86f), HudC4(18, 28, 44, 0.86f), 0.0f, {});
+    ext.roundRect(barX, ry + 2.4f, barW * frac, 4.6f, 2.3f,
+                  kStatCols[s], kStatCols[s], 0.0f, {});
+  }
+
+  // Right card: 4 Type-Colored Move Cards.
+  const float rx = 172.0f, ry = 26.0f, rw = ext.canvasW - 182.0f, rh = 144.0f;
+  ext.shadowRect(rx, ry + 1.2f, rw, rh, 6.0f, 3.0f, 0.40f);
+  ext.roundRect(rx, ry, rw, rh, 6.0f,
+                HudC4(18, 29, 48, 0.90f), HudC4(12, 20, 35, 0.94f),
+                0.8f, HudC4(142, 192, 248, 0.38f));
+
+  const char *mvHdr = (ov.confirmMode == 1) ? "SELECT MOVE TO RESTORE PP" : "MOVES";
+  ext.drawText(mvHdr, rx + 8.0f, ry + 6.5f, 6.8f, HudC4(168, 210, 252, 0.96f), false);
+
+  const float mcX = rx + 7.0f;
+  const float mcW = rw - 14.0f;
+  const float mcH = 26.5f;
+  const float mcGap = 4.5f;
+
+  for (int m = 0; m < 4; ++m) {
+    float my = ry + 19.0f + m * (mcH + mcGap);
+    if (mon.moveNames[m][0] == '\0') {
+      ext.roundRect(mcX, my, mcW, mcH, 4.5f,
+                    HudC4(22, 32, 50, 0.50f), HudC4(16, 24, 38, 0.54f),
+                    0.45f, HudC4(120, 150, 190, 0.18f));
+      ext.drawText("---", mcX + 10.0f, my + 9.0f, 7.5f, HudC4(130, 148, 174, 0.65f), false);
+      continue;
+    }
+
+    int ti = std::clamp(mon.moveTypes[m], 0, 18);
+    int bdspTi = BdspTypeIndex(ti);
+    const TypePal &tp = kTypePal[ti];
+    bool sel = (ov.confirmMode == 1 && ov.confirmCursor == m);
+
+    ext.shadowRect(mcX, my + 1.0f, mcW, mcH, 4.8f, 2.0f, 0.32f);
+    const HudUiSprite *moveSp = (ext.useBdspUi && ext.atlas) ? ext.atlas->moveCard[bdspTi] : nullptr;
+    if (moveSp) {
+      const float sc = mcH / moveSp->h;
+      const float leftPad = std::min(mcW * 0.24f, 82.0f * sc);
+      const float ppBoxW = std::min(mcW * 0.34f, 114.0f * sc);
+      ext.spriteNineSlice(moveSp, mcX, my, mcW, mcH, sc, HudC4(255, 255, 255, 0.98f));
+
+      // High-contrast dark ink on pastel BDSP move card (matches fx_hudhd.cpp).
+      const float textX = mcX + leftPad + 2.0f;
+      ext.drawText(mon.moveNames[m], textX, my + 4.0f, 8.0f, HudC4(26, 32, 44, 1.0f), false);
+
+      float badgeW = ext.measureText(tp.name, 5.0f) + 7.0f;
+      ext.roundRect(textX, my + 15.2f, badgeW, 7.6f, 2.4f, tp.top, tp.bot, 0.35f, HudC4(255, 255, 255, 0.55f));
+      ext.drawText(tp.name, textX + 3.5f, my + 16.5f, 5.0f, HudC4(255, 255, 255, 1.0f), false);
+
+      char ppBuf[20];
+      std::snprintf(ppBuf, sizeof(ppBuf), "%d/%d", mon.movePp[m], mon.moveMaxPp[m]);
+      const float ppBoxX = mcX + mcW - ppBoxW;
+      const float ppNumW = ext.measureText(ppBuf, 7.2f);
+      HudExtColor ppCol = (mon.movePp[m] == 0) ? HudC4(204, 38, 38, 1.0f) : HudC4(34, 42, 56, 1.0f);
+      ext.drawText("PP", ppBoxX + 4.0f, my + 3.6f, 5.4f, HudC4(92, 102, 118, 1.0f), false);
+      ext.drawText(ppBuf, ppBoxX + (ppBoxW - ppNumW) * 0.5f, my + 13.0f, 7.2f, ppCol, false);
+    } else {
+      ext.roundRect(mcX, my, mcW, mcH, 4.8f, tp.top, tp.bot,
+                    sel ? 1.1f : 0.65f, HudC4(255, 255, 255, sel ? 0.95f : 0.45f));
+
+      ext.drawText(mon.moveNames[m], mcX + 8.0f, my + 4.5f, 8.2f, HudC4(255, 255, 255, 1.0f), true);
+
+      float badgeW = ext.measureText(tp.name, 5.2f) + 8.0f;
+      ext.roundRect(mcX + 8.0f, my + 15.8f, badgeW, 8.0f, 2.5f,
+                    HudC4(16, 24, 38, 0.62f), HudC4(10, 16, 28, 0.70f),
+                    0.35f, HudC4(255, 255, 255, 0.45f));
+      ext.drawText(tp.name, mcX + 12.0f, my + 17.2f, 5.2f, HudC4(248, 252, 255, 0.98f), false);
+
+      char ppBuf[24];
+      std::snprintf(ppBuf, sizeof(ppBuf), "PP %d / %d", mon.movePp[m], mon.moveMaxPp[m]);
+      float ppw = ext.measureText(ppBuf, 6.8f);
+      ext.roundRect(mcX + mcW - ppw - 13.0f, my + 13.5f, ppw + 8.0f, 10.2f, 3.0f,
+                    HudC4(12, 20, 34, 0.68f), HudC4(8, 14, 26, 0.74f), 0.0f, {});
+      ext.drawText(ppBuf, mcX + mcW - ppw - 9.0f, my + 15.2f, 6.8f,
+                   (mon.movePp[m] == 0) ? HudC4(255, 128, 128, 1.0f) : HudC4(248, 252, 255, 1.0f), false);
+    }
+
+    if (sel) {
+      DrawSelectionBrackets(ext, mcX, my, mcW, mcH, pulse);
+    }
+  }
+}
+
+} // namespace
+
+void RenderHudOverlay(const HudExtDraw &ext, const SIM_HudHD_Overlay &ov) {
+  if (ov.kind == SIM_HUDHD_OVERLAY_NONE) {
+    return;
+  }
+  const float pulse = 0.5f + 0.5f * std::sin(ext.timeSec * 5.2f);
+  DrawScrimHeaderFooter(ext, ov);
+  if (ov.kind == SIM_HUDHD_OVERLAY_BAG) {
+    RenderBagOverlay(ext, ov, pulse);
+  } else if (ov.kind == SIM_HUDHD_OVERLAY_PARTY) {
+    RenderPartyOverlay(ext, ov, pulse);
+  } else if (ov.kind == SIM_HUDHD_OVERLAY_SUMMARY) {
+    RenderSummaryOverlay(ext, ov, pulse);
+  }
+  DrawErrorBanner(ext, ov);
+}
+
+} // namespace SIM::Render
diff --git a/libraries/sim/src/render_gpu/fx_lighting.cpp b/libraries/sim/src/render_gpu/fx_lighting.cpp
new file mode 100644
index 0000000..b886261
--- /dev/null
+++ b/libraries/sim/src/render_gpu/fx_lighting.cpp
@@ -0,0 +1,75 @@
+// Scene lights for the SDL GPU G3 renderer (lighting lane). See
+// fx_lighting.hpp. The shader side lives in gpu/shaders/g3.frag
+// (// fx_lighting hook): ambient multiply, additive point lights
+// quantised to DS 5-bit steps, and rim light from the sprite alpha
+// edge. With the default state this block is ambient 1,1,1 with no
+// lights and no rim, so the shader output is unchanged.
+
+#include "fx_lighting.hpp"
+
+#include <simulator/sim_lights.h>
+
+#include <cmath>
+#include <cstring>
+
+namespace SIM::Render {
+namespace {
+
+G3LightsUniforms s_pushed{};
+std::uint64_t s_pushedFrame = 0;
+bool s_havePushed = false;
+
+} // namespace
+
+void FxLighting_Push(SIM::Gpu::Frame *frame)
+{
+    if (frame == nullptr) {
+        return;
+    }
+    SIM_LightsState state;
+    if (!SIM_Lights_Get(&state)) {
+        return;
+    }
+    G3LightsUniforms uniforms{};
+    uniforms.ambient[0] = state.ambientR;
+    uniforms.ambient[1] = state.ambientG;
+    uniforms.ambient[2] = state.ambientB;
+    uniforms.ambient[3] = 0.0f;
+    // Normalise the key direction; a zero vector keeps the default.
+    float len = std::sqrt(state.keyDirX * state.keyDirX + state.keyDirY * state.keyDirY);
+    if (len > 0.0001f) {
+        uniforms.keyDir[0] = state.keyDirX / len;
+        uniforms.keyDir[1] = state.keyDirY / len;
+    } else {
+        uniforms.keyDir[0] = -0.5f;
+        uniforms.keyDir[1] = 0.8f;
+    }
+    uniforms.keyDir[2] = state.rimStrength;
+    uniforms.keyDir[3] = 0.0f;
+    uniforms.keyColor[0] = state.keyR;
+    uniforms.keyColor[1] = state.keyG;
+    uniforms.keyColor[2] = state.keyB;
+    uniforms.keyColor[3] = 0.0f;
+    for (int i = 0; i < SIM_LIGHTS_MAX; i++) {
+        if (i < state.count) {
+            uniforms.lightPos[i][0] = state.lights[i].x;
+            uniforms.lightPos[i][1] = state.lights[i].y;
+            uniforms.lightPos[i][2] = state.lights[i].radius;
+            uniforms.lightPos[i][3] = state.lights[i].intensity;
+            uniforms.lightColor[i][0] = state.lights[i].r;
+            uniforms.lightColor[i][1] = state.lights[i].g;
+            uniforms.lightColor[i][2] = state.lights[i].b;
+            uniforms.lightColor[i][3] = 0.0f;
+        }
+    }
+    if (s_havePushed && frame->Index() == s_pushedFrame &&
+        std::memcmp(&s_pushed, &uniforms, sizeof(uniforms)) == 0) {
+        return;
+    }
+    frame->PushFragmentUniform(2, uniforms);
+    s_pushed = uniforms;
+    s_pushedFrame = frame->Index();
+    s_havePushed = true;
+}
+
+} // namespace SIM::Render
diff --git a/libraries/sim/src/render_gpu/fx_lighting.hpp b/libraries/sim/src/render_gpu/fx_lighting.hpp
new file mode 100644
index 0000000..1ea9cf7
--- /dev/null
+++ b/libraries/sim/src/render_gpu/fx_lighting.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+// Scene lights for the SDL GPU G3 renderer (lighting lane).
+// Translates the SIM_LightsState (sim_lights.h) into the std140 uniform
+// block the G3 fragment shader reads (set 3, binding 2), and pushes it
+// once per frame when the state changed. The G3 renderer calls
+// FxLighting_Push once per draw; the push is a no-op when the state
+// matches the block already pushed for this frame.
+
+#include <simulator/gpu/gpu.hpp>
+
+namespace SIM::Render {
+
+// std140 mirror of the G3Lights block in gpu/shaders/g3.frag.
+// 11 vec4 = 176 bytes.
+struct G3LightsUniforms {
+  float ambient[4];      // rgb, pad
+  float keyDir[4];       // xy direction to key light, z rimStrength, pad
+  float keyColor[4];     // rgb, pad
+  float lightPos[4][4];  // per light: x, y, radius, intensity
+  float lightColor[4][4]; // per light: rgb, pad
+};
+static_assert(sizeof(G3LightsUniforms) == 176, "g3 lights uniform size");
+
+void FxLighting_Push(SIM::Gpu::Frame *frame);
+
+} // namespace SIM::Render
