 #define HW_DB_OBJ_PLTT_SIZE     (HW_DB_OBJ_PLTT_END-HW_DB_OBJ_PLTT)
@@ -94,7 +115,7 @@ extern u8 s_HW_BG_VRAM[0x80000];
