diff --git a/libraries/sim/src/sim_headless.cpp b/libraries/sim/src/sim_headless.cpp
new file mode 100644
index 0000000..fc076df
--- /dev/null
+++ b/libraries/sim/src/sim_headless.cpp
@@ -0,0 +1,170 @@
+// Headless / deterministic mode for PC builds (docs/headless_protocol.md).
+// Off unless SIM_HEADLESS / SIM_CONTROL / SIM_FIXED_RTC / SIM_SEED / SIM_SAVE_PATH is set.
+#include "simulator/sim_headless.h"
+
+#include <SDL2/SDL.h>
+#include <simulator/sim_opengl.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <string>
+#include <vector>
+
+#include <unistd.h>
+
+extern "C" void SIM_Headless_ControlFrame(void);   // sim_headless_control.cpp
+extern "C" void SIM_Headless_WatchdogFrame(void);  // sim_headless_watchdog.cpp
+
+static int s_headless = 0;
+static int s_control = 0;
+static std::string s_savePath;
+static long s_seed = -1;
+static unsigned long long s_frame = 0;
+static int s_replyFd = -1;   // real stdout in control mode (fd 1 is redirected to stderr)
+
+// Fixed RTC: base instant broken down, plus days-from-civil for weekday math.
+static int s_fixedSet = 0;
+static long long s_fixedDays = 0;   // days since 1970-01-01
+static long long s_fixedSecsOfDay = 0;
+static int s_fixedWeekBase = 0;     // weekday of the base date (0 = Sunday)
+
+static long long DaysFromCivil(int y, int m, int d) {
+    y -= m <= 2;
+    long long era = (y >= 0 ? y : y - 399) / 400;
+    long long yoe = y - era * 400;
+    long long doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+    long long doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    return era * 146097 + doe - 719468;
+}
+
+static void CivilFromDays(long long z, int *yy, int *mm, int *dd) {
+    z += 719468;
+    long long era = (z >= 0 ? z : z - 146096) / 146097;
+    long long doe = z - era * 146097;
+    long long yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
+    long long y = yoe + era * 400;
+    long long doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
+    long long mp = (5 * doy + 2) / 153;
+    *dd = (int)(doy - (153 * mp + 2) / 5 + 1);
+    *mm = (int)(mp + (mp < 10 ? 3 : -9));
+    *yy = (int)(y + (*mm <= 2));
+}
+
+extern "C" void SIM_Headless_Init(void) {
+    if (s_headless || s_control) return;
+    const char *e;
+    e = getenv("SIM_HEADLESS"); s_headless = (e && atoi(e)) ? 1 : 0;
+    e = getenv("SIM_CONTROL"); s_control = (e && strcmp(e, "stdio") == 0) ? 1 : 0;
+    if (s_control) s_headless = 1;
+    e = getenv("SIM_SAVE_PATH"); if (e && *e) s_savePath = e;
+    e = getenv("SIM_SEED"); if (e && *e) s_seed = atol(e);
+    e = getenv("SIM_FIXED_RTC");
+    if (e && *e) {
+        int Y, M, D, h, mi, s;
+        if (sscanf(e, "%d-%d-%dT%d:%d:%d", &Y, &M, &D, &h, &mi, &s) == 6) {
+            s_fixedDays = DaysFromCivil(Y, M, D);
+            s_fixedSecsOfDay = h * 3600LL + mi * 60LL + s;
+            s_fixedWeekBase = (int)((s_fixedDays + 4) % 7);   // 1970-01-01 was a Thursday
+            if (s_fixedWeekBase < 0) s_fixedWeekBase += 7;
+            s_fixedSet = 1;
+        } else {
+            fprintf(stderr, "SIM_FIXED_RTC: expected YYYY-MM-DDTHH:MM:SS, got '%s'\n", e);
+        }
+    }
+    if (s_headless) {
+        // No audio device and no visible window; rendering still happens (offscreen/hidden).
+        setenv("SDL_AUDIODRIVER", "dummy", 0);
+#ifdef __APPLE__
+        // Never appear in the Dock / app switcher for headless test instances.
+        SDL_SetHint(SDL_HINT_MAC_BACKGROUND_APP, "1");
+#endif
+#if defined(__linux__)
+        if (!getenv("DISPLAY")) setenv("SDL_VIDEODRIVER", "offscreen", 0);
+#endif
+    }
+    if (s_control) {
+        // Protocol replies go to the real stdout; everything else (game printf) goes to stderr.
+        // The reply fd survives execv restarts (save import) via SIM_CONTROL_REPLY_FD.
+        const char *rfd = getenv("SIM_CONTROL_REPLY_FD");
+        fflush(stdout);
+        if (rfd && atoi(rfd) > 2) {
+            s_replyFd = atoi(rfd);
+        } else {
+            s_replyFd = dup(STDOUT_FILENO);
+            char buf[16]; snprintf(buf, sizeof buf, "%d", s_replyFd);
+            setenv("SIM_CONTROL_REPLY_FD", buf, 1);
+        }
+        dup2(STDERR_FILENO, STDOUT_FILENO);
+    }
+    if (s_headless || s_fixedSet || s_seed >= 0)
+        fprintf(stderr, "SIM headless=%d control=%d seed=%ld fixed_rtc=%d save_path=%s\n",
+                s_headless, s_control, s_seed, s_fixedSet, s_savePath.empty() ? "save.bin" : s_savePath.c_str());
+    SIM_Headless_InstallCrashHandlers();
+}
+
+extern "C" int SIM_Headless_Enabled(void) { return s_headless; }
+extern "C" int SIM_Control_Enabled(void) { return s_control; }
+extern "C" long SIM_Headless_Seed(void) { return s_seed; }
+extern "C" unsigned long long SIM_Headless_FrameCount(void) { return s_frame; }
+
+extern "C" const char *SIM_GetSaveBinPath(void) {
+    return s_savePath.empty() ? "save.bin" : s_savePath.c_str();
+}
+
+extern "C" int SIM_Headless_GetFixedRTC(int *year, int *month, int *day, int *week, int *hour, int *minute, int *second) {
+    if (!s_fixedSet) return 0;
+    // Advance exactly 1/60 s per frame: whole seconds = frame / 60.
+    long long total = s_fixedSecsOfDay + (long long)(s_frame / 60);
+    long long days = s_fixedDays + total / 86400;
+    long long sod = total % 86400;
+    if (sod < 0) { sod += 86400; days -= 1; }
+    int Y, M, D;
+    CivilFromDays(days, &Y, &M, &D);
+    *year = Y - 2000; *month = M; *day = D;
+    long long wd = (days + 4) % 7; if (wd < 0) wd += 7;
+    *week = (int)wd;
+    *hour = (int)(sod / 3600); *minute = (int)((sod % 3600) / 60); *second = (int)(sod % 60);
+    return 1;
+}
+
+extern "C" int SIM_Headless_Screenshot(const char *path) {
+    extern SDL_Window *SIM_GetSDLWindow(void);
+    SDL_Window *window = SIM_GetSDLWindow();
+    if (!window || !path) return 0;
+    int w = 0, h = 0;
+    SDL_GL_GetDrawableSize(window, &w, &h);
+    if (w <= 0 || h <= 0) { w = 512; h = 768; }
+    std::vector<unsigned char> px((size_t)w * h * 4);
+    glReadBuffer(GL_BACK);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, px.data());
+    std::vector<unsigned char> flipped(px.size());
+    for (int y = 0; y < h; y++) memcpy(&flipped[(size_t)y * w * 4], &px[(size_t)(h - 1 - y) * w * 4], (size_t)w * 4);
+    SDL_Surface *surf = SDL_CreateRGBSurfaceWithFormatFrom(flipped.data(), w, h, 32, w * 4, SDL_PIXELFORMAT_RGBA32);
+    if (!surf) return 0;
+    int ok = SDL_SaveBMP(surf, path);
+    SDL_FreeSurface(surf);
+    return ok == 0;
+}
+
+// Reply writer for the control protocol (defined here so early commands can use it).
+extern "C" void SIM_Headless_Reply(const char *line) {
+    int fd = s_replyFd >= 0 ? s_replyFd : STDOUT_FILENO;
+    ssize_t ignored = write(fd, line, strlen(line));
+    ignored = write(fd, "\n", 1);
+    (void)ignored;
+}
+
+extern "C" void SIM_Headless_FrameHook(void) {
+    s_frame++;
+    // SIM_HEADLESS_SHOT_AT=<render frame>:<path> - one screenshot at an exact render frame
+    // (the SIM_DEBUG_* shot counter can skip frames; this one cannot).
+    { static long long shotAt = -2; static const char *shotPath = nullptr;
+      if (shotAt == -2) { const char *e = getenv("SIM_HEADLESS_SHOT_AT"); shotAt = -1;
+        if (e && strchr(e, ':')) { shotAt = atoll(e); shotPath = strchr(e, ':') + 1; } }
+      if (shotAt >= 0 && (long long)s_frame == shotAt && shotPath) { int ok = SIM_Headless_Screenshot(shotPath); fprintf(stderr, "SIM_HEADLESS_SHOT_AT frame=%lld ok=%d path=%s\n", shotAt, ok, shotPath); } }
+    SIM_Headless_ControlFrame();   // sim_headless_control.cpp; no-op unless SIM_CONTROL=stdio
+    SIM_Headless_WatchdogFrame();  // sim_headless_watchdog.cpp; no-op unless armed
+}
diff --git a/libraries/sim/src/sim_headless_control.cpp b/libraries/sim/src/sim_headless_control.cpp
new file mode 100644
index 0000000..085796b
--- /dev/null
+++ b/libraries/sim/src/sim_headless_control.cpp
@@ -0,0 +1,255 @@
+// SIM_CONTROL=stdio lockstep protocol (docs/headless_protocol.md).
+// The game does not advance until told to: this runs at the end of each rendered frame
+// (from SIM_DebugFrame, before the swap) and blocks reading commands whenever no
+// frame budget remains. Each command is one line of JSON on stdin; each reply is one
+// line of JSON on the real stdout (fd 1 is redirected to stderr in control mode).
+#include "simulator/sim_headless.h"
+#include "simulator/sim_helpers.hpp"
+#include <simulator/sim_opengl.h>
+
+#include <nitro/hw/X86/mmap_shared.h>
+#include "simulator/simvariables.h"
+
+#include <chrono>
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#include <sys/select.h>
+#include <unistd.h>
+
+extern "C" void SIM_Headless_Reply(const char *line);
+extern "C" void SIM_Headless_WatchdogTick(void);   // sim_headless_watchdog.cpp
+
+// Game-side handlers (src/port/headless_game.c); weak definitions so the
+// simulator links without the game, and the game's strong definitions (in
+// the main executable) override these. Weak *undefined* symbols link on ELF
+// but not with Apple ld, hence definitions here rather than externs.
+extern "C" __attribute__((weak)) int HeadlessGame_Command(const char *line, char *reply, size_t cap) {
+    (void)line; (void)reply; (void)cap; return 0;
+}
+extern "C" __attribute__((weak)) int HeadlessGame_State(const char *line, char *reply, size_t cap) {
+    (void)line; (void)reply; (void)cap; return 0;
+}
+// `talk` asks for an A press over the next frames after its reply.
+extern "C" __attribute__((weak)) int HeadlessGame_TakeInjectedPress(unsigned *mask, unsigned *xy, int *frames) {
+    (void)mask; (void)xy; (void)frames; return 0;
+}
+
+static long long s_budget = 0;       // frames still allowed to run
+static int s_pendingReply = 0;       // a step/press/touch finished; reply when it completes
+static unsigned s_heldMask = 0, s_heldXY = 0;
+static int s_touchActive = 0, s_touchX = 0, s_touchY = 0;
+
+// ---- minimal JSON extraction (flat objects; string/int/bool/array-of-strings values) ----
+static bool JsonFind(const std::string &s, const char *key, size_t *pos) {
+    std::string pat = std::string("\"") + key + "\"";
+    size_t p = s.find(pat);
+    if (p == std::string::npos) return false;
+    p = s.find(':', p + pat.size());
+    if (p == std::string::npos) return false;
+    *pos = p + 1;
+    return true;
+}
+static bool JsonString(const std::string &s, const char *key, std::string *out) {
+    size_t p; if (!JsonFind(s, key, &p)) return false;
+    while (p < s.size() && (s[p] == ' ' || s[p] == '\t')) p++;
+    if (p >= s.size() || s[p] != '"') return false;
+    size_t e = s.find('"', p + 1);
+    if (e == std::string::npos) return false;
+    *out = s.substr(p + 1, e - p - 1);
+    return true;
+}
+static bool JsonInt(const std::string &s, const char *key, long long *out) {
+    size_t p; if (!JsonFind(s, key, &p)) return false;
+    *out = strtoll(s.c_str() + p, nullptr, 10);
+    return true;
+}
+static bool JsonBool(const std::string &s, const char *key, bool *out) {
+    size_t p; if (!JsonFind(s, key, &p)) return false;
+    while (p < s.size() && (s[p] == ' ' || s[p] == '\t')) p++;
+    *out = s.compare(p, 4, "true") == 0;
+    return true;
+}
+
+static void ReplyOk(const char *extra = nullptr) {
+    char buf[512];
+    if (extra) snprintf(buf, sizeof buf, "{\"ok\":true,\"frame\":%llu,%s}", SIM_Headless_FrameCount(), extra);
+    else snprintf(buf, sizeof buf, "{\"ok\":true,\"frame\":%llu}", SIM_Headless_FrameCount());
+    SIM_Headless_Reply(buf);
+}
+static void ReplyError(const char *msg) {
+    char buf[512];
+    snprintf(buf, sizeof buf, "{\"ok\":false,\"error\":\"%s\",\"frame\":%llu}", msg, SIM_Headless_FrameCount());
+    SIM_Headless_Reply(buf);
+}
+
+static const struct { const char *name; unsigned bit; int isXY; } kKeys[] = {
+    {"A", 1u << 0, 0}, {"B", 1u << 1, 0}, {"SELECT", 1u << 2, 0}, {"START", 1u << 3, 0},
+    {"RIGHT", 1u << 4, 0}, {"LEFT", 1u << 5, 0}, {"UP", 1u << 6, 0}, {"DOWN", 1u << 7, 0},
+    {"R", 1u << 8, 0}, {"L", 1u << 9, 0}, {"X", 1u << 10, 1}, {"Y", 1u << 11, 1},
+};
+
+static void ApplyHeld(void) {
+    // Pad registers are active low. Release everything we might hold, then press the held set.
+    static unsigned prevMask = 0, prevXY = 0;
+    s_reg_PAD_KEYINPUT = (u16)((s_reg_PAD_KEYINPUT | prevMask) & ~s_heldMask);
+    *(vu16 *)HW_BUTTON_XY_BUF = (u16)((*(vu16 *)HW_BUTTON_XY_BUF | prevXY) & ~s_heldXY);
+    prevMask = s_heldMask; prevXY = s_heldXY;
+    if (s_touchActive) {
+        s_tpData.x = (u16)s_touchX; s_tpData.y = (u16)s_touchY;
+        s_tpData.touch = 1; s_tpData.validity = 0;
+    }
+}
+static void ClearHeld(void) {
+    s_heldMask = 0; s_heldXY = 0;
+    s_touchActive = 0;
+    ApplyHeld();
+    s_tpData.touch = 0; s_tpData.validity = 0;
+}
+
+// Read one line from stdin, waiting in slices so a future watchdog can fire while blocked.
+// Returns false on EOF.
+static bool ReadLine(std::string *out) {
+    out->clear();
+    for (;;) {
+        fd_set rf; FD_ZERO(&rf); FD_SET(STDIN_FILENO, &rf);
+        struct timeval tv {0, 100000};
+        int r = select(STDIN_FILENO + 1, &rf, nullptr, nullptr, &tv);
+        if (r < 0) return false;
+        if (r == 0) { SIM_Headless_WatchdogTick(); continue; }
+        char c;
+        ssize_t n = read(STDIN_FILENO, &c, 1);
+        if (n <= 0) return false;
+        if (c == '\n') return true;
+        out->push_back(c);
+        if (out->size() > 65536) return true;   // overlong line: process what we have
+    }
+}
+
+static void HandleState(const std::string &line) {
+    char reply[16384];
+    if (HeadlessGame_State && HeadlessGame_State(line.c_str(), reply, sizeof reply)) {
+        SIM_Headless_Reply(reply);
+        return;
+    }
+    char buf[256];
+    snprintf(buf, sizeof buf, "{\"ok\":true,\"frame\":%llu,\"app\":\"unknown\"}", SIM_Headless_FrameCount());
+    SIM_Headless_Reply(buf);
+}
+
+// Process one command line. Returns true when a frame budget was granted (game may run).
+static bool HandleCommand(const std::string &line) {
+    std::string cmd;
+    if (!JsonString(line, "cmd", &cmd)) { ReplyError("missing cmd"); return false; }
+
+    if (cmd == "step" || cmd == "press" || cmd == "touch") {
+        SIM_Headless_WatchdogInput();
+        long long frames = 1;
+        JsonInt(line, "frames", &frames);
+        if (frames < 0) frames = 0;
+        ClearHeld();
+        if (cmd == "press") {
+            // keys: ["A","UP",...]
+            size_t p;
+            if (JsonFind(line, "keys", &p)) {
+                size_t e = line.find(']', p);
+                std::string arr = line.substr(p, e == std::string::npos ? std::string::npos : e - p);
+                for (auto &k : kKeys)
+                    if (arr.find(std::string("\"") + k.name + "\"") != std::string::npos) {
+                        if (k.isXY) s_heldXY |= k.bit; else s_heldMask |= k.bit;
+                    }
+            }
+        } else if (cmd == "touch") {
+            long long x = 0, y = 0;
+            JsonInt(line, "x", &x); JsonInt(line, "y", &y);
+            s_touchActive = 1; s_touchX = (int)x; s_touchY = (int)y;
+        }
+        s_budget = frames;
+        s_pendingReply = 1;
+        ApplyHeld();
+        if (s_budget == 0) { s_pendingReply = 0; ReplyOk(); return false; }
+        return true;
+    }
+    if (cmd == "screenshot") {
+        std::string path;
+        if (!JsonString(line, "path", &path)) { ReplyError("screenshot needs path"); return false; }
+        if (SIM_Headless_Screenshot(path.c_str())) ReplyOk();
+        else ReplyError("screenshot failed");
+        return false;
+    }
+    if (cmd == "state") { HandleState(line); return false; }
+    if (cmd == "import_save") {
+        std::string path;
+        if (!JsonString(line, "path", &path)) { ReplyError("import_save needs path"); return false; }
+        ReplyOk("\"restarting\":true");
+        SIM::Helpers::ImportSave(path);   // restarts the process (fds survive execv)
+        s_budget = 30;                    // let Poll() perform the restart
+        return true;
+    }
+    if (cmd == "quit") {
+        ReplyOk();
+        fflush(nullptr);
+        _exit(0);
+    }
+    // Game-side commands (warp, set_var, set_flag, give_item, talk, ...).
+    {
+        char reply[4096];
+        if (HeadlessGame_Command && HeadlessGame_Command(line.c_str(), reply, sizeof reply)) {
+            SIM_Headless_Reply(reply);
+            unsigned mask = 0, xy = 0; int frames = 0;
+            if (HeadlessGame_TakeInjectedPress(&mask, &xy, &frames) && frames > 0) {
+                ClearHeld();
+                s_heldMask = mask; s_heldXY = xy;
+                s_budget = frames;
+                ApplyHeld();
+                return true;   // run the injected press frames (no second reply)
+            }
+            return false;
+        }
+    }
+    ReplyError("unknown cmd");
+    return false;
+}
+
+// Once a second: hash a downsampled centre patch of the frame plus the state reply,
+// for the watchdog's soft-freeze check. Cheap: 48x32 readback, once a second.
+static void SampleForWatchdog(void) {
+    using namespace std::chrono;
+    static long long lastMs = 0;
+    long long now = duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+    if (now - lastMs < 1000) return;
+    lastMs = now;
+    unsigned char px[48 * 32 * 4];
+    glReadBuffer(GL_BACK);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(112, 176, 48, 32, GL_RGBA, GL_UNSIGNED_BYTE, px);   // centre of the 512x768 frame
+    unsigned long long hash = 1469598103934665603ULL;
+    for (size_t i = 0; i < sizeof px; i += 16) { hash ^= px[i]; hash *= 1099511628211ULL; }
+    char state[4096];
+    state[0] = 0;
+    if (HeadlessGame_State) HeadlessGame_State("{\"cmd\":\"state\"}", state, sizeof state);
+    for (const char *p = state; *p; p++) { hash ^= (unsigned char)*p; hash *= 1099511628211ULL; }
+    SIM_Headless_WatchdogSample(hash);
+}
+
+extern "C" void SIM_Headless_ControlFrame(void) {
+    if (!SIM_Control_Enabled()) return;
+    SampleForWatchdog();
+    if (s_budget > 0) {
+        s_budget--;
+        ApplyHeld();
+        if (s_budget > 0) return;
+        // Budget just finished: fall through, reply, and block for the next command.
+    }
+    if (s_pendingReply) { s_pendingReply = 0; ReplyOk(); }
+    ClearHeld();
+    std::string line;
+    for (;;) {
+        if (!ReadLine(&line)) { fflush(nullptr); _exit(0); }   // stdin EOF: quit
+        if (line.empty()) continue;
+        if (HandleCommand(line)) return;   // frames granted: let the game run
+    }
+}
diff --git a/libraries/sim/src/sim_headless_watchdog.cpp b/libraries/sim/src/sim_headless_watchdog.cpp
new file mode 100644
index 0000000..7bfcd2e
--- /dev/null
+++ b/libraries/sim/src/sim_headless_watchdog.cpp
@@ -0,0 +1,178 @@
+// Assert / crash reporting and the watchdog (docs/headless_protocol.md, step 4).
+// Headless: GF_ASSERT and fatal signals print file:line, message and a symbolized
+// backtrace to stderr, then exit 134. The watchdog exits 124 with a state dump when
+// no frame completes for SIM_WATCHDOG_SEC seconds (default 30 in headless mode).
+// Interactive (non-headless): assert info is appended to log.txt and shown in a
+// message box, then the process exits 134 instead of hanging silently.
+#include "simulator/sim_headless.h"
+
+#include <SDL2/SDL.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+
+#include <csignal>
+#include <unistd.h>
+#if defined(__linux__) || defined(__APPLE__)
+#include <execinfo.h>
+#endif
+
+// Weak definition lives in sim_headless_control.cpp; overridden by the game.
+extern "C" int HeadlessGame_State(const char *line, char *reply, size_t cap);
+
+static std::atomic<long long> s_lastFrameMs{0};
+static std::atomic<bool> s_waitingForInput{false};
+static std::atomic<bool> s_armed{false};
+static long long s_timeoutMs = 30000;
+static bool s_started = false;
+
+static long long NowMs();
+
+// Soft-freeze check: combined framebuffer+state hash, sampled by the control layer.
+static std::atomic<unsigned long long> s_lastHash{0};
+static std::atomic<long long> s_lastHashChangeMs{0};
+static std::atomic<long long> s_lastInputMs{0};
+
+extern "C" void SIM_Headless_WatchdogInput(void) {
+    s_lastInputMs.store(NowMs());
+}
+
+extern "C" void SIM_Headless_WatchdogSample(unsigned long long hash) {
+    if (hash != s_lastHash.load()) {
+        s_lastHash.store(hash);
+        s_lastHashChangeMs.store(NowMs());
+    } else if (s_lastHashChangeMs.load() == 0) {
+        s_lastHashChangeMs.store(NowMs());
+    }
+}
+
+static long long NowMs() {
+    using namespace std::chrono;
+    return duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+}
+
+static void PrintBacktrace() {
+#if defined(__linux__) || defined(__APPLE__)
+    void *frames[64];
+    int n = backtrace(frames, 64);
+    if (n > 0) backtrace_symbols_fd(frames, n, STDERR_FILENO);
+#endif
+}
+extern "C" void SIM_Headless_DumpState(const char *reason) {
+    char buf[16384];
+    buf[0] = 0;
+    if (HeadlessGame_State) HeadlessGame_State("{\"cmd\":\"state\"}", buf, sizeof buf);
+    fprintf(stderr, "SIM state dump (%s): frame=%llu state=%s\n",
+            reason ? reason : "?", SIM_Headless_FrameCount(), buf[0] ? buf : "{}");
+    fflush(stderr);
+}
+
+extern "C" void SIM_Headless_AssertFail(const char *file, int line, const char *msg) {
+    if (SIM_Headless_Enabled() || SIM_Control_Enabled()) {
+        fprintf(stderr, "GF_ASSERT %s:%d: %s\n", file ? file : "?", line, msg ? msg : "");
+        SIM_Headless_DumpState("assert");
+        PrintBacktrace();
+        fflush(stderr);
+        _exit(134);
+    }
+    // Interactive: log.txt + message box instead of a silent hang.
+    char text[2048];
+    snprintf(text, sizeof text, "Assertion failed: %s:%d: %s", file ? file : "?", line, msg ? msg : "");
+    if (FILE *f = fopen("log.txt", "a")) { fprintf(f, "%s\n", text); fclose(f); }
+    fprintf(stderr, "%s\n", text);
+    PrintBacktrace();
+    SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Dazzling Platinum", text, nullptr);
+    fflush(nullptr);
+    _exit(134);
+}
+
+// ---- watchdog ----
+
+static void WatchdogThread() {
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        if (!s_armed.load()) continue;
+        if (s_waitingForInput.load()) continue;   // lockstep idle: legitimately blocked on stdin
+        long long last = s_lastFrameMs.load();
+        if (last == 0) continue;
+        if (NowMs() - last > s_timeoutMs) {
+            fprintf(stderr, "SIM watchdog: no frame completed for %lld ms (limit %lld ms)\n",
+                    NowMs() - last, s_timeoutMs);
+            SIM_Headless_DumpState("watchdog");
+            PrintBacktrace();
+            fflush(stderr);
+            _exit(124);
+        }
+        // Soft freeze: inputs are being sent, frames render, but screen+state never change.
+        long long lastInput = s_lastInputMs.load();
+        long long lastChange = s_lastHashChangeMs.load();
+        if (SIM_Control_Enabled() && lastInput > 0 && lastChange > 0 &&
+            lastInput > lastChange && NowMs() - lastChange > s_timeoutMs) {
+            fprintf(stderr, "SIM watchdog: screen and state frozen for %lld ms while inputs are being sent (limit %lld ms)\n",
+                    NowMs() - lastChange, s_timeoutMs);
+            SIM_Headless_DumpState("watchdog-soft-freeze");
+            PrintBacktrace();
+            fflush(stderr);
+            _exit(124);
+        }
+    }
+}
+
+static void StartWatchdogOnce() {
+    if (s_started) return;
+    s_started = true;
+    const char *e = getenv("SIM_WATCHDOG_SEC");
+    if (e) s_timeoutMs = atoll(e) * 1000;
+    if (s_timeoutMs < 0) s_timeoutMs = 0;
+    bool on = (SIM_Headless_Enabled() || SIM_Control_Enabled()) && s_timeoutMs > 0;
+    if (e && atoll(e) == 0) on = false;   // SIM_WATCHDOG_SEC=0 disables
+    s_armed.store(on);
+    s_lastFrameMs.store(NowMs());
+    if (on) {
+        std::thread(WatchdogThread).detach();
+        fprintf(stderr, "SIM watchdog: armed, %lld ms\n", s_timeoutMs);
+    }
+}
+
+extern "C" void SIM_Headless_WatchdogFrame(void) {
+    StartWatchdogOnce();
+    s_waitingForInput.store(false);
+    s_lastFrameMs.store(NowMs());
+}
+
+extern "C" void SIM_Headless_WatchdogTick(void) {
+    StartWatchdogOnce();
+    // Blocked reading commands: the game is idle by design, not frozen.
+    s_waitingForInput.store(true);
+}
+
+// ---- signal handlers (best effort) ----
+
+static void CrashHandler(int sig) {
+    const char *name = sig == SIGSEGV ? "SIGSEGV" : sig == SIGBUS ? "SIGBUS" : sig == SIGABRT ? "SIGABRT" : "signal";
+    char buf[128];
+    int n = snprintf(buf, sizeof buf, "SIM crash: %s (%d) at frame=%llu\n", name, sig, SIM_Headless_FrameCount());
+    if (n > 0) { ssize_t ignored = write(STDERR_FILENO, buf, (size_t)n); (void)ignored; }
+#if defined(__linux__) || defined(__APPLE__)
+    void *frames[48];
+    int count = backtrace(frames, 48);
+    if (count > 0) backtrace_symbols_fd(frames, count, STDERR_FILENO);
+#endif
+    _exit(134);
+}
+
+extern "C" void SIM_Headless_InstallCrashHandlers(void) {
+    if (!SIM_Headless_Enabled() && !SIM_Control_Enabled()) return;
+    struct sigaction sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_handler = CrashHandler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0;
+    sigaction(SIGSEGV, &sa, nullptr);
+    sigaction(SIGBUS, &sa, nullptr);
+    sigaction(SIGABRT, &sa, nullptr);
+}
diff --git a/libraries/sim/src/sim_helpers.cpp b/libraries/sim/src/sim_helpers.cpp
new file mode 100644
index 0000000..ad4cb80
--- /dev/null
+++ b/libraries/sim/src/sim_helpers.cpp
@@ -0,0 +1,360 @@
+// Player helpers for PC builds: a fast-forward badge and short messages drawn over the game, and save import/export.
+//
+// Saves: the game reads and writes save.bin in its working directory, a raw image of the DS cartridge's 512 KB flash, so it is
+// the same format as the .sav DeSmuME (File > Export Backup Memory), melonDS and real-cartridge dumpers use. Import also takes a
+// DeSmuME .dsv (a raw image followed by a 122-byte footer). Before an import the current save is copied to save-backups/.
+
+#include "simulator/sim.h"
+#include "simulator/sim_helpers.hpp"
+#include "simulator/sim_gui.hpp"
+
+#include "simulator/imgui/imgui.hpp"
+
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <limits.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifdef __APPLE__
+#include <crt_externs.h>
+#include <mach-o/dyld.h>
+#endif
+
+namespace SIM::Helpers {
+
+#include "simulator/sim_headless.h"
+// SIM_SAVE_PATH (SIM_GetSaveBinPath) redirects the save; backups go in save-backups/ next to it.
+static const char * kSaveFileFallback = "save.bin";
+static std::string SaveFile() { return SIM_GetSaveBinPath(); }
+static std::string BackupDir() {
+    std::string p = SaveFile();
+    size_t slash = p.find_last_of('/');
+    return (slash == std::string::npos ? std::string("save-backups") : p.substr(0, slash) + "/save-backups");
+}
+static const size_t kFlashSize = 512 * 1024;
+static const unsigned kSectorSignature = 0x20060623;   // Gen 4 save block footer signature
+static const char kDsvCookie[] = "|-DESMUME SAVE-|";
+static const size_t kDsvFooterSize = 122;
+
+static std::mutex sToastLock;
+static std::string sToastText;
+static double sToastUntil = 0;
+static std::atomic<bool> sBusy{false};      // a dialog or file operation is running
+static std::atomic<bool> sRestart{false};   // restart after an import
+
+static double Now() {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (double)t.tv_sec + (double)t.tv_nsec / 1e9;
+}
+
+void Toast(const std::string & message, double seconds) {
+    std::lock_guard<std::mutex> lock(sToastLock);
+    sToastText = message;
+    sToastUntil = Now() + seconds;
+    printf("SIM helpers: %s\n", message.c_str());
+    fflush(stdout);
+}
+
+// ---------------------------------------------------------------------------------------------------------------- overlay
+
+void DrawOverlay() {
+    ImDrawList * dl = ImGui::GetForegroundDrawList();
+    ImVec2 display = ImGui::GetIO().DisplaySize;
+    float scale = display.x / 512.0f;
+    if (scale < 1.0f) scale = 1.0f;
+    ImFont * font = ImGui::GetFont();
+    float fontSize = 13.0f * scale;
+
+    double speed = 0;
+    int ff = SIM_GetFastForward(&speed);
+    if (SIM::GUI::IsGameLogicPaused()) {
+        // Pause badge in the top-right corner: two bars and PAUSED
+        const char * label = "PAUSED";
+        ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, 0.0f, label);
+        float h = 20.0f * scale, pad = 6.0f * scale, bar = 3.0f * scale, barH = 10.0f * scale;
+        float w = pad + bar * 3 + 4.0f * scale + textSize.x + pad;
+        ImVec2 p1(display.x - w - 6.0f * scale, 6.0f * scale);
+        ImVec2 p2(p1.x + w, p1.y + h);
+        dl->AddRectFilled(p1, p2, IM_COL32(0, 0, 0, 150), h / 2);
+        float cy = p1.y + h / 2, x = p1.x + pad;
+        ImU32 white = IM_COL32(255, 255, 255, 235);
+        dl->AddRectFilled(ImVec2(x, cy - barH / 2), ImVec2(x + bar, cy + barH / 2), white);
+        dl->AddRectFilled(ImVec2(x + bar * 2, cy - barH / 2), ImVec2(x + bar * 3, cy + barH / 2), white);
+        dl->AddText(font, fontSize, ImVec2(x + bar * 3 + 4.0f * scale, cy - textSize.y / 2), white, label);
+    } else if (ff != 0) {
+        // Badge in the top-right corner: two triangles and the speed
+        char label[16];
+        if (ff == 2) snprintf(label, sizeof label, "MAX");
+        else if (speed == (int)speed) snprintf(label, sizeof label, "%dx", (int)speed);
+        else snprintf(label, sizeof label, "%.1fx", speed);
+        ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, 0.0f, label);
+        float h = 20.0f * scale, pad = 6.0f * scale, tri = 7.0f * scale;
+        float w = pad + tri * 2 + 4.0f * scale + textSize.x + pad;
+        ImVec2 p1(display.x - w - 6.0f * scale, 6.0f * scale);
+        ImVec2 p2(p1.x + w, p1.y + h);
+        dl->AddRectFilled(p1, p2, IM_COL32(0, 0, 0, 150), h / 2);
+        float cy = p1.y + h / 2, x = p1.x + pad;
+        ImU32 white = IM_COL32(255, 255, 255, 235);
+        dl->AddTriangleFilled(ImVec2(x, cy - tri * 0.75f), ImVec2(x + tri, cy), ImVec2(x, cy + tri * 0.75f), white);
+        dl->AddTriangleFilled(ImVec2(x + tri, cy - tri * 0.75f), ImVec2(x + tri * 2, cy), ImVec2(x + tri, cy + tri * 0.75f), white);
+        dl->AddText(font, fontSize, ImVec2(x + tri * 2 + 4.0f * scale, cy - textSize.y / 2), white, label);
+    }
+
+    std::string toast;
+    {
+        std::lock_guard<std::mutex> lock(sToastLock);
+        if (Now() < sToastUntil) toast = sToastText;
+    }
+    if (!toast.empty()) {
+        float maxWidth = display.x - 40.0f * scale;
+        ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, maxWidth, toast.c_str());
+        float pad = 8.0f * scale;
+        ImVec2 p1((display.x - textSize.x) / 2 - pad, 32.0f * scale);
+        ImVec2 p2(p1.x + textSize.x + pad * 2, p1.y + textSize.y + pad * 2);
+        dl->AddRectFilled(p1, p2, IM_COL32(0, 0, 0, 190), 6.0f * scale);
+        dl->AddText(font, fontSize, ImVec2(p1.x + pad, p1.y + pad), IM_COL32(255, 255, 255, 255), toast.c_str(), nullptr, maxWidth);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------- files
+
+static bool ReadFile(const std::string & path, std::vector<unsigned char> & out, size_t maxSize) {
+    FILE * f = fopen(path.c_str(), "rb");
+    if (!f) return false;
+    out.clear();
+    unsigned char buf[65536];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof buf, f)) > 0) {
+        out.insert(out.end(), buf, buf + n);
+        if (out.size() > maxSize) { fclose(f); return false; }
+    }
+    fclose(f);
+    return true;
+}
+
+// Write via a temporary file and rename, so a failed write never leaves half a file
+static bool WriteFile(const std::string & path, const std::vector<unsigned char> & data) {
+    std::string tmp = path + ".tmp";
+    FILE * f = fopen(tmp.c_str(), "wb");
+    if (!f) return false;
+    bool ok = fwrite(data.data(), 1, data.size(), f) == data.size();
+    ok = (fclose(f) == 0) && ok;
+    if (!ok || rename(tmp.c_str(), path.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    return true;
+}
+
+static std::string BaseName(const std::string & path) {
+    size_t slash = path.find_last_of('/');
+    return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+static std::string Timestamp() {
+    time_t t = time(nullptr);
+    struct tm tmv;
+    localtime_r(&t, &tmv);
+    char buf[32];
+    strftime(buf, sizeof buf, "%Y%m%d-%H%M%S", &tmv);
+    return buf;
+}
+
+static unsigned Read32(const unsigned char * p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((unsigned)p[3] << 24); }
+
+// A Platinum save has a block footer signature at 0xCF24 in its primary (0x00000) or backup (0x40000) half. 0xCF38 is the
+// layout of saves from older versions of this port, which the game upgrades when it loads them.
+static bool LooksLikePlatinumSave(const std::vector<unsigned char> & d) {
+    const size_t offsets[] = {0xCF24, 0x40000 + 0xCF24, 0xCF38, 0x40000 + 0xCF38};
+    for (size_t off : offsets)
+        if (off + 4 <= d.size() && Read32(&d[off]) == kSectorSignature) return true;
+    return false;
+}
+
+// ---------------------------------------------------------------------------------------------------------------- dialogs
+
+#ifdef __APPLE__
+static std::string AppleScriptString(const std::string & s) {
+    std::string out = "\"";
+    for (char c : s) {
+        if (c == '"' || c == '\\') out += '\\';
+        out += c;
+    }
+    return out + "\"";
+}
+
+// Runs an AppleScript with osascript; false when it fails or the player cancels
+static bool RunAppleScript(const std::string & script, std::string * result) {
+    char tmpl[] = "/tmp/pokeplatinum-dialog-XXXXXX";
+    int fd = mkstemp(tmpl);
+    if (fd < 0) return false;
+    bool wrote = write(fd, script.data(), script.size()) == (ssize_t)script.size();
+    close(fd);
+    if (!wrote) { unlink(tmpl); return false; }
+    std::string cmd = std::string("/usr/bin/osascript ") + tmpl + " 2>/dev/null";
+    FILE * p = popen(cmd.c_str(), "r");
+    std::string out;
+    if (p) {
+        char buf[1024];
+        size_t n;
+        while ((n = fread(buf, 1, sizeof buf, p)) > 0) out.append(buf, n);
+    }
+    int status = p ? pclose(p) : -1;
+    unlink(tmpl);
+    while (!out.empty() && (out.back() == '\n' || out.back() == '\r')) out.pop_back();
+    if (result) *result = out;
+    return status == 0;
+}
+
+static std::string DefaultFolder(bool forImport) {
+    const char * home = getenv("HOME");
+    if (!home) return "/";
+    struct stat st;
+    if (forImport) {
+        // OpenEmu keeps DeSmuME saves here
+        std::string openEmu = std::string(home) + "/Library/Application Support/OpenEmu/DeSmuME/Battery Saves";
+        if (stat(openEmu.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) return openEmu;
+    }
+    std::string docs = std::string(home) + "/Documents";
+    return (stat(docs.c_str(), &st) == 0) ? docs : home;
+}
+#endif
+
+// ---------------------------------------------------------------------------------------------------------------- export
+
+static void DoExport(std::string path) {
+    std::vector<unsigned char> data;
+    if (!ReadFile(SaveFile(), data, 4 * kFlashSize) || data.empty()) {
+        Toast("No save yet: save in the game first");
+        return;
+    }
+    if (data.size() < kFlashSize) data.resize(kFlashSize, 0xFF);   // erased flash reads as 0xFF
+
+    if (path.empty()) {
+#ifdef __APPLE__
+        std::string script = "activate\nPOSIX path of (choose file name with prompt " + AppleScriptString("Export the save (.sav)") +
+                             " default name " + AppleScriptString("Pokemon Platinum " + Timestamp() + ".sav") +
+                             " default location (POSIX file " + AppleScriptString(DefaultFolder(false)) + "))";
+        if (!RunAppleScript(script, &path) || path.empty()) return;   // cancelled
+#else
+        Toast("Save export needs a path on this platform");
+        return;
+#endif
+    }
+    if (WriteFile(path, data)) Toast("Save exported to " + BaseName(path));
+    else Toast("Could not write " + path + ": " + strerror(errno));
+}
+
+void ExportSave(const std::string & path) {
+    if (sBusy.exchange(true)) return;
+    std::thread([path] { DoExport(path); sBusy = false; }).detach();
+}
+
+// ---------------------------------------------------------------------------------------------------------------- import
+
+static void DoImport(std::string path) {
+    bool interactive = path.empty();
+#ifdef __APPLE__
+    if (interactive) {
+        std::string script = "activate\nPOSIX path of (choose file with prompt " +
+                             AppleScriptString("Import a save (.sav, or a DeSmuME .dsv)") +
+                             " default location (POSIX file " + AppleScriptString(DefaultFolder(true)) + "))";
+        if (!RunAppleScript(script, &path) || path.empty()) return;   // cancelled
+    }
+#else
+    if (interactive) { Toast("Save import needs a path on this platform"); return; }
+#endif
+
+    std::vector<unsigned char> data;
+    if (!ReadFile(path, data, 4 * kFlashSize)) {
+        Toast("Could not read " + BaseName(path) + " (missing, or larger than a DS save)");
+        return;
+    }
+    // DeSmuME .dsv: the raw image, then a footer ending in its cookie
+    if (data.size() >= kDsvFooterSize && memcmp(&data[data.size() - 16], kDsvCookie, 16) == 0) {
+        size_t raw = data.size() - kDsvFooterSize;
+        size_t used = Read32(&data[raw + 82]);   // the footer's "actual size"
+        data.resize(used > 0 && used <= raw ? used : raw);
+    }
+    if (data.size() > kFlashSize) data.resize(kFlashSize);
+    if (data.size() < kFlashSize) data.resize(kFlashSize, 0xFF);
+    if (!LooksLikePlatinumSave(data)) {
+        bool empty = true;
+        for (unsigned char b : data) if (b != 0 && b != 0xFF) { empty = false; break; }
+        Toast(BaseName(path) + (empty ? " is empty (no game saved in it)" : " is not a Pokemon Platinum save"), 5.0);
+        return;
+    }
+
+#ifdef __APPLE__
+    if (interactive) {
+        std::string script = "activate\ndisplay dialog " +
+                             AppleScriptString("Replace the current save with " + BaseName(path) +
+                                               "?\n\nThe current save is kept in save-backups. The game restarts to load the imported save; "
+                                               "progress since your last in-game save is lost.") +
+                             " buttons {\"Cancel\", \"Import and Restart\"} default button 2 with icon caution";
+        if (!RunAppleScript(script, nullptr)) return;   // cancelled
+    }
+#endif
+
+    // Keep the current save
+    std::vector<unsigned char> current;
+    bool blank = true;   // the game creates an all-zero save.bin before anything is saved
+    if (ReadFile(SaveFile(), current, 4 * kFlashSize))
+        for (unsigned char b : current) if (b != 0 && b != 0xFF) { blank = false; break; }
+    if (!blank) {
+        mkdir(BackupDir().c_str(), 0755);
+        std::string backup = BackupDir() + "/save-" + Timestamp() + ".sav";
+        if (!WriteFile(backup, current)) {
+            Toast("Could not back up the current save; nothing imported");
+            return;
+        }
+    }
+    if (!WriteFile(SaveFile(), data)) {
+        Toast(std::string("Could not write the save: ") + strerror(errno));
+        return;
+    }
+    Toast("Imported " + BaseName(path) + ", restarting");
+    sRestart = true;
+}
+
+void ImportSave(const std::string & path) {
+    if (sBusy.exchange(true)) return;
+    std::thread([path] { DoImport(path); sBusy = false; }).detach();
+}
+
+// ---------------------------------------------------------------------------------------------------------------- restart
+
+void Poll() {
+    if (!sRestart) return;
+    sRestart = false;
+#ifdef __APPLE__
+    // Run this executable again with the same arguments, working directory and output
+    char exe[PATH_MAX];
+    uint32_t size = sizeof exe;
+    if (_NSGetExecutablePath(exe, &size) == 0) {
+        char ** argv = *_NSGetArgv();
+        fflush(stdout);
+        execv(exe, argv);
+    }
+#else
+    char exe[PATH_MAX];
+    ssize_t n = readlink("/proc/self/exe", exe, sizeof exe - 1);
+    if (n > 0) {
+        exe[n] = 0;
+        char * argv[] = {exe, nullptr};
+        fflush(stdout);
+        execv(exe, argv);
+    }
+#endif
+    Toast("Imported; quit and reopen the game to load it", 8.0);
+}
+
