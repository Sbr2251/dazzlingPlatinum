diff --git a/libraries/sim/src/sim_helpers.cpp b/libraries/sim/src/sim_helpers.cpp
new file mode 100644
index 0000000..74d53a8
--- /dev/null
+++ b/libraries/sim/src/sim_helpers.cpp
@@ -0,0 +1,353 @@
+// Player helpers for PC builds: a fast-forward badge and short messages drawn over the game, and save import/export.
+//
+// Saves: the game reads and writes save.bin in its working directory, a raw image of the DS cartridge's 512 KB flash, so it is
+// the same format as the .sav DeSmuME (File > Export Backup Memory), melonDS and real-cartridge dumpers use. Import also takes a
+// DeSmuME .dsv (a raw image followed by a 122-byte footer). Before an import the current save is copied to save-backups/.
+
+#include "simulator/sim.h"
+#include "simulator/sim_helpers.hpp"
+#include "simulator/sim_gui.hpp"
+
+#include "simulator/imgui/imgui.hpp"
+
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <limits.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifdef __APPLE__
+#include <crt_externs.h>
+#include <mach-o/dyld.h>
+#endif
+
+namespace SIM::Helpers {
+
+static const char * kSaveFile = "save.bin";
+static const char * kBackupDir = "save-backups";
+static const size_t kFlashSize = 512 * 1024;
+static const unsigned kSectorSignature = 0x20060623;   // Gen 4 save block footer signature
+static const char kDsvCookie[] = "|-DESMUME SAVE-|";
+static const size_t kDsvFooterSize = 122;
+
+static std::mutex sToastLock;
+static std::string sToastText;
+static double sToastUntil = 0;
+static std::atomic<bool> sBusy{false};      // a dialog or file operation is running
+static std::atomic<bool> sRestart{false};   // restart after an import
+
+static double Now() {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (double)t.tv_sec + (double)t.tv_nsec / 1e9;
+}
+
+void Toast(const std::string & message, double seconds) {
+    std::lock_guard<std::mutex> lock(sToastLock);
+    sToastText = message;
+    sToastUntil = Now() + seconds;
+    printf("SIM helpers: %s\n", message.c_str());
+    fflush(stdout);
+}
+
+// ---------------------------------------------------------------------------------------------------------------- overlay
+
+void DrawOverlay() {
+    ImDrawList * dl = ImGui::GetForegroundDrawList();
+    ImVec2 display = ImGui::GetIO().DisplaySize;
+    float scale = display.x / 512.0f;
+    if (scale < 1.0f) scale = 1.0f;
+    ImFont * font = ImGui::GetFont();
+    float fontSize = 13.0f * scale;
+
+    double speed = 0;
+    int ff = SIM_GetFastForward(&speed);
+    if (SIM::GUI::IsGameLogicPaused()) {
+        // Pause badge in the top-right corner: two bars and PAUSED
+        const char * label = "PAUSED";
+        ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, 0.0f, label);
+        float h = 20.0f * scale, pad = 6.0f * scale, bar = 3.0f * scale, barH = 10.0f * scale;
+        float w = pad + bar * 3 + 4.0f * scale + textSize.x + pad;
+        ImVec2 p1(display.x - w - 6.0f * scale, 6.0f * scale);
+        ImVec2 p2(p1.x + w, p1.y + h);
+        dl->AddRectFilled(p1, p2, IM_COL32(0, 0, 0, 150), h / 2);
+        float cy = p1.y + h / 2, x = p1.x + pad;
+        ImU32 white = IM_COL32(255, 255, 255, 235);
+        dl->AddRectFilled(ImVec2(x, cy - barH / 2), ImVec2(x + bar, cy + barH / 2), white);
+        dl->AddRectFilled(ImVec2(x + bar * 2, cy - barH / 2), ImVec2(x + bar * 3, cy + barH / 2), white);
+        dl->AddText(font, fontSize, ImVec2(x + bar * 3 + 4.0f * scale, cy - textSize.y / 2), white, label);
+    } else if (ff != 0) {
+        // Badge in the top-right corner: two triangles and the speed
+        char label[16];
+        if (ff == 2) snprintf(label, sizeof label, "MAX");
+        else if (speed == (int)speed) snprintf(label, sizeof label, "%dx", (int)speed);
+        else snprintf(label, sizeof label, "%.1fx", speed);
+        ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, 0.0f, label);
+        float h = 20.0f * scale, pad = 6.0f * scale, tri = 7.0f * scale;
+        float w = pad + tri * 2 + 4.0f * scale + textSize.x + pad;
+        ImVec2 p1(display.x - w - 6.0f * scale, 6.0f * scale);
+        ImVec2 p2(p1.x + w, p1.y + h);
+        dl->AddRectFilled(p1, p2, IM_COL32(0, 0, 0, 150), h / 2);
+        float cy = p1.y + h / 2, x = p1.x + pad;
+        ImU32 white = IM_COL32(255, 255, 255, 235);
+        dl->AddTriangleFilled(ImVec2(x, cy - tri * 0.75f), ImVec2(x + tri, cy), ImVec2(x, cy + tri * 0.75f), white);
+        dl->AddTriangleFilled(ImVec2(x + tri, cy - tri * 0.75f), ImVec2(x + tri * 2, cy), ImVec2(x + tri, cy + tri * 0.75f), white);
+        dl->AddText(font, fontSize, ImVec2(x + tri * 2 + 4.0f * scale, cy - textSize.y / 2), white, label);
+    }
+
+    std::string toast;
+    {
+        std::lock_guard<std::mutex> lock(sToastLock);
+        if (Now() < sToastUntil) toast = sToastText;
+    }
+    if (!toast.empty()) {
+        float maxWidth = display.x - 40.0f * scale;
+        ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, maxWidth, toast.c_str());
+        float pad = 8.0f * scale;
+        ImVec2 p1((display.x - textSize.x) / 2 - pad, 32.0f * scale);
+        ImVec2 p2(p1.x + textSize.x + pad * 2, p1.y + textSize.y + pad * 2);
+        dl->AddRectFilled(p1, p2, IM_COL32(0, 0, 0, 190), 6.0f * scale);
+        dl->AddText(font, fontSize, ImVec2(p1.x + pad, p1.y + pad), IM_COL32(255, 255, 255, 255), toast.c_str(), nullptr, maxWidth);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------- files
+
+static bool ReadFile(const std::string & path, std::vector<unsigned char> & out, size_t maxSize) {
+    FILE * f = fopen(path.c_str(), "rb");
+    if (!f) return false;
+    out.clear();
+    unsigned char buf[65536];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof buf, f)) > 0) {
+        out.insert(out.end(), buf, buf + n);
+        if (out.size() > maxSize) { fclose(f); return false; }
+    }
+    fclose(f);
+    return true;
+}
+
+// Write via a temporary file and rename, so a failed write never leaves half a file
+static bool WriteFile(const std::string & path, const std::vector<unsigned char> & data) {
+    std::string tmp = path + ".tmp";
+    FILE * f = fopen(tmp.c_str(), "wb");
+    if (!f) return false;
+    bool ok = fwrite(data.data(), 1, data.size(), f) == data.size();
+    ok = (fclose(f) == 0) && ok;
+    if (!ok || rename(tmp.c_str(), path.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    return true;
+}
+
+static std::string BaseName(const std::string & path) {
+    size_t slash = path.find_last_of('/');
+    return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+static std::string Timestamp() {
+    time_t t = time(nullptr);
+    struct tm tmv;
+    localtime_r(&t, &tmv);
+    char buf[32];
+    strftime(buf, sizeof buf, "%Y%m%d-%H%M%S", &tmv);
+    return buf;
+}
+
+static unsigned Read32(const unsigned char * p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((unsigned)p[3] << 24); }
+
+// A Platinum save has a block footer signature at 0xCF24 in its primary (0x00000) or backup (0x40000) half. 0xCF38 is the
+// layout of saves from older versions of this port, which the game upgrades when it loads them.
+static bool LooksLikePlatinumSave(const std::vector<unsigned char> & d) {
+    const size_t offsets[] = {0xCF24, 0x40000 + 0xCF24, 0xCF38, 0x40000 + 0xCF38};
+    for (size_t off : offsets)
+        if (off + 4 <= d.size() && Read32(&d[off]) == kSectorSignature) return true;
+    return false;
+}
+
+// ---------------------------------------------------------------------------------------------------------------- dialogs
+
+#ifdef __APPLE__
+static std::string AppleScriptString(const std::string & s) {
+    std::string out = "\"";
+    for (char c : s) {
+        if (c == '"' || c == '\\') out += '\\';
+        out += c;
+    }
+    return out + "\"";
+}
+
+// Runs an AppleScript with osascript; false when it fails or the player cancels
+static bool RunAppleScript(const std::string & script, std::string * result) {
+    char tmpl[] = "/tmp/pokeplatinum-dialog-XXXXXX";
+    int fd = mkstemp(tmpl);
+    if (fd < 0) return false;
+    bool wrote = write(fd, script.data(), script.size()) == (ssize_t)script.size();
+    close(fd);
+    if (!wrote) { unlink(tmpl); return false; }
+    std::string cmd = std::string("/usr/bin/osascript ") + tmpl + " 2>/dev/null";
+    FILE * p = popen(cmd.c_str(), "r");
+    std::string out;
+    if (p) {
+        char buf[1024];
+        size_t n;
+        while ((n = fread(buf, 1, sizeof buf, p)) > 0) out.append(buf, n);
+    }
+    int status = p ? pclose(p) : -1;
+    unlink(tmpl);
+    while (!out.empty() && (out.back() == '\n' || out.back() == '\r')) out.pop_back();
+    if (result) *result = out;
+    return status == 0;
+}
+
+static std::string DefaultFolder(bool forImport) {
+    const char * home = getenv("HOME");
+    if (!home) return "/";
+    struct stat st;
+    if (forImport) {
+        // OpenEmu keeps DeSmuME saves here
+        std::string openEmu = std::string(home) + "/Library/Application Support/OpenEmu/DeSmuME/Battery Saves";
+        if (stat(openEmu.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) return openEmu;
+    }
+    std::string docs = std::string(home) + "/Documents";
+    return (stat(docs.c_str(), &st) == 0) ? docs : home;
+}
+#endif
+
+// ---------------------------------------------------------------------------------------------------------------- export
+
+static void DoExport(std::string path) {
+    std::vector<unsigned char> data;
+    if (!ReadFile(kSaveFile, data, 4 * kFlashSize) || data.empty()) {
+        Toast("No save yet: save in the game first");
+        return;
+    }
+    if (data.size() < kFlashSize) data.resize(kFlashSize, 0xFF);   // erased flash reads as 0xFF
+
+    if (path.empty()) {
+#ifdef __APPLE__
+        std::string script = "activate\nPOSIX path of (choose file name with prompt " + AppleScriptString("Export the save (.sav)") +
+                             " default name " + AppleScriptString("Pokemon Platinum " + Timestamp() + ".sav") +
+                             " default location (POSIX file " + AppleScriptString(DefaultFolder(false)) + "))";
+        if (!RunAppleScript(script, &path) || path.empty()) return;   // cancelled
+#else
+        Toast("Save export needs a path on this platform");
+        return;
+#endif
+    }
+    if (WriteFile(path, data)) Toast("Save exported to " + BaseName(path));
+    else Toast("Could not write " + path + ": " + strerror(errno));
+}
+
+void ExportSave(const std::string & path) {
+    if (sBusy.exchange(true)) return;
+    std::thread([path] { DoExport(path); sBusy = false; }).detach();
+}
+
+// ---------------------------------------------------------------------------------------------------------------- import
+
+static void DoImport(std::string path) {
+    bool interactive = path.empty();
+#ifdef __APPLE__
+    if (interactive) {
+        std::string script = "activate\nPOSIX path of (choose file with prompt " +
+                             AppleScriptString("Import a save (.sav, or a DeSmuME .dsv)") +
+                             " default location (POSIX file " + AppleScriptString(DefaultFolder(true)) + "))";
+        if (!RunAppleScript(script, &path) || path.empty()) return;   // cancelled
+    }
+#else
+    if (interactive) { Toast("Save import needs a path on this platform"); return; }
+#endif
+
+    std::vector<unsigned char> data;
+    if (!ReadFile(path, data, 4 * kFlashSize)) {
+        Toast("Could not read " + BaseName(path) + " (missing, or larger than a DS save)");
+        return;
+    }
+    // DeSmuME .dsv: the raw image, then a footer ending in its cookie
+    if (data.size() >= kDsvFooterSize && memcmp(&data[data.size() - 16], kDsvCookie, 16) == 0) {
+        size_t raw = data.size() - kDsvFooterSize;
+        size_t used = Read32(&data[raw + 82]);   // the footer's "actual size"
+        data.resize(used > 0 && used <= raw ? used : raw);
+    }
+    if (data.size() > kFlashSize) data.resize(kFlashSize);
+    if (data.size() < kFlashSize) data.resize(kFlashSize, 0xFF);
+    if (!LooksLikePlatinumSave(data)) {
+        bool empty = true;
+        for (unsigned char b : data) if (b != 0 && b != 0xFF) { empty = false; break; }
+        Toast(BaseName(path) + (empty ? " is empty (no game saved in it)" : " is not a Pokemon Platinum save"), 5.0);
+        return;
+    }
+
+#ifdef __APPLE__
+    if (interactive) {
+        std::string script = "activate\ndisplay dialog " +
+                             AppleScriptString("Replace the current save with " + BaseName(path) +
+                                               "?\n\nThe current save is kept in save-backups. The game restarts to load the imported save; "
+                                               "progress since your last in-game save is lost.") +
+                             " buttons {\"Cancel\", \"Import and Restart\"} default button 2 with icon caution";
+        if (!RunAppleScript(script, nullptr)) return;   // cancelled
+    }
+#endif
+
+    // Keep the current save
+    std::vector<unsigned char> current;
+    bool blank = true;   // the game creates an all-zero save.bin before anything is saved
+    if (ReadFile(kSaveFile, current, 4 * kFlashSize))
+        for (unsigned char b : current) if (b != 0 && b != 0xFF) { blank = false; break; }
+    if (!blank) {
+        mkdir(kBackupDir, 0755);
+        std::string backup = std::string(kBackupDir) + "/save-" + Timestamp() + ".sav";
+        if (!WriteFile(backup, current)) {
+            Toast("Could not back up the current save; nothing imported");
+            return;
+        }
+    }
+    if (!WriteFile(kSaveFile, data)) {
+        Toast(std::string("Could not write the save: ") + strerror(errno));
+        return;
+    }
+    Toast("Imported " + BaseName(path) + ", restarting");
+    sRestart = true;
+}
+
+void ImportSave(const std::string & path) {
+    if (sBusy.exchange(true)) return;
+    std::thread([path] { DoImport(path); sBusy = false; }).detach();
+}
+
+// ---------------------------------------------------------------------------------------------------------------- restart
+
+void Poll() {
+    if (!sRestart) return;
+    sRestart = false;
+#ifdef __APPLE__
+    // Run this executable again with the same arguments, working directory and output
+    char exe[PATH_MAX];
+    uint32_t size = sizeof exe;
+    if (_NSGetExecutablePath(exe, &size) == 0) {
+        char ** argv = *_NSGetArgv();
+        fflush(stdout);
+        execv(exe, argv);
+    }
+#else
+    char exe[PATH_MAX];
+    ssize_t n = readlink("/proc/self/exe", exe, sizeof exe - 1);
+    if (n > 0) {
+        exe[n] = 0;
+        char * argv[] = {exe, nullptr};
+        fflush(stdout);
+        execv(exe, argv);
+    }
+#endif
+    Toast("Imported; quit and reopen the game to load it", 8.0);
+}
+
+}  // namespace SIM::Helpers
