+  void CompositeEngine(const G2CompositeInput &input) override {
+    glBindFramebuffer(GL_FRAMEBUFFER, mCurrentFbo);
+    glViewport(mCurrentViewport[0], mCurrentViewport[1],
+               mCurrentViewport[2], mCurrentViewport[3]);
+    glUseProgram(mG2Program);
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_CULL_FACE);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    if (input.cpu) {
+      for (int i = 0; i < 4; i++) {
+        if (input.bgSource[i] == LayerSource::Layer && input.cpu->bg[i]) {
+          glActiveTexture(GL_TEXTURE0 + kBgUnits[i]);
+          glBindTexture(GL_TEXTURE_2D, mBgTex[i]);
+          glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, kLayerW, kLayerH, GL_RGBA,
+                          GL_UNSIGNED_BYTE, input.cpu->bg[i]);
+        }
+      }
+      for (int i = 0; i < 4; i++) {
+        if (input.cpu->obj[i]) {
+          glActiveTexture(GL_TEXTURE0 + kObjUnits[i]);
+          glBindTexture(GL_TEXTURE_2D, mObjTex[i]);
+          glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, kLayerW, kLayerH, GL_RGBA,
+                          GL_UNSIGNED_BYTE, input.cpu->obj[i]);
+        }
+      }
+      if (input.cpu->objWindow) {
+        glActiveTexture(GL_TEXTURE0 + kObjWindowUnit);
+        glBindTexture(GL_TEXTURE_2D, mObjWindowTex);
+        glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, kLayerW, kLayerH, GL_RGBA,
+                        GL_UNSIGNED_BYTE, input.cpu->objWindow);
+      }
+    }
+    const G2CompositeUniforms &u = input.uniforms;
+    glProgramUniform4f(mG2Program, Uniform(mG2Program, "backdropColor"),
+                       u.backdropColor[0], u.backdropColor[1],
+                       u.backdropColor[2], u.backdropColor[3]);
+    glUniform1iv(Uniform(mG2Program, "bgPriorities"), 4, u.bgPriorities);
+    glUniform1iv(Uniform(mG2Program, "bgOrder"), 4, u.bgOrder);
+    for (int i = 0; i < 4; i++) {
+      glActiveTexture(GL_TEXTURE0 + kBgUnits[i]);
+      GLuint tex = mDummyTex;
+      if (input.bgSource[i] == LayerSource::Layer) tex = mBgTex[i];
+      else if (input.bgSource[i] == LayerSource::G3Target) tex = mG3Tex;
+      glBindTexture(GL_TEXTURE_2D, tex);
+    }
+    for (int i = 0; i < 4; i++) {
+      glActiveTexture(GL_TEXTURE0 + kObjUnits[i]);
+      glBindTexture(GL_TEXTURE_2D, mObjTex[i]);
+    }
+    glActiveTexture(GL_TEXTURE0 + kObjWindowUnit);
+    glBindTexture(GL_TEXTURE_2D, mObjWindowTex);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "objWindowTexture"),
+                       kObjWindowUnit);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "bldcnt"), u.bldcnt);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "bldalpha"),
+                       u.bldalpha);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "bldy"), u.bldy);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "topScreen"),
+                       u.topScreen);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "dispcnt"), u.dispcnt);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "winin"), u.winin);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "winout"), u.winout);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "win0h"), u.win0h);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "win0v"), u.win0v);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "win1h"), u.win1h);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "win1v"), u.win1v);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "bg0as3d"), u.bg0as3d);
+    glProgramUniform1i(mG2Program, Uniform(mG2Program, "upscaleMode"),
+                       (int)u.upscaleMode);
+    glProgramUniform2f(mG2Program, Uniform(mG2Program, "upscaleW"),
+                       mCurrentViewport[2] > 0
+                           ? 256.0f / (float)mCurrentViewport[2]
+                           : 0.5f,
+                       mCurrentViewport[3] > 0
+                           ? 384.0f / (float)mCurrentViewport[3]
+                           : 0.5f);
+    glProgramUniform1f(mG2Program,
+                       Uniform(mG2Program, "inMasterBrightFactor"),
+                       u.masterBrightFactor);
+    glProgramUniform1i(mG2Program,
+                       Uniform(mG2Program, "inMasterBrightMode"),
+                       u.masterBrightMode);
+    DrawQuad(input.screenQuad, input.screenQuadVertexCount);
+  }
