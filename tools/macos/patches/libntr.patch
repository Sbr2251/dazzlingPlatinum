+// Debug automation (any PC build; off unless the variables are set), for checking a build without a person at the keyboard:
+//   SIM_DEBUG_SHOT_DIR=<dir> SIM_DEBUG_SHOT_EVERY=<frames>  saves the window every N frames as <dir>/frame_<n>.bmp
+//   SIM_DEBUG_KEYS="<frame>:<keys>[/<hold frames>],..."     presses DS buttons at those frames (keys joined by +: A B X Y L R START SELECT UP DOWN LEFT RIGHT;
+//                                                            hold 6 frames unless given), e.g. "300:START,420:A/2,600:A+B"
+//   SIM_DEBUG_EXIT_FRAME=<frame>                            exits after that frame
+//   (a key T<x>;<y> touches the bottom screen at DS coordinates, e.g. "6000:T120;82/4")
+//   SIM_DEBUG_FAST=1                                        no frame cap, no vsync
+static int sDebugTouch = 0;   // SIM_DEBUG_KEYS holds the touch screen: the mouse does not override it
+static u32 SIM_DebugKeyMask(const char *s, u32 *xy) {
+  static const struct { const char *n; u32 bit; int isXY; } names[] = {
+    {"A", 1u << 0, 0}, {"B", 1u << 1, 0}, {"SELECT", 1u << 2, 0}, {"START", 1u << 3, 0}, {"RIGHT", 1u << 4, 0}, {"LEFT", 1u << 5, 0},
+    {"UP", 1u << 6, 0}, {"DOWN", 1u << 7, 0}, {"R", 1u << 8, 0}, {"L", 1u << 9, 0}, {"X", 1u << 10, 1}, {"Y", 1u << 11, 1}};
+  u32 m = 0; *xy = 0;
+  std::string str(s);
+  size_t start = 0;
+  while (start <= str.size()) {
+    size_t end = str.find('+', start); if (end == std::string::npos) end = str.size();
+    std::string k = str.substr(start, end - start);
+    for (auto &n : names) if (k == n.n) { if (n.isXY) *xy |= n.bit; else m |= n.bit; }
+    start = end + 1;
+  }
+  return m;
+}
+static void SIM_DebugFrame(void) {
+  static int init = 0; static const char *shotDir; static u32 shotEvery, exitFrame;
+  struct Step { u32 frame, hold, mask, xy; int touch, tx, ty; };
+  static std::vector<Step> steps; static u32 heldMask, heldXY;
+  if (!init) {
+    init = 1;
+    if (getenv("SIM_DEBUG_FAST")) { sFastForward = true; SDL_GL_SetSwapInterval(0); printf("SIM_DEBUG_FAST: uncapped\n"); }   // automation runs as fast as it renders
+    shotDir = getenv("SIM_DEBUG_SHOT_DIR");
+    const char *e = getenv("SIM_DEBUG_SHOT_EVERY"); shotEvery = e ? (u32)atoi(e) : 0;
+    e = getenv("SIM_DEBUG_EXIT_FRAME"); exitFrame = e ? (u32)atoi(e) : 0;
+    e = getenv("SIM_DEBUG_KEYS");
+    if (e) {
+      std::string all(e); size_t start = 0;
+      while (start < all.size()) {
+        size_t end = all.find(',', start); if (end == std::string::npos) end = all.size();
+        std::string item = all.substr(start, end - start);
+        size_t colon = item.find(':');
+        if (colon != std::string::npos) {
+          Step st; st.frame = (u32)atoi(item.c_str()); st.hold = 6;
+          std::string keys = item.substr(colon + 1);
+          size_t slash = keys.find('/');
+          if (slash != std::string::npos) { st.hold = (u32)atoi(keys.c_str() + slash + 1); keys = keys.substr(0, slash); }
+          st.touch = 0; st.tx = st.ty = 0;
+          size_t t = keys.find('T');   // T<x>;<y>: touch the bottom screen at DS coordinates
+          if (t != std::string::npos && t + 1 < keys.size() && isdigit((unsigned char)keys[t + 1])) {
+            st.touch = 1; st.tx = atoi(keys.c_str() + t + 1);
+            size_t semi = keys.find(';', t); st.ty = semi != std::string::npos ? atoi(keys.c_str() + semi + 1) : 0;
+          }
+          st.mask = SIM_DebugKeyMask(keys.c_str(), &st.xy);
+          steps.push_back(st);
+        }
+        start = end + 1;
+      }
+      printf("SIM_DEBUG_KEYS: %zu steps\n", steps.size());
+    }
+  }
+  u32 frame = *((u32 *)HW_VBLANK_COUNT_BUF);
+  if (!steps.empty()) {
+    u32 mask = 0, xy = 0;
+    int touch = 0, tx = 0, ty = 0;
+    for (auto &st : steps) if (frame >= st.frame && frame < st.frame + st.hold) { mask |= st.mask; xy |= st.xy; if (st.touch) { touch = 1; tx = st.tx; ty = st.ty; } }
+    if (touch) { s_tpData.x = (u16)tx; s_tpData.y = (u16)ty; s_tpData.touch = 1; s_tpData.validity = 0; sDebugTouch = 1; }
+    else if (sDebugTouch) { s_tpData.touch = 0; s_tpData.validity = 0; sDebugTouch = 0; }
+    // the pad registers are active low: release what this script pressed before, then press what it holds now
+    s_reg_PAD_KEYINPUT = (u16)((s_reg_PAD_KEYINPUT | heldMask) & ~mask);
+    *(vu16 *)HW_BUTTON_XY_BUF = (u16)((*(vu16 *)HW_BUTTON_XY_BUF | heldXY) & ~xy);
+    heldMask = mask; heldXY = xy;
+  }
+  if (shotDir && shotEvery && frame % shotEvery == 0) {
+    int w = 0, h = 0;
+    SDL_GL_GetDrawableSize(window, &w, &h);
+    std::vector<u8> px((size_t)w * h * 4);
+    glReadBuffer(GL_BACK);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, px.data());
+    std::vector<u8> flipped(px.size());
+    for (int y = 0; y < h; y++) memcpy(&flipped[(size_t)y * w * 4], &px[(size_t)(h - 1 - y) * w * 4], (size_t)w * 4);
+    SDL_Surface *surf = SDL_CreateRGBSurfaceWithFormatFrom(flipped.data(), w, h, 32, w * 4, SDL_PIXELFORMAT_RGBA32);
+    if (surf) {
+      char path[1024]; snprintf(path, sizeof path, "%s/frame_%06u.bmp", shotDir, frame);
+      SDL_SaveBMP(surf, path); SDL_FreeSurface(surf);
+    }
+  }
+  if (exitFrame && frame >= exitFrame) { printf("SIM_DEBUG_EXIT_FRAME: exiting at frame %u\n", frame); fflush(stdout); _exit(0); }
+}
