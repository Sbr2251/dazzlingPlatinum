+// ---- minimal JSON extraction (flat objects; string/int/bool/array-of-strings values) ----
+static bool JsonFind(const std::string &s, const char *key, size_t *pos) {
+    std::string pat = std::string("\"") + key + "\"";
+    size_t p = s.find(pat);
+    if (p == std::string::npos) return false;
+    p = s.find(':', p + pat.size());
+    if (p == std::string::npos) return false;
+    *pos = p + 1;
+    return true;
+}
+static bool JsonString(const std::string &s, const char *key, std::string *out) {
+    size_t p; if (!JsonFind(s, key, &p)) return false;
+    while (p < s.size() && (s[p] == ' ' || s[p] == '\t')) p++;
+    if (p >= s.size() || s[p] != '"') return false;
+    size_t e = s.find('"', p + 1);
+    if (e == std::string::npos) return false;
+    *out = s.substr(p + 1, e - p - 1);
+    return true;
+}
+static bool JsonInt(const std::string &s, const char *key, long long *out) {
+    size_t p; if (!JsonFind(s, key, &p)) return false;
+    *out = strtoll(s.c_str() + p, nullptr, 10);
+    return true;
+}
+static bool JsonBool(const std::string &s, const char *key, bool *out) {
+    size_t p; if (!JsonFind(s, key, &p)) return false;
+    while (p < s.size() && (s[p] == ' ' || s[p] == '\t')) p++;
+    *out = s.compare(p, 4, "true") == 0;
+    return true;
+}
+
+static void ReplyOk(const char *extra = nullptr) {
+    char buf[4096];
+    if (extra) snprintf(buf, sizeof buf, "{\"ok\":true,\"frame\":%llu,%s}", SIM_Headless_FrameCount(), extra);
+    else snprintf(buf, sizeof buf, "{\"ok\":true,\"frame\":%llu}", SIM_Headless_FrameCount());
+    SIM_Headless_Reply(buf);
+}
+static void ReplyError(const char *msg) {
+    char buf[512];
+    snprintf(buf, sizeof buf, "{\"ok\":false,\"error\":\"%s\",\"frame\":%llu}", msg, SIM_Headless_FrameCount());
+    SIM_Headless_Reply(buf);
+}
+
+static const struct { const char *name; unsigned bit; int isXY; } kKeys[] = {
+    {"A", 1u << 0, 0}, {"B", 1u << 1, 0}, {"SELECT", 1u << 2, 0}, {"START", 1u << 3, 0},
+    {"RIGHT", 1u << 4, 0}, {"LEFT", 1u << 5, 0}, {"UP", 1u << 6, 0}, {"DOWN", 1u << 7, 0},
+    {"R", 1u << 8, 0}, {"L", 1u << 9, 0}, {"X", 1u << 10, 1}, {"Y", 1u << 11, 1},
+};
+
+static void ApplyHeld(void) {
+    // Pad registers are active low. Release everything we might hold, then press the held set.
+    static unsigned prevMask = 0, prevXY = 0;
+    s_reg_PAD_KEYINPUT = (u16)((s_reg_PAD_KEYINPUT | prevMask) & ~s_heldMask);
+    *(vu16 *)HW_BUTTON_XY_BUF = (u16)((*(vu16 *)HW_BUTTON_XY_BUF | prevXY) & ~s_heldXY);
+    prevMask = s_heldMask; prevXY = s_heldXY;
+    if (s_touchActive) {
+        s_tpData.x = (u16)s_touchX; s_tpData.y = (u16)s_touchY;
+        // The game derives touchPressed from the touch 0->1 edge, so a touch
+        // held for the whole command would register only on its first frame
+        // - before a touch-only battle menu (party SHIFT card, Yes/No
+        // buttons) has finished opening, and the tap is lost. Pulse the
+        // panel (2 frames down, 14 frames up): a fresh press edge lands
+        // every 16 frames for the duration of a long touch, while a normal
+        // short tap (<=10 frames, as every current caller sends) still
+        // produces exactly one press - a faster pulse double-taps through
+        // chained menus whose buttons overlap (fight -> move selection).
+        s_tpData.touch = ((s_touchPulse++ % 16) < 2) ? 1 : 0;
+        s_tpData.validity = 0;
+    }
+}
+static void ClearHeld(void) {
+    s_heldMask = 0; s_heldXY = 0;
+    s_touchActive = 0; s_touchPulse = 0;
+    ApplyHeld();
+    s_tpData.touch = 0; s_tpData.validity = 0;
+}
+
+// Read one line from stdin, waiting in slices so a future watchdog can fire while blocked.
+// Returns false on EOF.
+static bool ReadLine(std::string *out) {
+    out->clear();
+    for (;;) {
+        fd_set rf; FD_ZERO(&rf); FD_SET(STDIN_FILENO, &rf);
+        struct timeval tv {0, 100000};
+        int r = select(STDIN_FILENO + 1, &rf, nullptr, nullptr, &tv);
+        if (r < 0) return false;
+        if (r == 0) { SIM_Headless_WatchdogTick(); continue; }
+        char c;
+        ssize_t n = read(STDIN_FILENO, &c, 1);
+        if (n <= 0) return false;
+        if (c == '\n') return true;
+        out->push_back(c);
+        if (out->size() > 65536) return true;   // overlong line: process what we have
+    }
+}
+
+static void PerfJson(char *out, size_t cap) {
+    SimPerfCounters f{}, t{}; SIM_Perf_Get(&f, &t);
+    const char *renderer = SIM::Render::Get().Name();
+    SIM_config_type *cfg = SIM_GetConfigPtr();
+    snprintf(out, cap,
+      "{\"cpu_frame_us\":%llu,\"render_frame_us\":%llu,\"renderer\":\"%s\",\"g2_gpu\":%s,\"internal_scale\":%u,\"wide\":%s,"
+      "\"g3\":{\"draws\":%llu,\"verts\":%llu,\"flushes\":%llu,\"tex_decodes\":%llu,\"tex_uploads\":%llu,"
+      "\"total\":{\"draws\":%llu,\"verts\":%llu,\"flushes\":%llu,\"tex_decodes\":%llu,\"tex_uploads\":%llu}},"
+      "\"g2\":{\"passes\":%llu,\"vram_upload_bytes\":%llu,\"oam_sprites\":%llu,"
+      "\"total\":{\"passes\":%llu,\"vram_upload_bytes\":%llu,\"oam_sprites\":%llu}},"
+      "\"gpu\":{\"render_passes\":%llu,\"copy_passes\":%llu,\"total\":{\"render_passes\":%llu,\"copy_passes\":%llu}},"
+      "\"audio\":{\"active_channels\":%u}}",
+      f.cpu_frame_us, f.render_frame_us, renderer, G2GPU_IsEnabled() ? "true" : "false",
+      cfg->internalResolutionScale, SIM_Layout_IsWide() ? "true" : "false",
+      f.g3_draws, f.g3_verts, f.g3_flushes, f.g3_tex_decodes, f.g3_tex_uploads,
+      t.g3_draws, t.g3_verts, t.g3_flushes, t.g3_tex_decodes, t.g3_tex_uploads,
+      f.g2_passes, f.g2_vram_upload_bytes, f.g2_oam_sprites,
+      t.g2_passes, t.g2_vram_upload_bytes, t.g2_oam_sprites,
+      f.gpu_render_passes, f.gpu_copy_passes, t.gpu_render_passes, t.gpu_copy_passes,
+      f.audio_active_channels);
+}
+
+static void HandleState(const std::string &line) {
+    char reply[16384];
+    bool wantPerf = false; JsonBool(line, "perf", &wantPerf);
+    if (HeadlessGame_State && HeadlessGame_State(line.c_str(), reply, sizeof reply)) {
+        if (wantPerf) {
+            char perf[2048]; PerfJson(perf, sizeof perf);
+            size_t n = strlen(reply);
+            if (n && reply[n - 1] == '}' && n + strlen(perf) + 9 < sizeof reply)
+                snprintf(reply + n - 1, sizeof reply - n + 1, ",\"perf\":%s}", perf);
+        }
+        SIM_Headless_Reply(reply);
+        return;
+    }
+    char perf[2048]; PerfJson(perf, sizeof perf);
+    if (wantPerf) snprintf(reply, sizeof reply, "{\"ok\":true,\"frame\":%llu,\"app\":\"unknown\",\"perf\":%s}", SIM_Headless_FrameCount(), perf);
+    else snprintf(reply, sizeof reply, "{\"ok\":true,\"frame\":%llu,\"app\":\"unknown\"}", SIM_Headless_FrameCount());
+    SIM_Headless_Reply(reply);
+}
+
+static bool HandleSetConfig(const std::string &line) {
+    if (line.find("\"Renderer\"") != std::string::npos) { ReplyError("Renderer requires restart"); return false; }
+    SIM_config_type *cfg = SIM_GetConfigPtr();
+    std::string applied; bool any = false;
+    auto add = [&](const std::string &v) { if (any) applied += ','; applied += v; any = true; };
+    long long n;
+    if (JsonInt(line, "InternalResolutionScale", &n)) {
+        if (n < 1 || n > 8) { ReplyError("InternalResolutionScale must be 1..8"); return false; }
+        cfg->internalResolutionScale = (u32)n; SIM_SetInternalResolutionAfterRender((int)n);
+        add("\"InternalResolutionScale\":" + std::to_string(n));
+    }
+    std::string value;
+    if (JsonString(line, "ScreenLayout", &value)) {
+        int layout = -1;
+        if (value == "vertical") layout = SIM_CONFIG_SCREEN_LAYOUT_VERTICAL;
+        else if (value == "horizontal") layout = SIM_CONFIG_SCREEN_LAYOUT_HORIZONTAL;
+        else if (value == "wide") layout = SIM_CONFIG_SCREEN_LAYOUT_WIDE;
+        else { ReplyError("invalid ScreenLayout"); return false; }
+        if (layout == SIM_CONFIG_SCREEN_LAYOUT_WIDE && strcmp(SIM::Render::Get().Name(), "gpu")) { ReplyError("ScreenLayout wide requires gpu"); return false; }
+        cfg->screenLayout = (SIM_config_screen_layout_type)layout;
+        SIM_Layout_SetWideEnabled(layout == SIM_CONFIG_SCREEN_LAYOUT_WIDE);
+        add("\"ScreenLayout\":\"" + value + "\"");
+    }
+    bool b;
+    if (JsonBool(line, "SwapScreens", &b) && line.find("\"SwapScreens\"") != std::string::npos) {
+        cfg->swapScreens = b; add(std::string("\"SwapScreens\":") + (b ? "true" : "false"));
+    }
+    if (JsonString(line, "Upscale2DFilter", &value)) {
+        if (value == "Nearest") n = 0; else if (value == "Sharp") n = 1;
+        else if (value == "Linear") n = 2; else { ReplyError("invalid Upscale2DFilter"); return false; }
+        cfg->upscale2D = (u8)n; SIM_SetUpscale2DFilterLive((int)n);
+        add("\"Upscale2DFilter\":\"" + value + "\"");
+    } else if (JsonInt(line, "Upscale2DFilter", &n) && line.find("\"Upscale2DFilter\"") != std::string::npos) {
+        if (n < 0 || n > 2) { ReplyError("Upscale2DFilter must be 0..2"); return false; }
+        cfg->upscale2D = (u8)n; SIM_SetUpscale2DFilterLive((int)n); add("\"Upscale2DFilter\":" + std::to_string(n));
+    }
+    if (JsonString(line, "TouchControls", &value)) {
+        if (value == "auto") n = 0; else if (value == "on") n = 1; else if (value == "off") n = 2;
+        else { ReplyError("invalid TouchControls"); return false; }
+        cfg->touchControls = (u8)n; SIM::Touchpad::SetMode((int)n); add("\"TouchControls\":\"" + value + "\"");
+    }
+    if (JsonBool(line, "G2Gpu", &b) && line.find("\"G2Gpu\"") != std::string::npos) {
+        G2GPU_SetEnabled(b ? 1 : 0); add(std::string("\"G2Gpu\":") + (b ? "true" : "false"));
+    }
+    if (!any) { ReplyError("no live-safe config keys"); return false; }
+    ReplyOk((std::string("\"applied\":{") + applied + "}").c_str());
+    return false;
+}
+
+// Process one command line. Returns true when a frame budget was granted (game may run).
+static bool HandleCommand(const std::string &line) {
+    std::string cmd;
+    if (!JsonString(line, "cmd", &cmd)) { ReplyError("missing cmd"); return false; }
+
+    if (cmd == "finger") { // ios-controls hook: normalised window coords through the real finger path
+        double nx = 0, ny = 0; long long frames = 1;
+        { size_t pp; if (JsonFind(line, "x", &pp)) nx = strtod(line.c_str() + pp, nullptr); if (JsonFind(line, "y", &pp)) ny = strtod(line.c_str() + pp, nullptr); }
+        JsonInt(line, "frames", &frames); if (frames < 0) frames = 0;
+        SIM::Touchpad::InjectFinger((float)nx, (float)ny, 0);
+        s_fingerActive = 1; s_fingerNX = (float)nx; s_fingerNY = (float)ny;
+        s_budget = frames; s_pendingReply = 1;
+        if (s_budget == 0) { SIM::Touchpad::InjectFinger((float)nx, (float)ny, 2); s_pendingReply = 0; ReplyOk(); return false; }
+        return true;
+    }
+    if (cmd == "step" || cmd == "press" || cmd == "touch") {
+        SIM_Headless_WatchdogInput();
+        long long frames = 1;
+        JsonInt(line, "frames", &frames);
+        if (frames < 0) frames = 0;
+        ClearHeld();
+        if (cmd == "press") {
+            // keys: ["A","UP",...]
+            size_t p;
+            if (JsonFind(line, "keys", &p)) {
+                size_t e = line.find(']', p);
+                std::string arr = line.substr(p, e == std::string::npos ? std::string::npos : e - p);
+                for (auto &k : kKeys)
+                    if (arr.find(std::string("\"") + k.name + "\"") != std::string::npos) {
+                        if (k.isXY) s_heldXY |= k.bit; else s_heldMask |= k.bit;
+                    }
+            }
+        } else if (cmd == "touch") {
+            long long x = 0, y = 0;
+            JsonInt(line, "x", &x); JsonInt(line, "y", &y);
+            s_touchActive = 1; s_touchX = (int)x; s_touchY = (int)y;
+        }
+        s_budget = frames;
+        s_pendingReply = 1;
+        ApplyHeld();
+        if (s_budget == 0) { s_pendingReply = 0; ReplyOk(); return false; }
+        return true;
+    }
+    if (cmd == "panel") {
+        bool has=false, open=false; { size_t pp; has=JsonFind(line, "open", &pp); if (has) JsonBool(line, "open", &open); }
+        if (!has) SIM_Layout_SetPanelOpen(!SIM_Layout_IsPanelOpen());
+        else SIM_Layout_SetPanelOpen(open ? 1 : 0);
+        char extra[64]; snprintf(extra, sizeof extra, "\"panel_open\":%d", SIM_Layout_IsPanelOpen());
+        ReplyOk(extra); return false;
+    }
+    if (cmd == "screenshot") {
+        std::string path, stage;
+        if (!JsonString(line, "path", &path)) { ReplyError("screenshot needs path"); return false; }
+        bool ok = JsonString(line, "stage", &stage)
+            ? SIM_Headless_ScreenshotStage(path.c_str(), stage.c_str())
+            : SIM_Headless_Screenshot(path.c_str());
+        if (ok) ReplyOk();
+        else ReplyError(stage.empty() ? "screenshot failed" : "screenshot stage unavailable");
+        return false;
+    }
+    if (cmd == "inspect") {
+        std::string what;
+        if (JsonString(line, "what", &what) && what == "render") {
+            SIM::Render::Backend &b = SIM::Render::Get();
+            SIM::Render::Backend::RenderDebugInfo info;
+            b.GetRenderDebugInfo(info);
+            char extra[512];
+            snprintf(extra, sizeof extra,
+                "\"what\":\"render\",\"data\":{\"renderer\":\"%s\",\"g2_gpu\":%s,\"wide\":%s,"
+                "\"internal_scale\":%d,\"frame_size\":[%d,%d],\"g3_size\":[%d,%d],"
+                "\"fx_water_ran\":%s,\"fx_weather_ran\":%s,\"post_fx_active\":%s}",
+                b.Name(), info.g2Gpu ? "true" : "false", info.wide ? "true" : "false",
+                info.internalScale, info.frameW, info.frameH, info.g3W, info.g3H,
+                info.waterActive ? "true" : "false", info.weatherActive ? "true" : "false",
+                info.postFxActive ? "true" : "false");
+            ReplyOk(extra);
+            return false;
+        }
+    }
+    if (cmd == "perf") {
+        char perf[2048], extra[2112]; PerfJson(perf, sizeof perf);
+        snprintf(extra, sizeof extra, "\"perf\":%s", perf); ReplyOk(extra);
+        bool reset = false; if (JsonBool(line, "reset", &reset) && reset) SIM_Perf_ResetTotals();
+        return false;
+    }
+    if (cmd == "set_config") return HandleSetConfig(line);
+    if (cmd == "state") { HandleState(line); return false; }
+    if (cmd == "import_save") {
+        std::string path;
+        if (!JsonString(line, "path", &path)) { ReplyError("import_save needs path"); return false; }
+        ReplyOk("\"restarting\":true");
+        SIM::Helpers::ImportSave(path);   // restarts the process (fds survive execv)
+        s_budget = 30;                    // let Poll() perform the restart
+        return true;
+    }
+    if (cmd == "quit") {
+        ReplyOk();
+        fflush(nullptr);
+        _exit(0);
+    }
+    // Game-side commands (warp, set_var, set_flag, give_item, talk, inspect, ...).
+    {
+        char reply[16384];
+        if (HeadlessGame_Command && HeadlessGame_Command(line.c_str(), reply, sizeof reply)) {
+            SIM_Headless_Reply(reply);
+            unsigned mask = 0, xy = 0; int frames = 0;
+            if (HeadlessGame_TakeInjectedPress(&mask, &xy, &frames) && frames > 0) {
+                ClearHeld();
+                s_heldMask = mask; s_heldXY = xy;
+                s_budget = frames;
+                ApplyHeld();
+                return true;   // run the injected press frames (no second reply)
+            }
+            return false;
+        }
+    }
+    ReplyError("unknown cmd");
+    return false;
+}
+
+// Once a second: hash a downsampled centre patch of the frame plus the state reply,
+// for the watchdog's soft-freeze check. Cheap: 48x32 readback, once a second.
+static void SampleForWatchdog(void) {
+    using namespace std::chrono;
+    static long long lastMs = 0;
+    long long now = duration_cast<milliseconds>(steady_clock::now().time_since_epoch()).count();
+    if (now - lastMs < 1000) return;
+    lastMs = now;
+    unsigned char px[48 * 32 * 4];
+    // Centre of the 512x768 frame, top-down from the backend. The hash
+    // only compares frames against each other, so the row order does
+    // not matter as long as it is consistent.
+    SIM::Render::Get().ReadPixels(112, 176, 48, 32, px);
+    unsigned long long hash = 1469598103934665603ULL;
+    for (size_t i = 0; i < sizeof px; i += 16) { hash ^= px[i]; hash *= 1099511628211ULL; }
+    char state[4096];
+    state[0] = 0;
+    if (HeadlessGame_State) HeadlessGame_State("{\"cmd\":\"state\"}", state, sizeof state);
+    for (const char *p = state; *p; p++) { hash ^= (unsigned char)*p; hash *= 1099511628211ULL; }
+    SIM_Headless_WatchdogSample(hash);
+}
+
+extern "C" void SIM_Headless_ControlFrame(void) {
+    if (!SIM_Control_Enabled()) return;
+    SampleForWatchdog();
+    if (s_budget > 0) {
+        s_budget--;
+        ApplyHeld();
+        if (s_budget > 0) return;
+        // Budget just finished: fall through, reply, and block for the next command.
+    }
+    if (s_pendingReply) { s_pendingReply = 0; if (s_fingerActive) { SIM::Touchpad::InjectFinger(s_fingerNX, s_fingerNY, 2); s_fingerActive = 0; } ReplyOk(); }
+    ClearHeld();
+    std::string line;
+    for (;;) {
+        if (!ReadLine(&line)) { fflush(nullptr); _exit(0); }   // stdin EOF: quit
+        if (line.empty()) continue;
+        if (HandleCommand(line)) return;   // frames granted: let the game run
+    }
+}
