diff --git a/libraries/sim/src/shaders/g2gpu_fragment.glsl b/libraries/sim/src/shaders/g2gpu_fragment.glsl
new file mode 100644
index 0000000..1203f83
--- /dev/null
+++ b/libraries/sim/src/shaders/g2gpu_fragment.glsl
@@ -0,0 +1,289 @@
+R""(
+#version 420 core
+// GPU 2D layer renderer (perf-g2gpu). One pass renders one layer (a BG, an
+// OBJ priority layer, or the OBJ window mask) into that layer's existing
+// 256x384 texture; g2_fragment.glsl compositing is unchanged afterwards.
+// All inputs are plain data textures / int uniforms so a Metal port only
+// has to translate the fetch helpers. This replicates sim_g2.cpp/sim_main
+// CPU behaviour exactly, including its quirks (see sim_g2_gpu.cpp header).
+uniform usampler2D bgVramTex;   // R8UI, 2048 wide
+uniform usampler2D objVramTex;  // R8UI, 1024 wide
+uniform usampler2D lcdcTex;     // R8UI, 2048 wide (extended palettes)
+uniform usampler2D oamTex;      // R16UI, 512 x 2 (main, sub)
+uniform usampler2D palTex;      // R16UI, 256 x 4 (BG main, OBJ main, BG sub, OBJ sub)
+uniform int passMode;           // 0 = BG, 1 = OBJ layer, 2 = OBJ window
+uniform int isSub;
+uniform int layer;              // BG number, or OBJ priority 0..3
+uniform int topScreen;          // 1 if this engine is on the top half
+uniform int dispcnt;
+uniform int bgcnt[4];
+uniform int bgofs[4];           // packed HOFS | VOFS<<16 (text BGs)
+uniform int affA[4]; uniform int affB[4]; uniform int affC[4]; uniform int affD[4];
+uniform int affX[4]; uniform int affY[4];
+uniform int bgMode;
+uniform int extPlttBase;        // byte offset into lcdcTex for BG ext palettes
+uniform int win0h; uniform int win0v; uniform int winin; uniform int winout;
+uniform int dbgEnable;          // GUI debug enable for this layer
+out vec4 outColor;
+
+uint bgByte(int a) { a &= isSub == 1 ? 0x1FFFF : 0x7FFFF; return texelFetch(bgVramTex, ivec2(a & 2047, a >> 11), 0).r; }
+uint objByte(int a) { a &= isSub == 1 ? 0x1FFFF : 0x3FFFF; return texelFetch(objVramTex, ivec2(a & 1023, a >> 10), 0).r; }
+uint lcdcByte(int a) { return texelFetch(lcdcTex, ivec2(a & 2047, a >> 11), 0).r; }
+uint bgWord(int a) { return bgByte(a) | (bgByte(a + 1) << 8u); }
+uint objWord(int a) { return objByte(a) | (objByte(a + 1) << 8u); }
+uint lcdcWord(int a) { return lcdcByte(a) | (lcdcByte(a + 1) << 8u); }
+uint oamWord(int i) { return texelFetch(oamTex, ivec2(i, isSub), 0).r; }
+vec3 palColor(int row, int idx) {
+    uint c = texelFetch(palTex, ivec2(idx & 255, row), 0).r;
+    uint r = ((c & 31u) * 527u + 23u) >> 6;
+    uint g = (((c >> 5) & 31u) * 527u + 23u) >> 6;
+    uint b = (((c >> 10) & 31u) * 527u + 23u) >> 6;
+    return vec3(float(r), float(g), float(b)) / 255.0;
+}
+vec3 extPalColor(int slot, int palNum, int idx) {
+    int a = extPlttBase + slot * 8192 + palNum * 512 + idx * 2;
+    uint c = lcdcWord(a);
+    uint r = ((c & 31u) * 527u + 23u) >> 6;
+    uint g = (((c >> 5) & 31u) * 527u + 23u) >> 6;
+    uint b = (((c >> 10) & 31u) * 527u + 23u) >> 6;
+    return vec3(float(r), float(g), float(b)) / 255.0;
+}
+int bgKind() { // 0 text, 1 affine, 2 extended, -1 none ( mirrors G2SIM_DrawBG dispatch )
+    if (layer == 0 || layer == 1) return 0;
+    if (layer == 2) {
+        if (bgMode == 0 || bgMode == 1 || bgMode == 3) return 0;
+        if (bgMode == 2 || bgMode == 4) return 1;
+        if (bgMode == 5) return 2;
+        return -1;
+    }
+    if (bgMode == 0) return 0;
+    if (bgMode == 1 || bgMode == 2) return 1;
+    if (bgMode >= 3 && bgMode <= 5) return 2;
+    return -1;
+}
+bool textWindowPass(int x, int y) { // CPU text BG: only WIN0 is consulted
+    if (((dispcnt >> 13) & 1) == 0) return true;
+    int left = (win0h >> 8) & 255; int right = win0h & 255;
+    int top = (win0v >> 8) & 255; int bottom = win0v & 255;
+    if (x >= left && x < right && y >= top && y < bottom) return ((winin >> layer) & 1) == 1;
+    return ((winout >> layer) & 1) == 1;
+}
+vec4 renderTextBG(int px, int py) {
+    int cnt = bgcnt[layer];
+    int xoff = (bgofs[layer] & 0x1FF) + px;
+    int yoff = ((bgofs[layer] >> 16) & 0x1FF) + py;
+    int tileset = isSub == 1 ? ((cnt & 0x3C) << 12)
+                             : (((dispcnt >> 24) & 7) << 16) + ((cnt & 0x3C) << 12);
+    int tilemap = isSub == 1 ? ((cnt & 0x1F00) << 3)
+                             : (((dispcnt >> 27) & 7) << 16) + ((cnt & 0x1F00) << 3);
+    if ((cnt & 0x8000) != 0) {
+        tilemap += (yoff & 0x1F8) << 3;
+        if ((cnt & 0x4000) != 0) tilemap += (yoff & 0x100) << 3;
+    } else tilemap += (yoff & 0xF8) << 3;
+    int wideMask = (cnt & 0x4000) != 0 ? 0x100 : 0;
+    int entryAddr = tilemap + ((xoff & 0xF8) >> 2) + ((xoff & wideMask) << 3);
+    uint tile = bgWord(entryAddr);
+    int tileNum = int(tile & 0x3FFu);
+    int tx = (tile & 0x400u) != 0u ? 7 - (xoff & 7) : (xoff & 7);
+    int ty = (tile & 0x800u) != 0u ? 7 - (yoff & 7) : (yoff & 7);
+    if ((cnt & 0x80) != 0) { // 256 colour
+        uint idx = bgByte(tileset + (tileNum << 6) + (ty << 3) + tx);
+        if (idx == 0u || !textWindowPass(px, py)) return vec4(0.0);
+        if ((dispcnt & 0x40000000) != 0) {
+            int slot = (layer < 2 && (cnt & 0x2000) != 0) ? 2 + layer : layer;
+            return vec4(extPalColor(slot, int(tile >> 12), int(idx)), 1.0);
+        }
+        return vec4(palColor(isSub == 1 ? 2 : 0, int(idx)), 1.0);
+    }
+    int addr = tileset + (tileNum << 5) + (ty << 2) + (tx >> 1);
+    uint packed = bgByte(addr);
+    uint idx = (tx & 1) != 0 ? (packed >> 4) : (packed & 15u);
+    if (idx == 0u || !textWindowPass(px, py)) return vec4(0.0);
+    return vec4(palColor(isSub == 1 ? 2 : 0, int(((tile & 0xF000u) >> 8) | idx)), 1.0);
+}
+vec4 renderAffineBG(int px, int py, bool extended) {
+    int cnt = bgcnt[layer];
+    int fx = affX[layer] + py * affB[layer] + px * affA[layer];
+    int fy = affY[layer] + py * affD[layer] + px * affC[layer];
+    int tileset = isSub == 1 ? ((cnt & 0x3C) << 12)
+                             : (((dispcnt >> 24) & 7) << 16) + ((cnt & 0x3C) << 12);
+    int tilemap = isSub == 1 ? ((cnt & 0x1F00) << 3)
+                             : (((dispcnt >> 27) & 7) << 16) + ((cnt & 0x1F00) << 3);
+    int palRow = isSub == 1 ? 2 : 0;
+    if (extended && (cnt & 0x80) != 0) { // bitmap modes (direct colour falls back to CPU)
+        int xmask; int ymask; int yshift;
+        int sizeBits = cnt & 0xC000;
+        if (sizeBits == 0) { xmask = 0x7FFF; ymask = 0x7FFF; yshift = 7; }
+        else if (sizeBits == 0x4000) { xmask = 0xFFFF; ymask = 0xFFFF; yshift = 8; }
+        else if (sizeBits == 0x8000) { xmask = 0x1FFFF; ymask = 0xFFFF; yshift = 9; }
+        else { xmask = 0x1FFFF; ymask = 0x1FFFF; yshift = 9; }
+        int base = (cnt & 0x1F00) << 6;
+        if ((cnt & 0x2000) == 0 && ((fx & ~xmask) != 0 || (fy & ~ymask) != 0)) return vec4(0.0);
+        uint idx = bgByte(base + ((((fy & ymask) >> 8) << yshift) + ((fx & xmask) >> 8)));
+        if (idx == 0u) return vec4(0.0);
+        return vec4(palColor(palRow, int(idx)), 1.0);
+    }
+    int coordmask; int yshift;
+    int sizeBits = cnt & 0xC000;
+    if (sizeBits == 0) { coordmask = 0x7800; yshift = 4; }
+    else if (sizeBits == 0x4000) { coordmask = 0xF800; yshift = 5; }
+    else if (sizeBits == 0x8000) { coordmask = 0x1F800; yshift = 6; }
+    else { coordmask = 0x3F800; yshift = 7; }
+    if ((cnt & 0x2000) == 0 && ((fx | fy) & ~(coordmask | 0x7FF)) != 0) return vec4(0.0);
+    int tx = (fx >> 8) & 7; int ty = (fy >> 8) & 7;
+    if (!extended) {
+        uint tile = bgByte(tilemap + ((((fy & coordmask) >> 11) << yshift) + ((fx & coordmask) >> 11)));
+        uint idx = bgByte(tileset + (int(tile) << 6) + (ty << 3) + tx);
+        if (idx == 0u) return vec4(0.0);
+        return vec4(palColor(palRow, int(idx)), 1.0);
+    }
+    uint tile = bgWord(tilemap + (((((fy & coordmask) >> 11) << yshift) + ((fx & coordmask) >> 11)) << 1));
+    if ((tile & 0x400u) != 0u) tx = 7 - tx;
+    if ((tile & 0x800u) != 0u) ty = 7 - ty;
+    uint idx = bgByte(tileset + ((int(tile & 0x3FFu)) << 6) + (ty << 3) + tx);
+    if (idx == 0u) return vec4(0.0);
+    if ((dispcnt & 0x40000000) != 0) return vec4(extPalColor(layer, int(tile >> 12), int(idx)), 1.0);
+    return vec4(palColor(palRow, int(idx)), 1.0);
+}
+const int sprW[16] = int[16](8,16,8,8,16,32,8,8,32,32,16,8,64,64,32,8);
+const int sprH[16] = int[16](8,8,16,8,16,8,32,8,32,16,32,8,64,32,64,8);
+// Returns: rgb in .rgb, .a = 1 plotted; hitButTransparent handled via alpha 2 marker.
+vec4 sampleSprite(int num, int px, int py, bool wantWindow) {
+    uint a0 = oamWord(num * 4); uint a1 = oamWord(num * 4 + 1); uint a2 = oamWord(num * 4 + 2);
+    bool isWin = ((a0 >> 10) & 3u) == 2u;
+    if (isWin != wantWindow) return vec4(0.0);
+    int mode = wantWindow ? 0 : int((a0 >> 10) & 3u);
+    int sizeParam = int(a0 >> 14) | (int(a1 & 0xC000u) >> 12);
+    int w = sprW[sizeParam]; int h = sprH[sizeParam];
+    int tileNum = int(a2 & 0x3FFu);
+    int palRow = isSub == 1 ? 3 : 1;
+    bool rot = (a0 & 0x100u) != 0u;
+    int palByte = -1; bool hit = false;
+    if (rot) {
+        int bw = w; int bh = h;
+        if ((a0 & 0x200u) != 0u) { bw <<= 1; bh <<= 1; }
+        int syB = (py - int(a0 & 0xFFu)) & 0xFF;
+        if (syB >= bh) return vec4(0.0);
+        int sxB = px - ((int(a1 << 23)) >> 23);
+        if (sxB < 0 || sxB >= bw) return vec4(0.0);
+        int grp = int((a1 >> 9) & 0x1Fu) * 16 + 3;
+        int rA = (int(oamWord(grp)) << 16) >> 16; int rB = (int(oamWord(grp + 4)) << 16) >> 16;
+        int rC = (int(oamWord(grp + 8)) << 16) >> 16; int rD = (int(oamWord(grp + 12)) << 16) >> 16;
+        int rotX = (sxB - (bw >> 1)) * rA + (syB - (bh >> 1)) * rB + (w << 7);
+        int rotY = (sxB - (bw >> 1)) * rC + (syB - (bh >> 1)) * rD + (h << 7);
+        if (uint(rotX) >= uint(w << 8) || uint(rotY) >= uint(h << 8)) return vec4(0.0);
+        if (mode == 3) {
+            if ((a2 >> 12) == 0u) return vec4(0.0);
+            int addr;
+            if ((dispcnt & 0x40) != 0) {
+                if ((dispcnt & 0x20) != 0) return vec4(0.0);
+                addr = tileNum << (7 + ((dispcnt >> 22) & 1));
+                int ytf = w * 2;
+                uint c = objWord(addr + ((rotY >> 8) * ytf) + ((rotX >> 8) << 1));
+                if ((c & 0x8000u) != 0u) { hit = true; palByte = int(c & 0xFFu); }
+            } else {
+                int ytf = (dispcnt & 0x20) != 0 ? 512 : 256;
+                int base = (dispcnt & 0x20) != 0 ? ((tileNum & 0x1F) << 4) + ((tileNum & 0x3E0) << 7)
+                                                 : ((tileNum & 0xF) << 4) + ((tileNum & 0x3F0) << 7);
+                uint c = objWord(base + ((rotY >> 8) * ytf) + ((rotX >> 8) << 1));
+                if ((c & 0x8000u) != 0u) { hit = true; palByte = int(c & 0xFFu); }
+            }
+        } else if ((a0 & 0x2000u) != 0u) { // 8bpp
+            int ytf;
+            int base = tileNum;
+            if ((dispcnt & 0x10) != 0) { base <<= ((dispcnt >> 20) & 3); ytf = ((w >> 3) << 1) << 5; }
+            else ytf = 0x20 << 5;
+            base <<= 5;
+            uint idx = objByte(base + ((rotY >> 11) * ytf) + ((rotY & 0x700) >> 5) + ((rotX >> 11) * 64) + ((rotX & 0x700) >> 8));
+            if (idx != 0u) { hit = true; palByte = int(idx); }
+        } else {
+            int ytf;
+            int base = tileNum;
+            if ((dispcnt & 0x10) != 0) { base <<= ((dispcnt >> 20) & 3); ytf = (w >> 3) << 5; }
+            else ytf = 0x20 << 5;
+            base <<= 5;
+            uint packed = objByte(base + ((rotY >> 11) * ytf) + ((rotY & 0x700) >> 6) + ((rotX >> 11) * 32) + ((rotX & 0x700) >> 9));
+            uint idx = (rotX & 0x100) != 0 ? (packed >> 4) : (packed & 15u);
+            if (idx != 0u) { hit = true; palByte = int(((a2 & 0xF000u) >> 8) | idx); }
+        }
+    } else {
+        if ((a0 & 0x200u) != 0u) return vec4(0.0); // disabled
+        int sy = (py - int(a0 & 0xFFu)) & 0xFF;
+        if (sy >= h) return vec4(0.0);
+        int sx = px - ((int(a1 << 23)) >> 23);
+        if (sx < 0 || sx >= w) return vec4(0.0);
+        int sxF = (a1 & 0x1000u) != 0u ? w - 1 - sx : sx;
+        int syF = (a1 & 0x2000u) != 0u ? h - 1 - sy : sy;
+        if (mode == 3) {
+            if ((a2 >> 12) == 0u) return vec4(0.0);
+            int addr;
+            if ((dispcnt & 0x40) != 0) {
+                if ((dispcnt & 0x20) != 0) return vec4(0.0);
+                addr = (tileNum << (7 + ((dispcnt >> 22) & 1))) + syF * w * 2 + sxF * 2;
+            } else if ((dispcnt & 0x20) != 0) {
+                addr = ((tileNum & 0x1F) << 4) + ((tileNum & 0x3E0) << 7) + syF * 512 + sxF * 2;
+            } else {
+                addr = ((tileNum & 0xF) << 4) + ((tileNum & 0x3F0) << 7) + syF * 256 + sxF * 2;
+            }
+            uint c = objWord(addr);
+            if ((c & 0x8000u) != 0u) { hit = true; palByte = int(c & 0xFFu); }
+        } else if ((a0 & 0x2000u) != 0u) { // 8bpp
+            int t = tileNum;
+            if ((dispcnt & 0x10) != 0) { t <<= ((dispcnt >> 20) & 3); t += ((syF >> 3) * (w >> 3)) << 1; }
+            else t += (syF >> 3) * 0x20;
+            uint idx = objByte((t << 5) + ((syF & 7) << 3) + ((sxF >> 3) << 6) + (sxF & 7));
+            if (idx != 0u) { hit = true; palByte = int(idx); }
+        } else {
+            int t = tileNum;
+            if ((dispcnt & 0x10) != 0) { t <<= ((dispcnt >> 20) & 3); t += (syF >> 3) * (w >> 3); }
+            else t += (syF >> 3) * 0x20;
+            uint packed = objByte((t << 5) + ((syF & 7) << 2) + ((sxF >> 3) << 5) + ((sxF & 7) >> 1));
+            uint idx = (sxF & 1) != 0 ? (packed >> 4) : (packed & 15u);
+            if (idx != 0u) { hit = true; palByte = int(((a2 & 0xF000u) >> 8) | idx); }
+        }
+    }
+    if (!hit) return vec4(0.0);
+    if (wantWindow) return vec4(1.0);
+    if (palByte == 0) return vec4(0.0, 0.0, 0.0, 2.0); // CPU: blocks lower sprites, plots nothing
+    return vec4(palColor(palRow, palByte), 1.0);
+}
+vec4 renderOBJ(int px, int py, bool wantWindow) {
+    for (int i = 0; i < 128; i++) {
+        uint a2 = oamWord(i * 4 + 2);
+        if (int((a2 >> 10) & 3u) != layer && !wantWindow) continue;
+        if (wantWindow) {
+            uint a0 = oamWord(i * 4);
+            if (((a0 >> 10) & 3u) != 2u) continue;
+            if (int((a2 >> 10) & 3u) != layer) continue;
+        }
+        vec4 s = sampleSprite(i, px, py, wantWindow);
+        if (s.a > 0.5) return s.a > 1.5 ? vec4(0.0) : s;
+    }
+    return vec4(0.0);
+}
+void main() {
+    if (dbgEnable == 0) { outColor = vec4(0.0); return; }
+    int rb = int(gl_FragCoord.y);
+    int px = int(gl_FragCoord.x);
+    int py;
+    if (topScreen == 1) { if (rb < 192) discard; py = 383 - rb; }
+    else { if (rb >= 192) discard; py = 191 - rb; }
+    if (passMode == 0) {
+        int kind = bgKind();
+        if (kind == 0) outColor = renderTextBG(px, py);
+        else if (kind == 1) outColor = renderAffineBG(px, py, false);
+        else if (kind == 2) outColor = renderAffineBG(px, py, true);
+        else outColor = vec4(0.0);
+    } else if (passMode == 1) outColor = renderOBJ(px, py, false);
+    else {
+        vec4 w = vec4(0.0);
+        for (int p = 0; p < 4; p++) { /* window mask spans all priorities: emulate per-prio calls */ }
+        // OBJ window: any window sprite at any priority (CPU accumulates across the 4 prio passes)
+        outColor = vec4(0.0);
+        for (int i = 0; i < 128; i++) {
+            vec4 s = sampleSprite(i, px, py, true);
+            if (s.a > 0.5) { outColor = vec4(1.0); break; }
+        }
+    }
+}
+)""
