diff --git a/libraries/sim/src/sim_touchpad.cpp b/libraries/sim/src/sim_touchpad.cpp
new file mode 100644
index 0000000..c757186
--- /dev/null
+++ b/libraries/sim/src/sim_touchpad.cpp
@@ -0,0 +1,339 @@
+// ios-controls hook: see sim_touchpad.h.
+#include "sim_touchpad.h"
+
+#include <SDL3/SDL.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+
+namespace SIM::Touchpad {
+namespace {
+
+int gMode = 0;  // 0 auto, 1 on, 2 off
+int gEnv = -1;  // -1 unset, 0 off, 1 on
+bool gGamepad = false;
+uint64_t gLastTouchMs = 0;
+uint64_t gInitMs = 0;
+bool gPauseToggle = false, gPanelToggle = false;
+
+struct FingerState {
+  bool overlay = false;
+  Btn btn = Btn::A;
+  float nx = 0, ny = 0;  // for the D-pad slide
+};
+std::map<int64_t, FingerState> gFingers;
+
+bool IsIOS() {
+#if defined(__APPLE__) && defined(TARGET_OS_IOS)
+  return TARGET_OS_IOS != 0;
+#else
+  return false;
+#endif
+}
+
+struct LBtn { Btn btn; float cx, cy, w, h; const char *label; bool circle; };
+std::vector<LBtn> gLayout;
+int gLayoutW = 0, gLayoutH = 0;
+
+void BuildLayout(int W, int H) {
+  if (W == gLayoutW && H == gLayoutH && !gLayout.empty()) return;
+  gLayoutW = W; gLayoutH = H; gLayout.clear();
+  if (W <= 0 || H <= 0) return;
+  float fw = (float)W, fh = (float)H;
+  float m = std::max(10.0f, std::min(fw, fh) * 0.04f);        // safe-area-ish margin (notch/home-bar side)
+  float big = std::min(fw, fh) * 0.10f;                       // A/B/X/Y diameter (compact: edges only)
+  float dpad = std::min(fw, fh) * 0.27f;                      // D-pad bounding box
+  float cyLow = fh - m - big * 1.15f;
+  // D-pad (one hit box, directions derived from the touch position).
+  gLayout.push_back({Btn::DPad, m + dpad * 0.5f, cyLow, dpad, dpad, "", false});
+  // ABXY diamond on the right, clear of the playfield centre.
+  float ax = fw - m - big * 0.55f, ay = cyLow;
+  gLayout.push_back({Btn::A, ax, ay, big, big, "A", true});
+  gLayout.push_back({Btn::B, ax - big * 0.95f, ay + big * 0.95f, big, big, "B", true});
+  gLayout.push_back({Btn::X, ax - big * 0.95f, ay - big * 0.95f, big, big, "X", true});
+  gLayout.push_back({Btn::Y, ax - big * 1.90f, ay, big, big, "Y", true});
+  // Shoulders above each cluster.
+  float shW = std::min(fw, fh) * 0.17f, shH = std::min(fw, fh) * 0.075f;
+  gLayout.push_back({Btn::L, m + shW * 0.5f, cyLow - dpad * 0.5f - shH, shW, shH, "L", false});
+  gLayout.push_back({Btn::R, fw - m - shW * 0.5f, cyLow - dpad * 0.5f - shH, shW, shH, "R", false});
+  // Small system pills hugging the edges (nothing in the middle third):
+  // SEL under L on the left, STA under R on the right, FF/Pause in the top
+  // corners, Panel stacked under Pause on the right edge.
+  float pW = std::min(fw, fh) * 0.13f, pH = std::min(fw, fh) * 0.062f;
+  float shY = cyLow - dpad * 0.5f - shH;
+  gLayout.push_back({Btn::Select, m + pW * 0.5f, shY - pH * 1.3f, pW, pH, "SEL", false});
+  gLayout.push_back({Btn::Start, fw - m - pW * 0.5f, shY - pH * 1.3f, pW, pH, "STA", false});
+  float tW = std::min(fw, fh) * 0.11f, tH = std::min(fw, fh) * 0.06f;
+  gLayout.push_back({Btn::FastForward, m + tW * 0.5f, m + tH * 0.5f, tW, tH, "FF", false});
+  gLayout.push_back({Btn::Pause, fw - m - tW * 0.5f, m + tH * 0.5f, tW, tH, "II", false});
+  gLayout.push_back({Btn::Panel, fw - m - tW * 0.5f, m + tH * 1.8f, tW, tH, "PNL", false});
+}
+
+bool Pressed(Btn b) {
+  for (auto &kv : gFingers) if (kv.second.overlay && kv.second.btn == b) return true;
+  return false;
+}
+
+uint32_t DPadMask(const FingerState &f, int W, int H) {
+  // Position inside the D-pad box -> 8-way (slide between directions).
+  const LBtn *d = nullptr;
+  for (auto &b : gLayout) if (b.btn == Btn::DPad) d = &b;
+  if (!d || W <= 0) return 0;
+  float dx = (f.nx * W - d->cx) / (d->w * 0.5f);
+  float dy = (f.ny * H - d->cy) / (d->h * 0.5f);
+  uint32_t m = 0;
+  if (dx < -0.33f) m |= kLeft; if (dx > 0.33f) m |= kRight;
+  if (dy < -0.33f) m |= kUp; if (dy > 0.33f) m |= kDown;
+  return m;
+}
+
+// ---- tiny 3x5 font (A-Z, space) ----
+const uint8_t *Glyph(char c) {
+  static const uint8_t f[][5] = {
+      {2,5,7,5,5},  // A
+      {6,5,6,5,6},  // B
+      {3,4,4,4,3},  // C
+      {6,5,5,5,6},  // D
+      {7,4,6,4,7},  // E
+      {7,4,6,4,4},  // F
+      {3,4,5,5,3},  // G
+      {5,5,7,5,5},  // H
+      {7,2,2,2,7},  // I
+      {1,1,1,5,2},  // J
+      {5,5,6,5,5},  // K
+      {4,4,4,4,7},  // L
+      {5,7,7,5,5},  // M
+      {5,7,7,5,5},  // N (approx: no diagonal in 3px)
+      {2,5,5,5,2},  // O
+      {6,5,6,4,4},  // P
+      {2,5,5,2,1},  // Q
+      {6,5,6,5,5},  // R
+      {3,4,2,1,6},  // S
+      {7,2,2,2,2},  // T
+      {5,5,5,5,7},  // U
+      {5,5,5,5,2},  // V
+      {5,5,7,7,5},  // W
+      {5,5,2,5,5},  // X
+      {5,5,2,2,2},  // Y
+      {7,1,2,4,7},  // Z
+  };
+  static const uint8_t blank[5] = {0, 0, 0, 0, 0};
+  if (c >= 'A' && c <= 'Z') return f[c - 'A'];
+  if (c == '2' || c == '|') { static const uint8_t bar[5] = {0x2,0x2,0x2,0x2,0x2}; return bar; }
+  return blank;
+}
+
+std::vector<uint8_t> gBmp;
+int gBmpW = 0, gBmpH = 0;
+uint64_t gBmpKey = 0;
+
+void PutPx(int x, int y, uint8_t r, uint8_t g, uint8_t b, uint8_t a) {
+  if (x < 0 || y < 0 || x >= gBmpW || y >= gBmpH) return;
+  uint8_t *p = &gBmp[((size_t)y * gBmpW + x) * 4];
+  // Source-over onto the (transparent or already drawn) pixel.
+  float sa = a / 255.0f, da = p[3] / 255.0f, oa = sa + da * (1 - sa);
+  if (oa <= 0) return;
+  for (int c = 0; c < 3; c++) {
+    float src = c == 0 ? r : c == 1 ? g : b;
+    p[c] = (uint8_t)((src * sa + p[c] * da * (1 - sa)) / oa);
+  }
+  p[3] = (uint8_t)(oa * 255);
+}
+void FillRect(int x0, int y0, int x1, int y1, uint8_t r, uint8_t g, uint8_t b, uint8_t a) {
+  for (int y = y0; y < y1; y++) for (int x = x0; x < x1; x++) PutPx(x, y, r, g, b, a);
+}
+void BorderRect(int x0, int y0, int x1, int y1, int t, uint8_t r, uint8_t g, uint8_t b, uint8_t a) {
+  FillRect(x0, y0, x1, y0 + t, r, g, b, a); FillRect(x0, y1 - t, x1, y1, r, g, b, a);
+  FillRect(x0, y0, x0 + t, y1, r, g, b, a); FillRect(x1 - t, y0, x1, y1, r, g, b, a);
+}
+void DrawLabel(const char *s, float cx, float cy, float scale) {
+  int n = (int)std::strlen(s);
+  float w = n * 4 * scale - scale;
+  float x = cx - w * 0.5f, y = cy - 2.5f * scale;
+  for (int i = 0; s[i]; i++) {
+    const uint8_t *gl = Glyph(s[i]);
+    for (int row = 0; row < 5; row++)
+      for (int col = 0; col < 3; col++)
+        if (gl[row] & (1 << (2 - col)))
+          FillRect((int)(x + i * 4 * scale + col * scale), (int)(y + row * scale),
+                   (int)(x + i * 4 * scale + (col + 1) * scale), (int)(y + (row + 1) * scale),
+                   255, 255, 255, 235);
+  }
+}
+
+struct Inj { float nx, ny; int phase; };
+std::vector<Inj> gInj;
+
+}  // namespace
+
+void Init(int configMode) {
+  gMode = configMode;
+  const char *e = std::getenv("SIM_TOUCHPAD");
+  gEnv = e ? (std::strcmp(e, "0") == 0 ? 0 : 1) : -1;
+  gInitMs = gLastTouchMs = SDL_GetTicks();
+}
+void SetMode(int configMode) { gMode = configMode; gBmpKey = 0; }
+bool ForcedByEnv() { return gEnv == 1; }
+bool Enabled() {
+  if (gEnv >= 0) return gEnv == 1;
+  if (gMode == 1) return true;
+  if (gMode == 2) return false;
+  return IsIOS();
+}
+void SetGamepadConnected(bool c) { gGamepad = c; }
+bool GamepadConnected() { return gGamepad; }
+void NoteTouch() { gLastTouchMs = SDL_GetTicks(); }
+
+bool Visible(int W, int H) {
+  if (!Enabled() || W <= 0 || H <= 0) return false;
+  if (gGamepad && !ForcedByEnv()) return false;
+  if (ForcedByEnv()) return true;
+  uint64_t now = SDL_GetTicks();
+  if (!gFingers.empty()) return true;
+  return now - gLastTouchMs < 8000;  // auto-hide after 8 s without touch
+}
+
+int Layout(int W, int H, RectN *out, int maxOut) {
+  BuildLayout(W, H);
+  int n = 0;
+  for (auto &b : gLayout) {
+    if (n >= maxOut) break;
+    out[n++] = {(b.cx - b.w * 0.5f) / (float)W, (b.cy - b.h * 0.5f) / (float)H,
+                b.w / (float)W, b.h / (float)H, b.btn, b.label, Pressed(b.btn)};
+  }
+  return n;
+}
+
+bool HitTest(float nx, float ny, int W, int H) {
+  if (!Visible(W, H)) return false;
+  BuildLayout(W, H);
+  float x = nx * W, y = ny * H;
+  for (auto &b : gLayout) {
+    if (b.circle) {
+      float dx = x - b.cx, dy = y - b.cy;
+      if (dx * dx + dy * dy <= (b.w * 0.55f) * (b.w * 0.55f)) return true;
+    } else if (x >= b.cx - b.w * 0.5f && x <= b.cx + b.w * 0.5f &&
+               y >= b.cy - b.h * 0.5f && y <= b.cy + b.h * 0.5f) return true;
+  }
+  return false;
+}
+
+bool FingerDown(int64_t finger, float nx, float ny, int W, int H) {
+  NoteTouch();
+  if (!Visible(W, H) && !Enabled()) return false;
+  if (gGamepad && !ForcedByEnv()) return false;
+  BuildLayout(W, H);
+  float x = nx * W, y = ny * H;
+  // The overlay appears on any touch, so hit-test even while auto-hidden.
+  for (auto &b : gLayout) {
+    bool hit;
+    if (b.circle) {
+      float dx = x - b.cx, dy = y - b.cy;
+      hit = dx * dx + dy * dy <= (b.w * 0.55f) * (b.w * 0.55f);
+    } else {
+      hit = x >= b.cx - b.w * 0.5f && x <= b.cx + b.w * 0.5f &&
+            y >= b.cy - b.h * 0.5f && y <= b.cy + b.h * 0.5f;
+    }
+    if (!hit) continue;
+    FingerState f; f.overlay = true; f.btn = b.btn; f.nx = nx; f.ny = ny;
+    gFingers[finger] = f;
+    if (b.btn == Btn::Pause) gPauseToggle = true;
+    if (b.btn == Btn::Panel) gPanelToggle = true;
+    return true;
+  }
+  return false;
+}
+void FingerMotion(int64_t finger, float nx, float ny, int, int) {
+  auto it = gFingers.find(finger);
+  if (it != gFingers.end()) { it->second.nx = nx; it->second.ny = ny; NoteTouch(); }
+}
+void FingerUp(int64_t finger, float, float, int, int) { gFingers.erase(finger); }
+bool IsOverlayFinger(int64_t finger) {
+  auto it = gFingers.find(finger);
+  return it != gFingers.end() && it->second.overlay;
+}
+
+uint32_t HeldMask() {
+  uint32_t m = 0;
+  for (auto &kv : gFingers) {
+    if (!kv.second.overlay) continue;
+    switch (kv.second.btn) {
+      case Btn::DPad: m |= DPadMask(kv.second, gLayoutW, gLayoutH); break;
+      case Btn::A: m |= kA; break;
+      case Btn::B: m |= kB; break;
+      case Btn::X: m |= kX; break;
+      case Btn::Y: m |= kY; break;
+      case Btn::L: m |= kL; break;
+      case Btn::R: m |= kR; break;
+      case Btn::Start: m |= kStart; break;
+      case Btn::Select: m |= kSelect; break;
+      default: break;
+    }
+  }
+  return m;
+}
+bool FastForwardHeld() { return Pressed(Btn::FastForward); }
+bool TakePauseToggle() { bool v = gPauseToggle; gPauseToggle = false; return v; }
+bool TakePanelToggle() { bool v = gPanelToggle; gPanelToggle = false; return v; }
+
+void InjectFinger(float nx, float ny, int phase) { gInj.push_back({nx, ny, phase}); }
+bool PollInjected(float *nx, float *ny, int *phase) {
+  if (gInj.empty()) return false;
+  Inj i = gInj.front(); gInj.erase(gInj.begin());
+  *nx = i.nx; *ny = i.ny; *phase = i.phase; return true;
+}
+
+const std::vector<uint8_t> &Bitmap(int W, int H, bool *dirty) {
+  BuildLayout(W, H);
+  uint64_t key = ((uint64_t)(uint32_t)W << 32) | (uint32_t)H;
+  uint32_t pm = HeldMask();
+  key ^= (uint64_t)pm << 8 ^ (FastForwardHeld() ? 0x5A : 0);
+  if (dirty) *dirty = (W != gBmpW || H != gBmpH || key != gBmpKey);
+  if (W == gBmpW && H == gBmpH && key == gBmpKey) return gBmp;
+  gBmpW = W; gBmpH = H; gBmpKey = key;
+  gBmp.assign((size_t)W * H * 4, 0);
+  if (!Visible(W, H)) return gBmp;
+  for (auto &b : gLayout) {
+    bool pr = Pressed(b.btn);
+    if (b.btn == Btn::DPad) {
+      // Cross: vertical + horizontal bars, centre highlighted by held dirs.
+      float arm = b.w * 0.34f;
+      int vx0 = (int)(b.cx - arm * 0.5f), vx1 = (int)(b.cx + arm * 0.5f);
+      int vy0 = (int)(b.cy - b.h * 0.5f), vy1 = (int)(b.cy + b.h * 0.5f);
+      int hx0 = (int)(b.cx - b.w * 0.5f), hx1 = (int)(b.cx + b.w * 0.5f);
+      int hy0 = (int)(b.cy - arm * 0.5f), hy1 = (int)(b.cy + arm * 0.5f);
+      uint8_t a = pr ? 195 : 150;
+      FillRect(vx0, vy0, vx1, vy1, 22, 27, 38, a); FillRect(hx0, hy0, hx1, hy1, 22, 27, 38, a);
+      BorderRect(vx0, vy0, vx1, vy1, 2, 190, 205, 225, 190);
+      BorderRect(hx0, hy0, hx1, hy1, 2, 190, 205, 225, 190);
+      // Direction pips.
+      continue;
+    }
+    int x0 = (int)(b.cx - b.w * 0.5f), x1 = (int)(b.cx + b.w * 0.5f);
+    int y0 = (int)(b.cy - b.h * 0.5f), y1 = (int)(b.cy + b.h * 0.5f);
+    if (b.circle) {
+      float r = b.w * 0.5f;
+      for (int y = y0; y < y1; y++) for (int x = x0; x < x1; x++) {
+        float dx = x - b.cx, dy = y - b.cy;
+        if (dx * dx + dy * dy <= r * r)
+          PutPx(x, y, pr ? 70 : 22, pr ? 140 : 27, pr ? 220 : 38, pr ? 205 : 160);
+      }
+      // Pixel-style ring: redraw the bounding square corners transparent-ish.
+      BorderRect(x0 + (int)(r * 0.15f), y0 + (int)(r * 0.15f), x1 - (int)(r * 0.15f), y1 - (int)(r * 0.15f), 2, 190, 205, 225, 120);
+    } else {
+      FillRect(x0, y0, x1, y1, pr ? 70 : 22, pr ? 140 : 27, pr ? 220 : 38, pr ? 205 : 150);
+      BorderRect(x0, y0, x1, y1, 2, 190, 205, 225, 190);
+    }
+    float sc = std::max(1.5f, std::min(b.w, b.h) * 0.085f);
+    DrawLabel(b.btn == Btn::Pause ? "II" : b.label, b.cx, b.cy, sc);
+  }
+  return gBmp;
+}
+
+}  // namespace SIM::Touchpad
