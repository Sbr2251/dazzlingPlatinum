+    // Distance atmospheric fog
+    float fogFactor = u.modelParams.y;
+    if (fogFactor > 0.001) {
+        float dist = length(in.worldPos - u.camEye.xyz);
+        float fogT = clamp((dist - u.fogParams.x) / max(u.fogParams.y - u.fogParams.x, 0.001), 0.0, 1.0);
+        fogT = fogT * fogT * (3.0 - 2.0 * fogT);
