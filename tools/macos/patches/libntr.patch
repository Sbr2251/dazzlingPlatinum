diff --git a/libraries/sim/src/sim_save_flash.cpp b/libraries/sim/src/sim_save_flash.cpp
new file mode 100644
index 0000000..f3201c3
--- /dev/null
+++ b/libraries/sim/src/sim_save_flash.cpp
@@ -0,0 +1,155 @@
+// Instant, atomic save-file backing for the PC port's DS flash (512 KB save.bin).
+//
+// Previously every CARD write opened save.bin, fseek+fwrite+fclose'd one chunk
+// (block data, secondary footer, footer, per block, plus extra-save sectors and
+// new-game footer erases): many non-atomic writes, no fsync, no backup. A kill
+// or crash mid-save could leave a torn file, and only the game's dual-sector
+// logic stood a chance of recovering it.
+//
+// Now the flash is a 512 KB in-memory image. Reads and writes operate on the
+// image. Outside a transaction a write flushes immediately; inside a
+// transaction (SIM_SaveFlash_Begin/Commit, used by the game's top-level save
+// paths) all chunk writes are coalesced and the file is written exactly once,
+// on Commit:
+//   1. the previous save.bin (if non-blank) is copied to save.bin.bak,
+//   2. the new image goes to save.bin.tmp, is fsync'd, then rename()d over
+//      save.bin (atomic on POSIX), and the directory is fsync'd.
+// A kill at any point therefore leaves either the old or the new complete
+// save; a leftover .tmp is ignored. The bytes in the image are exactly the
+// bytes the old chunked writes produced (same offsets, same contents), so
+// save files stay byte-identical and DeSmuME/melonDS compatible.
+#include "simulator/sim_headless.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace {
+
+const size_t kFlashSize = 512 * 1024;
+
+std::vector<unsigned char> s_image;
+bool s_loaded = false;
+bool s_dirty = false;
+int s_txnDepth = 0;
+unsigned s_bufferedWrites = 0;  // writes coalesced in the current/last flush
+
+std::string SavePath() { return SIM_GetSaveBinPath(); }
+
+bool LoadImage() {
+    if (s_loaded) return true;
+    s_image.assign(kFlashSize, 0);
+    std::string path = SavePath();
+    FILE *f = fopen(path.c_str(), "rb");
+    if (f) {
+        size_t n = fread(s_image.data(), 1, kFlashSize, f);
+        (void)n;  // short file: remainder stays 0, as a fseek/fwrite gap would read
+        fclose(f);
+    }
+    s_loaded = true;
+    return true;
+}
+
+bool WriteFileAtomic(const std::string &path, const unsigned char *data, size_t size) {
+    std::string tmp = path + ".tmp";
+    int fd = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0) return false;
+    size_t off = 0;
+    while (off < size) {
+        ssize_t w = write(fd, data + off, size - off);
+        if (w <= 0) { close(fd); unlink(tmp.c_str()); return false; }
+        off += (size_t)w;
+    }
+    if (fsync(fd) != 0) { close(fd); unlink(tmp.c_str()); return false; }
+    if (close(fd) != 0) { unlink(tmp.c_str()); return false; }
+    if (rename(tmp.c_str(), path.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    // fsync the directory so the rename itself survives a crash.
+    std::string dir = ".";
+    size_t slash = path.find_last_of('/');
+    if (slash != std::string::npos) dir = (slash == 0) ? "/" : path.substr(0, slash);
+    int dfd = open(dir.c_str(), O_RDONLY);
+    if (dfd >= 0) { fsync(dfd); close(dfd); }
+    return true;
+}
+
+bool Flush() {
+    if (!s_loaded || !s_dirty) return true;
+    std::string path = SavePath();
+    // Rolling backup: keep the previous (complete) file as <path>.bak.
+    std::vector<unsigned char> cur;
+    FILE *f = fopen(path.c_str(), "rb");
+    if (f) {
+        unsigned char buf[65536]; size_t n;
+        while ((n = fread(buf, 1, sizeof buf, f)) > 0) cur.insert(cur.end(), buf, buf + n);
+        fclose(f);
+    }
+    bool blank = true;
+    for (unsigned char b : cur) if (b != 0 && b != 0xFF) { blank = false; break; }
+    if (!cur.empty() && !blank)
+        WriteFileAtomic(path + ".bak", cur.data(), cur.size());  // best effort
+    struct timespec t0, t1;
+    clock_gettime(CLOCK_MONOTONIC, &t0);
+    if (!WriteFileAtomic(path, s_image.data(), kFlashSize)) return false;
+    clock_gettime(CLOCK_MONOTONIC, &t1);
+    double ms = (double)(t1.tv_sec - t0.tv_sec) * 1e3 + (double)(t1.tv_nsec - t0.tv_nsec) / 1e6;
+    fprintf(stderr, "SIM instant-save: wrote %zu bytes in %.1f ms (%u buffered writes coalesced, bak=%s)\n",
+            kFlashSize, ms, s_bufferedWrites, (!cur.empty() && !blank) ? "yes" : "no");
+    s_dirty = false;
+    s_bufferedWrites = 0;
+    return true;
+}
+
+}  // namespace
+
+extern "C" int SIM_SaveFlash_Read(unsigned int src, void *dst, unsigned int len) {
+    if (!LoadImage()) return 0;
+    if (src >= kFlashSize) { memset(dst, 0, len); return 1; }
+    size_t avail = kFlashSize - src;
+    size_t n = len < avail ? len : avail;
+    memcpy(dst, s_image.data() + src, n);
+    if (n < len) memset((unsigned char *)dst + n, 0, len - n);
+    return 1;
+}
+
+extern "C" int SIM_SaveFlash_Write(unsigned int dst, const void *src, unsigned int len) {
+    if (!LoadImage()) return 0;
+    if (dst >= kFlashSize) return 0;
+    size_t avail = kFlashSize - dst;
+    size_t n = len < avail ? len : avail;
+    if (memcmp(s_image.data() + dst, src, n) != 0) {
+        memcpy(s_image.data() + dst, src, n);
+        s_dirty = true;
+    }
+    s_bufferedWrites++;
+    if (s_txnDepth == 0) return Flush() ? 1 : 0;
+    return 1;
+}
+
+extern "C" void SIM_SaveFlash_Begin(void) {
+    LoadImage();
+    s_txnDepth++;
+}
+
+extern "C" int SIM_SaveFlash_Commit(void) {
+    if (s_txnDepth > 0) s_txnDepth--;
+    if (s_txnDepth == 0) return Flush() ? 1 : 0;
+    return 1;
+}
+
+extern "C" void SIM_SaveFlash_Rollback(void) {
+    if (s_txnDepth > 0) s_txnDepth--;
+    if (s_txnDepth == 0) {
+        // Discard buffered writes: reload from the file on next access.
+        s_loaded = false;
+        s_dirty = false;
+        s_bufferedWrites = 0;
+        s_image.clear();
+    }
+}
