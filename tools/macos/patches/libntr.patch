+int MatchAnimSlot(const char *name) {
+  std::string s = LowerStr(name);
+  if (s.empty()) return -1;
+  if (s == "idle" || s == "wait") return SIM_BATTLE3D_ANIM_IDLE;
+  if (s == "attack_phys" || s == "throw") return SIM_BATTLE3D_ANIM_ATTACK_PHYS;
+  if (s == "attack_spec" || s == "advent") return SIM_BATTLE3D_ANIM_ATTACK_SPEC;
+  if (s == "hit" || s == "lose") return SIM_BATTLE3D_ANIM_HIT;
+  if (s == "faint") return SIM_BATTLE3D_ANIM_FAINT;
+  if (s == "cry") return SIM_BATTLE3D_ANIM_CRY;
+  if (s.find("wait") != std::string::npos || s.find("idle") != std::string::npos) return SIM_BATTLE3D_ANIM_IDLE;
+  if (s.find("buturi") != std::string::npos || s.find("phys") != std::string::npos ||
+      s.find("throw") != std::string::npos) return SIM_BATTLE3D_ANIM_ATTACK_PHYS;
+  if (s.find("tokusyu") != std::string::npos || s.find("spec") != std::string::npos ||
+      s.find("advent") != std::string::npos) return SIM_BATTLE3D_ANIM_ATTACK_SPEC;
+  if (s.find("damage") != std::string::npos || s.find("hit") != std::string::npos ||
+      s.find("lose") != std::string::npos) return SIM_BATTLE3D_ANIM_HIT;
+  if (s.find("down") != std::string::npos || s.find("faint") != std::string::npos) return SIM_BATTLE3D_ANIM_FAINT;
+  if (s.find("roar") != std::string::npos || s.find("cry") != std::string::npos ||
+      s.find("land") != std::string::npos) return SIM_BATTLE3D_ANIM_CRY;
+  return -1;
+}
