+    int entryAddr = tilemap + ((xoff & 0xF8) >> 2) + ((xoff & wideMask) << 3);
+    uint tile = bgWord(entryAddr);
+    int tileNum = int(tile & 0x3FFu);
+    int tx = (tile & 0x400u) != 0u ? 7 - (xoff & 7) : (xoff & 7);
+    int ty = (tile & 0x800u) != 0u ? 7 - (yoff & 7) : (yoff & 7);
+    if ((cnt & 0x80) != 0) { // 256 colour
+        uint idx = bgByte(tileset + (tileNum << 6) + (ty << 3) + tx);
+        if (idx == 0u || !textWindowPass(px, py)) return vec4(0.0);
+        if ((dispcnt & 0x40000000) != 0) {
+            int slot = (layer < 2 && (cnt & 0x2000) != 0) ? 2 + layer : layer;
+            return vec4(extPalColor(slot, int(tile >> 12), int(idx)), 1.0);
+        }
+        return vec4(palColor(isSub == 1 ? 2 : 0, int(idx)), 1.0);
+    }
+    int addr = tileset + (tileNum << 5) + (ty << 2) + (tx >> 1);
+    uint packed = bgByte(addr);
+    uint idx = (tx & 1) != 0 ? (packed >> 4) : (packed & 15u);
+    if (idx == 0u || !textWindowPass(px, py)) return vec4(0.0);
+    return vec4(palColor(isSub == 1 ? 2 : 0, int(((tile & 0xF000u) >> 8) | idx)), 1.0);
+}
+vec4 renderAffineBG(int px, int py, bool extended) {
+    int cnt = bgcnt[layer];
+    int fx = affX[layer] + py * affB[layer] + px * affA[layer];
+    int fy = affY[layer] + py * affD[layer] + px * affC[layer];
+    int tileset = isSub == 1 ? ((cnt & 0x3C) << 12)
+                             : (((dispcnt >> 24) & 7) << 16) + ((cnt & 0x3C) << 12);
+    int tilemap = isSub == 1 ? ((cnt & 0x1F00) << 3)
+                             : (((dispcnt >> 27) & 7) << 16) + ((cnt & 0x1F00) << 3);
+    int palRow = isSub == 1 ? 2 : 0;
+    if (extended && (cnt & 0x80) != 0) { // bitmap modes (direct colour falls back to CPU)
+        int xmask; int ymask; int yshift;
+        int sizeBits = cnt & 0xC000;
+        if (sizeBits == 0) { xmask = 0x7FFF; ymask = 0x7FFF; yshift = 7; }
+        else if (sizeBits == 0x4000) { xmask = 0xFFFF; ymask = 0xFFFF; yshift = 8; }
+        else if (sizeBits == 0x8000) { xmask = 0x1FFFF; ymask = 0xFFFF; yshift = 9; }
+        else { xmask = 0x1FFFF; ymask = 0x1FFFF; yshift = 9; }
+        int base = (cnt & 0x1F00) << 6;
+        if ((cnt & 0x2000) == 0 && ((fx & ~xmask) != 0 || (fy & ~ymask) != 0)) return vec4(0.0);
+        uint idx = bgByte(base + ((((fy & ymask) >> 8) << yshift) + ((fx & xmask) >> 8)));
+        if (idx == 0u) return vec4(0.0);
+        return vec4(palColor(palRow, int(idx)), 1.0);
+    }
+    int coordmask; int yshift;
+    int sizeBits = cnt & 0xC000;
+    if (sizeBits == 0) { coordmask = 0x7800; yshift = 4; }
+    else if (sizeBits == 0x4000) { coordmask = 0xF800; yshift = 5; }
+    else if (sizeBits == 0x8000) { coordmask = 0x1F800; yshift = 6; }
+    else { coordmask = 0x3F800; yshift = 7; }
+    if ((cnt & 0x2000) == 0 && ((fx | fy) & ~(coordmask | 0x7FF)) != 0) return vec4(0.0);
+    int tx = (fx >> 8) & 7; int ty = (fy >> 8) & 7;
+    if (!extended) {
+        uint tile = bgByte(tilemap + ((((fy & coordmask) >> 11) << yshift) + ((fx & coordmask) >> 11)));
+        uint idx = bgByte(tileset + (int(tile) << 6) + (ty << 3) + tx);
+        if (idx == 0u) return vec4(0.0);
+        return vec4(palColor(palRow, int(idx)), 1.0);
+    }
+    uint tile = bgWord(tilemap + (((((fy & coordmask) >> 11) << yshift) + ((fx & coordmask) >> 11)) << 1));
+    if ((tile & 0x400u) != 0u) tx = 7 - tx;
+    if ((tile & 0x800u) != 0u) ty = 7 - ty;
+    uint idx = bgByte(tileset + ((int(tile & 0x3FFu)) << 6) + (ty << 3) + tx);
+    if (idx == 0u) return vec4(0.0);
+    if ((dispcnt & 0x40000000) != 0) return vec4(extPalColor(layer, int(tile >> 12), int(idx)), 1.0);
+    return vec4(palColor(palRow, int(idx)), 1.0);
+}
+const int sprW[16] = int[16](8,16,8,8,16,32,8,8,32,32,16,8,64,64,32,8);
+const int sprH[16] = int[16](8,8,16,8,16,8,32,8,32,16,32,8,64,32,64,8);
+// Returns: rgb in .rgb, .a = 1 plotted; hitButTransparent handled via alpha 2 marker.
+vec4 sampleSprite(int num, int px, int py, bool wantWindow) {
+    uint a0 = oamWord(num * 4); uint a1 = oamWord(num * 4 + 1); uint a2 = oamWord(num * 4 + 2);
+    bool isWin = ((a0 >> 10) & 3u) == 2u;
+    if (isWin != wantWindow) return vec4(0.0);
+    int mode = wantWindow ? 0 : int((a0 >> 10) & 3u);
+    int sizeParam = int(a0 >> 14) | (int(a1 & 0xC000u) >> 12);
+    int w = sprW[sizeParam]; int h = sprH[sizeParam];
+    int tileNum = int(a2 & 0x3FFu);
+    int palRow = isSub == 1 ? 3 : 1;
+    bool rot = (a0 & 0x100u) != 0u;
+    int palByte = -1; bool hit = false;
+    if (rot) {
+        int bw = w; int bh = h;
+        if ((a0 & 0x200u) != 0u) { bw <<= 1; bh <<= 1; }
+        int syB = (py - int(a0 & 0xFFu)) & 0xFF;
+        if (syB >= bh) return vec4(0.0);
+        int sxB = px - ((int(a1 << 23)) >> 23);
+        if (sxB < 0 || sxB >= bw) return vec4(0.0);
+        int grp = int((a1 >> 9) & 0x1Fu) * 16 + 3;
+        int rA = (int(oamWord(grp)) << 16) >> 16; int rB = (int(oamWord(grp + 4)) << 16) >> 16;
+        int rC = (int(oamWord(grp + 8)) << 16) >> 16; int rD = (int(oamWord(grp + 12)) << 16) >> 16;
+        int rotX = (sxB - (bw >> 1)) * rA + (syB - (bh >> 1)) * rB + (w << 7);
+        int rotY = (sxB - (bw >> 1)) * rC + (syB - (bh >> 1)) * rD + (h << 7);
+        if (uint(rotX) >= uint(w << 8) || uint(rotY) >= uint(h << 8)) return vec4(0.0);
