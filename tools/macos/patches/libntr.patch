+static bool CaseUniformBlock(Device &d) {
+    struct Block {
+        Std140Array<int, 4> idx;
+        Std140Array<float, 32> fog;
+    };
+    Block block;
+    block.idx[0] = 5;
+    block.idx[1] = 17;
+    block.idx[2] = 0;
+    block.idx[3] = 31;
+    for (int i = 0; i < 32; i++) block.fog[i] = (float)i / 31.0f;
+    RenderTarget target;
+    CHECK(target.Create(d, 2, 2, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, false, "selftest-ubo"), "target create");
+    Frame *f = d.BeginFrame();
+    CHECK(f, "BeginFrame");
+    CHECK(f->BeginPass(Phase::Scene3D, PassDesc::Color(target.Color().Handle())), "BeginPass");
+    f->BindPipeline(Pipe(d, test_pos_vert, test_uniform_frag, PosLayout()));
+    f->SetViewport(FullViewport(2, 2));
+    f->PushFragmentUniform(0, block);
+    FullscreenPosQuad(f);
+    f->EndPass();
+    CHECK(f->End(), "End");
+    std::vector<Uint8> px;
+    CHECK(d.ReadbackRGBA8(target.Color(), px), "readback");
+    // fog[5] = 5/31 -> 41, fog[17] = 17/31 -> 140, fog[0] -> 0, fog[31] -> 255.
+    CHECK(PixelNear(px, 2, 0, 0, 41, 140, 0, 255, 2), "uniform block output is not (41,140,0,255)");
+    return true;
+}
