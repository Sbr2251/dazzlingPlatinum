+      Color4 ppCol = C4(38, 44, 54, alpha);
+      if (m.pp <= 0) ppCol = C4(210, 42, 42, alpha);
+      else if (m.maxPp > 0 && m.pp * 4 <= m.maxPp) ppCol = C4(196, 128, 16, alpha);
+      const float ppLabelPt = 5.6f;
+      const float ppNumPt = 7.8f;
+      const float ppBoxX = x + w - ppBoxW;
+      const float ppNumW = measureText(ppBuf, ppNumPt);
+      drawText("PP", ppBoxX + 3.0f, y + 1.8f, ppLabelPt, C4(96, 104, 118, alpha), false);
+      drawText(ppBuf, ppBoxX + (ppBoxW - ppNumW) * 0.5f, y + h - 10.8f, ppNumPt, ppCol, false);
+
+      if (m.selected) {
+        db.DrawCursorSprite(mUiAtlas, x, y, w, h, pulse, alpha);
+      }
+    } else {
+      Color4 top = MulAlpha(kTypeColors[ti].top, alpha);
+      Color4 bot = MulAlpha(kTypeColors[ti].bot, alpha);
+      if (m.selected) {
+        db.ShadowRect(x - 0.6f, y - 0.6f, w + 1.2f, h + 1.2f, 3.0f, 2.2f,
+                      (0.28f + 0.14f * pulse) * alpha);
+      }
+      db.RoundRect(x, y, w, h, 2.5f, top, bot,
+                   m.selected ? 0.75f : 0.55f,
+                   m.selected ? C4(255, 255, 255, 0.92f * alpha) : C4(34, 38, 46, alpha));
+
+      drawText(m.name, x + 5.0f, y + 1.4f, 8.8f, C4(255, 255, 255, alpha), true);
+      db.DrawCategoryIcon(x + 8.5f, y + h - 5.5f, m.category, alpha);
+
+      char ppBuf[20];
+      std::snprintf(ppBuf, sizeof(ppBuf), "PP %d/%d", m.pp, m.maxPp);
+      float ppW = measureText(ppBuf, 7.0f);
+      drawText(ppBuf, x + w - 4.5f - ppW, y + h - 9.2f, 7.0f, C4(248, 250, 255, alpha), true);
+
+      const char *effStr = nullptr;
+      Color4 effCol = C4(255, 255, 255, alpha);
+      if (m.effectiveness == SIM_HUDHD_EFF_SUPER) {
+        effStr = "Super effective";
+        effCol = C4(255, 244, 128, alpha);
+      } else if (m.effectiveness == SIM_HUDHD_EFF_NORMAL) {
+        effStr = "Effective";
+        effCol = C4(240, 246, 255, 0.90f * alpha);
+      } else if (m.effectiveness == SIM_HUDHD_EFF_NOT_VERY) {
+        effStr = "Not very effective";
+        effCol = C4(225, 225, 232, 0.90f * alpha);
+      } else if (m.effectiveness == SIM_HUDHD_EFF_NONE) {
+        effStr = "No effect";
+        effCol = C4(255, 175, 175, alpha);
+      }
+      if (effStr) {
+        drawText(effStr, x + 14.5f, y + h - 8.2f, 5.2f, effCol, true);
+      }
+      if (m.selected) {
+        db.DrawSelectionBrackets(x, y, w, h, pulse);
+      }
+    }
+  }
+
+  // 5. Info Card overlay (Y on Move Select = move detail; Y on Action Menu = battle status)
+  if (mLatched.infoCard.visible && mLatched.infoCard.kind != 0) {
+    const auto &ic = mLatched.infoCard;
+    const float x = (ic.rect.w > 1.0f) ? ic.rect.x : 12.0f;
+    const float y = (ic.rect.h > 1.0f) ? ic.rect.y : 44.0f;
+    const float w = (ic.rect.w > 1.0f) ? ic.rect.w : 156.0f;
+    const float h = (ic.rect.h > 1.0f) ? ic.rect.h : 86.0f;
+    const bool isMoveDetail = (ic.kind == 1);
+    const Color4 white1 = C4(255, 255, 255, 0.98f);
+
+    db.ShadowRect(x + 0.8f, y + 1.2f, w, h, 3.0f, 2.2f, 0.36f);
+    const HudUiSprite *panelSp = useBdspUi
+        ? (isMoveDetail ? mUiAtlas.infoMoveBg : mUiAtlas.infoStatusBg)
+        : nullptr;
+    if (panelSp) {
+      const float bsc = isMoveDetail ? 0.14f : 0.24f;
+      db.DrawSprite9Slice(panelSp, x, y, w, h, bsc, white1);
+      if (!isMoveDetail && mUiAtlas.infoSubBg) {
+        db.DrawSprite9Slice(mUiAtlas.infoSubBg, x + 4.0f, y + 4.0f, w - 8.0f, 15.0f,
+                            0.45f, C4(255, 255, 255, 0.95f));
+      }
+    } else {
+      const int ti = (ic.type >= 0 && ic.type < 19) ? ic.type : 0;
+      Color4 hdrTop = isMoveDetail ? kTypeColors[ti].top : C4(58, 108, 198, 0.98f);
+      Color4 hdrBot = isMoveDetail ? kTypeColors[ti].bot : C4(42, 82, 162, 0.98f);
+      db.RoundRect(x, y, w, h, 3.0f,
+                   C4(252, 251, 246, 0.96f), C4(236, 238, 242, 0.96f),
+                   0.65f, C4(44, 52, 66, 0.95f));
+      db.RoundRect(x + 1.2f, y + 1.2f, w - 2.4f, 16.5f, 2.2f, hdrTop, hdrBot);
+    }
+
+    // Header content
+    if (isMoveDetail) {
+      float tx = x + 7.0f;
+      const Color4 titleCol = panelSp ? C4(44, 36, 18, 1.0f) : C4(255, 255, 255, 1.0f);
+      drawText(ic.title, tx, y + 4.8f, 8.8f, titleCol, !panelSp);
+
+      const int bdspTi = BdspTypeIndex(ic.type);
+      float rightEdge = x + w - 6.0f;
+      if (useBdspUi) {
+        const HudUiSprite *catSp = (ic.category == SIM_HUDHD_CAT_PHYSICAL) ? mUiAtlas.catPhys
+                                 : (ic.category == SIM_HUDHD_CAT_SPECIAL) ? mUiAtlas.catSpec
+                                                                          : mUiAtlas.catStatus;
+        if (catSp) {
+          db.DrawSpriteAspectFit(catSp, rightEdge - 13.5f, y + 5.2f, 13.5f, 8.0f, white1, 1.0f, 0.5f);
+          rightEdge -= 15.5f;
+        }
+        if (mUiAtlas.typeBadge[bdspTi]) {
+          db.DrawSpriteAspectFit(mUiAtlas.typeBadge[bdspTi], rightEdge - 32.0f, y + 5.2f,
+                                 32.0f, 8.0f, white1, 1.0f, 0.5f);
+        }
+      } else {
+        db.DrawCategoryIcon(rightEdge - 4.5f, y + 9.4f, ic.category, 1.0f);
+      }
+    } else {
+      drawText(ic.title[0] ? ic.title : "Battle Status", x + 8.0f, y + 5.0f, 9.2f,
+               C4(255, 255, 255, 1.0f), true);
+    }
+
+    // Body rows: line1, line2, wrapped desc
+    // On BDSP's blue subinfo panel (kind==2), use crisp white text; on cream/white panels, dark slate text.
+    const bool darkBodyBg = (!isMoveDetail && panelSp != nullptr);
+    const Color4 line1Col = darkBodyBg ? C4(250, 252, 255, 1.0f) : C4(36, 42, 54, 1.0f);
+    const Color4 line2Col = darkBodyBg ? C4(224, 238, 255, 1.0f) : C4(62, 72, 92, 1.0f);
+    const Color4 descCol  = darkBodyBg ? C4(240, 246, 255, 1.0f) : C4(42, 48, 58, 1.0f);
+    const Color4 divCol   = darkBodyBg ? C4(220, 236, 255, 0.45f) : C4(160, 166, 178, 0.55f);
+
+    float curY = y + 21.5f;
+    if (ic.line1[0]) {
+      drawWrappedText(ic.line1, x + 7.5f, curY, w - 15.0f, 7.2f, 9.2f, 1, line1Col, darkBodyBg);
+      curY += 10.8f;
+    }
+    if (ic.line2[0]) {
+      drawWrappedText(ic.line2, x + 7.5f, curY, w - 15.0f, 7.0f, 9.2f, 1, line2Col, darkBodyBg);
+      curY += 10.4f;
+    }
+    if (ic.desc[0]) {
+      db.Line(x + 7.0f, curY + 0.5f, x + w - 7.0f, curY + 0.5f, 0.5f, divCol);
+      curY += 3.0f;
+      int maxLines = std::max(1, static_cast<int>((y + h - 5.0f - curY) / 8.8f));
+      drawWrappedText(ic.desc, x + 7.5f, curY, w - 15.0f, 6.7f, 8.8f, maxLines,
+                      descCol, darkBodyBg);
+    }
+  }
+
+  // 6. Key-guide hints bar (only when explicitly requested by game via showKeyHints)
+  if (mLatched.showKeyHints) {
+    const bool hasMenu = (mLatched.numMoves > 0 || mLatched.numButtons > 0);
+    if (hasMenu) {
+      const char *yLabel = mLatched.infoCard.visible ? "Close"
+                         : (mLatched.numMoves > 0 ? "Details" : "Check");
+      const float pillW = 46.0f;
+      const float pillH = 11.5f;
+      const float px = 124.0f;
+      const float py = 178.0f;
+      if (useBdspUi && mUiAtlas.keyY) {
+        db.RoundRect(px, py, pillW, pillH, 2.4f,
+                     C4(28, 34, 44, 0.80f), C4(20, 24, 32, 0.80f),
+                     0.35f, C4(235, 240, 250, 0.45f));
+        db.DrawSpriteAspectFit(mUiAtlas.keyY, px + 2.5f, py + 1.4f, 8.6f, 8.6f,
+                               C4(255, 255, 255, 1.0f));
+        drawText(yLabel, px + 13.0f, py + 1.9f, 7.2f, C4(248, 250, 255, 1.0f), true);
+      } else {
+        db.RoundRect(px, py, pillW, pillH, 2.4f,
+                     C4(28, 34, 44, 0.82f), C4(20, 24, 32, 0.82f),
+                     0.35f, C4(220, 228, 240, 0.45f));
+        db.Circle(px + 6.5f, py + pillH * 0.5f, 3.8f,
+                  C4(82, 134, 228, 1.0f), C4(52, 96, 186, 1.0f));
+        drawText("Y", px + 4.4f, py + 2.0f, 6.8f, C4(255, 255, 255, 1.0f), false);
+        drawText(yLabel, px + 13.0f, py + 1.9f, 7.2f, C4(248, 250, 255, 1.0f), true);
+      }
+    }
+  }
+
+  // 7. Phase-3 extensions: HD BDSP dialogue bar + HD in-battle Bag/Party/Summary overlays
+  if (mLatched.dialogue.visible || mLatched.overlay.kind != SIM_HUDHD_OVERLAY_NONE) {
+    auto toC4 = [](HudExtColor c) -> Color4 { return {c.r, c.g, c.b, c.a}; };
+    HudExtDraw ext{};
+    ext.atlas = &mUiAtlas;
+    ext.useBdspUi = useBdspUi;
+    ext.timeSec = mTimeSec;
+    ext.canvasW = mLatched.canvasW > 0.0f ? mLatched.canvasW : 342.0f;
+    ext.canvasH = mLatched.canvasH > 0.0f ? mLatched.canvasH : 192.0f;
+    ext.roundRect = [&](float x, float y, float w, float h, float r, HudExtColor top, HudExtColor bot, float b, HudExtColor bc) {
+      db.RoundRect(x, y, w, h, r, toC4(top), toC4(bot), b, toC4(bc));
+    };
+    ext.shadowRect = [&](float x, float y, float w, float h, float r, float soft, float a) {
+      db.ShadowRect(x, y, w, h, r, soft, a);
+    };
+    ext.circle = [&](float cx, float cy, float r, HudExtColor top, HudExtColor bot) {
+      db.Circle(cx, cy, r, toC4(top), toC4(bot));
+    };
+    ext.line = [&](float x0, float y0, float x1, float y1, float t, HudExtColor col) {
+      db.Line(x0, y0, x1, y1, t, toC4(col));
+    };
+    ext.sprite = [&](const HudUiSprite *sp, float x, float y, float w, float h, HudExtColor tint) {
+      db.DrawSprite(sp, x, y, w, h, toC4(tint));
+    };
+    ext.spriteNineSlice = [&](const HudSprite *sp, float x, float y, float w, float h, float bs, HudExtColor tint) {
+      db.DrawSprite9Slice(sp, x, y, w, h, bs, toC4(tint));
+    };
+    ext.spriteAspectFit = [&](const HudUiSprite *sp, float x, float y, float w, float h, HudExtColor tint) {
+      db.DrawSpriteAspectFit(sp, x, y, w, h, toC4(tint));
+    };
+    ext.measureText = [&](const char *str, float sz) -> float { return measureText(str, sz); };
+    ext.drawText = [&](const char *str, float x, float y, float sz, HudExtColor col, bool sh) {
+      drawText(str, x, y, sz, toC4(col), sh);
+    };
+    ext.drawWrappedText = [&](const char *str, float x, float y, float mw, float sz, float lh, int ml, HudExtColor col, bool sh) {
+      drawWrappedText(str, x, y, mw, sz, lh, ml, toC4(col), sh);
+    };
+    if (mLatched.dialogue.visible) {
+      RenderHudDialogue(ext, mLatched.dialogue);
+    }
+    if (mLatched.overlay.kind != SIM_HUDHD_OVERLAY_NONE) {
+      RenderHudOverlay(ext, mLatched.overlay);
+    }
+  }
+
+  if (db.verts.empty()) return;
+
+  frame->BindPipeline(pipe);
+  SDL_GPUViewport vp{0.0f, 0.0f, static_cast<float>(mTargetW), static_cast<float>(mTargetH), 0.0f, 1.0f};
+  frame->SetViewport(vp);
+  frame->BindFragmentSampler(0, mFontAtlas.Handle(), device.Sampler(SamplerKey::Linear()));
+  frame->BindFragmentSampler(1, mUiAtlas.Ready() ? mUiAtlas.TextureHandle() : mFontAtlas.Handle(),
+                             device.Sampler(SamplerKey::Linear()));
+  frame->DrawStreamed(db.verts.data(), static_cast<Uint32>(db.verts.size()), sizeof(HudVertex));
+}
+
+} // namespace SIM::Render
+
+extern "C" {
+
+void SIM_HudHD_Submit(const SIM_HudHD_Frame *frame) {
+  std::lock_guard<std::mutex> lock(SIM::Render::gStateMutex);
+  if (frame) {
+    SIM::Render::gSharedFrame = *frame;
+  } else {
+    std::memset(&SIM::Render::gSharedFrame, 0, sizeof(SIM::Render::gSharedFrame));
+  }
+  SIM::Render::gFramesSinceSubmit = 0;
+}
+
+int SIM_HudHD_IsSupported(void) {
+  return SIM::Render::gHudHDSupported.load(std::memory_order_acquire) ? 1 : 0;
+}
+
+} // extern "C"
