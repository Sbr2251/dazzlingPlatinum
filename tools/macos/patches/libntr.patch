+// GBATEK window priority for a BG pixel: WIN0 > WIN1 > OBJ window >
+// outside. This helper resolves WIN0/WIN1 only; pixels outside both
+// pass through and the composite (g2_fragment.glsl) applies the
+// OBJ-window vs outside mask, which needs the OBJ window texture.
+static bool G2SIM_WindowPassBG(u32 dispcnt, u16 win0H, u16 win0V, u16 win1H, u16 win1V, u16 winIn, u32 bgnum, u32 x, u32 line) {
+  if (dispcnt & 0x2000) {
+    u8 left = (u8)(win0H >> 8), right = (u8)(win0H & 0xFF);
+    u8 top = (u8)(win0V >> 8), bottom = (u8)(win0V & 0xFF);
+    if (x >= left && x < right && line >= top && line < bottom) return (winIn >> bgnum) & 1;
+  }
+  if (dispcnt & 0x4000) {
+    u8 left = (u8)(win1H >> 8), right = (u8)(win1H & 0xFF);
+    u8 top = (u8)(win1V >> 8), bottom = (u8)(win1V & 0xFF);
+    if (x >= left && x < right && line >= top && line < bottom) return (winIn >> (8 + bgnum)) & 1;
+  }
+  return true;
+}
+
+// Is BG mosaic active for this BG? BGCNT bit 6 enables it and the MOSAIC
+// register must have a nonzero BG H or V size.
+static u8 G2SIM_BGMosaicActive(u32 bgNum, u8 isSub) {
+  u16 mosaicReg = isSub ? s_reg_G2S_DB_MOSAIC : s_reg_G2_MOSAIC;
+  if (!(mosaicReg & 0xFF)) return 0;
+  u16 bgcnt = 0;
+  if (isSub) {
+    switch (bgNum) {
+    case 0: bgcnt = s_reg_G2S_DB_BG0CNT; break;
+    case 1: bgcnt = s_reg_G2S_DB_BG1CNT; break;
+    case 2: bgcnt = s_reg_G2S_DB_BG2CNT; break;
+    case 3: bgcnt = s_reg_G2S_DB_BG3CNT; break;
+    default: break;
+    }
+  } else {
+    switch (bgNum) {
+    case 0: bgcnt = s_reg_G2_BG0CNT; break;
+    case 1: bgcnt = s_reg_G2_BG1CNT; break;
+    case 2: bgcnt = s_reg_G2_BG2CNT; break;
+    case 3: bgcnt = s_reg_G2_BG3CNT; break;
+    default: break;
+    }
+  }
+  return (bgcnt & 0x40) ? 1 : 0;
+}
