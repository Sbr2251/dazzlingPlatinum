new file mode 100644
index 0000000..999904e
--- /dev/null
+++ b/libraries/sim/src/shaders/g2gpu_fragment.glsl
@@ -0,0 +1,275 @@
+R""(
+#version 420 core
+// GPU 2D layer renderer (perf-g2gpu). One pass renders one layer (a BG, an
+// OBJ priority layer, or the OBJ window mask) into that layer's existing
+// 256x384 texture; g2_fragment.glsl compositing is unchanged afterwards.
+// All inputs are plain data textures / int uniforms so a Metal port only
+// has to translate the fetch helpers. This replicates sim_g2.cpp/sim_main
+// CPU behaviour exactly, including its quirks (see sim_g2_gpu.cpp header).
+uniform usampler2D bgVramTex;   // R8UI, 2048 wide
+uniform usampler2D objVramTex;  // R8UI, 1024 wide
+uniform usampler2D lcdcTex;     // R8UI, 2048 wide (extended palettes)
+uniform usampler2D oamTex;      // R16UI, 512 x 2 (main, sub)
+uniform usampler2D palTex;      // R16UI, 256 x 4 (BG main, OBJ main, BG sub, OBJ sub)
+uniform int passMode;           // 0 = BG, 1 = OBJ layer, 2 = OBJ window
+uniform int isSub;
+uniform int layer;              // BG number, or OBJ priority 0..3
+uniform int topScreen;          // 1 if this engine is on the top half
+uniform int dispcnt;
+uniform int bgcnt[4];
+uniform int bgofs[4];           // packed HOFS | VOFS<<16 (text BGs)
+uniform int affA[4]; uniform int affB[4]; uniform int affC[4]; uniform int affD[4];
+uniform int affX[4]; uniform int affY[4];
+uniform int bgMode;
+uniform int extPlttBase;        // byte offset into lcdcTex for BG ext palettes
+uniform int win0h; uniform int win0v; uniform int winin; uniform int winout;
+uniform int dbgEnable;          // GUI debug enable for this layer
+uniform int objList[128];       // candidate sprite indices for this pass (ascending)
+uniform int objCount;
+out vec4 outColor;
+
+uint bgByte(int a) { a &= isSub == 1 ? 0x1FFFF : 0x7FFFF; return texelFetch(bgVramTex, ivec2(a & 2047, a >> 11), 0).r; }
+uint objByte(int a) { a &= isSub == 1 ? 0x1FFFF : 0x3FFFF; return texelFetch(objVramTex, ivec2(a & 1023, a >> 10), 0).r; }
+uint lcdcByte(int a) { return texelFetch(lcdcTex, ivec2(a & 2047, a >> 11), 0).r; }
+uint bgWord(int a) { return bgByte(a) | (bgByte(a + 1) << 8u); }
+uint objWord(int a) { return objByte(a) | (objByte(a + 1) << 8u); }
+uint lcdcWord(int a) { return lcdcByte(a) | (lcdcByte(a + 1) << 8u); }
+uint oamWord(int i) { return texelFetch(oamTex, ivec2(i, isSub), 0).r; }
