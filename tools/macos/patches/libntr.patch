+void SetHudHDSupported(bool supported) {
+  gHudHDSupported.store(supported, std::memory_order_release);
+}
+
+FxHudHD::~FxHudHD() { Release(); }
+
+void FxHudHD::Release() {
+  if (mHasAtlas) {
+    mFontAtlas.Release();
+    mHasAtlas = false;
+  }
+  mUiAtlas.Release();
+  mBakedPx = 0.0f;
+  mGlyphs.clear();
+  mVerts.clear();
+  mLastPrepareTicks = 0;
+  mDevice = nullptr;
+}
+
+bool FxHudHD::EnsureFontLoaded() {
+  if (mFontProbed) return mFontLoaded;
+  mFontProbed = true;
+
+  const char *envFont = std::getenv("SIM_HUDHD_FONT");
+  const char *dataDir = SIM_Platform_DataDir();
+  std::string exe = ExeDir();
+  const char *fontNames[] = {"MPLUSRounded1c-Bold.ttf", "MPLUSRounded1c-Medium.ttf"};
+  std::string found;
+  for (const char *kFontFile : fontNames) {
+    std::string candidates[] = {
+        envFont ? std::string(envFont) : std::string(),
+        dataDir ? JoinPath(JoinPath(dataDir, "hudhd"), kFontFile) : std::string(),
+        JoinPath("hudhd", kFontFile),
+        exe.empty() ? std::string() : JoinPath(JoinPath(exe, "hudhd"), kFontFile),
+        exe.empty() ? std::string() : JoinPath(JoinPath(exe, "../Resources/game/hudhd"), kFontFile),
+        exe.empty() ? std::string() : JoinPath(JoinPath(exe, "../res/hudhd"), kFontFile),
+        JoinPath("res/hudhd", kFontFile),
+        JoinPath("../res/hudhd", kFontFile),
+    };
+    for (const auto &c : candidates) {
+      if (FileExists(c)) {
+        found = c;
+        break;
+      }
+    }
+    if (!found.empty()) break;
+  }
+  if (found.empty()) {
+    std::fprintf(stderr, "FxHudHD: font not found\n");
+    return false;
+  }
+
+  FILE *f = std::fopen(found.c_str(), "rb");
+  if (!f) return false;
+  std::fseek(f, 0, SEEK_END);
+  long sz = std::ftell(f);
+  std::fseek(f, 0, SEEK_SET);
+  if (sz <= 0) {
+    std::fclose(f);
+    return false;
+  }
+  mFontData.resize(static_cast<std::size_t>(sz));
+  std::size_t nr = std::fread(mFontData.data(), 1, mFontData.size(), f);
+  std::fclose(f);
+  if (nr != mFontData.size()) {
+    mFontData.clear();
+    return false;
+  }
+  mFontLoaded = true;
+  return true;
+}
+
+bool FxHudHD::EnsureAtlas(Device &device, Frame *frame, float bakePx) {
+  if (!EnsureFontLoaded() || !frame) return false;
+  if (mHasAtlas && std::abs(bakePx - mBakedPx) <= 2.0f) return true;
+
+  stbtt_fontinfo font{};
+  if (!stbtt_InitFont(&font, mFontData.data(), stbtt_GetFontOffsetForIndex(mFontData.data(), 0))) {
+    return false;
+  }
+  const float scale = stbtt_ScaleForPixelHeight(&font, bakePx);
+  int asc = 0, desc = 0, lg = 0;
+  stbtt_GetFontVMetrics(&font, &asc, &desc, &lg);
+  mFontAscent = asc * scale;
+  mFontDescent = desc * scale;
+  mFontLineGap = lg * scale;
+
+  std::vector<std::uint32_t> cps;
+  for (std::uint32_t cp = 0x20; cp <= 0x7E; ++cp) cps.push_back(cp);
+  for (std::uint32_t cp = 0xA0; cp <= 0xFF; ++cp) cps.push_back(cp);
+  const std::uint32_t extra[] = {0x2018, 0x2019, 0x2014, 0x2026, 0x2190, 0x2192, 0x2212, 0x2640, 0x2642};
+  for (std::uint32_t cp : extra) cps.push_back(cp);
+
+  const int atlasW = 1024;
+  const int atlasH = 512;
+  std::vector<std::uint8_t> rgba(static_cast<std::size_t>(atlasW) * atlasH * 4, 0);
+  mGlyphs.clear();
+
+  int penX = 2, penY = 2, rowH = 0;
+  for (std::uint32_t cp : cps) {
+    int adv = 0, lsb = 0;
+    stbtt_GetCodepointHMetrics(&font, static_cast<int>(cp), &adv, &lsb);
+    int x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+    stbtt_GetCodepointBitmapBox(&font, static_cast<int>(cp), scale, scale, &x0, &y0, &x1, &y1);
+    int gw = x1 - x0;
+    int gh = y1 - y0;
+
+    GlyphInfo gi{};
+    gi.advance = adv * scale;
+    gi.xoff = static_cast<float>(x0);
+    gi.yoff = static_cast<float>(y0);
+    gi.w = static_cast<float>(gw);
+    gi.h = static_cast<float>(gh);
+    gi.valid = true;
+
+    if (gw > 0 && gh > 0) {
+      if (penX + gw + 2 >= atlasW) {
+        penX = 2;
+        penY += rowH + 2;
+        rowH = 0;
+      }
+      if (penY + gh + 2 >= atlasH) break;
+
+      std::vector<std::uint8_t> bmp(static_cast<std::size_t>(gw) * gh, 0);
+      stbtt_MakeCodepointBitmap(&font, bmp.data(), gw, gh, gw, scale, scale, static_cast<int>(cp));
+      for (int y = 0; y < gh; ++y) {
+        for (int x = 0; x < gw; ++x) {
+          std::size_t dst = (static_cast<std::size_t>(penY + y) * atlasW + (penX + x)) * 4;
+          rgba[dst + 0] = 255;
+          rgba[dst + 1] = 255;
+          rgba[dst + 2] = 255;
+          rgba[dst + 3] = bmp[static_cast<std::size_t>(y) * gw + x];
+        }
+      }
+      gi.u0 = static_cast<float>(penX) / static_cast<float>(atlasW);
+      gi.v0 = static_cast<float>(penY) / static_cast<float>(atlasH);
+      gi.u1 = static_cast<float>(penX + gw) / static_cast<float>(atlasW);
+      gi.v1 = static_cast<float>(penY + gh) / static_cast<float>(atlasH);
+      penX += gw + 2;
+      if (gh > rowH) rowH = gh;
+    }
+    mGlyphs[cp] = gi;
+  }
+
+  mDevice = &device;
+  if (!mHasAtlas) {
+    mFontAtlas.Create(device, TextureDesc::Rgba8(atlasW, atlasH, "hudhd_font"));
+    mHasAtlas = true;
+  }
+  frame->UploadTexture(mFontAtlas, rgba.data());
+  mBakedPx = bakePx;
+  return true;
+}
