+    if (getenv("SIM_DEBUG_FAST")) { sFastForward = true; sFastForwardUncapped = true; SDL_GL_SetSwapInterval(0); printf("SIM_DEBUG_FAST: uncapped\n"); }   // automation runs as fast as it renders
+    if (SIM_Headless_Enabled()) { sFastForward = true; sFastForwardUncapped = true; SDL_GL_SetSwapInterval(0); }   // headless: uncapped, never vsync
