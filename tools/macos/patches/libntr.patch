 }
 
 #ifdef SDK_PORT
+// SIM_FIXED_RTC (sim_headless.cpp): weak so non-simulator links keep wall-clock behaviour.
+__attribute__((weak)) extern int SIM_Headless_GetFixedRTC(int *year, int *month, int *day, int *week, int *hour, int *minute, int *second);
+static int getFixedRTC(RTCDate *date, RTCTime *time)
+{
+    if (!SIM_Headless_GetFixedRTC) return 0;
+    int y, mo, d, w, h, mi, s;
+    if (!SIM_Headless_GetFixedRTC(&y, &mo, &d, &w, &h, &mi, &s)) return 0;
+    if (date) { date->year = (u32)y; date->month = (u32)mo; date->day = (u32)d; date->week = (RTCWeek)w; }
+    if (time) { time->hour = (u32)h; time->minute = (u32)mi; time->second = (u32)s; }
+    return 1;
+}
+
 static void getPCTime( RTCTime* theTime )
 {
+    if (getFixedRTC(NULL, theTime)) return;
     struct tm * timeinfo;
     time_t currentTime = time( NULL );
     timeinfo = localtime( &currentTime );
@@ -193,6 +206,7 @@ static void getPCTime( RTCTime* theTime )
 
 static void getPCDate( RTCDate* theDate )
 {
+    if (getFixedRTC(theDate, NULL)) return;
     struct tm * timeinfo;
     time_t currentTime = time( NULL );
     timeinfo = localtime( &currentTime );
