+#ifndef SIM_G2_GPU_H
+#define SIM_G2_GPU_H
+#include <nitro/types.h>
+#include <simulator/sim_opengl.h>
+
+// GPU 2D layer renderer (perf-g2gpu). Renders BG and OBJ layers directly
+// from VRAM/palette/OAM data textures into the existing layer textures
+// (s_bgTextureId / s_objTextureId / objWindowTextureId), after which the
+// existing g2_fragment.glsl compositing runs unchanged.
+//
+// GPU path is the default; SIM_G2_GPU=0 forces the CPU reference path in sim_g2.cpp.
+// Returns FALSE when the GPU path is disabled or the engine uses a feature
+// the GPU path does not replicate (extended direct-color bitmap, mode 6);
+// the caller then runs the CPU path for that engine.
+BOOL G2GPU_RenderLayers(BOOL isSub, GLuint *bgTexIds, GLuint *objTexIds,
+                        GLuint objWindowTexId);
+
+#endif
diff --git a/libraries/sim/include/sim_hirestext.h b/libraries/sim/include/sim_hirestext.h
new file mode 100644
index 0000000..a497377
--- /dev/null
+++ b/libraries/sim/include/sim_hirestext.h
@@ -0,0 +1,39 @@
+#ifndef SIM_HIRESTEXT_H
+#define SIM_HIRESTEXT_H
+
+// Hi-res text overlay (lane hiresui, prototype).
+//
+// The game still renders all text through the DS tile pipeline; for the main
+// dialogue box it additionally reports every glyph it prints (see
+// include/port/hirestext.h in the game repo, which declares the same C API).
+// This simulator side expands those glyphs at 4x into a combined-display
+// RGBA buffer (1024x1536) and draws it over the composited frame, just
+// before the PostFX pass, so the text is crisp at window scale while
+// positions, colours, scrolling and text speed stay the game's.
+//
+// Only the vertical, unswapped screen layout is mapped; other layouts skip
+// the overlay (the DS text underneath is untouched either way).
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// gfx is the decompressed 4bpp glyph bitmap from TextGlyph (128 bytes,
+// 8x8 tiles of 32 bytes). (x, y) is the glyph position in DS screen pixels.
+// palette is the window's 16-colour palette slot; fgColor/shadowColor are
+// the palette indices of the letter/shadow pixels inside the glyph.
+void HiResText_Glyph(int isSub, int x, int y, int w, int h,
+                     const unsigned char *gfx, int palette,
+                     int fgColor, int shadowColor);
+void HiResText_ClearRect(int isSub, int x, int y, int w, int h);
+void HiResText_ScrollRectUp(int isSub, int x, int y, int w, int h, int dy);
+
+#ifdef __cplusplus
+}
+#endif
+
+// Simulator-internal: draw the overlay into the currently bound framebuffer
+// (the PostFX offscreen frame, viewport = combined-display rect).
+void HiResText_DrawOverlay(void);
+
+#endif
