+void DrawStatusBadge(const HudExtDraw &ext, int status, float x, float y, float w, float h) {
+  if (status == SIM_HUDHD_STATUS_NONE) return;
+  if (ext.useBdspUi && ext.atlas) {
+    const HudUiSprite *sp = nullptr;
+    switch (status) {
+      case SIM_HUDHD_STATUS_PAR: sp = ext.atlas->statusPar; break;
+      case SIM_HUDHD_STATUS_SLP: sp = ext.atlas->statusSlp; break;
+      case SIM_HUDHD_STATUS_FRZ: sp = ext.atlas->statusFrz; break;
+      case SIM_HUDHD_STATUS_BRN: sp = ext.atlas->statusBrn; break;
+      case SIM_HUDHD_STATUS_PSN: sp = ext.atlas->statusPsn; break;
+      case SIM_HUDHD_STATUS_TOX: sp = ext.atlas->statusTox; break;
+      case SIM_HUDHD_STATUS_FNT: sp = ext.atlas->statusFnt; break;
+      default: break;
+    }
+    if (sp) {
+      ext.spriteAspectFit(sp, x, y, w, h, HudC4(255, 255, 255, 1.0f));
+      return;
+    }
+  }
+  const char *lbl = "";
+  HudExtColor top = HudC4(160, 160, 160), bot = HudC4(110, 110, 110);
+  switch (status) {
+    case SIM_HUDHD_STATUS_PSN: lbl = "PSN"; top = HudC4(178, 76, 190); bot = HudC4(134, 46, 148); break;
+    case SIM_HUDHD_STATUS_TOX: lbl = "TOX"; top = HudC4(134, 52, 168); bot = HudC4(96, 30, 128); break;
+    case SIM_HUDHD_STATUS_BRN: lbl = "BRN"; top = HudC4(236, 94, 52);  bot = HudC4(190, 58, 28); break;
+    case SIM_HUDHD_STATUS_PAR: lbl = "PAR"; top = HudC4(234, 186, 36); bot = HudC4(192, 142, 16); break;
+    case SIM_HUDHD_STATUS_SLP: lbl = "SLP"; top = HudC4(136, 152, 174); bot = HudC4(98, 114, 136); break;
+    case SIM_HUDHD_STATUS_FRZ: lbl = "FRZ"; top = HudC4(92, 200, 232); bot = HudC4(56, 154, 192); break;
+    case SIM_HUDHD_STATUS_FNT: lbl = "FNT"; top = HudC4(182, 52, 62);  bot = HudC4(136, 32, 42); break;
+    default: return;
+  }
+  ext.roundRect(x, y, w, h, 2.2f, top, bot, 0.35f, HudC4(255, 255, 255, 0.6f));
+  float tw = ext.measureText(lbl, 5.4f);
+  ext.drawText(lbl, x + (w - tw) * 0.5f, y + (h - 5.4f) * 0.5f - 0.3f, 5.4f, HudC4(255, 255, 255, 1.0f), false);
+}
