+  if (isSub) objExtBase = 0xA0000; // LCDC bank I (also NONE: ext entries are then never selected)
+  else if (s_SIM_GXOBJExtPltt == GX_VRAM_OBJEXTPLTT_0_G) objExtBase = 0x94000;
+  else objExtBase = 0x90000; // F (also NONE)
+
+  u32 ofs[4], aX[4] = {0}, aY[4] = {0};
+  s16 pA[4] = {0}, pB[4] = {0}, pC[4] = {0}, pD[4] = {0};
+  if (isSub) {
