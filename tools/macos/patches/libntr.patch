+
+// Perform a pending display capture: read back the main engine's frame at
+// DS resolution, blend with source B, write RGB555+alpha into the target
+// VRAM bank, then clear the one-shot enable bit (as hardware does).
+// Source B is VRAM in the destination bank at the DISPCAPCNT source offset
+// (the motion-blur feedback layout every in-game user sets up); the main
+// memory FIFO source is approximated by the FIFO register value, as no
+// in-game user selects it.
+static void CaptureFrame() {
+  u32 cap = s_reg_GX_DISPCAPCNT;
+  if (!(cap & 0x80000000u)) return;
+  static const int kW[4] = {128, 256, 256, 256};
+  static const int kH[4] = {128, 64, 128, 192};
+  int sizeSel = (cap >> 20) & 3;
+  int w = kW[sizeSel], h = kH[sizeSel];
+  int mode = (cap >> 29) & 3;          // 0=A, 1=B, 2=blend
+  int srcA3D = (cap >> 24) & 1;
+  int srcBMem = (cap >> 25) & 1;
+  int srcBOfs = ((cap >> 26) & 3) * 0x8000;
+  int destBank = (cap >> 16) & 3;
+  int destOfs = ((cap >> 18) & 3) * 0x8000;
+  int eva = cap & 31; if (eva > 16) eva = 16;
+  int evb = (cap >> 8) & 31; if (evb > 16) evb = 16;
+
+  // Source A, RGBA8, DS top-left origin, 256x192.
+  static u8 srcA[256 * 192 * 4];
+  if (srcA3D) {
+    int scale = s_SIM_config.internalResolutionScale;
+    if (scale < 1) scale = 1;
+    int yOff = (s_reg_GX_POWCNT >> 15) ? SIM_NDS_SCREEN_HEIGHT * scale : 0;
+    SIM::Render::Get().Read3DTarget(yOff, scale, srcA);
+  } else {
+    // Re-render the main engine into the capture target, then read
+    // one screen half out of it. BeginCapture/EndCapture bracket the
+    // re-render and restore the composite target afterwards.
+    SIM::Render::Get().BeginCapture();
+    sInCapture = 1;
+    DrawEngine(FALSE);
+    sInCapture = 0;
+    int y0 = (s_reg_GX_POWCNT >> 15) ? SIM_NDS_SCREEN_HEIGHT : 0;
+    SIM::Render::Get().ReadCapture(y0, srcA);
+    SIM::Render::Get().EndCapture();
+  }
+
+  u16 *lcdc = (u16 *)s_HW_LCDC_VRAM;
+  int destIdx = (destBank * 0x20000 + destOfs) / 2;
+  int srcBIdx = (destBank * 0x20000 + srcBOfs) / 2;
+
+  // BG views of the destination bank, for games that re-map the captured
+  // bank as a BG (the encounter transition reads it as BG3 DC bitmap).
+  // VRAMCNT A-D: bit7 enable, MST bits0-2 (1=main BG, 4=sub BG for C),
+  // OFS bits3-4 in 128K units (main BG).
+  const u8 vramcnt[4] = {s_reg_GX_VRAMCNT_A, s_reg_GX_VRAMCNT_B, s_reg_GX_VRAMCNT_C, s_reg_GX_VRAMCNT_D};
+  u8 *bgAlias = nullptr, *subBgAlias = nullptr;
+  {
+    u8 vc = vramcnt[destBank];
+    int mst = vc & 7, ofs = ((vc >> 3) & 3) * 0x20000;
+    if ((vc & 0x80) && mst == 1) bgAlias = (u8 *)s_HW_BG_VRAM + ofs + destOfs;
+    if ((vc & 0x80) && mst == 4) subBgAlias = (u8 *)s_HW_DB_BG_VRAM + destOfs;
+    if (!bgAlias) {
+      // Not BG-mapped yet: the game maps it right after capturing. Use the
+      // layouts the capture users set up (C/D as the second 128K of a 256K
+      // main BG, A at 0) unless another bank already owns that BG range.
+      int want = destBank == 0 ? 0 : (destBank == 2 || destBank == 3) ? 0x20000 : -1;
+      if (want >= 0) {
+        bool covered = false;
+        for (int b = 0; b < 4; b++) {
+          u8 o = vramcnt[b];
+          if ((o & 0x80) && (o & 7) == 1) {
+            int oo = ((o >> 3) & 3) * 0x20000;
+            if (want >= oo && want < oo + 0x20000) covered = true;
+          }
+        }
+        if (!covered) bgAlias = (u8 *)s_HW_BG_VRAM + want + destOfs;
+      }
+    }
+  }
+
+  if (srcBMem) {
+    static int logged = 0;
+    if (!logged) { logged = 1; printf("SIM capture: main-memory FIFO source B approximated by DISP_MMEM_FIFO value\n"); }
+  }
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      int i = y * w + x;
+      const u8 *a = &srcA[(y * 256 + x) * 4];
+      int ar = (a[0] * 31 + 127) / 255, ag = (a[1] * 31 + 127) / 255, ab = (a[2] * 31 + 127) / 255;
+      u16 bpx = srcBMem ? (u16)s_reg_GX_DISP_MMEM_FIFO : lcdc[srcBIdx + i];
+      int br = bpx & 31, bg = (bpx >> 5) & 31, bb = (bpx >> 10) & 31;
+      int r, g, b;
+      if (mode == 0) { r = ar; g = ag; b = ab; }
+      else if (mode == 1) { r = br; g = bg; b = bb; }
+      else {
+        r = (ar * eva + br * evb + 8) >> 4;
+        g = (ag * eva + bg * evb + 8) >> 4;
+        b = (ab * eva + bb * evb + 8) >> 4;
+        if (r > 31) r = 31; if (g > 31) g = 31; if (b > 31) b = 31;
+      }
+      int alpha = mode == 1 ? ((bpx >> 15) & 1) : 1;
+      u16 out = (u16)(r | (g << 5) | (b << 10) | (alpha << 15));
+      lcdc[destIdx + i] = out;
+      if (bgAlias) *(u16 *)(bgAlias + i * 2) = out;
+      if (subBgAlias) *(u16 *)(subBgAlias + i * 2) = out;
+    }
+  }
+  s_reg_GX_DISPCAPCNT = cap & ~0x80000000u;
+  if (getenv("SIM_DEBUG_CAPTURE"))
+    printf("SIM capture: %dx%d mode=%d srcA=%s eva=%d evb=%d dest=VRAM_%c+0x%x\n",
+           w, h, mode, srcA3D ? "3D" : "2D3D", eva, evb, 'A' + destBank, destOfs);
+}
