+        if (rimStr > 0.001) {
+            float3 V = normalize(u.camEye.xyz - in.worldPos);
+            float ndotv = clamp(dot(N, V), 0.0, 1.0);
+            float rim = pow(1.0 - ndotv, 2.8) * smoothstep(-0.25, 0.65, NdotL + 0.35);
