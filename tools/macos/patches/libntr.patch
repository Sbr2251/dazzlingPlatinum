+// ios-controls hook: on-screen gamepad overlay, finger routing and gamepad state.
+// Drawn by the render backend after PostFX (Backend::DrawTouchpadOverlay).
+#pragma once
+#include <cstdint>
+#include <vector>
+
+namespace SIM::Touchpad {
+
+// DS pad bits (same layout as SIM_DebugKeyMask): low 10 bits PAD, bits 10/11 XY.
+enum : uint32_t {
+  kA = 1u << 0, kB = 1u << 1, kSelect = 1u << 2, kStart = 1u << 3,
+  kRight = 1u << 4, kLeft = 1u << 5, kUp = 1u << 6, kDown = 1u << 7,
+  kR = 1u << 8, kL = 1u << 9, kX = 1u << 10, kY = 1u << 11,
+};
+
+enum class Btn { DPad, A, B, X, Y, L, R, Start, Select, FastForward, Pause, Panel };
+
+struct RectN { float x, y, w, h; Btn btn; const char *label; bool pressed; };
+
+// configMode: 0=auto (on for iOS), 1=on, 2=off. SIM_TOUCHPAD=1/0 env wins.
+void Init(int configMode);
+void SetMode(int configMode); // dbg-perf-sim hook: live set_config
+bool Enabled();
+bool ForcedByEnv();
+void SetGamepadConnected(bool connected);
+bool GamepadConnected();
+// Recomputes layout for the window size; returns true when the overlay should be drawn.
+bool Visible(int winW, int winH);
+int Layout(int winW, int winH, RectN *out, int maxOut);
+// True when (nx,ny) in [0,1] window space hits an overlay button.
+bool HitTest(float nx, float ny, int winW, int winH);
+
+// Finger lifecycle in window-normalised coordinates. Down returns true when
+// an overlay button consumed the finger (it must not reach the DS screen).
+bool FingerDown(int64_t finger, float nx, float ny, int winW, int winH);
+void FingerMotion(int64_t finger, float nx, float ny, int winW, int winH);
+void FingerUp(int64_t finger, float nx, float ny, int winW, int winH);
+bool IsOverlayFinger(int64_t finger);
+void NoteTouch();  // any finger down: show the overlay again
+
+uint32_t HeldMask();       // DS bits currently held by overlay fingers
+bool FastForwardHeld();
+bool TakePauseToggle();
+bool TakePanelToggle();
+
+// Headless injection queue (cmd "finger"): normalised window coords.
+void InjectFinger(float nx, float ny, int phase);  // 0=down 1=motion 2=up
+bool PollInjected(float *nx, float *ny, int *phase);
+
+// Rasterised overlay (RGBA8, winW x winH, top-down). Regenerated only when
+// size, pressed state or visibility changes; dirty is set then.
+const std::vector<uint8_t> &Bitmap(int winW, int winH, bool *dirty);
+
+}  // namespace SIM::Touchpad
