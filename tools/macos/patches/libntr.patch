+bool GatePermits() {
+  const auto &e = GetGateEnv();
+  if (e.bdspZero) return false;
+  if (SIM_Headless_Enabled()) {
+    return e.bdspOne || e.interactiveFxOne;
+  }
+  return true;
+}
