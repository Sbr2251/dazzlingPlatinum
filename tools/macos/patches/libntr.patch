+static bool CaseUploadOrdering(Device &d) {
+    Texture tex;
+    CHECK(tex.Create(d, TextureDesc::Rgba8(1, 1, "selftest-order")), "texture create");
+    static const Uint8 red[4] = { 255, 0, 0, 255 };
+    static const Uint8 blue[4] = { 0, 0, 255, 255 };
+    RenderTarget target;
+    CHECK(target.Create(d, 2, 1, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, false, "selftest-order-target"), "target create");
+    Frame *f = d.BeginFrame();
+    CHECK(f, "BeginFrame");
+    f->UploadTexture(tex, red);
+    CHECK(f->BeginPass(Phase::Scene3D, PassDesc::Color(target.Color().Handle())), "BeginPass");
+    f->BindPipeline(Pipe(d, test_textured_vert, test_textured_frag, TexturedLayout()));
+    f->SetViewport(FullViewport(2, 1));
+    f->BindFragmentSampler(0, tex.Handle(), d.Sampler(SamplerKey::Nearest()));
+    // Left half with the red texture, then an upload to the same texture, then
+    // the right half: the upload splits the pass, so the right half is blue.
+    f->SetScissor(SDL_Rect{ 0, 0, 1, 1 });
+    FullscreenUvQuad(f);
+    f->UploadTexture(tex, blue);
+    f->SetScissor(SDL_Rect{ 1, 0, 1, 1 });
+    FullscreenUvQuad(f);
+    f->EndPass();
+    CHECK(f->End(), "End");
+    CHECK(f->Stats().passSplits >= 1, "upload to a referenced texture did not split the pass (splits=%u)",
+          f->Stats().passSplits);
+    std::vector<Uint8> px;
+    CHECK(d.ReadbackRGBA8(target.Color(), px), "readback");
+    CHECK(PixelEq(px, 2, 0, 0, 255, 0, 0, 255), "upload ordering: left half is not red");
+    CHECK(PixelEq(px, 2, 1, 0, 0, 0, 255, 255), "upload ordering: right half is not blue");
+    return true;
+}
