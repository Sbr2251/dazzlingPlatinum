 //mmap_shared
-u8 s_HW_MAIN_MEM_SYSTEM[HW_MAIN_MEM_SYSTEM_SIZE];
-u8 s_HW_ARENA_INFO_BUF[sizeof(OSArenaInfo)];
-u8 s_HW_MAIN_MEM_SUB[0x400000];
+// These arrays back the OS arenas (MAIN arena Lo = MAIN_MEM + 0xe3e0, a
+// multiple of 8) and the arena-info struct, which holds pointers. As
+// plain u8 arrays they have alignment 1, so the linker may place them
+// 4-aligned -- and every heap created in them then starts 4-aligned,
+// tripping UBSan on pointer-containing heap headers. Align them to 8.
+__attribute__((aligned(8))) u8 s_HW_MAIN_MEM_SYSTEM[HW_MAIN_MEM_SYSTEM_SIZE];
+__attribute__((aligned(8))) u8 s_HW_ARENA_INFO_BUF[sizeof(OSArenaInfo)];
+__attribute__((aligned(8))) u8 s_HW_MAIN_MEM_SUB[0x400000];
 
 //mmap_global
-u8 s_HW_MAIN_MEM[0x800000];
-u8 s_HW_MAIN_MEM_EX[0x800000];
+#ifdef SDK_HW_PLTT_BLOCK
+SIM_HWPlttBlock s_HW_PLTT_BLOCK;
+#endif
+__attribute__((aligned(8))) u8 s_HW_MAIN_MEM[0x2000000]; // 32 MB emulated main RAM (lane heap)
+__attribute__((aligned(8))) u8 s_HW_MAIN_MEM_EX[0x800000];
+#ifndef SDK_HW_PLTT_BLOCK
 u8 s_HW_BG_PLTT[0x200];
+#endif
+#ifndef SDK_HW_PLTT_BLOCK
 u8 s_HW_OBJ_PLTT[0x200];
+#endif
+#ifndef SDK_HW_PLTT_BLOCK
 u8 s_HW_DB_BG_PLTT[0x200];
+#endif
+#ifndef SDK_HW_PLTT_BLOCK
 u8 s_HW_DB_OBJ_PLTT[0x200];
+#endif
 u8 s_HW_BG_VRAM[0x80000];
 u8 s_HW_DB_BG_VRAM[0x20000];
 u8 s_HW_OBJ_VRAM[0x40000];
