diff --git a/libraries/sim/src/gpu/shaders/sim_gpu.glsl b/libraries/sim/src/gpu/shaders/sim_gpu.glsl
new file mode 100644
index 0000000..11649df
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/sim_gpu.glsl
@@ -0,0 +1,16 @@
+// Shared helpers for shaders ported from the OpenGL renderer. Include with
+//   #include "sim_gpu.glsl"
+// (gpu_shaderc.py passes the shader directory with -I). See coords.hpp.
+#ifndef SIM_GPU_GLSL
+#define SIM_GPU_GLSL
+
+// GL clip-space position (z in [-w, w]) to SDL_GPU clip space (z in [0, w]).
+// Feed the original z to anything that reads depth itself (for example fog).
+#define SIM_GL_TO_GPU_DEPTH(P) vec4((P).xy, ((P).z + (P).w) * 0.5, (P).w)
+
+// Texture coordinate for sampling a render target with a GL-convention t
+// (a render target's visual top is v = 0 under SDL_GPU, t = 1 under GL).
+// CPU-uploaded textures need no change: v = 0 is row 0 of the upload in both.
+#define SIM_RT_UV(UV) vec2((UV).x, 1.0 - (UV).y)
+
+#endif
