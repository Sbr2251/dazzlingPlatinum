+// GPU 2D layer renderer (perf-g2gpu).
+//
+// Renders each BG layer, each OBJ priority layer and the OBJ window mask
+// directly from VRAM / palette / OAM data textures into the layer textures
+// the existing g2_fragment.glsl compositing already samples. The CPU path
+// in sim_g2.cpp stays as the reference and fallback (SIM_G2_GPU=0).
+//
+// Both paths implement the same GBATEK behaviour: BG + OBJ mosaic,
+// WIN0/WIN1 windows on all BG kinds (the composite resolves the full
+// WIN0 > WIN1 > OBJ window > outside priority), 256-colour OBJ extended
+// palettes (DISPCNT bit 31), bitmap OBJ direct colour + per-sprite alpha,
+// and semi-transparent (XLU) OBJ blending via BLDALPHA in the composite.
+// Fallbacks (whole engine, logged once): extended direct-color bitmap
+// (the CPU reads the RGB555 pixel directly), BG mode 6.
+//
+// Shader inputs are plain data textures (R8UI/R16UI) and int uniforms so a
+// Metal port is mechanical. GL 4.1 core only.
+#include <nitro.h>
+#include <simulator/sim.h>
+#include <simulator/sim_opengl.h>
+#include <simulator/simvariables.h>
+#include <nitro/gx/gx_vramcnt.h>
+#include <stdio.h>
+#include <string.h>
+#include "sim_g2_gpu.h"
+
+extern u8 s_SIM_DBG_BGenable[4];
+extern u8 s_SIM_DBG_OAMenable;
+extern u8 s_SIM_DBG_BGSenable[4];
+extern u8 s_SIM_DBG_OAMSenable;
+extern GXVRamBGExtPltt s_SIM_GXBgExtPltt;
+extern GXVRamSubBGExtPltt s_SIM_GXSubBgExtPltt;
+extern GXVRamOBJExtPltt s_SIM_GXOBJExtPltt;
+extern GXVRamSubOBJExtPltt s_SIM_GXSubOBJExtPltt;
+
+static const char *kVertSrc =
+#include "shaders/g2gpu_vertex.glsl"
+;
+static const char *kFragSrc =
+#include "shaders/g2gpu_fragment.glsl"
+;
+
+static GLuint sProg = 0, sFbo = 0, sVao = 0, sDepthRb = 0;
+static GLuint sBgVramTex[2] = {0, 0}, sObjVramTex[2] = {0, 0}, sLcdcTex = 0, sOamTex = 0, sPalTex = 0;
+static int sInitFailed = 0;
+static int sLoggedFallback = 0;
+
+static GLuint Compile(GLenum type, const char *src) {
+  // macOS: rewrite the leading "#version 420" to "#version 410" (GL 4.1).
+  char *tmp = nullptr;
+  const char *use = src;
+#ifdef SDK_BUILD_MACOS
+  if (strncmp(src, "\n#version 420", 13) == 0 || strncmp(src, "#version 420", 12) == 0) {
+    tmp = strdup(src);
+    char *p = strstr(tmp, "#version 420");
+    if (p) memcpy(p, "#version 410", 12);
+    use = tmp;
+  }
+#endif
+  GLuint s = glCreateShader(type);
+  glShaderSource(s, 1, &use, nullptr);
+  glCompileShader(s);
+  GLint ok = 0;
+  glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+  if (!ok) {
+    GLint len = 0;
+    glGetShaderiv(s, GL_INFO_LOG_LENGTH, &len);
+    char *log = new char[len + 1]();
+    glGetShaderInfoLog(s, len, nullptr, log);
+    printf("SIM_G2_GPU: shader compile failed: %s\n", log);
+    delete[] log;
+  }
+  if (tmp) free(tmp);
+  return ok ? s : 0;
+}
+
+static bool Init() {
+  if (sProg || sInitFailed) return sProg != 0;
+  GLuint vs = Compile(GL_VERTEX_SHADER, kVertSrc);
+  GLuint fs = Compile(GL_FRAGMENT_SHADER, kFragSrc);
+  if (!vs || !fs) { sInitFailed = 1; return false; }
+  sProg = glCreateProgram();
+  glAttachShader(sProg, vs);
+  glAttachShader(sProg, fs);
+  glLinkProgram(sProg);
+  GLint ok = 0;
+  glGetProgramiv(sProg, GL_LINK_STATUS, &ok);
+  if (!ok) {
+    GLint len = 0;
+    glGetProgramiv(sProg, GL_INFO_LOG_LENGTH, &len);
+    char *log = new char[len + 1]();
+    glGetProgramInfoLog(sProg, len, nullptr, log);
+    printf("SIM_G2_GPU: link failed: %s\n", log);
+    delete[] log;
+    sInitFailed = 1;
+    return false;
+  }
+  glGenFramebuffers(1, &sFbo);
+  glGenVertexArrays(1, &sVao);
+  // Depth buffer for the per-sprite OBJ passes (lowest OAM index wins).
+  glBindFramebuffer(GL_FRAMEBUFFER, sFbo);
+  glGenRenderbuffers(1, &sDepthRb);
+  glBindRenderbuffer(GL_RENDERBUFFER, sDepthRb);
+  glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT * 2);
+  glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, sDepthRb);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  auto mkTex = [](GLuint &t, GLenum internal, int w, int h, GLenum fmt) {
+    glGenTextures(1, &t);
+    glBindTexture(GL_TEXTURE_2D, t);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, internal, w, h, 0, fmt, GL_UNSIGNED_BYTE, nullptr);
+  };
+  mkTex(sBgVramTex[0], GL_R8UI, 2048, 256, GL_RED_INTEGER);
+  mkTex(sBgVramTex[1], GL_R8UI, 2048, 256, GL_RED_INTEGER);
+  mkTex(sObjVramTex[0], GL_R8UI, 1024, 256, GL_RED_INTEGER);
+  mkTex(sObjVramTex[1], GL_R8UI, 1024, 256, GL_RED_INTEGER);
+  mkTex(sLcdcTex, GL_R8UI, 2048, 328, GL_RED_INTEGER);
+  glGenTextures(1, &sOamTex);
+  glBindTexture(GL_TEXTURE_2D, sOamTex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_R16UI, 512, 2, 0, GL_RED_INTEGER, GL_UNSIGNED_SHORT, nullptr);
+  glGenTextures(1, &sPalTex);
+  glBindTexture(GL_TEXTURE_2D, sPalTex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_R16UI, 256, 4, 0, GL_RED_INTEGER, GL_UNSIGNED_SHORT, nullptr);
+  glUseProgram(sProg);
+  glUniform1i(glGetUniformLocation(sProg, "bgVramTex"), 10);
+  glUniform1i(glGetUniformLocation(sProg, "objVramTex"), 11);
+  glUniform1i(glGetUniformLocation(sProg, "lcdcTex"), 12);
+  glUniform1i(glGetUniformLocation(sProg, "oamTex"), 13);
+  glUniform1i(glGetUniformLocation(sProg, "palTex"), 14);
+  printf("SIM_G2_GPU: GPU 2D layer renderer enabled\n");
+  return true;
+}
+
+static bool EngineFallback(int isSub, int bgMode, const u16 cnt[4], const u8 enabled[4], int bg0as3d) {
+  for (int i = 0; i < 4; i++) {
+    if (!enabled[i]) continue;
+    if (i == 0 && bg0as3d && !isSub) continue;
+    // Mode 6 large BG on BG2 (main): CPU uploads a stale buffer.
+    if (i == 2 && bgMode == 6 && !isSub) return true;
+    bool extended = (i == 2 && bgMode == 5) || (i == 3 && bgMode >= 3 && bgMode <= 5);
+    // Extended direct-color bitmap: CPU dereferences an uninitialized palette pointer.
+    if (extended && (cnt[i] & 0x84) == 0x84) return true;
+  }
+  return false;
+}
+
+BOOL G2GPU_RenderLayers(BOOL isSub, GLuint *bgTexIds, GLuint *objTexIds, GLuint objWindowTexId) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char *e = getenv("SIM_G2_GPU");
+    enabled = (!e || atoi(e)) ? 1 : 0; // GPU is the default; SIM_G2_GPU=0 forces the CPU path
+  }
+  if (!enabled) return FALSE;
+  if (!Init()) return FALSE;
+
