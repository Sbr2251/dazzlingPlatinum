+static inline void HashMix(size_t &h, size_t v) {
+    h ^= v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+}
+
+size_t PipelineKeyHash::operator()(const PipelineKey &k) const {
+    size_t h = 0;
+    HashMix(h, (size_t)(uintptr_t)k.vertex);
+    HashMix(h, (size_t)(uintptr_t)k.fragment);
+    HashMix(h, k.layout.stride);
+    HashMix(h, k.layout.numAttributes);
+    for (Uint32 i = 0; i < k.layout.numAttributes && i < kMaxVertexAttributes; i++) {
+        const VertexAttribute &a = k.layout.attributes[i];
+        HashMix(h, a.location | ((size_t)a.format << 8) | ((size_t)a.offset << 16));
+    }
+    HashMix(h, (size_t)k.primitive | ((size_t)k.cull << 4) | ((size_t)k.frontFace << 8) | ((size_t)k.depthTest << 10) |
+                   ((size_t)k.depthWrite << 11) | ((size_t)k.depthCompare << 12) | ((size_t)k.blend << 16) |
+                   ((size_t)k.colorWriteMask << 20));
+    HashMix(h, (size_t)k.colorFormat | ((size_t)k.depthFormat << 16));
+    return h;
+}
+
+static SDL_GPUColorTargetBlendState BlendState(Blend blend, Uint8 writeMask) {
+    SDL_GPUColorTargetBlendState s;
+    SDL_zero(s);
+    s.color_write_mask = writeMask;
+    s.enable_color_write_mask = writeMask != 0xF;
+    s.color_blend_op = SDL_GPU_BLENDOP_ADD;
+    s.alpha_blend_op = SDL_GPU_BLENDOP_ADD;
+    switch (blend) {
+    case Blend::Opaque:
+        s.enable_blend = false;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ZERO;
+        break;
+    case Blend::Alpha:
+        s.enable_blend = true;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_SRC_ALPHA;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
+        break;
+    case Blend::Premultiplied:
+        s.enable_blend = true;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE_MINUS_SRC_ALPHA;
+        break;
+    case Blend::Additive:
+        s.enable_blend = true;
+        s.src_color_blendfactor = s.src_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        s.dst_color_blendfactor = s.dst_alpha_blendfactor = SDL_GPU_BLENDFACTOR_ONE;
+        break;
+    }
+    return s;
+}
+
+PipelineCache::~PipelineCache() { Clear(); }
+
+void PipelineCache::Clear() {
+    if (mDevice.Handle()) {
+        for (auto &kv : mPipelines) SDL_ReleaseGPUGraphicsPipeline(mDevice.Handle(), kv.second);
+    }
+    mPipelines.clear();
+}
+
+SDL_GPUGraphicsPipeline *PipelineCache::Get(const PipelineKey &key) {
+    auto it = mPipelines.find(key);
+    if (it != mPipelines.end()) return it->second;
+    if (!key.vertex || !key.fragment) {
+        mDevice.ReportFailure("PipelineCache::Get: key without vertex or fragment shader", false);
+        return nullptr;
+    }
+    SDL_GPUShader *vs = mDevice.Shader(*key.vertex);
+    SDL_GPUShader *fs = mDevice.Shader(*key.fragment);
+    if (!vs || !fs) return nullptr;
+
+    SDL_GPUGraphicsPipelineCreateInfo info;
+    SDL_zero(info);
+    info.vertex_shader = vs;
+    info.fragment_shader = fs;
+
+    SDL_GPUVertexBufferDescription vb;
+    SDL_zero(vb);
+    SDL_GPUVertexAttribute attrs[kMaxVertexAttributes];
+    if (key.layout.numAttributes > 0) {
+        vb.slot = 0;
+        vb.pitch = key.layout.stride;
+        vb.input_rate = SDL_GPU_VERTEXINPUTRATE_VERTEX;
+        for (Uint32 i = 0; i < key.layout.numAttributes; i++) {
+            attrs[i].location = key.layout.attributes[i].location;
+            attrs[i].buffer_slot = 0;
+            attrs[i].format = key.layout.attributes[i].format;
+            attrs[i].offset = key.layout.attributes[i].offset;
+        }
+        info.vertex_input_state.vertex_buffer_descriptions = &vb;
+        info.vertex_input_state.num_vertex_buffers = 1;
+        info.vertex_input_state.vertex_attributes = attrs;
+        info.vertex_input_state.num_vertex_attributes = key.layout.numAttributes;
+    }
+    info.primitive_type = key.primitive;
+    info.rasterizer_state.fill_mode = SDL_GPU_FILLMODE_FILL;
+    info.rasterizer_state.cull_mode = key.cull;
+    info.rasterizer_state.front_face = key.frontFace;
+    info.rasterizer_state.enable_depth_clip = true;  // GL behaviour; also needs no depthClamp feature
+    info.multisample_state.sample_count = SDL_GPU_SAMPLECOUNT_1;
+    info.depth_stencil_state.enable_depth_test = key.depthTest;
+    info.depth_stencil_state.enable_depth_write = key.depthTest && key.depthWrite;
+    info.depth_stencil_state.compare_op = key.depthTest ? key.depthCompare : SDL_GPU_COMPAREOP_ALWAYS;
+
+    SDL_GPUColorTargetDescription color;
+    SDL_zero(color);
+    if (key.colorFormat != SDL_GPU_TEXTUREFORMAT_INVALID) {
+        color.format = key.colorFormat;
+        color.blend_state = BlendState(key.blend, key.colorWriteMask);
+        info.target_info.color_target_descriptions = &color;
+        info.target_info.num_color_targets = 1;
+    }
+    if (key.depthFormat != SDL_GPU_TEXTUREFORMAT_INVALID) {
+        info.target_info.has_depth_stencil_target = true;
+        info.target_info.depth_stencil_format = key.depthFormat;
+    } else if (key.depthTest) {
+        mDevice.ReportFailure("PipelineCache::Get: depth test without a depth format", false);
+        return nullptr;
+    }
+
+    char name[160];
+    SDL_snprintf(name, sizeof name, "%s+%s", key.vertex->name, key.fragment->name);
+    SDL_PropertiesID props = SDL_CreateProperties();
+    SDL_SetStringProperty(props, SDL_PROP_GPU_GRAPHICSPIPELINE_CREATE_NAME_STRING, name);
+    info.props = props;
+    SDL_GPUGraphicsPipeline *pipeline = SDL_CreateGPUGraphicsPipeline(mDevice.Handle(), &info);
+    SDL_DestroyProperties(props);
+    if (!pipeline) {
+        char ctx[256];
+        SDL_snprintf(ctx, sizeof ctx, "SDL_CreateGPUGraphicsPipeline(%s)", name);
+        mDevice.ReportFailure(ctx);
+        return nullptr;
+    }
+    mPipelines.emplace(key, pipeline);
+    return pipeline;
+}
+
+} // namespace SIM::Gpu
diff --git a/libraries/sim/src/gpu/gpu_readback.cpp b/libraries/sim/src/gpu/gpu_readback.cpp
new file mode 100644
index 0000000..d983696
--- /dev/null
+++ b/libraries/sim/src/gpu/gpu_readback.cpp
@@ -0,0 +1,165 @@
+#include <simulator/gpu/device.hpp>
+#include <simulator/gpu/readback.hpp>
+
+namespace SIM::Gpu {
+
+ReadbackRing::ReadbackRing(Device &device, Uint32 slots) : mDevice(device) {
+    if (slots < 1) slots = 1;
+    if (slots > 8) slots = 8;
+    mSlots.resize(slots);
+}
+
+ReadbackRing::~ReadbackRing() {
+    for (Slot &s : mSlots) DiscardSlot(s);
+}
+
+void ReadbackRing::DiscardSlot(Slot &slot) {
+    SDL_GPUDevice *dev = mDevice.Handle();
+    if (dev) {
+        if (slot.fence) SDL_ReleaseGPUFence(dev, slot.fence);
+        if (slot.buffer) SDL_ReleaseGPUTransferBuffer(dev, slot.buffer);
+    }
+    slot = Slot();
+}
+
+bool ReadbackRing::HasOutstanding() const {
+    for (const Slot &s : mSlots) {
+        if (s.token != 0) return true;
+    }
+    return false;
+}
+
+Uint64 ReadbackRing::Request(SDL_GPUTexture *texture, SDL_GPUTextureFormat format, Uint32 x, Uint32 y, Uint32 w, Uint32 h) {
+    if (!mDevice.Handle() || !texture || w == 0 || h == 0) {
+        mDevice.ReportFailure("ReadbackRing::Request: no device, texture or region", false);
+        return 0;
+    }
+    const Uint32 bytes = SDL_CalculateGPUTextureFormatSize(format, w, h, 1);
+    if (bytes == 0) {
+        mDevice.ReportFailure("ReadbackRing::Request: unknown texture format size", false);
+        return 0;
+    }
+    bool swapRB = false;
+    switch (format) {
+    case SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM:
+    case SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM_SRGB:
+        break;
+    case SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM:
+    case SDL_GPU_TEXTUREFORMAT_B8G8R8A8_UNORM_SRGB:
+        swapRB = true;
+        break;
+    default:
+        mDevice.ReportFailure("ReadbackRing::Request: only RGBA8/BGRA8 textures (capture targets are RGBA8)", false);
+        return 0;
+    }
+
+    Slot &slot = mSlots[mNextSlot];
+    mNextSlot = (mNextSlot + 1) % (Uint32)mSlots.size();
+    if (slot.token != 0) {
+        // Ring full: wait for the oldest download so its slot can be reused.
+        // Its result was never collected and is discarded.
+        SDL_GPUFence *fence = slot.fence;
+        if (fence && !SDL_WaitForGPUFences(mDevice.Handle(), true, &fence, 1)) {
+            mDevice.ReportFailure("ReadbackRing::Request: SDL_WaitForGPUFences (ring full)");
+            return 0;
+        }
+        DiscardSlot(slot);
+    }
+    if (!slot.buffer || slot.bufferSize < bytes) {
+        if (slot.buffer) SDL_ReleaseGPUTransferBuffer(mDevice.Handle(), slot.buffer);
+        SDL_GPUTransferBufferCreateInfo info;
+        SDL_zero(info);
+        info.usage = SDL_GPU_TRANSFERBUFFERUSAGE_DOWNLOAD;
+        info.size = bytes;
+        slot.buffer = SDL_CreateGPUTransferBuffer(mDevice.Handle(), &info);
+        slot.bufferSize = slot.buffer ? bytes : 0;
+        if (!slot.buffer) {
+            mDevice.ReportFailure("ReadbackRing::Request: SDL_CreateGPUTransferBuffer (download)");
+            return 0;
+        }
+    }
+
+    SDL_GPUCommandBuffer *cmd = SDL_AcquireGPUCommandBuffer(mDevice.Handle());
+    if (!cmd) {
+        mDevice.ReportFailure("ReadbackRing::Request: SDL_AcquireGPUCommandBuffer");
+        return 0;
+    }
+    SDL_GPUCopyPass *copy = SDL_BeginGPUCopyPass(cmd);
+    if (!copy) {
+        mDevice.ReportFailure("ReadbackRing::Request: SDL_BeginGPUCopyPass");
+        SDL_CancelGPUCommandBuffer(cmd);
+        return 0;
+    }
+    SDL_GPUTextureRegion src;
+    SDL_zero(src);
+    src.texture = texture;
+    src.x = x;
+    src.y = y;
+    src.w = w;
+    src.h = h;
+    src.d = 1;
+    SDL_GPUTextureTransferInfo dst;
+    SDL_zero(dst);
+    dst.transfer_buffer = slot.buffer;
+    dst.offset = 0;
+    dst.pixels_per_row = w;
+    dst.rows_per_layer = h;
+    SDL_DownloadFromGPUTexture(copy, &src, &dst);
+    SDL_EndGPUCopyPass(copy);
+    slot.fence = SDL_SubmitGPUCommandBufferAndAcquireFence(cmd);
+    if (!slot.fence) {
+        mDevice.ReportFailure("ReadbackRing::Request: SDL_SubmitGPUCommandBufferAndAcquireFence");
+        return 0;
+    }
+    slot.token = mNextToken++;
+    slot.bytes = bytes;
+    slot.format = format;
+    slot.swapRB = swapRB;
+    return slot.token;
+}
+
+bool ReadbackRing::Collect(Uint64 token, std::vector<Uint8> &out, bool wait) {
+    if (token == 0) return false;  // token 0 is never valid; not a device failure
+    Slot *slot = nullptr;
+    for (Slot &s : mSlots) {
+        if (s.token == token) {
+            slot = &s;
+            break;
+        }
+    }
+    if (!slot) {
+        // Unknown or discarded token (collect before the ring wraps): a caller
+        // error, logged without flagging the device as failed.
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "SIM_GPU: ReadbackRing::Collect: unknown or discarded token");
+        return false;
+    }
+    if (wait) {
+        SDL_GPUFence *fence = slot->fence;
+        if (!SDL_WaitForGPUFences(mDevice.Handle(), true, &fence, 1)) {
+            mDevice.ReportFailure("ReadbackRing::Collect: SDL_WaitForGPUFences");
+            return false;
+        }
+    } else if (!SDL_QueryGPUFence(mDevice.Handle(), slot->fence)) {
+        return false;
+    }
+    const Uint8 *mapped = (const Uint8 *)SDL_MapGPUTransferBuffer(mDevice.Handle(), slot->buffer, false);
+    if (!mapped) {
+        mDevice.ReportFailure("ReadbackRing::Collect: SDL_MapGPUTransferBuffer");
+        return false;
+    }
+    out.assign(mapped, mapped + slot->bytes);
+    SDL_UnmapGPUTransferBuffer(mDevice.Handle(), slot->buffer);
+    if (slot->swapRB) {
+        for (size_t i = 0; i + 3 < out.size(); i += 4) {
+            Uint8 t = out[i];
+            out[i] = out[i + 2];
+            out[i + 2] = t;
+        }
+    }
+    SDL_ReleaseGPUFence(mDevice.Handle(), slot->fence);
+    slot->fence = nullptr;
+    slot->token = 0;
+    return true;
+}
+
+} // namespace SIM::Gpu
diff --git a/libraries/sim/src/gpu/gpu_texture.cpp b/libraries/sim/src/gpu/gpu_texture.cpp
new file mode 100644
index 0000000..34de777
--- /dev/null
+++ b/libraries/sim/src/gpu/gpu_texture.cpp
@@ -0,0 +1,181 @@
+#include <simulator/gpu/device.hpp>
+#include <simulator/gpu/texture.hpp>
+
+#include <utility>
+
+namespace SIM::Gpu {
+
+TextureDesc TextureDesc::Rgba8(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d;
+    d.width = w;
+    d.height = h;
+    d.format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+    d.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER;
+    d.name = name;
+    return d;
+}
+
+TextureDesc TextureDesc::R8Uint(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = SDL_GPU_TEXTUREFORMAT_R8_UINT;
+    // Storage texture (see the header): SAMPLER is forbidden on integer formats.
+    d.usage = SDL_GPU_TEXTUREUSAGE_GRAPHICS_STORAGE_READ;
+    return d;
+}
+
+TextureDesc TextureDesc::R16Uint(Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = SDL_GPU_TEXTUREFORMAT_R16_UINT;
+    d.usage = SDL_GPU_TEXTUREUSAGE_GRAPHICS_STORAGE_READ;
+    return d;
+}
+
+TextureDesc TextureDesc::ColorTarget(Uint32 w, Uint32 h, SDL_GPUTextureFormat format, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = format;
+    d.usage = SDL_GPU_TEXTUREUSAGE_SAMPLER | SDL_GPU_TEXTUREUSAGE_COLOR_TARGET;
+    return d;
+}
+
+TextureDesc TextureDesc::DepthTarget(const Device &device, Uint32 w, Uint32 h, const char *name) {
+    TextureDesc d = Rgba8(w, h, name);
+    d.format = device.DepthFormat();
+    d.usage = SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET;
+    return d;
+}
+
+Texture::Texture(Texture &&o) noexcept : mDevice(o.mDevice), mTexture(o.mTexture), mDesc(o.mDesc) {
+    o.mTexture = nullptr;
+}
+
+Texture &Texture::operator=(Texture &&o) noexcept {
+    if (this != &o) {
+        Release();
+        mDevice = o.mDevice;
+        mTexture = o.mTexture;
+        mDesc = o.mDesc;
+        o.mTexture = nullptr;
+    }
+    return *this;
+}
+
+bool Texture::Create(Device &device, const TextureDesc &desc) {
+    Release();
+    mDevice = &device;
+    mDesc = desc;
+    if (!device.Handle() || desc.width == 0 || desc.height == 0) {
+        device.ReportFailure("Texture::Create: no device or zero size", false);
+        return false;
+    }
+    if (!SDL_GPUTextureSupportsFormat(device.Handle(), desc.format, SDL_GPU_TEXTURETYPE_2D, desc.usage)) {
+        char ctx[160];
+        SDL_snprintf(ctx, sizeof ctx, "Texture::Create(%s): format %d does not support usage 0x%x on this device",
+                     desc.name ? desc.name : "unnamed", (int)desc.format, (unsigned)desc.usage);
+        device.ReportFailure(ctx, false);
+        return false;
+    }
+    SDL_GPUTextureCreateInfo info;
+    SDL_zero(info);
+    info.type = desc.layers > 1 ? SDL_GPU_TEXTURETYPE_2D_ARRAY : SDL_GPU_TEXTURETYPE_2D;
+    info.format = desc.format;
+    info.usage = desc.usage;
+    info.width = desc.width;
+    info.height = desc.height;
+    info.layer_count_or_depth = desc.layers ? desc.layers : 1;
+    info.num_levels = desc.levels ? desc.levels : 1;
+    info.sample_count = SDL_GPU_SAMPLECOUNT_1;
+    SDL_PropertiesID props = 0;
+    if (desc.name) {
+        props = SDL_CreateProperties();
+        SDL_SetStringProperty(props, SDL_PROP_GPU_TEXTURE_CREATE_NAME_STRING, desc.name);
+        info.props = props;
+    }
+    mTexture = SDL_CreateGPUTexture(device.Handle(), &info);
+    if (props) SDL_DestroyProperties(props);
+    if (!mTexture) {
+        char ctx[160];
+        SDL_snprintf(ctx, sizeof ctx, "SDL_CreateGPUTexture(%s %ux%u)", desc.name ? desc.name : "unnamed", desc.width, desc.height);
+        device.ReportFailure(ctx);
+        return false;
+    }
+    return true;
+}
+
+bool Texture::Resize(Uint32 width, Uint32 height) {
+    if (!mDevice) return false;
+    if (mTexture && mDesc.width == width && mDesc.height == height) return true;
+    TextureDesc d = mDesc;
+    d.width = width;
+    d.height = height;
+    Device *device = mDevice;
+    return Create(*device, d);
+}
+
+void Texture::Release() {
+    if (mTexture && mDevice && mDevice->Handle()) SDL_ReleaseGPUTexture(mDevice->Handle(), mTexture);
+    mTexture = nullptr;
+}
+
+bool RenderTarget::Create(Device &device, Uint32 width, Uint32 height, SDL_GPUTextureFormat colorFormat, bool withDepth,
+                          const char *name) {
+    Release();
+    if (!mColor.Create(device, TextureDesc::ColorTarget(width, height, colorFormat, name))) return false;
+    if (withDepth && !mDepth.Create(device, TextureDesc::DepthTarget(device, width, height, name))) {
+        mColor.Release();
+        return false;
+    }
+    return true;
+}
+
+bool RenderTarget::Resize(Uint32 width, Uint32 height) {
+    if (!mColor) return false;
+    if (mColor.Width() == width && mColor.Height() == height) return false;
+    mColor.Resize(width, height);
+    if (mDepth.Desc().width != 0) mDepth.Resize(width, height);
+    return true;
+}
+
+void RenderTarget::Release() {
+    mColor.Release();
+    mDepth.Release();
+}
+
+static SDL_GPUSamplerAddressMode ToAddress(Wrap w) {
+    switch (w) {
+    case Wrap::Repeat: return SDL_GPU_SAMPLERADDRESSMODE_REPEAT;
+    case Wrap::Mirror: return SDL_GPU_SAMPLERADDRESSMODE_MIRRORED_REPEAT;
+    default: return SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+    }
+}
+
+SamplerCache::~SamplerCache() { Clear(); }
+
+void SamplerCache::Clear() {
+    if (mDevice.Handle()) {
+        for (auto &kv : mSamplers) SDL_ReleaseGPUSampler(mDevice.Handle(), kv.second);
+    }
+    mSamplers.clear();
+}
+
+SDL_GPUSampler *SamplerCache::Get(const SamplerKey &key) {
+    auto it = mSamplers.find(key);
+    if (it != mSamplers.end()) return it->second;
+    SDL_GPUSamplerCreateInfo info;
+    SDL_zero(info);
+    info.min_filter = info.mag_filter = key.filter == Filter::Linear ? SDL_GPU_FILTER_LINEAR : SDL_GPU_FILTER_NEAREST;
+    info.mipmap_mode = SDL_GPU_SAMPLERMIPMAPMODE_NEAREST;
+    info.address_mode_u = ToAddress(key.wrapU);
+    info.address_mode_v = ToAddress(key.wrapV);
+    info.address_mode_w = SDL_GPU_SAMPLERADDRESSMODE_CLAMP_TO_EDGE;
+    info.min_lod = 0.0f;
+    info.max_lod = 1000.0f;
+    SDL_GPUSampler *s = SDL_CreateGPUSampler(mDevice.Handle(), &info);
+    if (!s) {
+        mDevice.ReportFailure("SDL_CreateGPUSampler");
+        return nullptr;
+    }
+    mSamplers.emplace(key, s);
+    return s;
+}
+
+} // namespace SIM::Gpu
diff --git a/libraries/sim/src/gpu/meson.build b/libraries/sim/src/gpu/meson.build
new file mode 100644
index 0000000..5ebb059
--- /dev/null
+++ b/libraries/sim/src/gpu/meson.build
@@ -0,0 +1,79 @@
+# SDL GPU foundation library (workstream 1c).
+#
+# This file only defines variables; it adds no sources to any target.
+# The integrator enables the library in libraries/sim/src/meson.build with
+# one line:
+#   libsim_srcs += gpu_srcs
+# (plus the SDL3 dependency on libsim_dependencies, and gpu_shader_headers
+# on any target that includes a generated shader header).
+#
+# Shader headers are generated by libraries/sim/tools/gpu_shaderc.py
+# (GLSL 450 -> SPIR-V -> MSL, embedded as C arrays). The custom targets are
+# build_by_default: false, so a plain libsim build does not need
+# glslangValidator / spirv-cross until something uses gpu_shader_headers.
+# Adding a shader is one line: append its filename to gpu_shaders below and
+# #include "<name>.vert.h" / "<name>.frag.h".
+
+gpu_srcs = files(
+    'gpu_device.cpp',
+    'gpu_frame.cpp',
+    'gpu_pipeline.cpp',
+    'gpu_readback.cpp',
+    'gpu_texture.cpp',
+)
+
+gpu_shaders = [
+    'test_color.vert',
+    'test_color.frag',
+    'test_depth.vert',
+    'test_green.frag',
+    'test_int.frag',
+    'test_int16.frag',
+    'test_invariant.vert',
+    'test_invariant2.vert',
+    'test_pos.vert',
+    'test_red.frag',
+    'test_ssbo.frag',
+    'test_ssbo16.frag',
+    'test_textured.vert',
+    'test_textured.frag',
+    'test_uniform.frag',
+    'post.vert',
+    'post.frag',
+    'g3.vert',
+    'g3.frag',
+    'quad.vert',
+    'textured.frag',
+    'vram.frag',
+    'g2.frag',
+    'g2clear.frag',
+    'g2gpu.vert',
+    'g2gpu.frag',
+]
+
+gpu_shader_headers = []
+_gpu_python = find_program('python3', required: false)
+_gpu_glslang = find_program('glslangValidator', required: false)
+_gpu_spirv_cross = find_program('spirv-cross', required: false)
+if _gpu_python.found() and _gpu_glslang.found() and _gpu_spirv_cross.found()
+    _gpu_shaderc = '..' / '..' / 'tools' / 'gpu_shaderc.py'
+    foreach _shader : gpu_shaders
+        gpu_shader_headers += custom_target(
+            _shader + '.h',
+            input: 'shaders' / _shader,
+            output: '@PLAINNAME@.h',
+            depfile: '@PLAINNAME@.d',
+            command: [
+                _gpu_python, _gpu_shaderc, '@INPUT@',
+                '-I', meson.current_source_dir() / 'shaders',
+                '--glslang', _gpu_glslang.full_path(),
+                '--spirv-cross', _gpu_spirv_cross.full_path(),
+                '-o', '@OUTPUT@',
+                '--depfile', '@DEPFILE@',
+            ],
+            build_by_default: false,
+        )
+    endforeach
+else
+    warning('gpu shaders: glslangValidator / spirv-cross / python3 missing, gpu_shader_headers is empty')
+endif
diff --git a/libraries/sim/src/gpu/shaders/g2.frag b/libraries/sim/src/gpu/shaders/g2.frag
new file mode 100644
index 0000000..5783203
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/g2.frag
@@ -0,0 +1,274 @@
+#version 450
+// 2D composite (port of shaders/g2_fragment.glsl). Samples the layer
+// images of one engine and applies layer priorities and order, the blend
+// registers, windows, the backdrop colour and master brightness.
+//
+// Layer-image convention in this backend: texture row 0 is the TOP line
+// of the top screen, so a GL texture coordinate t samples at v = 1 - t.
+// CPU-uploaded layers are flipped at upload time to match; the window,
+// backdrop and brightness logic below keeps the caller's GL coordinates.
+layout(set = 2, binding = 0) uniform sampler2D bgTex0;
+layout(set = 2, binding = 1) uniform sampler2D bgTex1;
+layout(set = 2, binding = 2) uniform sampler2D bgTex2;
+layout(set = 2, binding = 3) uniform sampler2D bgTex3;
+layout(set = 2, binding = 4) uniform sampler2D objTex0;
+layout(set = 2, binding = 5) uniform sampler2D objTex1;
+layout(set = 2, binding = 6) uniform sampler2D objTex2;
+layout(set = 2, binding = 7) uniform sampler2D objTex3;
+layout(set = 2, binding = 8) uniform sampler2D objWindowTex;
+layout(set = 3, binding = 0) uniform G2Params {
+  vec4 backdropColor;
+  ivec4 bgOrder;
+  ivec4 bgPriorities;
+  ivec4 bld;   // bldcnt, bldalpha, bldy, topScreen
+  ivec4 dsp;   // dispcnt, winin, winout, win0h
+  ivec4 win;   // win0v, win1h, win1v, bg0as3d
+  vec4 misc;   // upscaleW.xy, masterBrightFactor, unused
+  ivec4 miscI; // upscaleMode, masterBrightMode, unused, unused
+};
+layout(location = 0) in vec2 fragTexCoord;
+layout(location = 0) out vec4 color;
+
+vec4 sampleUpscaled(sampler2D tex, vec2 uv) {
+  int upscaleMode = miscI.x;
+  vec2 upscaleW = misc.xy;
+  if (upscaleMode != 1) return texture(tex, uv);
+  vec2 sz = vec2(256.0, 384.0); // all layer textures are native DS size
+  vec2 p = uv * sz;
+  vec2 c = floor(p - 0.5) + 0.5;
+  vec2 f = p - c;
+  vec2 off = clamp(f / max(upscaleW, vec2(0.0001)), vec2(-0.5), vec2(0.5));
+  return texture(tex, (c + off) / sz);
+}
+vec4 texBg(int n, vec2 uv) {
+  if (n == 0) return texture(bgTex0, uv);
+  if (n == 1) return texture(bgTex1, uv);
+  if (n == 2) return texture(bgTex2, uv);
+  return texture(bgTex3, uv);
+}
+vec4 upBg(int n, vec2 uv) {
+  if (n == 0) return sampleUpscaled(bgTex0, uv);
+  if (n == 1) return sampleUpscaled(bgTex1, uv);
+  if (n == 2) return sampleUpscaled(bgTex2, uv);
+  return sampleUpscaled(bgTex3, uv);
+}
+// The 3D target (BG0 as 3D) keeps GL's filtering: MIN LINEAR / MAG
+// NEAREST, no mipmaps, REPEAT wrap. A split min/mag sampler is not
+// robust: drivers disagree on the filter at a ~1:1 footprint, and Metal
+// takes the min filter there and blurs. So the target is bound with a
+// NEAREST sampler and the choice is made here from the texel footprint,
+// exactly as GL makes it from lambda: footprint > 1 texel -> bilinear,
+// else nearest.
+vec4 sampleG3(vec2 uv) {
+  vec2 sz = vec2(textureSize(bgTex0, 0));
+  vec2 dx = dFdx(uv) * sz;
+  vec2 dy = dFdy(uv) * sz;
+  float rho = max(length(dx), length(dy));
+  if (rho <= 1.0) return texture(bgTex0, uv);
+  vec2 p = uv * sz - 0.5;
+  vec2 base = floor(p);
+  vec2 f = p - base;
+  ivec2 i0 = ivec2(base);
+  ivec2 s = ivec2(sz);
+  vec4 c00 = texelFetch(bgTex0, (i0 + ivec2(0, 0) + s) % s, 0);
+  vec4 c10 = texelFetch(bgTex0, (i0 + ivec2(1, 0) + s) % s, 0);
+  vec4 c01 = texelFetch(bgTex0, (i0 + ivec2(0, 1) + s) % s, 0);
+  vec4 c11 = texelFetch(bgTex0, (i0 + ivec2(1, 1) + s) % s, 0);
+  return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
+}
+vec4 sampleBg(int n, vec2 uv) {
+  int upscaleMode = miscI.x;
+  int bg0as3d = win.w;
+  if (n == 0 && bg0as3d != 0) return sampleG3(uv); // 3D stays at its native internal resolution
+  if (upscaleMode == 0) return texBg(n, uv);
+  return upBg(n, uv);
+}
+vec4 texObj(int n, vec2 uv) {
+  if (n == 0) return texture(objTex0, uv);
+  if (n == 1) return texture(objTex1, uv);
+  if (n == 2) return texture(objTex2, uv);
+  return texture(objTex3, uv);
+}
+vec4 sampleObj(int n, vec2 uv) {
+  if (miscI.x == 0) return texObj(n, uv);
+  if (n == 0) return sampleUpscaled(objTex0, uv);
+  if (n == 1) return sampleUpscaled(objTex1, uv);
+  if (n == 2) return sampleUpscaled(objTex2, uv);
+  return sampleUpscaled(objTex3, uv);
+}
+// Composite one OBJ pixel over the accumulated colour (bottom-up order).
+// OBJ layer alpha encodes the pixel kind: 1 = opaque, 0.0314 = semi-
+// transparent (XLU) marker, anything else in (0.05, 1) = bitmap OBJ
+// per-sprite alpha, 0 = absent/blocking (already filtered by the caller).
+void drawObjPixel(vec4 obj, bool effectOn, vec2 uv, inout vec4 acc, inout int currentBgDrawn) {
+  int bldcnt = bld.x;
+  int bldalpha = bld.y;
+  float oa = obj.a;
+  if (oa <= 0.01) return;
+  if (oa >= 0.999) { acc = obj; currentBgDrawn = 4; return; }
+  vec3 below = (currentBgDrawn == 5) ? backdropColor.rgb : acc.rgb;
+  if (oa <= 0.05) {
+    // Semi-transparent (XLU): alpha-blend with the pixel below using
+    // BLDALPHA, if the below layer is a 2nd target and the window
+    // effect is on; otherwise opaque.
+    bool belowIsTarget2 = ((bldcnt >> (8 + currentBgDrawn)) & 1) == 1;
+    if (effectOn && belowIsTarget2) {
+      float eva = min(16.0, float(bldalpha & 31)) / 16.0;
+      float evb = min(16.0, float((bldalpha >> 8) & 31)) / 16.0;
+      acc.rgb = min(vec3(1.0), obj.rgb * eva + below * evb);
+      acc.a = 1.0;
+      currentBgDrawn = 4;
+      return;
+    }
+    acc = vec4(obj.rgb, 1.0); currentBgDrawn = 4; return;
+  }
+  // Bitmap OBJ per-sprite alpha: blend with the pixel below by alpha.
+  acc.rgb = obj.rgb * oa + below * (1.0 - oa);
+  acc.a = 1.0; currentBgDrawn = 4;
+}
+void main() {
+  int bldcnt = bld.x;
+  int bldalpha = bld.y;
+  int bldy = bld.z;
+  int topScreen = bld.w;
+  int dispcnt = dsp.x;
+  int winin = dsp.y;
+  int winout = dsp.z;
+  int win0h = dsp.w;
+  int win0v = win.x;
+  int win1h = win.y;
+  int win1v = win.z;
+  int bg0as3d = win.w;
+  float inMasterBrightFactor = misc.z;
+  int inMasterBrightMode = miscI.y;
+  vec2 uv = vec2(fragTexCoord.x, 1.0 - fragTexCoord.y);
+  int oamsDrawn = 0;
+  int currentBgDrawn = 5; // Backdrop
+  vec4 acc = vec4(0.0);
+  bool objWindowEnabled = ((dispcnt >> 15) & 1) == 1;
+  if (topScreen == 1) {
+    if (fragTexCoord.t < 0.5) discard;
+  } else {
+    if (fragTexCoord.t >= 0.5) discard;
+  }
+  // GBATEK window priority for this pixel: WIN0 > WIN1 > OBJ window >
+  // outside. Layer passes already applied WIN0/WIN1 to the BG textures,
+  // but the OBJ window and the outside mask were not applied there (they
+  // need the OBJ window texture), and OBJs / colour effects were not
+  // window-gated at all. Resolve the full mask here. With no window
+  // enabled the masks are irrelevant: everything shows.
+  int px = int(fragTexCoord.s * 256.0);
+  int py = topScreen == 1 ? int(383.5 - fragTexCoord.t * 384.0) : int(191.5 - fragTexCoord.t * 384.0);
+  bool inWin0 = ((dispcnt >> 13) & 1) == 1
+      && px >= ((win0h >> 8) & 255) && px < (win0h & 255)
+      && py >= ((win0v >> 8) & 255) && py < (win0v & 255);
+  bool inWin1 = ((dispcnt >> 14) & 1) == 1
+      && px >= ((win1h >> 8) & 255) && px < (win1h & 255)
+      && py >= ((win1v >> 8) & 255) && py < (win1v & 255);
+  bool inObjWin = objWindowEnabled && texture(objWindowTex, uv).a > 0.1;
+  int winMask;   // BG + colour-effect enables for this pixel
+  int objWinMask; // OBJ enable for this pixel (the OBJ window never gates OBJs)
+  if (((dispcnt >> 13) & 7) == 0) { winMask = 63; objWinMask = 63; }
+  else if (inWin0) { winMask = winin & 63; objWinMask = winin & 63; }
+  else if (inWin1) { winMask = (winin >> 8) & 63; objWinMask = (winin >> 8) & 63; }
+  else if (inObjWin) { winMask = (winout >> 8) & 63; objWinMask = winout & 63; }
+  else { winMask = winout & 63; objWinMask = winout & 63; }
+  bool effectOn = ((winMask >> 5) & 1) == 1;
+  for (int i = 0; i < 4; i++) {
+    int bgNum = bgOrder[i];
+    int curPrio = bgPriorities[bgNum];
+    // Draw the OBJs that are at or below the current BG priority
+    for (int j = 3 - oamsDrawn; j > curPrio; j--) {
+      if (((objWinMask >> 4) & 1) == 1) {
+        drawObjPixel(sampleObj(j, uv), effectOn, uv, acc, currentBgDrawn);
+      }
+      oamsDrawn++;
+    }
+    // Window: BG visibility for this pixel (layer passes handled
+    // WIN0/WIN1; the OBJ-window / outside choice is made here).
+    if (((winMask >> bgNum) & 1) == 0) continue;
+    // Draw the current bg
+    vec4 bg3d = sampleBg(0, uv);
+    if (effectOn && bgNum == 0 && bg0as3d != 0 && bg3d.a > 0.004 && bg3d.a < 0.99 && (((bldcnt >> (8 + currentBgDrawn)) & 1) == 1)) {
+      // DS special case: translucent 3D pixels are alpha blended with the layer below whenever that layer is a 2nd
+      // target, whatever the blend mode and 1st targets are (particles, glows). The 3D buffer holds colour already
+      // weighted by its alpha (it is drawn over a transparent clear with SRC_ALPHA blending).
+      vec3 below = (currentBgDrawn == 5) ? backdropColor.rgb : acc.rgb;
+      acc.rgb = min(vec3(1.0), bg3d.rgb + below * (1.0 - bg3d.a));
+      acc.a = 1.0;
+      currentBgDrawn = bgNum;
+    } else if (sampleBg(bgNum, uv).a > 0.1) {
+      // Handle blending
+      if (effectOn && ((bldcnt >> 6) & 0x3) == 1 && ((bldcnt >> bgNum) & 1) == 1) {
+        // Alpha Blending Mode. bgNum is Target 1.
+        float alphaA = min(16.0, float(bldalpha & 31)) / 16.0;
+        float alphaB = min(16.0, float((bldalpha >> 8) & 31)) / 16.0;
+        if (bgNum == 0 && bg0as3d != 0) {
+          alphaA = sampleBg(0, uv).a;
+          alphaB = 1.0 - alphaA;
+        }
+        if ((currentBgDrawn < 4) && (((bldcnt >> (8 + currentBgDrawn)) & 1) == 1)) {
+          acc.r = min(1.0, ((sampleBg(bgNum, uv).r * alphaA) + (sampleBg(currentBgDrawn, uv).r * alphaB)));
+          acc.g = min(1.0, ((sampleBg(bgNum, uv).g * alphaA) + (sampleBg(currentBgDrawn, uv).g * alphaB)));
+          acc.b = min(1.0, ((sampleBg(bgNum, uv).b * alphaA) + (sampleBg(currentBgDrawn, uv).b * alphaB)));
+          acc.a = 1.0;
+          currentBgDrawn = bgNum;
+        } else if ((currentBgDrawn == 4) && (((bldcnt >> (8 + currentBgDrawn)) & 1) == 1)) {
+          // Alpha blending where the highest OBJ pixel is the target
+          acc.r = min(1.0, ((sampleBg(bgNum, uv).r * alphaA) + acc.r * alphaB));
+          acc.g = min(1.0, ((sampleBg(bgNum, uv).g * alphaA) + acc.g * alphaB));
+          acc.b = min(1.0, ((sampleBg(bgNum, uv).b * alphaA) + acc.b * alphaB));
+          acc.a = 1.0;
+        } else if ((currentBgDrawn == 5) && (((bldcnt >> (8 + currentBgDrawn)) & 1) == 1)) {
+          // Alpha blending where the backdrop is the target
+          acc.r = min(1.0, ((sampleBg(bgNum, uv).r * alphaA) + backdropColor.r * alphaB));
+          acc.g = min(1.0, ((sampleBg(bgNum, uv).g * alphaA) + backdropColor.g * alphaB));
+          acc.b = min(1.0, ((sampleBg(bgNum, uv).b * alphaA) + backdropColor.b * alphaB));
+          acc.a = 1.0;
+        } else {
+          acc = sampleBg(bgNum, uv);
+          currentBgDrawn = bgNum;
+        }
+      } else if (effectOn && ((bldcnt >> 6) & 0x3) == 2 && ((bldcnt >> bgNum) & 1) == 1) {
+        // Brightness Increase Mode. bgNum is Target 1.
+        float brightFactor = min(16.0, float(bldy & 31)) / 16.0;
+        acc.r = sampleBg(bgNum, uv).r + (1.0 - sampleBg(bgNum, uv).r) * brightFactor;
+        acc.g = sampleBg(bgNum, uv).g + (1.0 - sampleBg(bgNum, uv).g) * brightFactor;
+        acc.b = sampleBg(bgNum, uv).b + (1.0 - sampleBg(bgNum, uv).b) * brightFactor;
+        acc.a = 1.0;
+        currentBgDrawn = bgNum;
+      } else if (effectOn && ((bldcnt >> 6) & 0x3) == 3 && ((bldcnt >> bgNum) & 1) == 1) {
+        // Brightness Decrease Mode. bgNum is Target 1.
+        float brightFactor = min(16.0, float(bldy & 31)) / 16.0;
+        acc.r = max(0.0, (sampleBg(bgNum, uv).r - ((sampleBg(bgNum, uv).r) * brightFactor)));
+        acc.g = max(0.0, (sampleBg(bgNum, uv).g - ((sampleBg(bgNum, uv).g) * brightFactor)));
+        acc.b = max(0.0, (sampleBg(bgNum, uv).b - ((sampleBg(bgNum, uv).b) * brightFactor)));
+        acc.a = 1.0;
+        currentBgDrawn = bgNum;
+      } else {
+        acc.rgb = sampleBg(bgNum, uv).rgb;
+        acc.a = 1.0;
+        currentBgDrawn = bgNum;
+      }
+    }
+  }
+  // Draw the remaining objs
+  for (int i = 3 - oamsDrawn; i >= 0; i--) {
+    if (((objWinMask >> 4) & 1) == 1) {
+      drawObjPixel(sampleObj(i, uv), effectOn, uv, acc, currentBgDrawn);
+    }
+  }
+  if (currentBgDrawn == 5) acc = backdropColor;
+  if (inMasterBrightMode == 1) {
+    // brightness up
+    acc.r = acc.r + ((1.0 - acc.r) * (inMasterBrightFactor / 16.0));
+    acc.g = acc.g + ((1.0 - acc.g) * (inMasterBrightFactor / 16.0));
+    acc.b = acc.b + ((1.0 - acc.b) * (inMasterBrightFactor / 16.0));
+  } else if (inMasterBrightMode == 2) {
+    // brightness down
+    acc.r = acc.r - (acc.r * (inMasterBrightFactor / 16.0));
+    acc.g = acc.g - (acc.g * (inMasterBrightFactor / 16.0));
+    acc.b = acc.b - (acc.b * (inMasterBrightFactor / 16.0));
+  }
+  color = acc;
+}
diff --git a/libraries/sim/src/gpu/shaders/g2clear.frag b/libraries/sim/src/gpu/shaders/g2clear.frag
