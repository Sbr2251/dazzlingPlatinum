+
+// Dedicated 3D texture VRAM (512 KB, full 16-bit GX_TEXIMAGE_PARAM << 3 range)
+// and 3D texture palette VRAM (96 KB, full DS palette VRAM ceiling), decoupled
+// from the shared 656 KB s_HW_LCDC_VRAM bank array so BG/OBJ/capture banks
+// never collide with 3D textures or palettes.
+#define SIM_TEX_VRAM_SIZE 0x80000u
+#define SIM_TEX_PLTT_SIZE 0x18000u
+
+extern uint8_t s_SIM_TEX_VRAM[SIM_TEX_VRAM_SIZE];
+extern uint8_t s_SIM_TEX_PLTT[SIM_TEX_PLTT_SIZE];
+
+// Called (SDK_PORT only) after any DMA/CpuCopy/fill that may have written
+// texture or palette VRAM. The implementation ignores writes outside
+// s_SIM_TEX_VRAM / s_SIM_TEX_PLTT, so callers may pass any destination.
+void SIM_G3_NotifyTexVramWrite(const void * dest, size_t size);
+
