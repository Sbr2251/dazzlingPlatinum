diff --git a/libraries/sim/src/sim_g2_gpu.cpp b/libraries/sim/src/sim_g2_gpu.cpp
new file mode 100644
index 0000000..b621b4f
--- /dev/null
+++ b/libraries/sim/src/sim_g2_gpu.cpp
@@ -0,0 +1,308 @@
+// GPU 2D layer renderer (perf-g2gpu).
+//
+// Renders each BG layer, each OBJ priority layer and the OBJ window mask
+// directly from VRAM / palette / OAM data textures into the layer textures
+// the existing g2_fragment.glsl compositing already samples. The CPU path
+// in sim_g2.cpp stays as the reference and fallback (SIM_G2_GPU=0).
+//
+// Replicated CPU quirks (for pixel-exactness against the reference):
+// mosaic has no effect, text BG windows consult only WIN0, affine/extended
+// BGs ignore windows, OBJ extended palettes are ignored, bitmap OBJ pixels
+// are palette-looked-up by low byte, OBJ translucency is dropped.
+// Fallbacks (whole engine, logged once): extended direct-color bitmap
+// (CPU reads through an uninitialized palette pointer), BG mode 6.
+//
+// Shader inputs are plain data textures (R8UI/R16UI) and int uniforms so a
+// Metal port is mechanical. GL 4.1 core only.
+#include <nitro.h>
+#include <simulator/sim.h>
+#include <simulator/sim_opengl.h>
+#include <simulator/simvariables.h>
+#include <nitro/gx/gx_vramcnt.h>
+#include <stdio.h>
+#include <string.h>
+#include "sim_g2_gpu.h"
+
+extern u8 s_SIM_DBG_BGenable[4];
+extern u8 s_SIM_DBG_OAMenable;
+extern u8 s_SIM_DBG_BGSenable[4];
+extern u8 s_SIM_DBG_OAMSenable;
+extern GXVRamBGExtPltt s_SIM_GXBgExtPltt;
+extern GXVRamSubBGExtPltt s_SIM_GXSubBgExtPltt;
+
+static const char *kVertSrc =
+#include "shaders/g2gpu_vertex.glsl"
+;
+static const char *kFragSrc =
+#include "shaders/g2gpu_fragment.glsl"
+;
+
+static GLuint sProg = 0, sFbo = 0, sVao = 0;
+static GLuint sBgVramTex[2] = {0, 0}, sObjVramTex[2] = {0, 0}, sLcdcTex = 0, sOamTex = 0, sPalTex = 0;
+static int sInitFailed = 0;
+static int sLoggedFallback = 0;
+
+static GLuint Compile(GLenum type, const char *src) {
+  // macOS: rewrite the leading "#version 420" to "#version 410" (GL 4.1).
+  char *tmp = nullptr;
+  const char *use = src;
+#ifdef SDK_BUILD_MACOS
+  if (strncmp(src, "\n#version 420", 13) == 0 || strncmp(src, "#version 420", 12) == 0) {
+    tmp = strdup(src);
+    char *p = strstr(tmp, "#version 420");
+    if (p) memcpy(p, "#version 410", 12);
+    use = tmp;
+  }
+#endif
+  GLuint s = glCreateShader(type);
+  glShaderSource(s, 1, &use, nullptr);
+  glCompileShader(s);
+  GLint ok = 0;
+  glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+  if (!ok) {
+    GLint len = 0;
+    glGetShaderiv(s, GL_INFO_LOG_LENGTH, &len);
+    char *log = new char[len + 1]();
+    glGetShaderInfoLog(s, len, nullptr, log);
+    printf("SIM_G2_GPU: shader compile failed: %s\n", log);
+    delete[] log;
+  }
+  if (tmp) free(tmp);
+  return ok ? s : 0;
+}
+
+static bool Init() {
+  if (sProg || sInitFailed) return sProg != 0;
+  GLuint vs = Compile(GL_VERTEX_SHADER, kVertSrc);
+  GLuint fs = Compile(GL_FRAGMENT_SHADER, kFragSrc);
+  if (!vs || !fs) { sInitFailed = 1; return false; }
+  sProg = glCreateProgram();
+  glAttachShader(sProg, vs);
+  glAttachShader(sProg, fs);
+  glLinkProgram(sProg);
+  GLint ok = 0;
+  glGetProgramiv(sProg, GL_LINK_STATUS, &ok);
+  if (!ok) {
+    GLint len = 0;
+    glGetProgramiv(sProg, GL_INFO_LOG_LENGTH, &len);
+    char *log = new char[len + 1]();
+    glGetProgramInfoLog(sProg, len, nullptr, log);
+    printf("SIM_G2_GPU: link failed: %s\n", log);
+    delete[] log;
+    sInitFailed = 1;
+    return false;
+  }
+  glGenFramebuffers(1, &sFbo);
+  glGenVertexArrays(1, &sVao);
+  auto mkTex = [](GLuint &t, GLenum internal, int w, int h, GLenum fmt) {
+    glGenTextures(1, &t);
+    glBindTexture(GL_TEXTURE_2D, t);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, internal, w, h, 0, fmt, GL_UNSIGNED_BYTE, nullptr);
+  };
+  mkTex(sBgVramTex[0], GL_R8UI, 2048, 256, GL_RED_INTEGER);
+  mkTex(sBgVramTex[1], GL_R8UI, 2048, 256, GL_RED_INTEGER);
+  mkTex(sObjVramTex[0], GL_R8UI, 1024, 256, GL_RED_INTEGER);
+  mkTex(sObjVramTex[1], GL_R8UI, 1024, 256, GL_RED_INTEGER);
+  mkTex(sLcdcTex, GL_R8UI, 2048, 328, GL_RED_INTEGER);
+  glGenTextures(1, &sOamTex);
+  glBindTexture(GL_TEXTURE_2D, sOamTex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_R16UI, 512, 2, 0, GL_RED_INTEGER, GL_UNSIGNED_SHORT, nullptr);
+  glGenTextures(1, &sPalTex);
+  glBindTexture(GL_TEXTURE_2D, sPalTex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_R16UI, 256, 4, 0, GL_RED_INTEGER, GL_UNSIGNED_SHORT, nullptr);
+  glUseProgram(sProg);
+  glUniform1i(glGetUniformLocation(sProg, "bgVramTex"), 10);
+  glUniform1i(glGetUniformLocation(sProg, "objVramTex"), 11);
+  glUniform1i(glGetUniformLocation(sProg, "lcdcTex"), 12);
+  glUniform1i(glGetUniformLocation(sProg, "oamTex"), 13);
+  glUniform1i(glGetUniformLocation(sProg, "palTex"), 14);
+  printf("SIM_G2_GPU: GPU 2D layer renderer enabled\n");
+  return true;
+}
+
+static bool EngineFallback(int isSub, int bgMode, const u16 cnt[4], const u8 enabled[4], int bg0as3d) {
+  for (int i = 0; i < 4; i++) {
+    if (!enabled[i]) continue;
+    if (i == 0 && bg0as3d && !isSub) continue;
+    // Mode 6 large BG on BG2 (main): CPU uploads a stale buffer.
+    if (i == 2 && bgMode == 6 && !isSub) return true;
+    bool extended = (i == 2 && bgMode == 5) || (i == 3 && bgMode >= 3 && bgMode <= 5);
+    // Extended direct-color bitmap: CPU dereferences an uninitialized palette pointer.
+    if (extended && (cnt[i] & 0x84) == 0x84) return true;
+  }
+  return false;
+}
+
+BOOL G2GPU_RenderLayers(BOOL isSub, GLuint *bgTexIds, GLuint *objTexIds, GLuint objWindowTexId) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char *e = getenv("SIM_G2_GPU");
+    enabled = (!e || atoi(e)) ? 1 : 0; // GPU is the default; SIM_G2_GPU=0 forces the CPU path
+  }
+  if (!enabled) return FALSE;
+  if (!Init()) return FALSE;
+
+  u32 dispcnt = isSub ? s_reg_GXS_DB_DISPCNT : s_reg_GX_DISPCNT;
+  int bgMode = dispcnt & 7;
+  int bg0as3d = (dispcnt >> 3) & 1;
+  u16 cnt[4] = {isSub ? s_reg_G2S_DB_BG0CNT : s_reg_G2_BG0CNT, isSub ? s_reg_G2S_DB_BG1CNT : s_reg_G2_BG1CNT,
+                isSub ? s_reg_G2S_DB_BG2CNT : s_reg_G2_BG2CNT, isSub ? s_reg_G2S_DB_BG3CNT : s_reg_G2_BG3CNT};
+  u8 bgEnabled[4] = {(u8)((dispcnt >> 8) & 1), (u8)((dispcnt >> 9) & 1), (u8)((dispcnt >> 10) & 1), (u8)((dispcnt >> 11) & 1)};
+  if (EngineFallback(isSub, bgMode, cnt, bgEnabled, bg0as3d)) {
+    if (!sLoggedFallback) { sLoggedFallback = 1; printf("SIM_G2_GPU: unsupported feature this engine, CPU fallback\n"); }
+    return FALSE;
+  }
+
+  // Save texture bindings on the data units (10-14) and the active unit:
+  // the 3D renderer's state cache tracks bindings, so leave them as found.
+  GLint prevActiveTex = 0;
+  glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActiveTex);
+  GLuint savedBind[5] = {0, 0, 0, 0, 0};
+  for (int i = 0; i < 5; i++) {
+    glActiveTexture(GL_TEXTURE10 + i);
+    GLint b = 0;
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &b);
+    savedBind[i] = (GLuint)b;
+  }
+
+  // Upload data textures for this engine. A shadow copy is kept per
+  // buffer and the upload is skipped when nothing changed (most screens
+  // reuse VRAM for many frames); the LCDC extended palettes are only
+  // uploaded when this engine has extended palettes enabled.
+  static u8 sShadowBg[2][0x80000], sShadowObj[2][0x40000], sShadowLcdc[0xA4000];
+  static bool sShadowBgValid[2] = {false, false}, sShadowObjValid[2] = {false, false}, sShadowLcdcValid = false;
+  auto uploadIfChanged = [](GLuint tex, int unit, int w, int h, const void *data, size_t size, u8 *shadow, bool *valid) {
+    glActiveTexture(GL_TEXTURE0 + unit);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    if (*valid && memcmp(shadow, data, size) == 0) return;
+    memcpy(shadow, data, size);
+    *valid = true;
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h, GL_RED_INTEGER, GL_UNSIGNED_BYTE, data);
+  };
+  uploadIfChanged(sBgVramTex[isSub], 10, 2048, isSub ? 64 : 256, isSub ? (void *)s_HW_DB_BG_VRAM : (void *)s_HW_BG_VRAM,
+                  isSub ? 0x20000 : 0x80000, sShadowBg[isSub], &sShadowBgValid[isSub]);
+  uploadIfChanged(sObjVramTex[isSub], 11, 1024, isSub ? 128 : 256, isSub ? (void *)s_HW_DB_OBJ_VRAM : (void *)s_HW_OBJ_VRAM,
+                  isSub ? 0x20000 : 0x40000, sShadowObj[isSub], &sShadowObjValid[isSub]);
+  if (dispcnt & 0x40000000)
+    uploadIfChanged(sLcdcTex, 12, 2048, 328, (void *)s_HW_LCDC_VRAM, 0xA4000, sShadowLcdc, &sShadowLcdcValid);
+  glActiveTexture(GL_TEXTURE13);
+  glBindTexture(GL_TEXTURE_2D, sOamTex);
+  glTexSubImage2D(GL_TEXTURE_2D, 0, 0, isSub ? 1 : 0, 512, 1, GL_RED_INTEGER, GL_UNSIGNED_SHORT,
+                  isSub ? (void *)s_HW_DB_OAM : (void *)s_HW_OAM);
+  glActiveTexture(GL_TEXTURE14);
+  glBindTexture(GL_TEXTURE_2D, sPalTex);
+  const u16 *pals[4] = {(u16 *)s_HW_BG_PLTT, (u16 *)s_HW_OBJ_PLTT, (u16 *)s_HW_DB_BG_PLTT, (u16 *)s_HW_DB_OBJ_PLTT};
+  for (int r = 0; r < 4; r++)
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, r, 256, 1, GL_RED_INTEGER, GL_UNSIGNED_SHORT, (void *)pals[r]);
+
+  int extBase;
+  if (isSub) extBase = 0x98000; // LCDC bank H
+  else if (s_SIM_GXBgExtPltt == GX_VRAM_BGEXTPLTT_23_G) extBase = 0x94000;
+  else if (s_SIM_GXBgExtPltt == GX_VRAM_BGEXTPLTT_01_F || s_SIM_GXBgExtPltt == GX_VRAM_BGEXTPLTT_0123_FG) extBase = 0x90000;
+  else extBase = 0x80000; // E (also NONE: matches the CPU helper)
+
+  u32 ofs[4], aX[4] = {0}, aY[4] = {0};
+  s16 pA[4] = {0}, pB[4] = {0}, pC[4] = {0}, pD[4] = {0};
+  if (isSub) {
+    ofs[0] = s_reg_G2S_DB_BG0OFS; ofs[1] = s_reg_G2S_DB_BG1OFS; ofs[2] = s_reg_G2S_DB_BG2OFS; ofs[3] = s_reg_G2S_DB_BG3OFS;
+    pA[2] = (s16)s_reg_G2S_DB_BG2PA; pB[2] = (s16)s_reg_G2S_DB_BG2PB; pC[2] = (s16)s_reg_G2S_DB_BG2PC; pD[2] = (s16)s_reg_G2S_DB_BG2PD;
+    pA[3] = (s16)s_reg_G2S_DB_BG3PA; pB[3] = (s16)s_reg_G2S_DB_BG3PB; pC[3] = (s16)s_reg_G2S_DB_BG3PC; pD[3] = (s16)s_reg_G2S_DB_BG3PD;
+    aX[2] = s_reg_G2S_DB_BG2X; aY[2] = s_reg_G2S_DB_BG2Y; aX[3] = s_reg_G2S_DB_BG3X; aY[3] = s_reg_G2S_DB_BG3Y;
+  } else {
+    ofs[0] = s_reg_G2_BG0OFS; ofs[1] = s_reg_G2_BG1OFS; ofs[2] = s_reg_G2_BG2OFS; ofs[3] = s_reg_G2_BG3OFS;
+    pA[2] = (s16)s_reg_G2_BG2PA; pB[2] = (s16)s_reg_G2_BG2PB; pC[2] = (s16)s_reg_G2_BG2PC; pD[2] = (s16)s_reg_G2_BG2PD;
+    pA[3] = (s16)s_reg_G2_BG3PA; pB[3] = (s16)s_reg_G2_BG3PB; pC[3] = (s16)s_reg_G2_BG3PC; pD[3] = (s16)s_reg_G2_BG3PD;
+    aX[2] = s_reg_G2_BG2X; aY[2] = s_reg_G2_BG2Y; aX[3] = s_reg_G2_BG3X; aY[3] = s_reg_G2_BG3Y;
+  }
+  int topScreen = (s_reg_GX_POWCNT >> 15) ? !isSub : isSub;
+
+  GLint prevProg = 0;
+  glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+  GLint prevViewport[4] = {0};
+  glGetIntegerv(GL_VIEWPORT, prevViewport);
+  glUseProgram(sProg);
+  glBindVertexArray(sVao);
+  glBindFramebuffer(GL_FRAMEBUFFER, sFbo);
+  glViewport(0, 0, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT * 2);
+  glDisable(GL_BLEND);
+  glDisable(GL_DEPTH_TEST);
+  glUniform1i(glGetUniformLocation(sProg, "isSub"), isSub);
+  glUniform1i(glGetUniformLocation(sProg, "topScreen"), topScreen);
+  glUniform1i(glGetUniformLocation(sProg, "dispcnt"), (int)dispcnt);
+  glUniform1i(glGetUniformLocation(sProg, "bgMode"), bgMode);
+  glUniform1i(glGetUniformLocation(sProg, "extPlttBase"), extBase);
+  GLint cntI[4] = {cnt[0], cnt[1], cnt[2], cnt[3]};
+  glUniform1iv(glGetUniformLocation(sProg, "bgcnt"), 4, cntI);
+  GLint ofsI[4] = {(GLint)ofs[0], (GLint)ofs[1], (GLint)ofs[2], (GLint)ofs[3]};
+  glUniform1iv(glGetUniformLocation(sProg, "bgofs"), 4, ofsI);
+  GLint vA[4] = {0, 0, pA[2], pA[3]}, vB[4] = {0, 0, pB[2], pB[3]}, vC[4] = {0, 0, pC[2], pC[3]}, vD[4] = {0, 0, pD[2], pD[3]};
+  glUniform1iv(glGetUniformLocation(sProg, "affA"), 4, vA);
+  glUniform1iv(glGetUniformLocation(sProg, "affB"), 4, vB);
+  glUniform1iv(glGetUniformLocation(sProg, "affC"), 4, vC);
+  glUniform1iv(glGetUniformLocation(sProg, "affD"), 4, vD);
+  GLint vX[4] = {0, 0, (GLint)aX[2], (GLint)aX[3]}, vY[4] = {0, 0, (GLint)aY[2], (GLint)aY[3]};
+  glUniform1iv(glGetUniformLocation(sProg, "affX"), 4, vX);
+  glUniform1iv(glGetUniformLocation(sProg, "affY"), 4, vY);
+  glUniform1i(glGetUniformLocation(sProg, "win0h"), isSub ? s_reg_G2S_DB_WIN0H : s_reg_G2_WIN0H);
+  glUniform1i(glGetUniformLocation(sProg, "win0v"), isSub ? s_reg_G2S_DB_WIN0V : s_reg_G2_WIN0V);
+  glUniform1i(glGetUniformLocation(sProg, "winin"), isSub ? s_reg_G2S_DB_WININ : s_reg_G2_WININ);
+  glUniform1i(glGetUniformLocation(sProg, "winout"), isSub ? s_reg_G2S_DB_WINOUT : s_reg_G2_WINOUT);
+
+  int halfY = topScreen ? SIM_NDS_SCREEN_HEIGHT : 0;
+  auto drawPass = [&](GLuint target, int mode, int layer, int dbg) {
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, target, 0);
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(0, halfY, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT);
