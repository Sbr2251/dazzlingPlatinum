+static u32 SIM_DebugKeyMask(const char *s, u32 *xy) {
+  static const struct { const char *n; u32 bit; int isXY; } names[] = {
+    {"A", 1u << 0, 0}, {"B", 1u << 1, 0}, {"SELECT", 1u << 2, 0}, {"START", 1u << 3, 0}, {"RIGHT", 1u << 4, 0}, {"LEFT", 1u << 5, 0},
+    {"UP", 1u << 6, 0}, {"DOWN", 1u << 7, 0}, {"R", 1u << 8, 0}, {"L", 1u << 9, 0}, {"X", 1u << 10, 1}, {"Y", 1u << 11, 1}};
+  u32 m = 0; *xy = 0;
+  std::string str(s);
+  size_t start = 0;
+  while (start <= str.size()) {
+    size_t end = str.find('+', start); if (end == std::string::npos) end = str.size();
+    std::string k = str.substr(start, end - start);
+    for (auto &n : names) if (k == n.n) { if (n.isXY) *xy |= n.bit; else m |= n.bit; }
+    start = end + 1;
+  }
+  return m;
+}
