+static int sStickDirX = 0, sStickDirY = 0;
+static void HandleGamepadAxis(SDL_GamepadAxis axis, Sint16 value) {
+  using namespace SIM::Touchpad;
+  int dz = s_SIM_config.padSettings.joyAxisDeadzone;
+  if (axis == SDL_GAMEPAD_AXIS_LEFTX || axis == SDL_GAMEPAD_AXIS_LEFTY) {
+    int ndx = value > dz ? 1 : value < -dz ? -1 : 0;
+    if (axis == SDL_GAMEPAD_AXIS_LEFTX && ndx != sStickDirX) {
+      if (sStickDirX < 0) SetDSButton(kLeft, false); if (sStickDirX > 0) SetDSButton(kRight, false);
+      if (ndx < 0) SetDSButton(kLeft, true); if (ndx > 0) SetDSButton(kRight, true);
+      sStickDirX = ndx;
+    }
+    if (axis == SDL_GAMEPAD_AXIS_LEFTY && ndx != sStickDirY) {
+      if (sStickDirY < 0) SetDSButton(kUp, false); if (sStickDirY > 0) SetDSButton(kDown, false);
+      if (ndx < 0) SetDSButton(kUp, true); if (ndx > 0) SetDSButton(kDown, true);
+      sStickDirY = ndx;
+    }
+  } else if (axis == SDL_GAMEPAD_AXIS_LEFT_TRIGGER || axis == SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) {
+    SetDSButton(axis == SDL_GAMEPAD_AXIS_LEFT_TRIGGER ? kL : kR, value > 16000);
