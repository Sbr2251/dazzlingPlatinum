+// GPU 2D layer renderer (perf-g2gpu), backend-neutral half.
+//
+// Fills G2GpuData from the DS registers and hands it to the backend,
+// which renders BG 0-3, OBJ priority 0-3 and the OBJ window mask from
+// VRAM/OAM/palette data into the layer images, before the composite.
+// The CPU path in sim_g2.cpp stays as the reference and fallback
+// (SIM_G2_GPU=0). The GL implementation of the passes lives in
+// render_gl/render_gl_g2gpu.cpp; the SDL GPU backend packs the same
+// data into storage buffers (see sim_render_backend.hpp).
+//
+// Both paths implement the same GBATEK behaviour: BG + OBJ mosaic,
+// WIN0/WIN1 windows on all BG kinds (the composite resolves the full
+// WIN0 > WIN1 > OBJ window > outside priority), 256-colour OBJ extended
+// palettes (DISPCNT bit 31), bitmap OBJ direct colour + per-sprite alpha,
+// and semi-transparent (XLU) OBJ blending via BLDALPHA in the composite.
+// Fallbacks (whole engine, logged once): extended direct-color bitmap
+// (the CPU reads the RGB555 pixel directly), BG mode 6.
+#include <nitro.h>
+#include <simulator/sim.h>
+#include <simulator/sim_render_backend.hpp>
+#include <simulator/simvariables.h>
+#include <nitro/gx/gx_vramcnt.h>
+#include <stdio.h>
+#include <string.h>
+#include "sim_g2_gpu.h"
+
+extern u8 s_SIM_DBG_BGenable[4];
+extern u8 s_SIM_DBG_OAMenable;
+extern u8 s_SIM_DBG_BGSenable[4];
+extern u8 s_SIM_DBG_OAMSenable;
+extern GXVRamBGExtPltt s_SIM_GXBgExtPltt;
+extern GXVRamSubBGExtPltt s_SIM_GXSubBgExtPltt;
+extern GXVRamOBJExtPltt s_SIM_GXOBJExtPltt;
+extern GXVRamSubOBJExtPltt s_SIM_GXSubOBJExtPltt;
+
+static int sLoggedFallback = 0;
+
+static bool EngineFallback(int bgMode, const u16 cnt[4], const u8 enabled[4],
+                           int bg0as3d) {
+  for (int i = 0; i < 4; i++) {
+    if (!enabled[i]) continue;
+    if (i == 0 && bg0as3d) continue;
+    // Mode 6 large BG on BG2 (main): CPU uploads a stale buffer.
+    if (i == 2 && bgMode == 6) return true;
+    bool extended = (i == 2 && bgMode == 5) || (i == 3 && bgMode >= 3 && bgMode <= 5);
+    // Extended direct-color bitmap: CPU dereferences an uninitialized palette pointer.
+    if (extended && (cnt[i] & 0x84) == 0x84) return true;
+  }
+  return false;
+}
+
+BOOL G2GPU_RenderLayers(BOOL isSub) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char *e = getenv("SIM_G2_GPU");
+    enabled = (!e || atoi(e)) ? 1 : 0; // GPU is the default; SIM_G2_GPU=0 forces the CPU path
+  }
+  if (!enabled) return FALSE;
+
+  u32 dispcnt = isSub ? s_reg_GXS_DB_DISPCNT : s_reg_GX_DISPCNT;
+  int bgMode = dispcnt & 7;
+  int bg0as3d = (dispcnt >> 3) & 1;
+  u16 cnt[4] = {isSub ? s_reg_G2S_DB_BG0CNT : s_reg_G2_BG0CNT,
+                isSub ? s_reg_G2S_DB_BG1CNT : s_reg_G2_BG1CNT,
+                isSub ? s_reg_G2S_DB_BG2CNT : s_reg_G2_BG2CNT,
+                isSub ? s_reg_G2S_DB_BG3CNT : s_reg_G2_BG3CNT};
+  u8 bgEnabled[4] = {(u8)((dispcnt >> 8) & 1), (u8)((dispcnt >> 9) & 1),
+                     (u8)((dispcnt >> 10) & 1), (u8)((dispcnt >> 11) & 1)};
+  if (EngineFallback(bgMode, cnt, bgEnabled, bg0as3d)) {
+    if (!sLoggedFallback) {
+      sLoggedFallback = 1;
+      printf("SIM_G2_GPU: unsupported feature this engine, CPU fallback\n");
+    }
+    return FALSE;
+  }
+
+  SIM::Render::G2GpuData data{};
+  data.isSub = isSub;
+  data.topScreen = (s_reg_GX_POWCNT >> 15) ? !isSub : isSub;
+  data.dispcnt = (s32)dispcnt;
