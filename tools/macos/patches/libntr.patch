+void DrawBallIcon(const HudExtDraw &ext, const SIM_HudHD_OverlayMon &mon, float cx, float cy, float r) {
+  if (ext.useBdspUi && ext.atlas) {
+    const HudUiSprite *sp = ext.atlas->ballHdOk ? ext.atlas->ballHdOk : ext.atlas->ballOk;
+    if (mon.isFainted) {
+      sp = ext.atlas->ballFainted ? ext.atlas->ballFainted : sp;
+    } else if (mon.status != SIM_HUDHD_STATUS_NONE) {
+      sp = ext.atlas->ballStatus ? ext.atlas->ballStatus : sp;
+    }
+    if (sp) {
+      ext.spriteAspectFit(sp, cx - r, cy - r, r * 2.0f, r * 2.0f, HudC4(255, 255, 255, 1.0f));
+      return;
+    }
+  }
+  HudExtColor top = mon.isFainted ? HudC4(110, 82, 88) : (mon.isActive ? HudC4(66, 198, 245) : HudC4(228, 66, 74));
+  HudExtColor bot = mon.isFainted ? HudC4(76, 64, 70) : HudC4(236, 242, 250);
+  ext.circle(cx, cy, r, top, bot);
+  ext.line(cx - r * 0.92f, cy, cx + r * 0.92f, cy, 0.9f, HudC4(28, 36, 52, 0.95f));
+  ext.circle(cx, cy, r * 0.32f, HudC4(252, 254, 255), HudC4(212, 222, 236));
+}
