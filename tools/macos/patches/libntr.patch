+extern "C" {
+
+void SIM_Battle3D_SetFrame(const SIM_Battle3DFrame *frame) {
+  std::lock_guard<std::mutex> lock(SIM::Render::gStateMutex);
+  if (frame) {
+    SIM::Render::gSharedFrame = *frame;
+  } else {
+    std::memset(&SIM::Render::gSharedFrame, 0, sizeof(SIM::Render::gSharedFrame));
+  }
+}
+
+void SIM_Battle3D_Clear(void) {
+  {
+    std::lock_guard<std::mutex> lock(SIM::Render::gStateMutex);
+    std::memset(&SIM::Render::gSharedFrame, 0, sizeof(SIM::Render::gSharedFrame));
+    for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+      SIM::Render::gActorBones[i] = SIM::Render::CachedActorBones{};
+    }
+  }
+  // P2: Schedule release of non-active GLB arenas on the render thread at battle teardown.
+  SIM::Render::gClearNonActiveArenasPending.store(true, std::memory_order_release);
+}
+
+int SIM_Battle3D_IsSupported(void) {
+  return 1;
+}
+
+int SIM_Battle3D_HasModel(int species, int form, int isShiny) {
+  return SIM::Render::HasModelFast(species, form, isShiny, true) ? 1 : 0;
+}
+
+int SIM_Battle3D_HasArena(int biome) {
+  return SIM::Render::HasArenaFast(biome) ? 1 : 0;
+}
+
+int SIM_Battle3D_HasActor(int kind) {
+  return SIM::Render::HasActorFast(kind, true) ? 1 : 0;
+}
+
+int SIM_Battle3D_GetModelBounds(int species, int form, int isShiny, float outMin[3], float outMax[3]) {
+  if (species <= 0 || !outMin || !outMax) {
+    return 0;
+  }
+  const std::uint64_t key = SIM::Render::MakeModelKey(species, form, isShiny);
+  std::lock_guard<std::mutex> lock(SIM::Render::gProbeMutex);
+  auto it = SIM::Render::gModelBounds.find(key);
+  if (it == SIM::Render::gModelBounds.end()) {
+    return 0;
+  }
+  std::memcpy(outMin, it->second.min, sizeof(float) * 3);
+  std::memcpy(outMax, it->second.max, sizeof(float) * 3);
+  return 1;
+}
+
+int SIM_Battle3D_IsModelReady(int species, int form, int isShiny) {
+  if (species <= 0) {
+    return 0;
+  }
+  const std::uint64_t key = SIM::Render::MakeModelKey(species, form, isShiny);
+  {
+    std::lock_guard<std::mutex> lock(SIM::Render::gProbeMutex);
+    if (SIM::Render::gFailedModels.count(key) != 0) {
+      return 0;
+    }
+    if (SIM::Render::gReadyModels.count(key) != 0) {
+      return 1;
+    }
+  }
+
+  // Interactive mode: non-blocking check (async worker uploads to GPU, then marks gReadyModels).
+  if (!SIM_Headless_Enabled()) {
+    SIM::Render::HasModelFast(species, form, isShiny, true);
+    return 0;
+  }
+
+  // Headless mode: deterministic single-parse synchronous validation & CPU staging so the render
+  // thread uploads the already-parsed CPU data on the same frame without double-parsing.
+  if (SIM::Render::gAsyncLoader.HasPendingModelCpu(key)) {
+    return 1;
+  }
+  std::string path = SIM::Render::ResolveModelPath(species, form, isShiny);
+  if (path.empty()) {
+    return 0;
+  }
+  SIM::Render::GltfModelCpuData cpu;
+  if (!SIM::Render::LoadGltfModelCpu(path, cpu)) {
+    std::lock_guard<std::mutex> lock(SIM::Render::gProbeMutex);
+    SIM::Render::gFailedModels.insert(key);
+    return 0;
+  }
+  SIM::Render::RecordModelCpuMetadata(key, cpu);
+  SIM::Render::gAsyncLoader.StoreSyncModel(key, std::move(cpu));
+  return 1;
+}
+
+int SIM_Battle3D_GetActorBonePos(int actorIdx, int boneKind, float outPos[3]) {
+  if (!outPos || actorIdx < 0 || actorIdx >= SIM_BATTLE3D_MAX_ACTORS) {
+    return 0;
+  }
+  const int bSlot = boneKind - 1;
+  if (bSlot < 0 || bSlot > 1) {
+    return 0;
+  }
+  std::lock_guard<std::mutex> lock(SIM::Render::gStateMutex);
+  const auto &ab = SIM::Render::gActorBones[actorIdx];
+  if (!ab.valid[bSlot]) {
+    return 0;
+  }
+  outPos[0] = ab.pos[bSlot][0];
+  outPos[1] = ab.pos[bSlot][1];
+  outPos[2] = ab.pos[bSlot][2];
+  return 1;
+}
+
+int SIM_Battle3D_GetActorSocketPos(int actorIdx, int boneKind, int expectedNonce,
+                                   float minAnimTime, const float localOffset[3],
+                                   float outPos[3]) {
+  if (!outPos || actorIdx < 0 || actorIdx >= SIM_BATTLE3D_MAX_ACTORS) {
+    return 0;
+  }
+  const int bSlot = boneKind - 1;
+  if (bSlot < 0 || bSlot > 1) {
+    return 0;
+  }
+  std::lock_guard<std::mutex> lock(SIM::Render::gStateMutex);
+  const auto &ab = SIM::Render::gActorBones[actorIdx];
+  if (!ab.valid[bSlot]) {
+    return 0;
+  }
+  if (expectedNonce > 0 && ab.animNonce != expectedNonce) {
+    return 0;
+  }
+  if (ab.animTime + 0.025f < minAnimTime) {
+    return 0;
+  }
+  const float *bm = ab.mat[bSlot];
+  const float ox = localOffset ? localOffset[0] : 0.0f;
+  const float oy = localOffset ? localOffset[1] : 0.0f;
+  const float oz = localOffset ? localOffset[2] : 0.0f;
+  outPos[0] = bm[0] * ox + bm[4] * oy + bm[8]  * oz + bm[12];
+  outPos[1] = bm[1] * ox + bm[5] * oy + bm[9]  * oz + bm[13];
+  outPos[2] = bm[2] * ox + bm[6] * oy + bm[10] * oz + bm[14];
+  return 1;
+}
+
+float SIM_Battle3D_GetClipDuration(int species, int form, int isShiny, int animState) {
+  if (species <= 0 || animState < 0 || animState >= SIM::Render::kBattle3DAnimSlotCount) {
+    return 0.0f;
+  }
+  const std::uint64_t key = SIM::Render::MakeModelKey(species, form, isShiny);
+  std::lock_guard<std::mutex> lock(SIM::Render::gProbeMutex);
+  auto it = SIM::Render::gModelClipDurations.find(key);
+  if (it == SIM::Render::gModelClipDurations.end()) {
+    return 0.0f;
+  }
+  return it->second[static_cast<std::size_t>(animState)];
+}
+
