+#pragma once
+// fx_weather lane: tiny game -> simulator weather/mood API.
+// The game calls SIM_Weather_Set on map/weather change (src/fx_weather.c);
+// the SDL GPU backend applies the matching post effects in its weather
+// pass. Under Renderer=gl the calls are stored but never drawn (no-op).
+// Kinds: 0 none, 1 fog, 2 rain (wet look), 3 thunderstorm (rain +
+// lightning pulse), 4 light shafts, 5 heat haze, 6 Everspring Fairy Sanctuary
+// (bioluminescent spores/petals + subtle twilight pulse). Intensity is 0..1.
+// SIM_Water_Set enables the water reflection/foam pass (masked in the
+// shader, so enabling it away from water changes nothing).
+#ifdef __cplusplus
+extern "C" {
+#endif
+void SIM_Weather_Set(int kind, float intensity);
+int SIM_Weather_GetKind(void);
+float SIM_Weather_GetIntensity(void);
+void SIM_Water_Set(int enabled);
+int SIM_Water_GetEnabled(void);
+#ifdef __cplusplus
+}
+#endif
