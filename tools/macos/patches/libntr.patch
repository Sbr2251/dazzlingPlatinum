+namespace detail {
+Backend *gBackend = nullptr;
+} // namespace detail
+
+Backend *CreateGpuBackend();
+
+Backend &Select() {
+  if (detail::gBackend) return *detail::gBackend;
+  // SIM_RENDERER env wins; otherwise the sim_config.ini Renderer key
+  // (loaded before SIM_RenderInit); otherwise gl. The config value is
+  // only ever gl or gpu: the parser ignores any other string.
+  const char *env = getenv("SIM_RENDERER");
+  const char *choice = env;
+  const char *source = "SIM_RENDERER";
+  if (!choice) {
+    SIM_config_type *config = SIM_GetConfigPtr();
+    choice = (config && config->renderer == SIM_CONFIG_RENDERER_GPU) ? "gpu" : "gl";
+    source = "sim_config.ini Renderer";
+  }
+  printf("Renderer: %s (from %s)\n", choice, source);
+  fflush(stdout);
+  if (strcmp(choice, "gpu") == 0) {
+    if (GpuDeviceAvailable()) {
+      detail::gBackend = CreateGpuBackend();
+      return *detail::gBackend;
+    }
+    printf("Renderer: gpu requested but no GPU device could be created, falling back to gl\n");
+    fflush(stdout);
+    detail::gBackend = gGlBackend;
+    return *detail::gBackend;
+  }
+  if (strcmp(choice, "gl") != 0)
+    printf("SIM_RENDERER=%s: unknown backend, falling back to gl\n", choice);
+  detail::gBackend = gGlBackend;
+  return *detail::gBackend;
+}
