+void QuatNormalize(float q[4]) {
+  float len = std::sqrt(q[0] * q[0] + q[1] * q[1] + q[2] * q[2] + q[3] * q[3]);
+  if (len > 1e-6f) {
+    q[0] /= len; q[1] /= len; q[2] /= len; q[3] /= len;
+  } else {
+    q[0] = 0.0f; q[1] = 0.0f; q[2] = 0.0f; q[3] = 1.0f;
+  }
+}
+
+void QuatSlerp(float out[4], const float a[4], const float bIn[4], float t) {
+  float b[4] = {bIn[0], bIn[1], bIn[2], bIn[3]};
+  float dot = a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3];
+  if (dot < 0.0f) {
+    dot = -dot;
+    b[0] = -b[0]; b[1] = -b[1]; b[2] = -b[2]; b[3] = -b[3];
+  }
+  if (dot > 0.9995f) {
+    for (int i = 0; i < 4; i++) out[i] = a[i] + (b[i] - a[i]) * t;
+    QuatNormalize(out);
+    return;
+  }
+  dot = std::clamp(dot, -1.0f, 1.0f);
+  float theta = std::acos(dot);
+  float sinTheta = std::sin(theta);
+  float w0 = std::sin((1.0f - t) * theta) / sinTheta;
+  float w1 = std::sin(t * theta) / sinTheta;
+  for (int i = 0; i < 4; i++) out[i] = a[i] * w0 + b[i] * w1;
+  QuatNormalize(out);
+}
+
+void SampleChannel(const GltfAnimChannel &ch, float time, float out[4]) {
+  const std::size_t nKeys = ch.times.size();
+  const int comps = (ch.path == GltfAnimPath::Rotation) ? 4 : 3;
+  if (nKeys == 0 || ch.values.empty()) return;
+
+  const std::size_t stride = (ch.interp == GltfAnimInterp::CubicSpline)
+                                 ? static_cast<std::size_t>(comps * 3)
+                                 : static_cast<std::size_t>(comps);
+  if (ch.values.size() < nKeys * stride) return;
+
+  auto valPtr = [&](std::size_t k) -> const float * {
+    return ch.values.data() + k * stride +
+           (ch.interp == GltfAnimInterp::CubicSpline ? static_cast<std::size_t>(comps) : 0u);
+  };
+
+  if (nKeys == 1 || time <= ch.times.front()) {
+    std::memcpy(out, valPtr(0), sizeof(float) * static_cast<std::size_t>(comps));
+    if (comps == 4) QuatNormalize(out);
+    return;
+  }
+  if (time >= ch.times.back()) {
+    std::memcpy(out, valPtr(nKeys - 1), sizeof(float) * static_cast<std::size_t>(comps));
+    if (comps == 4) QuatNormalize(out);
+    return;
+  }
+
+  auto it = std::upper_bound(ch.times.begin(), ch.times.end(), time);
+  std::size_t k1 = static_cast<std::size_t>(it - ch.times.begin());
+  if (k1 == 0) k1 = 1;
+  if (k1 >= nKeys) k1 = nKeys - 1;
+  std::size_t k0 = k1 - 1;
+
+  float t0 = ch.times[k0];
+  float t1 = ch.times[k1];
+  float dt = t1 - t0;
+  float alpha = (dt > 1e-6f) ? std::clamp((time - t0) / dt, 0.0f, 1.0f) : 0.0f;
+
+  if (ch.interp == GltfAnimInterp::Step) {
+    std::memcpy(out, valPtr(k0), sizeof(float) * static_cast<std::size_t>(comps));
+    if (comps == 4) QuatNormalize(out);
+    return;
+  }
+
+  if (ch.interp == GltfAnimInterp::CubicSpline) {
+    const float *v0 = ch.values.data() + k0 * stride + comps;
+    const float *b0 = ch.values.data() + k0 * stride + comps * 2;
+    const float *a1 = ch.values.data() + k1 * stride;
+    const float *v1 = ch.values.data() + k1 * stride + comps;
+    float s = alpha;
+    float s2 = s * s;
+    float s3 = s2 * s;
+    float h00 = 2.0f * s3 - 3.0f * s2 + 1.0f;
+    float h10 = s3 - 2.0f * s2 + s;
+    float h01 = -2.0f * s3 + 3.0f * s2;
+    float h11 = s3 - s2;
+    for (int c = 0; c < comps; c++) {
+      out[c] = h00 * v0[c] + h10 * dt * b0[c] + h01 * v1[c] + h11 * dt * a1[c];
+    }
+    if (comps == 4) QuatNormalize(out);
+    return;
+  }
+
+  const float *v0 = valPtr(k0);
+  const float *v1 = valPtr(k1);
+  if (comps == 4) {
+    QuatSlerp(out, v0, v1, alpha);
+  } else {
+    for (int c = 0; c < 3; c++) out[c] = v0[c] + (v1[c] - v0[c]) * alpha;
+  }
+}
+
+void ComputeMissingSkinnedNormals(std::vector<GltfSkinnedVertex> &verts, std::uint32_t baseVert,
+                                  std::uint32_t vertCount, const std::vector<std::uint32_t> &indices,
+                                  std::uint32_t firstIdx, std::uint32_t idxCount) {
+  for (std::uint32_t v = 0; v < vertCount; v++) {
+    verts[baseVert + v].norm[0] = 0.0f;
+    verts[baseVert + v].norm[1] = 0.0f;
+    verts[baseVert + v].norm[2] = 0.0f;
+  }
+  for (std::uint32_t i = firstIdx; i + 2 < firstIdx + idxCount; i += 3) {
+    if (indices[i] >= verts.size() || indices[i + 1] >= verts.size() ||
+        indices[i + 2] >= verts.size()) {
+      continue;
+    }
+    auto &v0 = verts[indices[i]];
+    auto &v1 = verts[indices[i + 1]];
+    auto &v2 = verts[indices[i + 2]];
+    float e1[3] = {v1.pos[0] - v0.pos[0], v1.pos[1] - v0.pos[1], v1.pos[2] - v0.pos[2]};
+    float e2[3] = {v2.pos[0] - v0.pos[0], v2.pos[1] - v0.pos[1], v2.pos[2] - v0.pos[2]};
+    float n[3] = {e1[1] * e2[2] - e1[2] * e2[1],
+                  e1[2] * e2[0] - e1[0] * e2[2],
+                  e1[0] * e2[1] - e1[1] * e2[0]};
+    for (int k = 0; k < 3; k++) {
+      v0.norm[k] += n[k]; v1.norm[k] += n[k]; v2.norm[k] += n[k];
+    }
+  }
+  for (std::uint32_t v = 0; v < vertCount; v++) {
+    float *n = verts[baseVert + v].norm;
+    float len = std::sqrt(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]);
+    if (len > 1e-6f) {
+      n[0] /= len; n[1] /= len; n[2] /= len;
+    } else {
+      n[0] = 0.0f; n[1] = 1.0f; n[2] = 0.0f;
+    }
+  }
+}
+
+void ParseClip(const cgltf_data *data, const cgltf_animation &ga, GltfAnimClip &dst) {
+  dst.name = ga.name ? ga.name : "";
+  dst.duration = 0.0f;
+  dst.channels.clear();
+  dst.channels.reserve(ga.channels_count);
+
+  for (cgltf_size ci = 0; ci < ga.channels_count; ci++) {
+    const cgltf_animation_channel &gc = ga.channels[ci];
+    if (!gc.target_node || !gc.sampler || !gc.sampler->input || !gc.sampler->output) continue;
+    GltfAnimPath path;
+    int comps = 3;
+    if (gc.target_path == cgltf_animation_path_type_translation) {
+      path = GltfAnimPath::Translation; comps = 3;
+    } else if (gc.target_path == cgltf_animation_path_type_rotation) {
+      path = GltfAnimPath::Rotation; comps = 4;
+    } else if (gc.target_path == cgltf_animation_path_type_scale) {
+      path = GltfAnimPath::Scale; comps = 3;
+    } else {
+      continue;
+    }
+
+    const cgltf_accessor *inAcc = gc.sampler->input;
+    const cgltf_accessor *outAcc = gc.sampler->output;
+    if (inAcc->count == 0 || outAcc->count == 0) continue;
+
+    GltfAnimChannel ch{};
+    ch.targetNode = static_cast<std::int32_t>(gc.target_node - data->nodes);
+    ch.path = path;
+    if (gc.sampler->interpolation == cgltf_interpolation_type_step) {
+      ch.interp = GltfAnimInterp::Step;
+    } else if (gc.sampler->interpolation == cgltf_interpolation_type_cubic_spline) {
+      ch.interp = GltfAnimInterp::CubicSpline;
+    } else {
+      ch.interp = GltfAnimInterp::Linear;
+    }
+
+    ch.times.resize(inAcc->count);
+    for (cgltf_size k = 0; k < inAcc->count; k++) {
+      float t = 0.0f;
+      cgltf_accessor_read_float(inAcc, k, &t, 1);
+      ch.times[k] = t;
+      if (t > dst.duration) dst.duration = t;
+    }
+
+    const std::size_t elemsPerKey = (ch.interp == GltfAnimInterp::CubicSpline) ? 3u : 1u;
+    const std::size_t needed = inAcc->count * elemsPerKey;
+    if (outAcc->count < needed) continue;
+    ch.values.resize(needed * static_cast<std::size_t>(comps));
+    for (std::size_t k = 0; k < needed; k++) {
+      cgltf_accessor_read_float(outAcc, k, &ch.values[k * static_cast<std::size_t>(comps)],
+                                static_cast<cgltf_size>(comps));
+    }
+    dst.channels.push_back(std::move(ch));
+  }
+}
+
+void ApplyClipToTRS(const GltfAnimClip &clip, float time, std::vector<GltfNodeTRS> &trs) {
+  for (const auto &ch : clip.channels) {
+    if (ch.targetNode < 0 || static_cast<std::size_t>(ch.targetNode) >= trs.size()) continue;
+    GltfNodeTRS &n = trs[static_cast<std::size_t>(ch.targetNode)];
+    float val[4] = {};
+    SampleChannel(ch, time, val);
+    if (ch.path == GltfAnimPath::Translation) {
+      n.t[0] = val[0]; n.t[1] = val[1]; n.t[2] = val[2];
+    } else if (ch.path == GltfAnimPath::Rotation) {
+      n.r[0] = val[0]; n.r[1] = val[1]; n.r[2] = val[2]; n.r[3] = val[3];
+    } else {
+      n.s[0] = val[0]; n.s[1] = val[1]; n.s[2] = val[2];
+    }
+    n.animated = true;
+  }
+}
+
+} // namespace
+
+bool LoadGltfModelCpu(const std::string &path, GltfModelCpuData &out) {
+  out = GltfModelCpuData{};
+  if (!ValidateGlbHeader(path)) return false;
+  std::vector<std::uint8_t> fileBytes;
+  if (!ReadFileBytes(path, fileBytes)) return false;
+
+  cgltf_options opts{};
+  cgltf_data *data = nullptr;
+  if (cgltf_parse(&opts, fileBytes.data(), fileBytes.size(), &data) != cgltf_result_success || !data) {
+    return false;
+  }
+  if (cgltf_load_buffers(&opts, data, path.c_str()) != cgltf_result_success ||
+      cgltf_validate(data) != cgltf_result_success) {
+    cgltf_free(data);
+    return false;
+  }
+
+  // Reject oversized skins (> kMaxGltfJoints) cleanly before decoding any textures.
+  for (cgltf_size si = 0; si < data->skins_count; si++) {
+    if (data->skins[si].joints_count > kMaxGltfJoints) {
+      cgltf_free(data);
+      return false;
+    }
+  }
+
+  DecodeTexturesAndMaterials(data, out.textures, out.materials);
+  BuildNodeHierarchy(data, out.nodes, out.topoOrder);
+
+  // Locate named hand socket bones (prefer exact "RHand"/"LHand" over "*EX" variants).
+  out.rHandNode = -1;
+  out.lHandNode = -1;
+  std::int32_t rHandFallback = -1;
+  std::int32_t lHandFallback = -1;
+  for (cgltf_size i = 0; i < data->nodes_count; i++) {
+    const char *nm = data->nodes[i].name;
+    if (!nm || nm[0] == '\0') continue;
+    std::string lo = LowerStr(nm);
+    if (lo == "rhand" || lo == "hand_r" || lo == "righthand") {
+      out.rHandNode = static_cast<std::int32_t>(i);
+    } else if (lo == "lhand" || lo == "hand_l" || lo == "lefthand") {
+      out.lHandNode = static_cast<std::int32_t>(i);
+    } else if (rHandFallback < 0 && lo.find("rhand") != std::string::npos) {
+      rHandFallback = static_cast<std::int32_t>(i);
+    } else if (lHandFallback < 0 && lo.find("lhand") != std::string::npos) {
+      lHandFallback = static_cast<std::int32_t>(i);
+    }
+  }
+  if (out.rHandNode < 0) out.rHandNode = rHandFallback;
+  if (out.lHandNode < 0) out.lHandNode = lHandFallback;
+
+  // Skins
+  out.skins.resize(data->skins_count);
+  for (cgltf_size si = 0; si < data->skins_count; si++) {
+    const cgltf_skin &gs = data->skins[si];
+    GltfSkin &ds = out.skins[si];
+    const cgltf_size jc = std::min<cgltf_size>(gs.joints_count, kMaxGltfJoints);
+    ds.joints.resize(jc);
+    ds.inverseBindMatrices.resize(jc * 16);
+    for (cgltf_size j = 0; j < jc; j++) {
+      ds.joints[j] = (gs.joints[j] && data->nodes)
+                         ? static_cast<std::int32_t>(gs.joints[j] - data->nodes)
+                         : -1;
+      float *ibm = &ds.inverseBindMatrices[j * 16];
+      if (gs.inverse_bind_matrices && j < gs.inverse_bind_matrices->count) {
+        cgltf_accessor_read_float(gs.inverse_bind_matrices, j, ibm, 16);
+      } else {
+        Mat4Identity(ibm);
+      }
+    }
+  }
+
+  // Animations -> 6 semantic slots
+  for (int i = 0; i < kBattle3DAnimSlotCount; i++) out.hasClip[i] = false;
+  for (cgltf_size ai = 0; ai < data->animations_count; ai++) {
+    int slot = MatchAnimSlot(data->animations[ai].name);
+    if (slot >= 0 && slot < kBattle3DAnimSlotCount && !out.hasClip[slot]) {
+      ParseClip(data, data->animations[ai], out.clips[slot]);
+      if (!out.clips[slot].channels.empty()) {
+        out.hasClip[slot] = true;
+      }
+    }
+  }
+  if (!out.hasClip[SIM_BATTLE3D_ANIM_IDLE] && data->animations_count > 0) {
+    ParseClip(data, data->animations[0], out.clips[SIM_BATTLE3D_ANIM_IDLE]);
+    if (!out.clips[SIM_BATTLE3D_ANIM_IDLE].channels.empty()) {
+      out.hasClip[SIM_BATTLE3D_ANIM_IDLE] = true;
+    }
+  }
+
+  // Geometry
+  std::vector<GltfSkinnedVertex> &verts = out.verts;
+  std::vector<std::uint32_t> &indices = out.indices;
+  bool bboxInit = false;
+
+  for (cgltf_size ni = 0; ni < data->nodes_count; ni++) {
+    const cgltf_node &gn = data->nodes[ni];
+    if (!gn.mesh) continue;
+    const std::int32_t skinIdx = (gn.skin && data->skins)
+                                     ? static_cast<std::int32_t>(gn.skin - data->skins)
+                                     : -1;
+
+    for (cgltf_size pi = 0; pi < gn.mesh->primitives_count; pi++) {
+      const cgltf_primitive &prim = gn.mesh->primitives[pi];
+      if (prim.type != cgltf_primitive_type_triangles) continue;
+
+      const cgltf_accessor *posAcc = nullptr;
+      const cgltf_accessor *normAcc = nullptr;
+      const cgltf_accessor *uvAcc = nullptr;
+      const cgltf_accessor *colAcc = nullptr;
+      const cgltf_accessor *jointsAcc = nullptr;
+      const cgltf_accessor *weightsAcc = nullptr;
+      for (cgltf_size ai = 0; ai < prim.attributes_count; ai++) {
+        const cgltf_attribute &a = prim.attributes[ai];
+        if (a.type == cgltf_attribute_type_position) posAcc = a.data;
+        else if (a.type == cgltf_attribute_type_normal) normAcc = a.data;
+        else if (a.type == cgltf_attribute_type_texcoord && a.index == 0) uvAcc = a.data;
+        else if (a.type == cgltf_attribute_type_color && a.index == 0) colAcc = a.data;
+        else if (a.type == cgltf_attribute_type_joints && a.index == 0) jointsAcc = a.data;
+        else if (a.type == cgltf_attribute_type_weights && a.index == 0) weightsAcc = a.data;
+      }
+      if (!posAcc || posAcc->count == 0) continue;
+
+      const bool hasSkin = (skinIdx >= 0 && jointsAcc != nullptr && weightsAcc != nullptr);
+      const std::uint32_t maxJoint = (hasSkin && !out.skins[static_cast<std::size_t>(skinIdx)].joints.empty())
+                                         ? static_cast<std::uint32_t>(
+                                               out.skins[static_cast<std::size_t>(skinIdx)].joints.size() - 1)
+                                         : 0u;
+
+      const std::uint32_t baseVert = static_cast<std::uint32_t>(verts.size());
+      const std::uint32_t vCount = static_cast<std::uint32_t>(posAcc->count);
+      verts.resize(baseVert + vCount);
+
+      for (std::uint32_t v = 0; v < vCount; v++) {
+        GltfSkinnedVertex &dv = verts[baseVert + v];
+        cgltf_accessor_read_float(posAcc, v, dv.pos, 3);
+        if (!bboxInit) {
+          for (int k = 0; k < 3; k++) out.bboxMin[k] = out.bboxMax[k] = dv.pos[k];
+          bboxInit = true;
+        } else {
+          for (int k = 0; k < 3; k++) {
+            out.bboxMin[k] = std::min(out.bboxMin[k], dv.pos[k]);
+            out.bboxMax[k] = std::max(out.bboxMax[k], dv.pos[k]);
+          }
+        }
+
+        if (normAcc && v < normAcc->count) {
+          cgltf_accessor_read_float(normAcc, v, dv.norm, 3);
+        } else {
+          dv.norm[0] = 0.0f; dv.norm[1] = 1.0f; dv.norm[2] = 0.0f;
+        }
+
+        if (uvAcc && v < uvAcc->count) {
+          cgltf_accessor_read_float(uvAcc, v, dv.uv, 2);
+        } else {
+          dv.uv[0] = 0.0f; dv.uv[1] = 0.0f;
+        }
+
+        dv.color[0] = 1.0f; dv.color[1] = 1.0f; dv.color[2] = 1.0f; dv.color[3] = 1.0f;
+        if (colAcc && v < colAcc->count) {
+          cgltf_accessor_read_float(colAcc, v, dv.color, colAcc->type == cgltf_type_vec3 ? 3 : 4);
+        }
+
+        if (hasSkin && v < jointsAcc->count && v < weightsAcc->count) {
+          cgltf_uint jtmp[4] = {0, 0, 0, 0};
+          cgltf_accessor_read_uint(jointsAcc, v, jtmp, 4);
+          cgltf_accessor_read_float(weightsAcc, v, dv.weights, 4);
+          const std::size_t skinJointCount = out.skins[static_cast<std::size_t>(skinIdx)].joints.size();
+          float wSum = 0.0f;
+          for (int k = 0; k < 4; k++) {
+            if (dv.weights[k] < 0.0f) dv.weights[k] = 0.0f;
+            if (dv.weights[k] > 0.0f && static_cast<std::size_t>(jtmp[k]) >= skinJointCount) {
+              cgltf_free(data);
+              out = GltfModelCpuData{};
+              return false;
+            }
+            dv.joints[k] = std::min<std::uint32_t>(static_cast<std::uint32_t>(jtmp[k]), maxJoint);
+            wSum += dv.weights[k];
+          }
+          if (wSum > 1e-5f) {
+            for (int k = 0; k < 4; k++) dv.weights[k] /= wSum;
+          } else {
+            dv.joints[0] = 0; dv.weights[0] = 1.0f;
+            dv.weights[1] = dv.weights[2] = dv.weights[3] = 0.0f;
+          }
+        } else {
+          // Rigid mesh attached to bone/node: bind all vertices to joint 0 with weight 1.0.
+          dv.joints[0] = dv.joints[1] = dv.joints[2] = dv.joints[3] = 0;
+          dv.weights[0] = 1.0f;
+          dv.weights[1] = dv.weights[2] = dv.weights[3] = 0.0f;
+        }
+      }
+
+      const std::uint32_t firstIdx = static_cast<std::uint32_t>(indices.size());
+      if (prim.indices && prim.indices->count >= 3) {
+        std::size_t ic = (prim.indices->count / 3) * 3;
+        indices.reserve(indices.size() + ic);
+        for (std::size_t i = 0; i < ic; i++) {
+          cgltf_size rawIdx = cgltf_accessor_read_index(prim.indices, i);
+          if (rawIdx >= vCount) {
+            cgltf_free(data);
+            out = GltfModelCpuData{};
+            return false;
+          }
+          indices.push_back(baseVert + static_cast<std::uint32_t>(rawIdx));
+        }
+      } else if (vCount >= 3) {
+        std::uint32_t ic = (vCount / 3) * 3;
+        indices.reserve(indices.size() + ic);
+        for (std::uint32_t i = 0; i < ic; i++) indices.push_back(baseVert + i);
+      }
+      const std::uint32_t idxCount = static_cast<std::uint32_t>(indices.size()) - firstIdx;
+      if (idxCount == 0) continue;
+
+      if (!normAcc) {
+        ComputeMissingSkinnedNormals(verts, baseVert, vCount, indices, firstIdx, idxCount);
+      }
+
+      GltfPrimitive dp{};
+      dp.firstIndex = firstIdx;
+      dp.indexCount = idxCount;
+      dp.materialIndex = (prim.material && data->materials)
+                             ? static_cast<std::int32_t>(prim.material - data->materials)
+                             : -1;
+      dp.skinIndex = hasSkin ? skinIdx : -1;
+      dp.nodeIndex = static_cast<std::int32_t>(ni);
+      out.primitives.push_back(dp);
+    }
+  }
+
+  cgltf_free(data);
+
+  if (verts.empty() || indices.empty() || out.primitives.empty()) {
+    out = GltfModelCpuData{};
+    return false;
+  }
+
+  // Draw Opaque & Mask before Blend.
+  std::stable_sort(out.primitives.begin(), out.primitives.end(),
+                   [&](const GltfPrimitive &a, const GltfPrimitive &b) {
+                     auto rank = [&](const GltfPrimitive &p) {
+                       if (p.materialIndex < 0 ||
+                           static_cast<std::size_t>(p.materialIndex) >= out.materials.size()) {
+                         return 0;
+                       }
+                       auto mode = out.materials[static_cast<std::size_t>(p.materialIndex)].alphaMode;
+                       return mode == GltfAlphaMode::Blend ? 2 : (mode == GltfAlphaMode::Mask ? 1 : 0);
+                     };
+                     return rank(a) < rank(b);
+                   });
+
+  out.valid = true;
+  return true;
+}
+
+bool UploadGltfModelCpu(Device &device, Frame *frame, GltfModelCpuData &&cpu, GltfModel &out) {
+  if (!frame || !cpu.valid || cpu.verts.empty() || cpu.indices.empty() || cpu.primitives.empty()) {
+    return false;
+  }
+
+  std::size_t vramBytes = 0;
+  UploadMipmappedTextures(device, frame, cpu.textures, "battle3d_mon_tex", out.textures, vramBytes);
+
+  const std::size_t vBytes = cpu.verts.size() * sizeof(GltfSkinnedVertex);
+  const std::size_t iBytes = cpu.indices.size() * sizeof(std::uint32_t);
+
+  SDL_GPUBufferCreateInfo vInfo{};
+  vInfo.usage = SDL_GPU_BUFFERUSAGE_VERTEX;
+  vInfo.size = static_cast<Uint32>(vBytes);
+  out.vertexBuffer = SDL_CreateGPUBuffer(device.Handle(), &vInfo);
+  if (!out.vertexBuffer) {
+    ReleaseGltfModel(device, out);
+    return false;
+  }
+
+  SDL_GPUBufferCreateInfo iInfo{};
+  iInfo.usage = SDL_GPU_BUFFERUSAGE_INDEX;
+  iInfo.size = static_cast<Uint32>(iBytes);
+  out.indexBuffer = SDL_CreateGPUBuffer(device.Handle(), &iInfo);
+  if (!out.indexBuffer) {
+    ReleaseGltfModel(device, out);
+    return false;
+  }
+
+  frame->UploadBuffer(out.vertexBuffer, 0, cpu.verts.data(), static_cast<Uint32>(vBytes), true);
+  frame->UploadBuffer(out.indexBuffer, 0, cpu.indices.data(), static_cast<Uint32>(iBytes), true);
+  out.numVertices = static_cast<std::uint32_t>(cpu.verts.size());
+  out.numIndices = static_cast<std::uint32_t>(cpu.indices.size());
+  out.vramBytes = vramBytes + vBytes + iBytes;
+  out.materials = std::move(cpu.materials);
+  out.primitives = std::move(cpu.primitives);
+  out.nodes = std::move(cpu.nodes);
+  out.topoOrder = std::move(cpu.topoOrder);
+  out.skins = std::move(cpu.skins);
+  for (int i = 0; i < kBattle3DAnimSlotCount; i++) {
+    out.clips[i] = std::move(cpu.clips[i]);
+    out.hasClip[i] = cpu.hasClip[i];
+  }
+  std::memcpy(out.bboxMin, cpu.bboxMin, sizeof(out.bboxMin));
+  std::memcpy(out.bboxMax, cpu.bboxMax, sizeof(out.bboxMax));
+  out.rHandNode = cpu.rHandNode;
+  out.lHandNode = cpu.lHandNode;
+  out.valid = true;
+  return true;
+}
+
+bool LoadGltfModel(Device &device, Frame *frame, const std::string &path, GltfModel &out) {
+  if (!frame) return false;
+  GltfModelCpuData cpu;
+  if (!LoadGltfModelCpu(path, cpu)) return false;
+  return UploadGltfModelCpu(device, frame, std::move(cpu), out);
+}
+
+void ReleaseGltfModel(Device &device, GltfModel &model) {
+  if (device.Handle()) {
+    if (model.vertexBuffer) {
+      SDL_ReleaseGPUBuffer(device.Handle(), model.vertexBuffer);
+      model.vertexBuffer = nullptr;
+    }
+    if (model.indexBuffer) {
+      SDL_ReleaseGPUBuffer(device.Handle(), model.indexBuffer);
+      model.indexBuffer = nullptr;
+    }
+  }
+  model.textures.clear();
+  model.materials.clear();
+  model.primitives.clear();
+  model.nodes.clear();
+  model.topoOrder.clear();
+  model.skins.clear();
+  for (int i = 0; i < kBattle3DAnimSlotCount; i++) {
+    model.clips[i] = GltfAnimClip{};
+    model.hasClip[i] = false;
+  }
+  model.numVertices = 0;
+  model.numIndices = 0;
+  model.vramBytes = 0;
+  model.rHandNode = -1;
+  model.lHandNode = -1;
+  model.valid = false;
+  model.attempted = false;
+}
+
+void EvaluateGltfPose(const GltfModel &model, int animState, float animTime,
+                      std::vector<float> &outNodeWorldMats, GltfPoseScratch &scratch) {
+  const std::size_t n = model.nodes.size();
+  outNodeWorldMats.resize(n * 16);
+  if (n == 0) return;
+
+  std::vector<GltfNodeTRS> &trs = scratch.trs;
+  trs.resize(n);
+  for (std::size_t i = 0; i < n; i++) {
+    std::memcpy(trs[i].t, model.nodes[i].translation, sizeof(trs[i].t));
+    std::memcpy(trs[i].r, model.nodes[i].rotation, sizeof(trs[i].r));
+    std::memcpy(trs[i].s, model.nodes[i].scale, sizeof(trs[i].s));
+    trs[i].animated = false;
+  }
+
+  int slot = (animState >= 0 && animState < kBattle3DAnimSlotCount) ? animState : SIM_BATTLE3D_ANIM_IDLE;
+  if (!model.hasClip[slot]) slot = SIM_BATTLE3D_ANIM_IDLE;
+
+  if (model.hasClip[slot]) {
+    const GltfAnimClip &clip = model.clips[slot];
+    float t = std::max(0.0f, animTime);
+    if (slot == SIM_BATTLE3D_ANIM_IDLE) {
+      if (clip.duration > 1e-4f) t = std::fmod(t, clip.duration);
+      ApplyClipToTRS(clip, t, trs);
+    } else if (slot == SIM_BATTLE3D_ANIM_FAINT) {
+      ApplyClipToTRS(clip, std::min(t, clip.duration), trs);
+    } else {
+      // One-shot clip: play to end, then smoothly blend into idle over 0.15s if idle exists.
+      if (t <= clip.duration || !model.hasClip[SIM_BATTLE3D_ANIM_IDLE]) {
+        ApplyClipToTRS(clip, std::min(t, clip.duration), trs);
+      } else {
+        float blend = std::clamp((t - clip.duration) / 0.15f, 0.0f, 1.0f);
+        ApplyClipToTRS(clip, clip.duration, trs);
+        std::vector<GltfNodeTRS> &idleTrs = scratch.idleTrs;
+        idleTrs.resize(n);
+        for (std::size_t i = 0; i < n; i++) {
+          std::memcpy(idleTrs[i].t, model.nodes[i].translation, sizeof(idleTrs[i].t));
+          std::memcpy(idleTrs[i].r, model.nodes[i].rotation, sizeof(idleTrs[i].r));
+          std::memcpy(idleTrs[i].s, model.nodes[i].scale, sizeof(idleTrs[i].s));
+          idleTrs[i].animated = false;
+        }
+        const GltfAnimClip &idleClip = model.clips[SIM_BATTLE3D_ANIM_IDLE];
+        float idleT = (idleClip.duration > 1e-4f) ? std::fmod(t - clip.duration, idleClip.duration) : 0.0f;
+        ApplyClipToTRS(idleClip, idleT, idleTrs);
+        for (std::size_t i = 0; i < n; i++) {
+          if (!trs[i].animated && !idleTrs[i].animated) continue;
+          for (int k = 0; k < 3; k++) {
+            trs[i].t[k] = trs[i].t[k] + (idleTrs[i].t[k] - trs[i].t[k]) * blend;
+            trs[i].s[k] = trs[i].s[k] + (idleTrs[i].s[k] - trs[i].s[k]) * blend;
+          }
+          float q[4];
+          QuatSlerp(q, trs[i].r, idleTrs[i].r, blend);
+          std::memcpy(trs[i].r, q, sizeof(q));
+          trs[i].animated = true;
+        }
+      }
+    }
+  }
+
+  for (std::int32_t idx : model.topoOrder) {
+    const std::size_t u = static_cast<std::size_t>(idx);
+    float local[16];
+    if (model.nodes[u].hasMatrix && !trs[u].animated) {
+      std::memcpy(local, model.nodes[u].matrix, sizeof(local));
+    } else {
+      Mat4FromTRS(local, trs[u].t, trs[u].r, trs[u].s);
+    }
+    float *dst = &outNodeWorldMats[u * 16];
+    if (model.nodes[u].parent >= 0) {
+      Mat4Mul(dst, &outNodeWorldMats[static_cast<std::size_t>(model.nodes[u].parent) * 16], local);
+    } else {
+      std::memcpy(dst, local, sizeof(local));
+    }
+  }
+}
+
+void EvaluateGltfPose(const GltfModel &model, int animState, float animTime,
+                      std::vector<float> &outNodeWorldMats) {
+  GltfPoseScratch scratch;
+  EvaluateGltfPose(model, animState, animTime, outNodeWorldMats, scratch);
+}
+
+void BuildGltfJointPalette(const GltfModel &model, std::int32_t skinIndex,
+                           const std::vector<float> &nodeWorldMats,
+                           float outJoints[kMaxGltfJoints * 16],
+                           std::uint32_t &outJointCount) {
+  outJointCount = 1;
+  Mat4Identity(outJoints);
+  if (skinIndex < 0 || static_cast<std::size_t>(skinIndex) >= model.skins.size()) return;
+  const GltfSkin &skin = model.skins[static_cast<std::size_t>(skinIndex)];
+  const std::size_t count = std::min<std::size_t>(skin.joints.size(), kMaxGltfJoints);
+  if (count == 0) return;
+
+  outJointCount = static_cast<std::uint32_t>(count);
+  for (std::size_t j = 0; j < count; j++) {
+    float *dst = &outJoints[j * 16];
+    const std::int32_t nodeIdx = skin.joints[j];
+    if (nodeIdx >= 0 && static_cast<std::size_t>(nodeIdx) * 16 + 16 <= nodeWorldMats.size()) {
+      Mat4Mul(dst, &nodeWorldMats[static_cast<std::size_t>(nodeIdx) * 16],
+              &skin.inverseBindMatrices[j * 16]);
+    } else {
+      Mat4Identity(dst);
+    }
+  }
+}
+
+bool GetGltfBoneWorldMatrix(const GltfModel &model, const float actorModelMat[16],
+                            const std::vector<float> &nodeWorldMats,
+                            int boneKind, float outWorldMat[16]) {
+  std::int32_t nodeIdx = -1;
+  if (boneKind == 1) {
+    nodeIdx = model.rHandNode;
+  } else if (boneKind == 2) {
+    nodeIdx = model.lHandNode;
+  } else {
+    return false;
+  }
+  if (nodeIdx < 0 || static_cast<std::size_t>(nodeIdx) * 16 + 16 > nodeWorldMats.size()) {
+    return false;
+  }
+  Mat4Mul(outWorldMat, actorModelMat, &nodeWorldMats[static_cast<std::size_t>(nodeIdx) * 16]);
+  return true;
+}
+
+} // namespace SIM::Render
diff --git a/libraries/sim/src/render_gpu/fx_battle3d_gltf.hpp b/libraries/sim/src/render_gpu/fx_battle3d_gltf.hpp
