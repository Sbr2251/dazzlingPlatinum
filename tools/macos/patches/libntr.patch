+SKINNED_VERT_MSL = r"""#include <metal_stdlib>
+#include <simd/simd.h>
+using namespace metal;
+
+struct SkinnedMainVertUniforms {
+    float4x4 viewProj;
+    float4x4 lightViewProj;
+    float4x4 modelMat;
+    float4 params; // x = isSkinned (>0.5)
+};
+
+struct SkinnedJointsUniforms {
