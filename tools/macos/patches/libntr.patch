+      id reason = ((id (*)(id, SEL, const char *))objc_msgSend)((id)objc_getClass("NSString"), sel_registerName("stringWithUTF8String:"), "game frame pacing");
+      unsigned long long options = (0x00FFFFFFULL & ~(1ULL << 20)) | 0xFF00000000ULL;
