+static bool EnvFlag(const char *name) {
+    const char *v = SDL_getenv(name);
+    return v && *v && strcmp(v, "0") != 0;
+}
+
+void LogError(const char *context, bool withSdlError) {
+    if (withSdlError) {
+        const char *err = SDL_GetError();
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "SIM_GPU: %s: %s", context, (err && *err) ? err : "(no SDL error)");
+    } else {
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "SIM_GPU: %s", context);
+    }
+    if (EnvFlag("SIM_GPU_FATAL")) {
+        SDL_LogError(SDL_LOG_CATEGORY_GPU, "SIM_GPU: SIM_GPU_FATAL is set, aborting");
+        abort();
+    }
+}
+
+void LogInfo(const char *fmt, ...) {
+    char buf[1024];
+    va_list ap;
+    va_start(ap, fmt);
+    SDL_vsnprintf(buf, sizeof buf, fmt, ap);
+    va_end(ap);
+    SDL_LogInfo(SDL_LOG_CATEGORY_GPU, "SIM_GPU: %s", buf);
+}
