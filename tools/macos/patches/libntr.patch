diff --git a/libraries/gx/include/gx_regblock.h b/libraries/gx/include/gx_regblock.h
new file mode 100644
index 0000000..c5f7ffa
--- /dev/null
+++ b/libraries/gx/include/gx_regblock.h
@@ -0,0 +1,96 @@
+#ifndef NITRO_GX_REGBLOCK_H_
+#define NITRO_GX_REGBLOCK_H_
+
+#include <nitro/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifdef SDK_PORT
+
+/* Simulator-only access to a block of DS hardware registers.
+ *
+ * On real hardware a register table (the 2D BG register block, the edge
+ * colour / fog / toon tables, the matrix-result registers, ...) is one
+ * contiguous region, so the SDK clears / copies it with a single DMA or
+ * CPU block transfer rooted at the first register. On the simulator each
+ * register is a separate host global (s_reg_* in sim_vars.c), so a block
+ * transfer rooted at one register walks off the end of that single global
+ * -- a global-buffer-overflow under ASan, and technically UB even though
+ * the simulator lays the globals out in DS offset order so the writes land
+ * on the intended registers.
+ *
+ * These helpers perform the same byte-for-byte writes with explicit
+ * volatile byte loops instead of memcpy/memset. They are marked
+ * no_sanitize("address") because ASan cannot see the register block as
+ * one object; the suppression is narrow (only these three helpers, only
+ * on the simulator) and every call site names the register block it
+ * touches. Do NOT use them for RAM/VRAM buffers, which stay sanitized
+ * through the normal MI_* functions.
+ *
+ * The loops use volatile pointers so the compiler cannot re-fold them
+ * into a memcpy/memset call (whose interceptor would flag the same
+ * access). Fill repeats the low byte of `value`, matching memset, which
+ * is what the MI_* block-fill implementations do on the simulator.
+ */
+static inline __attribute__((no_sanitize("address"))) void GXi_FillRegBlock(void *dest, u32 value, u32 size)
+{
+    volatile u8 *d = (volatile u8 *)dest;
+    u32 i;
+    for (i = 0; i < size; i++) {
+        d[i] = (u8)value;
+    }
+}
+
+static inline __attribute__((no_sanitize("address"))) void GXi_CopyToRegBlock(void *dest, const void *src, u32 size)
+{
+    volatile u8 *d = (volatile u8 *)dest;
+    const u8 *s = (const u8 *)src;
+    u32 i;
+    for (i = 0; i < size; i++) {
+        d[i] = s[i];
+    }
+}
+
+static inline __attribute__((no_sanitize("address"))) void GXi_CopyFromRegBlock(void *dest, const void *src, u32 size)
+{
+    u8 *d = (u8 *)dest;
+    const volatile u8 *s = (const volatile u8 *)src;
+    u32 i;
+    for (i = 0; i < size; i++) {
+        d[i] = s[i];
+    }
+}
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SDK_PORT */
+
+/* Indexed register-block access, e.g. the G2x_ blend/affine helpers, which
+ * write a register pair as one u32 (BLDCNT+BLDALPHA) or a field at a
+ * halfword offset into a register block. The base address names a single
+ * (often u16) register global on the simulator, so `*((vu32 *)addr + n)`
+ * overflows that global under ASan even though the write lands on the
+ * intended following registers. These helpers do the same volatile store
+ * / load at the same byte offset without ASan instrumentation; on real
+ * hardware they compile to the identical access. Use only for DS register
+ * blocks, never for RAM/VRAM. */
+static inline __attribute__((no_sanitize("address"))) void GXi_RegWrite32(uPtr addr, u32 idx, u32 value)
+{
+    *(volatile u32 *)((volatile u8 *)addr + idx * 4) = value;
+}
+
+static inline __attribute__((no_sanitize("address"))) void GXi_RegWrite16(uPtr addr, u32 idx, u16 value)
+{
+    *(volatile u16 *)((volatile u8 *)addr + idx * 2) = value;
+}
+
+static inline __attribute__((no_sanitize("address"))) u16 GXi_RegRead16(uPtr addr, u32 idx)
+{
+    return *(volatile u16 *)((volatile u8 *)addr + idx * 2);
+}
+
+#endif /* NITRO_GX_REGBLOCK_H_ */
