+  u16 *lcdc = (u16 *)s_HW_LCDC_VRAM;
+  int destIdx = (destBank * 0x20000 + destOfs) / 2;
+  int srcBIdx = (destBank * 0x20000 + srcBOfs) / 2;
+
+  // BG views of the destination bank, for games that re-map the captured
+  // bank as a BG (the encounter transition reads it as BG3 DC bitmap).
+  // VRAMCNT A-D: bit7 enable, MST bits0-2 (1=main BG, 4=sub BG for C),
+  // OFS bits3-4 in 128K units (main BG).
+  const u8 vramcnt[4] = {s_reg_GX_VRAMCNT_A, s_reg_GX_VRAMCNT_B, s_reg_GX_VRAMCNT_C, s_reg_GX_VRAMCNT_D};
