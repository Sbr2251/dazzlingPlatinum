diff --git a/libraries/sim/src/sim_g3_GlRenderer.cpp b/libraries/sim/src/sim_g3_GlRenderer.cpp
index 77300c2..ecf6990 100644
--- a/libraries/sim/src/sim_g3_GlRenderer.cpp
+++ b/libraries/sim/src/sim_g3_GlRenderer.cpp
@@ -121,7 +121,24 @@ void GlRenderer::Draw(std::shared_ptr<DrawCall> drawCall) {
             glProgramUniform1fv(mShaderProgramId, fogDensityLoc, 32, drawCall->GetFogDensityTable());
         }
 
+        // Apply this draw call's own cull mode and depth test. PolygonAttrCommand also sets them on the GL state when the command
+        // arrives, but translucent draw calls are deferred to the end of the frame (DrawTransparentItems), so they would otherwise
+        // be drawn with whatever state the frame's last polygon attribute left behind (often GX_CULL_ALL: nothing drawn).
+        const PolygonAttr attr = drawCall->GetPolygonAttr();
+        switch(attr.cullMode) {
+            case GX_CULL_ALL:   glEnable(GL_CULL_FACE); glCullFace(GL_FRONT_AND_BACK); break;
+            case GX_CULL_FRONT: glEnable(GL_CULL_FACE); glCullFace(GL_BACK); break;
+            case GX_CULL_BACK:  glEnable(GL_CULL_FACE); glCullFace(GL_FRONT); break;
+            default:            glDisable(GL_CULL_FACE); break;
+        }
+        glDepthFunc(attr.depthTest ? GL_LEQUAL : GL_LESS);
+        // As on the DS, translucent polygons only update the depth buffer when their attribute asks for it.
+        const bool depthWrite = !drawCall->IsTransparent() || attr.translucentDepth;
+        if(!depthWrite) glDepthMask(GL_FALSE);
+
         glDrawArrays(GL_TRIANGLES, 0, vertsCount);
+
+        if(!depthWrite) glDepthMask(GL_TRUE);
     }
 }
 
