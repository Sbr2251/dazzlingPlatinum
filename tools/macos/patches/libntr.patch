+  bool testFraming = false;
+
+  CachedGateEnv() {
+    bdspZero = EnvIsZero("SIM_FX_BDSP_BATTLE");
+    bdspOne = EnvIsOne("SIM_FX_BDSP_BATTLE");
+    interactiveFxOne = EnvIsOne("SIM_HEADLESS_INTERACTIVE_FX");
+    modelsZero = EnvIsZero("SIM_FX_BDSP_MODELS");
+    modelsOne = EnvIsOne("SIM_FX_BDSP_MODELS");
+    if (const char *ts = std::getenv("SIM_BDSP_TEST_SLOTS"); ts && ts[0] != '\0') {
+      testSlots = ts;
