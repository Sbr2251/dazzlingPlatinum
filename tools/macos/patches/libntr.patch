+#pragma once
+// SDL_GPU foundation for the simulator's renderers. See libraries/sim/src/gpu/README.md.
+#include <simulator/gpu/coords.hpp>
+#include <simulator/gpu/device.hpp>
+#include <simulator/gpu/frame.hpp>
+#include <simulator/gpu/pipeline.hpp>
