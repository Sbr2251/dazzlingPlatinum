+  data.palettes[1] = (const void *)s_HW_OBJ_PLTT;
+  data.palettes[2] = (const void *)s_HW_DB_BG_PLTT;
+  data.palettes[3] = (const void *)s_HW_DB_OBJ_PLTT;
+  unsigned sprites = 0;
+  for (int i = 0; i < 5; i++) sprites += data.spriteCount[i];
+  SIM_Perf_G2(9, data.bgVramSize + data.objVramSize + 1024 + 2048, sprites);
+  return SIM::Render::Get().RenderGpuLayers(data) ? TRUE : FALSE;
+}
