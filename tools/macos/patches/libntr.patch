+#!/usr/bin/env python3
+"""Compile and verify hudhd Metal (macOS + iOS) and SPIR-V shaders,
+emitting subprojects/libntr/libraries/sim/src/render_gpu/generated/hudhd_shaders.h."""
+
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+
+SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
+OUT_HEADER = os.path.normpath(os.path.join(SCRIPT_DIR, "..", "generated", "hudhd_shaders.h"))
+
+HUDHD_VERT_MSL = r"""#include <metal_stdlib>
+using namespace metal;
+
+struct main0_out {
+    float2 vUv [[user(locn0)]];
+    float4 vColorTop [[user(locn1)]];
+    float4 vColorBot [[user(locn2)]];
+    float4 vBorderColor [[user(locn3)]];
+    float2 vRectSize [[user(locn4)]];
+    float4 vParams [[user(locn5)]];
+    float4 gl_Position [[position]];
+};
+
+struct main0_in {
+    float2 inPos [[attribute(0)]];
+    float2 inUv [[attribute(1)]];
+    float4 inColorTop [[attribute(2)]];
+    float4 inColorBot [[attribute(3)]];
+    float4 inBorderColor [[attribute(4)]];
+    float2 inRectSize [[attribute(5)]];
+    float4 inParams [[attribute(6)]];
+};
+
+vertex main0_out main0(main0_in in [[stage_in]]) {
+    main0_out out = {};
+    out.gl_Position = float4(in.inPos, 0.0, 1.0);
+    out.vUv = in.inUv;
+    out.vColorTop = in.inColorTop;
+    out.vColorBot = in.inColorBot;
+    out.vBorderColor = in.inBorderColor;
+    out.vRectSize = in.inRectSize;
+    out.vParams = in.inParams;
+    return out;
+}
+"""
+
+HUDHD_VERT_GLSL = r"""#version 450
+layout(location = 0) in vec2 inPos;
+layout(location = 1) in vec2 inUv;
+layout(location = 2) in vec4 inColorTop;
+layout(location = 3) in vec4 inColorBot;
+layout(location = 4) in vec4 inBorderColor;
+layout(location = 5) in vec2 inRectSize;
+layout(location = 6) in vec4 inParams;
+
+layout(location = 0) out vec2 vUv;
+layout(location = 1) out vec4 vColorTop;
+layout(location = 2) out vec4 vColorBot;
+layout(location = 3) out vec4 vBorderColor;
+layout(location = 4) out vec2 vRectSize;
+layout(location = 5) out vec4 vParams;
+
+void main() {
+    gl_Position = vec4(inPos, 0.0, 1.0);
+    vUv = inUv;
+    vColorTop = inColorTop;
+    vColorBot = inColorBot;
+    vBorderColor = inBorderColor;
+    vRectSize = inRectSize;
+    vParams = inParams;
+}
+"""
+
+HUDHD_FRAG_MSL = r"""#include <metal_stdlib>
+using namespace metal;
+
+struct main0_out {
+    float4 outColor [[color(0)]];
+};
+
+struct main0_in {
+    float2 vUv [[user(locn0)]];
+    float4 vColorTop [[user(locn1)]];
+    float4 vColorBot [[user(locn2)]];
+    float4 vBorderColor [[user(locn3)]];
+    float2 vRectSize [[user(locn4)]];
+    float4 vParams [[user(locn5)]];
+};
+
+static inline float sdRoundBox(float2 p, float2 b, float r) {
+    float2 q = abs(p) - b + float2(r);
+    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
+}
+
+fragment main0_out main0(main0_in in [[stage_in]],
+                         texture2d<float> fontAtlas [[texture(0)]],
+                         sampler fontAtlasSmplr [[sampler(0)]],
+                         texture2d<float> uiAtlas [[texture(1)]],
+                         sampler uiAtlasSmplr [[sampler(1)]]) {
+    main0_out out = {};
+    int mode = int(in.vParams.x + 0.5);
+    if (mode == 3) {
+        float a = fontAtlas.sample(fontAtlasSmplr, in.vUv).a * in.vColorTop.a;
+        if (a <= 0.002) discard_fragment();
+        out.outColor = float4(in.vColorTop.rgb, a);
+        return out;
+    }
+
+    if (mode == 5) {
+        float4 tex = uiAtlas.sample(uiAtlasSmplr, in.vUv);
+        float4 col = tex * in.vColorTop;
+        if (col.a <= 0.002) discard_fragment();
+        out.outColor = col;
+        return out;
+    }
+
+    float2 p = (in.vUv - 0.5) * in.vRectSize;
+    if (mode == 0) {
+        float radius = in.vParams.y;
+        float border = in.vParams.z;
+        float softness = in.vParams.w;
+        if (softness > 0.001) {
+            float2 halfB = max(in.vRectSize * 0.5 - float2(softness), float2(1.0));
+            float d = sdRoundBox(p, halfB, radius);
+            float a = 1.0 - smoothstep(-softness * 0.35, softness, d);
+            out.outColor = float4(in.vColorTop.rgb, in.vColorTop.a * a);
+            return out;
+        }
+        float2 halfB = max(in.vRectSize * 0.5 - float2(0.75), float2(1.0));
+        float d = sdRoundBox(p, halfB, min(radius, min(halfB.x, halfB.y)));
+        float fillAlpha = 1.0 - smoothstep(-0.6, 0.6, d);
+        float4 grad = mix(in.vColorTop, in.vColorBot, clamp(in.vUv.y, 0.0, 1.0));
+        float4 col = grad;
+        if (border > 0.01) {
+            float borderMask = smoothstep(-border - 0.6, -border + 0.6, d);
+            col = mix(grad, in.vBorderColor, borderMask * in.vBorderColor.a);
+        }
+        col.a *= fillAlpha;
+        if (col.a <= 0.002) discard_fragment();
+        out.outColor = col;
+        return out;
+    }
+
+    if (mode == 1) {
+        float radius = in.vParams.y;
+        float border = in.vParams.z;
+        float d = length(p) - radius;
+        float fillAlpha = 1.0 - smoothstep(-0.6, 0.6, d);
+        float4 grad = mix(in.vColorTop, in.vColorBot, clamp(in.vUv.y, 0.0, 1.0));
+        float4 col = grad;
+        if (border > 0.01) {
+            float borderMask = smoothstep(-border - 0.6, -border + 0.6, d);
+            col = mix(grad, in.vBorderColor, borderMask * in.vBorderColor.a);
+        }
+        col.a *= fillAlpha;
+        if (col.a <= 0.002) discard_fragment();
+        out.outColor = col;
+        return out;
+    }
+
+    if (mode == 2) {
+        float radius = in.vParams.y;
+        float halfLen = max(in.vRectSize.x * 0.5 - radius - 0.75, 0.0);
+        float2 q = float2(max(abs(p.x) - halfLen, 0.0), p.y);
+        float d = length(q) - radius;
+        float a = 1.0 - smoothstep(-0.6, 0.6, d);
+        float4 grad = mix(in.vColorTop, in.vColorBot, clamp(in.vUv.x, 0.0, 1.0));
+        grad.a *= a;
+        if (grad.a <= 0.002) discard_fragment();
+        out.outColor = grad;
+        return out;
+    }
+
+    out.outColor = mix(in.vColorTop, in.vColorBot, clamp(in.vUv.y, 0.0, 1.0));
+    return out;
+}
+"""
+
+HUDHD_FRAG_GLSL = r"""#version 450
+layout(location = 0) in vec2 vUv;
+layout(location = 1) in vec4 vColorTop;
+layout(location = 2) in vec4 vColorBot;
+layout(location = 3) in vec4 vBorderColor;
+layout(location = 4) in vec2 vRectSize;
+layout(location = 5) in vec4 vParams;
+
+layout(set = 2, binding = 0) uniform sampler2D fontAtlas;
+layout(set = 2, binding = 1) uniform sampler2D uiAtlas;
+
+layout(location = 0) out vec4 outColor;
+
+float sdRoundBox(vec2 p, vec2 b, float r) {
+    vec2 q = abs(p) - b + vec2(r);
+    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
+}
+
+void main() {
+    int mode = int(vParams.x + 0.5);
+    if (mode == 3) {
+        float a = texture(fontAtlas, vUv).a * vColorTop.a;
+        if (a <= 0.002) discard;
+        outColor = vec4(vColorTop.rgb, a);
+        return;
+    }
+
+    if (mode == 5) {
+        vec4 tex = texture(uiAtlas, vUv);
+        vec4 col = tex * vColorTop;
+        if (col.a <= 0.002) discard;
+        outColor = col;
+        return;
+    }
+
+    vec2 p = (vUv - 0.5) * vRectSize;
+    if (mode == 0) {
+        float radius = vParams.y;
+        float border = vParams.z;
+        float softness = vParams.w;
+        if (softness > 0.001) {
+            vec2 halfB = max(vRectSize * 0.5 - vec2(softness), vec2(1.0));
+            float d = sdRoundBox(p, halfB, radius);
+            float a = 1.0 - smoothstep(-softness * 0.35, softness, d);
+            outColor = vec4(vColorTop.rgb, vColorTop.a * a);
+            return;
+        }
+        vec2 halfB = max(vRectSize * 0.5 - vec2(0.75), vec2(1.0));
+        float d = sdRoundBox(p, halfB, min(radius, min(halfB.x, halfB.y)));
+        float fillAlpha = 1.0 - smoothstep(-0.6, 0.6, d);
+        vec4 grad = mix(vColorTop, vColorBot, clamp(vUv.y, 0.0, 1.0));
+        vec4 col = grad;
+        if (border > 0.01) {
+            float borderMask = smoothstep(-border - 0.6, -border + 0.6, d);
+            col = mix(grad, vBorderColor, borderMask * vBorderColor.a);
+        }
+        col.a *= fillAlpha;
+        if (col.a <= 0.002) discard;
+        outColor = col;
+        return;
+    }
+
+    if (mode == 1) {
+        float radius = vParams.y;
+        float border = vParams.z;
+        float d = length(p) - radius;
+        float fillAlpha = 1.0 - smoothstep(-0.6, 0.6, d);
+        vec4 grad = mix(vColorTop, vColorBot, clamp(vUv.y, 0.0, 1.0));
+        vec4 col = grad;
+        if (border > 0.01) {
+            float borderMask = smoothstep(-border - 0.6, -border + 0.6, d);
+            col = mix(grad, vBorderColor, borderMask * vBorderColor.a);
+        }
+        col.a *= fillAlpha;
+        if (col.a <= 0.002) discard;
+        outColor = col;
+        return;
+    }
+
+    if (mode == 2) {
+        float radius = vParams.y;
+        float halfLen = max(vRectSize.x * 0.5 - radius - 0.75, 0.0);
+        vec2 q = vec2(max(abs(p.x) - halfLen, 0.0), p.y);
+        float d = length(q) - radius;
+        float a = 1.0 - smoothstep(-0.6, 0.6, d);
+        vec4 grad = mix(vColorTop, vColorBot, clamp(vUv.x, 0.0, 1.0));
+        grad.a *= a;
+        if (grad.a <= 0.002) discard;
+        outColor = grad;
+        return;
+    }
+
+    outColor = mix(vColorTop, vColorBot, clamp(vUv.y, 0.0, 1.0));
+}
+"""
+
+SHADERS = [
+    ("hudhd_vert", "vert", "SDL_GPU_SHADERSTAGE_VERTEX", HUDHD_VERT_GLSL, HUDHD_VERT_MSL, 0, 0, 0, 0),
+    ("hudhd_frag", "frag", "SDL_GPU_SHADERSTAGE_FRAGMENT", HUDHD_FRAG_GLSL, HUDHD_FRAG_MSL, 2, 0, 0, 0),
+]
+
+
+def c_bytes(data: bytes, per_line: int = 24) -> str:
+    return "\n".join(
+        "    " + ",".join(f"0x{b:02x}" for b in data[i:i + per_line]) + ","
+        for i in range(0, len(data), per_line)
+    )
+
+
+def run(cmd):
+    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    if p.returncode != 0:
+        sys.stderr.write(f"FAILED: {' '.join(cmd)}\n")
+        sys.stderr.write(p.stdout.decode(errors="replace"))
+        sys.stderr.write(p.stderr.decode(errors="replace"))
+        sys.exit(1)
+    return p.stdout
+
+
+def main():
+    glslang = shutil.which("glslangValidator") or os.path.expanduser("~/.local/bin/glslangValidator")
+    if not os.path.isfile(glslang):
+        sys.exit("glslangValidator not found")
+
+    lines = [
+        "// Native Metal (MSL) and Vulkan (SPIR-V) shaders for the BDSP HD battle HUD.",
+        "// Generated by shaders/build_hudhd_shaders.py.",
+        "// Verified against xcrun metal (-std=macos-metal2.1 & ios-metal2.1 -Wall -Werror) and glslangValidator.",
+        "#pragma once",
+        "#include <simulator/gpu/shader_blob.hpp>",
+        "",
+        "namespace SIM::Gpu::Shaders {",
+        "",
+    ]
+
+    with tempfile.TemporaryDirectory() as tmp:
+        for name, stage, sdl_stage, glsl_src, msl_src, n_samp, n_stex, n_sbuf, n_ubo in SHADERS:
+            glsl_path = os.path.join(tmp, f"{name}.{stage}")
+            spv_path = os.path.join(tmp, f"{name}.spv")
+            msl_path = os.path.join(tmp, f"{name}.metal")
+            mac_air = os.path.join(tmp, f"{name}.mac.air")
+            ios_air = os.path.join(tmp, f"{name}.ios.air")
+
+            with open(glsl_path, "w") as f:
+                f.write(glsl_src)
+            with open(msl_path, "w") as f:
+                f.write(msl_src)
+
+            run([glslang, "-V", "--target-env", "vulkan1.0", "-S", stage, "-o", spv_path, glsl_path])
+            run(["xcrun", "-sdk", "macosx", "metal", "-std=macos-metal2.1", "-Wall", "-Werror", "-c", msl_path, "-o", mac_air])
+            run(["xcrun", "-sdk", "iphoneos", "metal", "-std=ios-metal2.1", "-Wall", "-Werror", "-c", msl_path, "-o", ios_air])
+
+            with open(spv_path, "rb") as f:
+                spv = f.read()
+            msl = msl_src.encode("utf-8")
+
+            print(f"OK {name}: SPIR-V={len(spv)}B, MSL={len(msl)}B (macOS + iOS verified)")
+            lines.append(f"inline constexpr unsigned char {name}_spirv[] = {{")
+            lines.append(c_bytes(spv))
+            lines.append("};")
+            lines.append("")
+            lines.append(f"inline constexpr unsigned char {name}_msl[] = {{")
+            lines.append(c_bytes(msl + b"\0"))
+            lines.append("};")
+            lines.append("")
+            lines.append(f"inline constexpr SIM::Gpu::ShaderBlob {name} = {{")
+            lines.append(f'    "{name}", {sdl_stage},')
+            lines.append(f"    {name}_spirv, sizeof({name}_spirv),")
+            lines.append(f"    {name}_msl, sizeof({name}_msl) - 1,")
+            lines.append(f"    {name}_msl, sizeof({name}_msl) - 1,")
+            lines.append(f"    {n_samp}, {n_stex}, {n_sbuf}, {n_ubo}")
+            lines.append("};")
+            lines.append("")
+
+    lines.append("} // namespace SIM::Gpu::Shaders")
+    lines.append("")
+
+    os.makedirs(os.path.dirname(OUT_HEADER), exist_ok=True)
+    with open(OUT_HEADER, "w") as f:
