+++ b/libraries/sim/include/imgui_impl_sdlgpu3_shaders_ios.h
@@ -0,0 +1,84 @@
+#pragma once
+// ios-build hook: ImGui SDLGPU3 shaders as MSL source (generated from the vendored
+// SPIR-V with spirv-cross --msl-version 20100). The vendored metallib blob is built
+// for macOS and rejected on iOS; SDL_GPU_SHADERFORMAT_MSL compiles this at runtime.
+static const char imgui_msl_vertex[] =
+"#include <metal_stdlib>\n"
+"#include <simd/simd.h>\n"
+"\n"
+"using namespace metal;\n"
+"\n"
+"struct _9\n"
+"{\n"
+"    float4 Color;\n"
+"    float2 UV;\n"
+"};\n"
+"\n"
+"struct uPushConstant\n"
+"{\n"
+"    float2 uScale;\n"
+"    float2 uTranslate;\n"
+"};\n"
+"\n"
+"struct main0_out\n"
+"{\n"
+"    float4 Out_Color [[user(locn0)]];\n"
+"    float2 Out_UV [[user(locn1)]];\n"
+"    float4 gl_Position [[position]];\n"
+"};\n"
+"\n"
+"struct main0_in\n"
+"{\n"
+"    float2 aPos [[attribute(0)]];\n"
+"    float2 aUV [[attribute(1)]];\n"
+"    float4 aColor [[attribute(2)]];\n"
+"};\n"
+"\n"
+"vertex main0_out main0(main0_in in [[stage_in]], constant uPushConstant& pc [[buffer(0)]])\n"
+"{\n"
+"    main0_out out = {};\n"
+"    _9 Out = {};\n"
+"    Out.Color = in.aColor;\n"
+"    Out.UV = in.aUV;\n"
+"    out.gl_Position = float4((in.aPos * pc.uScale) + pc.uTranslate, 0.0, 1.0);\n"
+"    out.gl_Position.y *= (-1.0);\n"
+"    out.Out_Color = Out.Color;\n"
+"    out.Out_UV = Out.UV;\n"
+"    return out;\n"
+"}\n"
+"\n"
+"";
+static const char imgui_msl_fragment[] =
+"#include <metal_stdlib>\n"
+"#include <simd/simd.h>\n"
+"\n"
+"using namespace metal;\n"
+"\n"
+"struct _11\n"
+"{\n"
+"    float4 Color;\n"
+"    float2 UV;\n"
+"};\n"
+"\n"
+"struct main0_out\n"
+"{\n"
+"    float4 fColor [[color(0)]];\n"
+"};\n"
+"\n"
+"struct main0_in\n"
+"{\n"
+"    float4 In_Color [[user(locn0)]];\n"
+"    float2 In_UV [[user(locn1)]];\n"
+"};\n"
+"\n"
+"fragment main0_out main0(main0_in in [[stage_in]], texture2d<float> sTexture [[texture(0)]], sampler sTextureSmplr [[sampler(0)]])\n"
+"{\n"
+"    main0_out out = {};\n"
+"    _11 In = {};\n"
+"    In.Color = in.In_Color;\n"
+"    In.UV = in.In_UV;\n"
+"    out.fColor = In.Color * sTexture.sample(sTextureSmplr, In.UV);\n"
+"    return out;\n"
+"}\n"
+"\n"
+"";
