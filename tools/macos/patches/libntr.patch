diff --git a/include/nitro/hw/X86/mmap_global.h b/include/nitro/hw/X86/mmap_global.h
index 3be08a2..89915a2 100644
--- a/include/nitro/hw/X86/mmap_global.h
+++ b/include/nitro/hw/X86/mmap_global.h
@@ -46,17 +46,34 @@ extern u8 s_HW_MAIN_MEM_EX[0x800000];
 #define HW_IOREG_END            0x05000000
 #define HW_REG_BASE             HW_IOREG        // alias
 //----------------------------- VRAMs
+
+// The DS's palette RAM is one block: BG then OBJ palettes for the main screen, then the sub screen's. HW_PLTT and HW_DB_PLTT span two
+// of them (HW_PLTT_END is HW_OBJ_PLTT_END), so they must be adjacent. Separate arrays were adjacent only by the linker's choice
+// (GNU ld keeps definition order; Apple's ld does not), so on macOS they are fields of one struct.
+#ifdef SDK_BUILD_MACOS
+#define SDK_HW_PLTT_BLOCK 1
+typedef struct SIM_HWPlttBlock { u8 bg[0x200]; u8 obj[0x200]; u8 db_bg[0x200]; u8 db_obj[0x200]; } SIM_HWPlttBlock;
+extern SIM_HWPlttBlock s_HW_PLTT_BLOCK;
+#define s_HW_BG_PLTT     (s_HW_PLTT_BLOCK.bg)
+#define s_HW_OBJ_PLTT    (s_HW_PLTT_BLOCK.obj)
+#define s_HW_DB_BG_PLTT  (s_HW_PLTT_BLOCK.db_bg)
+#define s_HW_DB_OBJ_PLTT (s_HW_PLTT_BLOCK.db_obj)
+#endif
 //#define HW_BG_PLTT              0x05000000
 //#define HW_BG_PLTT_END          0x05000200
 //#define HW_BG_PLTT_SIZE         (HW_BG_PLTT_END-HW_BG_PLTT)
+#ifndef SDK_HW_PLTT_BLOCK
 extern u8 s_HW_BG_PLTT[0x200];
+#endif
 #define HW_BG_PLTT              ((u64)s_HW_BG_PLTT)
 #define HW_BG_PLTT_END          ((u64)s_HW_BG_PLTT + 0x200)
 #define HW_BG_PLTT_SIZE         (HW_BG_PLTT_END-HW_BG_PLTT)
 //#define HW_OBJ_PLTT             0x05000200
 //#define HW_OBJ_PLTT_END         0x05000400
 //#define HW_OBJ_PLTT_SIZE        (HW_OBJ_PLTT_END-HW_OBJ_PLTT)
+#ifndef SDK_HW_PLTT_BLOCK
 extern u8 s_HW_OBJ_PLTT[0x200];
+#endif
 #define HW_OBJ_PLTT             ((u64)s_HW_OBJ_PLTT)
 #define HW_OBJ_PLTT_END         ((u64)s_HW_OBJ_PLTT + 0x200)
 #define HW_OBJ_PLTT_SIZE        (HW_OBJ_PLTT_END-HW_OBJ_PLTT)
@@ -67,14 +84,18 @@ extern u8 s_HW_OBJ_PLTT[0x200];
 //#define HW_DB_BG_PLTT           0x05000400
 //#define HW_DB_BG_PLTT_END       0x05000600
 //#define HW_DB_BG_PLTT_SIZE      (HW_DB_BG_PLTT_END-HW_DB_BG_PLTT)
+#ifndef SDK_HW_PLTT_BLOCK
 extern u8 s_HW_DB_BG_PLTT[0x200];
+#endif
 #define HW_DB_BG_PLTT             ((u64)s_HW_DB_BG_PLTT)
 #define HW_DB_BG_PLTT_END         ((u64)s_HW_DB_BG_PLTT + 0x200)
 #define HW_DB_BG_PLTT_SIZE      (HW_DB_BG_PLTT_END-HW_DB_BG_PLTT)
 //#define HW_DB_OBJ_PLTT          0x05000600
 //#define HW_DB_OBJ_PLTT_END      0x05000800
 //#define HW_DB_OBJ_PLTT_SIZE     (HW_DB_OBJ_PLTT_END-HW_DB_OBJ_PLTT)
