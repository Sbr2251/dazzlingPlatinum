+#pragma once
+
+// BDSP-style HD-2D / 3D Battle Arena & Skinned Pokémon GPU Renderer (Metal / Vulkan via SIM::Gpu).
+// Renders either an extracted glTF 2.0 (.glb) battle arena or procedural .b3d fallback, plus
+// skinned animated glTF 2.0 (.glb) Pokémon models with directional shadow-map casting, 2-band
+// BDSP toon lighting + hemisphere ambient + Fresnel rim + distance fog into Scene3D.
+
+#include "fx_battle3d_gltf.hpp"
+
+#include <simulator/gpu/gpu.hpp>
+#include <simulator/sim_battle3d.h>
+
+#include <SDL3/SDL.h>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace SIM::Render {
+
+class FxBattle3D {
+ public:
+  FxBattle3D() = default;
+  ~FxBattle3D();
+  FxBattle3D(const FxBattle3D &) = delete;
+  FxBattle3D &operator=(const FxBattle3D &) = delete;
+
+  // True when the game has an active 3D battle scene (alpha > 0.001) and the
+  // headless feature gate permits rendering it.
+  bool IsActive() const;
+
+  // Snapshots thread-safe frame state, lazy-loads the biome arena (.glb or .b3d)
+  // and any active 3D Pokémon .glb models, evaluates skeletal poses, queues GPU
+  // uploads, and runs Pass 1 (1024x1024 directional shadow map). Must be called
+  // OUTSIDE an open render pass. Returns true if RenderScene should run.
+  bool PrepareAndRenderShadow(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+                              SIM::Gpu::Phase phase);
+
+  // Runs Pass 2 (sky dome + 3D arena + skinned 3D Pokémon models with BDSP toon
+  // lighting/PCF shadows/rim/fog mapped to depth [0.960, 0.992]) and Pass 3
+  // (soft sun-angled ground shadow decals for 2D-sprite battlers) inside the
+  // currently open Scene3D pass. Restores `viewport` before returning.
+  void RenderScene(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+                   const SDL_GPUViewport &viewport,
+                   SDL_GPUTextureFormat colorFormat, bool hasDepth);
+
+  void Release();
+
+ private:
+  struct LoadedSubmesh {
+    std::uint32_t firstIndex = 0;
+    std::uint32_t indexCount = 0;
+    std::int32_t textureIndex = -1;
+    std::uint32_t flags = 0;
+    float roughness = 0.5f;
+    float fogFactor = 1.0f;
+    bool isSky = false;
+  };
+
+  struct LoadedTexture {
+    SIM::Gpu::Texture tex;
+    std::uint32_t flags = 0;
+  };
+
+  struct LoadedBiome {
+    bool attempted = false;
+    bool valid = false;
+    SDL_GPUBuffer *vertexBuffer = nullptr;
+    SDL_GPUBuffer *indexBuffer = nullptr;
+    std::uint32_t numVertices = 0;
+    std::uint32_t numIndices = 0;
+    std::vector<LoadedTexture> textures;
+    std::vector<LoadedSubmesh> submeshes;
+  };
+
+  struct CachedSkinPalette {
+    std::int32_t skinIndex = -1;
+    std::uint32_t jointCount = 0;
+    float joints[kMaxGltfJoints * 16] = {};
+  };
+
+  struct LatchedBattler {
+    const GltfModel *model = nullptr;
+    float modelMat[16] = {};
+    float combinedAlpha = 0.0f;
+    float flashAmount = 0.0f;
+    std::vector<float> nodeWorldMats;
+    GltfPoseScratch poseScratch;
+    std::vector<CachedSkinPalette> skinPalettes;
+  };
+
+  struct CachedModelEntry {
+    std::unique_ptr<GltfModel> model;
+    std::uint64_t lastUsedFrame = 0;
+  };
+
+  bool EnsureResources(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame);
+  void PrewarmPipelines(SIM::Gpu::Device &device);
+  void DrainCompletedLoads(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame);
+  void EvictLruModelsIfNeeded(SIM::Gpu::Device &device);
+  void ReleaseNonActiveArenas(SIM::Gpu::Device &device);
+  LoadedBiome *LoadBiome(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame, int biomeId);
+  bool LoadBiomeFile(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+                     const std::string &path, LoadedBiome &out);
+  GltfArena *LoadGltfArenaSlot(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame, int biomeId);
+  const GltfModel *LoadMonModel(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+                                int species, int form, int isShiny);
+  const GltfModel *LoadActorModel(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame, int kind);
+
+  void RenderShadowPass(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+                        SIM::Gpu::Phase phase);
+  void RenderArenaSubmeshes(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+                            const SDL_GPUViewport &skyVp, const SDL_GPUViewport &worldVp,
+                            SDL_GPUTextureFormat colorFormat, bool hasDepth,
+                            const float viewProj[16]);
+  void RenderSkinnedBattlers(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+                             const SDL_GPUViewport &worldVp,
+                             SDL_GPUTextureFormat colorFormat, bool hasDepth,
+                             const float viewProj[16]);
+  void RenderShadowDecals(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+                          const SDL_GPUViewport &worldViewport,
+                          SDL_GPUTextureFormat colorFormat, bool hasDepth,
+                          const float viewProj[16], const float shadowTint[3]);
+  void RenderBurstVfx(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+                      const SDL_GPUViewport &worldViewport,
+                      SDL_GPUTextureFormat colorFormat, bool hasDepth,
+                      const float viewProj[16]);
+
+  SIM::Gpu::Device *mDevice = nullptr;
+  SIM::Gpu::Texture mShadowMap;
+  SIM::Gpu::Texture mStaticShadowMap;
+  SIM::Gpu::Texture mWhiteDummy;
