diff --git a/include/simulator/gpu/pipeline.hpp b/include/simulator/gpu/pipeline.hpp
new file mode 100644
index 0000000..7b9c8c8
--- /dev/null
+++ b/include/simulator/gpu/pipeline.hpp
@@ -0,0 +1,84 @@
+#pragma once
+// Graphics pipelines keyed by a small value struct. SDL_GPU bakes into a pipeline what GL sets as
+// dynamic state (cull mode, depth test/compare/write, blending, target formats), so a renderer
+// describes each draw's state with a PipelineKey and asks the cache for the matching pipeline.
+// Viewport, scissor, blend constants and stencil reference stay dynamic (set on the pass).
+
+#include <SDL3/SDL.h>
+#include <simulator/gpu/shader_blob.hpp>
+#include <cstddef>
+#include <unordered_map>
+
+namespace SIM::Gpu {
+
+class Device;
+
+constexpr Uint32 kMaxVertexAttributes = 8;
+
+struct VertexAttribute {
+    Uint32 location = 0;                                            // GLSL layout(location = n)
+    SDL_GPUVertexElementFormat format = SDL_GPU_VERTEXELEMENTFORMAT_INVALID;
+    Uint32 offset = 0;                                              // bytes from the vertex start
+    bool operator==(const VertexAttribute &) const = default;
+};
+
+// One interleaved vertex buffer at slot 0. stride 0 / no attributes = no vertex input
+// (shaders that build vertices from gl_VertexIndex).
+struct VertexLayout {
+    Uint32 stride = 0;
+    Uint32 numAttributes = 0;
+    VertexAttribute attributes[kMaxVertexAttributes] = {};
+    VertexLayout &Add(Uint32 location, SDL_GPUVertexElementFormat format, Uint32 offset) {
+        if (numAttributes < kMaxVertexAttributes) attributes[numAttributes++] = { location, format, offset };
+        return *this;
+    }
+    bool operator==(const VertexLayout &) const = default;
+};
+
+enum class Blend : Uint8 {
+    Opaque,         // no blending
+    Alpha,          // GL glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA), applied to alpha too
+    Premultiplied,  // ONE, ONE_MINUS_SRC_ALPHA
+    Additive,       // ONE, ONE
+};
+
+struct PipelineKey {
+    const ShaderBlob *vertex = nullptr;
+    const ShaderBlob *fragment = nullptr;
+    VertexLayout layout;
+    SDL_GPUPrimitiveType primitive = SDL_GPU_PRIMITIVETYPE_TRIANGLELIST;
+    SDL_GPUCullMode cull = SDL_GPU_CULLMODE_NONE;
+    SDL_GPUFrontFace frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+    bool depthTest = false;
+    bool depthWrite = false;  // ignored (off) when depthTest is false, as in SDL_GPU and GL
+    SDL_GPUCompareOp depthCompare = SDL_GPU_COMPAREOP_LESS;
+    Blend blend = Blend::Opaque;
+    Uint8 colorWriteMask = 0xF;  // SDL_GPU_COLORCOMPONENT_* bits
+    SDL_GPUTextureFormat colorFormat = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;  // INVALID: no colour target
+    SDL_GPUTextureFormat depthFormat = SDL_GPU_TEXTUREFORMAT_INVALID;         // INVALID: no depth target
+    bool operator==(const PipelineKey &) const = default;
+};
+
+struct PipelineKeyHash {
+    size_t operator()(const PipelineKey &k) const;
+};
+
+class PipelineCache {
+public:
+    explicit PipelineCache(Device &device) : mDevice(device) {}
+    ~PipelineCache();
+    PipelineCache(const PipelineCache &) = delete;
+    PipelineCache &operator=(const PipelineCache &) = delete;
+
+    // Returns the pipeline for this state, creating it on first use; nullptr (logged) on failure.
+    // The pointer stays valid until Clear() or device destruction.
+    SDL_GPUGraphicsPipeline *Get(const PipelineKey &key);
+    size_t Size() const { return mPipelines.size(); }
+    void Clear();
+
+private:
+    Device &mDevice;
+    std::unordered_map<PipelineKey, SDL_GPUGraphicsPipeline *, PipelineKeyHash> mPipelines;
+};
+
+} // namespace SIM::Gpu
diff --git a/include/simulator/gpu/readback.hpp b/include/simulator/gpu/readback.hpp
new file mode 100644
index 0000000..7408977
--- /dev/null
+++ b/include/simulator/gpu/readback.hpp
@@ -0,0 +1,68 @@
+#pragma once
+// Per-frame texture readback with bounded cost (display capture can run every frame).
+//
+// Synchronous Device::ReadbackRGBA8 stalls the CPU until the GPU finishes the
+// download, which costs a full pipeline drain on capture frames. A ReadbackRing
+// instead records the download on its own command buffer at the end of frame N
+// (Request, after Frame::End) and hands the pixels back at a fixed later point
+// (Collect, typically at the start of frame N+1 or N+2), so the GPU keeps
+// working while the CPU runs the next frame. The ring holds `slots` downloads
+// in flight (default 3, one per frame in flight plus one); Request blocks only
+// when the ring is full, waiting for the oldest download to finish, and a
+// request whose result was never collected is discarded when its slot is
+// reused (Collect then returns false for that token).
+//
+// The texture must stay alive until its result is collected. The download
+// runs on a separate command buffer, so it sees the texture as of the last
+// submitted frame; nothing about the frame in progress is read.
+// Collect returns RGBA8 rows, top row first, swapping R/B for BGRA formats
+// exactly like Device::ReadbackRGBA8.
+
+#include <SDL3/SDL.h>
+#include <cstdint>
+#include <vector>
+
+namespace SIM::Gpu {
+
+class Device;
+
+class ReadbackRing {
+public:
+    explicit ReadbackRing(Device &device, Uint32 slots = 3);
+    ~ReadbackRing();
+    ReadbackRing(const ReadbackRing &) = delete;
+    ReadbackRing &operator=(const ReadbackRing &) = delete;
+
+    // Records a download of a region of `texture`. Returns a token (0 on
+    // failure) to pass to Collect. Call after the frame that produced the
+    // texture has ended.
+    Uint64 Request(SDL_GPUTexture *texture, SDL_GPUTextureFormat format, Uint32 x, Uint32 y, Uint32 w, Uint32 h);
+    Uint64 Request(SDL_GPUTexture *texture, SDL_GPUTextureFormat format, Uint32 w, Uint32 h) {
+        return Request(texture, format, 0, 0, w, h);
+    }
+    // Collects a requested result into `out` (RGBA8, top-down). With wait =
+    // false it returns false and leaves `out` untouched when the download has
+    // not finished yet; with wait = true it blocks until it has. Returns false
+    // (logged) for an unknown or discarded token and on GPU failure.
+    bool Collect(Uint64 token, std::vector<Uint8> &out, bool wait);
+    bool HasOutstanding() const;
+    Uint32 Slots() const { return (Uint32)mSlots.size(); }
+
+private:
+    struct Slot {
+        SDL_GPUTransferBuffer *buffer = nullptr;
+        Uint32 bufferSize = 0;
+        SDL_GPUFence *fence = nullptr;
+        Uint64 token = 0;
+        Uint32 bytes = 0;
+        SDL_GPUTextureFormat format = SDL_GPU_TEXTUREFORMAT_INVALID;
+        bool swapRB = false;
+    };
+    void DiscardSlot(Slot &slot);
+    Device &mDevice;
+    std::vector<Slot> mSlots;
+    Uint64 mNextToken = 1;
+    Uint32 mNextSlot = 0;
+};
+
+} // namespace SIM::Gpu
diff --git a/include/simulator/gpu/shader_blob.hpp b/include/simulator/gpu/shader_blob.hpp
new file mode 100644
index 0000000..0353b5c
--- /dev/null
+++ b/include/simulator/gpu/shader_blob.hpp
@@ -0,0 +1,26 @@
+#pragma once
+// One shader stage compiled offline for every SDL_GPU backend this project ships.
+// Instances are generated by libraries/sim/tools/gpu_shaderc.py into <name>.vert.h / <name>.frag.h
+// (namespace SIM::Gpu::Shaders) and passed to SIM::Gpu::Device::Shader().
+
+#include <SDL3/SDL.h>
+#include <cstddef>
+
+namespace SIM::Gpu {
+
+struct ShaderBlob {
+    const char *name;                 // C identifier, also used as the debug name
+    SDL_GPUShaderStage stage;
+    const unsigned char *spirv;       // SPIR-V module, entry point "main" (Vulkan)
+    size_t spirvSize;
+    const unsigned char *mslMacos;    // MSL source, entry point "main0" (Metal on macOS)
+    size_t mslMacosSize;              // without the terminating NUL
+    const unsigned char *mslIos;      // MSL source for iOS/tvOS (may alias mslMacos)
+    size_t mslIosSize;
+    Uint32 numSamplers;               // reflection-derived counts for SDL_GPUShaderCreateInfo
+    Uint32 numStorageTextures;
+    Uint32 numStorageBuffers;
+    Uint32 numUniformBuffers;
+};
+
+} // namespace SIM::Gpu
diff --git a/include/simulator/gpu/std140.hpp b/include/simulator/gpu/std140.hpp
new file mode 100644
index 0000000..2b69977
--- /dev/null
+++ b/include/simulator/gpu/std140.hpp
@@ -0,0 +1,44 @@
+#pragma once
+// C++ mirrors for std140 uniform blocks (the only layout SDL_GPU uniform buffers accept).
+//
+// std140 rules that bite when porting loose GL uniforms into a block:
+//  - every array element is padded to 16 bytes: `int a[4]` and `float f[32]` take 64 and 512 bytes;
+//    mirror them with Std140Array<int, 4> / Std140Array<float, 32>, or pack scalars four to a
+//    vec4/ivec4 in the shader (`vec4 f[8]`, read as f[i >> 2][i & 3]) and use plain C arrays;
+//  - vec3 is aligned to 16 bytes but only 12 long: a following scalar fills its 4th lane;
+//  - vec2/ivec2 align to 8, vec4/ivec4/mat4 columns to 16, a struct to 16;
+//  - the block size is rounded up to 16.
+// static_assert the offsets of every member against the GLSL declaration (the generated
+// reflection JSON from gpu_shaderc.py --keep lists them).
+
+#include <cstddef>
+#include <cstdint>
+
+namespace SIM::Gpu {
+
+// One std140 array element: a scalar or vector padded out to 16 bytes.
+template <typename T>
+struct alignas(16) Std140Element {
+    static_assert(sizeof(T) <= 16, "std140 array elements are at most one vec4");
+    T value;
+};
+
+template <typename T, size_t N>
+struct alignas(16) Std140Array {
+    Std140Element<T> items[N];
+    T &operator[](size_t i) { return items[i].value; }
+    const T &operator[](size_t i) const { return items[i].value; }
+    static constexpr size_t size() { return N; }
+    // Copy N tightly packed values in (e.g. a 32-float fog table).
+    void Assign(const T *src) { for (size_t i = 0; i < N; i++) items[i].value = src[i]; }
+};
+
+struct alignas(16) Std140Vec4 { float x, y, z, w; };
+struct alignas(16) Std140IVec4 { int32_t x, y, z, w; };
+struct alignas(8) Std140Vec2 { float x, y; };
+struct alignas(8) Std140IVec2 { int32_t x, y; };
+// vec3 has no wrapper type: a C++ type aligned to 16 would also be 16 long and push the next
+// member out of the vec3's 4th lane. Declare it as `alignas(16) float v[3];` instead, so a
+// following `float` lands at +12 exactly as in std140.
+
+} // namespace SIM::Gpu
diff --git a/include/simulator/gpu/texture.hpp b/include/simulator/gpu/texture.hpp
new file mode 100644
index 0000000..f3d0a09
--- /dev/null
+++ b/include/simulator/gpu/texture.hpp
@@ -0,0 +1,142 @@
+#pragma once
+// Textures, render targets and samplers.
+//
+// Sampler state lives in SDL_GPUSampler objects bound next to each texture at draw time; a texture
+// has no wrap or filter state of its own (GL's glTexParameteri has no equivalent). Ask the
+// SamplerCache for the combination a draw needs.
+//
+// GL_CLAMP_TO_BORDER has no SDL_GPU address mode (Metal on iOS lacks border colours). For the
+// DS "no repeat" case (transparent outside the texture) sample with CLAMP_TO_EDGE and, in the
+// fragment shader, return the border colour when the coordinate is outside [0, 1):
+//     if (any(lessThan(uv, vec2(0.0))) || any(greaterThanEqual(uv, vec2(1.0)))) c = vec4(0.0);
+// Do the test per axis that clamps (repeat/mirror axes keep their wrap mode in the sampler).
+// With NEAREST filtering this matches GL exactly; with LINEAR the edge texels blend toward the
+// edge colour instead of the border colour.
+
+#include <SDL3/SDL.h>
+#include <unordered_map>
+
+namespace SIM::Gpu {
+
+class Device;
+
+struct TextureDesc {
+    Uint32 width = 0;
+    Uint32 height = 0;
+    SDL_GPUTextureFormat format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+    SDL_GPUTextureUsageFlags usage = SDL_GPU_TEXTUREUSAGE_SAMPLER;
+    Uint32 layers = 1;
+    Uint32 levels = 1;
+    const char *name = nullptr;  // debug name (must outlive the texture)
+
+    // Sampled RGBA8 (CPU-decoded DS textures, palettes as colours, UI images).
+    static TextureDesc Rgba8(Uint32 w, Uint32 h, const char *name = nullptr);
+    // Integer data textures (VRAM bytes, OAM/palette words). SDL_GPU has no
+    // sampled-integer path: SDL forbids SDL_GPU_TEXTUREUSAGE_SAMPLER on
+    // integer formats, so these are storage textures, declared in GLSL as
+    //   layout(set = 2, binding = N, r8ui) readonly uniform uimage2D t;
+    // (r16ui for R16Uint), read with imageLoad and bound with
+    // Frame::BindVertexStorageTexture / BindFragmentStorageTexture. There is
+    // no texelFetch / usampler2D path for them.
+    // WARNING: storage textures crash lavapipe (Mesa 26.1.1) on SDL 3.4.16 in
+    // every variant tried (R8/R16/R32_UINT, RGBA8, with and without
+    // COMPUTE_STORAGE_WRITE), so they are not verified on Linux. Prefer a
+    // storage buffer (Frame::BindFragmentStorageBuffer) for integer data:
+    // that path is what the self-test covers everywhere. Storage textures
+    // are verified on Metal (exact pixels, self-test case
+    // integer-storage-texture, MSL only).
+    static TextureDesc R8Uint(Uint32 w, Uint32 h, const char *name = nullptr);
+    static TextureDesc R16Uint(Uint32 w, Uint32 h, const char *name = nullptr);
+    // Colour render target that can also be sampled and read back.
+    static TextureDesc ColorTarget(Uint32 w, Uint32 h, SDL_GPUTextureFormat format = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM,
+                                   const char *name = nullptr);
+    // Depth target in the device's preferred depth format (Device::DepthFormat()).
+    static TextureDesc DepthTarget(const Device &device, Uint32 w, Uint32 h, const char *name = nullptr);
+};
+
+// Owning handle (move-only). Release is deferred by SDL until the GPU no longer uses the texture.
+class Texture {
+public:
+    Texture() = default;
+    ~Texture() { Release(); }
+    Texture(Texture &&o) noexcept;
+    Texture &operator=(Texture &&o) noexcept;
+    Texture(const Texture &) = delete;
+    Texture &operator=(const Texture &) = delete;
+
+    bool Create(Device &device, const TextureDesc &desc);
+    // Recreates the texture at a new size with the same description when the size differs;
+    // the contents are undefined afterwards. Returns true if the texture is valid.
+    bool Resize(Uint32 width, Uint32 height);
+    void Release();
+
+    SDL_GPUTexture *Handle() const { return mTexture; }
+    explicit operator bool() const { return mTexture != nullptr; }
+    const TextureDesc &Desc() const { return mDesc; }
+    Uint32 Width() const { return mDesc.width; }
+    Uint32 Height() const { return mDesc.height; }
+    SDL_GPUTextureFormat Format() const { return mDesc.format; }
+
+private:
+    Device *mDevice = nullptr;
+    SDL_GPUTexture *mTexture = nullptr;
+    TextureDesc mDesc;
+};
+
+// Colour target plus optional depth target of the same size, resized together
+// (e.g. the 3D scene at the internal resolution).
+class RenderTarget {
+public:
+    bool Create(Device &device, Uint32 width, Uint32 height,
+                SDL_GPUTextureFormat colorFormat = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, bool withDepth = true,
+                const char *name = nullptr);
+    // Returns true if the size changed (the contents are then undefined: clear on next use).
+    bool Resize(Uint32 width, Uint32 height);
+    void Release();
+
+    Texture &Color() { return mColor; }
+    Texture &Depth() { return mDepth; }
+    const Texture &Color() const { return mColor; }
+    const Texture &Depth() const { return mDepth; }
+    Uint32 Width() const { return mColor.Width(); }
+    Uint32 Height() const { return mColor.Height(); }
+    bool HasDepth() const { return (bool)mDepth; }
+
+private:
+    Texture mColor;
+    Texture mDepth;
+};
+
+enum class Wrap : Uint8 { Repeat, Mirror, ClampToEdge };
+enum class Filter : Uint8 { Nearest, Linear };
+
+struct SamplerKey {
+    Filter filter = Filter::Nearest;  // min and mag filter; mipmaps are not used
+    Wrap wrapU = Wrap::ClampToEdge;
+    Wrap wrapV = Wrap::ClampToEdge;
+    bool operator==(const SamplerKey &) const = default;
+
+    static SamplerKey Nearest(Wrap u = Wrap::ClampToEdge, Wrap v = Wrap::ClampToEdge) { return { Filter::Nearest, u, v }; }
+    static SamplerKey Linear(Wrap u = Wrap::ClampToEdge, Wrap v = Wrap::ClampToEdge) { return { Filter::Linear, u, v }; }
+};
+
+struct SamplerKeyHash {
+    size_t operator()(const SamplerKey &k) const { return (size_t)k.filter | ((size_t)k.wrapU << 2) | ((size_t)k.wrapV << 4); }
+};
+
+class SamplerCache {
+public:
+    explicit SamplerCache(Device &device) : mDevice(device) {}
+    ~SamplerCache();
+    SamplerCache(const SamplerCache &) = delete;
+    SamplerCache &operator=(const SamplerCache &) = delete;
+
+    SDL_GPUSampler *Get(const SamplerKey &key);  // nullptr (logged) on failure
+    void Clear();
+
+private:
+    Device &mDevice;
+    std::unordered_map<SamplerKey, SDL_GPUSampler *, SamplerKeyHash> mSamplers;
+};
+
+} // namespace SIM::Gpu
