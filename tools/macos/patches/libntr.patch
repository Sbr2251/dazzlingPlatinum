+struct TextureKey {
+  std::uintptr_t texAddr = 0;
+  u32 texSize = 0;
+  std::uintptr_t plttAddr = 0;
+  u32 format = 0;
+  u32 sizeS = 0;
+  u32 sizeT = 0;
