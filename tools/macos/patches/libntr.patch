+static u32 sTpPrevMask = 0;
+static bool sTpPrevFF = false;
+static void ApplyTouchpadState() {
+  u32 cur = SIM::Touchpad::HeldMask();
+  u32 changed = cur ^ sTpPrevMask;
+  for (int b = 0; b < 12; b++) if (changed & (1u << b)) SetDSButton(1u << b, (cur & (1u << b)) != 0);
+  sTpPrevMask = cur;
+  bool ff = SIM::Touchpad::FastForwardHeld();
