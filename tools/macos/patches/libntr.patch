@@ -0,0 +1,43 @@
+#pragma once
+
+#include "fx_hudhd_atlas.hpp"
+#include <simulator/sim_hud_hd.h>
+#include <functional>
+
+namespace SIM::Render {
+
+using HudSprite = HudUiSprite;
+
+struct HudExtColor {
+  float r, g, b, a;
+};
+
+inline HudExtColor HudC4(int r, int g, int b, float a = 1.0f) {
+  return {r / 255.0f, g / 255.0f, b / 255.0f, a};
+}
+
+struct HudExtDraw {
+  const HudUiAtlas *atlas = nullptr;
+  bool useBdspUi = false;
+  float timeSec = 0.0f;
+  float canvasW = 342.0f;
+  float canvasH = 192.0f;
+
+  std::function<void(float x, float y, float w, float h, float radius,
+                     HudExtColor top, HudExtColor bot, float border, HudExtColor borderCol)> roundRect;
+  std::function<void(float x, float y, float w, float h, float radius, float soft, float alpha)> shadowRect;
+  std::function<void(float cx, float cy, float r, HudExtColor top, HudExtColor bot)> circle;
+  std::function<void(float x0, float y0, float x1, float y1, float thick, HudExtColor col)> line;
+  std::function<void(const HudUiSprite *sp, float x, float y, float w, float h, HudExtColor tint)> sprite;
+  std::function<void(const HudUiSprite *sp, float x, float y, float w, float h, float borderScale, HudExtColor tint)> spriteNineSlice;
+  std::function<void(const HudUiSprite *sp, float x, float y, float w, float h, HudExtColor tint)> spriteAspectFit;
+  std::function<float(const char *str, float sizeCanvas)> measureText;
+  std::function<void(const char *str, float x, float y, float sizeCanvas, HudExtColor col, bool shadow)> drawText;
+  std::function<void(const char *str, float x, float y, float maxW, float sizeCanvas, float lineH,
+                     int maxLines, HudExtColor col, bool shadow)> drawWrappedText;
+};
