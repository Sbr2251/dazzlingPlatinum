+static bool CaseSubRegionUpload(Device &d) {
+    Texture tex;
+    CHECK(tex.Create(d, TextureDesc::Rgba8(4, 4, "selftest-sub")), "texture create");
+    std::vector<Uint8> full(4 * 4 * 4, 255);  // white, alpha 255 everywhere
+    static const Uint8 red[2 * 2 * 4] = { 255, 0, 0, 255, 255, 0, 0, 255, 255, 0, 0, 255, 255, 0, 0, 255 };
+    RenderTarget target;
+    CHECK(target.Create(d, 4, 4, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, false, "selftest-sub-target"), "target create");
+    Frame *f = d.BeginFrame();
+    CHECK(f, "BeginFrame");
+    f->UploadTexture(tex, full.data());
+    f->UploadTexture(tex, 1, 1, 2, 2, red);
+    CHECK(f->BeginPass(Phase::Scene3D, PassDesc::Color(target.Color().Handle())), "BeginPass");
+    f->BindPipeline(Pipe(d, test_textured_vert, test_textured_frag, TexturedLayout()));
+    f->SetViewport(FullViewport(4, 4));
+    f->BindFragmentSampler(0, tex.Handle(), d.Sampler(SamplerKey::Nearest()));
+    FullscreenUvQuad(f);
+    f->EndPass();
+    CHECK(f->End(), "End");
+    std::vector<Uint8> px;
+    CHECK(d.ReadbackRGBA8(target.Color(), px), "readback");
+    CHECK(PixelEq(px, 4, 0, 0, 255, 255, 255, 255), "sub-region test: corner is not white");
+    CHECK(PixelEq(px, 4, 1, 1, 255, 0, 0, 255), "sub-region test: (1,1) is not red");
+    CHECK(PixelEq(px, 4, 2, 2, 255, 0, 0, 255), "sub-region test: (2,2) is not red");
+    CHECK(PixelEq(px, 4, 3, 3, 255, 255, 255, 255), "sub-region test: (3,3) is not white");
+    return true;
+}
