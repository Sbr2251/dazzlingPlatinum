+static WIN_PXIFifoMessage *PXIi_AcquireMessage(WIN_PXIFifoMessage *messages,
+                                                _Atomic unsigned char *used,
+                                                _Atomic size_t *hint) {
+    size_t start = atomic_fetch_add_explicit(hint, 1, memory_order_relaxed);
+    for (size_t n = 0; n < SIM_PXI_RING_SIZE; ++n) {
+        size_t i = (start + n) % SIM_PXI_RING_SIZE;
+        unsigned char expected = 0;
+        if (atomic_compare_exchange_strong_explicit(&used[i], &expected, 1,
+                                                     memory_order_acquire,
+                                                     memory_order_relaxed))
+            return &messages[i];
+    }
+    return NULL;
+}
+void PXI_Release9To7Message(WIN_PXIFifoMessage *message) {
+    size_t i = (size_t)(message - sPxi9To7Messages);
+    atomic_store_explicit(&sPxi9To7Used[i], 0, memory_order_release);
+}
+void PXI_Release7To9Message(WIN_PXIFifoMessage *message) {
+    size_t i = (size_t)(message - sPxi7To9Messages);
+    atomic_store_explicit(&sPxi7To9Used[i], 0, memory_order_release);
+}
