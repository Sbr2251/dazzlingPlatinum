+            lines.append("};")
+            lines.append("")
+            lines.append(f"inline constexpr ShaderBlob {name} = {{")
+            lines.append(f'    "{name}",')
+            lines.append(f"    {sdl_stage},")
+            lines.append(f"    {name}_spirv, sizeof({name}_spirv),")
+            lines.append(f"    {name}_msl, sizeof({name}_msl) - 1,")
+            lines.append(f"    {name}_msl, sizeof({name}_msl) - 1,")
+            lines.append(f"    {n_samp}u, {n_stex}u, {n_sbuf}u, {n_ubo}u,")
