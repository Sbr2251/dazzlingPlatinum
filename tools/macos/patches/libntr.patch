+// The same depth texture is a target of two passes in one frame: the second
+// pass loads it (LOAD) and an EQUAL draw covers exactly the first pass's quad.
+static bool CaseSharedDepth(Device &d) {
+    RenderTarget target;
+    CHECK(target.Create(d, 4, 4, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, true, "selftest-shared-depth"), "target create");
+    Frame *f = d.BeginFrame();
+    CHECK(f, "BeginFrame");
+    CHECK(f->BeginPass(Phase::Scene3D, PassDesc::ColorDepth(target.Color().Handle(), target.Depth().Handle())),
+          "BeginPass 1");
+    // Left half, depth 0.5, red.
+    f->BindPipeline(Pipe(d, test_depth_vert, test_color_frag, DepthLayout(), Blend::Opaque, SDL_GPU_CULLMODE_NONE,
+                         true, SDL_GPU_COMPAREOP_LESS, true, d.DepthFormat()));
+    f->SetViewport(FullViewport(4, 4));
+    PosZColor left[6] = { { -1, 1, 0.5f, 1, 0, 0, 1 }, { 0, 1, 0.5f, 1, 0, 0, 1 }, { -1, -1, 0.5f, 1, 0, 0, 1 },
+                          { 0, 1, 0.5f, 1, 0, 0, 1 }, { 0, -1, 0.5f, 1, 0, 0, 1 }, { -1, -1, 0.5f, 1, 0, 0, 1 } };
+    f->DrawStreamed(left, 6, sizeof(PosZColor));
+    f->EndPass();
+    // Second pass: LOAD colour and depth, draw the same left-half quad at
+    // depth 0.5 with EQUAL. It must cover exactly the left half.
+    PassDesc second;
+    second.color[0].texture = target.Color().Handle();
+    second.color[0].load = SDL_GPU_LOADOP_LOAD;
+    second.numColorTargets = 1;
+    second.depth.texture = target.Depth().Handle();
+    second.depth.load = SDL_GPU_LOADOP_LOAD;
+    second.depth.store = SDL_GPU_STOREOP_STORE;
+    CHECK(f->BeginPass(Phase::Composite2D, second), "BeginPass 2");
+    f->BindPipeline(Pipe(d, test_depth_vert, test_color_frag, DepthLayout(), Blend::Opaque, SDL_GPU_CULLMODE_NONE,
+                         true, SDL_GPU_COMPAREOP_EQUAL, false, d.DepthFormat()));
+    f->SetViewport(FullViewport(4, 4));
+    PosZColor green[6];
+    for (int i = 0; i < 6; i++) {
+        green[i] = left[i];
+        green[i].r = 0;
+        green[i].g = 1;
+    }
+    f->DrawStreamed(green, 6, sizeof(PosZColor));
+    f->EndPass();
+    CHECK(f->End(), "End");
+    std::vector<Uint8> px;
+    CHECK(d.ReadbackRGBA8(target.Color(), px), "readback");
+    CHECK(PixelEq(px, 4, 0, 0, 0, 255, 0, 255), "shared depth: left half is not green");
+    CHECK(PixelEq(px, 4, 3, 0, 0, 0, 0, 0), "shared depth: right half is not clear black");
+    return true;
+}
+
+// Exact depth equality: two vertex shaders with algebraically identical but
+// textually different position math, both declaring `invariant gl_Position`,
+// must produce bitwise-identical depth so the second draw (EQUAL) covers
+// every pixel the first draw wrote.
+static bool CaseInvariantDepth(Device &d) {
+    RenderTarget target;
+    CHECK(target.Create(d, 4, 4, SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM, true, "selftest-invariant"), "target create");
+    Frame *f = d.BeginFrame();
+    CHECK(f, "BeginFrame");
+    CHECK(f->BeginPass(Phase::Scene3D, PassDesc::ColorDepth(target.Color().Handle(), target.Depth().Handle())),
+          "BeginPass");
+    f->BindPipeline(Pipe(d, test_invariant_vert, test_red_frag, PosLayout(), Blend::Opaque, SDL_GPU_CULLMODE_NONE,
+                         true, SDL_GPU_COMPAREOP_LESS, true, d.DepthFormat()));
+    f->SetViewport(FullViewport(4, 4));
+    FullscreenPosQuad(f);
+    f->BindPipeline(Pipe(d, test_invariant2_vert, test_green_frag, PosLayout(), Blend::Opaque, SDL_GPU_CULLMODE_NONE,
+                         true, SDL_GPU_COMPAREOP_EQUAL, false, d.DepthFormat()));
+    FullscreenPosQuad(f);
+    f->EndPass();
+    CHECK(f->End(), "End");
+    std::vector<Uint8> px;
+    CHECK(d.ReadbackRGBA8(target.Color(), px), "readback");
+    for (Uint32 y = 0; y < 4; y++) {
+        for (Uint32 x = 0; x < 4; x++) {
+            CHECK(PixelEq(px, 4, x, y, 0, 255, 0, 255), "invariant depth: pixel (%u,%u) is not green", x, y);
+        }
+    }
+    return true;
+}
