+  if (srcBMem) {
+    static int logged = 0;
+    if (!logged) { logged = 1; printf("SIM capture: main-memory FIFO source B approximated by DISP_MMEM_FIFO value\n"); }
+  }
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      int i = y * w + x;
+      const u8 *a = &srcA[(y * 256 + x) * 4];
+      int ar = (a[0] * 31 + 127) / 255, ag = (a[1] * 31 + 127) / 255, ab = (a[2] * 31 + 127) / 255;
+      u16 bpx = srcBMem ? (u16)s_reg_GX_DISP_MMEM_FIFO : lcdc[srcBIdx + i];
+      int br = bpx & 31, bg = (bpx >> 5) & 31, bb = (bpx >> 10) & 31;
+      int r, g, b;
+      if (mode == 0) { r = ar; g = ag; b = ab; }
+      else if (mode == 1) { r = br; g = bg; b = bb; }
+      else {
+        r = (ar * eva + br * evb + 8) >> 4;
+        g = (ag * eva + bg * evb + 8) >> 4;
+        b = (ab * eva + bb * evb + 8) >> 4;
