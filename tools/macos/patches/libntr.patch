+ private:
+  static void GLAPIENTRY MessageCallback(GLenum, GLenum, GLuint, GLenum,
+                                         GLsizei, const GLchar *,
+                                         const void *) {}
+
+  void CacheG3Uniforms() {
+    if (mG3UniformsCached) return;
+    mLocUseTexture = Uniform(mG3Program, "useTexture");
+    mLocMyTexture = Uniform(mG3Program, "myTexture");
+    mLocPolygonMode = Uniform(mG3Program, "polygonMode");
+    mLocUseFog = Uniform(mG3Program, "useFog");
+    mLocFogColor = Uniform(mG3Program, "fogColor");
+    mLocFogDepthBoundary = Uniform(mG3Program, "fogDepthBoundary");
+    mLocFogDensity = Uniform(mG3Program, "fogDensity");
+    if (mLocMyTexture >= 0)
+      glProgramUniform1i(mG3Program, mLocMyTexture, 0);
+    mLastUseTexture = -1;
+    mLastPolygonMode = -1;
+    mLastUseFog = -1;
+    mG3UniformsCached = true;
+    if (G3::gG3Stats.enabled) G3::gG3Stats.uniformLocCalls += 7;
+  }
+
+  void DrawQuad(const G3::RenderVertex *verts, int count) {
+    if (verts == nullptr || count <= 0) return;
+    glBindVertexArray(mQuadVao);
+    glBindBuffer(GL_ARRAY_BUFFER, mQuadVbo);
+    glBufferData(GL_ARRAY_BUFFER,
+                 sizeof(G3::RenderVertex) * (size_t)count, verts,
+                 GL_STATIC_DRAW);
+    glEnableVertexAttribArray(0);
+    glEnableVertexAttribArray(1);
+    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE,
+                          sizeof(G3::RenderVertex),
+                          (void *)offsetof(G3::RenderVertex, x));
+    glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE,
+                          sizeof(G3::RenderVertex),
+                          (void *)offsetof(G3::RenderVertex, s));
+    glDrawArrays(GL_TRIANGLES, 0, count);
+  }
+
+  void InitHiRes() {
+    if (mHiResProgram || mHiResInitFailed) return;
+    GLuint vs = CompileShader(GL_VERTEX_SHADER, SIM::PostVertexShader);
+    GLuint fs =
+        CompileShader(GL_FRAGMENT_SHADER, SIM::HiResTextFragmentShader);
+    if (!vs || !fs) {
+      mHiResInitFailed = true;
+      return;
+    }
+    mHiResProgram = LinkProgram(vs, fs);
+    if (!mHiResProgram) {
+      mHiResInitFailed = true;
+      return;
+    }
+    glGenTextures(1, &mHiResTex);
+    glBindTexture(GL_TEXTURE_2D, mHiResTex);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 1024, 1536, 0, GL_RGBA,
+                 GL_UNSIGNED_BYTE, nullptr);
+    glGenVertexArrays(1, &mHiResVao);
+    glGenBuffers(1, &mHiResVbo);
+    // Fullscreen quad; v is flipped so buffer row 0 (main-screen top)
+    // lands at the top of the viewport.
+    static const float quad[] = {
+        -1.0f, -1.0f, 0.0f, 0.0f, 1.0f, 1.0f, -1.0f, 0.0f, 1.0f, 1.0f,
+        1.0f,  1.0f, 0.0f, 1.0f, 0.0f, -1.0f, -1.0f, 0.0f, 0.0f, 1.0f,
+        1.0f,  1.0f, 0.0f, 1.0f, 0.0f, -1.0f, 1.0f, 0.0f, 0.0f, 0.0f,
+    };
+    glBindVertexArray(mHiResVao);
+    glBindBuffer(GL_ARRAY_BUFFER, mHiResVbo);
+    glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW);
+    glEnableVertexAttribArray(0);
+    glEnableVertexAttribArray(1);
+    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 5 * sizeof(float),
+                          (void *)0);
+    glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 5 * sizeof(float),
+                          (void *)(3 * sizeof(float)));
+    glProgramUniform1i(mHiResProgram, Uniform(mHiResProgram, "overlayTex"),
+                       0);
+  }
+
+  static constexpr GLint kBgUnits[4] = {0, 1, 2, 3};
+  static constexpr GLint kObjUnits[5] = {4, 5, 6, 7, 8};
+  static constexpr GLint kObjWindowUnit = 9;
+
+  SDL_Window *mWindow = nullptr;
+  SDL_GLContext mContext = nullptr;
+  GLuint mBgTex[4] = {};
+  GLuint mObjTex[5] = {};
+  GLuint mDummyTex = 0;
+  GLuint mObjWindowTex = 0;
+  GLuint mG3Fbo = 0;
+  GLuint mG3Tex = 0;
+  GLuint mG3Rbo = 0;
+  GLuint mG3Program = 0;
+  GLuint mG2Program = 0;
+  GLuint mPostProgram = 0;
+  GLuint mPostFbo = 0;
+  GLuint mPostTex = 0;
+  GLuint mPostVao = 0;
+  GLuint mPostVbo = 0;
+  int mPostW = 0, mPostH = 0;
+  int mPostViewX = 0, mPostViewY = 0, mPostViewW = 0, mPostViewH = 0;
+  int mPostWinW = 0, mPostWinH = 0;
+  GLuint mCapFbo = 0, mCapTex = 0, mCapDispTex = 0, mCapProgram = 0;
+  GLuint mQuadVao = 0, mQuadVbo = 0;
+  GLuint mCurrentFbo = 0, mSavedFbo = 0;
+  GLint mCurrentViewport[4] = {};
+  GLint mSavedViewport[4] = {};
+  int mUpscaleApplied = -1;
+  int mG3Scale = 1;
+  // 3D renderer state (from sim_g3_GlRenderer.cpp).
+  GLuint mG3Vao = 0, mG3Vbo = 0;
+  int mG3VboCount = 0;
+  bool mG3UniformsCached = false;
+  GLint mLocUseTexture = -1, mLocMyTexture = -1, mLocPolygonMode = -1;
+  GLint mLocUseFog = -1, mLocFogColor = -1, mLocFogDepthBoundary = -1;
+  GLint mLocFogDensity = -1;
+  int mLastUseTexture = -1, mLastPolygonMode = -1, mLastUseFog = -1;
+  GLuint mLastWrapTexture = 0;
+  int mLastWrapS = -1, mLastWrapT = -1;
+  bool mFogUploaded = false;
+  float mLastFogColor[4] = {};
+  float mLastFogDepth[32] = {};
+  float mLastFogDensity[32] = {};
+  std::unordered_map<TextureHandle, GLuint> mTextures;
+  TextureHandle mNextTexture = 0;
+  // Hi-res text overlay (lazy, as before).
+  GLuint mHiResProgram = 0, mHiResTex = 0, mHiResVao = 0, mHiResVbo = 0;
+  bool mHiResInitFailed = false;
+};
+
+// The backend singleton is intentionally leaked (new, never delete):
+// G3 textures are owned by static state (GlobalState / TextureCache)
+// whose destructors run at exit and call DestroyTexture. If the
+// backend were a plain static, its destructor could run first, and
+// those calls would touch a destroyed unordered_map (SIGSEGV at exit).
+GlBackend *gGlBackend = new GlBackend();
+
+} // namespace
+
+namespace detail {
+Backend *gBackend = nullptr;
+} // namespace detail
+
+Backend *CreateGpuBackend();
+
+Backend &Select() {
+  if (detail::gBackend) return *detail::gBackend;
+  const char *env = getenv("SIM_RENDERER");
+  if (env && strcmp(env, "gpu") == 0) {
+    detail::gBackend = CreateGpuBackend();
+    return *detail::gBackend;
+  }
+  if (env && strcmp(env, "gl") != 0)
+    printf("SIM_RENDERER=%s: unknown backend, falling back to gl\n", env);
+  detail::gBackend = gGlBackend;
+  return *detail::gBackend;
+}
+
+} // namespace SIM::Render
