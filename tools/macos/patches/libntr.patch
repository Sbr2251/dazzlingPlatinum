+static void SetDSButton(u32 bit, bool down) {
+  if (bit < (1u << 10)) {
+    if (down) s_reg_PAD_KEYINPUT = (u16)(s_reg_PAD_KEYINPUT & ~(u16)bit);
+    else s_reg_PAD_KEYINPUT = (u16)(s_reg_PAD_KEYINPUT | (u16)bit);
