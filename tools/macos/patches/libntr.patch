+// P10: Cache env-based gate decisions once per process (never mutated at runtime).
+struct CachedGateEnv {
+  bool bdspZero = false;
+  bool bdspOne = false;
+  bool interactiveFxOne = false;
+  bool modelsZero = false;
+  bool modelsOne = false;
