+void Device::Destroy() {
+    if (mDevice) {
+        if (mFrame && mFrame->mActive) {
+            LogError("Device::Destroy with a frame in progress; submitting it", false);
+            mFrame->End();
+        }
+        SDL_WaitForGPUIdle(mDevice);
+        mFrame.reset();
+        if (mPipelines) mPipelines->Clear();
+        if (mSamplers) mSamplers->Clear();
+        mPipelines.reset();
+        mSamplers.reset();
+        for (auto &kv : mShaders) SDL_ReleaseGPUShader(mDevice, kv.second);
+        mShaders.clear();
+        if (mDownload) SDL_ReleaseGPUTransferBuffer(mDevice, mDownload);
+        mDownload = nullptr;
+        mDownloadSize = 0;
+        DetachWindow();
+        SDL_DestroyGPUDevice(mDevice);
+        mDevice = nullptr;
+    }
+    if (mInitedVideo) {
+        SDL_QuitSubSystem(SDL_INIT_VIDEO);
+        mInitedVideo = false;
+    }
+}
