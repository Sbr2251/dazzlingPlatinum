diff --git a/libraries/sim/src/sim_platform.cpp b/libraries/sim/src/sim_platform.cpp
new file mode 100644
index 0000000..1f73a0c
--- /dev/null
+++ b/libraries/sim/src/sim_platform.cpp
@@ -0,0 +1,153 @@
+// Platform paths and lifecycle. See include/simulator/sim_platform.h.
+#include "simulator/sim_platform.h"
+#include "simulator/sim_audio.h"
+#include "simulator/sim_gui.hpp"
+#include "simulator/sim_headless.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <sys/stat.h>
+#if defined(__APPLE__)
+#include <TargetConditionals.h>
+#endif
+namespace {
+bool IsIOS() {
+#if defined(__APPLE__) && defined(TARGET_OS_IOS)
+  return TARGET_OS_IOS != 0;
+#else
+  return false;
+#endif
+}
+std::string JoinStr(const std::string &a, const std::string &b) {
+  if (a.empty() || a.back() == '/') return a + b;
+  return a + "/" + b;
+}
+bool DirExists(const std::string &p) { struct stat st; return stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode); }
+const std::string &DataDir() {
+  static std::string d = [] {
+    if (const char *e = getenv("SIM_DATA_DIR"); e && e[0]) return std::string(e);
+    if (!IsIOS()) return std::string(".");
+    const char *base = SDL_GetBasePath();
+    std::string b = base ? base : ".";
+    // Agreed with build lane: game data at <bundle>/Resources/game (flat .app).
+    for (const char *c : {"Resources/game", "game"})
+      if (DirExists(JoinStr(b, c))) return JoinStr(b, c);
+    return b;
+  }();
+  return d;
+}
+const std::string &WritableDir() {
+  static std::string d = [] {
+    if (const char *e = getenv("SIM_WRITABLE_DIR"); e && e[0]) return std::string(e);
+    if (!IsIOS()) return std::string(".");
+    const char *docs = SDL_GetUserFolder(SDL_FOLDER_DOCUMENTS);
+    std::string r = docs ? docs : "";
+    if (r.empty()) { char *p = SDL_GetPrefPath("local", "DazzlingPlatinum"); r = p ? p : "."; SDL_free(p); }
+    while (r.size() > 1 && r.back() == '/') r.pop_back();
+    return r;
+  }();
+  return d;
+}
+std::string Cached(const std::string &name) { return IsIOS() || getenv("SIM_WRITABLE_DIR") ? JoinStr(WritableDir(), name) : name; }
+bool sAppSuspended = false;
+bool sBackgroundSaveFlushed = false;
+bool sWasPaused = false;
+}  // namespace
+extern "C" {
+int SIM_Platform_IsIOS(void) { return IsIOS() ? 1 : 0; }
+int SIM_Platform_IsSuspended(void) { return sAppSuspended ? 1 : 0; }
+const char *SIM_Platform_DataDir(void) { return DataDir().c_str(); }
+const char *SIM_Platform_WritableDir(void) { return WritableDir().c_str(); }
+const char *SIM_Platform_SaveBinPath(void) { static std::string p = Cached("save.bin"); return p.c_str(); }
+const char *SIM_Platform_ConfigPath(void) { static std::string p = Cached("sim_config.ini"); return p.c_str(); }
+const char *SIM_Platform_ConfigPrjPath(void) { static std::string p = Cached("sim_config_prj.ini"); return p.c_str(); }
+const char *SIM_Platform_LogPath(void) { static std::string p = Cached("log.txt"); return p.c_str(); }
+// ios-platform hook: firmware.bin (DS NVRAM / WFC settings) is opened "rb+", so it must live in the writable
+// dir. On iOS the bundle copy is the seed: it is copied to Documents on first use. Elsewhere: "firmware.bin".
+const char *SIM_Platform_FirmwarePath(void) {
+  static std::string p = [] {
+    std::string w = Cached("firmware.bin");
+    if (w == "firmware.bin") return w;
+    if (FILE *f = fopen(w.c_str(), "rb")) { fclose(f); return w; }
+    std::string seed = JoinStr(DataDir(), "firmware.bin");
+    FILE *in = fopen(seed.c_str(), "rb");
+    if (!in) in = fopen("firmware.bin", "rb");
+    FILE *out = in ? fopen(w.c_str(), "wb") : nullptr;
+    if (in && out) { char buf[65536]; size_t n; while ((n = fread(buf, 1, sizeof buf, in)) > 0) fwrite(buf, 1, n, out); }
+    if (out) fclose(out);
+    if (in) fclose(in);
+    return w;
+  }();
+  return p.c_str();
+}
+const char *SIM_Platform_JoinPath(const char *dir, const char *name) {
+  static thread_local std::string buf;
+  buf = JoinStr(dir ? dir : "", name ? name : "");
+  return buf.c_str();
+}
+void SIM_Platform_EnsureWritableDirs(void) {
+  if (!IsIOS() && !getenv("SIM_WRITABLE_DIR")) return;
+  const std::string &w = WritableDir();
+  mkdir(w.c_str(), 0755);
+  mkdir(JoinStr(w, "Import").c_str(), 0755);
+  mkdir(JoinStr(w, "Export").c_str(), 0755);
+  mkdir(JoinStr(w, "TexturePackDump").c_str(), 0755);
+  mkdir(JoinStr(w, "Screenshots").c_str(), 0755);
+  mkdir(JoinStr(w, "save-backups").c_str(), 0755);
+}
+int SIM_Platform_SafeArea(SDL_Window *window, SDL_Rect *out) {
+  if (!IsIOS() || !window || !out) return 0;
+  return SDL_GetWindowSafeArea(window, out) ? 1 : 0;
+}
+int SIM_Platform_PacingSwapInterval(SDL_Window *window) {
+  if (!window) return 1;
+  SDL_DisplayID id = SDL_GetDisplayForWindow(window);
+  const SDL_DisplayMode *m = id ? SDL_GetCurrentDisplayMode(id) : nullptr;
+  return (m && m->refresh_rate >= 100.0f) ? 2 : 1;
+}
+void SIM_ResetFramePacing(void);
+void SIM_Platform_HandleEvent(const SDL_Event *event) {
+  if (!event) return;
+  // perf-audio hook: recover output routes on every platform, not only iOS.
+  if (event->type == SDL_EVENT_AUDIO_DEVICE_ADDED) {
+    SIM_Audio_PollReconnect();
+  } else if (event->type == SDL_EVENT_AUDIO_DEVICE_REMOVED && !SIM_Audio_IsSilentFallback()) {
+    SIM_Audio_DeviceLost();
+  }
+  if (!IsIOS()) return;
+  switch (event->type) {
+    case SDL_EVENT_WILL_ENTER_BACKGROUND:
+      if (!sAppSuspended) sWasPaused = SIM::GUI::IsGameLogicPaused();
+      sAppSuspended = true;
+      SIM_Audio_SetPaused(true);
+      if (!sBackgroundSaveFlushed) {
+        SIM_SaveFlash_Flush();
+        sBackgroundSaveFlushed = true;
+      }
+      break;
+    case SDL_EVENT_DID_ENTER_BACKGROUND:
+      // WILL_ENTER_BACKGROUND owns the one-shot flush. Some SDL/UIKit
+      // versions deliver both events back-to-back.
+      sAppSuspended = true;
+      break;
+    case SDL_EVENT_AUDIO_DEVICE_REMOVED: // ios-platform hook: fall back, keep consuming
+      SIM_Audio_DeviceLost();
+      break;
+    case SDL_EVENT_AUDIO_DEVICE_FORMAT_CHANGED:
+      SIM_Audio_SetPaused(SIM::GUI::IsGameLogicPaused() || sAppSuspended);
+      break;
+    case SDL_EVENT_WILL_ENTER_FOREGROUND:
+      break;
+    case SDL_EVENT_DID_ENTER_FOREGROUND:
+      sAppSuspended = false;
+      sBackgroundSaveFlushed = false;
+      SIM_Audio_PollReconnect(); // ios-platform hook: reopen a recovered device
+      SIM::GUI::SetGameLogicPaused(sWasPaused);
+      SIM_Audio_SetPaused(sWasPaused);
+      SIM_ResetFramePacing();
+      break;
+    default: break;
+  }
+}
+}  // extern "C"
diff --git a/libraries/sim/src/sim_save_flash.cpp b/libraries/sim/src/sim_save_flash.cpp
new file mode 100644
index 0000000..ba9696d
--- /dev/null
+++ b/libraries/sim/src/sim_save_flash.cpp
@@ -0,0 +1,168 @@
+// Instant, atomic save-file backing for the PC port's DS flash (512 KB save.bin).
+//
+// Previously every CARD write opened save.bin, fseek+fwrite+fclose'd one chunk
+// (block data, secondary footer, footer, per block, plus extra-save sectors and
+// new-game footer erases): many non-atomic writes, no fsync, no backup. A kill
+// or crash mid-save could leave a torn file, and only the game's dual-sector
+// logic stood a chance of recovering it.
+//
+// Now the flash is a 512 KB in-memory image. Reads and writes operate on the
+// image. Outside a transaction a write flushes immediately; inside a
+// transaction (SIM_SaveFlash_Begin/Commit, used by the game's top-level save
+// paths) all chunk writes are coalesced and the file is written exactly once,
+// on Commit:
+//   1. the previous save.bin (if non-blank) is copied to save.bin.bak,
+//   2. the new image goes to save.bin.tmp, is fsync'd, then rename()d over
+//      save.bin (atomic on POSIX), and the directory is fsync'd.
+// A kill at any point therefore leaves either the old or the new complete
+// save; a leftover .tmp is ignored. The bytes in the image are exactly the
+// bytes the old chunked writes produced (same offsets, same contents), so
+// save files stay byte-identical and DeSmuME/melonDS compatible.
+#include "simulator/sim_headless.h"
+
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+namespace {
+
+const size_t kFlashSize = 512 * 1024;
+
+std::vector<unsigned char> s_image;
+std::vector<unsigned char> s_previousImage;
+bool s_loaded = false;
+bool s_dirty = false;
+bool s_previousIsUsable = false;
+int s_txnDepth = 0;
+unsigned s_bufferedWrites = 0;  // writes coalesced in the current/last flush
+
+std::string SavePath() { return SIM_GetSaveBinPath(); }
+
+bool LoadImage() {
+    if (s_loaded) return true;
+    s_image.assign(kFlashSize, 0);
+    std::string path = SavePath();
+    FILE *f = fopen(path.c_str(), "rb");
+    if (f) {
+        size_t n = fread(s_image.data(), 1, kFlashSize, f);
+        (void)n;  // short file: remainder stays 0, as a fseek/fwrite gap would read
+        fclose(f);
+        for (unsigned char byte : s_image) {
+            if (byte != 0 && byte != 0xFF) {
+                s_previousIsUsable = true;
+                break;
+            }
+        }
+    }
+    s_previousImage = s_image;
+    s_loaded = true;
+    return true;
+}
+
+bool WriteFileAtomic(const std::string &path, const unsigned char *data, size_t size, bool rotateBackup) {
+    std::string tmp = path + ".tmp";
+    int fd = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (fd < 0) return false;
+    size_t off = 0;
+    while (off < size) {
+        ssize_t w = write(fd, data + off, size - off);
+        if (w <= 0) { close(fd); unlink(tmp.c_str()); return false; }
+        off += (size_t)w;
+    }
+    if (fsync(fd) != 0) { close(fd); unlink(tmp.c_str()); return false; }
+    if (close(fd) != 0) { unlink(tmp.c_str()); return false; }
+    if (rotateBackup) {
+        // rename() is metadata-only: retain the previous complete save without
+        // reading or rewriting another 512 KiB image.
+        if (rename(path.c_str(), (path + ".bak").c_str()) != 0 && errno != ENOENT) {
+            unlink(tmp.c_str());
+            return false;
+        }
+    }
+    if (rename(tmp.c_str(), path.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    // One directory fsync persists both metadata rotations.
+    std::string dir = ".";
+    size_t slash = path.find_last_of('/');
+    if (slash != std::string::npos) dir = (slash == 0) ? "/" : path.substr(0, slash);
+    int dfd = open(dir.c_str(), O_RDONLY);
+    if (dfd >= 0) { fsync(dfd); close(dfd); }
+    return true;
+}
+
+bool Flush() {
+    if (!s_loaded || !s_dirty) return true;
+    std::string path = SavePath();
+    struct timespec t0, t1;
+    clock_gettime(CLOCK_MONOTONIC, &t0);
+    bool madeBackup = s_previousIsUsable;
+    if (!WriteFileAtomic(path, s_image.data(), kFlashSize, madeBackup)) return false;
+    s_previousImage = s_image;
+    s_previousIsUsable = true;
+    clock_gettime(CLOCK_MONOTONIC, &t1);
+    double ms = (double)(t1.tv_sec - t0.tv_sec) * 1e3 + (double)(t1.tv_nsec - t0.tv_nsec) / 1e6;
+    fprintf(stderr, "SIM instant-save: wrote %zu bytes in %.1f ms (%u buffered writes coalesced, bak=%s)\n",
+            kFlashSize, ms, s_bufferedWrites, madeBackup ? "yes" : "no");
+    s_dirty = false;
+    s_bufferedWrites = 0;
+    return true;
+}
+
+}  // namespace
+
+extern "C" int SIM_SaveFlash_Read(unsigned int src, void *dst, unsigned int len) {
+    if (!LoadImage()) return 0;
+    if (src >= kFlashSize) { memset(dst, 0, len); return 1; }
+    size_t avail = kFlashSize - src;
+    size_t n = len < avail ? len : avail;
+    memcpy(dst, s_image.data() + src, n);
+    if (n < len) memset((unsigned char *)dst + n, 0, len - n);
+    return 1;
+}
+
+extern "C" int SIM_SaveFlash_Write(unsigned int dst, const void *src, unsigned int len) {
+    if (!LoadImage()) return 0;
+    if (dst >= kFlashSize) return 0;
+    size_t avail = kFlashSize - dst;
+    size_t n = len < avail ? len : avail;
+    if (memcmp(s_image.data() + dst, src, n) != 0) {
+        memcpy(s_image.data() + dst, src, n);
+        s_dirty = true;
+    }
+    s_bufferedWrites++;
+    if (s_txnDepth == 0) return Flush() ? 1 : 0;
+    return 1;
+}
+
+extern "C" int SIM_SaveFlash_Flush(void) { return Flush() ? 1 : 0; }
+
+extern "C" void SIM_SaveFlash_Begin(void) {
+    LoadImage();
+    s_txnDepth++;
+}
+
+extern "C" int SIM_SaveFlash_Commit(void) {
+    if (s_txnDepth > 0) s_txnDepth--;
+    if (s_txnDepth == 0) return Flush() ? 1 : 0;
+    return 1;
+}
+
+extern "C" void SIM_SaveFlash_Rollback(void) {
+    if (s_txnDepth > 0) s_txnDepth--;
+    if (s_txnDepth == 0) {
+        // Discard buffered writes: reload from the file on next access.
+        s_loaded = false;
+        s_dirty = false;
+        s_bufferedWrites = 0;
+        s_image.clear();
+        s_previousImage.clear();
+        s_previousIsUsable = false;
+    }
+}
