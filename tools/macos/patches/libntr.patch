diff --git a/libraries/sim/src/gpu/shaders/test_ssbo.frag b/libraries/sim/src/gpu/shaders/test_ssbo.frag
new file mode 100644
index 0000000..65322c3
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/test_ssbo.frag
@@ -0,0 +1,10 @@
+// Integer data in a storage buffer (SSBO): the tested path for VRAM/OAM/
+// palette words. Storage textures (uimage2D) crash lavapipe on SDL 3.4.16.
+#version 450
+layout(set = 2, binding = 0) readonly buffer B { uint vals[]; } b;
+layout(location = 0) in vec2 vUv;
+layout(location = 0) out vec4 o;
+void main() {
+    uint idx = uint(vUv.x * 4.0) + uint(vUv.y * 4.0) * 4u;
+    o = vec4(float(b.vals[idx]) / 255.0, 0.0, 0.0, 1.0);
+}
diff --git a/libraries/sim/src/gpu/shaders/test_ssbo16.frag b/libraries/sim/src/gpu/shaders/test_ssbo16.frag
new file mode 100644
index 0000000..8485b4a
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/test_ssbo16.frag
@@ -0,0 +1,10 @@
+#version 450
+// 16-bit words packed two per uint: low word in bits 0..15, high word in 16..31.
+layout(set = 2, binding = 0) readonly buffer B { uint vals[]; } b;
+layout(location = 0) in vec2 vUv;
+layout(location = 0) out vec4 o;
+void main() {
+    uint idx = uint(vUv.x * 4.0) + uint(vUv.y * 4.0) * 4u;
+    uint w = b.vals[idx];
+    o = vec4(float(w & 0xFFFFu) / 65535.0, float(w >> 16) / 65535.0, 0.0, 1.0);
+}
