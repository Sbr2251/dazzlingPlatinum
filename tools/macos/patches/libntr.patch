+#pragma once
+
+// Native display-resolution HD battle HUD pass (BDSP parity).
+// Renders SIM_HudHD_Frame (cards, party ball strips, action buttons, move cards)
+// at native output resolution after the 2D composite / post FX and before the
+// touch-controls overlay.
+
+#include "fx_hudhd_atlas.hpp"
+
+#include <simulator/gpu/gpu.hpp>
+#include <simulator/sim_hud_hd.h>
+
+#include <SDL3/SDL.h>
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace SIM::Render {
+
+class FxHudHD {
+ public:
+  FxHudHD() = default;
+  ~FxHudHD();
+  FxHudHD(const FxHudHD &) = delete;
+  FxHudHD &operator=(const FxHudHD &) = delete;
+
+  // Called outside an open render pass (e.g. at the start of RenderPost).
+  // Latches the submitted frame (or builds the SIM_HUDHD_DEMO frame), advances
+  // animations, and ensures the TrueType font atlas is baked & uploaded at the
+  // current output resolution.
+  void Prepare(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+               std::uint32_t targetW, std::uint32_t targetH,
+               float viewU0, float viewV0, float viewU1, float viewV1);
+
+  // Called inside the open Phase::Post render pass on mPresent.
+  void Render(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+              SDL_GPUTextureFormat colorFormat);
+
+  void Release();
+
+  struct HudVertex {
+    float pos[2];
+    float uv[2];
+    float colorTop[4];
+    float colorBot[4];
+    float borderColor[4];
+    float rectSize[2];
+    float params[4]; // mode (0=roundRect,1=circle,2=capsule,3=text,4=flat), radius/thick, border, softness
+  };
+  static_assert(sizeof(HudVertex) == 88, "HudVertex size");
+
+ private:
+  struct GlyphInfo {
+    float u0 = 0, v0 = 0, u1 = 0, v1 = 0;
+    float xoff = 0, yoff = 0;
+    float w = 0, h = 0;
+    float advance = 0;
+    bool valid = false;
+  };
+
+  struct CardAnimState {
+    bool wasVisible = false;
+    float displayedHp = 1.0f;
+    float slide = 1.0f;
+  };
+
+  struct ButtonAnimState {
+    bool wasVisible = false;
+    float slide = 1.0f;
+  };
+
+  bool EnsureFontLoaded();
+  bool EnsureAtlas(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame, float bakePx);
+  void BuildDemoFrame(int mode);
+
+  SIM::Gpu::Device *mDevice = nullptr;
+  SIM::Gpu::Texture mFontAtlas;
+  HudUiAtlas mUiAtlas;
+  bool mHasAtlas = false;
+  float mBakedPx = 0.0f;
+  float mFontAscent = 0.0f;
+  float mFontDescent = 0.0f;
+  float mFontLineGap = 0.0f;
+
+  bool mFontProbed = false;
+  bool mFontLoaded = false;
+  std::vector<std::uint8_t> mFontData;
+  std::unordered_map<std::uint32_t, GlyphInfo> mGlyphs;
+
+  // Latched frame & viewport mapping
+  bool mShouldDraw = false;
+  SIM_HudHD_Frame mLatched{};
+  std::uint32_t mTargetW = 1;
+  std::uint32_t mTargetH = 1;
+  float mViewX = 0.0f;
+  float mViewY = 0.0f;
+  float mViewW = 1.0f;
+  float mViewH = 1.0f;
+  float mScaleX = 1.0f;
+  float mScaleY = 1.0f;
+  float mTimeSec = 0.0f;
+  Uint64 mLastPrepareTicks = 0;
+
+  // P9: Persistent vertex scratch buffer (reserved once, reused every frame).
+  std::vector<HudVertex> mVerts;
+
+  CardAnimState mCardAnim[SIM_HUDHD_MAX_CARDS]{};
+  ButtonAnimState mBtnAnim[SIM_HUDHD_MAX_BUTTONS]{};
+  ButtonAnimState mMoveAnim[SIM_HUDHD_MAX_MOVES]{};
+};
+
+// Called by GpuBackend::Init / Shutdown so SIM_HudHD_IsSupported() reflects
+// whether the GPU backend is active.
+void SetHudHDSupported(bool supported);
+
+} // namespace SIM::Render
