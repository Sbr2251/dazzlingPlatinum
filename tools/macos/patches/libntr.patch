+#include "fx_hudhd.hpp"
+#include "fx_hudhd_ext.hpp"
+
+#include "generated/hudhd_shaders.h"
+
+#define STB_TRUETYPE_IMPLEMENTATION
+#define STBTT_STATIC
+#include <imstb_truetype.h>
+#include <simulator/sim_headless.h>
+#include <simulator/sim_platform.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+#ifdef __APPLE__
+#include <mach-o/dyld.h>
+#endif
+#include <limits.h>
+#include <unistd.h>
+
+namespace SIM::Render {
+namespace {
+
+using namespace SIM::Gpu;
+
+std::mutex gStateMutex;
+SIM_HudHD_Frame gSharedFrame{};
+std::uint32_t gFramesSinceSubmit = 999;
+std::atomic<bool> gHudHDSupported{false};
+
+struct Color4 {
+  float r, g, b, a;
+};
+
+constexpr Color4 C4(std::uint8_t r, std::uint8_t g, std::uint8_t b, float a = 1.0f) {
+  return {r / 255.0f, g / 255.0f, b / 255.0f, a};
+}
+
+constexpr Color4 MulAlpha(Color4 c, float a) {
+  return {c.r, c.g, c.b, c.a * a};
+}
+
+using HudVertex = FxHudHD::HudVertex;
+
+// Matches generated/pokemon_types.txt (0..18)
+struct TypePalette {
+  Color4 top;
+  Color4 bot;
+};
+
+const TypePalette kTypeColors[19] = {
+    {C4(168, 168, 136), C4(132, 132, 102)}, // 0: NORMAL
+    {C4(204, 62, 50),   C4(162, 40, 30)},   // 1: FIGHTING
+    {C4(142, 168, 240), C4(104, 132, 206)}, // 2: FLYING
+    {C4(174, 78, 174),  C4(136, 52, 136)},  // 3: POISON
+    {C4(218, 184, 96),  C4(182, 148, 66)},  // 4: GROUND
+    {C4(186, 162, 74),  C4(148, 126, 48)},  // 5: ROCK
+    {C4(166, 188, 42),  C4(130, 150, 24)},  // 6: BUG
+    {C4(118, 92, 168),  C4(88, 64, 134)},   // 7: GHOST
+    {C4(172, 178, 200), C4(132, 138, 164)}, // 8: STEEL
+    {C4(110, 162, 148), C4(78, 126, 114)},  // 9: MYSTERY (???)
+    {C4(242, 118, 52),  C4(206, 82, 28)},   // 10: FIRE
+    {C4(88, 156, 242),  C4(56, 118, 206)},  // 11: WATER
+    {C4(110, 202, 82),  C4(76, 164, 52)},   // 12: GRASS
+    {C4(246, 204, 48),  C4(212, 166, 22)},  // 13: ELECTRIC
+    {C4(244, 96, 146),  C4(206, 62, 112)},  // 14: PSYCHIC
+    {C4(122, 212, 214), C4(84, 174, 178)},  // 15: ICE
+    {C4(118, 86, 244),  C4(82, 52, 206)},   // 16: DRAGON
+    {C4(116, 92, 78),   C4(82, 62, 50)},    // 17: DARK
+    {C4(236, 146, 198), C4(202, 108, 164)}, // 18: FAIRY
+};
+
+// Maps Dazzling Platinum TYPE_* (0..18, 9 = MYSTERY) to BDSP UI type index (0..17, 9 = FIRE..17 = FAIRY).
+int BdspTypeIndex(int ptType) {
+  if (ptType < 0 || ptType >= 19 || ptType == 9) return 0;
+  return (ptType > 9) ? (ptType - 1) : ptType;
+}
+
+bool FileExists(const std::string &path) {
+  return !path.empty() && ::access(path.c_str(), R_OK) == 0;
+}
+
+std::string JoinPath(const std::string &a, const std::string &b) {
+  if (a.empty()) return b;
+  if (a.back() == '/') return a + b;
+  return a + "/" + b;
+}
+
+std::string ExeDir() {
+#ifdef __APPLE__
+  char buf[PATH_MAX];
+  uint32_t sz = sizeof(buf);
+  if (_NSGetExecutablePath(buf, &sz) == 0) {
+    char resolved[PATH_MAX];
+    const char *p = ::realpath(buf, resolved) ? resolved : buf;
+    std::string s(p);
+    auto slash = s.rfind('/');
+    if (slash != std::string::npos) return s.substr(0, slash);
+  }
+#endif
+  return {};
+}
+
+std::uint32_t NextCodepoint(const char *&p) {
+  const unsigned char c = static_cast<unsigned char>(*p);
+  if (c == 0) return 0;
+  if (c < 0x80) {
+    ++p;
+    return c;
+  }
+  if ((c & 0xE0) == 0xC0 && p[1]) {
+    std::uint32_t cp = ((c & 0x1F) << 6) | (static_cast<unsigned char>(p[1]) & 0x3F);
+    p += 2;
+    return cp;
+  }
+  if ((c & 0xF0) == 0xE0 && p[1] && p[2]) {
+    std::uint32_t cp = ((c & 0x0F) << 12) |
+                       ((static_cast<unsigned char>(p[1]) & 0x3F) << 6) |
+                       (static_cast<unsigned char>(p[2]) & 0x3F);
+    p += 3;
+    return cp;
+  }
+  if ((c & 0xF8) == 0xF0 && p[1] && p[2] && p[3]) {
+    std::uint32_t cp = ((c & 0x07) << 18) |
+                       ((static_cast<unsigned char>(p[1]) & 0x3F) << 12) |
+                       ((static_cast<unsigned char>(p[2]) & 0x3F) << 6) |
+                       (static_cast<unsigned char>(p[3]) & 0x3F);
+    p += 4;
+    return cp;
+  }
+  ++p;
+  return '?';
+}
+
+struct DrawBatch {
+  float viewX, viewY, scaleX, scaleY;
+  float targetW, targetH;
+  std::vector<HudVertex> &verts;
+
+  float PxX(float cx) const { return viewX + cx * scaleX; }
+  float PxY(float cy) const { return viewY + cy * scaleY; }
+  float PxW(float cw) const { return cw * scaleX; }
+  float PxH(float ch) const { return ch * scaleY; }
+  float NdcX(float px) const { return (px / targetW) * 2.0f - 1.0f; }
+  float NdcY(float py) const { return 1.0f - (py / targetH) * 2.0f; }
+
+  void PushQuadPx(float x, float y, float w, float h,
+                  Color4 top, Color4 bot, Color4 border,
+                  float mode, float radiusPx, float borderPx, float softPx,
+                  float u0 = 0.0f, float v0 = 0.0f, float u1 = 1.0f, float v1 = 1.0f) {
+    if (w <= 0.0f || h <= 0.0f) return;
+    const float x0 = NdcX(x), x1 = NdcX(x + w);
+    const float y0 = NdcY(y), y1 = NdcY(y + h);
+    auto mk = [&](float nx, float ny, float u, float v) {
+      HudVertex hv{};
+      hv.pos[0] = nx; hv.pos[1] = ny;
+      hv.uv[0] = u; hv.uv[1] = v;
+      hv.colorTop[0] = top.r; hv.colorTop[1] = top.g; hv.colorTop[2] = top.b; hv.colorTop[3] = top.a;
+      hv.colorBot[0] = bot.r; hv.colorBot[1] = bot.g; hv.colorBot[2] = bot.b; hv.colorBot[3] = bot.a;
+      hv.borderColor[0] = border.r; hv.borderColor[1] = border.g; hv.borderColor[2] = border.b; hv.borderColor[3] = border.a;
+      hv.rectSize[0] = w; hv.rectSize[1] = h;
+      hv.params[0] = mode; hv.params[1] = radiusPx; hv.params[2] = borderPx; hv.params[3] = softPx;
+      return hv;
+    };
+    HudVertex tl = mk(x0, y0, u0, v0);
+    HudVertex tr = mk(x1, y0, u1, v0);
+    HudVertex br = mk(x1, y1, u1, v1);
+    HudVertex bl = mk(x0, y1, u0, v1);
+    verts.push_back(tl); verts.push_back(tr); verts.push_back(br);
+    verts.push_back(tl); verts.push_back(br); verts.push_back(bl);
+  }
+
+  void RoundRect(float cx, float cy, float cw, float ch, float radiusCanvas,
+                 Color4 top, Color4 bot, float borderCanvas = 0.0f, Color4 border = {}) {
+    float w = PxW(cw), h = PxH(ch);
+    float r = radiusCanvas * scaleY;
+    float b = borderCanvas * scaleY;
+    PushQuadPx(PxX(cx), PxY(cy), w, h, top, bot, border, 0.0f, r, b, 0.0f);
+  }
+
+  void ShadowRect(float cx, float cy, float cw, float ch, float radiusCanvas,
+                  float softCanvas, float alpha) {
+    float pad = softCanvas;
+    float w = PxW(cw + pad * 2.0f), h = PxH(ch + pad * 2.0f);
+    Color4 sc = {0.0f, 0.0f, 0.0f, alpha};
+    PushQuadPx(PxX(cx - pad), PxY(cy - pad), w, h, sc, sc, sc, 0.0f,
+               radiusCanvas * scaleY, 0.0f, softCanvas * scaleY);
+  }
+
+  void Circle(float ccx, float ccy, float rCanvas, Color4 top, Color4 bot,
+              float borderCanvas = 0.0f, Color4 border = {}) {
+    float rPx = rCanvas * scaleY;
+    float sizePx = (rPx + 1.5f) * 2.0f;
+    float x = PxX(ccx) - sizePx * 0.5f;
+    float y = PxY(ccy) - sizePx * 0.5f;
+    PushQuadPx(x, y, sizePx, sizePx, top, bot, border, 1.0f, rPx, borderCanvas * scaleY, 0.0f);
+  }
+
+  void Line(float x0c, float y0c, float x1c, float y1c, float thickCanvas, Color4 col) {
+    float x0 = PxX(x0c), y0 = PxY(y0c);
+    float x1 = PxX(x1c), y1 = PxY(y1c);
+    float dx = x1 - x0, dy = y1 - y0;
+    float len = std::sqrt(dx * dx + dy * dy);
+    float rPx = std::max(0.5f, thickCanvas * scaleY * 0.5f);
+    float quadW = len + rPx * 2.0f + 2.0f;
+    float quadH = rPx * 2.0f + 2.0f;
+    float ux = len > 0.001f ? dx / len : 1.0f;
+    float uy = len > 0.001f ? dy / len : 0.0f;
+    float nx = -uy, ny = ux;
+    float mx = (x0 + x1) * 0.5f;
+    float my = (y0 + y1) * 0.5f;
+    float hw = quadW * 0.5f, hh = quadH * 0.5f;
+
+    auto mk = [&](float px, float py, float u, float v) {
+      HudVertex hv{};
+      hv.pos[0] = NdcX(px); hv.pos[1] = NdcY(py);
+      hv.uv[0] = u; hv.uv[1] = v;
+      hv.colorTop[0] = col.r; hv.colorTop[1] = col.g; hv.colorTop[2] = col.b; hv.colorTop[3] = col.a;
+      hv.colorBot[0] = col.r; hv.colorBot[1] = col.g; hv.colorBot[2] = col.b; hv.colorBot[3] = col.a;
+      hv.rectSize[0] = quadW; hv.rectSize[1] = quadH;
+      hv.params[0] = 2.0f; hv.params[1] = rPx;
+      return hv;
+    };
+    HudVertex v0 = mk(mx - ux * hw - nx * hh, my - uy * hw - ny * hh, 0.0f, 0.0f);
+    HudVertex v1 = mk(mx + ux * hw - nx * hh, my + uy * hw - ny * hh, 1.0f, 0.0f);
+    HudVertex v2 = mk(mx + ux * hw + nx * hh, my + uy * hw + ny * hh, 1.0f, 1.0f);
+    HudVertex v3 = mk(mx - ux * hw + nx * hh, my - uy * hw + ny * hh, 0.0f, 1.0f);
+    verts.push_back(v0); verts.push_back(v1); verts.push_back(v2);
+    verts.push_back(v0); verts.push_back(v2); verts.push_back(v3);
+  }
+
+  void DrawSprite(const HudUiSprite *sp, float cx, float cy, float cw, float ch,
+                  Color4 tint = {1.0f, 1.0f, 1.0f, 1.0f}) {
+    if (!sp || !sp->valid || cw <= 0.0f || ch <= 0.0f) return;
+    PushQuadPx(PxX(cx), PxY(cy), PxW(cw), PxH(ch), tint, tint, tint, 5.0f,
+               0.0f, 0.0f, 0.0f, sp->u0, sp->v0, sp->u1, sp->v1);
+  }
+
+  void DrawSpriteAspectFit(const HudUiSprite *sp, float cx, float cy, float cw, float ch,
+                           Color4 tint = {1.0f, 1.0f, 1.0f, 1.0f},
+                           float alignH = 0.5f, float alignV = 0.5f) {
+    if (!sp || !sp->valid || cw <= 0.0f || ch <= 0.0f || sp->w <= 0.0f || sp->h <= 0.0f) return;
+    const float srcAspect = sp->w / sp->h;
+    const float dstAspect = cw / ch;
+    float dw = cw, dh = ch;
+    if (dstAspect > srcAspect) {
+      dw = ch * srcAspect;
+    } else {
+      dh = cw / srcAspect;
+    }
+    const float dx = cx + (cw - dw) * alignH;
+    const float dy = cy + (ch - dh) * alignV;
+    DrawSprite(sp, dx, dy, dw, dh, tint);
+  }
+
+  void DrawSprite9Slice(const HudUiSprite *sp, float cx, float cy, float cw, float ch,
+                        float borderScaleCanvasPerSrcPx,
+                        Color4 tint = {1.0f, 1.0f, 1.0f, 1.0f}) {
+    if (!sp || !sp->valid || cw <= 0.0f || ch <= 0.0f || sp->w <= 0.0f || sp->h <= 0.0f) return;
+    if (sp->bl <= 0.0f && sp->bt <= 0.0f && sp->br <= 0.0f && sp->bb <= 0.0f) {
+      DrawSprite(sp, cx, cy, cw, ch, tint);
+      return;
+    }
+    const float uSpan = sp->u1 - sp->u0;
+    const float vSpan = sp->v1 - sp->v0;
+    float sl = std::clamp(sp->bl, 0.0f, sp->w);
+    float sr = std::clamp(sp->br, 0.0f, sp->w - sl);
+    float st = std::clamp(sp->bt, 0.0f, sp->h);
+    float sb = std::clamp(sp->bb, 0.0f, sp->h - st);
+
+    float dl = sl * borderScaleCanvasPerSrcPx;
+    float dr = sr * borderScaleCanvasPerSrcPx;
+    float dt = st * borderScaleCanvasPerSrcPx;
+    float db = sb * borderScaleCanvasPerSrcPx;
+
+    if (dl + dr > cw && (dl + dr) > 0.0001f) {
+      float f = cw / (dl + dr);
+      dl *= f; dr *= f;
+    }
+    if (dt + db > ch && (dt + db) > 0.0001f) {
+      float f = ch / (dt + db);
+      dt *= f; db *= f;
+    }
+
+    const float xs[4] = {cx, cx + dl, cx + cw - dr, cx + cw};
+    const float ys[4] = {cy, cy + dt, cy + ch - db, cy + ch};
+    const float us[4] = {
+        sp->u0,
+        sp->u0 + uSpan * (sl / sp->w),
+        sp->u1 - uSpan * (sr / sp->w),
+        sp->u1,
+    };
+    const float vs[4] = {
+        sp->v0,
+        sp->v0 + vSpan * (st / sp->h),
+        sp->v1 - vSpan * (sb / sp->h),
+        sp->v1,
+    };
+
+    for (int ry = 0; ry < 3; ++ry) {
+      const float qh = ys[ry + 1] - ys[ry];
+      if (qh <= 0.0005f || vs[ry + 1] <= vs[ry]) continue;
+      for (int rx = 0; rx < 3; ++rx) {
+        const float qw = xs[rx + 1] - xs[rx];
+        if (qw <= 0.0005f || us[rx + 1] <= us[rx]) continue;
+        PushQuadPx(PxX(xs[rx]), PxY(ys[ry]), PxW(qw), PxH(qh), tint, tint, tint, 5.0f,
+                   0.0f, 0.0f, 0.0f, us[rx], vs[ry], us[rx + 1], vs[ry + 1]);
+      }
+    }
+  }
+
+  void DrawCursorSprite(const HudUiAtlas &atlas, float cx, float cy, float cw, float ch,
+                        float pulse, float alpha) {
+    if (!atlas.cursorFrame) {
+      DrawSelectionBrackets(cx, cy, cw, ch, pulse);
+      return;
+    }
+    const float out = 1.6f + 0.55f * pulse;
+    const float cornerScale = 0.25f; // ~6 canvas units per 24px BDSP corner
+    if (atlas.cursorEff) {
+      const float effOut = out + 0.5f;
+      DrawSprite9Slice(atlas.cursorEff, cx - effOut, cy - effOut,
+                       cw + effOut * 2.0f, ch + effOut * 2.0f, cornerScale,
+                       C4(255, 240, 220, (0.28f + 0.22f * pulse) * alpha));
+    }
+    DrawSprite9Slice(atlas.cursorFrame, cx - out, cy - out,
+                     cw + out * 2.0f, ch + out * 2.0f, cornerScale,
+                     C4(255, 255, 255, alpha));
+  }
+
+  void DrawPokeBall(float cx, float cy, float r, int state, float alpha) {
+    if (state == SIM_HUDHD_BALL_EMPTY) {
+      Circle(cx, cy, r * 0.85f, C4(95, 102, 115, 0.45f * alpha), C4(70, 76, 86, 0.45f * alpha),
+             0.35f, C4(160, 168, 180, 0.4f * alpha));
+      return;
+    }
+    Color4 top = C4(232, 66, 62, alpha);
+    Color4 bot = C4(246, 248, 252, alpha);
+    if (state == SIM_HUDHD_BALL_STATUS) {
+      top = C4(238, 168, 42, alpha);
+    } else if (state == SIM_HUDHD_BALL_FAINTED) {
+      top = C4(110, 114, 122, 0.8f * alpha);
+      bot = C4(82, 86, 94, 0.8f * alpha);
+    }
+    Circle(cx, cy, r, top, bot, 0.45f, C4(34, 38, 44, alpha));
+    Line(cx - r * 0.82f, cy, cx + r * 0.82f, cy, r * 0.34f, C4(34, 38, 44, alpha));
+    Circle(cx, cy, r * 0.34f, C4(248, 250, 252, alpha), C4(220, 226, 234, alpha),
+           0.35f, C4(34, 38, 44, alpha));
+  }
+
+  void DrawGenderBadge(float cx, float cy, int gender, float alpha) {
+    if (gender == SIM_HUDHD_GENDER_NONE) return;
+    const bool male = (gender == SIM_HUDHD_GENDER_MALE);
+    Color4 bgTop = male ? C4(48, 146, 244, alpha) : C4(240, 82, 118, alpha);
+    Color4 bgBot = male ? C4(26, 108, 206, alpha) : C4(204, 48, 86, alpha);
+    Circle(cx, cy, 3.3f, bgTop, bgBot, 0.35f, C4(255, 255, 255, 0.8f * alpha));
+    Color4 fg = C4(255, 255, 255, alpha);
+    // Ring
+    Circle(cx - (male ? 0.35f : 0.0f), cy + (male ? 0.35f : -0.55f), 1.35f,
+           C4(0, 0, 0, 0.0f), C4(0, 0, 0, 0.0f), 0.65f, fg);
+    if (male) {
+      Line(cx + 0.55f, cy - 0.55f, cx + 1.75f, cy - 1.75f, 0.65f, fg);
+      Line(cx + 0.95f, cy - 1.75f, cx + 1.75f, cy - 1.75f, 0.6f, fg);
+      Line(cx + 1.75f, cy - 1.75f, cx + 1.75f, cy - 0.95f, 0.6f, fg);
+    } else {
+      Line(cx, cy + 0.7f, cx, cy + 2.15f, 0.65f, fg);
+      Line(cx - 0.9f, cy + 1.5f, cx + 0.9f, cy + 1.5f, 0.6f, fg);
+    }
+  }
+
+  void DrawSelectionBrackets(float cx, float cy, float cw, float ch, float pulse) {
+    const float out = 1.1f + 0.45f * pulse;
+    const float len = 4.2f;
+    const float th = 1.15f;
+    Color4 col = C4(255, 255, 255, 0.88f + 0.12f * pulse);
+    const float x0 = cx - out, y0 = cy - out;
+    const float x1 = cx + cw + out, y1 = cy + ch + out;
+    Line(x0, y0, x0 + len, y0, th, col); Line(x0, y0, x0, y0 + len, th, col);
+    Line(x1, y0, x1 - len, y0, th, col); Line(x1, y0, x1, y0 + len, th, col);
+    Line(x0, y1, x0 + len, y1, th, col); Line(x0, y1, x0, y1 - len, th, col);
+    Line(x1, y1, x1 - len, y1, th, col); Line(x1, y1, x1, y1 - len, th, col);
+  }
+
+  void DrawButtonIcon(int style, float ix, float iy, float r, Color4 col) {
+    switch (style) {
+      case SIM_HUDHD_BUTTON_FIGHT: {
+        // Dynamic 8-ray starburst + center Poké Ball silhouette
+        for (int i = 0; i < 8; ++i) {
+          float ang = i * 0.785398f + 0.18f;
+          float c = std::cos(ang), s = std::sin(ang);
+          float rIn = (i % 2 == 0) ? r * 0.42f : r * 0.52f;
+          float rOut = (i % 2 == 0) ? r * 1.04f : r * 0.88f;
+          Line(ix + c * rIn, iy + s * rIn,
+               ix + c * rOut, iy + s * rOut, 1.25f, col);
+        }
+        Circle(ix, iy, r * 0.42f, C4(0, 0, 0, 0.0f), C4(0, 0, 0, 0.0f), 1.25f, col);
+        Circle(ix, iy, r * 0.14f, col, col);
+        break;
+      }
+      case SIM_HUDHD_BUTTON_POKEMON: {
+        Circle(ix, iy, r * 0.88f, C4(0, 0, 0, 0.0f), C4(0, 0, 0, 0.0f), 1.35f, col);
+        Line(ix - r * 0.84f, iy, ix - r * 0.26f, iy, 1.25f, col);
+        Line(ix + r * 0.26f, iy, ix + r * 0.84f, iy, 1.25f, col);
+        Circle(ix, iy, r * 0.26f, C4(0, 0, 0, 0.0f), C4(0, 0, 0, 0.0f), 1.15f, col);
+        break;
+      }
+      case SIM_HUDHD_BUTTON_BAG: {
+        // Satchel outline: rounded body + top handle + flap line + clasp
+        float bw = r * 1.55f, bh = r * 1.25f;
+        RoundRect(ix - bw * 0.5f, iy - bh * 0.35f, bw, bh, 2.2f,
+                  C4(0, 0, 0, 0.0f), C4(0, 0, 0, 0.0f), 1.25f, col);
+        Line(ix - bw * 0.24f, iy - bh * 0.35f, ix - bw * 0.16f, iy - bh * 0.68f, 1.15f, col);
+        Line(ix - bw * 0.16f, iy - bh * 0.68f, ix + bw * 0.16f, iy - bh * 0.68f, 1.15f, col);
+        Line(ix + bw * 0.16f, iy - bh * 0.68f, ix + bw * 0.24f, iy - bh * 0.35f, 1.15f, col);
+        Line(ix - bw * 0.46f, iy + bh * 0.06f, ix + bw * 0.46f, iy + bh * 0.06f, 1.10f, col);
+        Circle(ix, iy + bh * 0.06f, 1.25f, col, col);
+        break;
+      }
+      case SIM_HUDHD_BUTTON_RUN: {
+        // Running figure line art
+        Circle(ix + r * 0.24f, iy - r * 0.58f, r * 0.24f, C4(0, 0, 0, 0.0f), C4(0, 0, 0, 0.0f), 1.15f, col);
+        Line(ix + r * 0.16f, iy - r * 0.32f, ix - r * 0.12f, iy + r * 0.20f, 1.30f, col);
+        Line(ix - r * 0.48f, iy - r * 0.16f, ix + r * 0.48f, iy - r * 0.04f, 1.20f, col);
+        Line(ix - r * 0.12f, iy + r * 0.20f, ix + r * 0.42f, iy + r * 0.72f, 1.25f, col);
+        Line(ix - r * 0.12f, iy + r * 0.20f, ix - r * 0.52f, iy + r * 0.66f, 1.25f, col);
+        break;
+      }
+      case SIM_HUDHD_BUTTON_CANCEL: {
+        Line(ix - r * 0.45f, iy, ix + r * 0.45f, iy, 0.9f, col);
+        Line(ix - r * 0.45f, iy, ix - r * 0.05f, iy - r * 0.38f, 0.9f, col);
+        Line(ix - r * 0.45f, iy, ix - r * 0.05f, iy + r * 0.38f, 0.9f, col);
+        break;
+      }
+      case SIM_HUDHD_BUTTON_MEGA: {
+        Line(ix, iy - r * 0.6f, ix + r * 0.55f, iy, 0.9f, col);
+        Line(ix + r * 0.55f, iy, ix, iy + r * 0.6f, 0.9f, col);
+        Line(ix, iy + r * 0.6f, ix - r * 0.55f, iy, 0.9f, col);
+        Line(ix - r * 0.55f, iy, ix, iy - r * 0.6f, 0.9f, col);
+        break;
+      }
+      default: break;
+    }
+  }
+
+  void DrawCategoryIcon(float cx, float cy, int cat, float alpha) {
+    if (cat == SIM_HUDHD_CAT_PHYSICAL) {
+      Circle(cx, cy, 3.2f, C4(236, 92, 54, alpha), C4(192, 48, 28, alpha),
+             0.4f, C4(255, 255, 255, 0.8f * alpha));
+      for (int i = 0; i < 6; ++i) {
+        float ang = i * 1.0471975f;
+        Line(cx, cy, cx + std::cos(ang) * 2.2f, cy + std::sin(ang) * 2.2f,
+             0.65f, C4(255, 232, 130, alpha));
+      }
+    } else if (cat == SIM_HUDHD_CAT_SPECIAL) {
+      Circle(cx, cy, 3.2f, C4(72, 108, 212, alpha), C4(44, 72, 168, alpha),
+             0.4f, C4(255, 255, 255, 0.8f * alpha));
+      Circle(cx, cy, 1.9f, C4(0, 0, 0, 0.0f), C4(0, 0, 0, 0.0f),
+             0.55f, C4(186, 224, 255, alpha));
+      Circle(cx, cy, 0.75f, C4(235, 245, 255, alpha), C4(235, 245, 255, alpha));
+    } else {
+      Circle(cx, cy, 3.2f, C4(142, 150, 164, alpha), C4(98, 106, 120, alpha),
+             0.4f, C4(255, 255, 255, 0.8f * alpha));
+      Line(cx - 1.8f, cy, cx + 1.8f, cy, 0.7f, C4(248, 250, 252, alpha));
+    }
+  }
