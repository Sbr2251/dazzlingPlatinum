+// Debug automation (any PC build; off unless the variables are set), for checking a build without a person at the keyboard:
+//   SIM_DEBUG_SHOT_DIR=<dir> SIM_DEBUG_SHOT_EVERY=<frames>  saves the window every N frames as <dir>/frame_<n>.bmp
+//   SIM_DEBUG_KEYS="<frame>:<keys>[/<hold frames>],..."     presses DS buttons at those frames (keys joined by +: A B X Y L R START SELECT UP DOWN LEFT RIGHT;
+//                                                            hold 6 frames unless given), e.g. "300:START,420:A/2,600:A+B"
+//   SIM_DEBUG_EXIT_FRAME=<frame>                            exits after that frame
+//   (a key T<x>;<y> touches the bottom screen at DS coordinates, e.g. "6000:T120;82/4")
+//   SIM_DEBUG_FAST=1                                        no frame cap, no vsync
+//   SIM_DEBUG_EXPORT_SAVE=<frame>:<path>, SIM_DEBUG_IMPORT_SAVE=<frame>:<path>  export / import the save (no dialogs; import restarts)
+//   SIM_DEBUG_PAUSE=<from>-<to>                             paused for those frames (as with F8)
+//   SIM_DEBUG_FF_HOLD=1                                     as if the fast-forward key were held (SIM_FAST_FORWARD_SPEED x 60 fps)
+//   SIM_DEBUG_DUMP_FRAME=<frame>                            prints the 2D display/blend registers and BG palette at that frame
+static int sDebugTouch = 0;   // SIM_DEBUG_KEYS holds the touch screen: the mouse does not override it
+static u32 SIM_DebugKeyMask(const char *s, u32 *xy) {
+  static const struct { const char *n; u32 bit; int isXY; } names[] = {
+    {"A", 1u << 0, 0}, {"B", 1u << 1, 0}, {"SELECT", 1u << 2, 0}, {"START", 1u << 3, 0}, {"RIGHT", 1u << 4, 0}, {"LEFT", 1u << 5, 0},
+    {"UP", 1u << 6, 0}, {"DOWN", 1u << 7, 0}, {"R", 1u << 8, 0}, {"L", 1u << 9, 0}, {"X", 1u << 10, 1}, {"Y", 1u << 11, 1}};
+  u32 m = 0; *xy = 0;
+  std::string str(s);
+  size_t start = 0;
+  while (start <= str.size()) {
+    size_t end = str.find('+', start); if (end == std::string::npos) end = str.size();
+    std::string k = str.substr(start, end - start);
+    for (auto &n : names) if (k == n.n) { if (n.isXY) *xy |= n.bit; else m |= n.bit; }
+    start = end + 1;
+  }
+  return m;
+}
