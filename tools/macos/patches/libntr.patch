+// SDL3 GPU render backend: frame skeleton, post pass, present, readback,
+// capture, hi-res overlay and ImGui glue. The 3D and 2D layer work lives
+// in the sibling workstreams; until those draws land, G3 draws are
+// accepted and dropped and the composite is the cleared frame, so the
+// frame lifecycle, present and screenshot paths run end to end.
+#include <simulator/sim_render_backend.hpp>
+#include <simulator/gpu/gpu.hpp>
