+    case SDL_GAMEPAD_BUTTON_EAST: bit = kB; break;
+    case SDL_GAMEPAD_BUTTON_WEST: bit = kX; break;
+    case SDL_GAMEPAD_BUTTON_NORTH: bit = kY; break;
+    case SDL_GAMEPAD_BUTTON_LEFT_SHOULDER: bit = kL; break;
+    case SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER: bit = kR; break;
+    case SDL_GAMEPAD_BUTTON_START: bit = kStart; break;
+    case SDL_GAMEPAD_BUTTON_BACK: bit = kSelect; break;
+    case SDL_GAMEPAD_BUTTON_DPAD_UP: bit = kUp; break;
+    case SDL_GAMEPAD_BUTTON_DPAD_DOWN: bit = kDown; break;
+    case SDL_GAMEPAD_BUTTON_DPAD_LEFT: bit = kLeft; break;
+    case SDL_GAMEPAD_BUTTON_DPAD_RIGHT: bit = kRight; break;
