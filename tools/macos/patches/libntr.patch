+            return;
+        }
+        color = vec4(obj.rgb, 1.0); currentBgDrawn = 4; return;
+    }
+    // Bitmap OBJ per-sprite alpha: blend with the pixel below by alpha.
+    color.rgb = obj.rgb * oa + below * (1.0 - oa);
+    color.a = 1.0; currentBgDrawn = 4;
+}
 void main()
