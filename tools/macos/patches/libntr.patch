+  void DrawHiResOverlay(const HiResOverlayInput &input) override {
+    if (input.rgba8 == nullptr || input.width <= 0 || input.height <= 0)
+      return;
+    InitHiRes();
+    if (!mHiResProgram) return;
+    glBindFramebuffer(GL_FRAMEBUFFER, mCurrentFbo);
+    glViewport(mCurrentViewport[0], mCurrentViewport[1],
+               mCurrentViewport[2], mCurrentViewport[3]);
+    glUseProgram(mHiResProgram);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, mHiResTex);
+    if (input.dirty)
+      glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, input.width, input.height,
+                      GL_RGBA, GL_UNSIGNED_BYTE, input.rgba8);
+    if (input.wideMode) {
+      // Wide: source rows [srcY, srcY + srcH) into the destination rect
+      // (normalised, top-left origin, over the target). The quad is in
+      // NDC relative to the current viewport (mCurrentViewport, GL
+      // bottom-left origin, in FBO pixels of size mPostW x mPostH).
+      // v = 0 is the first uploaded row, as in the classic quad below.
+      int srcH = input.srcH > 0 ? input.srcH : input.height - input.srcY;
+      if (srcH <= 0) return;
+      glBindBuffer(GL_ARRAY_BUFFER, mHiResVbo);
+      float vx = (float)mCurrentViewport[0], vy = (float)mCurrentViewport[1];
+      float vw = (float)mCurrentViewport[2], vh = (float)mCurrentViewport[3];
+      float x0 = (input.dstX * (float)mPostW - vx) / vw * 2.0f - 1.0f;
+      float x1 = ((input.dstX + input.dstW) * (float)mPostW - vx) / vw * 2.0f - 1.0f;
+      float yTop = ((1.0f - input.dstY) * (float)mPostH - vy) / vh * 2.0f - 1.0f;
+      float yBottom = ((1.0f - (input.dstY + input.dstH)) * (float)mPostH - vy) / vh * 2.0f - 1.0f;
+      float vTop = (float)input.srcY / (float)input.height;
+      float vBottom = (float)(input.srcY + srcH) / (float)input.height;
+      float quad[] = {
+          x0, yBottom, 0.0f, 0.0f, vBottom, x1, yBottom, 0.0f, 1.0f, vBottom,
+          x1, yTop, 0.0f, 1.0f, vTop, x0, yBottom, 0.0f, 0.0f, vBottom,
+          x1, yTop, 0.0f, 1.0f, vTop, x0, yTop, 0.0f, 0.0f, vTop,
+      };
+      glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_DYNAMIC_DRAW);
+      glBindVertexArray(mHiResVao);
+      glDisable(GL_DEPTH_TEST);
+      glEnable(GL_BLEND);
+      glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+      glDrawArrays(GL_TRIANGLES, 0, 6);
+      return;
+    }
+    glBindVertexArray(mHiResVao);
+    glDisable(GL_DEPTH_TEST);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    glDrawArrays(GL_TRIANGLES, 0, 6);
+  }
+
+  void DrawTouchpadOverlay(const TouchpadOverlayInput &input) override {
+    if (!input.rgba8 || input.width <= 0 || input.height <= 0) return;
+    InitHiRes();
+    if (!mHiResProgram) return;
+    // After RenderPost the default framebuffer holds the final image.
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    glViewport(0, 0, mPostW, mPostH);
+    glUseProgram(mHiResProgram);
+    glActiveTexture(GL_TEXTURE0);
+    if (!mTouchTex) { glGenTextures(1, &mTouchTex); glBindTexture(GL_TEXTURE_2D, mTouchTex); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE); glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE); }
+    glBindTexture(GL_TEXTURE_2D, mTouchTex);
+    if (mTouchW != input.width || mTouchH != input.height) {
+      glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, input.width, input.height, 0, GL_RGBA, GL_UNSIGNED_BYTE, input.rgba8);
+      mTouchW = input.width; mTouchH = input.height;
+    } else if (input.dirty) {
+      glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, input.width, input.height, GL_RGBA, GL_UNSIGNED_BYTE, input.rgba8);
+    }
+    glBindVertexArray(mHiResVao);
+    glDisable(GL_DEPTH_TEST);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+    glDrawArrays(GL_TRIANGLES, 0, 6);
+  }
