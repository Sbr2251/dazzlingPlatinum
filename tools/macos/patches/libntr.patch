diff --git a/libraries/sim/src/gpu/shaders/test_int.frag b/libraries/sim/src/gpu/shaders/test_int.frag
new file mode 100644
index 0000000..aa44ce5
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/test_int.frag
@@ -0,0 +1,14 @@
+#version 450
+// Integer textures are storage textures in SDL_GPU (SAMPLER is forbidden on
+// integer formats): uimage2D + imageLoad, bound with
+// Frame::BindFragmentStorageTexture. There is no usampler2D/texelFetch path.
+// Reference shader only: storage textures crash lavapipe on SDL 3.4.16, so the
+// self-test covers integer data through storage buffers (test_ssbo*.frag).
+layout(set = 2, binding = 0, r8ui) readonly uniform uimage2D uTex;
+layout(location = 0) in vec2 vUv;
+layout(location = 0) out vec4 o;
+void main() {
+    // 4x4 integer texture: each texel holds its index * 16.
+    uint v = imageLoad(uTex, ivec2(vUv * vec2(4.0, 4.0))).r;
+    o = vec4(float(v) / 255.0, 0.0, 0.0, 1.0);
+}
