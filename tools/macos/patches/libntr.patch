+void DrawSelectionBrackets(const HudExtDraw &ext, float x, float y, float w, float h, float pulse) {
+  if (ext.useBdspUi && ext.atlas && ext.atlas->cursorFrame) {
+    float pad = 1.6f + 0.35f * pulse;
+    ext.spriteNineSlice(ext.atlas->cursorFrame, x - pad, y - pad, w + pad * 2.0f, h + pad * 2.0f,
+                        0.16f, HudC4(255, 255, 255, 0.92f + 0.08f * pulse));
+    return;
+  }
+  float out = 1.1f + 0.4f * pulse;
+  float len = 4.4f;
+  float th = 1.15f;
+  HudExtColor col = HudC4(142, 222, 255, 0.90f + 0.10f * pulse);
+  float x0 = x - out, y0 = y - out;
+  float x1 = x + w + out, y1 = y + h + out;
+  ext.line(x0, y0, x0 + len, y0, th, col); ext.line(x0, y0, x0, y0 + len, th, col);
+  ext.line(x1, y0, x1 - len, y0, th, col); ext.line(x1, y0, x1, y0 + len, th, col);
+  ext.line(x0, y1, x0 + len, y1, th, col); ext.line(x0, y1, x0, y1 - len, th, col);
+  ext.line(x1, y1, x1 - len, y1, th, col); ext.line(x1, y1, x1, y1 - len, th, col);
+}
