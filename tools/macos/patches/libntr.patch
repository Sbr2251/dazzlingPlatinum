+#pragma once
+// fx_weather lane: weather post pass (fog, rain wet look, thunderstorm
+// lightning, Eterna light shafts, Stark heat haze, Everspring Fairy Sanctuary)
+// for the SDL GPU backend. Owns no targets; the backend runs it
+// composite -> temp and the existing post pass then samples the temp.
+#include <simulator/gpu/gpu.hpp>
+#include <SDL3/SDL.h>
+namespace SIM::Render {
+class FxWeather {
+ public:
+  // Returns true when a pass ran (dst now holds the result). The target is
+  // allocated on first use, so inactive effects consume no frame-sized VRAM.
+  bool Run(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+           SDL_GPUTexture *src, SIM::Gpu::Texture &dst,
+           SDL_GPUTextureFormat dstFormat, std::uint32_t w, std::uint32_t h,
+           int wideMode);
+ private:
+  std::uint64_t mFrame = 0;
+};
+class FxWater {
+ public:
+  bool Run(SIM::Gpu::Device &device, SIM::Gpu::Frame *frame,
+           SDL_GPUTexture *src, SIM::Gpu::Texture &dst,
+           SDL_GPUTextureFormat dstFormat, std::uint32_t w, std::uint32_t h,
+           int wideMode);
+ private:
+  std::uint64_t mFrame = 0;
+};
+} // namespace SIM::Render
