+FxBattle3D::LoadedBiome *FxBattle3D::LoadBiome(Device &device, Frame *frame, int biomeId) {
+  if (biomeId < 0 || biomeId >= SIM_BATTLE3D_BIOME_COUNT) {
+    biomeId = SIM_BATTLE3D_BIOME_PLAIN;
+  }
+  LoadedBiome &slot = mBiomes[biomeId];
+  if (slot.attempted) {
+    return slot.valid ? &slot : nullptr;
+  }
+  slot.attempted = true;
+
+  if (!mAssetDirProbed) {
+    mAssetDirProbed = true;
+    const char *envDir = std::getenv("SIM_BATTLE3D_DIR");
+    const char *dataDir = SIM_Platform_DataDir();
+    std::string exe = ExeDir();
+    const std::string probeFile = kBiomeFilenames[0];
+    std::string candidates[] = {
+        envDir ? std::string(envDir) : std::string(),
+        dataDir ? JoinPath(dataDir, "battle3d") : std::string(),
+        std::string("battle3d"),
+        exe.empty() ? std::string() : JoinPath(exe, "battle3d"),
+        exe.empty() ? std::string() : JoinPath(exe, "../Resources/game/battle3d"),
+        exe.empty() ? std::string() : JoinPath(exe, "../res/battle3d"),
+        std::string("res/battle3d"),
+        std::string("../res/battle3d"),
+    };
+    for (const auto &dir : candidates) {
+      if (!dir.empty() && FileExists(JoinPath(dir, probeFile))) {
+        mAssetDir = dir;
+        break;
+      }
+    }
+  }
+
+  if (mAssetDir.empty()) {
+    return nullptr;
+  }
+
+  std::string path = JoinPath(mAssetDir, kBiomeFilenames[biomeId]);
+  if (!FileExists(path)) {
+    path = JoinPath(mAssetDir, kBiomeFilenames[SIM_BATTLE3D_BIOME_PLAIN]);
+    if (!FileExists(path)) return nullptr;
+  }
+
+  if (!LoadBiomeFile(device, frame, path, slot)) {
+    slot.valid = false;
+    return nullptr;
+  }
+  slot.valid = true;
+  return &slot;
+}
+
+bool FxBattle3D::LoadBiomeFile(Device &device, Frame *frame,
+                               const std::string &path, LoadedBiome &out) {
+  FILE *f = std::fopen(path.c_str(), "rb");
+  if (!f) return false;
+  std::fseek(f, 0, SEEK_END);
+  long sz = std::ftell(f);
+  std::fseek(f, 0, SEEK_SET);
+  if (sz < (long)sizeof(B3DHeader) || sz > 64 * 1024 * 1024) {
+    std::fclose(f);
+    return false;
+  }
+  std::vector<std::uint8_t> bytes((std::size_t)sz);
+  if (std::fread(bytes.data(), 1, bytes.size(), f) != bytes.size()) {
+    std::fclose(f);
+    return false;
+  }
+  std::fclose(f);
+
+  B3DHeader hdr{};
+  std::memcpy(&hdr, bytes.data(), sizeof(hdr));
+  if (hdr.magic[0] != B3D_MAGIC_0 || hdr.magic[1] != B3D_MAGIC_1 ||
+      hdr.magic[2] != B3D_MAGIC_2 || hdr.magic[3] != B3D_MAGIC_3 ||
+      hdr.version != B3D_VERSION || hdr.numVertices == 0 || hdr.numIndices == 0) {
+    return false;
+  }
+
+  std::size_t pos = sizeof(B3DHeader);
+  std::size_t texBytes = (std::size_t)hdr.numTextures * sizeof(B3DTextureDesc);
+  std::size_t smBytes = (std::size_t)hdr.numSubmeshes * sizeof(B3DSubmeshDesc);
+  std::size_t vBytes = (std::size_t)hdr.numVertices * sizeof(B3DVertex);
+  std::size_t iBytes = (std::size_t)hdr.numIndices * sizeof(std::uint32_t);
+  if (pos + texBytes + smBytes + vBytes + iBytes > bytes.size()) {
+    return false;
+  }
+
+  const auto *texDescs = reinterpret_cast<const B3DTextureDesc *>(bytes.data() + pos);
+  pos += texBytes;
+  const auto *smDescs = reinterpret_cast<const B3DSubmeshDesc *>(bytes.data() + pos);
+  pos += smBytes;
+  const void *vPtr = bytes.data() + pos;
+  pos += vBytes;
+  const void *iPtr = bytes.data() + pos;
+  pos += iBytes;
+
+  // Create and upload GPU vertex & index buffers.
+  SDL_GPUBufferCreateInfo vInfo{};
+  vInfo.usage = SDL_GPU_BUFFERUSAGE_VERTEX;
+  vInfo.size = (Uint32)vBytes;
+  out.vertexBuffer = SDL_CreateGPUBuffer(device.Handle(), &vInfo);
+  if (!out.vertexBuffer) return false;
+
+  SDL_GPUBufferCreateInfo iInfo{};
+  iInfo.usage = SDL_GPU_BUFFERUSAGE_INDEX;
+  iInfo.size = (Uint32)iBytes;
+  out.indexBuffer = SDL_CreateGPUBuffer(device.Handle(), &iInfo);
+  if (!out.indexBuffer) {
+    SDL_ReleaseGPUBuffer(device.Handle(), out.vertexBuffer);
+    out.vertexBuffer = nullptr;
+    return false;
+  }
+
+  frame->UploadBuffer(out.vertexBuffer, 0, vPtr, (Uint32)vBytes, true);
+  frame->UploadBuffer(out.indexBuffer, 0, iPtr, (Uint32)iBytes, true);
+  out.numVertices = hdr.numVertices;
+  out.numIndices = hdr.numIndices;
+
+  // Upload textures.
+  out.textures.resize(hdr.numTextures);
+  for (std::uint32_t t = 0; t < hdr.numTextures; t++) {
+    const B3DTextureDesc &td = texDescs[t];
+    std::size_t pxBytes = (std::size_t)td.width * (std::size_t)td.height * 4u;
+    if (td.width == 0 || td.height == 0 ||
+        (std::size_t)td.dataOffset + pxBytes > bytes.size()) {
+      continue;
+    }
+    if (out.textures[t].tex.Create(device, TextureDesc::Rgba8(td.width, td.height, "battle3d_tex"))) {
+      out.textures[t].flags = td.flags;
+      frame->UploadTexture(out.textures[t].tex, bytes.data() + td.dataOffset);
+    }
+  }
+
+  out.submeshes.reserve(hdr.numSubmeshes);
+  for (std::uint32_t s = 0; s < hdr.numSubmeshes; s++) {
+    const B3DSubmeshDesc &sd = smDescs[s];
+    if (sd.indexCount == 0 || sd.firstIndex + sd.indexCount > hdr.numIndices) continue;
+    LoadedSubmesh ls;
+    ls.firstIndex = sd.firstIndex;
+    ls.indexCount = sd.indexCount;
+    ls.textureIndex = sd.textureIndex;
+    ls.flags = sd.flags;
+    ls.roughness = sd.roughness;
+    ls.fogFactor = sd.fogFactor;
+    ls.isSky = ((sd.flags & B3D_SUBMESH_UNLIT) != 0) && (sd.fogFactor < 0.05f);
+    out.submeshes.push_back(ls);
+  }
+  return !out.submeshes.empty();
+}
+
+void FxBattle3D::DrainCompletedLoads(Device &device, Frame *frame) {
+  if (!frame) return;
+  bool anyUploaded = false;
+
+  // Upload at most 1 completed arena per frame.
+  int arenaBiome = -1;
+  GltfArenaCpuData arenaCpu;
+  if (gAsyncLoader.PopAnyCompletedArena(arenaBiome, arenaCpu)) {
+    if (arenaBiome >= 0 && arenaBiome < SIM_BATTLE3D_BIOME_COUNT) {
+      GltfArena &slot = mGltfArenas[arenaBiome];
+      if (!slot.valid) {
+        if (!UploadGltfArenaCpu(device, frame, std::move(arenaCpu), slot)) {
+          slot.valid = false;
+          std::lock_guard<std::mutex> lock(gProbeMutex);
+          gFailedArenas.insert(arenaBiome);
+        } else {
+          slot.attempted = true;
+          anyUploaded = true;
+        }
+      }
+    }
+  }
+
+  // Upload up to 2 completed mon models per frame (keeps GPU transfer spikes bounded).
+  for (int n = 0; n < 2; n++) {
+    std::uint64_t key = 0;
+    GltfModelCpuData modelCpu;
+    if (!gAsyncLoader.PopAnyCompletedModel(key, modelCpu)) break;
+    auto it = mModels.find(key);
+    if (it != mModels.end() && it->second.model && it->second.model->valid) {
+      continue;
+    }
+    auto model = std::make_unique<GltfModel>();
+    model->attempted = true;
+    if (!UploadGltfModelCpu(device, frame, std::move(modelCpu), *model)) {
+      model->valid = false;
+      std::lock_guard<std::mutex> lock(gProbeMutex);
+      gFailedModels.insert(key);
+    } else {
+      {
+        std::lock_guard<std::mutex> lock(gProbeMutex);
+        gReadyModels.insert(key);
+      }
+      CachedModelEntry entry;
+      entry.model = std::move(model);
+      entry.lastUsedFrame = mFrameCounter;
+      mModels[key] = std::move(entry);
+      anyUploaded = true;
+    }
+  }
+
+  // Upload up to 2 completed actor models per frame.
+  for (int n = 0; n < 2; n++) {
+    int kind = 0;
+    GltfModelCpuData actorCpu;
+    if (!gAsyncLoader.PopAnyCompletedActor(kind, actorCpu)) break;
+    auto it = mActors.find(kind);
+    if (it != mActors.end() && it->second && it->second->valid) {
+      continue;
+    }
+    auto model = std::make_unique<GltfModel>();
+    model->attempted = true;
+    if (!UploadGltfModelCpu(device, frame, std::move(actorCpu), *model)) {
+      model->valid = false;
+      std::lock_guard<std::mutex> lock(gProbeMutex);
+      gFailedActors.insert(kind);
+    } else {
+      mActors[kind] = std::move(model);
+    }
+  }
+
+  if (anyUploaded) {
+    EvictLruModelsIfNeeded(device);
+  }
+}
+
+void FxBattle3D::EvictLruModelsIfNeeded(Device &device) {
+  std::size_t totalBytes = 0;
+  for (const auto &kv : mModels) {
+    if (kv.second.model && kv.second.model->valid) {
+      totalBytes += kv.second.model->vramBytes;
+    }
+  }
+  if (totalBytes <= kModelVramBudgetBytes) return;
+
+  while (totalBytes > kModelVramBudgetBytes) {
+    auto victim = mModels.end();
+    for (auto it = mModels.begin(); it != mModels.end(); ++it) {
+      const auto &entry = it->second;
+      if (!entry.model || !entry.model->valid) continue;
+      if (mFrameCounter < entry.lastUsedFrame ||
+          (mFrameCounter - entry.lastUsedFrame) < kModelEvictMinAgeFrames) {
+        continue;
+      }
+      bool latched = false;
+      for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+        if (mLatchedBattlers[i].model == entry.model.get()) {
+          latched = true;
+          break;
+        }
+      }
+      if (latched) continue;
+      if (victim == mModels.end() || entry.lastUsedFrame < victim->second.lastUsedFrame) {
+        victim = it;
+      }
+    }
+    if (victim == mModels.end()) break;
+
+    const std::uint64_t evictKey = victim->first;
+    const std::size_t freed = victim->second.model->vramBytes;
+    ReleaseGltfModel(device, *victim->second.model);
+    mModels.erase(victim);
+    {
+      std::lock_guard<std::mutex> lock(gProbeMutex);
+      gReadyModels.erase(evictKey);
+    }
+    totalBytes = (totalBytes > freed) ? (totalBytes - freed) : 0;
+  }
+}
+
+void FxBattle3D::ReleaseNonActiveArenas(Device &device) {
+  if (!gClearNonActiveArenasPending.exchange(false, std::memory_order_acq_rel)) {
+    return;
+  }
+  if (!device.Handle()) return;
+  for (int i = 0; i < SIM_BATTLE3D_BIOME_COUNT; i++) {
+    if (i == mLastActiveBiome) continue;
+    if (mGltfArenas[i].valid || mGltfArenas[i].vertexBuffer || mGltfArenas[i].indexBuffer) {
+      if (mStaticShadowArenaPtr == &mGltfArenas[i]) {
+        mStaticShadowValid = false;
+        mStaticShadowArenaPtr = nullptr;
+      }
+      ReleaseGltfArena(device, mGltfArenas[i]);
+    }
+  }
+}
+
+GltfArena *FxBattle3D::LoadGltfArenaSlot(Device &device, Frame *frame, int biomeId) {
+  if (biomeId < 0 || biomeId >= SIM_BATTLE3D_BIOME_COUNT) return nullptr;
+  GltfArena &slot = mGltfArenas[biomeId];
+  if (slot.valid) {
+    return &slot;
+  }
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    if (gFailedArenas.count(biomeId) != 0) return nullptr;
+  }
+
+  std::string path = ResolveArenaPath(biomeId);
+  if (path.empty()) return nullptr;
+
+  if (!SIM_Headless_Enabled()) {
+    // P1: Interactive mode loads GLB arena asynchronously on the worker thread.
+    gAsyncLoader.EnqueueArena(biomeId, path);
+    return nullptr;
+  }
+
+  // Headless mode: deterministic single-parse synchronous load.
+  slot.attempted = true;
+  if (!LoadGltfArena(device, frame, path, slot)) {
+    slot.valid = false;
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    gFailedArenas.insert(biomeId);
+    return nullptr;
+  }
+  return &slot;
+}
+
+const GltfModel *FxBattle3D::LoadMonModel(Device &device, Frame *frame,
+                                          int species, int form, int isShiny) {
+  if (species <= 0) return nullptr;
+  const std::uint64_t key = MakeModelKey(species, form, isShiny);
+  auto it = mModels.find(key);
+  if (it != mModels.end() && it->second.model && it->second.model->valid) {
+    it->second.lastUsedFrame = mFrameCounter;
+    return it->second.model.get();
+  }
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    if (gFailedModels.count(key) != 0) return nullptr;
+  }
+
+  // Consume any already-parsed CPU data (from worker thread or headless IsModelReady single-parse).
+  GltfModelCpuData preParsed;
+  if (gAsyncLoader.PopCompletedModel(key, preParsed)) {
+    auto model = std::make_unique<GltfModel>();
+    model->attempted = true;
+    if (!UploadGltfModelCpu(device, frame, std::move(preParsed), *model)) {
+      model->valid = false;
+      std::lock_guard<std::mutex> lock(gProbeMutex);
+      gFailedModels.insert(key);
+      return nullptr;
+    }
+    {
+      std::lock_guard<std::mutex> lock(gProbeMutex);
+      gReadyModels.insert(key);
+    }
+    const GltfModel *ptr = model.get();
+    CachedModelEntry entry;
+    entry.model = std::move(model);
+    entry.lastUsedFrame = mFrameCounter;
+    mModels[key] = std::move(entry);
+    EvictLruModelsIfNeeded(device);
+    return ptr;
+  }
+
+  std::string path = ResolveModelPath(species, form, isShiny);
+  if (path.empty()) return nullptr;
+
+  if (!SIM_Headless_Enabled()) {
+    // P1: Interactive mode loads GLB model asynchronously on the worker thread.
+    gAsyncLoader.EnqueueModel(key, path);
+    return nullptr;
+  }
+
+  // Headless mode: deterministic single-parse synchronous load.
+  GltfModelCpuData cpu;
+  if (!LoadGltfModelCpu(path, cpu)) {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    gFailedModels.insert(key);
+    return nullptr;
+  }
+  RecordModelCpuMetadata(key, cpu);
+
+  auto model = std::make_unique<GltfModel>();
+  model->attempted = true;
+  if (!UploadGltfModelCpu(device, frame, std::move(cpu), *model)) {
+    model->valid = false;
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    gFailedModels.insert(key);
+    return nullptr;
+  }
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    gReadyModels.insert(key);
+  }
+  const GltfModel *ptr = model.get();
+  CachedModelEntry entry;
+  entry.model = std::move(model);
+  entry.lastUsedFrame = mFrameCounter;
+  mModels[key] = std::move(entry);
+  EvictLruModelsIfNeeded(device);
+  return ptr;
+}
+
+const GltfModel *FxBattle3D::LoadActorModel(Device &device, Frame *frame, int kind) {
+  if (kind <= 0) return nullptr;
+  auto it = mActors.find(kind);
+  if (it != mActors.end() && it->second && it->second->valid) {
+    return it->second.get();
+  }
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    if (gFailedActors.count(kind) != 0) return nullptr;
+  }
+
+  std::string path = ResolveActorPath(kind);
+  if (path.empty()) return nullptr;
+
+  if (!SIM_Headless_Enabled()) {
+    gAsyncLoader.EnqueueActor(kind, path);
+    return nullptr;
+  }
+
+  auto model = std::make_unique<GltfModel>();
+  model->attempted = true;
+  if (!LoadGltfModel(device, frame, path, *model)) {
+    model->valid = false;
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    gFailedActors.insert(kind);
+    return nullptr;
+  }
+  const GltfModel *ptr = model.get();
+  mActors[kind] = std::move(model);
+  return ptr;
+}
+
+void FxBattle3D::RenderShadowPass(Device &device, Frame *frame, Phase phase) {
+  if (!mHasShadowMap || !mShadowMap) return;
+
+  VertexLayout b3dLayout;
+  b3dLayout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(B3DVertex, pos));
+  b3dLayout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(B3DVertex, norm));
+  b3dLayout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(B3DVertex, uv));
+  b3dLayout.Add(3, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(B3DVertex, color));
+  b3dLayout.stride = sizeof(B3DVertex);
+
+  VertexLayout skinLayout;
+  skinLayout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(GltfSkinnedVertex, pos));
+  skinLayout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(GltfSkinnedVertex, norm));
+  skinLayout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(GltfSkinnedVertex, uv));
+  skinLayout.Add(3, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(GltfSkinnedVertex, color));
+  skinLayout.Add(4, SDL_GPU_VERTEXELEMENTFORMAT_UINT4, (Uint32)offsetof(GltfSkinnedVertex, joints));
+  skinLayout.Add(5, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(GltfSkinnedVertex, weights));
+  skinLayout.stride = sizeof(GltfSkinnedVertex);
+
+  auto hasDynamicCasters = [&]() {
+    for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+      if (mLatchedBattlers[i].model && mLatchedBattlers[i].model->valid &&
+          mLatchedBattlers[i].combinedAlpha > 0.1f) return true;
+    }
+    for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+      if (mLatchedActors[i].model && mLatchedActors[i].model->valid &&
+          mLatchedActors[i].combinedAlpha > 0.1f) return true;
+    }
+    return false;
+  };
+
+  auto renderShadowCaster = [&](const LatchedBattler &lb) {
+    if (!lb.model || !lb.model->valid || lb.combinedAlpha <= 0.1f) return;
+    const GltfModel &mon = *lb.model;
+
+    frame->BindVertexBuffer(mon.vertexBuffer, 0, 0);
+    frame->BindIndexBuffer(mon.indexBuffer, 0, SDL_GPU_INDEXELEMENTSIZE_32BIT);
+
+    std::int32_t lastSkin = -2;
+    for (const auto &prim : mon.primitives) {
+      GltfMaterial mat{};
+      if (prim.materialIndex >= 0 && (std::size_t)prim.materialIndex < mon.materials.size()) {
+        mat = mon.materials[prim.materialIndex];
+        if (mat.isFlame) continue;
+      }
+      if (mat.alphaMode == GltfAlphaMode::Blend) continue;
+
+      PipelineKey key;
+      key.vertex = &Shaders::battle3d_skinned_shadow_vert;
+      key.fragment = &Shaders::battle3d_skinned_shadow_frag;
+      key.layout = skinLayout;
+      key.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+      key.cull = mat.doubleSided ? SDL_GPU_CULLMODE_NONE : SDL_GPU_CULLMODE_BACK;
+      key.depthTest = true;
+      key.depthWrite = true;
+      key.depthCompare = SDL_GPU_COMPAREOP_LESS;
+      key.blend = Blend::Opaque;
+      key.colorFormat = SDL_GPU_TEXTUREFORMAT_INVALID;
+      key.depthFormat = mShadowFormat;
+
+      SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+      if (!pipe) continue;
+      frame->BindPipeline(pipe);
+
+      // P7: Reuse joint palette built once per model per frame in PrepareAndRenderShadow.
+      if (prim.skinIndex != lastSkin) {
+        if (prim.skinIndex >= 0 &&
+            static_cast<std::size_t>(prim.skinIndex) < lb.skinPalettes.size()) {
+          frame->PushVertexUniform(1, lb.skinPalettes[static_cast<std::size_t>(prim.skinIndex)].joints,
+                                   sizeof(SkinnedJointsUniforms));
+        } else {
+          frame->PushVertexUniform(1, IdentityJointsUniforms());
+        }
+        lastSkin = prim.skinIndex;
+      }
+
+      bool hasTex = mat.baseColorTex >= 0 &&
+                    (std::size_t)mat.baseColorTex < mon.textures.size() &&
+                    (bool)mon.textures[mat.baseColorTex].tex;
+      if (hasTex) {
+        const auto &gt = mon.textures[mat.baseColorTex];
+        frame->BindFragmentSampler(0, gt.tex.Handle(),
+                                   device.Sampler(SamplerKey::LinearMipmap(gt.wrapU, gt.wrapV, 1)));
+      } else if (mWhiteDummy) {
+        frame->BindFragmentSampler(0, mWhiteDummy.Handle(), device.Sampler(SamplerKey::Nearest()));
+      }
+
+      SkinnedShadowVertUniforms vu{};
+      std::memcpy(vu.lightViewProj, mLightViewProj, sizeof(mLightViewProj));
+      if (prim.skinIndex >= 0) {
+        std::memcpy(vu.modelMat, lb.modelMat, sizeof(lb.modelMat));
+        vu.params[0] = 1.0f;
+      } else if (prim.nodeIndex >= 0 &&
+                 (std::size_t)prim.nodeIndex * 16 + 16 <= lb.nodeWorldMats.size()) {
+        Mat4Mul(vu.modelMat, lb.modelMat, &lb.nodeWorldMats[(std::size_t)prim.nodeIndex * 16]);
+        vu.params[0] = 0.0f;
+      } else {
+        std::memcpy(vu.modelMat, lb.modelMat, sizeof(lb.modelMat));
+        vu.params[0] = 0.0f;
+      }
+      frame->PushVertexUniform(0, vu);
+
+      SkinnedShadowFragUniforms fu{};
+      fu.params[0] = hasTex ? 1.0f : 0.0f;
+      fu.params[1] = (mat.alphaMode == GltfAlphaMode::Mask) ? 1.0f : 0.0f;
+      fu.params[2] = mat.alphaCutoff;
+      fu.params[3] = mat.baseColorFactor[3];
+      frame->PushFragmentUniform(0, fu);
+
+      frame->DrawIndexed(prim.indexCount, prim.firstIndex, 0, 1);
+    }
+  };
+
+  // P3: Static GLTF arena shadow map caching + spatial light-box culling.
+  if (mLatchedGltfArena && mLatchedGltfArena->valid && mStaticShadowMap) {
+    const GltfArena &arena = *mLatchedGltfArena;
+    const bool cacheHit = mStaticShadowValid &&
+                          mStaticShadowBiome == mLatched.biome &&
+                          mStaticShadowTod == mLatched.timeOfDay &&
+                          mStaticShadowWeather == mLatched.weather &&
+                          mStaticShadowArenaPtr == mLatchedGltfArena;
+    if (!cacheHit) {
+      PassDesc staticPass;
+      staticPass.numColorTargets = 0;
+      staticPass.depth.texture = mStaticShadowMap.Handle();
+      staticPass.depth.load = SDL_GPU_LOADOP_CLEAR;
+      staticPass.depth.store = SDL_GPU_STOREOP_STORE;
+      staticPass.depth.clearDepth = 1.0f;
+      staticPass.depth.cycle = true;
+      staticPass.label = "battle3d_static_shadow";
+      if (frame->BeginPass(phase, staticPass)) {
+        frame->SetViewport(FullViewport(kShadowMapSize, kShadowMapSize));
+        frame->BindVertexBuffer(arena.vertexBuffer, 0, 0);
+        frame->BindIndexBuffer(arena.indexBuffer, 0, SDL_GPU_INDEXELEMENTSIZE_32BIT);
+
+        float lightPlanes[6][4];
+        ExtractFrustumPlanesZO(mLightViewProj, lightPlanes);
+
+        for (const auto &sm : arena.submeshes) {
+          if (!sm.castsShadow || (sm.flags & B3D_SUBMESH_CAST_SHADOW) == 0) continue;
+          if (!AabbIntersectsFrustum(sm.bboxMin, sm.bboxMax, lightPlanes)) continue;
+
+          PipelineKey key;
+          key.vertex = &Shaders::battle3d_shadow_vert;
+          key.fragment = &Shaders::battle3d_skinned_shadow_frag;
+          key.layout = b3dLayout;
+          key.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+          key.cull = (sm.flags & B3D_SUBMESH_DOUBLE_SIDED) ? SDL_GPU_CULLMODE_NONE : SDL_GPU_CULLMODE_BACK;
+          key.depthTest = true;
+          key.depthWrite = true;
+          key.depthCompare = SDL_GPU_COMPAREOP_LESS;
+          key.blend = Blend::Opaque;
+          key.colorFormat = SDL_GPU_TEXTUREFORMAT_INVALID;
+          key.depthFormat = mShadowFormat;
+          SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+          if (!pipe) continue;
+          frame->BindPipeline(pipe);
+
+          bool hasTex = sm.textureIndex >= 0 &&
+                        (std::size_t)sm.textureIndex < arena.textures.size() &&
+                        (bool)arena.textures[sm.textureIndex].tex;
+          if (hasTex) {
+            const auto &gt = arena.textures[sm.textureIndex];
+            frame->BindFragmentSampler(0, gt.tex.Handle(),
+                                       device.Sampler(SamplerKey::LinearMipmap(gt.wrapU, gt.wrapV, 4)));
+          } else if (mWhiteDummy) {
+            frame->BindFragmentSampler(0, mWhiteDummy.Handle(), device.Sampler(SamplerKey::Nearest()));
+          }
+
+          ShadowVertUniforms vu{};
+          std::memcpy(vu.lightViewProj, mLightViewProj, sizeof(mLightViewProj));
+          vu.params[0] = 0.0f;
+          vu.params[1] = 0.0f;
+          frame->PushVertexUniform(0, vu);
+
+          SkinnedShadowFragUniforms fu{};
+          fu.params[0] = hasTex ? 1.0f : 0.0f;
+          fu.params[1] = (sm.flags & B3D_SUBMESH_ALPHA_TEST) ? 1.0f : 0.0f;
+          fu.params[2] = sm.alphaCutoff;
+          fu.params[3] = 1.0f;
+          frame->PushFragmentUniform(0, fu);
+
+          frame->DrawIndexed(sm.indexCount, sm.firstIndex, 0, 1);
+        }
+        frame->EndPass();
+        mStaticShadowValid = true;
+        mStaticShadowBiome = mLatched.biome;
+        mStaticShadowTod = mLatched.timeOfDay;
+        mStaticShadowWeather = mLatched.weather;
+        mStaticShadowArenaPtr = mLatchedGltfArena;
+      }
+    }
+
+    if (!hasDynamicCasters()) {
+      mActiveShadowTex = mStaticShadowMap.Handle();
+      return;
+    }
+
+    // Copy cached static arena shadow map into mShadowMap, then render ONLY dynamic skinned casters.
+    frame->OutsidePass([src = mStaticShadowMap.Handle(), dst = mShadowMap.Handle()](SDL_GPUCommandBuffer *cmd) {
+      SDL_GPUCopyPass *cp = SDL_BeginGPUCopyPass(cmd);
+      if (!cp) return;
+      SDL_GPUTextureLocation sLoc{};
+      sLoc.texture = src;
+      SDL_GPUTextureLocation dLoc{};
+      dLoc.texture = dst;
+      SDL_CopyGPUTextureToTexture(cp, &sLoc, &dLoc, kShadowMapSize, kShadowMapSize, 1, true);
+      SDL_EndGPUCopyPass(cp);
+    });
+
+    PassDesc dynPass;
+    dynPass.numColorTargets = 0;
+    dynPass.depth.texture = mShadowMap.Handle();
+    dynPass.depth.load = SDL_GPU_LOADOP_LOAD;
+    dynPass.depth.store = SDL_GPU_STOREOP_STORE;
+    dynPass.depth.cycle = false;
+    dynPass.label = "battle3d_dynamic_shadow";
+    if (!frame->BeginPass(phase, dynPass)) {
+      mActiveShadowTex = mStaticShadowMap.Handle();
+      return;
+    }
+    frame->SetViewport(FullViewport(kShadowMapSize, kShadowMapSize));
+    for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+      renderShadowCaster(mLatchedBattlers[i]);
+    }
+    for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+      renderShadowCaster(mLatchedActors[i]);
+    }
+    frame->EndPass();
+    mActiveShadowTex = mShadowMap.Handle();
+    return;
+  }
+
+  // Fallback path (.b3d biome or if static shadow map unavailable): direct shadow pass into mShadowMap.
+  mActiveShadowTex = mShadowMap.Handle();
+  PassDesc pass;
+  pass.numColorTargets = 0;
+  pass.depth.texture = mShadowMap.Handle();
+  pass.depth.load = SDL_GPU_LOADOP_CLEAR;
+  pass.depth.store = SDL_GPU_STOREOP_STORE;
+  pass.depth.clearDepth = 1.0f;
+  pass.depth.cycle = true;
+  pass.label = "battle3d_shadow";
+  if (!frame->BeginPass(phase, pass)) return;
+
+  frame->SetViewport(FullViewport(kShadowMapSize, kShadowMapSize));
+
+  if (mLatchedGltfArena && mLatchedGltfArena->valid) {
+    const GltfArena &arena = *mLatchedGltfArena;
+    frame->BindVertexBuffer(arena.vertexBuffer, 0, 0);
+    frame->BindIndexBuffer(arena.indexBuffer, 0, SDL_GPU_INDEXELEMENTSIZE_32BIT);
+    float lightPlanes[6][4];
+    ExtractFrustumPlanesZO(mLightViewProj, lightPlanes);
+    for (const auto &sm : arena.submeshes) {
+      if (!sm.castsShadow || (sm.flags & B3D_SUBMESH_CAST_SHADOW) == 0) continue;
+      if (!AabbIntersectsFrustum(sm.bboxMin, sm.bboxMax, lightPlanes)) continue;
+      PipelineKey key;
+      key.vertex = &Shaders::battle3d_shadow_vert;
+      key.fragment = &Shaders::battle3d_skinned_shadow_frag;
+      key.layout = b3dLayout;
+      key.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+      key.cull = (sm.flags & B3D_SUBMESH_DOUBLE_SIDED) ? SDL_GPU_CULLMODE_NONE : SDL_GPU_CULLMODE_BACK;
+      key.depthTest = true;
+      key.depthWrite = true;
+      key.depthCompare = SDL_GPU_COMPAREOP_LESS;
+      key.blend = Blend::Opaque;
+      key.colorFormat = SDL_GPU_TEXTUREFORMAT_INVALID;
+      key.depthFormat = mShadowFormat;
+      SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+      if (!pipe) continue;
+      frame->BindPipeline(pipe);
+
+      bool hasTex = sm.textureIndex >= 0 &&
+                    (std::size_t)sm.textureIndex < arena.textures.size() &&
+                    (bool)arena.textures[sm.textureIndex].tex;
+      if (hasTex) {
+        const auto &gt = arena.textures[sm.textureIndex];
+        frame->BindFragmentSampler(0, gt.tex.Handle(),
+                                   device.Sampler(SamplerKey::LinearMipmap(gt.wrapU, gt.wrapV, 4)));
+      } else if (mWhiteDummy) {
+        frame->BindFragmentSampler(0, mWhiteDummy.Handle(), device.Sampler(SamplerKey::Nearest()));
+      }
+
+      ShadowVertUniforms vu{};
+      std::memcpy(vu.lightViewProj, mLightViewProj, sizeof(mLightViewProj));
+      vu.params[0] = mLatched.timeSec;
+      vu.params[1] = 0.0f;
+      frame->PushVertexUniform(0, vu);
+
+      SkinnedShadowFragUniforms fu{};
+      fu.params[0] = hasTex ? 1.0f : 0.0f;
+      fu.params[1] = (sm.flags & B3D_SUBMESH_ALPHA_TEST) ? 1.0f : 0.0f;
+      fu.params[2] = sm.alphaCutoff;
+      fu.params[3] = 1.0f;
+      frame->PushFragmentUniform(0, fu);
+
+      frame->DrawIndexed(sm.indexCount, sm.firstIndex, 0, 1);
+    }
+  } else if (mLatchedBiome && mLatchedBiome->valid) {
+    const LoadedBiome &biome = *mLatchedBiome;
+    frame->BindVertexBuffer(biome.vertexBuffer, 0, 0);
+    frame->BindIndexBuffer(biome.indexBuffer, 0, SDL_GPU_INDEXELEMENTSIZE_32BIT);
+    for (const auto &sm : biome.submeshes) {
+      if ((sm.flags & B3D_SUBMESH_CAST_SHADOW) == 0) continue;
+      PipelineKey key;
+      key.vertex = &Shaders::battle3d_shadow_vert;
+      key.fragment = &Shaders::battle3d_shadow_frag;
+      key.layout = b3dLayout;
+      key.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+      key.cull = (sm.flags & B3D_SUBMESH_DOUBLE_SIDED) ? SDL_GPU_CULLMODE_NONE : SDL_GPU_CULLMODE_BACK;
+      key.depthTest = true;
+      key.depthWrite = true;
+      key.depthCompare = SDL_GPU_COMPAREOP_LESS;
+      key.blend = Blend::Opaque;
+      key.colorFormat = SDL_GPU_TEXTUREFORMAT_INVALID;
+      key.depthFormat = mShadowFormat;
+      SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+      if (!pipe) continue;
+      frame->BindPipeline(pipe);
+
+      bool hasTex = sm.textureIndex >= 0 &&
+                    (std::size_t)sm.textureIndex < biome.textures.size() &&
+                    (bool)biome.textures[sm.textureIndex].tex;
+      if (hasTex) {
+        Wrap w = (biome.textures[sm.textureIndex].flags & B3D_TEX_FLAG_REPEAT)
+                     ? Wrap::Repeat : Wrap::ClampToEdge;
+        frame->BindFragmentSampler(0, biome.textures[sm.textureIndex].tex.Handle(),
+                                   device.Sampler(SamplerKey::Linear(w, w)));
+      } else if (mWhiteDummy) {
+        frame->BindFragmentSampler(0, mWhiteDummy.Handle(), device.Sampler(SamplerKey::Nearest()));
+      }
+
+      ShadowVertUniforms vu{};
+      std::memcpy(vu.lightViewProj, mLightViewProj, sizeof(mLightViewProj));
+      vu.params[0] = mLatched.timeSec;
+      vu.params[1] = (sm.flags & B3D_SUBMESH_ALPHA_TEST) ? 1.0f : 0.0f;
+      frame->PushVertexUniform(0, vu);
+
+      ShadowFragUniforms fu{};
+      fu.flags[0] = hasTex ? 1 : 0;
+      fu.flags[1] = (sm.flags & B3D_SUBMESH_ALPHA_TEST) ? 1 : 0;
+      frame->PushFragmentUniform(0, fu);
+
+      frame->DrawIndexed(sm.indexCount, sm.firstIndex, 0, 1);
+    }
+  }
+
+  for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+    renderShadowCaster(mLatchedBattlers[i]);
+  }
+  for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+    renderShadowCaster(mLatchedActors[i]);
+  }
+
+  frame->EndPass();
+}
+
+bool FxBattle3D::PrepareAndRenderShadow(Device &device, Frame *frame, Phase phase) {
+  mReadyForScene = false;
+  mLatchedBiome = nullptr;
+  mLatchedGltfArena = nullptr;
+  for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+    mLatchedBattlers[i].model = nullptr;
+    mLatchedBattlers[i].combinedAlpha = 0.0f;
+    mLatchedBattlers[i].skinPalettes.clear();
+  }
+  for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+    mLatchedActors[i].model = nullptr;
+    mLatchedActors[i].combinedAlpha = 0.0f;
+    mLatchedActors[i].skinPalettes.clear();
+  }
+
+  // P2: Release non-active arenas scheduled by SIM_Battle3D_Clear() even after battle ends.
+  ReleaseNonActiveArenas(device);
+
+  if (!frame || !GatePermits()) return false;
+
+  {
+    std::lock_guard<std::mutex> lock(gStateMutex);
+    mLatched = gSharedFrame;
+  }
+  if (!mLatched.active || mLatched.alpha <= 0.001f) {
+    return false;
+  }
+
+  ++mFrameCounter;
+  if (!EnsureResources(device, frame)) return false;
+
+  // P1: Drain any completed background worker GLB CPU loads into GPU resources.
+  DrainCompletedLoads(device, frame);
+
+  const auto &gateEnv = GetGateEnv();
+  const bool hasTestSlots = !gateEnv.testSlots.empty();
+  bool any3dEntity = hasTestSlots;
+  for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS && !any3dEntity; i++) {
+    const auto &b = mLatched.battlers[i];
+    if (b.visible && b.use3dModel && b.species > 0) {
+      any3dEntity = true;
+    }
+  }
+  for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS && !any3dEntity; i++) {
+    const auto &a = mLatched.actors[i];
+    if (a.visible && a.kind > 0) {
+      any3dEntity = true;
+    }
+  }
+
+  // B2: Gate GLB arena loading/rendering on both renderer env gate AND game-side modelsEnabled.
+  const bool modelsAllowed = ModelsGatePermits() && (mLatched.modelsEnabled != 0 || any3dEntity);
+  if (modelsAllowed) {
+    mLatchedGltfArena = LoadGltfArenaSlot(device, frame, mLatched.biome);
+  }
+  if (mLatchedGltfArena && mLatchedGltfArena->valid) {
+    mLastActiveBiome = mLatched.biome;
+  } else {
+    mLatchedBiome = LoadBiome(device, frame, mLatched.biome);
+  }
+  if ((!mLatchedGltfArena || !mLatchedGltfArena->valid) &&
+      (!mLatchedBiome || !mLatchedBiome->valid)) {
+    return false;
+  }
+
+  auto buildPalettesOnce = [](LatchedBattler &lb) {
+    if (!lb.model) return;
+    const GltfModel &mon = *lb.model;
+    const std::size_t nSkins = mon.skins.size();
+    lb.skinPalettes.resize(nSkins);
+    for (std::size_t si = 0; si < nSkins; si++) {
+      lb.skinPalettes[si].skinIndex = static_cast<std::int32_t>(si);
+      BuildGltfJointPalette(mon, static_cast<std::int32_t>(si), lb.nodeWorldMats,
+                            lb.skinPalettes[si].joints, lb.skinPalettes[si].jointCount);
+    }
+  };
+
+  // Optional test-harness slot override (SIM_BDSP_TEST_SLOTS="392,400") when game hooks aren't active yet.
+  if (modelsAllowed) {
+    if (hasTestSlots) {
+      int parsed[SIM_BATTLE3D_MAX_BATTLERS] = {};
+      int nParsed = 0;
+      const char *p = gateEnv.testSlots.c_str();
+      while (*p && nParsed < SIM_BATTLE3D_MAX_BATTLERS) {
+        char *end = nullptr;
+        long val = std::strtol(p, &end, 10);
+        if (end == p) break;
+        parsed[nParsed++] = static_cast<int>(val);
+        p = (*end == ',') ? end + 1 : end;
+      }
+      if (gateEnv.testFraming) {
+        mLatched.camEye[0] = -3.6f; mLatched.camEye[1] = 2.55f; mLatched.camEye[2] = 8.8f;
+        mLatched.camTarget[0] = 0.6f; mLatched.camTarget[1] = 1.45f; mLatched.camTarget[2] = -2.0f;
+        mLatched.camFovDeg = 38.0f;
+      }
+      for (int i = 0; i < nParsed && i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+        SIM_Battle3DBattler &b = mLatched.battlers[i];
+        if (b.visible && b.use3dModel == 0 && b.species == 0 && parsed[i] > 0) {
+          b.species = parsed[i];
+          b.form = 0;
+          b.isShiny = 0;
+          b.use3dModel = 1;
+          b.yawDeg = b.isPlayer ? 134.4f : -45.6f;
+          b.modelScale = gateEnv.testScale;
+          b.animState = gateEnv.testAnim;
+          b.animTime = mLatched.timeSec;
+          if (gateEnv.testFraming) {
+            if (b.isPlayer) {
+              b.worldX = -2.15f; b.worldY = 0.0f; b.worldZ = 2.25f;
+            } else {
+              b.worldX = 2.35f; b.worldY = 0.0f; b.worldZ = -2.15f;
+            }
+          }
+        }
+      }
+    }
+
+    for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+      const SIM_Battle3DBattler &b = mLatched.battlers[i];
+      if (!b.visible || b.alpha <= 0.01f || !b.use3dModel || b.species <= 0) continue;
+      const GltfModel *mon = LoadMonModel(device, frame, b.species, b.form, b.isShiny);
+      if (!mon || !mon->valid) continue;
+      LatchedBattler &lb = mLatchedBattlers[i];
+      lb.model = mon;
+      lb.combinedAlpha = std::clamp(b.alpha * mLatched.alpha, 0.0f, 1.0f);
+      lb.flashAmount = std::clamp(b.flashAmount, 0.0f, 1.0f);
+      Mat4BattlerTransform(lb.modelMat, b.worldX, b.worldY, b.worldZ, b.yawDeg, b.modelScale);
+      EvaluateGltfPose(*mon, b.animState, b.animTime, lb.nodeWorldMats, lb.poseScratch);
+      buildPalettesOnce(lb);
+    }
+
+    // Evaluate actors in 2 passes:
+    //   Pass A: unattached actors (e.g. Lucas/Dawn) + live RHand/LHand world sockets.
+    //   Pass B: bone-attached actors (e.g. Poke Ball locked to trainer LHand/RHand).
+    float actorBoneMats[SIM_BATTLE3D_MAX_ACTORS][2][16] = {};
+    CachedActorBones newBones[SIM_BATTLE3D_MAX_ACTORS];
+
+    for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+      const auto &a = mLatched.actors[i];
+      if (!a.visible || a.alpha <= 0.01f || a.kind <= 0 || a.attachBoneKind != 0) continue;
+      const GltfModel *actor = LoadActorModel(device, frame, a.kind);
+      if (!actor || !actor->valid) continue;
+      LatchedBattler &la = mLatchedActors[i];
+      la.model = actor;
+      la.combinedAlpha = std::clamp(a.alpha * mLatched.alpha, 0.0f, 1.0f);
+      la.flashAmount = 0.0f;
+      Mat4ActorTransform(la.modelMat, a.worldX, a.worldY, a.worldZ,
+                         a.yawDeg, a.pitchDeg, a.rollDeg, a.scale);
+      EvaluateGltfPose(*actor, a.animState, a.animTime, la.nodeWorldMats, la.poseScratch);
+      buildPalettesOnce(la);
+
+      newBones[i].animNonce = a.animNonce;
+      newBones[i].animState = a.animState;
+      newBones[i].animTime = a.animTime;
+      for (int bk = 1; bk <= 2; bk++) {
+        float bm[16];
+        if (GetGltfBoneWorldMatrix(*actor, la.modelMat, la.nodeWorldMats, bk, bm)) {
+          std::memcpy(actorBoneMats[i][bk - 1], bm, sizeof(bm));
+          std::memcpy(newBones[i].mat[bk - 1], bm, sizeof(bm));
+          newBones[i].valid[bk - 1] = true;
+          newBones[i].pos[bk - 1][0] = bm[12];
+          newBones[i].pos[bk - 1][1] = bm[13];
+          newBones[i].pos[bk - 1][2] = bm[14];
+        }
+      }
+    }
+
+    for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+      const auto &a = mLatched.actors[i];
+      if (!a.visible || a.alpha <= 0.01f || a.kind <= 0 || a.attachBoneKind == 0) continue;
+      const GltfModel *actor = LoadActorModel(device, frame, a.kind);
+      if (!actor || !actor->valid) continue;
+      float wx = a.worldX;
+      float wy = a.worldY;
+      float wz = a.worldZ;
+      const int pIdx = a.attachActorIdx;
+      const int bSlot = a.attachBoneKind - 1;
+      if (pIdx >= 0 && pIdx < SIM_BATTLE3D_MAX_ACTORS && pIdx != i &&
+          bSlot >= 0 && bSlot < 2 && newBones[pIdx].valid[bSlot]) {
+        const float *bm = actorBoneMats[pIdx][bSlot];
+        wx = bm[0] * a.attachOffset[0] + bm[4] * a.attachOffset[1] + bm[8]  * a.attachOffset[2] + bm[12];
+        wy = bm[1] * a.attachOffset[0] + bm[5] * a.attachOffset[1] + bm[9]  * a.attachOffset[2] + bm[13];
+        wz = bm[2] * a.attachOffset[0] + bm[6] * a.attachOffset[1] + bm[10] * a.attachOffset[2] + bm[14];
+        // Cache the exact transformed palm socket point as well as the full 4x4 bone matrix.
+        newBones[pIdx].pos[bSlot][0] = wx;
+        newBones[pIdx].pos[bSlot][1] = wy;
+        newBones[pIdx].pos[bSlot][2] = wz;
+      }
+      LatchedBattler &la = mLatchedActors[i];
+      la.model = actor;
+      la.combinedAlpha = std::clamp(a.alpha * mLatched.alpha, 0.0f, 1.0f);
+      la.flashAmount = 0.0f;
+      Mat4ActorTransform(la.modelMat, wx, wy, wz,
+                         a.yawDeg, a.pitchDeg, a.rollDeg, a.scale);
+      EvaluateGltfPose(*actor, a.animState, a.animTime, la.nodeWorldMats, la.poseScratch);
+      buildPalettesOnce(la);
+    }
+
+    {
+      std::lock_guard<std::mutex> lock(gStateMutex);
+      for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+        gActorBones[i] = newBones[i];
+      }
+    }
+  }
+
+  AtmospherePreset atmo = BuildAtmosphere(mLatched.biome, mLatched.timeOfDay, mLatched.weather);
+  mSunDir[0] = atmo.sunDir[0];
+  mSunDir[1] = atmo.sunDir[1];
+  mSunDir[2] = atmo.sunDir[2];
+
+  // Directional orthographic shadow box centered over the battle clearing + cliffs + nearby pines.
+  const float center[3] = {0.0f, 1.0f, -2.5f};
+  const float lightDist = 36.0f;
+  const float lightEye[3] = {
+      center[0] + mSunDir[0] * lightDist,
+      center[1] + mSunDir[1] * lightDist,
+      center[2] + mSunDir[2] * lightDist,
+  };
+  const float lightUp[3] = {0.0f, 1.0f, 0.0f};
+  float lightView[16], lightProj[16];
+  Mat4LookAtRH(lightView, lightEye, center, lightUp);
+  Mat4OrthoRH_ZO(lightProj, -24.0f, 24.0f, -24.0f, 24.0f, 4.0f, 76.0f);
+  Mat4Mul(mLightViewProj, lightProj, lightView);
+
+  if (mHasShadowMap && !frame->InPass()) {
+    RenderShadowPass(device, frame, phase);
+  }
+
+  mReadyForScene = true;
+  return true;
+}
+
+void FxBattle3D::RenderShadowDecals(Device &device, Frame *frame,
+                                    const SDL_GPUViewport &worldViewport,
+                                    SDL_GPUTextureFormat colorFormat, bool hasDepth,
+                                    const float viewProj[16], const float shadowTint[3]) {
+  // P7: Fixed stack array instead of per-frame heap vector.
+  DecalVertex verts[SIM_BATTLE3D_MAX_BATTLERS * 6];
+  std::uint32_t vertCount = 0;
+
+  // Project shadow slightly opposite the sun horizontal vector when a mon is elevated.
+  float sunHorizX = mSunDir[0];
+  float sunHorizZ = mSunDir[2];
+  float sunY = std::max(mSunDir[1], 0.35f);
+  float shiftPerY_X = -sunHorizX / sunY;
+  float shiftPerY_Z = -sunHorizZ / sunY;
+
+  for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+    const SIM_Battle3DBattler &b = mLatched.battlers[i];
+    if (!b.visible || b.alpha <= 0.01f || b.shadowRadius <= 0.01f) continue;
+    // Skip elliptical blob shadow decal when this battler casts a real 3D shadow map silhouette.
+    if (mHasShadowMap && mLatchedBattlers[i].model != nullptr) continue;
+
+    float elev = std::max(0.0f, b.worldY);
+    float cx = b.worldX + shiftPerY_X * elev * 0.65f;
+    float cz = b.worldZ + shiftPerY_Z * elev * 0.65f;
+    float y = 0.025f;
+
+    // Slight stretch along sun direction + soften with elevation.
+    float rx = b.shadowRadius * (1.0f + elev * 0.14f);
+    float rz = b.shadowRadius * 0.72f * (1.0f + elev * 0.14f);
+    float softness = std::min(0.88f, 0.42f + elev * 0.18f);
+    float opacity = 0.46f * b.alpha * mLatched.alpha / (1.0f + elev * 0.32f);
+
+    DecalVertex q[4] = {
+        {{cx - rx, y, cz - rz}, {-1.0f, -1.0f}, {softness, opacity}},
+        {{cx + rx, y, cz - rz}, { 1.0f, -1.0f}, {softness, opacity}},
+        {{cx + rx, y, cz + rz}, { 1.0f,  1.0f}, {softness, opacity}},
+        {{cx - rx, y, cz + rz}, {-1.0f,  1.0f}, {softness, opacity}},
+    };
+    verts[vertCount++] = q[0]; verts[vertCount++] = q[2]; verts[vertCount++] = q[1];
+    verts[vertCount++] = q[0]; verts[vertCount++] = q[3]; verts[vertCount++] = q[2];
+  }
+
+  if (vertCount == 0) return;
+
+  // Bias viewport depth slightly closer than clearing ground so decals never z-fight.
+  SDL_GPUViewport decalVp = worldViewport;
+  decalVp.min_depth = 0.9592f;
+  decalVp.max_depth = 0.9912f;
+  frame->SetViewport(decalVp);
+
+  PipelineKey key;
+  key.vertex = &Shaders::battle3d_shadow_decal_vert;
+  key.fragment = &Shaders::battle3d_shadow_decal_frag;
+  key.layout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(DecalVertex, pos));
+  key.layout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(DecalVertex, localUV));
+  key.layout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(DecalVertex, params));
+  key.layout.stride = sizeof(DecalVertex);
+  key.cull = SDL_GPU_CULLMODE_NONE;
+  key.depthTest = hasDepth;
+  key.depthWrite = false;
+  key.depthCompare = SDL_GPU_COMPAREOP_LESS_OR_EQUAL;
+  key.blend = Blend::Alpha;
+  key.colorFormat = colorFormat;
+  key.depthFormat = hasDepth ? device.DepthFormat() : SDL_GPU_TEXTUREFORMAT_INVALID;
+
+  SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+  if (!pipe) return;
+  frame->BindPipeline(pipe);
+
+  DecalVertUniforms vu{};
+  std::memcpy(vu.viewProj, viewProj, sizeof(vu.viewProj));
+  frame->PushVertexUniform(0, vu);
+
+  DecalFragUniforms fu{};
+  fu.shadowColor[0] = shadowTint[0] * 0.28f;
+  fu.shadowColor[1] = shadowTint[1] * 0.34f;
+  fu.shadowColor[2] = shadowTint[2] * 0.30f;
+  fu.shadowColor[3] = mLatched.brightness;
+  frame->PushFragmentUniform(0, fu);
+
+  frame->DrawStreamed(verts, vertCount, sizeof(DecalVertex));
+}
+
+void FxBattle3D::RenderArenaSubmeshes(Device &device, Frame *frame,
+                                      const SDL_GPUViewport &skyVp, const SDL_GPUViewport &worldVp,
+                                      SDL_GPUTextureFormat colorFormat, bool hasDepth,
+                                      const float viewProj[16]) {
+  AtmospherePreset atmo = BuildAtmosphere(mLatched.biome, mLatched.timeOfDay, mLatched.weather);
+
+  VertexLayout layout;
+  layout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(B3DVertex, pos));
+  layout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(B3DVertex, norm));
+  layout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(B3DVertex, uv));
+  layout.Add(3, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(B3DVertex, color));
+  layout.stride = sizeof(B3DVertex);
+
+  SDL_GPUTexture *shadowHandle = (mHasShadowMap && mActiveShadowTex)
+                                     ? mActiveShadowTex
+                                     : ((mHasShadowMap && mShadowMap) ? mShadowMap.Handle() : mWhiteDummy.Handle());
+  SDL_GPUSampler *shadowSampler = device.Sampler(SamplerKey::Nearest(Wrap::ClampToEdge, Wrap::ClampToEdge));
+
+  auto pushCommonFrag = [&](MainFragUniforms &fu, float roughness, float fogFactor,
+                            bool hasTex, std::uint32_t flags) {
+    fu.sunDir[0] = atmo.sunDir[0]; fu.sunDir[1] = atmo.sunDir[1]; fu.sunDir[2] = atmo.sunDir[2];
+    fu.sunColor[0] = atmo.sunColor[0]; fu.sunColor[1] = atmo.sunColor[1]; fu.sunColor[2] = atmo.sunColor[2];
+    fu.skyAmbient[0] = atmo.skyAmbient[0]; fu.skyAmbient[1] = atmo.skyAmbient[1]; fu.skyAmbient[2] = atmo.skyAmbient[2];
+    fu.groundAmbient[0] = atmo.groundAmbient[0]; fu.groundAmbient[1] = atmo.groundAmbient[1]; fu.groundAmbient[2] = atmo.groundAmbient[2];
+    fu.fogColor[0] = atmo.fogColor[0]; fu.fogColor[1] = atmo.fogColor[1]; fu.fogColor[2] = atmo.fogColor[2];
+    fu.shadowTint[0] = atmo.shadowTint[0]; fu.shadowTint[1] = atmo.shadowTint[1]; fu.shadowTint[2] = atmo.shadowTint[2];
+    fu.shadowTint[3] = atmo.shadowStrength;
+    fu.skyTint[0] = atmo.skyTint[0]; fu.skyTint[1] = atmo.skyTint[1]; fu.skyTint[2] = atmo.skyTint[2];
+    fu.skyTint[3] = atmo.todMode;
+    fu.camEye[0] = mLatched.camEye[0]; fu.camEye[1] = mLatched.camEye[1]; fu.camEye[2] = mLatched.camEye[2];
+    fu.fogParams[0] = atmo.fogStart;
+    fu.fogParams[1] = atmo.fogEnd;
+    fu.fogParams[2] = 1.0f / (float)kShadowMapSize;
+    fu.fogParams[3] = mHasShadowMap ? 1.0f : 0.0f;
+    fu.submeshParams[0] = roughness;
+    fu.submeshParams[1] = fogFactor;
+    fu.submeshParams[2] = mLatched.brightness;
+    fu.submeshParams[3] = mLatched.alpha;
+    fu.flags[0] = hasTex ? 1 : 0;
+    fu.flags[1] = (flags & B3D_SUBMESH_UNLIT) ? 1 : 0;
+    fu.flags[2] = (flags & B3D_SUBMESH_RECEIVE_SHADOW) ? 1 : 0;
+    fu.flags[3] = (flags & B3D_SUBMESH_ALPHA_TEST) ? 1 : 0;
+  };
+
+  if (mLatchedGltfArena && mLatchedGltfArena->valid) {
+    const GltfArena &arena = *mLatchedGltfArena;
+    frame->BindVertexBuffer(arena.vertexBuffer, 0, 0);
+    frame->BindIndexBuffer(arena.indexBuffer, 0, SDL_GPU_INDEXELEMENTSIZE_32BIT);
+
+    float camPlanes[6][4];
+    ExtractFrustumPlanesZO(viewProj, camPlanes);
+
+    for (const auto &sm : arena.submeshes) {
+      // P3: Cull non-sky arena submeshes outside the camera view frustum.
+      if (!sm.isSky && !AabbIntersectsFrustum(sm.bboxMin, sm.bboxMax, camPlanes)) {
+        continue;
+      }
+
+      frame->SetViewport(sm.isSky ? skyVp : worldVp);
+      const bool isBlend = (sm.alphaMode == GltfAlphaMode::Blend);
+
+      PipelineKey key;
+      key.vertex = &Shaders::battle3d_main_vert;
+      key.fragment = sm.isSky ? &Shaders::battle3d_main_frag : &Shaders::battle3d_skinned_frag;
+      key.layout = layout;
+      key.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+      key.cull = (sm.flags & B3D_SUBMESH_DOUBLE_SIDED) ? SDL_GPU_CULLMODE_NONE : SDL_GPU_CULLMODE_BACK;
+      key.depthTest = hasDepth;
+      key.depthWrite = hasDepth && !sm.isSky && !isBlend;
+      key.depthCompare = SDL_GPU_COMPAREOP_LESS_OR_EQUAL;
+      // Non-sky opaque/mask use battle3d_skinned_frag which applies 4x4 Bayer screen-door dither when
+      // mLatched.alpha < 0.999, keeping Blend::Opaque and depthWrite = true (B6).
+      key.blend = sm.isSky ? ((mLatched.alpha < 0.999f) ? Blend::Alpha : Blend::Opaque)
+                           : (isBlend ? Blend::Alpha : Blend::Opaque);
+      key.colorFormat = colorFormat;
+      key.depthFormat = hasDepth ? device.DepthFormat() : SDL_GPU_TEXTUREFORMAT_INVALID;
+
+      SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+      if (!pipe) continue;
+      frame->BindPipeline(pipe);
+
+      bool hasTex = sm.textureIndex >= 0 &&
+                    (std::size_t)sm.textureIndex < arena.textures.size() &&
+                    (bool)arena.textures[sm.textureIndex].tex;
+      if (hasTex) {
+        const auto &gt = arena.textures[sm.textureIndex];
+        frame->BindFragmentSampler(0, gt.tex.Handle(),
+                                   device.Sampler(SamplerKey::LinearMipmap(gt.wrapU, gt.wrapV, 4)));
+      } else {
+        frame->BindFragmentSampler(0, mWhiteDummy.Handle(), device.Sampler(SamplerKey::Nearest()));
+      }
+      frame->BindFragmentSampler(1, shadowHandle, shadowSampler);
+
+      MainVertUniforms vu{};
+      std::memcpy(vu.viewProj, viewProj, sizeof(vu.viewProj));
+      std::memcpy(vu.lightViewProj, mLightViewProj, sizeof(mLightViewProj));
+      vu.params[0] = mLatched.timeSec;
+      vu.params[1] = sm.isSky ? 1.0f : 0.0f;
+      vu.params[2] = 0.0f; // no procedural grass sway on glTF arena geometry
+      vu.params[3] = 0.0f;
+      frame->PushVertexUniform(0, vu);
+
+      if (sm.isSky) {
+        MainFragUniforms fu{};
+        pushCommonFrag(fu, sm.roughness, sm.fogFactor, hasTex, sm.flags);
+        frame->PushFragmentUniform(0, fu);
+      } else {
+        SkinnedMainFragUniforms fu{};
+        fu.sunDir[0] = atmo.sunDir[0]; fu.sunDir[1] = atmo.sunDir[1]; fu.sunDir[2] = atmo.sunDir[2];
+        fu.sunDir[3] = 0.08f; // subtle rim on arena geometry
+        fu.sunColor[0] = atmo.sunColor[0]; fu.sunColor[1] = atmo.sunColor[1]; fu.sunColor[2] = atmo.sunColor[2];
+        fu.skyAmbient[0] = atmo.skyAmbient[0]; fu.skyAmbient[1] = atmo.skyAmbient[1]; fu.skyAmbient[2] = atmo.skyAmbient[2];
+        fu.groundAmbient[0] = atmo.groundAmbient[0]; fu.groundAmbient[1] = atmo.groundAmbient[1]; fu.groundAmbient[2] = atmo.groundAmbient[2];
+        fu.fogColor[0] = atmo.fogColor[0]; fu.fogColor[1] = atmo.fogColor[1]; fu.fogColor[2] = atmo.fogColor[2];
+      fu.fogColor[3] = mLatched.timeSec;
+        fu.shadowTint[0] = atmo.shadowTint[0]; fu.shadowTint[1] = atmo.shadowTint[1]; fu.shadowTint[2] = atmo.shadowTint[2];
+        fu.shadowTint[3] = atmo.shadowStrength;
+        fu.baseColorFactor[0] = 1.0f; fu.baseColorFactor[1] = 1.0f; fu.baseColorFactor[2] = 1.0f; fu.baseColorFactor[3] = 1.0f;
+        fu.emissiveFactor[0] = 0.0f; fu.emissiveFactor[1] = 0.0f; fu.emissiveFactor[2] = 0.0f;
+        fu.emissiveFactor[3] = sm.alphaCutoff;
+        fu.camEye[0] = mLatched.camEye[0]; fu.camEye[1] = mLatched.camEye[1]; fu.camEye[2] = mLatched.camEye[2];
+        fu.fogParams[0] = atmo.fogStart;
+        fu.fogParams[1] = atmo.fogEnd;
+        fu.fogParams[2] = 1.0f / (float)kShadowMapSize;
+        fu.fogParams[3] = mHasShadowMap ? 1.0f : 0.0f;
+        fu.modelParams[0] = 1.0f; // full shadow receiving on arena ground/trees
+        fu.modelParams[1] = sm.fogFactor;
+        fu.modelParams[2] = mLatched.brightness;
+        fu.modelParams[3] = mLatched.alpha;
+        fu.flags[0] = hasTex ? 1 : 0;
+        fu.flags[1] = (sm.flags & B3D_SUBMESH_UNLIT) ? 1 : 0;
+        fu.flags[2] = (sm.flags & B3D_SUBMESH_RECEIVE_SHADOW) ? 1 : 0;
+        fu.flags[3] = static_cast<std::int32_t>(sm.alphaMode);
+        frame->PushFragmentUniform(0, fu);
+      }
+
+      frame->DrawIndexed(sm.indexCount, sm.firstIndex, 0, 1);
+    }
+    return;
+  }
+
+  if (!mLatchedBiome || !mLatchedBiome->valid) return;
+  const LoadedBiome &biome = *mLatchedBiome;
+  frame->BindVertexBuffer(biome.vertexBuffer, 0, 0);
+  frame->BindIndexBuffer(biome.indexBuffer, 0, SDL_GPU_INDEXELEMENTSIZE_32BIT);
+
+  for (const auto &sm : biome.submeshes) {
+    frame->SetViewport(sm.isSky ? skyVp : worldVp);
+
+    PipelineKey key;
+    key.vertex = &Shaders::battle3d_main_vert;
+    key.fragment = &Shaders::battle3d_main_frag;
+    key.layout = layout;
+    key.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+    key.cull = (sm.flags & B3D_SUBMESH_DOUBLE_SIDED) ? SDL_GPU_CULLMODE_NONE : SDL_GPU_CULLMODE_BACK;
+    key.depthTest = hasDepth;
+    key.depthWrite = hasDepth && !sm.isSky;
+    key.depthCompare = SDL_GPU_COMPAREOP_LESS_OR_EQUAL;
+    key.blend = (mLatched.alpha < 0.999f) ? Blend::Alpha : Blend::Opaque;
+    key.colorFormat = colorFormat;
+    key.depthFormat = hasDepth ? device.DepthFormat() : SDL_GPU_TEXTUREFORMAT_INVALID;
+
+    SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+    if (!pipe) continue;
+    frame->BindPipeline(pipe);
+
+    bool hasTex = sm.textureIndex >= 0 &&
+                  (std::size_t)sm.textureIndex < biome.textures.size() &&
+                  (bool)biome.textures[sm.textureIndex].tex;
+    if (hasTex) {
+      Wrap w = (biome.textures[sm.textureIndex].flags & B3D_TEX_FLAG_REPEAT)
+                   ? Wrap::Repeat : Wrap::ClampToEdge;
+      frame->BindFragmentSampler(0, biome.textures[sm.textureIndex].tex.Handle(),
+                                 device.Sampler(SamplerKey::Linear(w, w)));
+    } else {
+      frame->BindFragmentSampler(0, mWhiteDummy.Handle(), device.Sampler(SamplerKey::Nearest()));
+    }
+    frame->BindFragmentSampler(1, shadowHandle, shadowSampler);
+
+    MainVertUniforms vu{};
+    std::memcpy(vu.viewProj, viewProj, sizeof(vu.viewProj));
+    std::memcpy(vu.lightViewProj, mLightViewProj, sizeof(mLightViewProj));
+    vu.params[0] = mLatched.timeSec;
+    vu.params[1] = sm.isSky ? 1.0f : 0.0f;
+    vu.params[2] = (sm.flags & B3D_SUBMESH_ALPHA_TEST) ? 1.0f : 0.0f;
+    vu.params[3] = 0.0f;
+    frame->PushVertexUniform(0, vu);
+
+    MainFragUniforms fu{};
+    pushCommonFrag(fu, sm.roughness, sm.fogFactor, hasTex, sm.flags);
+    frame->PushFragmentUniform(0, fu);
+
+    frame->DrawIndexed(sm.indexCount, sm.firstIndex, 0, 1);
+  }
+}
+
+void FxBattle3D::RenderSkinnedBattlers(Device &device, Frame *frame,
+                                       const SDL_GPUViewport &worldVp,
+                                       SDL_GPUTextureFormat colorFormat, bool hasDepth,
+                                       const float viewProj[16]) {
+  bool any = false;
+  for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS && !any; i++) {
+    if (mLatchedBattlers[i].model && mLatchedBattlers[i].model->valid &&
+        mLatchedBattlers[i].combinedAlpha > 0.01f) {
+      any = true;
+    }
+  }
+  for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS && !any; i++) {
+    if (mLatchedActors[i].model && mLatchedActors[i].model->valid &&
+        mLatchedActors[i].combinedAlpha > 0.01f) {
+      any = true;
+    }
+  }
+  if (!any) return;
+
+  AtmospherePreset atmo = BuildAtmosphere(mLatched.biome, mLatched.timeOfDay, mLatched.weather);
+  frame->SetViewport(worldVp);
+
+  VertexLayout skinLayout;
+  skinLayout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(GltfSkinnedVertex, pos));
+  skinLayout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(GltfSkinnedVertex, norm));
+  skinLayout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(GltfSkinnedVertex, uv));
+  skinLayout.Add(3, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(GltfSkinnedVertex, color));
+  skinLayout.Add(4, SDL_GPU_VERTEXELEMENTFORMAT_UINT4, (Uint32)offsetof(GltfSkinnedVertex, joints));
+  skinLayout.Add(5, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(GltfSkinnedVertex, weights));
+  skinLayout.stride = sizeof(GltfSkinnedVertex);
+
+  SDL_GPUTexture *shadowHandle = (mHasShadowMap && mActiveShadowTex)
+                                     ? mActiveShadowTex
+                                     : ((mHasShadowMap && mShadowMap) ? mShadowMap.Handle() : mWhiteDummy.Handle());
+  SDL_GPUSampler *shadowSampler = device.Sampler(SamplerKey::Nearest(Wrap::ClampToEdge, Wrap::ClampToEdge));
+
+  auto renderSkinnedOne = [&](const LatchedBattler &lb) {
+    if (!lb.model || !lb.model->valid || lb.combinedAlpha <= 0.01f) return;
+    const GltfModel &mon = *lb.model;
+
+    frame->BindVertexBuffer(mon.vertexBuffer, 0, 0);
+    frame->BindIndexBuffer(mon.indexBuffer, 0, SDL_GPU_INDEXELEMENTSIZE_32BIT);
+
+    std::int32_t lastSkin = -2;
+    for (int pass = 0; pass < 2; ++pass) {
+    for (const auto &prim : mon.primitives) {
+      GltfMaterial mat{};
+      if (prim.materialIndex >= 0 && (std::size_t)prim.materialIndex < mon.materials.size()) {
+        mat = mon.materials[prim.materialIndex];
+      }
+      const bool isTranslucent = (mat.alphaMode == GltfAlphaMode::Blend) || mat.isFlame;
+      if ((pass == 0 && isTranslucent) || (pass == 1 && !isTranslucent)) {
+        continue;
+      }
+      // B6: Opaque/Mask primitives use 4x4 Bayer screen-door dither in the fragment shader when
+      // fading (combinedAlpha < 0.999), keeping depthWrite = true and Blend::Opaque so interior
+      // geometry never shows through. Blend and FireCore primitives keep normal alpha blending.
+      const bool isBlend = isTranslucent;
+
+      PipelineKey key;
+      key.vertex = &Shaders::battle3d_skinned_vert;
+      key.fragment = &Shaders::battle3d_skinned_frag;
+      key.layout = skinLayout;
+      key.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+      key.cull = mat.doubleSided ? SDL_GPU_CULLMODE_NONE : SDL_GPU_CULLMODE_BACK;
+      key.depthTest = hasDepth;
+      key.depthWrite = hasDepth && !isBlend;
+      key.depthCompare = SDL_GPU_COMPAREOP_LESS_OR_EQUAL;
+      key.blend = isBlend ? Blend::Alpha : Blend::Opaque;
+      key.colorFormat = colorFormat;
+      key.depthFormat = hasDepth ? device.DepthFormat() : SDL_GPU_TEXTUREFORMAT_INVALID;
+
+      SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+      if (!pipe) continue;
+      frame->BindPipeline(pipe);
+
+      // P7: Reuse joint palette built once per model per frame in PrepareAndRenderShadow.
+      if (prim.skinIndex != lastSkin) {
+        if (prim.skinIndex >= 0 &&
+            static_cast<std::size_t>(prim.skinIndex) < lb.skinPalettes.size()) {
+          frame->PushVertexUniform(1, lb.skinPalettes[static_cast<std::size_t>(prim.skinIndex)].joints,
+                                   sizeof(SkinnedJointsUniforms));
+        } else {
+          frame->PushVertexUniform(1, IdentityJointsUniforms());
+        }
+        lastSkin = prim.skinIndex;
+      }
+
+      bool hasTex = mat.baseColorTex >= 0 &&
+                    (std::size_t)mat.baseColorTex < mon.textures.size() &&
+                    (bool)mon.textures[mat.baseColorTex].tex;
+      if (hasTex) {
+        const auto &gt = mon.textures[mat.baseColorTex];
+        frame->BindFragmentSampler(0, gt.tex.Handle(),
+                                   device.Sampler(SamplerKey::LinearMipmap(gt.wrapU, gt.wrapV, 1)));
+      } else {
+        frame->BindFragmentSampler(0, mWhiteDummy.Handle(), device.Sampler(SamplerKey::Nearest()));
+      }
+      frame->BindFragmentSampler(1, shadowHandle, shadowSampler);
+
+      SkinnedMainVertUniforms vu{};
+      std::memcpy(vu.viewProj, viewProj, sizeof(vu.viewProj));
+      std::memcpy(vu.lightViewProj, mLightViewProj, sizeof(mLightViewProj));
+      if (prim.skinIndex >= 0) {
+        std::memcpy(vu.modelMat, lb.modelMat, sizeof(lb.modelMat));
+        vu.params[0] = 1.0f;
+      } else if (prim.nodeIndex >= 0 &&
+                 (std::size_t)prim.nodeIndex * 16 + 16 <= lb.nodeWorldMats.size()) {
+        Mat4Mul(vu.modelMat, lb.modelMat, &lb.nodeWorldMats[(std::size_t)prim.nodeIndex * 16]);
+        vu.params[0] = 0.0f;
+      } else {
+        std::memcpy(vu.modelMat, lb.modelMat, sizeof(lb.modelMat));
+        vu.params[0] = 0.0f;
+      }
+      frame->PushVertexUniform(0, vu);
+
+      SkinnedMainFragUniforms fu{};
+      fu.sunDir[0] = atmo.sunDir[0]; fu.sunDir[1] = atmo.sunDir[1]; fu.sunDir[2] = atmo.sunDir[2];
+      fu.sunDir[3] = 0.24f; // crisp BDSP character rim highlight
+      fu.sunColor[0] = atmo.sunColor[0]; fu.sunColor[1] = atmo.sunColor[1]; fu.sunColor[2] = atmo.sunColor[2];
+      fu.skyAmbient[0] = atmo.skyAmbient[0]; fu.skyAmbient[1] = atmo.skyAmbient[1]; fu.skyAmbient[2] = atmo.skyAmbient[2];
+      fu.groundAmbient[0] = atmo.groundAmbient[0]; fu.groundAmbient[1] = atmo.groundAmbient[1]; fu.groundAmbient[2] = atmo.groundAmbient[2];
+      fu.fogColor[0] = atmo.fogColor[0]; fu.fogColor[1] = atmo.fogColor[1]; fu.fogColor[2] = atmo.fogColor[2];
+      fu.shadowTint[0] = atmo.shadowTint[0]; fu.shadowTint[1] = atmo.shadowTint[1]; fu.shadowTint[2] = atmo.shadowTint[2];
+      fu.shadowTint[3] = atmo.shadowStrength;
+      std::memcpy(fu.baseColorFactor, mat.baseColorFactor, sizeof(fu.baseColorFactor));
+      fu.emissiveFactor[0] = mat.emissiveFactor[0];
+      fu.emissiveFactor[1] = mat.emissiveFactor[1];
+      fu.emissiveFactor[2] = mat.emissiveFactor[2];
+      fu.emissiveFactor[3] = mat.alphaCutoff;
+      fu.camEye[0] = mLatched.camEye[0]; fu.camEye[1] = mLatched.camEye[1]; fu.camEye[2] = mLatched.camEye[2];
+      fu.camEye[3] = lb.flashAmount;
+      fu.fogParams[0] = atmo.fogStart;
+      fu.fogParams[1] = atmo.fogEnd;
+      fu.fogParams[2] = 1.0f / (float)kShadowMapSize;
+      fu.fogParams[3] = mHasShadowMap ? 1.0f : 0.0f;
+      fu.modelParams[0] = 0.55f; // gentle shadow receiving on Pokémon/trainers to avoid self-shadow acne
+      fu.modelParams[1] = 0.35f; // lighter haze so characters remain vivid
+      fu.modelParams[2] = mLatched.brightness;
+      fu.modelParams[3] = lb.combinedAlpha;
+      fu.flags[0] = hasTex ? 1 : 0;
+      fu.flags[1] = mat.isFlame ? 2 : (mat.unlit ? 1 : 0);
+      fu.flags[2] = 1; // receive shadow map
+      fu.flags[3] = static_cast<std::int32_t>(mat.alphaMode);
+      frame->PushFragmentUniform(0, fu);
+
+      frame->DrawIndexed(prim.indexCount, prim.firstIndex, 0, 1);
+    }
+    }
+  };
+  for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+    renderSkinnedOne(mLatchedBattlers[i]);
+  }
+  for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+    renderSkinnedOne(mLatchedActors[i]);
+  }
+}
+
+void FxBattle3D::RenderBurstVfx(Device &device, Frame *frame,
+                                const SDL_GPUViewport &worldViewport,
+                                SDL_GPUTextureFormat colorFormat, bool hasDepth,
+                                const float viewProj[16]) {
+  const auto &b = mLatched.burst;
+  if (!b.active || b.progress <= 0.001f || b.progress >= 0.999f) {
+    return;
+  }
+
+  const float p = std::clamp(b.progress, 0.0f, 1.0f);
+  const float baseRadius = (b.radius > 0.1f) ? b.radius : 1.65f;
+
+  // Camera-aligned right & up basis for crisp billboard orientation.
+  const float upWorld[3] = {0.0f, 1.0f, 0.0f};
+  float toCam[3] = {
+      mLatched.camEye[0] - b.worldX,
+      mLatched.camEye[1] - b.worldY,
+      mLatched.camEye[2] - b.worldZ,
+  };
+  Vec3Normalize(toCam);
+  float camFwd[3] = {
+      mLatched.camTarget[0] - mLatched.camEye[0],
+      mLatched.camTarget[1] - mLatched.camEye[1],
+      mLatched.camTarget[2] - mLatched.camEye[2],
+  };
+  Vec3Normalize(camFwd);
+  float camRight[3];
+  Vec3Cross(camRight, camFwd, upWorld);
+  Vec3Normalize(camRight);
+  float camUp[3];
+  Vec3Cross(camUp, camRight, camFwd);
+  Vec3Normalize(camUp);
+
+  // P7: Fixed stack array instead of per-frame heap vector.
+  BurstVertex verts[12];
+  std::uint32_t vertCount = 0;
+
+  // Layer 1: Ground shockwave ring + light pool on the clearing grass (y = 0.08).
+  {
+    const float gr = baseRadius * (0.45f + 0.85f * std::pow(p, 0.55f));
+    const float gy = 0.08f;
+    const float cx = b.worldX;
+    const float cz = b.worldZ;
+    BurstVertex q[4] = {
+        {{cx - gr, gy, cz - gr}, {-1.0f, -1.0f}, {1.0f, p, 1.0f, 0.0f}},
+        {{cx + gr, gy, cz - gr}, { 1.0f, -1.0f}, {1.0f, p, 1.0f, 0.0f}},
+        {{cx + gr, gy, cz + gr}, { 1.0f,  1.0f}, {1.0f, p, 1.0f, 0.0f}},
+        {{cx - gr, gy, cz + gr}, {-1.0f,  1.0f}, {1.0f, p, 1.0f, 0.0f}},
+    };
+    verts[vertCount++] = q[0]; verts[vertCount++] = q[2]; verts[vertCount++] = q[1];
+    verts[vertCount++] = q[0]; verts[vertCount++] = q[3]; verts[vertCount++] = q[2];
+  }
+
+  // Layer 0: Camera-facing volumetric Poke Ball open burst (pulled slightly toward camera so
+  // core/rays bloom cleanly across the emerging Pokemon without bisecting its torso).
+  {
+    const float br = baseRadius * (0.42f + 0.92f * std::pow(p, 0.52f));
+    const float bx = b.worldX + toCam[0] * 0.65f;
+    const float by = b.worldY + toCam[1] * 0.25f;
+    const float bz = b.worldZ + toCam[2] * 0.65f;
+    auto corner = [&](float sx, float sy) -> BurstVertex {
+      BurstVertex v{};
+      v.pos[0] = bx + (camRight[0] * sx + camUp[0] * sy) * br;
+      v.pos[1] = by + (camRight[1] * sx + camUp[1] * sy) * br;
+      v.pos[2] = bz + (camRight[2] * sx + camUp[2] * sy) * br;
+      v.localUV[0] = sx;
+      v.localUV[1] = sy;
+      v.params[0] = 0.0f;
+      v.params[1] = p;
+      v.params[2] = 1.15f;
+      v.params[3] = 0.0f;
+      return v;
+    };
+    BurstVertex q[4] = {
+        corner(-1.0f, -1.0f),
+        corner( 1.0f, -1.0f),
+        corner( 1.0f,  1.0f),
+        corner(-1.0f,  1.0f),
+    };
+    verts[vertCount++] = q[0]; verts[vertCount++] = q[1]; verts[vertCount++] = q[2];
+    verts[vertCount++] = q[0]; verts[vertCount++] = q[2]; verts[vertCount++] = q[3];
+  }
+
+  SDL_GPUViewport burstVp = worldViewport;
+  burstVp.min_depth = 0.9585f;
+  burstVp.max_depth = 0.9905f;
+  frame->SetViewport(burstVp);
+
+  PipelineKey key;
+  key.vertex = &Shaders::battle3d_burst_vert;
+  key.fragment = &Shaders::battle3d_burst_frag;
+  key.layout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(BurstVertex, pos));
+  key.layout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(BurstVertex, localUV));
+  key.layout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(BurstVertex, params));
+  key.layout.stride = sizeof(BurstVertex);
+  key.cull = SDL_GPU_CULLMODE_NONE;
+  key.depthTest = hasDepth;
+  key.depthWrite = false;
+  key.depthCompare = SDL_GPU_COMPAREOP_LESS_OR_EQUAL;
+  key.blend = Blend::Additive;
+  key.colorFormat = colorFormat;
+  key.depthFormat = hasDepth ? device.DepthFormat() : SDL_GPU_TEXTUREFORMAT_INVALID;
+
+  SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+  if (!pipe) return;
+  frame->BindPipeline(pipe);
+
+  BurstVertUniforms vu{};
+  std::memcpy(vu.viewProj, viewProj, sizeof(vu.viewProj));
+  frame->PushVertexUniform(0, vu);
+
+  const bool hasTint = (b.color[0] + b.color[1] + b.color[2]) > 0.01f;
+  BurstFragUniforms fu{};
+  fu.tintColor[0] = hasTint ? b.color[0] : 1.0f;
+  fu.tintColor[1] = hasTint ? b.color[1] : 0.86f;
+  fu.tintColor[2] = hasTint ? b.color[2] : 0.72f;
+  fu.tintColor[3] = std::clamp(mLatched.alpha, 0.0f, 1.0f);
+  fu.burstParams[0] = p;
+  fu.burstParams[1] = mLatched.timeSec;
+  fu.burstParams[2] = mLatched.brightness;
+  fu.burstParams[3] = 0.0f;
+  frame->PushFragmentUniform(0, fu);
+
+  frame->DrawStreamed(verts, vertCount, sizeof(BurstVertex));
+}
+
+void FxBattle3D::RenderScene(Device &device, Frame *frame,
+                             const SDL_GPUViewport &viewport,
+                             SDL_GPUTextureFormat colorFormat, bool hasDepth) {
+  if (!mReadyForScene || !frame) {
+    return;
+  }
+  if ((!mLatchedGltfArena || !mLatchedGltfArena->valid) &&
+      (!mLatchedBiome || !mLatchedBiome->valid)) {
+    return;
+  }
+  mReadyForScene = false;
+
+  const float up[3] = {0.0f, 1.0f, 0.0f};
+  float view[16], proj[16], viewProj[16];
+  Mat4LookAtRH(view, mLatched.camEye, mLatched.camTarget, up);
+  float fov = (mLatched.camFovDeg > 5.0f && mLatched.camFovDeg < 110.0f) ? mLatched.camFovDeg : 36.0f;
+  float aspect = (mLatched.camAspect > 0.5f && mLatched.camAspect < 4.0f) ? mLatched.camAspect : (16.0f / 9.0f);
+  const float zFar = (mLatchedGltfArena && mLatchedGltfArena->valid) ? 180.0f : 120.0f;
+  Mat4PerspectiveRH_ZO(proj, fov, aspect, 0.35f, zFar);
+  Mat4Mul(viewProj, proj, view);
+
+  AtmospherePreset atmo = BuildAtmosphere(mLatched.biome, mLatched.timeOfDay, mLatched.weather);
+
+  // Depth remapping:
+  //   Sky dome: [0.9935, 0.9945] (shader pins z/w = 0.5 -> 0.994)
+  //   3D World & 3D Pokémon: [0.9600, 0.9920] (strictly behind DS sprites/SPL particles!)
+  SDL_GPUViewport skyVp = viewport;
+  skyVp.min_depth = 0.9935f;
+  skyVp.max_depth = 0.9945f;
+
+  SDL_GPUViewport worldVp = viewport;
+  worldVp.min_depth = 0.9600f;
+  worldVp.max_depth = 0.9920f;
+
+  // Pass 2a: Sky dome + 3D Arena (.glb override or .b3d fallback).
+  RenderArenaSubmeshes(device, frame, skyVp, worldVp, colorFormat, hasDepth, viewProj);
+
+  // Pass 2b: Skinned 3D Pokémon models (sharing depth range with arena, behind DS SPL particles).
+  RenderSkinnedBattlers(device, frame, worldVp, colorFormat, hasDepth, viewProj);
+
+  // Pass 3: Soft sun-angled battler ground shadows at Y = 0.025 (for 2D-sprite battlers).
+  RenderShadowDecals(device, frame, worldVp, colorFormat, hasDepth, viewProj, atmo.shadowTint);
+
+  // Pass 4: 3D additive Poke Ball open / materialization light-burst VFX.
+  RenderBurstVfx(device, frame, worldVp, colorFormat, hasDepth, viewProj);
+
+  // Restore original Scene3D viewport (min_depth=0, max_depth=1) for DS sprites & SPL particles.
+  frame->SetViewport(viewport);
+}
