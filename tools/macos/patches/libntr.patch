+            if (idx != 0u) { hit = true; palByte = int(((a2 & 0xF000u) >> 8) | idx); }
+        }
+    } else {
+        if ((a0 & 0x200u) != 0u) return vec4(0.0); // disabled
+        int sy = (py - int(a0 & 0xFFu)) & 0xFF;
+        if (sy >= h) return vec4(0.0);
