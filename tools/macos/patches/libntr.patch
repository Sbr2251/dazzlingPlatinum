-static void calculateVtxFx(fx32 * x, fx32 * y, fx32 * z, fx32 * w)
-{
-    fx32 myW = FX32_ONE;
-    fx32 oldVec[4];
-    fx32 newVec[4];
-    fx32 curSum;
-
-    oldVec[0] = *x;
-    oldVec[1] = *y;
-    oldVec[2] = *z;
-    oldVec[3] = FX32_ONE;
-
-    for( int i=0; i < 4; i++ )
-    {
-        curSum = 0;
-        for(int j=0; j < 4; j++ )
-        {
-            curSum = curSum + FX_Mul(oldVec[j], currentClipMatrix.nums[j][i]);
-        }
-        newVec[i] = curSum;
-    }
-    *x = newVec[0];
-    *y = newVec[1];
-    *z = newVec[2];
-    *w = newVec[3];
-}
