+constexpr std::size_t kMaxGlbBytes = 128u * 1024u * 1024u;
+constexpr float kPi = 3.14159265358979323846f;
+
+void Mat4Identity(float m[16]) {
+  std::memset(m, 0, sizeof(float) * 16);
+  m[0] = m[5] = m[10] = m[15] = 1.0f;
+}
+
+void Mat4Mul(float out[16], const float a[16], const float b[16]) {
+  float r[16];
+  for (int c = 0; c < 4; c++) {
+    for (int row = 0; row < 4; row++) {
+      r[c * 4 + row] = a[0 * 4 + row] * b[c * 4 + 0] +
+                       a[1 * 4 + row] * b[c * 4 + 1] +
+                       a[2 * 4 + row] * b[c * 4 + 2] +
+                       a[3 * 4 + row] * b[c * 4 + 3];
+    }
+  }
+  std::memcpy(out, r, sizeof(r));
+}
+
+void Mat4FromTRS(float out[16], const float t[3], const float q[4], const float s[3]) {
+  float x = q[0], y = q[1], z = q[2], w = q[3];
+  float len = std::sqrt(x * x + y * y + z * z + w * w);
+  if (len > 1e-6f) {
+    x /= len; y /= len; z /= len; w /= len;
+  } else {
+    x = y = z = 0.0f; w = 1.0f;
+  }
+  float xx = x * x, yy = y * y, zz = z * z;
+  float xy = x * y, xz = x * z, yz = y * z;
+  float wx = w * x, wy = w * y, wz = w * z;
+
+  out[0]  = (1.0f - 2.0f * (yy + zz)) * s[0];
+  out[1]  = (2.0f * (xy + wz)) * s[0];
+  out[2]  = (2.0f * (xz - wy)) * s[0];
+  out[3]  = 0.0f;
+
+  out[4]  = (2.0f * (xy - wz)) * s[1];
+  out[5]  = (1.0f - 2.0f * (xx + zz)) * s[1];
+  out[6]  = (2.0f * (yz + wx)) * s[1];
+  out[7]  = 0.0f;
+
+  out[8]  = (2.0f * (xz + wy)) * s[2];
+  out[9]  = (2.0f * (yz - wx)) * s[2];
+  out[10] = (1.0f - 2.0f * (xx + yy)) * s[2];
+  out[11] = 0.0f;
+
+  out[12] = t[0];
+  out[13] = t[1];
+  out[14] = t[2];
+  out[15] = 1.0f;
+}
+
+float Mat3Det(const float m[16]) {
+  float a00 = m[0], a10 = m[1], a20 = m[2];
+  float a01 = m[4], a11 = m[5], a21 = m[6];
+  float a02 = m[8], a12 = m[9], a22 = m[10];
+  return a00 * (a11 * a22 - a21 * a12) -
+         a01 * (a10 * a22 - a20 * a12) +
+         a02 * (a10 * a21 - a20 * a11);
+}
+
+void Mat4TransformPoint(const float m[16], const float in[3], float out[3]) {
+  out[0] = m[0] * in[0] + m[4] * in[1] + m[8]  * in[2] + m[12];
+  out[1] = m[1] * in[0] + m[5] * in[1] + m[9]  * in[2] + m[13];
+  out[2] = m[2] * in[0] + m[6] * in[1] + m[10] * in[2] + m[14];
+}
+
+void Mat4TransformNormal(const float m[16], const float in[3], float out[3]) {
+  // Cofactor of upper 3x3 (equals det * inverse-transpose).
+  float c0[3] = {m[0], m[1], m[2]};
+  float c1[3] = {m[4], m[5], m[6]};
+  float c2[3] = {m[8], m[9], m[10]};
+  float n0[3] = {c1[1] * c2[2] - c1[2] * c2[1],
+                 c1[2] * c2[0] - c1[0] * c2[2],
+                 c1[0] * c2[1] - c1[1] * c2[0]};
+  float n1[3] = {c2[1] * c0[2] - c2[2] * c0[1],
+                 c2[2] * c0[0] - c2[0] * c0[2],
+                 c2[0] * c0[1] - c2[1] * c0[0]};
+  float n2[3] = {c0[1] * c1[2] - c0[2] * c1[1],
+                 c0[2] * c1[0] - c0[0] * c1[2],
+                 c0[0] * c1[1] - c0[1] * c1[0]};
+  float det = c0[0] * n0[0] + c0[1] * n0[1] + c0[2] * n0[2];
+  float sign = det < 0.0f ? -1.0f : 1.0f;
+  float nx, ny, nz;
+  if (std::fabs(det) > 1e-8f) {
+    nx = (n0[0] * in[0] + n1[0] * in[1] + n2[0] * in[2]) * sign;
+    ny = (n0[1] * in[0] + n1[1] * in[1] + n2[1] * in[2]) * sign;
+    nz = (n0[2] * in[0] + n1[2] * in[1] + n2[2] * in[2]) * sign;
+  } else {
+    nx = c0[0] * in[0] + c1[0] * in[1] + c2[0] * in[2];
+    ny = c0[1] * in[0] + c1[1] * in[1] + c2[1] * in[2];
+    nz = c0[2] * in[0] + c1[2] * in[1] + c2[2] * in[2];
+  }
+  float len = std::sqrt(nx * nx + ny * ny + nz * nz);
+  if (len > 1e-6f) {
+    out[0] = nx / len; out[1] = ny / len; out[2] = nz / len;
+  } else {
+    out[0] = 0.0f; out[1] = 1.0f; out[2] = 0.0f;
+  }
+}
+
+std::string LowerStr(const char *s) {
+  std::string out;
+  if (!s) return out;
+  out.reserve(std::strlen(s));
+  for (const unsigned char *p = reinterpret_cast<const unsigned char *>(s); *p; ++p) {
+    out.push_back(static_cast<char>(std::tolower(*p)));
+  }
+  return out;
+}
+
+bool ReadFileBytes(const std::string &path, std::vector<std::uint8_t> &out) {
+  FILE *f = std::fopen(path.c_str(), "rb");
+  if (!f) return false;
+  std::fseek(f, 0, SEEK_END);
+  long sz = std::ftell(f);
+  std::fseek(f, 0, SEEK_SET);
+  if (sz < 12 || static_cast<std::size_t>(sz) > kMaxGlbBytes) {
+    std::fclose(f);
+    return false;
+  }
+  out.resize(static_cast<std::size_t>(sz));
+  bool ok = std::fread(out.data(), 1, out.size(), f) == out.size();
+  std::fclose(f);
+  return ok;
+}
+
+Wrap MapWrap(cgltf_int mode) {
+  if (mode == 33071) return Wrap::ClampToEdge;
+  if (mode == 33648) return Wrap::Mirror;
+  return Wrap::Repeat;
+}
+
+bool DecodeImage(const cgltf_image *img, std::vector<std::uint8_t> &rgba, int &w, int &h) {
+  if (!img) return false;
+  const std::uint8_t *src = nullptr;
+  std::size_t len = 0;
+  std::vector<std::uint8_t> decodedUri;
+
+  if (img->buffer_view && img->buffer_view->buffer && img->buffer_view->buffer->data) {
+    src = static_cast<const std::uint8_t *>(img->buffer_view->buffer->data) + img->buffer_view->offset;
+    len = img->buffer_view->size;
+  } else if (img->uri && std::strncmp(img->uri, "data:", 5) == 0) {
+    const char *comma = std::strchr(img->uri, ',');
+    if (comma && comma > img->uri + 7 && std::strstr(img->uri, ";base64")) {
+      const char *b64 = comma + 1;
+      std::size_t b64Len = std::strlen(b64);
+      std::size_t outSize = (b64Len / 4) * 3;
+      void *raw = nullptr;
+      cgltf_options opts{};
+      if (cgltf_load_buffer_base64(&opts, outSize, b64, &raw) == cgltf_result_success && raw) {
+        decodedUri.assign(static_cast<const std::uint8_t *>(raw),
+                          static_cast<const std::uint8_t *>(raw) + outSize);
+        std::free(raw);
+        src = decodedUri.data();
+        len = decodedUri.size();
+      }
+    }
+  }
+  if (!src || len == 0 || len > 64u * 1024u * 1024u) return false;
+
+  int comp = 0;
+  stbi_uc *px = stbi_load_from_memory(src, static_cast<int>(len), &w, &h, &comp, 4);
+  if (!px || w <= 0 || h <= 0) {
+    if (px) stbi_image_free(px);
+    return false;
+  }
+  rgba.assign(px, px + static_cast<std::size_t>(w) * static_cast<std::size_t>(h) * 4u);
+  stbi_image_free(px);
+  return true;
+}
+
+void DecodeTexturesAndMaterials(const cgltf_data *data,
+                                std::vector<GltfCpuTexture> &outTextures,
+                                std::vector<GltfMaterial> &outMaterials) {
+  outTextures.clear();
+  outTextures.resize(data->textures_count);
+  for (cgltf_size t = 0; t < data->textures_count; t++) {
+    const cgltf_texture &gt = data->textures[t];
+    if (gt.sampler) {
+      outTextures[t].wrapU = MapWrap(gt.sampler->wrap_s);
+      outTextures[t].wrapV = MapWrap(gt.sampler->wrap_t);
+    }
+    int w = 0, h = 0;
+    if (DecodeImage(gt.image, outTextures[t].rgba, w, h)) {
+      outTextures[t].width = w;
+      outTextures[t].height = h;
+    } else {
+      outTextures[t].rgba.clear();
+      outTextures[t].width = 0;
+      outTextures[t].height = 0;
+    }
+  }
+
+  outMaterials.clear();
+  outMaterials.resize(data->materials_count);
+  for (cgltf_size m = 0; m < data->materials_count; m++) {
+    const cgltf_material &gm = data->materials[m];
+    GltfMaterial &dm = outMaterials[m];
+    if (gm.has_pbr_metallic_roughness) {
+      const auto &pbr = gm.pbr_metallic_roughness;
+      for (int c = 0; c < 4; c++) dm.baseColorFactor[c] = pbr.base_color_factor[c];
+      dm.roughness = pbr.roughness_factor;
+      if (pbr.base_color_texture.texture && data->textures) {
+        dm.baseColorTex = static_cast<std::int32_t>(pbr.base_color_texture.texture - data->textures);
+      }
+    }
+    for (int c = 0; c < 3; c++) dm.emissiveFactor[c] = gm.emissive_factor[c];
+    if (gm.alpha_mode == cgltf_alpha_mode_mask) {
+      dm.alphaMode = GltfAlphaMode::Mask;
+      dm.alphaCutoff = gm.alpha_cutoff;
+    } else if (gm.alpha_mode == cgltf_alpha_mode_blend) {
+      dm.alphaMode = GltfAlphaMode::Blend;
+    } else {
+      dm.alphaMode = GltfAlphaMode::Opaque;
+    }
+    dm.doubleSided = gm.double_sided != 0;
+    dm.unlit = gm.unlit != 0;
+    std::string lname = LowerStr(gm.name);
+    if (lname.find("firecore") != std::string::npos) {
+      dm.isFlame = true;
+    }
+    if (lname.find("sky") != std::string::npos) {
+      dm.isSky = true;
+      dm.unlit = true;
+    }
+    // P3: Disable shadow casting on UNLIT, sky, Blend, distant Mount*, and TreeBoard* materials.
+    const bool isMountOrBoard = (lname.find("_mount") != std::string::npos) ||
+                                (lname.rfind("mount", 0) == 0) ||
+                                (lname.find("treeboard") != std::string::npos);
+    dm.noShadow = dm.unlit || dm.isSky || dm.isFlame ||
+                  (dm.alphaMode == GltfAlphaMode::Blend) || isMountOrBoard;
+  }
+}
+
+std::size_t CalcMipChainBytes(Uint32 w, Uint32 h, Uint32 levels) {
+  std::size_t total = 0;
+  Uint32 mw = w, mh = h;
+  for (Uint32 l = 0; l < levels; l++) {
+    total += static_cast<std::size_t>(mw) * static_cast<std::size_t>(mh) * 4u;
+    if (mw > 1) mw >>= 1;
+    if (mh > 1) mh >>= 1;
+  }
+  return total;
+}
+
+void UploadMipmappedTextures(Device &device, Frame *frame,
+                             const std::vector<GltfCpuTexture> &cpuTextures,
+                             const char *texLabel,
+                             std::vector<GltfTexture> &outTextures,
+                             std::size_t &outVramBytes) {
+  outTextures.clear();
+  outTextures.resize(cpuTextures.size());
+  std::vector<SDL_GPUTexture *> mipTargets;
+  mipTargets.reserve(cpuTextures.size());
+
+  for (std::size_t t = 0; t < cpuTextures.size(); t++) {
+    const GltfCpuTexture &src = cpuTextures[t];
+    outTextures[t].wrapU = src.wrapU;
+    outTextures[t].wrapV = src.wrapV;
+    if (src.width <= 0 || src.height <= 0 || src.rgba.empty()) continue;
+
+    const Uint32 w = static_cast<Uint32>(src.width);
+    const Uint32 h = static_cast<Uint32>(src.height);
+    TextureDesc desc = TextureDesc::Rgba8Mipmapped(w, h, texLabel);
+    if (outTextures[t].tex.Create(device, desc)) {
+      frame->UploadTexture(outTextures[t].tex, src.rgba.data());
+      outVramBytes += CalcMipChainBytes(w, h, desc.levels);
+      if (desc.levels > 1) {
+        mipTargets.push_back(outTextures[t].tex.Handle());
+      }
+    }
+  }
+
+  if (!mipTargets.empty() && !frame->InPass()) {
+    frame->OutsidePass([targets = std::move(mipTargets)](SDL_GPUCommandBuffer *cmd) {
+      for (SDL_GPUTexture *tex : targets) {
+        SDL_GenerateMipmapsForGPUTexture(cmd, tex);
+      }
+    });
+  }
+}
+
+void AppendProceduralSkyDome(std::vector<B3DVertex> &verts, std::vector<std::uint32_t> &indices,
+                             std::vector<GltfArenaSubmesh> &submeshes) {
+  constexpr int kSlices = 24;
+  constexpr int kRings = 10;
+  constexpr float kRadius = 68.0f;
+  const std::uint32_t baseVert = static_cast<std::uint32_t>(verts.size());
+  const std::uint32_t firstIdx = static_cast<std::uint32_t>(indices.size());
+
+  for (int r = 0; r <= kRings; r++) {
+    float t = static_cast<float>(r) / static_cast<float>(kRings);
+    float elev = -0.22f + t * (kPi * 0.5f + 0.22f);
+    float ce = std::cos(elev);
+    float se = std::sin(elev);
+    float upT = std::clamp(se, 0.0f, 1.0f);
+    float cr = 0.64f + (0.20f - 0.64f) * std::pow(upT, 0.65f);
+    float cg = 0.85f + (0.52f - 0.85f) * std::pow(upT, 0.65f);
+    float cb = 0.99f + (0.94f - 0.99f) * std::pow(upT, 0.65f);
+    for (int s = 0; s <= kSlices; s++) {
+      float u = static_cast<float>(s) / static_cast<float>(kSlices);
+      float phi = u * 2.0f * kPi;
+      float x = ce * std::cos(phi);
+      float z = ce * std::sin(phi);
+      B3DVertex v{};
+      v.pos[0] = x * kRadius;
+      v.pos[1] = se * kRadius;
+      v.pos[2] = z * kRadius;
+      v.norm[0] = -x;
+      v.norm[1] = -se;
+      v.norm[2] = -z;
+      v.uv[0] = u;
+      v.uv[1] = 1.0f - t;
+      v.color[0] = cr;
+      v.color[1] = cg;
+      v.color[2] = cb;
+      v.color[3] = 1.0f;
+      verts.push_back(v);
+    }
+  }
+
+  const int stride = kSlices + 1;
+  for (int r = 0; r < kRings; r++) {
+    for (int s = 0; s < kSlices; s++) {
+      std::uint32_t a = baseVert + static_cast<std::uint32_t>(r * stride + s);
+      std::uint32_t b = a + 1;
+      std::uint32_t c = a + static_cast<std::uint32_t>(stride);
+      std::uint32_t d = c + 1;
+      indices.push_back(a); indices.push_back(b); indices.push_back(c);
+      indices.push_back(b); indices.push_back(d); indices.push_back(c);
+    }
+  }
+
+  GltfArenaSubmesh sm{};
+  sm.firstIndex = firstIdx;
+  sm.indexCount = static_cast<std::uint32_t>(indices.size()) - firstIdx;
+  sm.textureIndex = -1;
+  sm.flags = B3D_SUBMESH_UNLIT | B3D_SUBMESH_DOUBLE_SIDED;
+  sm.roughness = 1.0f;
+  sm.fogFactor = 0.0f;
+  sm.alphaMode = GltfAlphaMode::Opaque;
+  sm.isSky = true;
+  sm.castsShadow = false;
+  sm.bboxMin[0] = -kRadius; sm.bboxMin[1] = -kRadius; sm.bboxMin[2] = -kRadius;
+  sm.bboxMax[0] =  kRadius; sm.bboxMax[1] =  kRadius; sm.bboxMax[2] =  kRadius;
+  submeshes.push_back(sm);
+}
+
+void ComputeMissingNormals(std::vector<B3DVertex> &verts, std::uint32_t baseVert,
+                           std::uint32_t vertCount, const std::vector<std::uint32_t> &indices,
+                           std::uint32_t firstIdx, std::uint32_t idxCount) {
+  for (std::uint32_t v = 0; v < vertCount; v++) {
+    verts[baseVert + v].norm[0] = 0.0f;
+    verts[baseVert + v].norm[1] = 0.0f;
+    verts[baseVert + v].norm[2] = 0.0f;
+  }
+  for (std::uint32_t i = firstIdx; i + 2 < firstIdx + idxCount; i += 3) {
+    if (indices[i] >= verts.size() || indices[i + 1] >= verts.size() ||
+        indices[i + 2] >= verts.size()) {
+      continue;
+    }
+    auto &v0 = verts[indices[i]];
+    auto &v1 = verts[indices[i + 1]];
+    auto &v2 = verts[indices[i + 2]];
+    float e1[3] = {v1.pos[0] - v0.pos[0], v1.pos[1] - v0.pos[1], v1.pos[2] - v0.pos[2]};
+    float e2[3] = {v2.pos[0] - v0.pos[0], v2.pos[1] - v0.pos[1], v2.pos[2] - v0.pos[2]};
+    float n[3] = {e1[1] * e2[2] - e1[2] * e2[1],
+                  e1[2] * e2[0] - e1[0] * e2[2],
+                  e1[0] * e2[1] - e1[1] * e2[0]};
+    for (int k = 0; k < 3; k++) {
+      v0.norm[k] += n[k]; v1.norm[k] += n[k]; v2.norm[k] += n[k];
+    }
+  }
+  for (std::uint32_t v = 0; v < vertCount; v++) {
+    float *n = verts[baseVert + v].norm;
+    float len = std::sqrt(n[0] * n[0] + n[1] * n[1] + n[2] * n[2]);
+    if (len > 1e-6f) {
+      n[0] /= len; n[1] /= len; n[2] /= len;
+    } else {
+      n[0] = 0.0f; n[1] = 1.0f; n[2] = 0.0f;
+    }
+  }
+}
+
+void BuildNodeHierarchy(const cgltf_data *data, std::vector<GltfNode> &nodes,
+                        std::vector<std::int32_t> &topoOrder) {
+  nodes.resize(data->nodes_count);
+  for (cgltf_size i = 0; i < data->nodes_count; i++) {
+    const cgltf_node &gn = data->nodes[i];
+    GltfNode &dn = nodes[i];
+    if (gn.parent && data->nodes) {
+      dn.parent = static_cast<std::int32_t>(gn.parent - data->nodes);
+    }
+    if (gn.has_matrix) {
+      dn.hasMatrix = true;
+      std::memcpy(dn.matrix, gn.matrix, sizeof(dn.matrix));
+    } else {
+      if (gn.has_translation) std::memcpy(dn.translation, gn.translation, sizeof(dn.translation));
+      if (gn.has_rotation) std::memcpy(dn.rotation, gn.rotation, sizeof(dn.rotation));
+      if (gn.has_scale) std::memcpy(dn.scale, gn.scale, sizeof(dn.scale));
+      Mat4FromTRS(dn.matrix, dn.translation, dn.rotation, dn.scale);
+    }
+  }
+
+  topoOrder.clear();
+  topoOrder.reserve(nodes.size());
+  std::vector<std::uint8_t> state(nodes.size(), 0); // 0=unvisited, 1=visiting, 2=done
+  auto visit = [&](auto &&self, std::int32_t idx) -> void {
+    if (idx < 0 || static_cast<std::size_t>(idx) >= nodes.size()) return;
+    if (state[idx] != 0) return;
+    state[idx] = 1;
+    if (nodes[idx].parent >= 0) self(self, nodes[idx].parent);
+    state[idx] = 2;
+    topoOrder.push_back(idx);
+  };
+  for (std::int32_t i = 0; i < static_cast<std::int32_t>(nodes.size()); i++) {
+    visit(visit, i);
+  }
+}
