+  cardPlayer = Find("card_player");
+  cardEnemy = Find("card_enemy");
+  partyStrip = Find("party_strip");
+  hpBarFrame = Find("hp_bar_frame");
+  hpFillGreen = Find("hp_fill_green");
+  hpFillYellow = Find("hp_fill_yellow");
+  hpFillRed = Find("hp_fill_red");
+  expBg = Find("exp_bg");
+  expFill = Find("exp_fill");
+  ballOk = Find("ball_ok");
+  ballStatus = Find("ball_status");
+  ballFainted = Find("ball_fainted");
+  ballEmpty = Find("ball_hd_empty");
+  ballHdOk = Find("ball_hd_ok");
+  caughtIcon = Find("caught_icon");
+  genderM = Find("gender_m");
+  genderF = Find("gender_f");
+  keyA = Find("key_a");
