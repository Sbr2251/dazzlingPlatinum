+
+bool Device::Create(const DeviceConfig &config) {
+    if (mDevice) return true;
+    mConfig = config;
+    if (EnvFlag("SIM_GPU_DEBUG")) mConfig.debug = true;
+    const char *envDriver = SDL_getenv("SIM_GPU_DRIVER");
+    if (envDriver && *envDriver) mConfig.driver = envDriver;
+
+    // SDL loads Vulkan through the video subsystem, so it must be up even without a window.
+    if (!SDL_WasInit(SDL_INIT_VIDEO)) {
+        if (!SDL_InitSubSystem(SDL_INIT_VIDEO)) {
+            const char *hint = SDL_GetHint(SDL_HINT_VIDEO_DRIVER);
+            if (hint && *hint) {
+                ReportFailure("SDL_InitSubSystem(VIDEO)");
+                return false;
+            }
+            LogInfo("no display video driver (%s); using the offscreen video driver", SDL_GetError());
+            SDL_SetHint(SDL_HINT_VIDEO_DRIVER, "offscreen");
+            if (!SDL_InitSubSystem(SDL_INIT_VIDEO)) {
+                ReportFailure("SDL_InitSubSystem(VIDEO) with the offscreen driver");
+                return false;
+            }
+        }
+        mInitedVideo = true;
+    }
+
+    SDL_PropertiesID props = SDL_CreateProperties();
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_SHADERS_SPIRV_BOOLEAN, true);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_SHADERS_MSL_BOOLEAN, true);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_DEBUGMODE_BOOLEAN, mConfig.debug);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_VERBOSE_BOOLEAN, mConfig.debug);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_PREFERLOWPOWER_BOOLEAN, mConfig.preferLowPower);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_VULKAN_REQUIRE_HARDWARE_ACCELERATION_BOOLEAN, mConfig.requireHardware);
+    // Optional Vulkan features nothing here uses; leaving them off keeps older Android devices eligible.
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_FEATURE_CLIP_DISTANCE_BOOLEAN, false);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_FEATURE_INDIRECT_DRAW_FIRST_INSTANCE_BOOLEAN, false);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_FEATURE_ANISOTROPY_BOOLEAN, false);
+    SDL_SetBooleanProperty(props, SDL_PROP_GPU_DEVICE_CREATE_FEATURE_DEPTH_CLAMPING_BOOLEAN, mConfig.depthClamping);
+    if (mConfig.driver) SDL_SetStringProperty(props, SDL_PROP_GPU_DEVICE_CREATE_NAME_STRING, mConfig.driver);
+    mDevice = SDL_CreateGPUDeviceWithProperties(props);
+    SDL_DestroyProperties(props);
+    if (!mDevice) {
+        ReportFailure("SDL_CreateGPUDeviceWithProperties");
+        Destroy();
+        return false;
+    }
+
+    SDL_GPUShaderFormat formats = SDL_GetGPUShaderFormats(mDevice);
+    if (formats & SDL_GPU_SHADERFORMAT_SPIRV) {
+        mShaderFormat = SDL_GPU_SHADERFORMAT_SPIRV;
+    } else if (formats & SDL_GPU_SHADERFORMAT_MSL) {
+        mShaderFormat = SDL_GPU_SHADERFORMAT_MSL;
+    } else {
+        ReportFailure("the GPU driver accepts neither SPIR-V nor MSL shaders", false);
+        Destroy();
+        return false;
+    }
+
+    // D24 matches the GL renderer's depth precision; Apple GPUs only offer D32_FLOAT (and D16).
+    const SDL_GPUTextureUsageFlags depthUsage = SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET;
+    if (SDL_GPUTextureSupportsFormat(mDevice, SDL_GPU_TEXTUREFORMAT_D24_UNORM, SDL_GPU_TEXTURETYPE_2D, depthUsage)) {
+        mDepthFormat = SDL_GPU_TEXTUREFORMAT_D24_UNORM;
+    } else if (SDL_GPUTextureSupportsFormat(mDevice, SDL_GPU_TEXTUREFORMAT_D32_FLOAT, SDL_GPU_TEXTURETYPE_2D, depthUsage)) {
+        mDepthFormat = SDL_GPU_TEXTUREFORMAT_D32_FLOAT;
+    } else {
+        mDepthFormat = SDL_GPU_TEXTUREFORMAT_D16_UNORM;
+    }
+
+    Uint32 fif = mConfig.framesInFlight < 1 ? 1 : (mConfig.framesInFlight > 3 ? 3 : mConfig.framesInFlight);
+    if (fif != 2 && !SDL_SetGPUAllowedFramesInFlight(mDevice, fif)) ReportFailure("SDL_SetGPUAllowedFramesInFlight");
+
+    mPipelines = std::make_unique<PipelineCache>(*this);
+    mSamplers = std::make_unique<SamplerCache>(*this);
+    mFrame = std::make_unique<Frame>(*this);
+
+    SDL_PropertiesID dp = SDL_GetGPUDeviceProperties(mDevice);
+    LogInfo("device: driver %s, %s (%s), shaders %s, depth %s%s", SDL_GetGPUDeviceDriver(mDevice),
+            dp ? SDL_GetStringProperty(dp, SDL_PROP_GPU_DEVICE_NAME_STRING, "?") : "?",
+            dp ? SDL_GetStringProperty(dp, SDL_PROP_GPU_DEVICE_DRIVER_INFO_STRING, "?") : "?",
+            mShaderFormat == SDL_GPU_SHADERFORMAT_SPIRV ? "SPIR-V" : "MSL",
+            mDepthFormat == SDL_GPU_TEXTUREFORMAT_D24_UNORM ? "D24" : (mDepthFormat == SDL_GPU_TEXTUREFORMAT_D32_FLOAT ? "D32F" : "D16"),
+            mConfig.debug ? ", debug mode" : "");
+    return true;
+}
