+// ios-build hook: backend selection for iOS. GPU (Metal through SDL GPU) only;
+// the OpenGL backend is compiled out, so there is no gl fallback. This file
+// replaces Select() from render_gl/sim_render_gl.cpp on iOS only.
+#include <simulator/sim_render_backend.hpp>
+
+#include <cstdio>
+
+namespace SIM::Render {
+
+namespace detail {
+Backend *gBackend = nullptr;
+} // namespace detail
+
+Backend *CreateGpuBackend();
+bool GpuDeviceAvailable();
+
+Backend &Select() {
+  if (detail::gBackend) return *detail::gBackend;
+  printf("Renderer: gpu (iOS, from ios-build hook)\n");
+  fflush(stdout);
+  detail::gBackend = CreateGpuBackend();
+  return *detail::gBackend;
+}
+
+} // namespace SIM::Render
