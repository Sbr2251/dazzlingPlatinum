diff --git a/libraries/sim/src/gpu/shaders/vram.frag b/libraries/sim/src/gpu/shaders/vram.frag
new file mode 100644
index 0000000..3c4bac2
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/vram.frag
@@ -0,0 +1,17 @@
+#version 450
+layout(set = 2, binding = 0) uniform sampler2D capTex;
+layout(set = 3, binding = 0) uniform CapParams {
+  int topScreen;
+  float brightFactor;
+  int brightMode;
+};
+layout(location = 0) in vec2 vUv;
+layout(location = 0) out vec4 color;
+void main() {
+  if (topScreen == 1) { if (vUv.y < 0.5) discard; }
+  else { if (vUv.y >= 0.5) discard; }
+  color = texture(capTex, vUv);
+  if (brightMode == 1) color.rgb += (1.0 - color.rgb) * (brightFactor / 16.0);
+  else if (brightMode == 2) color.rgb -= color.rgb * (brightFactor / 16.0);
+  color.a = 1.0;
+}
