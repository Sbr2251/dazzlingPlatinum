 namespace SIM::G3 {
 
+// Identifies one decoded texture without hashing its pixels: the VRAM
+// range it was decoded from plus everything that changes the decode.
+struct TextureKey {
+  std::uintptr_t texAddr = 0;
+  u32 texSize = 0;
+  std::uintptr_t plttAddr = 0;
+  u32 format = 0;
+  u32 sizeS = 0;
+  u32 sizeT = 0;
+  u32 color0 = 0;
+  bool usePalette = false;
+  bool operator==(const TextureKey& o) const {
+    return texAddr == o.texAddr && texSize == o.texSize && plttAddr == o.plttAddr &&
+           format == o.format && sizeS == o.sizeS && sizeT == o.sizeT &&
+           color0 == o.color0 && usePalette == o.usePalette;
+  }
+};
+struct TextureKeyHash {
+  std::size_t operator()(const TextureKey& k) const {
+    std::size_t h = std::hash<std::uintptr_t>{}(k.texAddr);
+    h = h * 1315423911u + std::hash<std::uintptr_t>{}(k.plttAddr);
+    h = h * 1315423911u + (k.texSize * 2654435761u + k.format * 97u + k.sizeS * 13u + k.sizeT * 7u + k.color0);
+    return h;
+  }
+};
