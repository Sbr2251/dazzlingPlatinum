+        sys.stderr.write(p.stderr.decode(errors="replace"))
+        sys.exit(1)
+    return p.stdout
+
+
+def main():
+    glslang = shutil.which("glslangValidator") or os.path.expanduser("~/.local/bin/glslangValidator")
