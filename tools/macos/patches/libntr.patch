+  if (srcBMem) {
+    static int logged = 0;
+    if (!logged) { logged = 1; printf("SIM capture: main-memory FIFO source B approximated by DISP_MMEM_FIFO value\n"); }
+  }
+  for (int y = 0; y < h; y++) {
+    for (int x = 0; x < w; x++) {
+      int i = y * w + x;
+      const u8 *a = &srcA[(y * 256 + x) * 4];
+      int ar = (a[0] * 31 + 127) / 255, ag = (a[1] * 31 + 127) / 255, ab = (a[2] * 31 + 127) / 255;
+      u16 bpx = srcBMem ? (u16)s_reg_GX_DISP_MMEM_FIFO : lcdc[srcBIdx + i];
+      int br = bpx & 31, bg = (bpx >> 5) & 31, bb = (bpx >> 10) & 31;
+      int r, g, b;
+      if (mode == 0) { r = ar; g = ag; b = ab; }
+      else if (mode == 1) { r = br; g = bg; b = bb; }
+      else {
+        r = (ar * eva + br * evb + 8) >> 4;
+        g = (ag * eva + bg * evb + 8) >> 4;
+        b = (ab * eva + bb * evb + 8) >> 4;
+        if (r > 31) r = 31; if (g > 31) g = 31; if (b > 31) b = 31;
+      }
+      int alpha = mode == 1 ? ((bpx >> 15) & 1) : 1;
+      u16 out = (u16)(r | (g << 5) | (b << 10) | (alpha << 15));
+      lcdc[destIdx + i] = out;
+      if (bgAlias) *(u16 *)(bgAlias + i * 2) = out;
+      if (subBgAlias) *(u16 *)(subBgAlias + i * 2) = out;
+    }
+  }
+  s_reg_GX_DISPCAPCNT = cap & ~0x80000000u;
+  if (getenv("SIM_DEBUG_CAPTURE"))
+    printf("SIM capture: %dx%d mode=%d srcA=%s eva=%d evb=%d dest=VRAM_%c+0x%x\n",
+           w, h, mode, srcA3D ? "3D" : "2D3D", eva, evb, 'A' + destBank, destOfs);
+}
+
+// Display the main screen from a VRAM bank (DISPCNT display mode 2,
+// GX_DISPMODE_VRAM_A-D): a 256x192 RGB555 bitmap at the bank base.
+static void DrawVramDisplay() {
+  u32 dispcnt = s_reg_GX_DISPCNT;
+  int bank = (dispcnt >> 18) & 3;
+  const u16 *lcdc = (const u16 *)s_HW_LCDC_VRAM;
+  static u8 buf[256 * 384 * 4];
+  memset(buf, 0, sizeof(buf));
+  int topScreen = (s_reg_GX_POWCNT >> 15) ? 1 : 0;
+  for (int y = 0; y < 192; y++) {
+    int memRow = topScreen ? (383 - y) : (191 - y);
+    for (int x = 0; x < 256; x++) {
+      u8 r, g, b;
+      SIM_u16ToRGB(lcdc[bank * 0x10000 + y * 256 + x], &r, &g, &b);
+      u8 *q = &buf[(memRow * 256 + x) * 4];
+      q[0] = r; q[1] = g; q[2] = b; q[3] = 255;
+    }
+  }
+  float bright = (float)(s_reg_GX_MASTER_BRIGHT & 31);
+  if (bright > 16.0f) bright = 16.0f;
+  SIM::Render::Get().DrawVramDisplay(
+      buf, topScreen, bright, (s_reg_GX_MASTER_BRIGHT >> 14) & 3,
+      SIM::GetScreenQuadArray(s_SIM_config.screenLayout,
+                              s_SIM_config.swapScreens),
+      SIM::GetScreenQuadVertexCount(s_SIM_config.screenLayout,
+                                    s_SIM_config.swapScreens));
+}
