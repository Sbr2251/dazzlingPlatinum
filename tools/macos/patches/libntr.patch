@@ -0,0 +1,192 @@
+// Hi-res text overlay (lane hiresui, prototype). See sim_hirestext.h.
+//
+// Game code reports dialogue glyphs as it prints them; this file expands
+// them at HIRES_SCALE into a CPU RGBA buffer covering the combined display
+// (256x384 DS pixels), uploads it when dirty and draws it over the
+// composited frame. New file on purpose: nothing here touches the G2 layer
+// renderers or the composite shader, so it merges independently.
+#include <nitro.h>
+#include <simulator/sim.h>
+#include <simulator/sim_opengl.h>
+#include <simulator/simvariables.h>
+#include <simulator/config/sim_config.h>
+#include <stdio.h>
+#include <string.h>
+#include "sim_hirestext.h"
+
+namespace SIM {
+extern const char *PostVertexShader;
+extern const char *HiResTextFragmentShader;
+}
+
+extern "C" void SIM_u16ToRGB(u16 in, u8 *r, u8 *g, u8 *b);
+SIM_config_type *SIM_GetConfigPtr();
+
+static constexpr int kScale = 4;
+static constexpr int kBufW = SIM_NDS_SCREEN_WIDTH * kScale;   // 1024
+static constexpr int kBufH = SIM_NDS_SCREEN_HEIGHT * 2 * kScale; // 1536
+
+static u8 sBuf[kBufW * kBufH * 4];
+static bool sHasContent = false;
+static bool sDirty = false;
+
+static GLuint sProg = 0, sTex = 0, sVao = 0, sVbo = 0;
+static int sInitFailed = 0;
+
+static GLuint Compile(GLenum type, const char *src) {
+  char *tmp = nullptr;
+  const char *use = src;
+#ifdef SDK_BUILD_MACOS
+  if (strncmp(src, "\n#version 420", 13) == 0 || strncmp(src, "#version 420", 12) == 0) {
+    tmp = strdup(src);
+    char *p = strstr(tmp, "#version 420");
+    if (p) memcpy(p, "#version 410", 12);
+    use = tmp;
+  }
+#endif
+  GLuint s = glCreateShader(type);
+  glShaderSource(s, 1, &use, nullptr);
+  glCompileShader(s);
+  GLint ok = 0;
+  glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+  if (!ok) {
+    GLint len = 0;
+    glGetShaderiv(s, GL_INFO_LOG_LENGTH, &len);
+    char *log = new char[len + 1]();
+    glGetShaderInfoLog(s, len, nullptr, log);
+    printf("HiResText: shader compile failed: %s\n", log);
+    delete[] log;
+  }
+  if (tmp) free(tmp);
+  return ok ? s : 0;
+}
+
+static bool Init() {
+  if (sProg || sInitFailed) return sProg != 0;
+  GLuint vs = Compile(GL_VERTEX_SHADER, SIM::PostVertexShader);
+  GLuint fs = Compile(GL_FRAGMENT_SHADER, SIM::HiResTextFragmentShader);
+  if (!vs || !fs) { sInitFailed = 1; return false; }
+  sProg = glCreateProgram();
+  glAttachShader(sProg, vs);
+  glAttachShader(sProg, fs);
+  glLinkProgram(sProg);
+  GLint ok = 0;
+  glGetProgramiv(sProg, GL_LINK_STATUS, &ok);
+  if (!ok) { sInitFailed = 1; printf("HiResText: link failed\n"); return false; }
+  glGenTextures(1, &sTex);
+  glBindTexture(GL_TEXTURE_2D, sTex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, kBufW, kBufH, 0, GL_RGBA, GL_UNSIGNED_BYTE, nullptr);
+  glGenVertexArrays(1, &sVao);
+  glGenBuffers(1, &sVbo);
+  // Fullscreen quad; v is flipped so buffer row 0 (main-screen top) lands
+  // at the top of the viewport.
+  static const float quad[] = {
+      -1.0f, -1.0f, 0.0f, 0.0f, 1.0f,  1.0f, -1.0f, 0.0f, 1.0f, 1.0f,
+       1.0f,  1.0f, 0.0f, 1.0f, 0.0f, -1.0f, -1.0f, 0.0f, 0.0f, 1.0f,
+       1.0f,  1.0f, 0.0f, 1.0f, 0.0f, -1.0f,  1.0f, 0.0f, 0.0f, 0.0f,
+  };
+  glBindVertexArray(sVao);
+  glBindBuffer(GL_ARRAY_BUFFER, sVbo);
+  glBufferData(GL_ARRAY_BUFFER, sizeof(quad), quad, GL_STATIC_DRAW);
+  glEnableVertexAttribArray(0);
+  glEnableVertexAttribArray(1);
+  glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, 5 * sizeof(float), (void *)0);
+  glVertexAttribPointer(1, 2, GL_FLOAT, GL_FALSE, 5 * sizeof(float), (void *)(3 * sizeof(float)));
+  glProgramUniform1i(sProg, glGetUniformLocation(sProg, "overlayTex"), 0);
+  printf("HiResText: overlay enabled (dialogue prototype)\n");
+  return true;
+}
+
+// DS-pixel rect -> clamped buffer-space rect for one screen.
+static bool ClipRect(int isSub, int x, int y, int w, int h,
+                     int *bx, int *by, int *bw, int *bh) {
+  int ox = x, oy = y + (isSub ? SIM_NDS_SCREEN_HEIGHT : 0);
+  if (ox < 0) { w += ox; ox = 0; }
+  if (oy < 0) { h += oy; oy = 0; }
+  if (ox + w > SIM_NDS_SCREEN_WIDTH) w = SIM_NDS_SCREEN_WIDTH - ox;
+  int screenBottom = (isSub ? SIM_NDS_SCREEN_HEIGHT * 2 : SIM_NDS_SCREEN_HEIGHT);
+  if (oy + h > screenBottom) h = screenBottom - oy;
+  if (w <= 0 || h <= 0) return false;
+  *bx = ox; *by = oy; *bw = w; *bh = h;
+  return true;
+}
+
+extern "C" void HiResText_Glyph(int isSub, int x, int y, int w, int h,
+                                const unsigned char *gfx, int palette,
+                                int fgColor, int shadowColor) {
+  if (!gfx || w <= 0 || h <= 0 || w > 32 || h > 32) return;
+  int bx, by, bw, bh;
+  if (!ClipRect(isSub, x, y, w, h, &bx, &by, &bw, &bh)) return;
+  const u16 *pal = (const u16 *)(isSub ? s_HW_DB_BG_PLTT : s_HW_BG_PLTT);
+  u8 fgR, fgG, fgB, shR, shG, shB;
+  SIM_u16ToRGB(pal[((palette & 0xF) << 4) + (fgColor & 0xF)], &fgR, &fgG, &fgB);
+  SIM_u16ToRGB(pal[((palette & 0xF) << 4) + (shadowColor & 0xF)], &shR, &shG, &shB);
+  for (int sy = 0; sy < h; sy++) {
+    for (int sx = 0; sx < w; sx++) {
+      int off = (sy >> 3) * 64 + (sx >> 3) * 32 + (sy & 7) * 4 + ((sx & 7) >> 1);
+      u8 byte = gfx[off];
+      int nib = (sx & 1) ? (byte >> 4) : (byte & 0xF);
+      const u8 *col;
+      if (nib == (fgColor & 0xF)) col = &fgR;
+      else if (nib == (shadowColor & 0xF)) col = &shR;
+      else continue; // background pixels: the DS box underneath already shows
+      int dx = (x + sx) * kScale;
+      int dy = (y + (isSub ? SIM_NDS_SCREEN_HEIGHT : 0) + sy) * kScale;
+      for (int ky = 0; ky < kScale; ky++) {
+        u8 *row = &sBuf[((dy + ky) * kBufW + dx) * 4];
+        for (int kx = 0; kx < kScale; kx++, row += 4) {
+          row[0] = col[0]; row[1] = col[1]; row[2] = col[2]; row[3] = 255;
+        }
+      }
+    }
+  }
+  sHasContent = true;
+  sDirty = true;
+}
+
+extern "C" void HiResText_ClearRect(int isSub, int x, int y, int w, int h) {
+  int bx, by, bw, bh;
+  if (!ClipRect(isSub, x, y, w, h, &bx, &by, &bw, &bh)) return;
+  for (int row = 0; row < bh * kScale; row++)
+    memset(&sBuf[((by * kScale + row) * kBufW + bx * kScale) * 4], 0, (size_t)bw * kScale * 4);
+  sDirty = true;
+}
+
+extern "C" void HiResText_ScrollRectUp(int isSub, int x, int y, int w, int h, int dy) {
+  if (dy <= 0) return;
+  int bx, by, bw, bh;
+  if (!ClipRect(isSub, x, y, w, h, &bx, &by, &bw, &bh)) return;
+  if (dy >= bh) { HiResText_ClearRect(isSub, x, y, w, h); return; }
+  int pxY = by * kScale, pxH = bh * kScale, pxDy = dy * kScale, pxX = bx * kScale, pxW = bw * kScale;
+  for (int row = 0; row < pxH - pxDy; row++)
+    memmove(&sBuf[((pxY + row) * kBufW + pxX) * 4], &sBuf[((pxY + row + pxDy) * kBufW + pxX) * 4], (size_t)pxW * 4);
+  for (int row = pxH - pxDy; row < pxH; row++)
+    memset(&sBuf[((pxY + row) * kBufW + pxX) * 4], 0, (size_t)pxW * 4);
+  sDirty = true;
+}
+
+void HiResText_DrawOverlay(void) {
+  if (!sHasContent) return;
+  SIM_config_type *cfg = SIM_GetConfigPtr();
+  if (cfg && (cfg->screenLayout != SIM_CONFIG_SCREEN_LAYOUT_VERTICAL || cfg->swapScreens)) return;
+  if (!Init()) return;
+  GLint prevProg = 0, prevVao = 0;
+  glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+  glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+  glUseProgram(sProg);
+  glActiveTexture(GL_TEXTURE0);
+  glBindTexture(GL_TEXTURE_2D, sTex);
+  if (sDirty) {
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, kBufW, kBufH, GL_RGBA, GL_UNSIGNED_BYTE, sBuf);
+    sDirty = false;
+  }
+  glBindVertexArray(sVao);
+  glDisable(GL_DEPTH_TEST);
+  glDrawArrays(GL_TRIANGLES, 0, 6);
+  glBindVertexArray((GLuint)prevVao);
+  glUseProgram((GLuint)prevProg);
+}
