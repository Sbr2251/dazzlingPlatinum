+void DrawHpBar(const HudExtDraw &ext, float x, float y, float w, float h, int hp, int maxHp) {
+  float frac = (maxHp > 0) ? std::clamp(static_cast<float>(hp) / static_cast<float>(maxHp), 0.0f, 1.0f) : 0.0f;
+  ext.roundRect(x, y, w, h, h * 0.5f, HudC4(16, 22, 34, 0.92f), HudC4(24, 32, 46, 0.92f),
+                0.45f, HudC4(180, 200, 228, 0.45f));
+  float fillW = (w - 1.6f) * frac;
+  if (fillW > 0.6f) {
+    HudExtColor top = HudC4(78, 224, 128), bot = HudC4(42, 180, 92);
+    if (frac <= 0.20f) {
+      top = HudC4(246, 84, 76);
+      bot = HudC4(204, 48, 44);
+    } else if (frac <= 0.50f) {
+      top = HudC4(248, 206, 62);
+      bot = HudC4(216, 162, 26);
+    }
+    ext.roundRect(x + 0.8f, y + 0.8f, fillW, h - 1.6f, (h - 1.6f) * 0.5f, top, bot, 0.0f, {});
+  }
+}
