+                     sFxShock.framesLeft > 0 ? sFxShock.strength * (1.0f - shockProgress * 0.5f) : 0.0f);
+  float zu = 0.5f, zv = 0.5f; FxUV(sFxZoom, &zu, &zv);
+  glProgramUniform2f(sPostProgramID, glGetUniformLocation(sPostProgramID, "zoomCenter"), zu, zv);
+  glProgramUniform1f(sPostProgramID, glGetUniformLocation(sPostProgramID, "zoomBlur"),
+                     sFxZoom.framesLeft > 0 ? sFxZoom.strength * FxFactor(sFxZoom) : 0.0f);
