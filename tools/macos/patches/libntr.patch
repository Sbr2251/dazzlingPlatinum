+  void ApplyUpscaleFilter(int mode) override {
+    if (mode == mUpscaleApplied) return;
+    mUpscaleApplied = mode;
+    GLenum f = (mode == 0) ? GL_NEAREST : GL_LINEAR;
+    GLint prevActive = 0;
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActive);
+    for (int i = 0; i < 4; i++) {
+      glActiveTexture(GL_TEXTURE0 + kBgUnits[i]);
+      GLint b = 0;
+      glGetIntegerv(GL_TEXTURE_BINDING_2D, &b);
+      GLuint saved = (GLuint)b;
+      glBindTexture(GL_TEXTURE_2D, mBgTex[i]);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, f);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, f);
+      glBindTexture(GL_TEXTURE_2D, saved);
+    }
+    for (int i = 0; i < 5; i++) {
+      glActiveTexture(GL_TEXTURE0 + kObjUnits[i]);
+      GLint b = 0;
+      glGetIntegerv(GL_TEXTURE_BINDING_2D, &b);
+      GLuint saved = (GLuint)b;
+      glBindTexture(GL_TEXTURE_2D, mObjTex[i]);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, f);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, f);
+      glBindTexture(GL_TEXTURE_2D, saved);
+    }
+    glActiveTexture(GL_TEXTURE0);
+    {
+      GLint b = 0;
+      glGetIntegerv(GL_TEXTURE_BINDING_2D, &b);
+      glBindTexture(GL_TEXTURE_2D, mDummyTex);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, f);
+      glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, f);
+      glBindTexture(GL_TEXTURE_2D, (GLuint)b);
+    }
+    // mObjWindowTex stays NEAREST: it is a mask, tested with > 0.1.
+    glActiveTexture((GLenum)prevActive);
+  }
