+// Display the main screen from a VRAM bank (DISPCNT display mode 2,
+// GX_DISPMODE_VRAM_A-D): a 256x192 RGB555 bitmap at the bank base.
+static void DrawVramDisplay() {
+  if (!sCapProg) return;
+  u32 dispcnt = s_reg_GX_DISPCNT;
+  int bank = (dispcnt >> 18) & 3;
+  const u16 *lcdc = (const u16 *)s_HW_LCDC_VRAM;
+  static u8 buf[256 * 384 * 4];
+  memset(buf, 0, sizeof(buf));
+  int topScreen = (s_reg_GX_POWCNT >> 15) ? 1 : 0;
+  for (int y = 0; y < 192; y++) {
+    int memRow = topScreen ? (383 - y) : (191 - y);
+    for (int x = 0; x < 256; x++) {
+      u8 r, g, b;
+      SIM_u16ToRGB(lcdc[bank * 0x10000 + y * 256 + x], &r, &g, &b);
+      u8 *q = &buf[(memRow * 256 + x) * 4];
+      q[0] = r; q[1] = g; q[2] = b; q[3] = 255;
+    }
+  }
+  GLint prevProg = 0, prevActive = 0;
+  glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+  glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActive);
+  glActiveTexture(GL_TEXTURE0);
+  glBindTexture(GL_TEXTURE_2D, sCapDispTex);
+  glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 256, 384, GL_RGBA, GL_UNSIGNED_BYTE, buf);
+  glUseProgram(sCapProg);
+  glProgramUniform1i(sCapProg, glGetUniformLocation(sCapProg, "capTex"), 0);
+  glProgramUniform1i(sCapProg, glGetUniformLocation(sCapProg, "topScreen"), topScreen);
+  float bright = (float)(s_reg_GX_MASTER_BRIGHT & 31);
+  if (bright > 16.0f) bright = 16.0f;
+  glProgramUniform1f(sCapProg, glGetUniformLocation(sCapProg, "brightFactor"), bright);
+  glProgramUniform1i(sCapProg, glGetUniformLocation(sCapProg, "brightMode"),
+                     (s_reg_GX_MASTER_BRIGHT >> 14) & 3);
+  DrawScreenQuad();
+  glUseProgram((GLuint)prevProg);
+  glActiveTexture((GLenum)prevActive);
+}
