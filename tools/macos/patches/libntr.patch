diff --git a/libraries/sim/src/shaders/post_fragment.glsl b/libraries/sim/src/shaders/post_fragment.glsl
new file mode 100644
index 0000000..15a1967
--- /dev/null
+++ b/libraries/sim/src/shaders/post_fragment.glsl
@@ -0,0 +1,156 @@
+R""(
+#version 420 core
+
+// PostFX post pass: samples the fully composited frame (both screens) and
+// applies the effects driven from game code via include/port/postfx.h.
+// All effect strengths are already decayed CPU-side per rendered frame;
+// a strength of 0 makes this a plain passthrough.
+uniform sampler2D sceneTex;
+uniform vec2 texelSize;        // 1 / drawable size
+uniform vec2 shakeOffset;      // in UV units
+uniform vec2 shockCenter;      // UV, combined-display coords converted CPU-side
+uniform float shockRadius;     // expanding ring radius, in combined-display units
+uniform float shockStrength;   // UV distortion at the ring
+uniform vec2 zoomCenter;       // UV
+uniform float zoomBlur;        // radial blur amount
+uniform vec3 vignetteColor;
+uniform float vignetteAmount;  // 0 = none
+uniform float chromaAmount;    // chromatic aberration, in texels at the corners
+uniform float glowAmount;      // bloom-ish glow
+uniform float letterbox;       // bar height as a fraction of the main screen
+uniform int fxRegion;          // 0 both screens, 1 main/top only, 2 sub only
+uniform float cutinProgress;   // Key Stone cut-in sweep position 0-1
+uniform float cutinAlpha;
+uniform vec2 beamTarget;       // UV in the combined display
+uniform float titleProgress;   // title-card band sweep 0-1
+uniform float titleAlpha;
+uniform vec2 glowCenter;       // UV, combined display
+uniform float glowAtAmount;    // localised radial glow
+
+smooth in vec2 fragTexCoord;
+out vec4 color;
+
+vec3 FxRainbow(float t)
+{
+    return 0.55 + 0.45 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67)));
+}
+
+void main()
+{
+    // Screen mask: effects default to the main (top/battle) screen only, so
+    // the bottom touch screen stays clean during cinematics.
+    if (fxRegion == 1 && fragTexCoord.y < 0.5) { color = texture(sceneTex, fragTexCoord); return; }
+    if (fxRegion == 2 && fragTexCoord.y >= 0.5) { color = texture(sceneTex, fragTexCoord); return; }
+
+    vec2 uv = fragTexCoord + shakeOffset;
+
+    // Shockwave: push UVs away from the centre as the ring passes.
+    if (shockStrength > 0.001) {
+        vec2 d = uv - shockCenter;
+        d.x *= 256.0 / 384.0; // combined display is 256x384; keep the ring round
+        float dist = length(d);
+        float band = exp(-pow((dist - shockRadius) * 9.0, 2.0));
+        vec2 dir = dist > 0.0001 ? normalize(uv - shockCenter) : vec2(0.0);
+        uv += dir * band * shockStrength * 0.05;
+    }
+
+    vec3 c;
+    if (zoomBlur > 0.001) {
+        // Zoom blur: average taps along the ray from the zoom centre.
+        c = texture(sceneTex, uv).rgb * 0.24;
+        for (int i = 1; i <= 4; i++) {
+            float t = float(i) / 4.0;
+            vec2 s = mix(uv, zoomCenter, -t * zoomBlur * 0.12);
+            c += texture(sceneTex, s).rgb * 0.19;
+        }
+    } else {
+        c = texture(sceneTex, uv).rgb;
+    }
+
+    if (chromaAmount > 0.001) {
+        vec2 dir = (uv - vec2(0.5)) * chromaAmount * texelSize * 6.0;
+        c.r = texture(sceneTex, uv + dir).r;
+        c.b = texture(sceneTex, uv - dir).b;
+    }
+
+    if (glowAmount > 0.001) {
+        // Bloom-ish: bleed the bright parts into their neighbourhood.
+        vec3 bright = vec3(0.0);
+        bright += texture(sceneTex, uv + vec2(texelSize.x * 2.0, 0.0)).rgb;
+        bright += texture(sceneTex, uv - vec2(texelSize.x * 2.0, 0.0)).rgb;
+        bright += texture(sceneTex, uv + vec2(0.0, texelSize.y * 2.0)).rgb;
+        bright += texture(sceneTex, uv - vec2(0.0, texelSize.y * 2.0)).rgb;
+        bright *= 0.25;
+        bright = max(bright - vec3(0.55), vec3(0.0)) * 1.8;
+        c += bright * glowAmount;
+    }
+
+    if (vignetteAmount > 0.001) {
+        vec2 d = (uv - vec2(0.5)) * vec2(1.15, 1.0);
+        float v = smoothstep(0.35, 0.95, length(d));
+        c = mix(c, vignetteColor, v * vignetteAmount);
+    }
+
+    if (glowAtAmount > 0.001 && fragTexCoord.y >= 0.5) {
+        vec2 gd = (fragTexCoord - glowCenter) * vec2(1.3333, 1.0);
+        float g = smoothstep(0.16, 0.0, length(gd));
+        c += FxRainbow(glowCenter.x * 2.0) * g * glowAtAmount * 0.7;
+    }
+
+    // Key Stone cut-in + title card: main screen only.
+    if (fragTexCoord.y >= 0.5 && (cutinAlpha > 0.001 || titleAlpha > 0.001)) {
+        vec2 p = vec2(fragTexCoord.x, (fragTexCoord.y - 0.5) * 2.0); // 0-1, bottom-to-top of main screen
+        vec2 pa = vec2(p.x * 1.3333, p.y); // aspect-corrected (256x192)
+
+        if (titleAlpha > 0.001) {
+            float bandY = abs(p.y - 0.5);
+            float band = smoothstep(0.16, 0.14, bandY);
+            float slide = (p.x - (titleProgress * 1.4 - 0.2));
+            vec3 bandCol = mix(vec3(0.10, 0.02, 0.22), vec3(0.23, 0.05, 0.38), p.y);
+            float edge = smoothstep(0.035, 0.0, abs(bandY - 0.15));
+            bandCol += FxRainbow(p.x * 0.5 + titleProgress) * edge * 1.4;
+            bandCol += vec3(1.0) * smoothstep(0.10, 0.0, abs(slide)) * 0.35; // sweep highlight
+            c = mix(c, bandCol, band * titleAlpha);
+        }
+
+        if (cutinAlpha > 0.001) {
+            float diag = p.x * 0.75 + p.y * 0.45;
+            float centre = mix(-0.25, 1.35, cutinProgress);
+            float d = abs(diag - centre);
+            float band = smoothstep(0.17, 0.13, d);
+            vec3 strip = FxRainbow(diag * 1.5 - cutinProgress * 0.7) * 0.85 + vec3(0.12);
+            strip += vec3(1.0) * smoothstep(0.03, 0.0, d) * 0.8; // hot core line
+            c = mix(c, strip, band * cutinAlpha * 0.88);
+
+            // The Key Stone rides the strip; a rainbow beam links it to the battler.
+            vec2 stone = vec2(mix(0.18, 0.82, cutinProgress), 0.58);
+            vec2 stoneA = vec2(stone.x * 1.3333, stone.y);
+            vec2 tgt = vec2(beamTarget.x, (beamTarget.y - 0.5) * 2.0);
+            vec2 tgtA = vec2(tgt.x * 1.3333, tgt.y);
+            vec2 pa2 = pa - stoneA;
+            vec2 ba = tgtA - stoneA;
+            float h = clamp(dot(pa2, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0);
+            float beamD = length(pa2 - ba * h);
+            float beam = smoothstep(0.018, 0.004, beamD) * sin(cutinProgress * 3.14159);
+            c += FxRainbow(h * 1.5 - cutinProgress) * beam * cutinAlpha * 0.9;
+
+            float sd = length(pa2);
+            float ang = atan(pa2.y, pa2.x) / 6.28318 + 0.5;
+            float ring = smoothstep(0.012, 0.004, abs(sd - 0.055));
+            float core = smoothstep(0.045, 0.01, sd);
+            float halo = smoothstep(0.16, 0.0, sd) * 0.35;
+            c += (FxRainbow(ang + cutinProgress * 0.5) * ring * 1.6 + vec3(1.0) * core * 1.2 + FxRainbow(ang) * halo) * cutinAlpha;
+        }
+    }
+
+    if (letterbox > 0.001) {
+        // Bars on the main screen only: it occupies the top half (v 0.5-1).
+        float bar = letterbox * 0.5;
+        if (fragTexCoord.y > 1.0 - bar || (fragTexCoord.y >= 0.5 && fragTexCoord.y < 0.5 + bar)) {
+            c = vec3(0.0);
+        }
+    }
+
+    color = vec4(c, 1.0);
+}
+)""
