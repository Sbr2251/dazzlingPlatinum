@@ -0,0 +1,419 @@
+#include "fx_hudhd_atlas.hpp"
+
+#include "third_party/stb_image.h"
+#include <simulator/sim_headless.h>
+#include <simulator/sim_platform.h>
+
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <unistd.h>
+#include <vector>
+
+namespace SIM::Render {
+namespace {
+
+using namespace SIM::Gpu;
+
+bool EnvIsOne(const char *name) {
+  const char *v = std::getenv(name);
+  return v != nullptr && v[0] == '1';
+}
+
+bool EnvIsZero(const char *name) {
+  const char *v = std::getenv(name);
+  return v != nullptr && v[0] == '0';
+}
+
+bool UiAtlasGatePermits() {
+  if (EnvIsZero("SIM_FX_BDSP_MODELS")) return false;
+  if (SIM_Headless_Enabled()) {
+    return EnvIsOne("SIM_FX_BDSP_MODELS");
+  }
+  return true;
+}
+
+bool FileExists(const std::string &path) {
+  return !path.empty() && ::access(path.c_str(), R_OK) == 0;
+}
+
+std::string JoinPath(const std::string &a, const std::string &b) {
+  if (a.empty()) return b;
+  if (a.back() == '/') return a + b;
+  return a + "/" + b;
+}
+
+std::string ExpandLeadingTilde(const char *raw) {
+  if (!raw || raw[0] == '\0') return "";
+  std::string s(raw);
+  if (s[0] == '~' && (s.size() == 1 || s[1] == '/')) {
+    const char *home = std::getenv("HOME");
+    if (home && home[0] != '\0') {
+      return std::string(home) + s.substr(1);
+    }
+  }
+  return s;
+}
+
+std::string ResolveUiDir() {
+  const char *envDir = std::getenv("SIM_BDSP_ASSETS_DIR");
+  const char *writableDir = SIM_Platform_WritableDir();
+  const char *dataDir = SIM_Platform_DataDir();
+  std::string candidates[3] = {
+      ExpandLeadingTilde(envDir),
+      (writableDir && writableDir[0] != '\0') ? JoinPath(writableDir, "bdsp_assets") : std::string(),
+      (dataDir && dataDir[0] != '\0') ? JoinPath(dataDir, "bdsp_assets") : std::string(),
+  };
+  for (const auto &root : candidates) {
+    if (root.empty()) continue;
+    std::string uiDir = JoinPath(root, "ui");
+    if (FileExists(JoinPath(uiDir, "manifest.json"))) {
+      return uiDir;
+    }
+  }
+  return "";
+}
+
+bool ReadFileToString(const std::string &path, std::size_t maxBytes, std::string &out) {
+  FILE *f = std::fopen(path.c_str(), "rb");
+  if (!f) return false;
+  if (std::fseek(f, 0, SEEK_END) != 0) {
+    std::fclose(f);
+    return false;
+  }
+  long sz = std::ftell(f);
+  if (sz <= 0 || static_cast<std::size_t>(sz) > maxBytes) {
+    std::fclose(f);
+    return false;
+  }
+  std::fseek(f, 0, SEEK_SET);
+  out.resize(static_cast<std::size_t>(sz));
+  std::size_t n = std::fread(out.data(), 1, out.size(), f);
+  std::fclose(f);
+  return n == out.size();
+}
+
+// Minimal recursive-descent JSON reader tailored for manifest.json.
+class JsonCursor {
+ public:
+  explicit JsonCursor(const std::string &src) : s(src), pos(0) {}
+
+  void SkipWs() {
+    while (pos < s.size() && std::isspace(static_cast<unsigned char>(s[pos]))) ++pos;
+  }
+
+  bool Consume(char ch) {
+    SkipWs();
+    if (pos < s.size() && s[pos] == ch) {
+      ++pos;
+      return true;
+    }
+    return false;
+  }
+
+  char Peek() {
+    SkipWs();
+    return pos < s.size() ? s[pos] : '\0';
+  }
+
+  bool ParseString(std::string &out) {
+    SkipWs();
+    if (pos >= s.size() || s[pos] != '"') return false;
+    ++pos;
+    out.clear();
+    while (pos < s.size()) {
+      char c = s[pos++];
+      if (c == '"') return true;
+      if (c == '\\' && pos < s.size()) {
+        char esc = s[pos++];
+        switch (esc) {
+          case '"': out.push_back('"'); break;
+          case '\\': out.push_back('\\'); break;
+          case '/': out.push_back('/'); break;
+          case 'n': out.push_back('\n'); break;
+          case 'r': out.push_back('\r'); break;
+          case 't': out.push_back('\t'); break;
+          default: out.push_back(esc); break;
+        }
+      } else {
+        out.push_back(c);
+      }
+    }
+    return false;
+  }
+
+  bool ParseNumber(double &out) {
+    SkipWs();
+    if (pos >= s.size()) return false;
+    const char *start = s.c_str() + pos;
+    char *end = nullptr;
+    out = std::strtod(start, &end);
+    if (end == start) return false;
+    pos = static_cast<std::size_t>(end - s.c_str());
+    return true;
+  }
+
+  bool SkipValue() {
+    char c = Peek();
+    if (c == '"') {
+      std::string dummy;
+      return ParseString(dummy);
+    }
+    if (c == '{') {
+      ++pos;
+      if (Consume('}')) return true;
+      while (true) {
+        std::string k;
+        if (!ParseString(k) || !Consume(':') || !SkipValue()) return false;
+        if (Consume('}')) return true;
+        if (!Consume(',')) return false;
+      }
+    }
+    if (c == '[') {
+      ++pos;
+      if (Consume(']')) return true;
+      while (true) {
+        if (!SkipValue()) return false;
+        if (Consume(']')) return true;
+        if (!Consume(',')) return false;
+      }
+    }
+    if (c == '-' || std::isdigit(static_cast<unsigned char>(c))) {
+      double d = 0.0;
+      return ParseNumber(d);
+    }
+    if (s.compare(pos, 4, "true") == 0) { pos += 4; return true; }
+    if (s.compare(pos, 5, "false") == 0) { pos += 5; return true; }
+    if (s.compare(pos, 4, "null") == 0) { pos += 4; return true; }
+    return false;
+  }
+
+ private:
+  const std::string &s;
+  std::size_t pos;
+};
+
+bool ParseSpriteEntry(JsonCursor &cur, HudUiSprite &sp) {
+  if (!cur.Consume('{')) return false;
+  if (cur.Consume('}')) return true;
+  while (true) {
+    std::string field;
+    if (!cur.ParseString(field) || !cur.Consume(':')) return false;
+    if (field == "x" || field == "y" || field == "w" || field == "h") {
+      double v = 0.0;
+      if (!cur.ParseNumber(v)) return false;
+      if (field == "x") sp.x = static_cast<float>(v);
+      else if (field == "y") sp.y = static_cast<float>(v);
+      else if (field == "w") sp.w = static_cast<float>(v);
+      else if (field == "h") sp.h = static_cast<float>(v);
+    } else if (field == "border") {
+      if (!cur.Consume('[')) return false;
+      double b[4] = {0, 0, 0, 0};
+      for (int i = 0; i < 4; ++i) {
+        if (!cur.ParseNumber(b[i])) return false;
+        if (i < 3 && !cur.Consume(',')) return false;
+      }
+      if (!cur.Consume(']')) return false;
+      sp.bl = static_cast<float>(b[0]);
+      sp.bt = static_cast<float>(b[1]);
+      sp.br = static_cast<float>(b[2]);
+      sp.bb = static_cast<float>(b[3]);
+    } else {
+      if (!cur.SkipValue()) return false;
+    }
+    if (cur.Consume('}')) return true;
+    if (!cur.Consume(',')) return false;
+  }
+}
+
+bool ParseManifest(const std::string &jsonText, std::string &atlasFile,
+                   std::unordered_map<std::string, HudUiSprite> &outSprites) {
+  JsonCursor cur(jsonText);
+  if (!cur.Consume('{')) return false;
+  if (cur.Consume('}')) return false;
+  atlasFile = "atlas.png";
+  while (true) {
+    std::string key;
+    if (!cur.ParseString(key) || !cur.Consume(':')) return false;
+    if (key == "atlas") {
+      if (!cur.ParseString(atlasFile)) return false;
+    } else if (key == "sprites") {
+      if (!cur.Consume('{')) return false;
+      if (!cur.Consume('}')) {
+        while (true) {
+          std::string spKey;
+          HudUiSprite sp{};
+          if (!cur.ParseString(spKey) || !cur.Consume(':') || !ParseSpriteEntry(cur, sp)) {
+            return false;
+          }
+          if (sp.w > 0.0f && sp.h > 0.0f) {
+            sp.valid = true;
+            outSprites[spKey] = sp;
+          }
+          if (cur.Consume('}')) break;
+          if (!cur.Consume(',')) return false;
+        }
+      }
+    } else {
+      if (!cur.SkipValue()) return false;
+    }
+    if (cur.Consume('}')) return !outSprites.empty();
+    if (!cur.Consume(',')) return false;
+  }
+}
+
+} // namespace
+
+HudUiAtlas::~HudUiAtlas() { Release(); }
+
+void HudUiAtlas::Release() {
+  if (mReady) {
+    mTexture.Release();
+    mReady = false;
+  }
+  mProbed = false;
+  mWidth = 0;
+  mHeight = 0;
+  mSprites.clear();
+  btnFight = btnPokemon = btnBag = btnRun = btnCancel = nullptr;
+  btnPlainRed = btnPlainGreen = btnPlainGold = btnPlainBlue = btnQuickBall = nullptr;
+  cursorFrame = cursorEff = cardPlayer = cardEnemy = partyStrip = nullptr;
+  hpBarFrame = hpFillGreen = hpFillYellow = hpFillRed = expBg = expFill = nullptr;
+  ballOk = ballStatus = ballFainted = ballEmpty = ballHdOk = caughtIcon = nullptr;
+  genderM = genderF = keyA = keyB = keyX = keyY = keyPillX = keyPillY = nullptr;
+  catPhys = catSpec = catStatus = effSuper = effNormal = effNotVery = effNone = nullptr;
+  statusPar = statusSlp = statusFrz = statusBrn = statusPsn = statusTox = statusFnt = nullptr;
+  infoMoveBg = infoStatusBg = infoSubBg = nullptr;
+  for (auto &p : moveCard) p = nullptr;
+  for (auto &p : typeBadge) p = nullptr;
+}
+
+const HudUiSprite *HudUiAtlas::Find(const char *key) const {
+  if (!key) return nullptr;
+  auto it = mSprites.find(key);
+  return (it != mSprites.end() && it->second.valid) ? &it->second : nullptr;
+}
+
+void HudUiAtlas::CacheWellKnown() {
+  btnFight = Find("btn_fight");
+  btnPokemon = Find("btn_pokemon");
