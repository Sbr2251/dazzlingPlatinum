+    sTpPrevFF = ff; sFastForward = ff;
+    SIM::Render::Get().SetSwapInterval(ff ? 0 : EffectiveSwapInterval());
+  }
+  if (SIM::Touchpad::TakePauseToggle()) SIM::GUI::SetGameLogicPaused(!SIM::GUI::IsGameLogicPaused());
+  if (SIM::Touchpad::TakePanelToggle() && WideActive() && !WideSideBySideMenu())
+    SIM_Layout_SetPanelOpen(!SIM_Layout_IsPanelOpen());
