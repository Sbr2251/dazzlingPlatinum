+// ---- hiresui: 2D upscale mode (config Upscale2D / env SIM_2D_UPSCALE) ----
+// Effective mode: env wins; headless/lockstep runs default to nearest so
+// regression screenshots stay byte-identical unless explicitly opted in;
+// otherwise the config value (default nearest; Sharp/Bilinear opt-in). 3D is never touched:
+// it keeps its native internal-resolution texture and sampling.
+static int HiRes_UpscaleEnvMode() {
+  static int cached = -2;
+  if (cached != -2) return cached;
+  const char *e = getenv("SIM_2D_UPSCALE");
+  cached = -1;
+  if (e && e[0]) {
+    if (!strcmp(e, "0") || !strcmp(e, "Nearest") || !strcmp(e, "nearest")) cached = 0;
+    else if (!strcmp(e, "2") || !strcmp(e, "Bilinear") || !strcmp(e, "bilinear")) cached = 2;
+    else cached = 1;
+  }
+  return cached;
+}
+static int HiRes_EffectiveUpscale2D() {
+  int env = HiRes_UpscaleEnvMode();
+  if (env >= 0) return env;
+  if (SIM_Headless_Enabled()) return 0;
+  int m = s_SIM_config.upscale2D;
+  return (m >= 0 && m <= 2) ? m : 0;
+}
