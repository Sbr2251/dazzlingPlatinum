+    uint v = imageLoad(uTex, ivec2(vUv * vec2(4.0, 4.0))).r;
+    o = vec4(float(v) / 15000.0, 0.0, 0.0, 1.0);
+}
diff --git a/libraries/sim/src/gpu/shaders/test_invariant.vert b/libraries/sim/src/gpu/shaders/test_invariant.vert
new file mode 100644
index 0000000..fec58d2
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/test_invariant.vert
