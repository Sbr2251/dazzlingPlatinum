diff --git a/include/simulator/sim_helpers.hpp b/include/simulator/sim_helpers.hpp
new file mode 100644
index 0000000..c2b0286
--- /dev/null
+++ b/include/simulator/sim_helpers.hpp
@@ -0,0 +1,26 @@
+#pragma once
+
+// Player helpers for PC builds: a fast-forward badge and short messages drawn over the game, and save import/export
+// (a raw 512 KB .sav, as DeSmuME's "Export Backup Memory" writes, or a DeSmuME .dsv on import).
+
+#include <string>
+
+namespace SIM::Helpers {
+
+// Draws the overlay (fast-forward badge, message). Called once per frame inside the ImGui frame.
+void DrawOverlay();
+
+// Shows a short message at the top of the window.
+void Toast(const std::string & message, double seconds = 3.0);
+
+// Export the current save. With an empty path a save dialog asks where (macOS).
+void ExportSave(const std::string & path = "");
+
+// Import a save (.sav raw or DeSmuME .dsv), keeping a backup of the current one, then restart the game so it loads.
+// With an empty path a file dialog asks which, and the player confirms (macOS). A given path is imported without asking.
+void ImportSave(const std::string & path = "");
+
+// Called by the main loop each frame: restarts the game after an import.
+void Poll();
+
+}  // namespace SIM::Helpers
