diff --git a/libraries/sim/src/render_gl/render_gl_g2gpu.cpp b/libraries/sim/src/render_gl/render_gl_g2gpu.cpp
new file mode 100644
index 0000000..2fbbeda
--- /dev/null
+++ b/libraries/sim/src/render_gl/render_gl_g2gpu.cpp
@@ -0,0 +1,289 @@
+// GPU 2D layer passes, GL implementation (from sim_g2_gpu.cpp).
+//
+// Renders each BG layer, each OBJ priority layer and the OBJ window mask
+// directly from VRAM / palette / OAM data into the layer textures the
+// g2_fragment.glsl compositing samples. The caller (sim_g2_gpu.cpp)
+// fills G2GpuData from the DS registers; this file only turns it into
+// GL draws. Integer data travels as R8UI/R16UI textures here; the SDL
+// GPU backend will pack the same G2GpuData into storage buffers instead
+// (SDL GPU forbids SAMPLER usage on integer formats).
+#include "render_gl_internal.hpp"
+
+#include <simulator/sim.h>
+
+#include <cstdio>
+#include <cstring>
+
+namespace SIM::Render::detail {
+namespace {
+
+const char *kVertSrc =
+#include "../shaders/g2gpu_vertex.glsl"
+;
+const char *kFragSrc =
+#include "../shaders/g2gpu_fragment.glsl"
+;
+
+GLuint sProg = 0, sFbo = 0, sVao = 0, sDepthRb = 0;
+GLuint sBgVramTex[2] = {0, 0}, sObjVramTex[2] = {0, 0}, sLcdcTex = 0,
+       sOamTex = 0, sPalTex = 0;
+int sInitFailed = 0;
+
+GLuint Compile(GLenum type, const char *src) {
+  char *tmp = nullptr;
+  const char *use = src;
+#ifdef SDK_BUILD_MACOS
+  if (strncmp(src, "\n#version 420", 13) == 0 ||
+      strncmp(src, "#version 420", 12) == 0) {
+    tmp = strdup(src);
+    char *p = strstr(tmp, "#version 420");
+    if (p) memcpy(p, "#version 410", 12);
+    use = tmp;
+  }
+#endif
+  GLuint s = glCreateShader(type);
+  glShaderSource(s, 1, &use, nullptr);
+  glCompileShader(s);
+  GLint ok = 0;
+  glGetShaderiv(s, GL_COMPILE_STATUS, &ok);
+  if (!ok) {
+    GLint len = 0;
+    glGetShaderiv(s, GL_INFO_LOG_LENGTH, &len);
+    char *log = new char[len + 1]();
+    glGetShaderInfoLog(s, len, nullptr, log);
+    printf("SIM_G2_GPU: shader compile failed: %s\n", log);
+    delete[] log;
+  }
+  if (tmp) free(tmp);
+  return ok ? s : 0;
+}
+
+bool Init() {
+  if (sProg || sInitFailed) return sProg != 0;
+  GLuint vs = Compile(GL_VERTEX_SHADER, kVertSrc);
+  GLuint fs = Compile(GL_FRAGMENT_SHADER, kFragSrc);
+  if (!vs || !fs) {
+    sInitFailed = 1;
+    return false;
+  }
+  sProg = glCreateProgram();
+  glAttachShader(sProg, vs);
+  glAttachShader(sProg, fs);
+  glLinkProgram(sProg);
+  GLint ok = 0;
+  glGetProgramiv(sProg, GL_LINK_STATUS, &ok);
+  if (!ok) {
+    GLint len = 0;
+    glGetProgramiv(sProg, GL_INFO_LOG_LENGTH, &len);
+    char *log = new char[len + 1]();
+    glGetProgramInfoLog(sProg, len, nullptr, log);
+    printf("SIM_G2_GPU: link failed: %s\n", log);
+    delete[] log;
+    sInitFailed = 1;
+    return false;
+  }
+  glGenFramebuffers(1, &sFbo);
+  glGenVertexArrays(1, &sVao);
+  glBindFramebuffer(GL_FRAMEBUFFER, sFbo);
+  glGenRenderbuffers(1, &sDepthRb);
+  glBindRenderbuffer(GL_RENDERBUFFER, sDepthRb);
+  glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24,
+                        SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT * 2);
+  glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
+                            GL_RENDERBUFFER, sDepthRb);
+  glBindFramebuffer(GL_FRAMEBUFFER, 0);
+  auto mkTex = [](GLuint &t, GLenum internal, int w, int h, GLenum fmt) {
+    glGenTextures(1, &t);
+    glBindTexture(GL_TEXTURE_2D, t);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    glTexImage2D(GL_TEXTURE_2D, 0, internal, w, h, 0, fmt, GL_UNSIGNED_BYTE,
+                 nullptr);
+  };
+  mkTex(sBgVramTex[0], GL_R8UI, 2048, 256, GL_RED_INTEGER);
+  mkTex(sBgVramTex[1], GL_R8UI, 2048, 256, GL_RED_INTEGER);
+  mkTex(sObjVramTex[0], GL_R8UI, 1024, 256, GL_RED_INTEGER);
+  mkTex(sObjVramTex[1], GL_R8UI, 1024, 256, GL_RED_INTEGER);
+  mkTex(sLcdcTex, GL_R8UI, 2048, 328, GL_RED_INTEGER);
+  glGenTextures(1, &sOamTex);
+  glBindTexture(GL_TEXTURE_2D, sOamTex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_R16UI, 512, 2, 0, GL_RED_INTEGER,
+               GL_UNSIGNED_SHORT, nullptr);
+  glGenTextures(1, &sPalTex);
+  glBindTexture(GL_TEXTURE_2D, sPalTex);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+  glTexImage2D(GL_TEXTURE_2D, 0, GL_R16UI, 256, 4, 0, GL_RED_INTEGER,
+               GL_UNSIGNED_SHORT, nullptr);
+  glUseProgram(sProg);
+  glUniform1i(glGetUniformLocation(sProg, "bgVramTex"), 10);
+  glUniform1i(glGetUniformLocation(sProg, "objVramTex"), 11);
+  glUniform1i(glGetUniformLocation(sProg, "lcdcTex"), 12);
+  glUniform1i(glGetUniformLocation(sProg, "oamTex"), 13);
+  glUniform1i(glGetUniformLocation(sProg, "palTex"), 14);
+  printf("SIM_G2_GPU: GPU 2D layer renderer enabled\n");
+  return true;
+}
+
+} // namespace
+
+bool G2GpuRenderGl(const G2GpuData &data, GLuint bgTexIds[4],
+                   GLuint objTexIds[5], GLuint objWindowTexId) {
+  if (!Init()) return false;
+  const int isSub = data.isSub;
+  GLint prevActiveTex = 0;
+  glGetIntegerv(GL_ACTIVE_TEXTURE, &prevActiveTex);
+  GLuint savedBind[5] = {0, 0, 0, 0, 0};
+  for (int i = 0; i < 5; i++) {
+    glActiveTexture(GL_TEXTURE10 + i);
+    GLint b = 0;
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &b);
+    savedBind[i] = (GLuint)b;
+  }
+  // Upload data textures for this engine. A shadow copy is kept per
+  // buffer and the upload is skipped when nothing changed (most screens
+  // reuse VRAM for many frames); the LCDC extended palettes are only
+  // uploaded when this engine has extended palettes enabled.
+  static u8 sShadowBg[2][0x80000], sShadowObj[2][0x40000],
+      sShadowLcdc[0xA4000];
+  static bool sShadowBgValid[2] = {false, false},
+              sShadowObjValid[2] = {false, false},
+              sShadowLcdcValid = false;
+  auto uploadIfChanged = [](GLuint tex, int unit, int w, int h,
+                            const void *srcData, size_t size, u8 *shadow,
+                            bool *valid) {
+    glActiveTexture(GL_TEXTURE0 + unit);
+    glBindTexture(GL_TEXTURE_2D, tex);
+    if (*valid && memcmp(shadow, srcData, size) == 0) return;
+    memcpy(shadow, srcData, size);
+    *valid = true;
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h, GL_RED_INTEGER,
+                    GL_UNSIGNED_BYTE, srcData);
+  };
+  if (data.bgVram && data.bgVramSize)
+    uploadIfChanged(sBgVramTex[isSub], 10, 2048,
+                    (int)(data.bgVramSize / 2048), data.bgVram,
+                    data.bgVramSize, sShadowBg[isSub],
+                    &sShadowBgValid[isSub]);
+  if (data.objVram && data.objVramSize)
+    uploadIfChanged(sObjVramTex[isSub], 11, 1024,
+                    (int)(data.objVramSize / 1024), data.objVram,
+                    data.objVramSize, sShadowObj[isSub],
+                    &sShadowObjValid[isSub]);
+  if (data.lcdc && data.dispcnt & 0x40000000)
+    uploadIfChanged(sLcdcTex, 12, 2048, 328, data.lcdc, data.lcdcSize,
+                    sShadowLcdc, &sShadowLcdcValid);
+  if (data.oam) {
+    glActiveTexture(GL_TEXTURE13);
+    glBindTexture(GL_TEXTURE_2D, sOamTex);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, isSub ? 1 : 0, 512, 1, GL_RED_INTEGER,
+                    GL_UNSIGNED_SHORT, data.oam);
+  }
+  glActiveTexture(GL_TEXTURE14);
+  glBindTexture(GL_TEXTURE_2D, sPalTex);
+  for (int r = 0; r < 4; r++) {
+    if (data.palettes[r])
+      glTexSubImage2D(GL_TEXTURE_2D, 0, 0, r, 256, 1, GL_RED_INTEGER,
+                      GL_UNSIGNED_SHORT, data.palettes[r]);
+  }
+  GLint prevProg = 0;
+  glGetIntegerv(GL_CURRENT_PROGRAM, &prevProg);
+  GLint prevViewport[4] = {0};
+  glGetIntegerv(GL_VIEWPORT, prevViewport);
+  GLint prevFbo = 0;
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &prevFbo);
+  glUseProgram(sProg);
+  glBindVertexArray(sVao);
+  glBindFramebuffer(GL_FRAMEBUFFER, sFbo);
+  glViewport(0, 0, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT * 2);
+  glDisable(GL_BLEND);
+  glDisable(GL_DEPTH_TEST);
+  glUniform1i(glGetUniformLocation(sProg, "isSub"), data.isSub);
+  glUniform1i(glGetUniformLocation(sProg, "topScreen"), data.topScreen);
+  glUniform1i(glGetUniformLocation(sProg, "dispcnt"), data.dispcnt);
+  glUniform1i(glGetUniformLocation(sProg, "bgMode"), data.bgMode);
+  glUniform1i(glGetUniformLocation(sProg, "extPlttBase"), data.extPlttBase);
+  glUniform1i(glGetUniformLocation(sProg, "objExtPlttBase"),
+              data.objExtPlttBase);
+  glUniform1iv(glGetUniformLocation(sProg, "bgcnt"), 4, data.bgcnt);
+  glUniform1iv(glGetUniformLocation(sProg, "bgofs"), 4, data.bgofs);
+  glUniform1iv(glGetUniformLocation(sProg, "affA"), 4, data.affA);
+  glUniform1iv(glGetUniformLocation(sProg, "affB"), 4, data.affB);
+  glUniform1iv(glGetUniformLocation(sProg, "affC"), 4, data.affC);
+  glUniform1iv(glGetUniformLocation(sProg, "affD"), 4, data.affD);
+  glUniform1iv(glGetUniformLocation(sProg, "affX"), 4, data.affX);
+  glUniform1iv(glGetUniformLocation(sProg, "affY"), 4, data.affY);
+  glUniform1i(glGetUniformLocation(sProg, "win0h"), data.win0h);
+  glUniform1i(glGetUniformLocation(sProg, "win0v"), data.win0v);
+  glUniform1i(glGetUniformLocation(sProg, "win1h"), data.win1h);
+  glUniform1i(glGetUniformLocation(sProg, "win1v"), data.win1v);
+  glUniform1i(glGetUniformLocation(sProg, "mosaic"), data.mosaic);
+  glUniform1i(glGetUniformLocation(sProg, "winin"), data.winin);
+  glUniform1i(glGetUniformLocation(sProg, "winout"), data.winout);
+  int halfY = data.topScreen ? SIM_NDS_SCREEN_HEIGHT : 0;
+  auto drawPass = [&](GLuint target, int mode, int layer, int dbg) {
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_2D, target, 0);
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(0, halfY, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT);
+    glClearColor(0, 0, 0, 0);
+    glClear(GL_COLOR_BUFFER_BIT);
+    glDisable(GL_SCISSOR_TEST);
+    glUniform1i(glGetUniformLocation(sProg, "passMode"), mode);
+    glUniform1i(glGetUniformLocation(sProg, "layer"), layer);
+    glUniform1i(glGetUniformLocation(sProg, "dbgEnable"), dbg);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+  };
+  for (int i = 0; i < 4; i++) drawPass(bgTexIds[i], 0, i, data.bgRender[i]);
+  auto drawObjPass = [&](GLuint target, int mode, int layer, int listIdx) {
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                           GL_TEXTURE_2D, target, 0);
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(0, halfY, SIM_NDS_SCREEN_WIDTH, SIM_NDS_SCREEN_HEIGHT);
+    glClearColor(0, 0, 0, 0);
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+    glDisable(GL_SCISSOR_TEST);
+    if (!data.objEnabled || data.spriteCount[listIdx] == 0)
+      return; // cleared only
+    glEnable(GL_DEPTH_TEST);
+    glDepthFunc(GL_LEQUAL);
+    glDepthMask(GL_TRUE);
+    glUniform1i(glGetUniformLocation(sProg, "singleMode"), 1);
+    glUniform1i(glGetUniformLocation(sProg, "passMode"), mode);
+    glUniform1i(glGetUniformLocation(sProg, "layer"), layer);
+    glUniform1i(glGetUniformLocation(sProg, "dbgEnable"), 1);
+    for (int si = 0; si < data.spriteCount[listIdx]; si++) {
+      const G2GpuSprite &sp = data.sprites[listIdx][si];
+      GLint one[1] = {sp.oamIndex};
+      glUniform1iv(glGetUniformLocation(sProg, "objList"), 1, one);
+      glUniform1i(glGetUniformLocation(sProg, "objCount"), 1);
+      glUniform1f(glGetUniformLocation(sProg, "uDepth"), sp.depth);
+      glEnable(GL_SCISSOR_TEST);
+      glScissor(sp.scissorX, sp.scissorY, sp.scissorW, sp.scissorH);
+      glDrawArrays(GL_TRIANGLES, 0, 3);
+      glDisable(GL_SCISSOR_TEST);
+    }
+    glDisable(GL_DEPTH_TEST);
+    glUniform1i(glGetUniformLocation(sProg, "singleMode"), 0);
+    glUniform1f(glGetUniformLocation(sProg, "uDepth"), 0.0f);
+  };
+  for (int p = 0; p < 4; p++) drawObjPass(objTexIds[p], 1, p, p);
+  drawObjPass(objWindowTexId, 2, 0, 4);
+  glBindFramebuffer(GL_FRAMEBUFFER, (GLuint)prevFbo);
+  glViewport(prevViewport[0], prevViewport[1], prevViewport[2],
+             prevViewport[3]);
+  for (int i = 0; i < 5; i++) {
+    glActiveTexture(GL_TEXTURE10 + i);
+    glBindTexture(GL_TEXTURE_2D, savedBind[i]);
+  }
+  glActiveTexture(prevActiveTex);
+  glEnable(GL_BLEND);
+  glUseProgram(prevProg);
+  return true;
+}
+
+} // namespace SIM::Render::detail
