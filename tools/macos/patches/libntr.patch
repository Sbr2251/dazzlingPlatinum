+// Player helpers for PC builds: a fast-forward badge and short messages drawn over the game, and save import/export.
+//
+// Saves: the game reads and writes save.bin in its working directory, a raw image of the DS cartridge's 512 KB flash, so it is
+// the same format as the .sav DeSmuME (File > Export Backup Memory), melonDS and real-cartridge dumpers use. Import also takes a
+// DeSmuME .dsv (a raw image followed by a 122-byte footer). Before an import the current save is copied to save-backups/.
+
+#include "simulator/sim.h"
+#include "simulator/sim_helpers.hpp"
+#include "simulator/sim_gui.hpp"
+#include "simulator/sim_platform.h" // ios-platform hook
+#include <dirent.h> // ios-platform hook
+
+#include "simulator/imgui/imgui.hpp"
+
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <limits.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#ifdef __APPLE__
+#include <TargetConditionals.h> // ios-platform hook
+#include <crt_externs.h>
+#include <mach-o/dyld.h>
+#endif
+
+namespace SIM::Helpers {
+
+#include "simulator/sim_headless.h"
+// SIM_SAVE_PATH (SIM_GetSaveBinPath) redirects the save; backups go in save-backups/ next to it.
+static const char * kSaveFileFallback = "save.bin";
+static std::string SaveFile() { return SIM_GetSaveBinPath(); }
+static std::string BackupDir() {
+    std::string p = SaveFile();
+    size_t slash = p.find_last_of('/');
+    return (slash == std::string::npos ? std::string("save-backups") : p.substr(0, slash) + "/save-backups");
+}
+static const size_t kFlashSize = 512 * 1024;
+static const unsigned kSectorSignature = 0x20060623;   // Gen 4 save block footer signature
+static const char kDsvCookie[] = "|-DESMUME SAVE-|";
+static const size_t kDsvFooterSize = 122;
+
+static std::mutex sToastLock;
+static std::string sToastText;
+static double sToastUntil = 0;
+static std::atomic<bool> sBusy{false};      // a dialog or file operation is running
+static std::atomic<bool> sRestart{false};   // restart after an import
+
+static double Now() {
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return (double)t.tv_sec + (double)t.tv_nsec / 1e9;
+}
+
+void Toast(const std::string & message, double seconds) {
+    std::lock_guard<std::mutex> lock(sToastLock);
+    sToastText = message;
+    sToastUntil = Now() + seconds;
+    printf("SIM helpers: %s\n", message.c_str());
+    fflush(stdout);
+}
+
+// ---------------------------------------------------------------------------------------------------------------- overlay
+
+void DrawOverlay() {
+    ImDrawList * dl = ImGui::GetForegroundDrawList();
+    ImVec2 display = ImGui::GetIO().DisplaySize;
+    float scale = display.x / 512.0f;
+    if (scale < 1.0f) scale = 1.0f;
+    ImFont * font = ImGui::GetFont();
+    float fontSize = 13.0f * scale;
+
+    double speed = 0;
+    int ff = SIM_GetFastForward(&speed);
+    if (SIM::GUI::IsGameLogicPaused()) {
+        // Pause badge in the top-right corner: two bars and PAUSED
+        const char * label = "PAUSED";
+        ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, 0.0f, label);
+        float h = 20.0f * scale, pad = 6.0f * scale, bar = 3.0f * scale, barH = 10.0f * scale;
+        float w = pad + bar * 3 + 4.0f * scale + textSize.x + pad;
+        ImVec2 p1(display.x - w - 6.0f * scale, 6.0f * scale);
+        ImVec2 p2(p1.x + w, p1.y + h);
+        dl->AddRectFilled(p1, p2, IM_COL32(0, 0, 0, 150), h / 2);
+        float cy = p1.y + h / 2, x = p1.x + pad;
+        ImU32 white = IM_COL32(255, 255, 255, 235);
+        dl->AddRectFilled(ImVec2(x, cy - barH / 2), ImVec2(x + bar, cy + barH / 2), white);
+        dl->AddRectFilled(ImVec2(x + bar * 2, cy - barH / 2), ImVec2(x + bar * 3, cy + barH / 2), white);
+        dl->AddText(font, fontSize, ImVec2(x + bar * 3 + 4.0f * scale, cy - textSize.y / 2), white, label);
+    } else if (ff != 0) {
+        // Badge in the top-right corner: two triangles and the speed
+        char label[16];
+        if (ff == 2) snprintf(label, sizeof label, "MAX");
+        else if (speed == (int)speed) snprintf(label, sizeof label, "%dx", (int)speed);
+        else snprintf(label, sizeof label, "%.1fx", speed);
+        ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, 0.0f, label);
+        float h = 20.0f * scale, pad = 6.0f * scale, tri = 7.0f * scale;
+        float w = pad + tri * 2 + 4.0f * scale + textSize.x + pad;
+        ImVec2 p1(display.x - w - 6.0f * scale, 6.0f * scale);
+        ImVec2 p2(p1.x + w, p1.y + h);
+        dl->AddRectFilled(p1, p2, IM_COL32(0, 0, 0, 150), h / 2);
+        float cy = p1.y + h / 2, x = p1.x + pad;
+        ImU32 white = IM_COL32(255, 255, 255, 235);
+        dl->AddTriangleFilled(ImVec2(x, cy - tri * 0.75f), ImVec2(x + tri, cy), ImVec2(x, cy + tri * 0.75f), white);
+        dl->AddTriangleFilled(ImVec2(x + tri, cy - tri * 0.75f), ImVec2(x + tri * 2, cy), ImVec2(x + tri, cy + tri * 0.75f), white);
+        dl->AddText(font, fontSize, ImVec2(x + tri * 2 + 4.0f * scale, cy - textSize.y / 2), white, label);
+    }
+
+    std::string toast;
+    {
+        std::lock_guard<std::mutex> lock(sToastLock);
+        if (Now() < sToastUntil) toast = sToastText;
+    }
+    if (!toast.empty()) {
+        float maxWidth = display.x - 40.0f * scale;
+        ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, maxWidth, toast.c_str());
+        float pad = 8.0f * scale;
+        ImVec2 p1((display.x - textSize.x) / 2 - pad, 32.0f * scale);
+        ImVec2 p2(p1.x + textSize.x + pad * 2, p1.y + textSize.y + pad * 2);
+        dl->AddRectFilled(p1, p2, IM_COL32(0, 0, 0, 190), 6.0f * scale);
+        dl->AddText(font, fontSize, ImVec2(p1.x + pad, p1.y + pad), IM_COL32(255, 255, 255, 255), toast.c_str(), nullptr, maxWidth);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------------------------- files
+
+static bool ReadFile(const std::string & path, std::vector<unsigned char> & out, size_t maxSize) {
+    FILE * f = fopen(path.c_str(), "rb");
+    if (!f) return false;
+    out.clear();
+    unsigned char buf[65536];
+    size_t n;
+    while ((n = fread(buf, 1, sizeof buf, f)) > 0) {
+        out.insert(out.end(), buf, buf + n);
+        if (out.size() > maxSize) { fclose(f); return false; }
+    }
+    fclose(f);
+    return true;
+}
+
+// Write via a temporary file and rename, so a failed write never leaves half a file
+static bool WriteFile(const std::string & path, const std::vector<unsigned char> & data) {
+    std::string tmp = path + ".tmp";
+    FILE * f = fopen(tmp.c_str(), "wb");
+    if (!f) return false;
+    bool ok = fwrite(data.data(), 1, data.size(), f) == data.size();
+    ok = (fclose(f) == 0) && ok;
+    if (!ok || rename(tmp.c_str(), path.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    return true;
+}
+
+static std::string BaseName(const std::string & path) {
+    size_t slash = path.find_last_of('/');
+    return slash == std::string::npos ? path : path.substr(slash + 1);
+}
+
+static std::string Timestamp() {
+    time_t t = time(nullptr);
+    struct tm tmv;
+    localtime_r(&t, &tmv);
+    char buf[32];
+    strftime(buf, sizeof buf, "%Y%m%d-%H%M%S", &tmv);
+    return buf;
+}
+
+static unsigned Read32(const unsigned char * p) { return p[0] | (p[1] << 8) | (p[2] << 16) | ((unsigned)p[3] << 24); }
+
+// A Platinum save has a block footer signature at 0xCF24 in its primary (0x00000) or backup (0x40000) half. 0xCF38 is the
+// layout of saves from older versions of this port, which the game upgrades when it loads them.
+static bool LooksLikePlatinumSave(const std::vector<unsigned char> & d) {
+    const size_t offsets[] = {0xCF24, 0x40000 + 0xCF24, 0xCF38, 0x40000 + 0xCF38};
+    for (size_t off : offsets)
+        if (off + 4 <= d.size() && Read32(&d[off]) == kSectorSignature) return true;
+    return false;
+}
+
+// ---------------------------------------------------------------------------------------------------------------- dialogs
+
+#if defined(__APPLE__) && defined(TARGET_OS_OSX) && TARGET_OS_OSX
+static std::string AppleScriptString(const std::string & s) {
+    std::string out = "\"";
+    for (char c : s) {
+        if (c == '"' || c == '\\') out += '\\';
+        out += c;
+    }
+    return out + "\"";
+}
+
+// Runs an AppleScript with osascript; false when it fails or the player cancels
+static bool RunAppleScript(const std::string & script, std::string * result) {
+    char tmpl[] = "/tmp/pokeplatinum-dialog-XXXXXX";
+    int fd = mkstemp(tmpl);
+    if (fd < 0) return false;
+    bool wrote = write(fd, script.data(), script.size()) == (ssize_t)script.size();
+    close(fd);
+    if (!wrote) { unlink(tmpl); return false; }
+    std::string cmd = std::string("/usr/bin/osascript ") + tmpl + " 2>/dev/null";
+    FILE * p = popen(cmd.c_str(), "r");
+    std::string out;
+    if (p) {
+        char buf[1024];
+        size_t n;
+        while ((n = fread(buf, 1, sizeof buf, p)) > 0) out.append(buf, n);
+    }
+    int status = p ? pclose(p) : -1;
+    unlink(tmpl);
+    while (!out.empty() && (out.back() == '\n' || out.back() == '\r')) out.pop_back();
+    if (result) *result = out;
+    return status == 0;
+}
+
+static std::string DefaultFolder(bool forImport) { // macOS only
+    const char * home = getenv("HOME");
+    if (!home) return "/";
+    struct stat st;
+    if (forImport) {
+        // OpenEmu keeps DeSmuME saves here
+        std::string openEmu = std::string(home) + "/Library/Application Support/OpenEmu/DeSmuME/Battery Saves";
+        if (stat(openEmu.c_str(), &st) == 0 && S_ISDIR(st.st_mode)) return openEmu;
+    }
+    std::string docs = std::string(home) + "/Documents";
+    return (stat(docs.c_str(), &st) == 0) ? docs : home;
+}
+#endif
+
+// ---------------------------------------------------------------------------------------------------------------- export
+
+static void DoExport(std::string path) {
+    std::vector<unsigned char> data;
+    if (!ReadFile(SaveFile(), data, 4 * kFlashSize) || data.empty()) {
+        Toast("No save yet: save in the game first");
+        return;
+    }
+    if (data.size() < kFlashSize) data.resize(kFlashSize, 0xFF);   // erased flash reads as 0xFF
+
+    if (path.empty()) {
+#if defined(__APPLE__) && defined(TARGET_OS_OSX) && TARGET_OS_OSX // ios-platform hook
+        std::string script = "activate\nPOSIX path of (choose file name with prompt " + AppleScriptString("Export the save (.sav)") +
+                             " default name " + AppleScriptString("Pokemon Platinum " + Timestamp() + ".sav") +
+                             " default location (POSIX file " + AppleScriptString(DefaultFolder(false)) + "))";
+        if (!RunAppleScript(script, &path) || path.empty()) return;   // cancelled
+#else
+        Toast("Save export needs a path on this platform");
+        return;
+#endif
+    }
+    if (WriteFile(path, data)) Toast("Save exported to " + BaseName(path));
+    else Toast("Could not write " + path + ": " + strerror(errno));
+}
+
+void ExportSave(const std::string & path) {
+    if (sBusy.exchange(true)) return;
+    std::thread([path] { DoExport(path); sBusy = false; }).detach();
+}
+
+// ---------------------------------------------------------------------------------------------------------------- import
+
+static void DoImport(std::string path) {
+    bool interactive = path.empty();
+#if defined(__APPLE__) && defined(TARGET_OS_OSX) && TARGET_OS_OSX // ios-platform hook
+    if (interactive) {
+        std::string script = "activate\nPOSIX path of (choose file with prompt " +
+                             AppleScriptString("Import a save (.sav, or a DeSmuME .dsv)") +
+                             " default location (POSIX file " + AppleScriptString(DefaultFolder(true)) + "))";
+        if (!RunAppleScript(script, &path) || path.empty()) return;   // cancelled
+    }
+#else
+    if (interactive) { Toast("Save import needs a path on this platform"); return; }
+#endif
+
+    std::vector<unsigned char> data;
+    if (!ReadFile(path, data, 4 * kFlashSize)) {
+        Toast("Could not read " + BaseName(path) + " (missing, or larger than a DS save)");
+        return;
+    }
+    // DeSmuME .dsv: the raw image, then a footer ending in its cookie
+    if (data.size() >= kDsvFooterSize && memcmp(&data[data.size() - 16], kDsvCookie, 16) == 0) {
+        size_t raw = data.size() - kDsvFooterSize;
+        size_t used = Read32(&data[raw + 82]);   // the footer's "actual size"
+        data.resize(used > 0 && used <= raw ? used : raw);
+    }
+    if (data.size() > kFlashSize) data.resize(kFlashSize);
+    if (data.size() < kFlashSize) data.resize(kFlashSize, 0xFF);
+    if (!LooksLikePlatinumSave(data)) {
+        bool empty = true;
+        for (unsigned char b : data) if (b != 0 && b != 0xFF) { empty = false; break; }
+        Toast(BaseName(path) + (empty ? " is empty (no game saved in it)" : " is not a Pokemon Platinum save"), 5.0);
+        return;
+    }
+
+#if defined(__APPLE__) && defined(TARGET_OS_OSX) && TARGET_OS_OSX // ios-platform hook
+    if (interactive) {
+        std::string script = "activate\ndisplay dialog " +
+                             AppleScriptString("Replace the current save with " + BaseName(path) +
+                                               "?\n\nThe current save is kept in save-backups. The game restarts to load the imported save; "
+                                               "progress since your last in-game save is lost.") +
+                             " buttons {\"Cancel\", \"Import and Restart\"} default button 2 with icon caution";
+        if (!RunAppleScript(script, nullptr)) return;   // cancelled
+    }
+#endif
+
+    // Keep the current save
+    std::vector<unsigned char> current;
+    bool blank = true;   // the game creates an all-zero save.bin before anything is saved
+    if (ReadFile(SaveFile(), current, 4 * kFlashSize))
+        for (unsigned char b : current) if (b != 0 && b != 0xFF) { blank = false; break; }
+    if (!blank) {
+        mkdir(BackupDir().c_str(), 0755);
+        std::string backup = BackupDir() + "/save-" + Timestamp() + ".sav";
+        if (!WriteFile(backup, current)) {
+            Toast("Could not back up the current save; nothing imported");
+            return;
+        }
+    }
+    if (!WriteFile(SaveFile(), data)) {
+        Toast(std::string("Could not write the save: ") + strerror(errno));
+        return;
+    }
+    Toast("Imported " + BaseName(path) + ", restarting");
+    sRestart = true;
+}
+
+void ImportSave(const std::string & path) {
+    if (sBusy.exchange(true)) return;
+    // Lockstep: import synchronously on the game thread. A detached thread set
+    // sRestart whenever its file I/O happened to finish, so the execv restart
+    // consumed a wall-clock-dependent number of the 30 granted frames and, if
+    // it lost the race, later commands were consumed by the pre-restart
+    // process. Synchronous import restarts at the very next rendered frame.
+    if (SIM_Control_Enabled()) { DoImport(path); sBusy = false; return; }
+    std::thread([path] { DoImport(path); sBusy = false; }).detach();
+}
+
+// ---------------------------------------------------------------------------------------------------------------- restart
+
+void Poll() {
+    if (!sRestart) return;
+    sRestart = false;
+ #if defined(__APPLE__) && defined(TARGET_OS_OSX) && TARGET_OS_OSX // ios-platform hook
+    // Run this executable again with the same arguments, working directory and output
+    char exe[PATH_MAX];
+    uint32_t size = sizeof exe;
+    if (_NSGetExecutablePath(exe, &size) == 0) {
+        char ** argv = *_NSGetArgv();
+        fflush(stdout);
+        execv(exe, argv);
+    }
+#else
+    char exe[PATH_MAX];
+    ssize_t n = readlink("/proc/self/exe", exe, sizeof exe - 1);
+    if (n > 0) {
+        exe[n] = 0;
+        char * argv[] = {exe, nullptr};
+        fflush(stdout);
+        execv(exe, argv);
+    }
+#endif
+    Toast("Imported; quit and reopen the game to load it", 8.0);
+}
+
+// ios-platform hook: iOS Files-app import/export for the controls lane.
+std::string ExportPathForDocuments() {
+    SIM_Platform_EnsureWritableDirs();
+    return std::string(SIM_Platform_WritableDir()) + "/Export/Pokemon Platinum " + Timestamp() + ".sav";
+}
+void ExportSaveToDocuments() { ExportSave(ExportPathForDocuments()); }
+bool ImportSaveFromDocuments() {
+    SIM_Platform_EnsureWritableDirs();
+    std::string dir = std::string(SIM_Platform_WritableDir()) + "/Import";
+    DIR *d = opendir(dir.c_str());
+    if (!d) return false;
+    std::string found;
+    while (auto *e = readdir(d)) {
+        std::string n = e->d_name;
+        if (n.size() > 4 && (n.compare(n.size()-4,4,".sav")==0 || n.compare(n.size()-4,4,".dsv")==0)) { found = dir + "/" + n; break; }
+    }
+    closedir(d);
+    if (found.empty()) return false;
+    ImportSave(found);
+    std::string done = found + ".imported";
+    rename(found.c_str(), done.c_str());
+    return true;
+}
+bool CheckImportOnBoot() {
+    if (!SIM_Platform_IsIOS()) return false;
+    if (ImportSaveFromDocuments()) { Toast("Imported save from Files; reopening load", 5.0); return true; }
+    return false;
+}
+}  // namespace SIM::Helpers
diff --git a/libraries/sim/src/sim_hirestext.cpp b/libraries/sim/src/sim_hirestext.cpp
new file mode 100644
index 0000000..75cdee1
--- /dev/null
+++ b/libraries/sim/src/sim_hirestext.cpp
@@ -0,0 +1,144 @@
+// Hi-res text overlay (lane hiresui, prototype). See sim_hirestext.h.
+//
+// Game code reports dialogue glyphs as it prints them; this file expands
+// them at HIRES_SCALE into a CPU RGBA buffer covering the combined display
+// (256x384 DS pixels), uploads it when dirty and draws it over the
+// composited frame. New file on purpose: nothing here touches the G2 layer
+// renderers or the composite shader, so it merges independently.
+#include <nitro.h>
+#include <simulator/sim.h>
+#include <simulator/sim_render_backend.hpp>
+#include <simulator/simvariables.h>
+#include <simulator/config/sim_config.h>
+#include <stdio.h>
+#include <string.h>
+#include "sim_hirestext.h"
+
+namespace SIM {
+extern const char *PostVertexShader;
+extern const char *HiResTextFragmentShader;
+}
+
+extern "C" void SIM_u16ToRGB(u16 in, u8 *r, u8 *g, u8 *b);
+SIM_config_type *SIM_GetConfigPtr();
+
+static constexpr int kScale = 4;
+static constexpr int kBufW = SIM_NDS_SCREEN_WIDTH * kScale;   // 1024
+static constexpr int kBufH = SIM_NDS_SCREEN_HEIGHT * 2 * kScale; // 1536
+
+static u8 sBuf[kBufW * kBufH * 4];
+static bool sHasContent = false;
+static bool sDirty = false;
+
+
+// DS-pixel rect -> clamped buffer-space rect for one screen.
+static bool ClipRect(int isSub, int x, int y, int w, int h,
+                     int *bx, int *by, int *bw, int *bh) {
+  int ox = x, oy = y + (isSub ? SIM_NDS_SCREEN_HEIGHT : 0);
+  if (ox < 0) { w += ox; ox = 0; }
+  if (oy < 0) { h += oy; oy = 0; }
+  if (ox + w > SIM_NDS_SCREEN_WIDTH) w = SIM_NDS_SCREEN_WIDTH - ox;
+  int screenBottom = (isSub ? SIM_NDS_SCREEN_HEIGHT * 2 : SIM_NDS_SCREEN_HEIGHT);
+  if (oy + h > screenBottom) h = screenBottom - oy;
+  if (w <= 0 || h <= 0) return false;
+  *bx = ox; *by = oy; *bw = w; *bh = h;
+  return true;
+}
+
+extern "C" void HiResText_Glyph(int isSub, int x, int y, int w, int h,
+                                const unsigned char *gfx, int palette,
+                                int fgColor, int shadowColor) {
+  if (!gfx || w <= 0 || h <= 0 || w > 32 || h > 32) return;
+  int bx, by, bw, bh;
+  if (!ClipRect(isSub, x, y, w, h, &bx, &by, &bw, &bh)) return;
+  const u16 *pal = (const u16 *)(isSub ? s_HW_DB_BG_PLTT : s_HW_BG_PLTT);
+  // Arrays, not three scalars: col[1]/col[2] below read the green/blue
+  // channels, and indexing past a scalar (col = &fgR) is UBSan
+  // object-size UB even though the scalars happened to sit adjacently.
+  u8 fg[3], sh[3];
+  SIM_u16ToRGB(pal[((palette & 0xF) << 4) + (fgColor & 0xF)], &fg[0], &fg[1], &fg[2]);
+  SIM_u16ToRGB(pal[((palette & 0xF) << 4) + (shadowColor & 0xF)], &sh[0], &sh[1], &sh[2]);
+  for (int sy = 0; sy < h; sy++) {
+    for (int sx = 0; sx < w; sx++) {
+      int off = (sy >> 3) * 64 + (sx >> 3) * 32 + (sy & 7) * 4 + ((sx & 7) >> 1);
+      u8 byte = gfx[off];
+      int nib = (sx & 1) ? (byte >> 4) : (byte & 0xF);
+      const u8 *col;
+      if (nib == (fgColor & 0xF)) col = fg;
+      else if (nib == (shadowColor & 0xF)) col = sh;
+      else continue; // background pixels: the DS box underneath already shows
+      int dx = (x + sx) * kScale;
+      int dy = (y + (isSub ? SIM_NDS_SCREEN_HEIGHT : 0) + sy) * kScale;
+      for (int ky = 0; ky < kScale; ky++) {
+        u8 *row = &sBuf[((dy + ky) * kBufW + dx) * 4];
+        for (int kx = 0; kx < kScale; kx++, row += 4) {
+          row[0] = col[0]; row[1] = col[1]; row[2] = col[2]; row[3] = 255;
+        }
+      }
+    }
+  }
+  sHasContent = true;
+  sDirty = true;
+}
+
+extern "C" void HiResText_ClearRect(int isSub, int x, int y, int w, int h) {
+  int bx, by, bw, bh;
+  if (!ClipRect(isSub, x, y, w, h, &bx, &by, &bw, &bh)) return;
+  for (int row = 0; row < bh * kScale; row++)
+    memset(&sBuf[((by * kScale + row) * kBufW + bx * kScale) * 4], 0, (size_t)bw * kScale * 4);
+  sDirty = true;
+}
+
+extern "C" void HiResText_ScrollRectUp(int isSub, int x, int y, int w, int h, int dy) {
+  if (dy <= 0) return;
+  int bx, by, bw, bh;
+  if (!ClipRect(isSub, x, y, w, h, &bx, &by, &bw, &bh)) return;
+  if (dy >= bh) { HiResText_ClearRect(isSub, x, y, w, h); return; }
+  int pxY = by * kScale, pxH = bh * kScale, pxDy = dy * kScale, pxX = bx * kScale, pxW = bw * kScale;
+  for (int row = 0; row < pxH - pxDy; row++)
+    memmove(&sBuf[((pxY + row) * kBufW + pxX) * 4], &sBuf[((pxY + row + pxDy) * kBufW + pxX) * 4], (size_t)pxW * 4);
+  for (int row = pxH - pxDy; row < pxH; row++)
+    memset(&sBuf[((pxY + row) * kBufW + pxX) * 4], 0, (size_t)pxW * 4);
+  sDirty = true;
+}
+
+void HiResText_DrawOverlay(void) {
+  if (!sHasContent) return;
+  SIM_config_type *cfg = SIM_GetConfigPtr();
+  if (cfg && (cfg->screenLayout != SIM_CONFIG_SCREEN_LAYOUT_VERTICAL || cfg->swapScreens)) return;
+  SIM::Render::HiResOverlayInput input;
+  input.rgba8 = sBuf;
+  input.width = kBufW;
+  input.height = kBufH;
+  input.dirty = sDirty;
+  sDirty = false;
+  SIM::Render::Get().DrawHiResOverlay(input);
+}
+
+void HiResText_DrawOverlayWide(HiResOverlayWideRect mainRect, HiResOverlayWideRect subRect, bool subVisible) {
+  if (!sHasContent) return;
+  // Main half (buffer rows 0..kBufH/2) into the centred rect; sub half
+  // into the panel / right-half rect when it is visible. The first call
+  // carries the dirty upload; the second samples the same texture.
+  SIM::Render::HiResOverlayInput input;
+  input.rgba8 = sBuf;
+  input.width = kBufW;
+  input.height = kBufH;
+  input.dirty = sDirty;
+  input.wideMode = true;
+  input.srcY = 0;
+  input.srcH = kBufH / 2;
+  input.dstX = mainRect.x; input.dstY = mainRect.y;
+  input.dstW = mainRect.w; input.dstH = mainRect.h;
+  SIM::Render::Get().DrawHiResOverlay(input);
+  if (subVisible) {
+    input.dirty = false;
+    input.srcY = kBufH / 2;
+    input.srcH = kBufH / 2;
+    input.dstX = subRect.x; input.dstY = subRect.y;
+    input.dstW = subRect.w; input.dstH = subRect.h;
+    SIM::Render::Get().DrawHiResOverlay(input);
+  }
+  sDirty = false;
+}
+
diff --git a/libraries/sim/src/sim_layout.c b/libraries/sim/src/sim_layout.c
new file mode 100644
index 0000000..febcaae
--- /dev/null
+++ b/libraries/sim/src/sim_layout.c
@@ -0,0 +1,236 @@
+#include <simulator/sim_layout.h>
+
+static SIM_Layout_Scene s_scene = SIM_LAYOUT_SCENE_UNKNOWN;
+static int s_wideEnabled = 0;
+static int s_wide2DWidth = 0;
+static int s_panelOpen = 0;
+static int s_battleTouchNeeded = 0;
+static int s_manualClose = 0;
+static int s_panelVisible = 0;
+static int s_tabIconVisible = 0;
+static float s_tabX = 0.0f;
+static float s_tabY = 0.0f;
+static float s_tabW = 0.0f;
+static float s_tabH = 0.0f;
+static int s_closeIconVisible = 0;
+static float s_closeX = 0.0f;
+static float s_closeY = 0.0f;
+static float s_closeW = 0.0f;
+static float s_closeH = 0.0f;
+static float s_panelX = 0.0f;
+static float s_panelY = 0.0f;
+static float s_panelW = 0.0f;
+static float s_panelH = 0.0f;
+
+void SIM_Layout_SetScene(SIM_Layout_Scene scene)
+{
+    if (scene < SIM_LAYOUT_SCENE_UNKNOWN || scene > SIM_LAYOUT_SCENE_MENU_SINGLE) {
+        scene = SIM_LAYOUT_SCENE_UNKNOWN;
+    }
+    s_scene = scene;
+    s_wide2DWidth = 0;
+    s_panelOpen = 0;
+    s_battleTouchNeeded = 0;
+    s_manualClose = 0;
+}
+
+SIM_Layout_Scene SIM_Layout_GetScene(void)
+{
+    return s_scene;
+}
+
+void SIM_Layout_SetWide2DWidth(int widthPx)
+{
+    if (widthPx <= 256) {
+        s_wide2DWidth = 0;
+    } else {
+        s_wide2DWidth = widthPx > 384 ? 384 : widthPx;
+    }
+}
+
+int SIM_Layout_GetWide2DWidth(void)
+{
+    return s_wide2DWidth;
+}
+
+int SIM_Layout_IsWide(void)
+{
+    return s_wideEnabled;
+}
+
+float SIM_Layout_GetWideAspect(void)
+{
+    return 16.0f / 9.0f;
+}
+
+void SIM_Layout_SetBattleTouchNeeded(int needsTouch)
+{
+    int next = needsTouch ? 1 : 0;
+    if (next && !s_battleTouchNeeded) {
+        s_manualClose = 0;
+    }
+    s_battleTouchNeeded = next;
+}
+
+void SIM_Layout_SetPanelOpen(int open)
+{
+    s_panelOpen = open ? 1 : 0;
+    if (open) {
+        s_manualClose = 0;
+    } else {
+        s_manualClose = 1;
+    }
+}
+
+int SIM_Layout_IsPanelOpen(void)
+{
+    if (s_scene == SIM_LAYOUT_SCENE_MENU) {
+        return 0;
+    }
+    if (s_scene == SIM_LAYOUT_SCENE_BATTLE) {
+        return s_panelOpen || (s_battleTouchNeeded && !s_manualClose);
+    }
+    return s_panelOpen;
+}
+
+int SIM_Layout_GetPanelRect(float *x, float *y, float *w, float *h)
+{
+    if (!s_panelVisible || !SIM_Layout_IsPanelOpen()) {
+        return 0;
+    }
+    if (x) *x = s_panelX;
+    if (y) *y = s_panelY;
+    if (w) *w = s_panelW;
+    if (h) *h = s_panelH;
+    return 1;
+}
+
+void SIM_Layout_SetTabIconRect(int visible, float x, float y, float w, float h)
+{
+    s_tabIconVisible = visible ? 1 : 0;
+    s_tabX = x;
+    s_tabY = y;
+    s_tabW = w;
+    s_tabH = h;
+}
+
+int SIM_Layout_GetTabIconRect(float *x, float *y, float *w, float *h)
+{
+    if (!s_tabIconVisible) {
+        return 0;
+    }
+    if (x) *x = s_tabX;
+    if (y) *y = s_tabY;
+    if (w) *w = s_tabW;
+    if (h) *h = s_tabH;
+    return 1;
+}
+
+void SIM_Layout_SetCloseIconRect(int visible, float x, float y, float w, float h)
+{
+    s_closeIconVisible = visible ? 1 : 0;
+    s_closeX = x; s_closeY = y; s_closeW = w; s_closeH = h;
+}
+
+int SIM_Layout_GetCloseIconRect(float *x, float *y, float *w, float *h)
+{
+    if (!s_closeIconVisible) return 0;
+    if (x) *x = s_closeX;
+    if (y) *y = s_closeY;
+    if (w) *w = s_closeW;
+    if (h) *h = s_closeH;
+    return 1;
+}
+
+void SIM_Layout_SetWideEnabled(int enabled)
+{
+    s_wideEnabled = enabled ? 1 : 0;
+}
+
+void SIM_Layout_SetPanelRect(int visible, float x, float y, float w, float h)
+{
+    s_panelVisible = visible ? 1 : 0;
+    s_panelX = x;
+    s_panelY = y;
+    s_panelW = w;
+    s_panelH = h;
+}
+
+// --- Main-screen touch (battlehud hook) ---
+static int s_mainTouchEnabled = 0;
+static int s_mainTouchPending = 0;
+static int s_mainTouchX = 0;
+static int s_mainTouchY = 0;
+static int s_mainTouchHeld = 0;
+static int s_mainTouchHeldX = 0;
+static int s_mainTouchHeldY = 0;
+static int s_mainRectVisible = 0;
+static float s_mainX = 0.0f;
+static float s_mainY = 0.0f;
+static float s_mainW = 0.0f;
+static float s_mainH = 0.0f;
+
+void SIM_Layout_SetMainTouchEnabled(int enabled)
+{
+    s_mainTouchEnabled = enabled ? 1 : 0;
+    if (!s_mainTouchEnabled) {
+        s_mainTouchPending = 0;
+        s_mainTouchHeld = 0;
+    }
+}
+
+int SIM_Layout_MainTouchEnabled(void)
+{
+    return s_mainTouchEnabled;
+}
+
+int SIM_Layout_GetMainTouch(int *x, int *y)
+{
+    if (!s_mainTouchPending) {
+        return 0;
+    }
+    s_mainTouchPending = 0;
+    if (x) *x = s_mainTouchX;
+    if (y) *y = s_mainTouchY;
+    return 1;
+}
+
+int SIM_Layout_GetMainTouchHeld(int *x, int *y)
+{
+    if (!s_mainTouchEnabled || !s_mainTouchHeld) {
+        return 0;
+    }
+    if (x) *x = s_mainTouchHeldX;
+    if (y) *y = s_mainTouchHeldY;
+    return 1;
+}
+
+void SIM_Layout_SetMainRect(int visible, float x, float y, float w, float h)
+{
+    s_mainRectVisible = visible ? 1 : 0;
+    s_mainX = x;
+    s_mainY = y;
+    s_mainW = w;
+    s_mainH = h;
+}
+
+void SIM_Layout_PushMainTouch(int x, int y)
+{
+    if (!s_mainTouchEnabled || !s_mainRectVisible) {
+        return;
+    }
+    s_mainTouchX = x;
+    s_mainTouchY = y;
+    s_mainTouchPending = 1;
+}
+
+void SIM_Layout_SetMainTouchHeld(int held, int x, int y)
+{
+    if (!held || !s_mainTouchEnabled || !s_mainRectVisible) {
+        s_mainTouchHeld = 0;
+        return;
+    }
+    s_mainTouchHeld = 1;
+    s_mainTouchHeldX = x;
+    s_mainTouchHeldY = y;
+}
diff --git a/libraries/sim/src/sim_lights.c b/libraries/sim/src/sim_lights.c
new file mode 100644
index 0000000..4b3f9e5
--- /dev/null
+++ b/libraries/sim/src/sim_lights.c
@@ -0,0 +1,70 @@
+#include <simulator/sim_lights.h>
+
+#include <string.h>
+
+static SIM_LightsState s_lights;
+static int s_lightsInit = 0;
+
+static void LightsDefault(SIM_LightsState *state)
+{
+    memset(state, 0, sizeof(*state));
+    state->ambientR = 1.0f;
+    state->ambientG = 1.0f;
+    state->ambientB = 1.0f;
+    state->keyDirX = -0.5f;
+    state->keyDirY = 0.8f;
+    state->keyR = 1.0f;
+    state->keyG = 1.0f;
+    state->keyB = 1.0f;
+    state->rimStrength = 0.0f;
+    state->count = 0;
+}
+
+static void LightsInit(void)
+{
+    if (!s_lightsInit) {
+        LightsDefault(&s_lights);
+        s_lightsInit = 1;
+    }
+}
+
+void SIM_Lights_Set(const SIM_LightsState *state)
+{
+    int i;
+    LightsInit();
+    if (state == NULL) {
+        LightsDefault(&s_lights);
+        return;
+    }
+    s_lights = *state;
+    if (s_lights.count < 0) {
+        s_lights.count = 0;
+    }
+    if (s_lights.count > SIM_LIGHTS_MAX) {
+        s_lights.count = SIM_LIGHTS_MAX;
+    }
+    for (i = 0; i < s_lights.count; i++) {
+        if (s_lights.lights[i].radius <= 0.0f) {
+            s_lights.lights[i].radius = 0.5f;
+        }
+        if (s_lights.lights[i].intensity < 0.0f) {
+            s_lights.lights[i].intensity = 0.0f;
+        }
+    }
+}
+
+void SIM_Lights_Clear(void)
+{
+    LightsInit();
+    LightsDefault(&s_lights);
+}
+
+int SIM_Lights_Get(SIM_LightsState *state)
+{
+    LightsInit();
+    if (state == NULL) {
+        return 0;
+    }
+    *state = s_lights;
+    return 1;
+}
