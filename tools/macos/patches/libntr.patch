+++ b/include/simulator/sim_helpers.hpp
@@ -0,0 +1,31 @@
+#pragma once
+
+// Player helpers for PC builds: a fast-forward badge and short messages drawn over the game, and save import/export
+// (a raw 512 KB .sav, as DeSmuME's "Export Backup Memory" writes, or a DeSmuME .dsv on import).
+
+#include <string>
+
+namespace SIM::Helpers {
+
+// Draws the overlay (fast-forward badge, message). Called once per frame inside the ImGui frame.
+void DrawOverlay();
+
+// Shows a short message at the top of the window.
+void Toast(const std::string & message, double seconds = 3.0);
+
+// Export the current save. With an empty path a save dialog asks where (macOS).
+void ExportSave(const std::string & path = "");
+
+// Import a save (.sav raw or DeSmuME .dsv), keeping a backup of the current one, then restart the game so it loads.
+// With an empty path a file dialog asks which, and the player confirms (macOS). A given path is imported without asking.
+void ImportSave(const std::string & path = "");
+
+// ios-platform hook: iOS Documents/Import + Documents/Export (Files app). Controls lane binds these to buttons.
+void ExportSaveToDocuments();
+bool ImportSaveFromDocuments();
+bool CheckImportOnBoot();
+
+// Called by the main loop each frame: restarts the game after an import.
+void Poll();
+
+}  // namespace SIM::Helpers
diff --git a/include/simulator/sim_hud_hd.h b/include/simulator/sim_hud_hd.h
new file mode 100644
index 0000000..2183992
--- /dev/null
+++ b/include/simulator/sim_hud_hd.h
@@ -0,0 +1,246 @@
+#ifndef SIMULATOR_SIM_HUD_HD_H
+#define SIMULATOR_SIM_HUD_HD_H
+
+// HD battle HUD (BDSP parity, 2026-11-26). The game describes the battle HUD
+// once per frame (cards, party ball strips, action buttons, move cards); the
+// GPU backend draws it at display resolution after the 2D composite and
+// before the touch-controls overlay: smooth rounded cards, gradients, icons
+// and a TrueType font, instead of the pixel-art HUD on the 342x192 canvas.
+//
+// Coordinates are in HUD canvas units: the wide battle 2D canvas, 342 x 192,
+// origin top-left (the same space the pixel-art corner HUD and touch hit
+// tests use). The renderer maps it onto the game view. C header, no nitro.h;
+// booleans are int. Strings are UTF-8, NUL-terminated.
+//
+// Contract:
+// - SIM_HudHD_Submit copies the frame; call it from the game thread every
+//   frame the battle is drawn (active = 0, or not calling it for a frame,
+//   draws nothing). The renderer keeps the last frame for at most 2 frames.
+// - The renderer owns animation that does not change game state: HP bar
+//   easing towards hpFrac, selection bracket pulse, card slide-in when a
+//   card/button becomes visible.
+// - Everything is a no-op under Renderer=gl and on builds without the GPU
+//   backend (SIM_HudHD_IsSupported returns 0).
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SIM_HUDHD_MAX_CARDS 4
+#define SIM_HUDHD_MAX_BUTTONS 8
+#define SIM_HUDHD_MAX_MOVES 4
+#define SIM_HUDHD_NAME_LEN 24
+
+typedef struct SIM_HudHD_Rect {
+    float x, y, w, h;
+} SIM_HudHD_Rect;
+
+typedef enum SIM_HudHD_Gender {
+    SIM_HUDHD_GENDER_NONE = 0,
+    SIM_HUDHD_GENDER_MALE,
+    SIM_HUDHD_GENDER_FEMALE,
+} SIM_HudHD_Gender;
+
+typedef enum SIM_HudHD_Status {
+    SIM_HUDHD_STATUS_NONE = 0,
+    SIM_HUDHD_STATUS_PSN,
+    SIM_HUDHD_STATUS_TOX,
+    SIM_HUDHD_STATUS_BRN,
+    SIM_HUDHD_STATUS_PAR,
+    SIM_HUDHD_STATUS_SLP,
+    SIM_HUDHD_STATUS_FRZ,
+    SIM_HUDHD_STATUS_FNT,
+} SIM_HudHD_Status;
+
+typedef enum SIM_HudHD_BallState {
+    SIM_HUDHD_BALL_EMPTY = 0, // no Pokemon in that slot
+    SIM_HUDHD_BALL_OK,
+    SIM_HUDHD_BALL_STATUS,    // has a status condition
+    SIM_HUDHD_BALL_FAINTED,
+} SIM_HudHD_BallState;
+
+// Name/level/HP card. Player cards show HP numbers and the EXP bar (BDSP
+// bottom-left); enemy cards show name/level/HP bar and the caught icon.
+typedef struct SIM_HudHD_Card {
+    int visible;
+    int isPlayer;
+    SIM_HudHD_Rect rect;            // card bounds
+    char name[SIM_HUDHD_NAME_LEN];
+    int gender;                     // SIM_HudHD_Gender
+    int level;
+    float hpFrac;                   // 0..1, target value (renderer eases)
+    int hp, maxHp;                  // drawn when showHpNumbers
+    int showHpNumbers;
+    float expFrac;                  // 0..1, drawn when showExp
+    int showExp;
+    int status;                     // SIM_HudHD_Status
+    int caught;                     // enemy: species already caught (ball icon)
+    float alpha;                    // 0..1 (fade during move animations)
+} SIM_HudHD_Card;
+
+// Six-ball party status strip under a card (BDSP: under the player card,
+// and next to the enemy card in trainer battles).
+typedef struct SIM_HudHD_PartyStrip {
+    int visible;
+    SIM_HudHD_Rect rect;
+    int count;                      // 0..6
+    int balls[6];                   // SIM_HudHD_BallState
+} SIM_HudHD_PartyStrip;
+
+typedef enum SIM_HudHD_ButtonStyle {
+    SIM_HUDHD_BUTTON_FIGHT = 0,     // "Battle" (crimson, burst icon)
+    SIM_HUDHD_BUTTON_POKEMON,       // emerald, Poke Ball icon
+    SIM_HUDHD_BUTTON_BAG,           // gold, bag icon
+    SIM_HUDHD_BUTTON_RUN,           // blue/slate, running icon
+    SIM_HUDHD_BUTTON_QUICK_BALL,    // compact pill: X key badge + ball icon
+    SIM_HUDHD_BUTTON_CANCEL,        // "Back"
+    SIM_HUDHD_BUTTON_MEGA,          // Mega Evolution toggle
+    SIM_HUDHD_BUTTON_YES,
+    SIM_HUDHD_BUTTON_NO,
+    SIM_HUDHD_BUTTON_GENERIC,       // label only
+} SIM_HudHD_ButtonStyle;
+
+typedef struct SIM_HudHD_Button {
+    int visible;
+    int style;                      // SIM_HudHD_ButtonStyle
+    SIM_HudHD_Rect rect;
+    char label[SIM_HUDHD_NAME_LEN];
+    int selected;                   // cursor is on it (brackets + glow)
+    int enabled;                    // 0: greyed out
+    int toggled;                    // MEGA: armed
+} SIM_HudHD_Button;
+
+typedef enum SIM_HudHD_MoveCategory {
+    SIM_HUDHD_CAT_PHYSICAL = 0,
+    SIM_HUDHD_CAT_SPECIAL,
+    SIM_HUDHD_CAT_STATUS,
+} SIM_HudHD_MoveCategory;
+
+typedef enum SIM_HudHD_Effectiveness {
+    SIM_HUDHD_EFF_UNKNOWN = 0,      // no hint (doubles, status moves)
+    SIM_HUDHD_EFF_NORMAL,
+    SIM_HUDHD_EFF_SUPER,            // "Super effective"
+    SIM_HUDHD_EFF_NOT_VERY,         // "Not very effective"
+    SIM_HUDHD_EFF_NONE,             // "No effect"
+} SIM_HudHD_Effectiveness;
+
+// Move card in the move-select menu: type colour, category icon, PP and the
+// effectiveness hint against the current target.
+typedef struct SIM_HudHD_MoveCard {
+    int visible;
+    SIM_HudHD_Rect rect;
+    char name[SIM_HUDHD_NAME_LEN];
+    int type;                       // game TYPE_* value (0..17, 9 = ???)
+    int category;                   // SIM_HudHD_MoveCategory
+    int pp, maxPp;
+    int effectiveness;              // SIM_HudHD_Effectiveness
+    int selected;
+    int enabled;                    // 0: no PP / disabled
+} SIM_HudHD_MoveCard;
+
+// --- BDSP HD Dialogue Bar (replaces pixel-art BG_LAYER_MAIN_1 battle text box) ---
+typedef struct SIM_HudHD_Dialogue {
+    int visible;
+    char text[320];        // UTF-8 currently visible (typewriter-sliced) text
+    int waitArrow;         // 1 = waiting for A press (animated down triangle)
+    float alpha;           // 0..1
+} SIM_HudHD_Dialogue;
+
+// --- BDSP HD In-Battle Bag / Party / Summary Overlays ---
+#define SIM_HUDHD_OVERLAY_NONE    0
+#define SIM_HUDHD_OVERLAY_BAG     1
+#define SIM_HUDHD_OVERLAY_PARTY   2
+#define SIM_HUDHD_OVERLAY_SUMMARY 3
+#define SIM_HUDHD_MAX_OVERLAY_ITEMS 10
+#define SIM_HUDHD_MAX_OVERLAY_TABS  4
+#define SIM_HUDHD_MAX_OVERLAY_PARTY 6
+
+typedef struct SIM_HudHD_OverlayItem {
+    int valid;
+    int itemId;
+    char name[32];
+    int count;
+    int selected;
+    int usable;
+} SIM_HudHD_OverlayItem;
+
+typedef struct SIM_HudHD_OverlayMon {
+    int valid;
+    char name[SIM_HUDHD_NAME_LEN];
+    int gender;
+    int level;
+    int hp, maxHp;
+    int status;
+    int isActive;          // currently on battlefield
+    int isFainted;
+    int selected;
+    int selectable;
+    char heldItem[32];
+    char ability[32];
+    int stats[6];          // HP, Atk, Def, SpA, SpD, Spe
+    char moveNames[4][SIM_HUDHD_NAME_LEN];
+    int moveTypes[4];
+    int movePp[4];
+    int moveMaxPp[4];
+} SIM_HudHD_OverlayMon;
+
+typedef struct SIM_HudHD_Overlay {
+    int kind;              // SIM_HUDHD_OVERLAY_*
+    char title[32];
+    char subtitle[64];
+    char desc[180];
+    char footerHint[96];
+    int numTabs;
+    int activeTab;
+    char tabNames[SIM_HUDHD_MAX_OVERLAY_TABS][24];
+    int numItems;
+    int scrollOffset;
+    int totalItems;
+    SIM_HudHD_OverlayItem items[SIM_HUDHD_MAX_OVERLAY_ITEMS];
+    int numParty;
+    int partyCursor;
+    SIM_HudHD_OverlayMon party[SIM_HUDHD_MAX_OVERLAY_PARTY];
+    int confirmMode;       // 0=list, 1=action prompt (Use/Cancel or Shift/Summary/Cancel)
+    int confirmCursor;
+    int confirmCount;
+    char confirmLabels[3][24];
+    char errorMsg[128];
+} SIM_HudHD_Overlay;
+
+typedef struct SIM_HudHD_Frame {
+    int active;                     // 0: draw nothing this frame
+    float canvasW, canvasH;         // 342, 192
+    SIM_HudHD_Card cards[SIM_HUDHD_MAX_CARDS];
+    SIM_HudHD_PartyStrip partyStrips[2];   // [0] player, [1] enemy
