diff --git a/include/simulator/sim_headless.h b/include/simulator/sim_headless.h
new file mode 100644
index 0000000..378b778
--- /dev/null
+++ b/include/simulator/sim_headless.h
@@ -0,0 +1,65 @@
+#pragma once
+// Headless / lockstep test support for PC builds. See docs/headless_protocol.md in the game repo.
+// All of it is off unless the SIM_* environment variables are set; the interactive app is unchanged.
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Parse SIM_HEADLESS / SIM_SAVE_PATH / SIM_FIXED_RTC / SIM_SEED / SIM_CONTROL / SIM_WATCHDOG_SEC.
+// Call once at the top of main(), before SDL_Init. In SIM_CONTROL mode this also redirects
+// stdout to stderr and keeps the real stdout fd for protocol replies.
+void SIM_Headless_Init(void);
+
+int SIM_Headless_Enabled(void);   // SIM_HEADLESS=1
+int SIM_Control_Enabled(void);    // SIM_CONTROL=stdio
+
+// The save file the game reads and writes: SIM_SAVE_PATH if set, else "save.bin" (cwd-relative).
+const char *SIM_GetSaveBinPath(void);
+
+// Instant atomic save backing (sim_save_flash.cpp): the 512 KB flash image lives in
+// memory; writes flush atomically (tmp + fsync + rename, previous file kept as
+// "<save>.bak"). Between Begin and Commit, writes are coalesced into one flush.
+int SIM_SaveFlash_Read(unsigned int src, void *dst, unsigned int len);
+int SIM_SaveFlash_Write(unsigned int dst, const void *src, unsigned int len);
+void SIM_SaveFlash_Begin(void);
+int SIM_SaveFlash_Commit(void);
+void SIM_SaveFlash_Rollback(void);
+
+// 1 when SIM_FIXED_RTC is set: fills the broken-down time for the current frame
+// (base instant + frame * 1/60 s). Used by the RTC implementation.
+int SIM_Headless_GetFixedRTC(int *year, int *month, int *day, int *week, int *hour, int *minute, int *second);
+
+// SIM_SEED, or -1 when unset.
+long SIM_Headless_Seed(void);
+
+// Called once per rendered frame from SIM_DebugFrame (sim_main.cpp).
+void SIM_Headless_FrameHook(void);
+
+// Frame counter (frames completed since start, in lockstep also the protocol "frame").
+unsigned long long SIM_Headless_FrameCount(void);
+
+// Write the current frame to a BMP file. Returns 1 on success. Must be called on the render thread.
+int SIM_Headless_Screenshot(const char *path);
+
+// Print file:line, message and a symbolized backtrace to stderr, then _exit(134).
+// Used by GF_ASSERT (game side) and the signal handlers.
+void SIM_Headless_AssertFail(const char *file, int line, const char *msg);
+
+// Install best-effort SIGSEGV/SIGBUS/SIGABRT handlers (headless/control only).
+void SIM_Headless_InstallCrashHandlers(void);
+
+// Watchdog soft-freeze check: the control layer calls WatchdogInput() when a
+// step/press/touch command arrives, and WatchdogSample(hash) about once a second
+// with a combined framebuffer+state hash. If inputs keep arriving but the hash
+// does not change for SIM_WATCHDOG_SEC, the watchdog dumps state and exits 124.
+void SIM_Headless_WatchdogInput(void);
+void SIM_Headless_WatchdogSample(unsigned long long hash);
+
+// Best-effort state dump for the watchdog / crashes: writes JSON-ish state to stderr.
+void SIM_Headless_DumpState(const char *reason);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/include/simulator/sim_helpers.hpp b/include/simulator/sim_helpers.hpp
