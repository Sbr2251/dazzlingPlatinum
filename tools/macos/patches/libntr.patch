diff --git a/libraries/sim/src/gpu/shaders/g2gpu.frag b/libraries/sim/src/gpu/shaders/g2gpu.frag
new file mode 100644
index 0000000..0e40497
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/g2gpu.frag
@@ -0,0 +1,368 @@
+#version 450
+// GPU 2D layer renderer (port of shaders/g2gpu_fragment.glsl). One pass
+// renders one layer (a BG, an OBJ priority layer, or the OBJ window mask)
+// into that layer's 256x384 image; the g2 composite is unchanged
+// afterwards. Integer data (VRAM, OAM, palettes) arrives in storage
+// buffers: SDL GPU forbids samplers on integer textures and storage
+// textures crash lavapipe on SDL 3.4.16, so the GL path's usampler2D +
+// texelFetch reads become packed-word array reads here (bytes packed
+// four per uint, 16-bit words two per uint, little-endian).
+layout(set = 2, binding = 0) readonly buffer BgVram { uint w[]; } bgVram;
+layout(set = 2, binding = 1) readonly buffer ObjVram { uint w[]; } objVram;
+layout(set = 2, binding = 2) readonly buffer Lcdc { uint w[]; } lcdc;
+layout(set = 2, binding = 3) readonly buffer Oam { uint w[]; } oam;
+layout(set = 2, binding = 4) readonly buffer Pal { uint w[]; } pal;
+layout(set = 3, binding = 0) uniform G2GpuParams {
+  ivec4 bgcnt;
+  ivec4 bgofs; // packed HOFS | VOFS<<16 (text BGs)
+  ivec4 affA;
+  ivec4 affB;
+  ivec4 affC;
+  ivec4 affD;
+  ivec4 affX;
+  ivec4 affY;
+  ivec4 m0; // passMode, isSub, layer, topScreen
+  ivec4 m1; // dispcnt, bgMode, extPlttBase, objExtPlttBase
+  ivec4 m2; // win0h, win0v, win1h, win1v
+  ivec4 m3; // winin, winout, mosaic, dbgEnable
+  ivec4 m4; // objCount, singleMode, unused, unused
+  ivec4 objList[32]; // candidate sprite indices for this pass (ascending)
+};
+layout(location = 0) out vec4 outColor;
+
+// Safe sign extension (no signed-overflow UB: left-shifting a signed int
+// past its width, or converting an out-of-range uint to int, is
+// undefined in GLSL, and Apple's Metal translation does not wrap the
+// way Mesa does, so rot/scale sprites vanished there).
+int signExtend9(uint v) { uint x = v & 0x1FFu; return x >= 256u ? int(x) - 512 : int(x); }
+int signExtend16(uint v) { return v >= 32768u ? int(v) - 65536 : int(v); }
+uint byteAt(uint word, int a) { return (word >> ((uint(a) & 3u) * 8u)) & 0xFFu; }
+uint bgByte(int a) {
+  a &= m0.y == 1 ? 0x1FFFF : 0x7FFFF;
+  return byteAt(bgVram.w[uint(a) >> 2], a);
+}
+uint objByte(int a) {
+  a &= m0.y == 1 ? 0x1FFFF : 0x3FFFF;
+  return byteAt(objVram.w[uint(a) >> 2], a);
+}
+uint lcdcByte(int a) { return byteAt(lcdc.w[uint(a) >> 2], a); }
+uint bgWord(int a) { return bgByte(a) | (bgByte(a + 1) << 8u); }
+uint objWord(int a) { return objByte(a) | (objByte(a + 1) << 8u); }
+uint lcdcWord(int a) { return lcdcByte(a) | (lcdcByte(a + 1) << 8u); }
+uint oamWord(int i) {
+  uint w = oam.w[uint(i) >> 1];
+  return (w >> ((uint(i) & 1u) * 16u)) & 0xFFFFu;
+}
+uint palWord(int n) {
+  uint w = pal.w[uint(n) >> 1];
+  return (w >> ((uint(n) & 1u) * 16u)) & 0xFFFFu;
+}
+vec3 palColor(int row, int idx) {
+  uint c = palWord(row * 256 + (idx & 255));
+  uint r = ((c & 31u) * 527u + 23u) >> 6;
+  uint g = (((c >> 5) & 31u) * 527u + 23u) >> 6;
+  uint b = (((c >> 10) & 31u) * 527u + 23u) >> 6;
+  return vec3(float(r), float(g), float(b)) / 255.0;
+}
+vec3 extPalColor(int slot, int palNum, int idx) {
+  int a = m1.z + slot * 8192 + palNum * 512 + idx * 2;
+  uint c = lcdcWord(a);
+  uint r = ((c & 31u) * 527u + 23u) >> 6;
+  uint g = (((c >> 5) & 31u) * 527u + 23u) >> 6;
+  uint b = (((c >> 10) & 31u) * 527u + 23u) >> 6;
+  return vec3(float(r), float(g), float(b)) / 255.0;
+}
+vec3 rgb555(uint c) {
+  uint r = ((c & 31u) * 527u + 23u) >> 6;
+  uint g = (((c >> 5) & 31u) * 527u + 23u) >> 6;
+  uint b = (((c >> 10) & 31u) * 527u + 23u) >> 6;
+  return vec3(float(r), float(g), float(b)) / 255.0;
+}
+vec3 objExtPalColor(int palNum, int idx) {
+  return rgb555(lcdcWord(m1.w + palNum * 512 + idx * 2));
+}
+int objAt(int i) { return objList[i >> 2][i & 3]; }
+int bgKind() { // 0 text, 1 affine, 2 extended, -1 none (mirrors G2SIM_DrawBG dispatch)
+  int layer = m0.z;
+  int bgMode = m1.y;
+  if (layer == 0 || layer == 1) return 0;
+  if (layer == 2) {
+    if (bgMode == 0 || bgMode == 1 || bgMode == 3) return 0;
+    if (bgMode == 2 || bgMode == 4) return 1;
+    if (bgMode == 5) return 2;
+    return -1;
+  }
+  if (bgMode == 0) return 0;
+  if (bgMode == 1 || bgMode == 2) return 1;
+  if (bgMode >= 3 && bgMode <= 5) return 2;
+  return -1;
+}
+bool windowPass(int x, int y) { // GBATEK window priority: WIN0 > WIN1 > OBJ window > outside.
+  // This pass only resolves WIN0/WIN1; pixels outside both pass through
+  // and the composite (g2 composite shader) applies the OBJ-window vs
+  // outside mask, which needs the OBJ window texture.
+  int layer = m0.z;
+  int dispcnt = m1.x;
+  if (((dispcnt >> 13) & 1) == 1) {
+    int left = (m2.x >> 8) & 255; int right = m2.x & 255;
+    int top = (m2.y >> 8) & 255; int bottom = m2.y & 255;
+    if (x >= left && x < right && y >= top && y < bottom) return ((m3.x >> layer) & 1) == 1;
+  }
+  if (((dispcnt >> 14) & 1) == 1) {
+    int left = (m2.z >> 8) & 255; int right = m2.z & 255;
+    int top = (m2.w >> 8) & 255; int bottom = m2.w & 255;
+    if (x >= left && x < right && y >= top && y < bottom) return ((m3.x >> (8 + layer)) & 1) == 1;
+  }
+  return true;
+}
+vec4 renderTextBG(int px, int py) {
+  int layer = m0.z;
+  int isSub = m0.y;
+  int dispcnt = m1.x;
+  int mosaic = m3.z;
+  int cnt = bgcnt[layer];
+  // BG mosaic (this BG's BGCNT mosaic bit): the fetched BG pixel is the
+  // one at the mosaic block's origin (screen-space blocks).
+  int qx = px; int qy = py;
+  if ((cnt & 0x40) != 0) { qx = px - px % ((mosaic & 15) + 1); qy = py - py % (((mosaic >> 4) & 15) + 1); }
+  int xoff = (bgofs[layer] & 0x1FF) + qx;
+  int yoff = ((bgofs[layer] >> 16) & 0x1FF) + qy;
+  int tileset = isSub == 1 ? ((cnt & 0x3C) << 12)
+                           : (((dispcnt >> 24) & 7) << 16) + ((cnt & 0x3C) << 12);
+  int tilemap = isSub == 1 ? ((cnt & 0x1F00) << 3)
+                           : (((dispcnt >> 27) & 7) << 16) + ((cnt & 0x1F00) << 3);
+  if ((cnt & 0x8000) != 0) {
+    tilemap += (yoff & 0x1F8) << 3;
+    if ((cnt & 0x4000) != 0) tilemap += (yoff & 0x100) << 3;
+  } else tilemap += (yoff & 0xF8) << 3;
+  int wideMask = (cnt & 0x4000) != 0 ? 0x100 : 0;
+  int entryAddr = tilemap + ((xoff & 0xF8) >> 2) + ((xoff & wideMask) << 3);
+  uint tile = bgWord(entryAddr);
+  int tileNum = int(tile & 0x3FFu);
+  int tx = (tile & 0x400u) != 0u ? 7 - (xoff & 7) : (xoff & 7);
+  int ty = (tile & 0x800u) != 0u ? 7 - (yoff & 7) : (yoff & 7);
+  if ((cnt & 0x80) != 0) { // 256 colour
+    uint idx = bgByte(tileset + (tileNum << 6) + (ty << 3) + tx);
+    if (idx == 0u || !windowPass(px, py)) return vec4(0.0);
+    if ((dispcnt & 0x40000000) != 0) {
+      int slot = (layer < 2 && (cnt & 0x2000) != 0) ? 2 + layer : layer;
+      return vec4(extPalColor(slot, int(tile >> 12), int(idx)), 1.0);
+    }
+    return vec4(palColor(isSub == 1 ? 2 : 0, int(idx)), 1.0);
+  }
+  int addr = tileset + (tileNum << 5) + (ty << 2) + (tx >> 1);
+  uint packedByte = bgByte(addr);
+  uint idx = (tx & 1) != 0 ? (packedByte >> 4) : (packedByte & 15u);
+  if (idx == 0u || !windowPass(px, py)) return vec4(0.0);
+  return vec4(palColor(isSub == 1 ? 2 : 0, int(((tile & 0xF000u) >> 8) | idx)), 1.0);
+}
+vec4 renderAffineBG(int px, int py, bool extended) {
+  if (!windowPass(px, py)) return vec4(0.0);
+  int layer = m0.z;
+  int isSub = m0.y;
+  int dispcnt = m1.x;
+  int mosaic = m3.z;
+  int cnt = bgcnt[layer];
+  // BG mosaic: affine transform is evaluated at the mosaic block origin.
+  int qx = px; int qy = py;
+  if ((cnt & 0x40) != 0) { qx = px - px % ((mosaic & 15) + 1); qy = py - py % (((mosaic >> 4) & 15) + 1); }
+  int fx = affX[layer] + qy * affB[layer] + qx * affA[layer];
+  int fy = affY[layer] + qy * affD[layer] + qx * affC[layer];
+  int tileset = isSub == 1 ? ((cnt & 0x3C) << 12)
+                           : (((dispcnt >> 24) & 7) << 16) + ((cnt & 0x3C) << 12);
+  int tilemap = isSub == 1 ? ((cnt & 0x1F00) << 3)
+                           : (((dispcnt >> 27) & 7) << 16) + ((cnt & 0x1F00) << 3);
+  int palRow = isSub == 1 ? 2 : 0;
+  if (extended && (cnt & 0x80) != 0) { // bitmap modes (direct colour falls back to CPU)
+    int xmask; int ymask; int yshift;
+    int sizeBits = cnt & 0xC000;
+    if (sizeBits == 0) { xmask = 0x7FFF; ymask = 0x7FFF; yshift = 7; }
+    else if (sizeBits == 0x4000) { xmask = 0xFFFF; ymask = 0xFFFF; yshift = 8; }
+    else if (sizeBits == 0x8000) { xmask = 0x1FFFF; ymask = 0xFFFF; yshift = 9; }
+    else { xmask = 0x1FFFF; ymask = 0x1FFFF; yshift = 9; }
+    int base = (cnt & 0x1F00) << 6;
+    if ((cnt & 0x2000) == 0 && ((fx & ~xmask) != 0 || (fy & ~ymask) != 0)) return vec4(0.0);
+    uint idx = bgByte(base + ((((fy & ymask) >> 8) << yshift) + ((fx & xmask) >> 8)));
+    if (idx == 0u) return vec4(0.0);
+    return vec4(palColor(palRow, int(idx)), 1.0);
+  }
+  int coordmask; int yshift;
+  int sizeBits = cnt & 0xC000;
+  if (sizeBits == 0) { coordmask = 0x7800; yshift = 4; }
+  else if (sizeBits == 0x4000) { coordmask = 0xF800; yshift = 5; }
+  else if (sizeBits == 0x8000) { coordmask = 0x1F800; yshift = 6; }
+  else { coordmask = 0x3F800; yshift = 7; }
+  if ((cnt & 0x2000) == 0 && ((fx | fy) & ~(coordmask | 0x7FF)) != 0) return vec4(0.0);
+  int tx = (fx >> 8) & 7; int ty = (fy >> 8) & 7;
+  if (!extended) {
+    uint tile = bgByte(tilemap + ((((fy & coordmask) >> 11) << yshift) + ((fx & coordmask) >> 11)));
+    uint idx = bgByte(tileset + (int(tile) << 6) + (ty << 3) + tx);
+    if (idx == 0u) return vec4(0.0);
+    return vec4(palColor(palRow, int(idx)), 1.0);
+  }
+  uint tile = bgWord(tilemap + (((((fy & coordmask) >> 11) << yshift) + ((fx & coordmask) >> 11)) << 1));
+  if ((tile & 0x400u) != 0u) tx = 7 - tx;
+  if ((tile & 0x800u) != 0u) ty = 7 - ty;
+  uint idx = bgByte(tileset + ((int(tile & 0x3FFu)) << 6) + (ty << 3) + tx);
+  if (idx == 0u) return vec4(0.0);
+  if ((dispcnt & 0x40000000) != 0) return vec4(extPalColor(m0.z, int(tile >> 12), int(idx)), 1.0);
+  return vec4(palColor(palRow, int(idx)), 1.0);
+}
+const int sprW[16] = int[16](8,16,8,8,16,32,8,8,32,32,16,8,64,64,32,8);
+const int sprH[16] = int[16](8,8,16,8,16,8,32,8,32,16,32,8,64,32,64,8);
+// Returns: rgb in .rgb, .a = 1 plotted; hitButTransparent handled via alpha 2 marker.
+vec4 sampleSprite(int num, int px, int py, bool wantWindow) {
+  int isSub = m0.y;
+  int dispcnt = m1.x;
+  int mosaic = m3.z;
+  uint a0 = oamWord(num * 4); uint a1 = oamWord(num * 4 + 1); uint a2 = oamWord(num * 4 + 2);
+  bool isWin = ((a0 >> 10) & 3u) == 2u;
+  if (isWin != wantWindow) return vec4(0.0);
+  int mode = wantWindow ? 0 : int((a0 >> 10) & 3u);
+  int sizeParam = int(a0 >> 14) | (int(a1 & 0xC000u) >> 12);
+  int w = sprW[sizeParam]; int h = sprH[sizeParam];
+  int tileNum = int(a2 & 0x3FFu);
+  int palRow = isSub == 1 ? 3 : 1;
+  bool rot = (a0 & 0x100u) != 0u;
+  int palByte = -1; bool hit = false;
+  bool palExt = false; int palNum = 0; // 256-colour OBJ with DISPCNT bit 31 (extended palettes)
+  bool bmp = false; vec3 bmpRgb = vec3(0.0); int bmpA = 16; // bitmap OBJ (mode 3): direct colour + per-sprite alpha
+  if (rot) {
+    int bw = w; int bh = h;
+    if ((a0 & 0x200u) != 0u) { bw <<= 1; bh <<= 1; }
+    int syB = (py - int(a0 & 0xFFu)) & 0xFF;
+    if (syB >= bh) return vec4(0.0);
+    int sxB = px - signExtend9(a1);
+    if (sxB < 0 || sxB >= bw) return vec4(0.0);
+    int grp = int((a1 >> 9) & 0x1Fu) * 16 + 3;
+    int rA = signExtend16(oamWord(grp)); int rB = signExtend16(oamWord(grp + 4));
+    int rC = signExtend16(oamWord(grp + 8)); int rD = signExtend16(oamWord(grp + 12));
+    int rotX = (sxB - (bw >> 1)) * rA + (syB - (bh >> 1)) * rB + (w << 7);
+    int rotY = (sxB - (bw >> 1)) * rC + (syB - (bh >> 1)) * rD + (h << 7);
+    if (uint(rotX) >= uint(w << 8) || uint(rotY) >= uint(h << 8)) return vec4(0.0);
+    // OBJ mosaic (ATTR0 bit 12): sample the sprite pixel at the
+    // mosaic block origin in sprite space. Window sprites ignore it.
+    if (((a0 & 0x1000u) != 0u) && !wantWindow) {
+      rotX = ((rotX >> 8) - ((rotX >> 8) % (((mosaic >> 8) & 15) + 1))) << 8;
+      rotY = ((rotY >> 8) - ((rotY >> 8) % (((mosaic >> 12) & 15) + 1))) << 8;
+    }
+    if (mode == 3) {
+      if ((a2 >> 12) == 0u) return vec4(0.0);
+      int addr;
+      if ((dispcnt & 0x40) != 0) {
+        if ((dispcnt & 0x20) != 0) return vec4(0.0);
+        addr = tileNum << (7 + ((dispcnt >> 22) & 1));
+        int ytf = w * 2;
+        uint c = objWord(addr + ((rotY >> 8) * ytf) + ((rotX >> 8) << 1));
+        if ((c & 0x8000u) != 0u) { hit = true; bmp = true; bmpRgb = rgb555(c & 0x7FFFu); bmpA = int((a2 >> 12) & 15u) + 1; }
+      } else {
+        int ytf = (dispcnt & 0x20) != 0 ? 512 : 256;
+        int base = (dispcnt & 0x20) != 0 ? ((tileNum & 0x1F) << 4) + ((tileNum & 0x3E0) << 7)
+                                         : ((tileNum & 0xF) << 4) + ((tileNum & 0x3F0) << 7);
+        uint c = objWord(base + ((rotY >> 8) * ytf) + ((rotX >> 8) << 1));
+        if ((c & 0x8000u) != 0u) { hit = true; bmp = true; bmpRgb = rgb555(c & 0x7FFFu); bmpA = int((a2 >> 12) & 15u) + 1; }
+      }
+    } else if ((a0 & 0x2000u) != 0u) { // 8bpp
+      int ytf;
+      int base = tileNum;
+      if ((dispcnt & 0x10) != 0) { base <<= ((dispcnt >> 20) & 3); ytf = ((w >> 3) << 1) << 5; }
+      else ytf = 0x20 << 5;
+      base <<= 5;
+      uint idx = objByte(base + ((rotY >> 11) * ytf) + ((rotY & 0x700) >> 5) + ((rotX >> 11) * 64) + ((rotX & 0x700) >> 8));
+      if (idx != 0u) { hit = true; palByte = int(idx); if ((dispcnt & 0x80000000) != 0) { palExt = true; palNum = int((a2 >> 12) & 15u); } }
+    } else {
+      int ytf;
+      int base = tileNum;
+      if ((dispcnt & 0x10) != 0) { base <<= ((dispcnt >> 20) & 3); ytf = (w >> 3) << 5; }
+      else ytf = 0x20 << 5;
+      base <<= 5;
+      uint packedByte = objByte(base + ((rotY >> 11) * ytf) + ((rotY & 0x700) >> 6) + ((rotX >> 11) * 32) + ((rotX & 0x700) >> 9));
+      uint idx = (rotX & 0x100) != 0 ? (packedByte >> 4) : (packedByte & 15u);
+      if (idx != 0u) { hit = true; palByte = int(((a2 & 0xF000u) >> 8) | idx); }
+    }
+  } else {
+    if ((a0 & 0x200u) != 0u) return vec4(0.0); // disabled
+    int sy = (py - int(a0 & 0xFFu)) & 0xFF;
+    if (sy >= h) return vec4(0.0);
+    int sx = px - signExtend9(a1);
+    if (sx < 0 || sx >= w) return vec4(0.0);
+    int sxF = (a1 & 0x1000u) != 0u ? w - 1 - sx : sx;
+    int syF = (a1 & 0x2000u) != 0u ? h - 1 - sy : sy;
+    // OBJ mosaic (ATTR0 bit 12, sprite space, post-flip). Window sprites ignore it.
+    if (((a0 & 0x1000u) != 0u) && !wantWindow) {
+      sxF = sxF - sxF % (((mosaic >> 8) & 15) + 1);
+      syF = syF - syF % (((mosaic >> 12) & 15) + 1);
+    }
+    if (mode == 3) {
+      if ((a2 >> 12) == 0u) return vec4(0.0);
+      int addr;
+      if ((dispcnt & 0x40) != 0) {
+        if ((dispcnt & 0x20) != 0) return vec4(0.0);
+        addr = (tileNum << (7 + ((dispcnt >> 22) & 1))) + syF * w * 2 + sxF * 2;
+      } else if ((dispcnt & 0x20) != 0) {
+        addr = ((tileNum & 0x1F) << 4) + ((tileNum & 0x3E0) << 7) + syF * 512 + sxF * 2;
+      } else {
+        addr = ((tileNum & 0xF) << 4) + ((tileNum & 0x3F0) << 7) + syF * 256 + sxF * 2;
+      }
+      uint c = objWord(addr);
+      if ((c & 0x8000u) != 0u) { hit = true; bmp = true; bmpRgb = rgb555(c & 0x7FFFu); bmpA = int((a2 >> 12) & 15u) + 1; }
+    } else if ((a0 & 0x2000u) != 0u) { // 8bpp
+      int t = tileNum;
+      if ((dispcnt & 0x10) != 0) { t <<= ((dispcnt >> 20) & 3); t += ((syF >> 3) * (w >> 3)) << 1; }
+      else t += (syF >> 3) * 0x20;
+      uint idx = objByte((t << 5) + ((syF & 7) << 3) + ((sxF >> 3) << 6) + (sxF & 7));
+      if (idx != 0u) { hit = true; palByte = int(idx); if ((dispcnt & 0x80000000) != 0) { palExt = true; palNum = int((a2 >> 12) & 15u); } }
+    } else {
+      int t = tileNum;
+      if ((dispcnt & 0x10) != 0) { t <<= ((dispcnt >> 20) & 3); t += (syF >> 3) * (w >> 3); }
+      else t += (syF >> 3) * 0x20;
+      uint packedByte = objByte((t << 5) + ((syF & 7) << 2) + ((sxF >> 3) << 5) + ((sxF & 7) >> 1));
+      uint idx = (sxF & 1) != 0 ? (packedByte >> 4) : (packedByte & 15u);
+      if (idx != 0u) { hit = true; palByte = int(((a2 & 0xF000u) >> 8) | idx); }
+    }
+  }
+  if (!hit) return vec4(0.0);
+  if (wantWindow) return vec4(1.0);
+  if (palByte == 0 && !bmp) return vec4(0.0, 0.0, 0.0, 2.0); // CPU: blocks lower sprites, plots nothing
+  vec3 rgb;
+  float a = 1.0;
+  if (bmp) { rgb = bmpRgb; a = float(bmpA) / 16.0; }
+  else if (palExt) rgb = objExtPalColor(palNum, palByte);
+  else rgb = palColor(palRow, palByte);
+  if (mode == 1) a = 0.0314; // semi-transparent (XLU): composite blends with BLDALPHA
+  return vec4(rgb, a);
+}
+vec4 renderOBJ(int px, int py, bool wantWindow) {
+  if (m4.y == 1) {
+    // One sprite per draw, scissored to its bounding box; the depth
+    // buffer (LEQUAL, ascending OAM index) resolves priority. A miss
+    // must not write depth (lower sprites still draw); a transparent
+    // pixel that blocks lower sprites writes depth with alpha 0.
+    vec4 s = sampleSprite(objAt(0), px, py, wantWindow);
+    if (s.a > 0.01) return s.a > 1.5 ? vec4(0.0) : s;
+    discard;
+  }
+  for (int i = 0; i < m4.x; i++) {
+    vec4 s = sampleSprite(objAt(i), px, py, wantWindow);
+    if (s.a > 0.01) return s.a > 1.5 ? vec4(0.0) : s;
+  }
+  return vec4(0.0);
+}
+void main() {
+  if (m3.w == 0) { outColor = vec4(0.0); return; }
+  // Layer images store the top screen in rows 0..191 (row 0 = top), the
+  // bottom screen in rows 192..383; gl_FragCoord.y counts from the top.
+  int row = int(gl_FragCoord.y);
+  int px = int(gl_FragCoord.x);
+  int py;
+  if (m0.w == 1) { if (row >= 192) discard; py = row; }
+  else { if (row < 192) discard; py = row - 192; }
+  if (m0.x == 0) {
+    int kind = bgKind();
+    if (kind == 0) outColor = renderTextBG(px, py);
+    else if (kind == 1) outColor = renderAffineBG(px, py, false);
+    else if (kind == 2) outColor = renderAffineBG(px, py, true);
+    else outColor = vec4(0.0);
+  } else if (m0.x == 1) outColor = renderOBJ(px, py, false);
+  else outColor = renderOBJ(px, py, true); // window sprites, any priority (objList = window list)
+}
diff --git a/libraries/sim/src/gpu/shaders/g2gpu.vert b/libraries/sim/src/gpu/shaders/g2gpu.vert
new file mode 100644
index 0000000..2f897e9
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/g2gpu.vert
@@ -0,0 +1,10 @@
+#version 450
+// Fullscreen triangle for the GPU 2D layer passes (port of
+// shaders/g2gpu_vertex.glsl). uDepth is the per-sprite depth for OBJ
+// passes (lowest OAM index wins via LEQUAL); 0 for BG passes. SDL GPU
+// depth is the clip z itself, so no GL-style remap is needed.
+layout(set = 1, binding = 0) uniform VertParams { float uDepth; };
+void main() {
+  vec2 p = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
+  gl_Position = vec4(p * 2.0 - 1.0, uDepth, 1.0);
+}
diff --git a/libraries/sim/src/gpu/shaders/g3.frag b/libraries/sim/src/gpu/shaders/g3.frag
new file mode 100644
index 0000000..7eff9fc
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/g3.frag
@@ -0,0 +1,81 @@
+#version 450
+// 3D fragment shader, ported from shaders/g3_fragment.glsl (GL #version 420).
+// Differences from the GL shader, all load-bearing:
+// - Uniforms are std140 blocks (set 3). The fog tables are a second block,
+//   pushed only when they change, so a per-draw push stays small.
+// - Clamp-to-border has no SDL GPU equivalent: the sampler uses
+//   CLAMP_TO_EDGE and the border colour (transparent black, the GL
+//   default: the GL backend never sets a border colour) is returned here
+//   when the coordinate is outside [0, 1) on a clamping axis. With
+//   NEAREST filtering this matches GL exactly. The border texel's alpha
+//   (0) then trips the same < 0.05 discard the GL shader applies to a
+//   sampled texel, so an out-of-range fragment is discarded either way.
+// - polygonMode: 0 = modulate (texel * vertex colour), else texel only.
+//   This matches the GL shader and the DS polygon modes it implements
+//   (toon/highlight and shadow ride on the vertex colours / alpha).
+layout(set = 2, binding = 0) uniform sampler2D myTexture;
+layout(std140, set = 3, binding = 0) uniform G3Draw {
+  vec4 fogColor;
+  int useTexture;
+  int polygonMode;
+  int useFog;
+  int clampS;
+  int clampT;
+} g3Draw;
+layout(std140, set = 3, binding = 1) uniform G3Fog {
+  float fogDepthBoundary[32];
+  float fogDensity[32];
+} g3Fog;
+layout(location = 0) in vec2 fragTexCoord;
+layout(location = 1) in vec4 fragInColor;
+layout(location = 2) in vec4 coords;
+layout(location = 0) out vec4 color;
+void main() {
+  vec4 shadedColor;
+  if (g3Draw.useTexture == 1) {
+    vec4 texel;
+    if ((g3Draw.clampS == 1 && (fragTexCoord.x < 0.0 || fragTexCoord.x >= 1.0)) ||
+        (g3Draw.clampT == 1 && (fragTexCoord.y < 0.0 || fragTexCoord.y >= 1.0))) {
+      texel = vec4(0.0);
+    } else {
+      texel = texture(myTexture, fragTexCoord);
+    }
+    if (g3Draw.polygonMode == 0) {
+      shadedColor = texel * fragInColor;
+    } else {
+      shadedColor = texel;
+    }
+    if (texel.a < 0.05) {
+      discard;
+    }
+  } else {
+    shadedColor = fragInColor;
+  }
+
+  if (g3Draw.useFog == 1) {
+    float fogFactor = 0.0;
+    if (coords.z < g3Fog.fogDepthBoundary[0]) {
+      fogFactor = g3Fog.fogDensity[0];
+    } else {
+      int foundIdx = 31;
+      for (int i = 1; i < 32; i++) {
+        if (coords.z < g3Fog.fogDepthBoundary[i]) {
+          foundIdx = i;
+          break;
+        }
+      }
+      if (foundIdx == 31) {
+        fogFactor = g3Fog.fogDensity[foundIdx];
+      } else {
+        float interpolationFactor =
+            (g3Fog.fogDepthBoundary[foundIdx - 1] - coords.z) /
+            (g3Fog.fogDepthBoundary[foundIdx] - g3Fog.fogDepthBoundary[foundIdx - 1]);
+        fogFactor = (g3Fog.fogDensity[foundIdx - 1] * (interpolationFactor)) +
+                    (g3Fog.fogDensity[foundIdx] * (1.0 - interpolationFactor));
+      }
+    }
+    color = mix(shadedColor, g3Draw.fogColor, fogFactor);
+  } else {
+    color = shadedColor;
+  }
+}
diff --git a/libraries/sim/src/gpu/shaders/g3.vert b/libraries/sim/src/gpu/shaders/g3.vert
new file mode 100644
index 0000000..9483f0b
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/g3.vert
@@ -0,0 +1,25 @@
+#version 450
+#extension GL_GOOGLE_include_directive : enable
+#include "sim_gpu.glsl"
+// 3D vertex shader, ported from shaders/g3_vertex.glsl (GL #version 420).
+// Position is GL clip space with w = 1 (the GL shader forced w to 1 and
+// the G3 vertices already carry NDC z in [-1, 1]); the depth remap turns
+// it into SDL GPU clip space (z in [0, w]). The original z is passed
+// through unchanged for fog, which reads clip-space z.
+// invariant gl_Position: two draws with identical vertices must produce
+// bitwise-identical depth, so the stat-change effect's EQUAL depth test
+// passes on Vulkan and Metal (see gpu/README.md, "Exact depth equality").
+layout(location = 0) in vec3 position;
+layout(location = 1) in vec2 texCoord;
+layout(location = 2) in vec4 inColor;
+layout(location = 0) out vec2 fragTexCoord;
+layout(location = 1) out vec4 fragInColor;
+layout(location = 2) out vec4 coords;
+invariant gl_Position;
+void main() {
+  vec4 p = vec4(position.x, position.y, position.z, 1.0);
+  gl_Position = SIM_GL_TO_GPU_DEPTH(p);
+  coords = p;
+  fragTexCoord = texCoord;
+  fragInColor = inColor;
+}
diff --git a/libraries/sim/src/gpu/shaders/post.frag b/libraries/sim/src/gpu/shaders/post.frag
new file mode 100644
index 0000000..a4f521a
--- /dev/null
+++ b/libraries/sim/src/gpu/shaders/post.frag
@@ -0,0 +1,152 @@
+#version 450
+#extension GL_GOOGLE_include_directive : enable
+#include "sim_gpu.glsl"
+layout(set = 2, binding = 0) uniform sampler2D sceneTex;
+layout(set = 3, binding = 0) uniform PostParams {
+  vec2 texelSize;
+  vec2 shakeOffset;
+  vec2 shockCenter;
+  float shockRadius;
+  float shockStrength;
+  vec2 zoomCenter;
+  float zoomBlur;
+  vec3 vignetteColor;
+  float vignetteAmount;
+  float chromaAmount;
+  float glowAmount;
+  float letterbox;
+  int fxRegion;
+  vec2 beamTarget;
+  float cutinProgress;
+  float cutinAlpha;
+  float titleProgress;
+  float titleAlpha;
+  vec2 glowCenter;
+  float glowAtAmount;
+};
+layout(location = 0) in vec2 fragTexCoord;
+layout(location = 0) out vec4 color;
+vec4 sceneTexture(vec2 uv) { return texture(sceneTex, SIM_RT_UV(uv)); }
+vec3 FxRainbow(float t)
+{
+    return 0.55 + 0.45 * cos(6.28318 * (t + vec3(0.0, 0.33, 0.67)));
+}
+
+void main()
+{
+    // Screen mask: effects default to the main (top/battle) screen only, so
+    // the bottom touch screen stays clean during cinematics.
+    if (fxRegion == 1 && fragTexCoord.y < 0.5) { color = sceneTexture( fragTexCoord); return; }
+    if (fxRegion == 2 && fragTexCoord.y >= 0.5) { color = sceneTexture( fragTexCoord); return; }
+
+    vec2 uv = fragTexCoord + shakeOffset;
+
+    // Shockwave: push UVs away from the centre as the ring passes.
+    if (shockStrength > 0.001) {
+        vec2 d = uv - shockCenter;
+        d.x *= 256.0 / 384.0; // combined display is 256x384; keep the ring round
+        float dist = length(d);
+        float band = exp(-pow((dist - shockRadius) * 9.0, 2.0));
+        vec2 dir = dist > 0.0001 ? normalize(uv - shockCenter) : vec2(0.0);
+        uv += dir * band * shockStrength * 0.05;
+    }
+
+    vec3 c;
+    if (zoomBlur > 0.001) {
+        // Zoom blur: average taps along the ray from the zoom centre.
+        c = sceneTexture( uv).rgb * 0.24;
+        for (int i = 1; i <= 4; i++) {
+            float t = float(i) / 4.0;
+            vec2 s = mix(uv, zoomCenter, -t * zoomBlur * 0.12);
+            c += sceneTexture( s).rgb * 0.19;
+        }
+    } else {
+        c = sceneTexture( uv).rgb;
+    }
+
+    if (chromaAmount > 0.001) {
+        vec2 dir = (uv - vec2(0.5)) * chromaAmount * texelSize * 6.0;
+        c.r = sceneTexture( uv + dir).r;
+        c.b = sceneTexture( uv - dir).b;
+    }
+
+    if (glowAmount > 0.001) {
+        // Bloom-ish: bleed the bright parts into their neighbourhood.
+        vec3 bright = vec3(0.0);
+        bright += sceneTexture( uv + vec2(texelSize.x * 2.0, 0.0)).rgb;
+        bright += sceneTexture( uv - vec2(texelSize.x * 2.0, 0.0)).rgb;
+        bright += sceneTexture( uv + vec2(0.0, texelSize.y * 2.0)).rgb;
+        bright += sceneTexture( uv - vec2(0.0, texelSize.y * 2.0)).rgb;
+        bright *= 0.25;
+        bright = max(bright - vec3(0.55), vec3(0.0)) * 1.8;
+        c += bright * glowAmount;
+    }
+
+    if (vignetteAmount > 0.001) {
+        vec2 d = (uv - vec2(0.5)) * vec2(1.15, 1.0);
+        float v = smoothstep(0.35, 0.95, length(d));
+        c = mix(c, vignetteColor, v * vignetteAmount);
+    }
+
+    if (glowAtAmount > 0.001 && fragTexCoord.y >= 0.5) {
+        vec2 gd = (fragTexCoord - glowCenter) * vec2(1.3333, 1.0);
+        float g = smoothstep(0.16, 0.0, length(gd));
+        c += FxRainbow(glowCenter.x * 2.0) * g * glowAtAmount * 0.7;
+    }
+
+    // Key Stone cut-in + title card: main screen only.
+    if (fragTexCoord.y >= 0.5 && (cutinAlpha > 0.001 || titleAlpha > 0.001)) {
+        vec2 p = vec2(fragTexCoord.x, (fragTexCoord.y - 0.5) * 2.0); // 0-1, bottom-to-top of main screen
+        vec2 pa = vec2(p.x * 1.3333, p.y); // aspect-corrected (256x192)
+
+        if (titleAlpha > 0.001) {
+            float bandY = abs(p.y - 0.5);
+            float band = smoothstep(0.16, 0.14, bandY);
+            float slide = (p.x - (titleProgress * 1.4 - 0.2));
+            vec3 bandCol = mix(vec3(0.10, 0.02, 0.22), vec3(0.23, 0.05, 0.38), p.y);
+            float edge = smoothstep(0.035, 0.0, abs(bandY - 0.15));
+            bandCol += FxRainbow(p.x * 0.5 + titleProgress) * edge * 1.4;
+            bandCol += vec3(1.0) * smoothstep(0.10, 0.0, abs(slide)) * 0.35; // sweep highlight
+            c = mix(c, bandCol, band * titleAlpha);
+        }
+
+        if (cutinAlpha > 0.001) {
+            float diag = p.x * 0.75 + p.y * 0.45;
+            float centre = mix(-0.25, 1.35, cutinProgress);
+            float d = abs(diag - centre);
+            float band = smoothstep(0.17, 0.13, d);
+            vec3 strip = FxRainbow(diag * 1.5 - cutinProgress * 0.7) * 0.85 + vec3(0.12);
+            strip += vec3(1.0) * smoothstep(0.03, 0.0, d) * 0.8; // hot core line
+            c = mix(c, strip, band * cutinAlpha * 0.88);
+
+            // The Key Stone rides the strip; a rainbow beam links it to the battler.
+            vec2 stone = vec2(mix(0.18, 0.82, cutinProgress), 0.58);
+            vec2 stoneA = vec2(stone.x * 1.3333, stone.y);
+            vec2 tgt = vec2(beamTarget.x, (beamTarget.y - 0.5) * 2.0);
+            vec2 tgtA = vec2(tgt.x * 1.3333, tgt.y);
+            vec2 pa2 = pa - stoneA;
+            vec2 ba = tgtA - stoneA;
+            float h = clamp(dot(pa2, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0);
+            float beamD = length(pa2 - ba * h);
+            float beam = smoothstep(0.018, 0.004, beamD) * sin(cutinProgress * 3.14159);
+            c += FxRainbow(h * 1.5 - cutinProgress) * beam * cutinAlpha * 0.9;
+
+            float sd = length(pa2);
+            float ang = atan(pa2.y, pa2.x) / 6.28318 + 0.5;
+            float ring = smoothstep(0.012, 0.004, abs(sd - 0.055));
+            float core = smoothstep(0.045, 0.01, sd);
+            float halo = smoothstep(0.16, 0.0, sd) * 0.35;
+            c += (FxRainbow(ang + cutinProgress * 0.5) * ring * 1.6 + vec3(1.0) * core * 1.2 + FxRainbow(ang) * halo) * cutinAlpha;
+        }
+    }
+
+    if (letterbox > 0.001) {
+        // Bars on the main screen only: it occupies the top half (v 0.5-1).
+        float bar = letterbox * 0.5;
+        if (fragTexCoord.y > 1.0 - bar || (fragTexCoord.y >= 0.5 && fragTexCoord.y < 0.5 + bar)) {
+            c = vec3(0.0);
+        }
+    }
+
+    color = vec4(c, 1.0);
+}
