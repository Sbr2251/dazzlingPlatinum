+// The boost quads go through the existing G3 pipeline, so the backend in
+// force decides whether they are GPU-drawn; the game asks here and draws
+// nothing when the answer is no, keeping the GL backend byte-identical.
+
+#include <simulator/sim_particles.h>
+#include <simulator/sim_render_backend.hpp>
+
+#include <cstring>
+
+extern "C" int SIM_Particles_IsGpu(void) {
+  if (SIM::Render::detail::gBackend == nullptr) return 0;
+  const char *name = SIM::Render::detail::gBackend->Name();
+  return name != nullptr && std::strcmp(name, "gpu") == 0 ? 1 : 0;
+}
diff --git a/libraries/sim/src/render_gpu/fx_texpack.cpp b/libraries/sim/src/render_gpu/fx_texpack.cpp
new file mode 100644
index 0000000..1f94b72
--- /dev/null
+++ b/libraries/sim/src/render_gpu/fx_texpack.cpp
@@ -0,0 +1,289 @@
+// fx_texpack implementation. See include/simulator/fx_texpack.hpp.
+#include <simulator/fx_texpack.hpp>
+#include <simulator/sim_platform.h> // ios-platform hook
+
+#include <SDL3/SDL.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <limits.h>
+#include <unistd.h>
+#ifdef __APPLE__
+#include <mach-o/dyld.h>
+#endif
+#include <cstring>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace SIM::Render::TexPack {
+namespace {
+
+constexpr std::uint64_t kFnvOffset = 1469598103934665603ULL;
+constexpr std::uint64_t kFnvPrime = 1099511628211ULL;
+
+std::uint64_t FnvMix(std::uint64_t h, const void *data, std::size_t size) {
+  const auto *p = static_cast<const std::uint8_t *>(data);
+  for (std::size_t i = 0; i < size; i++) {
+    h ^= p[i];
+    h *= kFnvPrime;
+  }
+  return h;
+}
+std::uint64_t FnvInt(std::uint64_t h, std::uint64_t v) {
+  return FnvMix(h, &v, sizeof(v));
+}
+
+bool EnvIs(const char *name, const char *want) {
+  const char *v = std::getenv(name);
+  return v && std::strcmp(v, want) == 0;
+}
+
+// Reads TexturePack / TexturePackDump from ./sim_config_prj.ini
+// [General], the same file the game config uses. Returns -1 when absent.
+int IniFlag(const char *key) {
+  FILE *f = std::fopen(SIM_Platform_ConfigPrjPath(), "r"); // ios-platform hook
+  if (!f) return -1;
+  char line[256];
+  int inGeneral = 0, result = -1;
+  while (std::fgets(line, sizeof(line), f)) {
+    if (line[0] == '[') inGeneral = std::strncmp(line, "[General]", 9) == 0;
+    if (!inGeneral) continue;
+    std::size_t klen = std::strlen(key);
+    if (std::strncmp(line, key, klen) == 0 && line[klen] == '=') {
+      const char *v = line + klen + 1;
+      if (std::strncmp(v, "true", 4) == 0) result = 1;
+      else if (std::strncmp(v, "false", 5) == 0) result = 0;
+    }
+  }
+  std::fclose(f);
+  return result;
+}
+
+// Feature switch (brief rule): ON by default in the app, OFF under
+// SIM_HEADLESS unless SIM_FX_TEXPACK=1 (dump: off by default everywhere; SIM_FX_TEXPACK_DUMP=1 or TexturePackDump=true),
+// so existing goldens stay byte-identical. Env beats the ini file.
+bool SwitchOn(const char *envName, const char *iniKey, bool appDefault = true) {
+  if (EnvIs(envName, "0")) return false;
+  if (std::getenv("SIM_HEADLESS") && !EnvIs(envName, "1")) return false;
+  if (EnvIs(envName, "1")) return true;
+  int ini = IniFlag(iniKey);
+  if (ini >= 0) return ini != 0;
+  return appDefault; // app default (dump is opt-in: it writes files)
+}
+
+struct Config {
+  bool enabled = false;
+  bool dump = false;
+  std::string dir;      // pack / dump directory (empty = none found)
+  bool dirProbed = false;
+};
+Config gCfg;
+
+std::string Join(const std::string &a, const std::string &b) {
+  if (a.empty() || a.back() == '/') return a + b;
+  return a + "/" + b;
+}
+
+bool DirExists(const std::string &path) {
+  SDL_PathInfo info;
+  return !path.empty() && SDL_GetPathInfo(path.c_str(), &info) &&
+         info.type == SDL_PATHTYPE_DIRECTORY;
+}
+
+// Directory of the real executable (resolving the symlink the test
+// runner launches through), or "" when it cannot be determined.
+std::string ExeDir() {
+  char raw[PATH_MAX];
+#ifdef __APPLE__
+  std::uint32_t size = sizeof(raw);
+  if (_NSGetExecutablePath(raw, &size) != 0) return "";
+#else
+  ssize_t n = ::readlink("/proc/self/exe", raw, sizeof(raw) - 1);
+  if (n <= 0) return "";
+  raw[n] = '\0';
+#endif
+  char resolved[PATH_MAX];
+  if (!::realpath(raw, resolved)) return "";
+  std::string path = resolved;
+  std::size_t slash = path.find_last_of('/');
+  return slash == std::string::npos ? "" : path.substr(0, slash);
+}
+
+std::string ProbeDir() {
+  if (SIM_Platform_IsIOS() && gCfg.dump) return Join(SIM_Platform_WritableDir(), "TexturePackDump"); // ios-platform hook
+  if (const char *env = std::getenv("SIM_TEXPACK_DIR")) {
+    if (env[0]) return env; // explicit: use even for dump (created there)
+  }
+  const char *base = SDL_GetBasePath(); // executable directory
+  std::string exe = ExeDir();
+  std::string candidates[] = {
+      Join(SIM_Platform_DataDir(), "TexturePack"), // ios-platform hook
+      "TexturePack",
+      base ? Join(base, "TexturePack") : "",
+      Join(exe, "TexturePack"),
+      base ? Join(base, "../tools/texpack/demo/TexturePack") : "",
+      Join(exe, "../tools/texpack/demo/TexturePack"),
+      "tools/texpack/demo/TexturePack",
+      "../tools/texpack/demo/TexturePack",
+  };
+  for (auto &c : candidates)
+    if (DirExists(c)) return c;
+  return "";
+}
+
+const Config &Cfg() {
+  if (!gCfg.dirProbed) {
+    gCfg.enabled = SwitchOn("SIM_FX_TEXPACK", "TexturePack");
+    gCfg.dump = SwitchOn("SIM_FX_TEXPACK_DUMP", "TexturePackDump", false);
+    gCfg.dir = ProbeDir();
+    gCfg.dirProbed = true;
+    if ((gCfg.enabled || gCfg.dump) && !gCfg.dir.empty())
+      std::fprintf(stderr, "texpack: dir=%s enabled=%d dump=%d\n",
+                   gCfg.dir.c_str(), (int)gCfg.enabled, (int)gCfg.dump);
+  }
+  return gCfg;
+}
+
+// Pending raw source (set by the decode path, consumed by Resolve).
+struct Pending {
+  bool set = false;
+  std::uint64_t baseHash = 0;
+  std::uint64_t paletteHash = 0;
+  int format = 0;
+};
+Pending gPending;
+
+std::string HashName(std::uint64_t h) {
+  char buf[17];
+  std::snprintf(buf, sizeof(buf), "%016llx", (unsigned long long)h);
+  return buf;
+}
+
+struct CacheEntry {
+  bool found = false;
+  int width = 0, height = 0;
+  std::vector<std::uint8_t> pixels;
+};
+std::unordered_map<std::uint64_t, CacheEntry> gCache;
+std::unordered_set<std::uint64_t> gDumped;
+
+void DumpOne(std::uint64_t hash, int w, int h, const void *rgba8, int format,
+             std::uint64_t paletteHash) {
+  const Config &c = Cfg();
+  if (c.dir.empty() || !rgba8 || w <= 0 || h <= 0) return;
+  if (!gDumped.insert(hash).second) return;
+  SDL_CreateDirectory(c.dir.c_str());
+  std::string name = HashName(hash);
+  SDL_Surface *surf = SDL_CreateSurfaceFrom(
+      w, h, SDL_PIXELFORMAT_RGBA32, const_cast<void *>(rgba8), w * 4);
+  if (surf) {
+    SDL_SavePNG(surf, Join(c.dir, name + ".png").c_str());
+    SDL_DestroySurface(surf);
+  }
+  FILE *m = std::fopen(Join(c.dir, "manifest.csv").c_str(), "a");
+  if (m) {
+    std::fprintf(m, "%s,%d,%d,%d,%016llx,unknown\n", name.c_str(), w, h,
+                 format, (unsigned long long)paletteHash);
+    std::fclose(m);
+  }
+}
+
+bool LoadReplacement(std::uint64_t hash, int origW, int origH,
+                     CacheEntry &out) {
+  const Config &c = Cfg();
+  std::string path = Join(c.dir, HashName(hash) + ".png");
+  SDL_Surface *surf = SDL_LoadPNG(path.c_str());
+  if (!surf) return false;
+  SDL_Surface *rgba = SDL_ConvertSurface(surf, SDL_PIXELFORMAT_RGBA32);
+  SDL_DestroySurface(surf);
+  if (!rgba) return false;
+  bool ok = false;
+  // Any integer scale 1x-4x of the original, same aspect.
+  if (origW > 0 && origH > 0 && rgba->w % origW == 0 &&
+      rgba->h % origH == 0 && rgba->w / origW == rgba->h / origH &&
+      rgba->w / origW >= 1 && rgba->w / origW <= 4) {
+    out.found = true;
+    out.width = rgba->w;
+    out.height = rgba->h;
+    out.pixels.assign((std::uint8_t *)rgba->pixels,
+                      (std::uint8_t *)rgba->pixels +
+                          (std::size_t)rgba->w * rgba->h * 4);
+    ok = true;
+  } else {
+    std::fprintf(stderr, "texpack: %s is %dx%d, need 1x-4x of %dx%d\n",
+                 path.c_str(), rgba->w, rgba->h, origW, origH);
+  }
+  SDL_DestroySurface(rgba);
+  return ok;
+}
+
+} // namespace
+
+void SetPendingSource(const std::uint8_t *texels, std::size_t texelBytes,
+                      const std::uint8_t *palette, std::size_t paletteBytes,
+                      int format, int width, int height) {
+  const Config &c = Cfg();
+  if (!c.enabled && !c.dump) return; // no hashing cost when the lane is off
+  std::uint64_t h = kFnvOffset;
+  h = FnvInt(h, (std::uint64_t)(std::uint32_t)width);
+  h = FnvInt(h, (std::uint64_t)(std::uint32_t)height);
+  h = FnvInt(h, (std::uint64_t)(std::uint32_t)format);
+  if (texels) h = FnvMix(h, texels, texelBytes);
+  gPending.baseHash = h;
+  std::uint64_t ph = kFnvOffset;
+  if (palette) ph = FnvMix(ph, palette, paletteBytes);
+  gPending.paletteHash = ph;
+  gPending.format = format;
+  gPending.set = true;
+}
+
+bool Enabled() { return Cfg().enabled; }
+bool DumpEnabled() { return Cfg().dump; }
+
+Resolved Resolve(int width, int height, const void *rgba8) {
+  Resolved out;
+  const Config &c = Cfg();
+  Pending pending = gPending;
+  gPending.set = false;
+  if (!c.enabled && !c.dump) return out;
+  if (width <= 0 || height <= 0 || !rgba8) return out;
+
+  std::uint64_t hash;
+  int format = 0;
+  std::uint64_t paletteHash = 0;
+  if (pending.set) {
+    hash = pending.baseHash;
+    format = pending.format;
+    paletteHash = pending.paletteHash;
+  } else {
+    // No raw source (direct backend update): fall back to the decoded
+    // RGBA pixels. Palette animations then hash differently, which only
+    // means the original texture is used for those frames.
+    std::uint64_t h = kFnvOffset;
+    h = FnvInt(h, (std::uint64_t)(std::uint32_t)width);
+    h = FnvInt(h, (std::uint64_t)(std::uint32_t)height);
+    h = FnvMix(h, rgba8, (std::size_t)width * height * 4);
+    hash = h;
+  }
+  out.hash = hash;
+
+  if (c.dump) DumpOne(hash, width, height, rgba8, format, paletteHash);
+  if (!c.enabled || c.dir.empty()) return out;
+
+  auto it = gCache.find(hash);
+  if (it == gCache.end()) {
+    CacheEntry entry;
+    LoadReplacement(hash, width, height, entry);
+    it = gCache.emplace(hash, std::move(entry)).first;
+  }
+  if (it->second.found) {
+    out.found = true;
+    out.width = it->second.width;
+    out.height = it->second.height;
+    out.pixels = it->second.pixels;
+  }
+  return out;
+}
+
+} // namespace SIM::Render::TexPack
diff --git a/libraries/sim/src/render_gpu/fx_weather.cpp b/libraries/sim/src/render_gpu/fx_weather.cpp
new file mode 100644
index 0000000..4579a2c
--- /dev/null
+++ b/libraries/sim/src/render_gpu/fx_weather.cpp
@@ -0,0 +1,137 @@
+// fx_weather lane: weather state (game-facing C API) plus the two GPU
+// post passes (weather, water). GPU backend only; nothing here runs
+// under Renderer=gl, and both passes are skipped when disabled so the
+// default frame stays byte-identical.
+#include "fx_weather.hpp"
+#include <simulator/sim_weather.h>
+#include <simulator/sim_layout.h>
+#include "generated/post.vert.h"
+#include "generated/fx_weather.frag.h"
+#include "generated/fx_water.frag.h"
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+static int gKind = 0;
+static float gIntensity = 0.0f;
+// -1 until the game first calls SIM_Water_Set (it does on every map change,
+// not on a continue-load); 0 / 1 afterwards.
+static int gWater = -1;
+extern "C" void SIM_Weather_Set(int kind, float intensity) {
+  gKind = kind; gIntensity = intensity < 0 ? 0 : (intensity > 1 ? 1 : intensity);
+}
+extern "C" int SIM_Weather_GetKind(void) { return gKind; }
+extern "C" float SIM_Weather_GetIntensity(void) { return gIntensity; }
+extern "C" void SIM_Water_Set(int enabled) { gWater = enabled ? 1 : 0; }
+extern "C" int SIM_Water_GetEnabled(void) { return gWater > 0 ? 1 : 0; }
+
+namespace SIM::Render {
+namespace {
+using namespace SIM::Gpu;
+struct FxUniforms {
+  float texel[2]; float time; int kind;
+  float intensity; float flash; int wideMode; float pad;
+};
+static_assert(sizeof(FxUniforms) == 32, "fx std140 size");
+
+bool EnvOn(const char *name) {
+  const char *v = std::getenv(name);
+  return v && v[0] == '1';
+}
+// Headless gate (brief): features are off under SIM_HEADLESS unless the
+// scenario opts in with SIM_FX_WEATHER=1 / SIM_FX_WATER=1 (or forces a
+// kind with SIM_FX_WEATHER_KIND), so existing goldens stay identical.
+// Field-only gate: both passes are strict no-ops outside the field
+// scene (title, battles, menus), however they were enabled. The game
+// sets the scene through the wide-layout scene API at app transitions.
+bool InFieldScene() { return SIM_Layout_GetScene() == SIM_LAYOUT_SCENE_FIELD; }
+bool HeadlessBlocked(const char *fxEnv) {
+  return std::getenv("SIM_HEADLESS") && !EnvOn(fxEnv) &&
+         !std::getenv("SIM_FX_WEATHER_KIND");
+}
+
+bool RunPass(Device &device, Frame *frame, SDL_GPUTexture *src,
+             SDL_GPUTexture *dst, SDL_GPUTextureFormat dstFormat,
+             std::uint32_t w, std::uint32_t h, const ShaderBlob *frag,
+             const FxUniforms &u) {
+  if (!frame || !src || !dst || w == 0 || h == 0) return false;
+  if (frame->InPass()) frame->EndPass();
+  PassDesc d = PassDesc::Color(dst, SDL_GPU_LOADOP_CLEAR, {0, 0, 0, 1});
+  if (!frame->BeginPass(Phase::Post, d)) return false;
+  PipelineKey key;
+  key.vertex = &Shaders::post_vert;
+  key.fragment = frag;
+  key.layout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, 0);
+  key.layout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, 12);
+  key.layout.stride = sizeof(float) * 5;
+  key.blend = Blend::Alpha;
+  key.colorFormat = dstFormat;
+  SDL_GPUGraphicsPipeline *pipe = device.Pipeline(key);
+  if (!pipe) { frame->EndPass(); return false; }
+  frame->BindPipeline(pipe);
+  frame->SetViewport(FullViewport(w, h));
+  frame->BindFragmentSampler(0, src, device.Sampler(SamplerKey::Linear()));
+  frame->PushFragmentUniform(0, u);
+  static const float quad[] = {
+      -1, -1, 0, 0, 0, 1, -1, 0, 1, 0, 1, 1, 0, 1, 1,
+      -1, -1, 0, 0, 0, 1, 1, 0, 1, 1, -1, 1, 0, 0, 1,
+  };
+  frame->DrawStreamed(quad, 6, sizeof(float) * 5);
+  frame->EndPass();
+  return true;
+}
+} // namespace
+
+bool FxWeather::Run(Device &device, Frame *frame, SDL_GPUTexture *src,
+                    Texture &dst, SDL_GPUTextureFormat fmt,
+                    std::uint32_t w, std::uint32_t h, int wideMode) {
+  int kind = gKind; float inten = gIntensity;
+  if (const char *k = std::getenv("SIM_FX_WEATHER_KIND")) {
+    kind = std::atoi(k);
+    inten = 0.8f;
+    if (const char *i = std::getenv("SIM_FX_WEATHER_INTENSITY")) inten = (float)std::atof(i);
+  }
+  if (kind <= 0 || inten <= 0.001f || HeadlessBlocked("SIM_FX_WEATHER") || !InFieldScene()) return false;
+  if (!dst.Handle() && !dst.Create(device, TextureDesc::ColorTarget(
+                           w, h, fmt, "weather fx lazy target"))) return false;
+  if (dst.Width() != w || dst.Height() != h) dst.Resize(w, h);
+  mFrame++;
+  // Lightning: deterministic frame-hash pulses (same seed -> same frame,
+  // like the PostFX shake), a double-blink every ~7 seconds at 60 fps.
+  float flash = 0.0f;
+  if (kind == 3) {
+    std::uint64_t cyc = mFrame % 420;
+    if (cyc < 3 || (cyc >= 6 && cyc < 8)) flash = 0.55f * inten;
+  }
+  FxUniforms u{};
+  u.texel[0] = w ? 1.0f / (float)w : 0; u.texel[1] = h ? 1.0f / (float)h : 0;
+  u.time = (float)(mFrame % 36000) / 60.0f;
+  u.kind = kind; u.intensity = inten; u.flash = flash; u.wideMode = wideMode;
+  return RunPass(device, frame, src, dst.Handle(), fmt, w, h, &Shaders::fx_weather_frag, u);
+}
+
+bool FxWater::Run(Device &device, Frame *frame, SDL_GPUTexture *src,
+                  Texture &dst, SDL_GPUTextureFormat fmt,
+                  std::uint32_t w, std::uint32_t h, int wideMode) {
+  // SIM_FX_WATER=1 forces the pass on until the game has decided; once the
+  // game sets the per-map state (which already honours SIM_FX_WATER through
+  // its own feature gate) an explicit 0 wins, so the dry / snow routes the
+  // game turns off never reflect, whatever the env says.
+  int on = gWater > 0 || (gWater < 0 && EnvOn("SIM_FX_WATER"));
+  if (!on || HeadlessBlocked("SIM_FX_WATER") || !InFieldScene()) return false;
+  if (!dst.Handle() && !dst.Create(device, TextureDesc::ColorTarget(
+                           w, h, fmt, "water fx lazy target"))) return false;
+  if (dst.Width() != w || dst.Height() != h) dst.Resize(w, h);
+  mFrame++;
+  int wkind = gKind;
+  if (const char *k = std::getenv("SIM_FX_WEATHER_KIND")) {
+    wkind = std::atoi(k);
+  }
+  if (HeadlessBlocked("SIM_FX_WEATHER")) wkind = 0;
+  FxUniforms u{};
+  u.texel[0] = w ? 1.0f / (float)w : 0; u.texel[1] = h ? 1.0f / (float)h : 0;
+  u.time = (float)(mFrame % 36000) / 60.0f;
+  u.kind = (wkind == 6 || wkind == 7 || wkind == 8) ? wkind : 0; u.intensity = 0.85f; u.flash = 0; u.wideMode = wideMode;
+  return RunPass(device, frame, src, dst.Handle(), fmt, w, h, &Shaders::fx_water_frag, u);
+}
+} // namespace SIM::Render
