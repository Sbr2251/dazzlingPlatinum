+FxBattle3D::~FxBattle3D() {
+  Release();
+}
+
+void FxBattle3D::Release() {
+  // P1: Join background GLB worker thread cleanly before releasing GPU resources.
+  gAsyncLoader.Shutdown();
+
+  if (mDevice && mDevice->Handle()) {
+    for (int i = 0; i < SIM_BATTLE3D_BIOME_COUNT; i++) {
+      LoadedBiome &b = mBiomes[i];
+      if (b.vertexBuffer) {
+        SDL_ReleaseGPUBuffer(mDevice->Handle(), b.vertexBuffer);
+        b.vertexBuffer = nullptr;
+      }
+      if (b.indexBuffer) {
+        SDL_ReleaseGPUBuffer(mDevice->Handle(), b.indexBuffer);
+        b.indexBuffer = nullptr;
+      }
+      b.textures.clear();
+      b.submeshes.clear();
+      b.valid = false;
+      b.attempted = false;
+
+      ReleaseGltfArena(*mDevice, mGltfArenas[i]);
+    }
+    for (auto &kv : mModels) {
+      if (kv.second.model) ReleaseGltfModel(*mDevice, *kv.second.model);
+    }
+    for (auto &kv : mActors) {
+      if (kv.second) ReleaseGltfModel(*mDevice, *kv.second);
+    }
+  }
+  mModels.clear();
+  mActors.clear();
+  {
+    std::lock_guard<std::mutex> lock(gProbeMutex);
+    gReadyModels.clear();
+  }
+  for (int i = 0; i < SIM_BATTLE3D_MAX_BATTLERS; i++) {
+    mLatchedBattlers[i] = LatchedBattler{};
+  }
+  for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+    mLatchedActors[i] = LatchedBattler{};
+  }
+  {
+    std::lock_guard<std::mutex> lock(gStateMutex);
+    for (int i = 0; i < SIM_BATTLE3D_MAX_ACTORS; i++) {
+      gActorBones[i] = CachedActorBones{};
+    }
+  }
+  mLatchedBiome = nullptr;
+  mLatchedGltfArena = nullptr;
+  mShadowMap.Release();
+  mStaticShadowMap.Release();
+  mActiveShadowTex = nullptr;
+  mStaticShadowValid = false;
+  mStaticShadowBiome = -1;
+  mStaticShadowTod = -1;
+  mStaticShadowWeather = -1;
+  mStaticShadowArenaPtr = nullptr;
+  mLastActiveBiome = -1;
+  mWhiteDummy.Release();
+  mWhiteDummyUploaded = false;
+  mPipelinesWarmed = false;
+  mHasShadowMap = false;
+  mReadyForScene = false;
+  mDevice = nullptr;
+}
+
+bool FxBattle3D::IsActive() const {
+  if (!GatePermits()) return false;
+  std::lock_guard<std::mutex> lock(gStateMutex);
+  return gSharedFrame.active != 0 && gSharedFrame.alpha > 0.001f;
+}
+
+void FxBattle3D::PrewarmPipelines(Device &device) {
+  if (mPipelinesWarmed) return;
+  mPipelinesWarmed = true;
+
+  const SDL_GPUTextureFormat colorFormat = SDL_GPU_TEXTUREFORMAT_R8G8B8A8_UNORM;
+  const SDL_GPUTextureFormat depthFormat = device.DepthFormat();
+
+  VertexLayout b3dLayout;
+  b3dLayout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(B3DVertex, pos));
+  b3dLayout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(B3DVertex, norm));
+  b3dLayout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(B3DVertex, uv));
+  b3dLayout.Add(3, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(B3DVertex, color));
+  b3dLayout.stride = sizeof(B3DVertex);
+
+  VertexLayout skinLayout;
+  skinLayout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(GltfSkinnedVertex, pos));
+  skinLayout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(GltfSkinnedVertex, norm));
+  skinLayout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(GltfSkinnedVertex, uv));
+  skinLayout.Add(3, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(GltfSkinnedVertex, color));
+  skinLayout.Add(4, SDL_GPU_VERTEXELEMENTFORMAT_UINT4, (Uint32)offsetof(GltfSkinnedVertex, joints));
+  skinLayout.Add(5, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(GltfSkinnedVertex, weights));
+  skinLayout.stride = sizeof(GltfSkinnedVertex);
+
+  const SDL_GPUCullMode culls[2] = {SDL_GPU_CULLMODE_BACK, SDL_GPU_CULLMODE_NONE};
+
+  // Shadow pipelines
+  if (mHasShadowMap && mShadowFormat != SDL_GPU_TEXTUREFORMAT_INVALID) {
+    for (SDL_GPUCullMode cull : culls) {
+      PipelineKey k;
+      k.vertex = &Shaders::battle3d_shadow_vert;
+      k.fragment = &Shaders::battle3d_skinned_shadow_frag;
+      k.layout = b3dLayout;
+      k.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+      k.cull = cull;
+      k.depthTest = true;
+      k.depthWrite = true;
+      k.depthCompare = SDL_GPU_COMPAREOP_LESS;
+      k.blend = Blend::Opaque;
+      k.colorFormat = SDL_GPU_TEXTUREFORMAT_INVALID;
+      k.depthFormat = mShadowFormat;
+      device.Pipeline(k);
+
+      k.fragment = &Shaders::battle3d_shadow_frag;
+      device.Pipeline(k);
+
+      k.vertex = &Shaders::battle3d_skinned_shadow_vert;
+      k.fragment = &Shaders::battle3d_skinned_shadow_frag;
+      k.layout = skinLayout;
+      device.Pipeline(k);
+    }
+  }
+
+  // Main scene pipelines (cull x blend x depthWrite)
+  for (SDL_GPUCullMode cull : culls) {
+    // GLTF Arena (non-sky)
+    for (int bi = 0; bi < 2; bi++) {
+      PipelineKey k;
+      k.vertex = &Shaders::battle3d_main_vert;
+      k.fragment = &Shaders::battle3d_skinned_frag;
+      k.layout = b3dLayout;
+      k.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+      k.cull = cull;
+      k.depthTest = true;
+      k.depthWrite = (bi == 0);
+      k.depthCompare = SDL_GPU_COMPAREOP_LESS_OR_EQUAL;
+      k.blend = (bi == 0) ? Blend::Opaque : Blend::Alpha;
+      k.colorFormat = colorFormat;
+      k.depthFormat = depthFormat;
+      device.Pipeline(k);
+
+      // Skinned battlers/actors (Opaque+depthWrite for opaque/mask+Bayer dither, Alpha+no-depthWrite for Blend/FireCore)
+      k.vertex = &Shaders::battle3d_skinned_vert;
+      k.layout = skinLayout;
+      device.Pipeline(k);
+    }
+
+    // Sky / .b3d main
+    PipelineKey k;
+    k.vertex = &Shaders::battle3d_main_vert;
+    k.fragment = &Shaders::battle3d_main_frag;
+    k.layout = b3dLayout;
+    k.frontFace = SDL_GPU_FRONTFACE_COUNTER_CLOCKWISE;
+    k.cull = cull;
+    k.depthTest = true;
+    k.depthCompare = SDL_GPU_COMPAREOP_LESS_OR_EQUAL;
+    k.colorFormat = colorFormat;
+    k.depthFormat = depthFormat;
+
+    k.depthWrite = true;  k.blend = Blend::Opaque; device.Pipeline(k);
+    k.depthWrite = false; k.blend = Blend::Opaque; device.Pipeline(k);
+    k.depthWrite = false; k.blend = Blend::Alpha;  device.Pipeline(k);
+  }
+
+  // Shadow decals
+  {
+    PipelineKey k;
+    k.vertex = &Shaders::battle3d_shadow_decal_vert;
+    k.fragment = &Shaders::battle3d_shadow_decal_frag;
+    k.layout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(DecalVertex, pos));
+    k.layout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(DecalVertex, localUV));
+    k.layout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(DecalVertex, params));
+    k.layout.stride = sizeof(DecalVertex);
+    k.cull = SDL_GPU_CULLMODE_NONE;
+    k.depthTest = true;
+    k.depthWrite = false;
+    k.depthCompare = SDL_GPU_COMPAREOP_LESS_OR_EQUAL;
+    k.blend = Blend::Alpha;
+    k.colorFormat = colorFormat;
+    k.depthFormat = depthFormat;
+    device.Pipeline(k);
+  }
+
+  // Burst VFX
+  {
+    PipelineKey k;
+    k.vertex = &Shaders::battle3d_burst_vert;
+    k.fragment = &Shaders::battle3d_burst_frag;
+    k.layout.Add(0, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT3, (Uint32)offsetof(BurstVertex, pos));
+    k.layout.Add(1, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT2, (Uint32)offsetof(BurstVertex, localUV));
+    k.layout.Add(2, SDL_GPU_VERTEXELEMENTFORMAT_FLOAT4, (Uint32)offsetof(BurstVertex, params));
+    k.layout.stride = sizeof(BurstVertex);
+    k.cull = SDL_GPU_CULLMODE_NONE;
+    k.depthTest = true;
+    k.depthWrite = false;
+    k.depthCompare = SDL_GPU_COMPAREOP_LESS_OR_EQUAL;
+    k.blend = Blend::Additive;
+    k.colorFormat = colorFormat;
+    k.depthFormat = depthFormat;
+    device.Pipeline(k);
+  }
+}
+
+bool FxBattle3D::EnsureResources(Device &device, Frame *frame) {
+  mDevice = &device;
+
+  if (!mWhiteDummy) {
+    if (!mWhiteDummy.Create(device, TextureDesc::Rgba8(1, 1, "battle3d_white"))) {
+      return false;
+    }
+    mWhiteDummyUploaded = false;
+  }
+  if (!mWhiteDummyUploaded && frame) {
+    static const std::uint8_t kWhite[4] = {255, 255, 255, 255};
+    frame->UploadTexture(mWhiteDummy, kWhite);
+    mWhiteDummyUploaded = true;
+  }
+
+  if (!mShadowMap) {
+    TextureDesc desc;
+    desc.width = kShadowMapSize;
+    desc.height = kShadowMapSize;
+    desc.format = SDL_GPU_TEXTUREFORMAT_D32_FLOAT;
+    desc.usage = SDL_GPU_TEXTUREUSAGE_DEPTH_STENCIL_TARGET | SDL_GPU_TEXTUREUSAGE_SAMPLER;
+    desc.name = "battle3d_shadow_map";
+    if (!SDL_GPUTextureSupportsFormat(device.Handle(), desc.format,
+                                      SDL_GPU_TEXTURETYPE_2D, desc.usage)) {
+      desc.format = device.DepthFormat();
+    }
+    if (SDL_GPUTextureSupportsFormat(device.Handle(), desc.format,
+                                     SDL_GPU_TEXTURETYPE_2D, desc.usage) &&
+        mShadowMap.Create(device, desc)) {
+      mShadowFormat = desc.format;
+      mHasShadowMap = true;
+      TextureDesc staticDesc = desc;
+      staticDesc.name = "battle3d_static_shadow_map";
+      mStaticShadowMap.Create(device, staticDesc);
+      mStaticShadowValid = false;
+    } else {
+      mHasShadowMap = false;
+    }
+  }
+
+  // P11: Pre-warm core Battle3D Metal pipeline variants once to avoid mid-battle compiles.
+  PrewarmPipelines(device);
+  return true;
+}
