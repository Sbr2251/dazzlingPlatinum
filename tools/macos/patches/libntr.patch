+// 3D part of the SDL GPU render backend (workstream 2a).
+//
+// The game issues G3 draws during its frame, between G3BeginFrame and
+// G3EndFrame; this class records them (vertices and fog tables are copied
+// at the call, because caller pointers are valid only for the call) and
+// replays them into the 3D target in G3EndFrame, in recorded order.
+//
+// Ownership: the GpuBackend in sim_render_gpu.cpp (workstream 2c) owns
+// the device and the 3D RenderTarget and forwards the Backend 3D calls
+// here (see the glue patch in the 2a deliverables). This class never
+// touches the composite, post, capture or present targets.
+
+#pragma once
+
+#include <simulator/gpu/gpu.hpp>
+#include <simulator/sim_render_backend.hpp>
+
+#include <SDL3/SDL.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+namespace SIM::Render {
+
+// Records one 3D frame and replays it through the SDL GPU foundation
+// library. All methods run on the render thread (see the contract in
+// sim_render_backend.hpp).
+class G3Renderer {
+ public:
+  // The device and the 3D target (colour + depth) owned by the backend.
+  // Both must outlive this renderer. Attach is called once, from Init.
+  void Attach(SIM::Gpu::Device *device, SIM::Gpu::RenderTarget *target);
+
+  // Backend 3D calls, forwarded by the backend.
+  void BeginFrame(const G3FrameParams &params);
+  void EndFrame();
+  void ClearTarget();
+  void Draw(const G3DrawState &state, const G3::RenderVertex *verts, std::size_t count);
+  TextureHandle CreateTexture(int width, int height, const void *rgba8);
+  void UpdateTexture(TextureHandle texture, int width, int height, const void *rgba8);
+  void DestroyTexture(TextureHandle texture);
+
+  // Replays the recorded draws into another colour+depth target (same
+  // recorded order, same viewport rules). The recorded draws are kept
+  // until the next BeginFrame, so this may be called after EndFrame for
+  // a second target in the same frame (display capture re-rendering the
+  // 3D scene), with a depth texture the caller provides. `phase` must
+  // not go backwards on the frame (Scene3D at G3EndFrame time; a caller
+  // replaying later in the frame passes the phase of the pass it opens).
+  // The target is sized targetW x targetH; the 3D viewport is its
+  // screen half for the latched screen, as in EndFrame.
+  bool ReplayInto(SIM::Gpu::Frame *frame, SDL_GPUTexture *color, SDL_GPUTexture *depth,
+                  SDL_GPUTextureFormat colorFormat, std::uint32_t targetW, std::uint32_t targetH,
+                  SIM::Gpu::Phase phase = SIM::Gpu::Phase::Scene3D);
+
+  bool HasRecordedDraws() const;
+
+ private:
+  // One GPU texture version: a new version per Create/Update, so draws
+  // recorded before an update keep the old pixels. `pixels` holds the
+  // upload until the next replay drains it.
+  struct TextureVersion {
+    SIM::Gpu::Texture tex;
+    std::vector<std::uint8_t> pixels;
+    bool needsUpload = false;
+    int width = 0;
+    int height = 0;
+  };
+
+  struct RecordedDraw {
+    // Everything G3DrawState carries except the fog pointers (copied
+    // below) and the texture handle (resolved to a version snapshot).
+    std::shared_ptr<TextureVersion> texture;
+    WrapMode wrapS = WrapMode::Repeat;
+    WrapMode wrapT = WrapMode::Repeat;
+    std::uint8_t polygonMode = 0;
+    CullWinding cull = CullWinding::None;
+    DepthFunc depthFunc = DepthFunc::Less;
+    bool depthWrite = true;
+    bool fogEnabled = false;
+    float fogColor[4] = {};
+    float fogDepth[32] = {};
+    float fogDensity[32] = {};
+    std::vector<G3::RenderVertex> verts;
+  };
+
+  struct RecordedItem {
+    bool clear = false;
+    RecordedDraw draw;
+  };
+
+  bool EnsureVersionTexture(const std::shared_ptr<TextureVersion> &version);
+  void DrainUploads(SIM::Gpu::Frame *frame);
+  bool EnsureDummy(SIM::Gpu::Frame *frame);
+
+  SIM::Gpu::Device *mDevice = nullptr;
+  SIM::Gpu::RenderTarget *mTarget = nullptr;
+  Screen mScreen = Screen::Bottom;
+  bool mInFrame = false;
+  bool mReplayed = false;
+  // Draws recorded before the current BeginFrame (boot, the VBlank
+  // handler inside SIM_Render, which runs after G3EndFrame): replayed
+  // as part of the next frame, after its clear and before its in-frame
+  // draws, so the clear cannot erase them.
+  std::vector<RecordedItem> mPending;
+  std::vector<RecordedItem> mItems;
+  bool mPendingClear = false;
+  // A clear recorded before any in-frame draw of the current frame
+  // (before BeginFrame, or from SIM_PostRenderVBlank right after it):
+  // replayed before the pending draws.
+  bool mClearBeforePending = false;
+  // Texture versions: a new version per Create/Update, so draws recorded
+  // before an update keep the old pixels and draws after it see the new
+  // ones, exactly as with glTexImage2D between two GL draws. Destroy
+  // drops the handle; versions referenced by recorded draws stay alive
+  // until the draws are cleared at the next BeginFrame.
+  std::unordered_map<TextureHandle, std::shared_ptr<TextureVersion>> mTextures;
+  TextureHandle mNextTexture = 0;
+  std::vector<std::weak_ptr<TextureVersion>> mUploadQueue;
+  std::shared_ptr<TextureVersion> mDummy;
+  // Fog tables last pushed, and the frame they were pushed in (uniform
+  // state lives on the command buffer, so a new frame needs a fresh
+  // push even when the tables did not change).
+  bool mFogPushed = false;
+  std::uint64_t mFogFrameIndex = 0;
+  float mFogDepth[32] = {};
+  float mFogDensity[32] = {};
+  bool mFogCached = false;
+};
+
+} // namespace SIM::Render
