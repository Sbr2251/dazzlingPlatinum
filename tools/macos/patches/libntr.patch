+    }
+    if (n == 0 && bg0as3d != 0) return texture(bgTexture[0], uv); // hiresui: 3D stays at its native internal resolution
+    if (n == 0) return sampleUpscaled(bgTexture[0], uv);
+    if (n == 1) return sampleUpscaled(bgTexture[1], uv);
+    if (n == 2) return sampleUpscaled(bgTexture[2], uv);
+    return sampleUpscaled(bgTexture[3], uv);
+}
+vec4 sampleObj(int n, vec2 uv) {
+    if (upscaleMode == 0) {
+        if (n == 0) return texture(objTexture[0], uv);
+        if (n == 1) return texture(objTexture[1], uv);
+        if (n == 2) return texture(objTexture[2], uv);
+        if (n == 3) return texture(objTexture[3], uv);
+        return texture(objTexture[4], uv);
+    }
+    if (n == 0) return sampleUpscaled(objTexture[0], uv);
+    if (n == 1) return sampleUpscaled(objTexture[1], uv);
+    if (n == 2) return sampleUpscaled(objTexture[2], uv);
+    if (n == 3) return sampleUpscaled(objTexture[3], uv);
+    return sampleUpscaled(objTexture[4], uv);
