  "messages": [
    {
      "id": "RowanIntro_Text_HelloThere",
      "en_US": [
        "Hello there! My name is Rowan.\n",
        "Welcome to the world of Pokémon!\r",
        "The journey you are about to embark\n",
        "upon is not the Sinnoh you remember.\r",
        "It is a parallel Sinnoh, where events\n",
        "have unfolded differently...\r",
        "...down to the very map.\n",
        "It begins after Team Galactic fell.\r",
        "And some events...\n",
        "may be very different.\r"
      ]
    },
    {
      "id": "RowanIntro_Text_GenderDialogue",
      "en_US": [
        "Are you a boy?\n",
        "Or are you a girl?\r"
      ]
    },
    {
      "id": "RowanIntro_Text_ConfirmBoy",
      "en_US": "All right, so you’re a boy?\r"
    },
    {
      "id": "RowanIntro_Text_ConfirmGirl",
      "en_US": "All right, so you’re a girl?\r"
    },
    {
      "id": "RowanIntro_Text_NameDialogue",
      "en_US": "Tell me, what is your name?\r"
    },
    {
      "id": "RowanIntro_Text_ConfirmNameMale",
      "en_US": "Your name is {STRVAR_1 3, 0, 0}?\r"
    },
    {
      "id": "RowanIntro_Text_ConfirmNameFemale",
      "en_US": "Your name is {STRVAR_1 3, 0, 0}?\r"
    },
    {
      "id": "RowanIntro_Text_RivalNameDialogue",
      "en_US": "What might his name be?\r"
    },
    {
      "id": "RowanIntro_Text_ConfirmRivalName",
      "en_US": [
        "{STRVAR_1 3, 1, 0}, is it?\n",
        "That’s your friend’s name?\r"
      ]
    },
    {
      "id": "RowanIntro_Text_EndDialogue",
      "en_US": [
        "{STRVAR_1 3, 0, 0}! Your very own tale\n",
        "is about to unfold!\r"
      ]
