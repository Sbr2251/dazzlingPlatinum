{
  "key": 9234,
  "messages": [
    {
      "id": "TwinleafTownPlayerHouse2F_Text_InterviewerTeamEclipse",
      "en_US": [
        "Interviewer: Team Eclipse has been\n",
        "gaining followers at an unprecedented\r",
        "rate. How do you feel about this\n",
        "emerging organization?\r"
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_ProfRowanTeamEclipse",
      "en_US": [
        "Prof. Rowan: Any person or group that\n",
        "promises to bring people back from\r",
        "the dead is either a con artist or\n",
        "lying to themselves.\r",
        "Either way, they don't have\n",
        "my support.\r"
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_ThatConcludesOurSpecialProgram",
      "en_US": [
        "That concludes our special program,\n",
        "“Let's Ask Prof. Rowan!”\r",
        "Broadcast live from Lake Verity by\n",
        "Jubilife TV on Nationwide Net!\r"
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_SeeYouNextWeek",
      "en_US": [
        "See you next week, same time,\n",
        "same channel!"
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_MomBoughThisTVAsAGift",
      "en_US": "Mom bought this TV as a gift."
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_TheXButtonOpensTheMenu",
      "en_US": [
        "The X Button\n",
        "opens the menu!"
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_ItsAWii",
      "en_US": [
        "It’s a Wii!\n",
        "It’s controlled by a Wii Remote!"
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_PCPokemonBasics",
      "en_US": [
        "{STRVAR_1 3, 0, 0} checked the PC.\r",
        "Pokémon Basics...\r",
        "People live alongside Pokémon in\n",
        "this world.\r",
        "The people that battle Pokémon are\n",
        "called Pokémon Trainers."
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_ThereYouAre",
      "en_US": "{STRVAR_1 3, 0, 0}: There you are!\r"
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_ThatTeamEclipseReallyIsSomething",
      "en_US": [
        "Hey, {STRVAR_1 3, 1, 0}! Man, that Team\n",
        "Eclipse really is something.\r",
        "Anyways, Professor Rowan's probably\n",
        "the guy that can help us get our\r",
        "starters, and the TV broadcast said\n",
        "he was at Lake Verity!\r"
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_IsThisANewPC",
      "en_US": [
        "Oh, hey!\n",
        "Is this a new PC?!\r"
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_WhereWasI",
      "en_US": [
        "{STRVAR_1 3, 0, 0}: Uh...\n",
        "Where was I?\r"
      ]
    },
    {
      "id": "TwinleafTownPlayerHouse2F_Text_WereGoingToSeeProfRowanAndGetPokemon",
      "en_US": [
        "Oh, right, right! We're going to go\n",
        "to Lake Verity and find Prof. Rowan!\r",
        "I'll be waiting outside.\r",
        "OK, {STRVAR_1 3, 1, 0}? If you're late, I'm\n",
        "fining you $10 million!\r"
      ]
    }
  ]
}
