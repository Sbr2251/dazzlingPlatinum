  "messages": [
    {
      "id": "Route223_Text_KingdraRift",
      "en_US": [
        "A jagged tear hums above the\n",
        "dark surf.\r",
        "The sea churns with a dragon's\n",
        "ancient pressure..."
      ]
    },
    {
      "id": "Route223_Text_SummitPillar",
      "en_US": [
        "Shattered links of violet\n",
        "crystal cling to the cliff.\r",
        "Above the falls, the sky itself\n",
        "feels pulled taut."
      ]
    }
  ]
}
