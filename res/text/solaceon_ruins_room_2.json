{
  "key": 17426,
  "messages": [
    {
      "id": "SolaceonRuinsRoom2_Text_TMInRuins",
      "en_US": [
        "I'd heard there was a TM somewhere\n",
        "in these ruins. Way down deep.\r",
        "It's just that I seem to be lost,\n",
        "with everything looking the same.\r",
        "Now what?\n",
        "I could use help here."
      ]
    },
    {
      "id": "SolaceonRuinsRoom2_Text_TMInRuins2",
      "en_US": [
        "I'd heard there was a TM somewhere\n",
        "in these ruins. Way down deep.\r",
        "It's just that I seem to be lost,\n",
        "with everything looking the same.\r",
        "Now what?\n",
        "I could use help here.\r"
      ]
    },
    {
      "id": "SolaceonRuinsRoom2_Text_CanYouShowTheWay",
      "en_US": [
        "Hey!\n",
        "Now looky here!\r",
        "What you have there!\n",
        "That's TM30, Shadow Ball!\r",
        "Can you tell me the way down?\n",
        "I'll make it worth your while."
      ]
    },
    {
      "id": "SolaceonRuinsRoom2_Text_ThanksYoureMyRescuer",
      "en_US": [
        "Down the stairs, and down again...\n",
        "Got it! Every last turn!\r",
        "Thanks! You're my rescuer! Hahaha!\n",
        "Here you go, my thanks as promised.\r"
      ]
    },
    {
      "id": "SolaceonRuinsRoom2_Text_ItsNotLikeItWearsOut",
      "en_US": [
        "It's not like the way down will\n",
        "wear out! Cheapskate!"
      ]
    },
    {
      "id": "SolaceonRuinsRoom2_Text_IKnowTheWayDown",
      "en_US": [
        "I know the way down now, and it's all\n",
        "thanks to you.\r",
        "I'll find a TM of my own down there\n",
        "one of these days."
      ]
    }
  ]
