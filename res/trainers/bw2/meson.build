# BW2 animated battle trainer fronts (bw2vis:trainers-anim): trfgra_bw2.narc, 4 files per entry
# (NCGR, NCLR, NCER, NANR) in the order of trfgra_bw2.order. Generated by
# tools/bw2_trainers/build_bw2_trainers.py from tools/bw2_trainers/mapping.py; the battle reads it
# through src/battle/battle_trainer_bw2.c. Source art: pokebw2 res/trainers/sprites/front (MCSS).

bw2_trainer_order = files('trfgra_bw2.order')
bw2_trainer_classes = []
foreach line : fs.read('trfgra_bw2.order').splitlines()
    if line.endswith('/front.NCGR')
        bw2_trainer_classes += line.split('/')[0]
    endif
endforeach

bw2_trainer_png = []
bw2_trainer_cell_json = []
bw2_trainer_anim_json = []
foreach c : bw2_trainer_classes
    bw2_trainer_png += files(c / 'front.png')
    bw2_trainer_cell_json += files(c / 'front_cell.json')
    bw2_trainer_anim_json += files(c / 'front_anim.json')
endforeach

bw2_trainers_root = meson.current_source_dir()

bw2_trainer_NCGR = ncgr_cell_gen.process(bw2_trainer_png,
    extra_args: [
        '-version101',
        '-vram',
        '-clobbersize',
        '-mappingtype', '64',
        '-convertTo4Bpp',
    ],
    preserve_path_from: bw2_trainers_root,
)
bw2_trainer_NCLR = nclr_gen.process(bw2_trainer_png,
    extra_args: [ '-bitdepth', '4' ],
    preserve_path_from: bw2_trainers_root,
)
bw2_trainer_NCER = ncer_gen.process(bw2_trainer_cell_json,
    preserve_path_from: bw2_trainers_root,
)
bw2_trainer_NANR = nanr_gen.process(bw2_trainer_anim_json,
    preserve_path_from: bw2_trainers_root,
)

trfgra_bw2_narc = custom_target('trfgra_bw2.narc',
    output: [
        'trfgra_bw2.narc',
        'trfgra_bw2.naix.h',
    ],
    input: [
        bw2_trainer_NCGR,
        bw2_trainer_NCLR,
        bw2_trainer_NCER,
        bw2_trainer_NANR,
    ],
    command: [
        narc_exe, 'create',
        '--naix',
        '--order', bw2_trainer_order,
        '--output', '@OUTPUT0@',
        '@PRIVATE_DIR@',
    ],
    depend_files: bw2_trainer_order,
)

nitrofs_files += trfgra_bw2_narc
