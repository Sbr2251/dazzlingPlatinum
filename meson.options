option('revision', type : 'combo', choices: ['0', '1'], value : '1')
option('logging_enabled', type: 'boolean', value: false)
# macOS uses 'linux' (desktop SDL3 + Metal; libntr uses 'linux' for desktop POSIX SDL) and iOS uses 'ios'.
option('build_target', type: 'combo', choices: ['linux', 'ios'], value: 'linux', description: 'Target build platform (linux=macOS desktop SDL, ios=iOS Metal)', yield: true)
option('tracy_enable', type: 'boolean', value: false, description: 'Enable profiling')
option('skip_anim_scripts', type: 'boolean', value: false, description: 'True to skip building anim scripts')
# Build flavour (tools/macos/build.sh and tools/ios/build.sh):
#   dev     - GF_ASSERT/canaries/debug tools live, no optimisation
#   release - project-wide -O3, section GC and no debug info; GF_ASSERT expressions
#             are still evaluated because game code relies on their side effects
#   asan    - AddressSanitizer + UBSan on the whole build, GF_ASSERT live
option('build_variant', type: 'combo', choices: ['dev', 'release', 'asan'], value: 'dev', description: 'Build variant: dev, release or asan')
